10 OPEN "DATOS.TXT" FOR OUTPUT AS #1
20 PRINT #1, "UNO";1;2: WRITE #1, "DOS, Y", 3.5, -4
30 PRINT #1, "TRES"
40 CLOSE #1
50 OPEN "I", #2, "DATOS.TXT"
60 LINE INPUT #2, A$: PRINT "[";A$;"]"
70 INPUT #2, B$, X, Y: PRINT B$; X; Y
80 WHILE NOT EOF(2): LINE INPUT #2, C$: PRINT "<";C$;">": WEND
90 PRINT LOF(2): CLOSE
100 OPEN "DATOS.TXT" FOR APPEND AS 1: PRINT #1, "CUATRO": CLOSE 1
110 OPEN "DATOS.TXT" FOR INPUT AS #1: N=0
120 WHILE NOT EOF(1): LINE INPUT #1, L$: N=N+1: WEND: CLOSE: PRINT N; "LINEAS"
130 ON ERROR GOTO 200
140 OPEN "NOESTA.TXT" FOR INPUT AS #3
150 PRINT "TRAS EL ERROR"
160 Z=SQR(-1): PRINT "Z";Z
170 ERROR 99
180 PRINT "FIN": END
200 PRINT "ERROR";ERR;"EN";ERL: RESUME NEXT
