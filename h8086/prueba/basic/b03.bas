10 REM cadenas, bucles, subrutinas y datos
20 A$="HOLA MUNDO": PRINT LEN(A$); LEFT$(A$,4); "|"; RIGHT$(A$,5); "|"; MID$(A$,3,4)
30 PRINT INSTR(A$,"MUN"); INSTR(4,A$,"O"); ASC("Z"); CHR$(65)+CHR$(66); STR$(42); VAL("3.5")+1
40 PRINT STRING$(5,"*"); SPACE$(3); "<"; HEX$(255); " "; OCT$(8); " "; HEX$(-1)
50 B$="": FOR I=1 TO 5: B$=B$+CHR$(64+I): NEXT: PRINT B$
60 I=0: WHILE I<3: PRINT "W";I;: I=I+1: WEND: PRINT
70 FOR I=1 TO 3: ON I GOSUB 200,210,220: NEXT: PRINT
80 FOR J=10 TO 1 STEP -3: PRINT J;: NEXT J: PRINT
90 RESTORE 300: READ N: FOR I=1 TO N: READ X$, Y: PRINT X$;Y;: NEXT: PRINT
100 DEF FNC(X)=X*X+1: DEF FNS$(A$,N)=LEFT$(A$,N)+"!": PRINT FNC(3); FNS$("ABCDEF",2)
110 IF 1=1 THEN IF 2=3 THEN PRINT "MAL" ELSE PRINT "BIEN" ELSE PRINT "MAL2"
120 X=5: IF X>3 AND X<10 THEN PRINT "DENTRO" ELSE PRINT "FUERA"
130 PRINT NOT 0; 5 AND 3; 5 OR 3; 5 XOR 3; -1 EQV 0; 0 IMP 0
140 PRINT "A"<"B"; "ABC"="ABC"; "AB">"ABC"; 2<>3; 3>=3
150 DIM T$(3): T$(1)="UNO": T$(2)="DOS": PRINT T$(1);T$(2);LEN(T$(3))
160 SWAP T$(1),T$(2): PRINT T$(1);T$(2)
180 GOTO 400
200 PRINT "S1";: RETURN
210 PRINT "S2";: RETURN
220 PRINT "S3";: RETURN
300 DATA 3, "UNO", 1, DOS, 2, " TRES ", 3
400 PRINT 10/4; 10\4; 10 MOD 4; -10\4; 2^-1; ABS(-3); SGN(-2); INT(3.7); FIX(-3.7)
410 PRINT TAB(5);"T5";TAB(12);"T12";SPC(3);"S3"
420 PRINT 1E38*10
430 PRINT "FIN"
