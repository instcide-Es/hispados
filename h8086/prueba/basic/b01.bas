10 PRINT "HOLA"
20 PRINT 1+2, 3*4; 10/4
30 A=5: B=7: PRINT A*B, A-B
40 FOR I=1 TO 5: PRINT I;: NEXT I: PRINT
50 A$="BUENOS": B$="DIAS": PRINT A$+" "+B$
60 IF A>3 THEN PRINT "MAYOR" ELSE PRINT "MENOR"
70 GOSUB 200
80 PRINT LEN(A$), LEFT$(A$,3), RIGHT$(B$,2), MID$(A$,2,3)
90 DIM M(5): FOR I=0 TO 5: M(I)=I*I: NEXT: PRINT M(3), M(5)
100 READ X, Y$: PRINT X, Y$
110 PRINT 1/3, 2/3, 1E20, 123456789
120 PRINT -7 MOD 3, 7\2, ASC("A"), CHR$(66)
130 PRINT 32767+1, -32768, 2.5E-5, .1+.2
140 END
200 PRINT "EN LA SUBRUTINA": RETURN
300 DATA 42, "TEXTO"
