;
;  El texto va en la página de códigos 858 (la 850 con el €): tiene todas las
;  letras del castellano, el catalán, el gallego y el vasco, también las
;  mayúsculas con tilde, que la 437 no tiene. La pantalla de un PC enseña la
;  437 (en CGA, MDA y Hercules las letras están grabadas en la tarjeta), así
;  que cada letra se pinta con su equivalente (vis); en EGA y VGA, que dejan
;  cambiar las letras, se cargan las nueve que faltan (Á À È Í Ï Ó Ò Ú €) y se
;  ven tal cual. Las tablas a437, base, marca y unicode se han sacado de la
;  858 con Python (unicodedata); «base» es la letra sin tilde y «marca», la
;  tilde que se le pone encima en las impresoras que no la tienen.
; =============================================================================

video:
        mov ah, 0x0F
        int 0x10
        mov [modo], al
        mov word [vseg], 0xB800
        mov si, atr_color
        cmp al, 7
        je .mono
        cmp al, 2
        je .v
        cmp al, 3
        je .v
        mov ax, 3                   ; (otro modo: el de texto de 80 columnas)
        int 0x10
        mov byte [modo], 3
        jmp short .v
.mono:
        mov word [vseg], 0xB000
        mov si, atr_mono
.v:
        mov di, atributos
        mov cx, 8
        rep movsb
        ; ¿EGA o VGA, con letras de 14 o 16 filas? Se cargan las que faltan
        mov ah, 0x12
        mov bl, 0x10
        int 0x10
        cmp bl, 0x10
        je .x
        push es
        mov ax, 0x40
        mov es, ax
        mov bh, [es:0x85]
        pop es
        cmp bh, 14
        je .carga
        cmp bh, 16
        jne .x
.carga:
        mov si, glifos
.g:
        lodsb
        test al, al
        jz .hecho
        mov dl, al
        mov dh, 0
        mov bp, si
        push si
        push bx
        mov ax, 0x1100
        mov bl, 0
        mov cx, 1
        int 0x10
        pop bx
        pop si
        add si, 16
        jmp .g
.hecho:
        mov byte [letras_ok], 1
.x:
        jmp forma_cursor

tablas:
        mov si, a437                ; las letras para la pantalla
        mov di, vis
        xor bx, bx
.v:
        mov al, [a437+bx]
        test al, al
        jnz .v1
        mov al, [base+bx]
        test al, al
        jnz .v1
        mov al, '?'
.v1:
        mov [vis+bx], al
        inc bx
        cmp bx, 128
        jb .v
        mov byte [vis+C_EURO-0x80], 0xEE   ; (€ como ε, si no hay letras)
        cmp byte [letras_ok], 0
        je .p
        mov si, glifos
.g:
        lodsb
        test al, al
        jz .p
        mov bl, al
        mov bh, 0
        mov [vis+bx-0x80], al
        add si, 16
        jmp .g
.p:
        xor bx, bx                  ; para buscar: sin tildes y en mayúscula
.c:
        mov al, bl
        cmp al, 0x80
        jb .m
        cmp al, 0xA4                ; (la ñ se queda: es otra letra)
        je .n
        cmp al, 0xA5
        je .n
        mov al, [base+bx-0x80]
        test al, al
        jnz .m
        mov al, bl
        jmp short .pon
.n:
        mov al, 0xA5
        jmp short .pon
.m:
        cmp al, 'a'
        jb .pon
        cmp al, 'z'
        ja .pon
        sub al, 32
.pon:
        mov [pliega+bx], al
        inc bl
        jnz .c
        ret

