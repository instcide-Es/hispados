REM CONFIG.SYS de Hispa-DOS (disquete de arranque)
REM
REM Menú: 1 arrancar sin instalar (solo, a los 10 s), 2 instalar en el disco
REM duro; luego, la configuración (a los 5 s, «Normal»). F5 = arranque
REM limpio, F8 = línea a línea. La elegida queda en la variable CONFIG.
REM Más en docs/HSPEMM.md, docs/HSPSB.md y docs/USB.md. Ojo: el núcleo lee
REM los primeros 4 KB de este archivo.
[menu]
REM [SOLO-MEDIO: de aquí a la otra marca, el primer menú; INSTALAR lo
REM quita al copiar este archivo al disco duro
SUBMENU=ARRANCAR,Arrancar Hispa-DOS sin instalar
MENUITEM=INSTALAR,Instalar Hispa-DOS en el disco duro
MENUDEFAULT=ARRANCAR,10
[ARRANCAR]
REM SOLO-MEDIO]
MENUITEM=NORMAL,Normal
MENUITEM=JUEGOS,Juegos (memoria expandida EMS y la mayor memoria libre)
MENUITEM=PRUEBA,Prueba del equipo y del sonido (guarda un informe)
MENUITEM=JUEGOSSE,Juegos sin EMS (más memoria libre; para los que no piden EMS)
MENUDEFAULT=NORMAL,5

[common]
REM Memoria extendida (XMS); el núcleo va en la memoria alta (HMA).
DEVICE=A:\HISPADOS\HSPXMS.SYS

[normal]
REM ---- Normal: modo real; funciona todo (CD en SATA, HD Audio, Windows
REM en modo 386 mejorado). ----
DOS=HIGH
DEVICE=A:\HISPADOS\HSPCD.SYS
REM USB propio (memorias, teclado, ratón, mandos). Sin opciones no toca el
REM USB que use la BIOS, salvo sin ratón PS/2 (MacBook), donde lo lleva él.
DEVICE=A:\HISPADOS\HSPUSB.SYS
REM /F le quita el USB a la BIOS; /INFO dice lo que encuentra:
REM DEVICE=A:\HISPADOS\HSPUSB.SYS /F /INFO

[juegos]
REM ---- Juegos: EMS, VCPI (DOS/4GW) y memoria superior para los
REM controladores. Modo V86: sin CD en SATA ni Windows 386 mejorado (use
REM «Normal»). Sin Sound Blaster, HSPSND /SB (AUTOEXEC.BAT) la emula. ----
DEVICE=A:\HISPADOS\HSPEMM.SYS
DOS=HIGH,UMB
DEVICEHIGH=A:\HISPADOS\HSPCD.SYS
DEVICEHIGH=A:\HISPADOS\HSPUSB.SYS
REM Mandos de juego USB: añada /F a HSPUSB. Si un juego que busca pantalla
REM monocromo se cuelga, añada X=B000-B7FF a HSPEMM (más zonas: I=E000-EFFF;
REM si luego falla el arranque, quítelo; F5 arranca en limpio).

[juegosse]
REM ---- Juegos sin EMS: como «Juegos», pero HSPEMM sin marco EMS (NOEMS):
REM esos 64 KB son memoria superior (con HD Audio o AC'97, unos 56 KB más de
REM convencional). Siguen VCPI y la Sound Blaster emulada. ----
DEVICE=A:\HISPADOS\HSPEMM.SYS NOEMS
DOS=HIGH,UMB
DEVICEHIGH=A:\HISPADOS\HSPCD.SYS
DEVICEHIGH=A:\HISPADOS\HSPUSB.SYS

[prueba]
REM ---- Prueba del equipo y del sonido: sin controladores de sonido ni
REM residentes (informe en \INFORMES\EQUIPOnn). ----
DOS=HIGH

REM [SOLO-MEDIO
[INSTALAR]
REM El programa de instalación (INSTALAR /SETUP, en AUTOEXEC.BAT)
INCLUDE=NORMAL
REM SOLO-MEDIO]

[common]
NUMLOCK=ON
FILES=30
BUFFERS=20
LASTDRIVE=Z
