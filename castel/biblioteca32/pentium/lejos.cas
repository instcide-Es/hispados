; lejos.cas (Hispa-Pentium) - la memoria «lejana» de biblioteca/lejos.cas para
; los programas del anillo 3 de Hispa-Pentium («modelo usuario»): la misma
; forma de usarla, con la memoria plana. Un bloque se pide al núcleo con
; más_memoria() y lo que se da es su PÁRRAFO (su dirección entre 16), un
; Segmento de 32 bits: se lee y se escribe con leer_byte, poner_byte,
; leer_palabra y poner_palabra, que en 32 bits son la memoria «por párrafos»
; (CASTEL32.md §5). Así, lo escrito para 16 bits (el compilador CASTEL, el
; ensamblador ENSAMBLA) corre igual aquí, y con megas en vez de 640 K.
módulo Lejos

    importar Llamadas

    público tipo Segmento = nat32

    ; pide un bloque de tantos párrafos (0x1000 son 64 K). Devuelve su
    ; párrafo, o 0 si no hay tanta memoria. Viene a cero.
    público función pedir(párrafos: nat16): Segmento
        variable p: puntero a byte
        si párrafos = 0 entonces devolver 0 fin
        p := más_memoria(nat32(párrafos) * 16 + 16)
        si p = nulo entonces devolver 0 fin
        devolver (nat32(p) + 15) >> 4
    fin

    ; cuántos párrafos tiene el mayor bloque que se puede pedir ahora (lo más
    ; que cabe en un nat16)
    público función mayor_bloque(): nat16
        variable libres: nat32
        libres := dato(DATO_MARCOS_LIBRES)
        si libres >= 256 entonces devolver 0xFFFF fin
        devolver nat16(libres * 256)
    fin

    ; (el núcleo da la memoria seguida, detrás de la que ya hay: un bloque de
    ; en medio no se puede devolver; se queda para el programa)
    público función devolver_bloque(seg: Segmento)
    fin

    ; pone a cero las primeras «palabras» palabras de un bloque
    público función borrar_bloque(seg: Segmento, palabras: nat16)
        variable i: nat32
        i := 0
        mientras palabras > 0 hacer
            poner_palabra(seg, i, 0)
            i := i + 2
            palabras := palabras - 1
        fin
    fin

fin Lejos.
