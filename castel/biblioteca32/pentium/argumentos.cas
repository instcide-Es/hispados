; argumentos.cas (Hispa-Pentium) - los argumentos de biblioteca/argumentos.cas
; para los programas del anillo 3 de Hispa-Pentium: lo que se escribió
; detrás del nombre del programa, que el núcleo le da con la llamada 14
; (Llamadas.argumentos), partido en palabras separadas por espacios o
; tabuladores. La misma forma de usarlo que en DOS.
módulo Argumentos

    importar Llamadas

    constante CABE = 260
    variable línea: arreglo [CABE] de byte
    variable leída: bool

    función es_blanco(c: byte): bool
        devolver c = ' ' o c = '\t'
    fin

    función acaba(c: byte): bool
        devolver c = '\r' o c = 0
    fin

    ; la línea de órdenes entera, tal cual (acabada en 0)
    público función línea_de_órdenes(): puntero a byte
        si no leída entonces
            argumentos(línea, CABE)
            leída := cierto
        fin
        devolver línea
    fin

    público función cuántos_argumentos(): nat16
        variable p: puntero a byte
        variable n: nat16
        p := línea_de_órdenes()
        n := 0
        mientras cierto hacer
            mientras es_blanco(valor(p)) hacer
                p := p + 1
            fin
            si acaba(valor(p)) entonces devolver n fin
            n := n + 1
            mientras no es_blanco(valor(p)) y no acaba(valor(p)) hacer
                p := p + 1
            fin
        fin
        devolver n
    fin

    ; copia en destino el argumento número n (el primero es el 1), acabado en
    ; 0; «cabe» es el sitio que hay, con el 0. Da falso si no hay tantos.
    público función argumento(n: nat16, destino: puntero a byte, cabe: nat16): bool
        variable p: puntero a byte
        variable i: nat16
        p := línea_de_órdenes()
        valor(destino) := 0
        si n = 0 o cabe = 0 entonces devolver falso fin
        mientras cierto hacer
            mientras es_blanco(valor(p)) hacer
                p := p + 1
            fin
            si acaba(valor(p)) entonces devolver falso fin
            n := n - 1
            si n = 0 entonces romper fin
            mientras no es_blanco(valor(p)) y no acaba(valor(p)) hacer
                p := p + 1
            fin
        fin
        i := 0
        mientras no es_blanco(valor(p)) y no acaba(valor(p)) hacer
            si i + 1 < cabe entonces
                destino[i] := valor(p)
                i := i + 1
            fin
            p := p + 1
        fin
        destino[i] := 0
        devolver cierto
    fin

    ; la ruta del archivo del programa: Hispa-Pentium no se la dice a los
    ; programas (da falso, con destino vacío)
    público función ruta_del_programa(destino: puntero a byte, cabe: nat16): bool
        si cabe > 0 entonces valor(destino) := 0 fin
        devolver falso
    fin

fin Argumentos.
