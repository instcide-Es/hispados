; =============================================================================
;  castel.cas - CASTEL, el compilador de Castel escrito en Castel.
;  Corre dentro de Hispa-8086 (o de cualquier DOS): lee un programa en Castel
;  (y los módulos que importa) y saca el mismo ensamblador que ccastel.py,
;  letra a letra. Con ENSAMBLA (ensamblador/ensambla.cas) da el programa.
;
;      CASTEL ENTRADA.CAS [-o SALIDA.ASM] [-I CARPETA]... [--todo] [--gasto]
;
;  Sin -o, deja ENTRADA.ASM. -I: una carpeta más donde buscar módulos (los
;  busca también en la del programa y en la del propio CASTEL). --todo: no
;  deja fuera lo que no se usa (para las pruebas). --gasto: dice al acabar
;  cuánta memoria ha gastado. Acaba con el nivel de
;  error 1 si el programa tiene un error (lo dice con su archivo, su línea y
;  su columna, igual que ccastel.py) y con 2 si se le llama mal.
;
;  Es ccastel.py pasado a Castel, parte por parte:
;      base.cas        los nombres, los textos, el árbol y los errores
;      lexico.cas      1. el lector (análisis léxico)
;      sintactico.cas  2. la gramática (el árbol) y 5. los archivos (módulos)
;      cuentas.cas     las cuentas con constantes (64 bits)
;      tablas.cas      los tipos y lo declarado
;      tipos.cas       3. los tipos y las comprobaciones
;      salida.cas      las líneas que se generan y su limpieza
;      expr.cas        4. generar: lugares, expresiones y llamadas
;      sent.cas        4. generar: sentencias y funciones
;      apoyo.cas       las rutinas de apoyo (las de ccastel.py)
;      programa.cas    el programa entero: declarar, generar, qué va y escribirlo
;  Es un programa de «modelo grande» (un .EXE: cada módulo en su segmento) y
;  sus tablas van en memoria lejana. Ver docs/CASTEL.md y el README.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Castel

    modelo grande

    importar Base, Tablas, Salida, Sintactico, Programa, Argumentos, Textos

    variable entrada: arreglo [80] de byte
    variable salida: arreglo [80] de byte
    variable arg_: arreglo [80] de byte

    función uso(): byte
        escribir("uso: CASTEL ENTRADA.CAS [-o SALIDA.ASM] [-I CARPETA]... [--todo]\r\n")
        devolver 2
    fin

    función principal(): byte
        variable i, n: nat16
        variable todo, gasto: bool
        variable p: puntero a byte
        prepara_base()
        prepara_tablas()
        prepara_salida()
        todo := falso
        gasto := falso
        n := cuántos_argumentos()
        i := 1
        mientras i <= n hacer
            argumento(i, arg_, 80)
            si iguales_sin_caja(arg_, "-o") y i < n entonces
                argumento(i + 1, salida, 80)
                i := i + 2
            sino si iguales_sin_caja(arg_, "-i") y i < n entonces
                argumento(i + 1, arg_, 80)
                añade_carpeta(arg_)
                i := i + 2
            sino si (arg_[0] = '-') y (arg_[1] = 'I' o arg_[1] = 'i') y arg_[2] <> 0 entonces
                añade_carpeta(dirección(arg_[2]))
                i := i + 1
            sino si iguales_sin_caja(arg_, "--todo") entonces
                todo := cierto
                i := i + 1
            sino si iguales_sin_caja(arg_, "--gasto") entonces
                gasto := cierto
                i := i + 1
            sino si entrada[0] = 0 y arg_[0] <> '-' entonces
                copiar(entrada, arg_)
                i := i + 1
            sino
                devolver uso()
            fin
        fin
        si entrada[0] = 0 entonces devolver uso() fin
        si salida[0] = 0 entonces
            ; el mismo nombre, con .ASM
            copiar(salida, entrada)
            p := nulo
            para i desde 0 hasta longitud(salida) hacer
                si salida[i] = '.' entonces p := dirección(salida[i]) fin
                si salida[i] = '\\' o salida[i] = ':' entonces p := nulo fin
            fin
            si p <> nulo entonces valor(p) := 0 fin
            concatenar(salida, ".ASM")
        fin
        carga_programa(entrada)
        compila(entrada, salida, todo, gasto)
        devolver 0
    fin

fin Castel.
