    fin

    público función l64_apoyo_texto(i: nat16): puntero a byte
        devolver nulo
    fin

    público función l64_arranque(): puntero a byte
        devolver nulo
    fin

    público función l64_arranque_datos(): puntero a byte
        devolver nulo
    fin

    público constante T64_PUSH_RBP = 0
    público constante T64_MOV_RBP_RSP = 1
    público constante T64_SUB_RSP = 2
    público constante T64_MOV_RSP_RBP = 3
    público constante T64_POP_RBP = 4
    público constante T64_IRETQ = 5
    público constante T64_ADD_RSP_8 = 6
    público constante T64_PUSH_RAX = 7
    público constante T64_POP_RAX = 8
