módulo Caso
    ensamblador      ; con comentario
    fin
    ensamblador

        mov ax, 1   ; fin
    etiqueta:
    fin ; el fin, con comentario
    función principal()
        ensamblador
            nop
        fin
        si cierto entonces ensamblador
            cli
          fin fin
    fin
fin Caso.
