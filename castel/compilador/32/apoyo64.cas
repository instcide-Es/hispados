; =============================================================================
;  apoyo64.cas - [CASTEL64] las rutinas de apoyo de los programas de 64 bits
;  (modelo linux64, núcleo64 y hispa64, CASTEL64.md) y su arranque. NO editar a mano: lo
;  escribe compilador/haz_apoyo.py con el texto de APOYO64, APOYO_LINUX64,
;  APOYO_NUCLEO64, APOYO_HISPA64 y ARRANQUE64 de ccastel.py, para que los dos compiladores
;  pongan lo mismo, letra a letra.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Apoyo64

    público constante N_APOYO_LINUX64 = 6
    público constante N_APOYO_NÚCLEO64 = 7
    público constante N_APOYO_HISPA64 = 7
    constante LN_0 = "escribir_num"
    constante LT_0 = "; escribir_num: ense\xC3\xB1a RAX como entero con signo, en decimal\nescribir_num:\n    test rax, rax\n    jns escribir_nat\n    push rax\n    mov al, \'-\'\n    call escribir_car\n    pop rax\n    neg rax\n"
    constante LN_1 = "escribir_nat"
    constante LT_1 = "; escribir_nat: ense\xC3\xB1a RAX como natural, en decimal\nescribir_nat:\n    sub rsp, 24\n    lea rdi, [rsp+24]\n    mov ebx, 10\n.cifra:\n    xor edx, edx\n    div rbx\n    add dl, \'0\'\n    dec rdi\n    mov [rdi], dl\n    test rax, rax\n    jnz .cifra\n    mov rsi, rdi\n    lea rcx, [rsp+24]\n    sub rcx, rdi\n    call castel_salida\n    add rsp, 24\n    ret\n"
    constante LN_2 = "escribir_cad"
    constante LT_2 = "; escribir_cad: ense\xC3\xB1a el texto acabado en 0 que hay en RSI\nescribir_cad:\n    xor ecx, ecx\n.mide:\n    cmp byte [rsi+rcx], 0\n    je .va\n    inc rcx\n    jmp .mide\n.va:\n    jmp castel_salida\n"
    constante LN_3 = "escribir_car"
    constante LT_3 = "; escribir_car: ense\xC3\xB1a la letra que hay en AL\nescribir_car:\n    push rax\n    mov rsi, rsp\n    mov ecx, 1\n    call castel_salida\n    pop rax\n    ret\n"
    constante LN_4 = "castel_salida"
    constante LT_4 = "; castel_salida: escribe RCX octetos desde RSI en la salida (la llamada 1 de\n; Linux, write, hasta que vayan todos)\ncastel_salida:\n    test rcx, rcx\n    jz .fin\n    push rcx\n    push rsi\n    mov eax, 1\n    mov edi, 1\n    mov rdx, rcx\n    syscall\n    pop rsi\n    pop rcx\n    test rax, rax\n    jle .fin\n    add rsi, rax\n    sub rcx, rax\n    jmp castel_salida\n.fin:\n    ret\n"
    constante LN_5 = "castel_salir"
    constante LT_5 = "; castel_salir: el programa acaba con el c\xC3\xB3digo de AL (la llamada 231 de Linux,\n; exit_group)\ncastel_salir:\n    movzx edi, al\n    mov eax, 231\n    syscall\n.para:\n    jmp .para\n"
    constante NN_0 = "escribir_num"
    constante NT_0 = "; escribir_num: ense\xC3\xB1a RAX como entero con signo, en decimal\nescribir_num:\n    test rax, rax\n    jns escribir_nat\n    push rax\n    mov al, \'-\'\n    call escribir_car\n    pop rax\n    neg rax\n"
    constante NN_1 = "escribir_nat"
    constante NT_1 = "; escribir_nat: ense\xC3\xB1a RAX como natural, en decimal\nescribir_nat:\n    sub rsp, 24\n    lea rdi, [rsp+24]\n    mov ebx, 10\n.cifra:\n    xor edx, edx\n    div rbx\n    add dl, \'0\'\n    dec rdi\n    mov [rdi], dl\n    test rax, rax\n    jnz .cifra\n    mov rsi, rdi\n    lea rcx, [rsp+24]\n    sub rcx, rdi\n    call castel_salida\n    add rsp, 24\n    ret\n"
    constante NN_2 = "escribir_cad"
    constante NT_2 = "; escribir_cad: ense\xC3\xB1a el texto acabado en 0 que hay en RSI\nescribir_cad:\n    xor ecx, ecx\n.mide:\n    cmp byte [rsi+rcx], 0\n    je .va\n    inc rcx\n    jmp .mide\n.va:\n    jmp castel_salida\n"
    constante NN_3 = "escribir_car"
    constante NT_3 = "; escribir_car: ense\xC3\xB1a la letra que hay en AL\nescribir_car:\n    push rax\n    mov rsi, rsp\n    mov ecx, 1\n    call castel_salida\n    pop rax\n    ret\n"
    constante NN_4 = "castel_salida"
    constante NT_4 = "; castel_salida: escribe RCX octetos desde RSI (puerto serie y pantalla)\ncastel_salida:\n    test rcx, rcx\n    jz .fin\n.otra:\n    lodsb\n    call castel_pon_car\n    dec rcx\n    jnz .otra\n.fin:\n    ret\n"
    constante NN_5 = "castel_pon_car"
    constante NT_5 = "; castel_pon_car: la letra de AL, al puerto serie COM1 y a la pantalla de texto\n; (con su cursor, C_cursor, y subiendo las l\xC3\xADneas al llegar abajo). Lo conserva todo.\ncastel_pon_car:\n    push rdx\n    push rax\n    mov edx, 0x3FD\n.espera:\n    in al, dx\n    test al, 0x20\n    jz .espera\n    pop rax\n    push rax\n    mov edx, 0x3F8\n    out dx, al\n    mov edx, [C_cursor]\n    cmp al, 10\n    je .nueva\n    cmp al, 13\n    je .principio\n    mov ah, 7\n    mov [rdx*2+0xB8000], ax\n    inc edx\n    jmp .mira\n.nueva:\n    add edx, 80\n.principio:\n    push rcx\n    mov eax, edx\n    xor edx, edx\n    mov ecx, 80\n    div ecx\n    imul edx, eax, 80\n    pop rcx\n.mira:\n    cmp edx, 2000\n    jb .bien\n    push rsi\n    push rdi\n    push rcx\n    mov esi, 0xB80A0\n    mov edi, 0xB8000\n    mov ecx, 960\n    rep movsd\n    mov eax, 0x07200720\n    mov ecx, 40\n    rep stosd\n    pop rcx\n    pop rdi\n    pop rsi\n    sub edx, 80\n.bien:\n    mov [C_cursor], edx\n    push rbx\n    mov ebx, edx\n    mov edx, 0x3D4\n    mov al, 0x0F\n    out dx, al\n    inc edx\n    mov al, bl\n    out dx, al\n    dec edx\n    mov al, 0x0E\n    out dx, al\n    inc edx\n    mov al, bh\n    out dx, al\n    pop rbx\n    pop rax\n    pop rdx\n    ret\n"
    constante NN_6 = "castel_salir"
    constante NT_6 = "; castel_salir: el programa acaba (con el c\xC3\xB3digo de AL): se dice por el puerto\n; 0xF4 (en QEMU, el dispositivo isa-debug-exit) y el procesador se para\ncastel_salir:\n    mov edx, 0xF4\n    out dx, al\n    cli\n.para:\n    hlt\n    jmp .para\n"
    constante HN_0 = "escribir_num"
    constante HT_0 = "; escribir_num: ense\xC3\xB1a RAX como entero con signo, en decimal\nescribir_num:\n    test rax, rax\n    jns escribir_nat\n    push rax\n    mov al, \'-\'\n    call escribir_car\n    pop rax\n    neg rax\n"
    constante HN_1 = "escribir_nat"
    constante HT_1 = "; escribir_nat: ense\xC3\xB1a RAX como natural, en decimal\nescribir_nat:\n    sub rsp, 24\n    lea rdi, [rsp+24]\n    mov ebx, 10\n.cifra:\n    xor edx, edx\n    div rbx\n    add dl, \'0\'\n    dec rdi\n    mov [rdi], dl\n    test rax, rax\n    jnz .cifra\n    mov rsi, rdi\n    lea rcx, [rsp+24]\n    sub rcx, rdi\n    call castel_salida\n    add rsp, 24\n    ret\n"
    constante HN_2 = "escribir_cad"
    constante HT_2 = "; escribir_cad: ense\xC3\xB1a el texto acabado en 0 que hay en RSI\nescribir_cad:\n    xor ecx, ecx\n.mide:\n    cmp byte [rsi+rcx], 0\n    je .va\n    inc rcx\n    jmp .mide\n.va:\n    jmp castel_salida\n"
    constante HN_3 = "escribir_car"
    constante HT_3 = "; escribir_car: ense\xC3\xB1a la letra que hay en AL\nescribir_car:\n    push rax\n    mov rsi, rsp\n    mov ecx, 1\n    call castel_salida\n    pop rax\n    ret\n"
    constante HN_4 = "castel_salida"
    constante HT_4 = "; castel_salida: escribe RCX octetos desde RSI (puerto serie y consola)\ncastel_salida:\n    test rcx, rcx\n    jz .fin\n.otra:\n    lodsb\n    call castel_pon_car\n    dec rcx\n    jnz .otra\n.fin:\n    ret\n"
    constante HN_5 = "castel_pon_car"
    constante HT_5 = "; castel_pon_car: la letra de AL, al puerto serie COM1 (si no est\xC3\xA1, no se\n; espera: se da por perdida) y a la funci\xC3\xB3n de C_consola, si la hay, que la\n; recibe como su par\xC3\xA1metro (una funci\xC3\xB3n de Castel: lo quita ella). Lo conserva todo.\ncastel_pon_car:\n    push rdx\n    push rcx\n    push rax\n    mov edx, 0x3FD\n    mov ecx, 100000\n.espera:\n    in al, dx\n    test al, 0x20\n    jnz .va\n    dec ecx\n    jnz .espera\n.va:\n    pop rax\n    push rax\n    mov edx, 0x3F8\n    out dx, al\n    cmp qword [C_consola], 0\n    je .fin\n    push rbx\n    push rsi\n    push rdi\n    movzx eax, al\n    push rax\n    call [C_consola]\n    pop rdi\n    pop rsi\n    pop rbx\n.fin:\n    pop rax\n    pop rcx\n    pop rdx\n    ret\n"
    constante HN_6 = "castel_salir"
    constante HT_6 = "; castel_salir: el n\xC3\xBAcleo acaba (con el c\xC3\xB3digo de AL): se dice por el puerto\n; 0xF4 (en QEMU, el dispositivo isa-debug-exit) y el procesador se para\ncastel_salir:\n    mov edx, 0xF4\n    out dx, al\n    cli\n.para:\n    hlt\n    jmp .para\n"
    público constante ARRANQUE_LINUX64 = "; Ensamblar:  nasm -f bin ESTE.asm -o PROGRAMA\n; -----------------------------------------------------------------\ncpu x64\nbits 64\norg 0x400000\n; un programa de Linux para x86-64: un ELF est\xC3\xA1tico, con las cabeceras a mano\n; y un solo trozo (c\xC3\xB3digo, datos y, detr\xC3\xA1s, lo que empieza a cero) en 0x400000\nC_ini:\n    db 0x7F, 69, 76, 70, 2, 1, 1, 0\n    dd 0, 0\n    dw 2, 0x3E\n    dd 1\n    dq C_arranque\n    dq C_prog-C_ini\n    dq 0\n    dd 0\n    dw 64, 56, 1, 0, 0, 0\nC_prog:\n    dd 1, 7\n    dq 0, C_ini, C_ini\n    dq _datos_fin-C_ini\n    dq _vacio_fin-C_ini\n    dq 0x1000\nC_arranque:\n    mov [C_pila_linux], rsp\n    mov esp, C_pila_fin\n    cld\n"
    público constante ARRANQUE_LINUX64_DATOS = "; d\xC3\xB3nde dej\xC3\xB3 Linux la pila: el n\xC3\xBAmero de argumentos, los argumentos (y el entorno)\n    align 8, db 0\nC_pila_linux:\n    dq 0\n    align 8, db 0\n_datos_fin:\n\n; ---- sin valor inicial: no van en el archivo; a cero al arrancar ----\n_vacio:\n    absolute _vacio\nC_pila:\n    resb 16777216\nC_pila_fin:\n"
    público constante ARRANQUE_NUCLEO64 = "; Ensamblar:  nasm -f bin ESTE.asm -o NUCLEO64.BIN\n; -----------------------------------------------------------------\ncpu x64\nbits 32\norg 0x100000\n; un n\xC3\xBAcleo de 64 bits: lo carga QEMU con -kernel (multiboot) o GRUB\n; (multiboot2), en modo protegido de 32 bits; el arranque pone la paginaci\xC3\xB3n\n; de cuatro niveles (los 4 primeros GB, tal cual, con p\xC3\xA1ginas de 2 MB) y pasa\n; al modo largo. Las tablas de p\xC3\xA1ginas van en 0x70000 (seis p\xC3\xA1ginas).\nC_ini:\n    jmp C_arranque\n    align 4, db 0\nC_multiboot:\n    dd 0x1BADB002\n    dd 0x00010000\n    dd 0xE4514FFE\n    dd C_multiboot\n    dd C_ini\n    dd _datos_fin\n    dd _vacio_fin\n    dd C_arranque\n    align 8, db 0\nC_multiboot2:\n    dd 0xE85250D6, 0\n    dd C_mb2_fin-C_multiboot2\n    dd 0x100000000-0xE85250D6-(C_mb2_fin-C_multiboot2)\n    dw 2, 0\n    dd 24\n    dd C_multiboot2, C_ini, _datos_fin, _vacio_fin\n    dw 3, 0\n    dd 12\n    dd C_arranque\n    dd 0\n    dw 0, 0\n    dd 8\nC_mb2_fin:\n; la tabla de descriptores: c\xC3\xB3digo de 64 bits (0x08) y datos (0x10)\nC_gdt:\n    dd 0, 0\n    dd 0x0000FFFF, 0x00AF9A00\n    dd 0x0000FFFF, 0x00CF9200\nC_gdtr:\n    dw 23\n    dq C_gdt\nC_mb_magia:\n    dd 0\nC_mb_info:\n    dd 0\nC_cursor:\n    dd 0\nC_arranque:\n    cli\n    mov [C_mb_magia], eax\n    mov [C_mb_info], ebx\n    cld\n    mov edi, _vacio\n    mov ecx, _vacio_fin-_vacio\n    xor eax, eax\n    rep stosb\n    mov edi, 0x70000\n    mov ecx, 6144\n    rep stosd\n    mov dword [0x70000], 0x71003\n    mov dword [0x71000], 0x72003\n    mov dword [0x71008], 0x73003\n    mov dword [0x71010], 0x74003\n    mov dword [0x71018], 0x75003\n    mov edi, 0x72000\n    mov eax, 0x83\n    xor edx, edx\n    mov ecx, 2048\n.pd:\n    mov [edi], eax\n    mov [edi+4], edx\n    add eax, 0x200000\n    adc edx, 0\n    add edi, 8\n    loop .pd\n    mov eax, cr4\n    or eax, 0x20\n    mov cr4, eax\n    mov eax, 0x70000\n    mov cr3, eax\n    mov ecx, 0xC0000080\n    rdmsr\n    or eax, 0x100\n    wrmsr\n    mov eax, cr0\n    or eax, 0x80000001\n    mov cr0, eax\n    lgdt [C_gdtr]\n    jmp 0x08:C_largo\nbits 64\nC_largo:\n    mov ax, 0x10\n    mov ds, ax\n    mov es, ax\n    mov fs, ax\n    mov gs, ax\n    mov ss, ax\n    mov esp, C_pila_fin\n; la pantalla, en blanco; y el puerto serie COM1 a 115200, 8N1\n    mov edi, 0xB8000\n    mov ecx, 1000\n    mov eax, 0x07200720\n    rep stosd\n    mov edx, 0x3F9\n    xor al, al\n    out dx, al\n    mov edx, 0x3FB\n    mov al, 0x80\n    out dx, al\n    mov edx, 0x3F8\n    mov al, 1\n    out dx, al\n    mov edx, 0x3F9\n    xor al, al\n    out dx, al\n    mov edx, 0x3FB\n    mov al, 3\n    out dx, al\n    mov edx, 0x3FA\n    mov al, 0xC7\n    out dx, al\n    mov edx, 0x3FC\n    mov al, 3\n    out dx, al\n"
    público constante ARRANQUE_NUCLEO64_DATOS = "    align 8, db 0\n_datos_fin:\n\n; ---- sin valor inicial: no van en el archivo; a cero al arrancar ----\n_vacio:\n    absolute _vacio\nC_pila:\n    resb 65536\nC_pila_fin:\n"
    público constante ARRANQUE_HISPA64 = "; Ensamblar:  nasm -f bin ESTE.asm -o HISPA64.BIN\n; -----------------------------------------------------------------\ncpu x64\nbits 32\norg 0x100000\n; Hispa-64 (docs/64/HISPA-64.md): multiboot2 (GRUB) o multiboot (QEMU -kernel)\nC_ini:\n    jmp C_arranque\n    align 4, db 0\nC_multiboot:\n    dd 0x1BADB002\n    dd 0x00010000\n    dd 0xE4514FFE\n    dd C_multiboot\n    dd C_ini\n    dd _datos_fin\n    dd _vacio_fin\n    dd C_arranque\n    align 8, db 0\nC_multiboot2:\n    dd 0xE85250D6, 0\n    dd C_mb2_fin-C_multiboot2\n    dd 0x100000000-0xE85250D6-(C_mb2_fin-C_multiboot2)\n    dw 2, 0\n    dd 24\n    dd C_multiboot2, C_ini, _datos_fin, _vacio_fin\n    dw 3, 0\n    dd 12\n    dd C_arranque\n    dd 0\n    dw 5, 1\n    dd 20\n    dd 0, 0, 32\n    dd 0\n    dw 0, 0\n    dd 8\nC_mb2_fin:\nC_gdt:\n    dd 0, 0\n    dd 0x0000FFFF, 0x00AF9A00\n    dd 0x0000FFFF, 0x00CF9200\nC_gdtr:\n    dw 23\n    dq C_gdt\nC_mb_magia:\n    dd 0\nC_mb_info:\n    dd 0\nC_consola:\n    dq 0\nC_no64:\n    db 13, 10, \'Hispa-64: el procesador no es de 64 bits. Use Hispa-Pentium.\', 13, 10, 0\nC_com1:\n    db 2, 0, 4, 0x80, 1, 1, 2, 0, 4, 3, 3, 0xC7, 5, 3, 0\nC_arranque:\n    cli\n    cld\n    mov [C_mb_magia], eax\n    mov [C_mb_info], ebx\n    mov edi, _vacio\n    mov ecx, _vacio_fin-_vacio\n    xor eax, eax\n    rep stosb\n; COM1 a 115200, 8N1 (C_com1: registro + 1 y valor)\n    mov esi, C_com1\n.com1:\n    movzx edx, byte [esi]\n    test edx, edx\n    jz .com1_ya\n    add edx, 0x3F7\n    mov al, [esi+1]\n    out dx, al\n    add esi, 2\n    jmp .com1\n.com1_ya:\n; \xC2\xBFhay modo largo? (CPUID 80000001h, EDX bit 29)\n    mov eax, 0x80000000\n    cpuid\n    cmp eax, 0x80000001\n    jb .no64\n    mov eax, 0x80000001\n    cpuid\n    test edx, 0x20000000\n    jnz .si64\n.no64:\n    mov esi, C_no64\n.letra:\n    mov ah, [esi]\n    test ah, ah\n    jz .para\n    inc esi\n    mov edx, 0x3FD\n    mov ecx, 100000\n.espera:\n    in al, dx\n    test al, 0x20\n    jnz .sale\n    dec ecx\n    jnz .espera\n.sale:\n    mov al, ah\n    mov edx, 0x3F8\n    out dx, al\n    jmp .letra\n.para:\n    hlt\n    jmp .para\n; las tablas: 64 GB tal cual y en la mitad alta (PML4 0 y 256), p\xC3\xA1ginas de 2 MB\n.si64:\n    mov edi, C_tablas\n    lea eax, [edi+0x1003]\n    mov [edi], eax\n    mov [edi+2048], eax\n    lea ebx, [edi+0x1000]\n    lea eax, [edi+0x2003]\n    mov ecx, 64\n.pdpt:\n    mov [ebx], eax\n    add eax, 0x1000\n    add ebx, 8\n    loop .pdpt\n    lea ebx, [edi+0x2000]\n    mov eax, 0x83\n    xor edx, edx\n    mov ecx, 32768\n.pd:\n    mov [ebx], eax\n    mov [ebx+4], edx\n    add eax, 0x200000\n    adc edx, 0\n    add ebx, 8\n    loop .pd\n    mov eax, cr4\n    or eax, 0x20\n    mov cr4, eax\n    mov eax, C_tablas\n    mov cr3, eax\n    mov ecx, 0xC0000080\n    rdmsr\n    or eax, 0x100\n    wrmsr\n    mov eax, cr0\n    or eax, 0x80000001\n    mov cr0, eax\n    lgdt [C_gdtr]\n    jmp 0x08:C_largo\nbits 64\nC_largo:\n    mov ax, 0x10\n    mov ds, ax\n    mov es, ax\n    mov fs, ax\n    mov gs, ax\n    mov ss, ax\n    mov esp, C_pila_fin\n"
    público constante ARRANQUE_HISPA64_DATOS = "    align 4096, db 0\n_datos_fin:\n\n; ---- sin valor inicial: no van en el archivo; a cero al arrancar ----\n_vacio:\n    absolute _vacio\nC_tablas:\n    resb 270336\nC_pila:\n    resb 65536\nC_pila_fin:\n"

    variable nombres_l: arreglo [N_APOYO_LINUX64] de puntero a byte = (LN_0, LN_1, LN_2, LN_3, LN_4, LN_5)
    variable textos_l: arreglo [N_APOYO_LINUX64] de puntero a byte = (LT_0, LT_1, LT_2, LT_3, LT_4, LT_5)
    variable nombres_n: arreglo [N_APOYO_NÚCLEO64] de puntero a byte = (NN_0, NN_1, NN_2, NN_3, NN_4, NN_5, NN_6)
    variable textos_n: arreglo [N_APOYO_NÚCLEO64] de puntero a byte = (NT_0, NT_1, NT_2, NT_3, NT_4, NT_5, NT_6)
    variable nombres_h: arreglo [N_APOYO_HISPA64] de puntero a byte = (HN_0, HN_1, HN_2, HN_3, HN_4, HN_5, HN_6)
    variable textos_h: arreglo [N_APOYO_HISPA64] de puntero a byte = (HT_0, HT_1, HT_2, HT_3, HT_4, HT_5, HT_6)

    ; las de linux64 (cual = 1), las de hispa64 (cual = 2) o las de núcleo64 (cual = 0)
    público función apoyo64_nombre(cual: nat16, i: nat16): puntero a byte
        si cual = 1 entonces devolver nombres_l[i] fin
        si cual = 2 entonces devolver nombres_h[i] fin
        devolver nombres_n[i]
    fin

    público función apoyo64_texto(cual: nat16, i: nat16): puntero a byte
        si cual = 1 entonces devolver textos_l[i] fin
        si cual = 2 entonces devolver textos_h[i] fin
        devolver textos_n[i]
    fin

fin Apoyo64.
