; =============================================================================
;  reloj64.cas - Hispa-64: los relojes (docs/64/HISPA-64.md, etapa 2), sin
;  fiarse del 8254 (los Intel de ahora lo tienen parado, como el Monovate):
;    - el HPET (de la tabla HPET de ACPI): un contador de 64 bits, de 10 a 100
;      MHz; es el reloj del núcleo si lo hay;
;    - si no, el reloj de ACPI (el «PM timer» de la FADT: 3,579545 MHz, de 24
;      o 32 bits), que se va sumando en 64 bits (hay que leerlo antes de que dé
;      la vuelta: 4,7 s con 24 bits);
;    - y, si no hay ninguno, el canal 2 del 8254, solo para medir 10 ms;
;    - el TSC (su frecuencia, medida con el reloj; si es invariante);
;    - la hora del CMOS (el reloj de tiempo real, con el siglo de la FADT).
;  ahora_ns() es el tiempo desde que se preparó, en nanosegundos.
;  [etapa 10 f] Con el TSC, si se puede: leer el HPET es leer un registro de un
;  dispositivo, y en una máquina virtual cada lectura sale al anfitrión (con
;  KVM anidado, de 50 a 90 µs: clock_gettime, el planificador, los plazos...,
;  todo iba así de lento). El TSC se lee sin salir (rdtsc). Vale si es
;  invariante (no cambia con la frecuencia ni se para al dormir: los equipos
;  de 2008 en adelante) o si es el de KVM con su reloj estable (pvclock con
;  PVCLOCK_TSC_STABLE_BIT: el anfitrión lo tiene igual en todos) o el de QEMU
;  sin KVM (TCG: lo saca del reloj del anfitrión; leer el HPET ahí toma el
;  cerrojo grande de QEMU, el de todos sus procesadores), y si entre
;  los procesadores no va hacia atrás (Smp64 lo prueba al encender cada uno,
;  como el «tsc warp test» de Linux). Desde que se pasa (pasa_a_tsc), la hora
;  es ns0 + (Δtsc · mult) >> 32, la misma cuenta que hace el vDSO (Vdso64) de
;  los programas; el HPET (o el de ACPI) sigue para medir y para el tic.
;  Con KVM sin el TSC estable (KVM dentro de otra máquina virtual, como el
;  servidor de las pruebas: su anfitrión va con kvm-clock), el TSC puede
;  saltar al mover el anfitrión sus procesadores: ahí, el reloj de KVM
;  (pvclock, uno por procesador: lo escribe el anfitrión en la memoria;
;  se lee con el TSC, sin salir), con lo que no deja ir hacia atrás de un
;  procesador a otro (el último dado, con cmpxchg), como hace Linux.
;  «reloj=hpet» en la línea de órdenes: sin el TSC, como antes.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Reloj64

    importar Cifras64, Pagina64, Es64, Acpi64, Cpu64, Cerrojo, PorCpu64

    público constante NINGUNO = 0
    público constante HPET = 1
    público constante PM = 2

    público variable fuente: nat32
    público variable hpet: nat64                ; dónde se ven sus registros (virtual), o 0
    público variable hpet_periodo: nat64        ; femtosegundos por cuenta
    público variable hpet_temps: nat32          ; cuántos temporizadores tiene
    público variable hpet_64: bool              ; ¿su contador es de 64 bits?
    público variable hpet_sustituye: bool       ; ¿sabe sustituir al 8254 (LegacyReplacement)?
    público variable tsc_hz: nat64              ; la frecuencia del TSC (medida)
    público variable tsc_invariante: bool
    variable pm_antes: nat32
    variable hpet_antes: nat32
    público variable hpet_32_forzado: bool      ; [etapa 10 d] «hpet32» en la línea de órdenes: como si fuera de 32 bits (las pruebas)
    variable pm_suma: nat64
    variable cuenta0: nat64
    variable cerrojo: nat64                 ; [etapa 3] el reloj de ACPI se suma en pm_suma: de uno en uno
    ; [etapa 10 f] el reloj del núcleo con el TSC
    público constante TSC_NO = 0
    público constante TSC_INVARIANTE = 1
    público constante TSC_KVM = 2
    público variable tsc_vale: nat32            ; ¿se puede usar? (TSC_NO, TSC_INVARIANTE o TSC_KVM)
    público variable tsc_prohibido: bool        ; «reloj=hpet»
    público variable tsc_forzado: bool          ; «reloj=tsc»: con el TSC aunque no se sepa si vale (las pruebas)
    público constante TSC_FORZADO = 3
    público variable con_tsc: bool              ; ahora_ns() ya va con el TSC
    público variable tsc0, ns0, tsc_mult: nat64 ; ns = ns0 + ((tsc - tsc0) · tsc_mult) >> 32
    público variable kvm_hay, kvm_estable: bool ; ¿es KVM? ¿con el TSC estable (pvclock)?
    público variable tcg_hay: bool              ; ¿es QEMU sin KVM (TCG: «TCGTCGTCGTCG»)?
    público constante TSC_TCG = 5               ; el de QEMU sin KVM
    público constante TSC_PV = 4                ; KVM sin el TSC estable: su reloj (pvclock)
    variable pv_msr: nat32                      ; el MSR del reloj de KVM (0 si no lo hay)
    público variable con_pv: bool               ; ahora_ns() ya va con el reloj de KVM
    variable pv_desfase, pv_último: nat64
    ; (lo que escribe KVM, pvclock_vcpu_time_info, 32 octetos: uno por procesador, cada 64)
    variable pvc: arreglo [520] de nat64
    público variable pv_atrás: nat64            ; las veces que uno lo ha leído por detrás del último dado

    ; la frecuencia de la fuente, en Hz
    público función hz(): nat64
        si fuente = HPET entonces devolver muldiv(1000000000, 1000000, hpet_periodo) fin
        si fuente = PM entonces devolver 3579545 fin
        devolver 0
    fin

    función lee_pm(): nat32
        variable v: nat32
        v := entra32(pm_tmr)
        si no pm_32 entonces v := v yb 0xFFFFFF fin
        devolver v
    fin

    ; las cuentas de la fuente, sin dar la vuelta
    público función cuenta(): nat64
        variable v, d: nat32
        variable b, s: nat64
        si fuente = HPET y hpet_64 entonces devolver m64(hpet + 0xF0) fin
        ; [etapa 10 d] un HPET de 32 bits (el de VirtualBox con el chipset
        ; PIIX3, por ejemplo): da la vuelta cada 5 minutos (a 14,3 MHz); se
        ; suma como el reloj de ACPI (antes se leía como si fuese de 64 bits:
        ; a los 5 minutos la hora volvía atrás y los que dormían no
        ; despertaban)
        si fuente = HPET entonces
            b := toma(dirección(cerrojo))
            v := m32(hpet + 0xF0)
            d := v - hpet_antes
            pm_suma := pm_suma + nat64(d)
            hpet_antes := v
            s := pm_suma
            suelta(dirección(cerrojo), b)
            devolver s
        fin
        si fuente = PM entonces
            b := toma(dirección(cerrojo))
            v := lee_pm()
            d := v - pm_antes
            si no pm_32 entonces d := d yb 0xFFFFFF fin
            pm_suma := pm_suma + d
            pm_antes := v
            s := pm_suma
            suelta(dirección(cerrojo), b)
            devolver s
        fin
        devolver 0
    fin

    ; [etapa 10 f] (Δtsc · tsc_mult) >> 32, con el producto en 128 bits
    público función tsc_a_ns(d: nat64): nat64
        variable m: nat64
        m := tsc_mult
        ensamblador
            mov rax, {d}
            mul qword {m}
            shr rax, 32
            shl rdx, 32
            or rax, rdx
        fin
    fin

    ; [etapa 10 f] el pvclock del procesador k (alineado a 64)
    función pv_de(k: nat32): nat64
        devolver ((nat64(dirección(pvc[0])) + 63) yb (nob nat64(63))) + nat64(k yb 63) * 64
    fin

    ; [etapa 10 f] (en cada procesador, al encenderlo) que KVM le escriba su pvclock
    público función pv_este(k: nat32)
        si pv_msr = 0 entonces devolver fin
        pon_msr(pv_msr, (pv_de(k) - base_núcleo()) ob 1)
    fin

    ; [etapa 10 f] el reloj de KVM de este procesador, en ns (como
    ; pvclock_clocksource_read de Linux: la versión, par; el TSC; lo escrito;
    ; y la versión otra vez igual)
    función lee_pv(): nat64
        variable s, r, b: nat64
        variable c: puntero a Cpu
        b := sin_ints()
        c := yo()
        s := pv_de(c.número)
        ensamblador
            mov r8, {s}
        .otra:
            mov r10d, [r8]
            test r10d, 1
            jnz .otra
            db 0x0F, 0xAE, 0xE8         ; lfence
            rdtsc
            shl rdx, 32
            or rax, rdx
            sub rax, [r8 + 8]
            movsx ecx, byte [r8 + 28]
            test ecx, ecx
            js .neg
            shl rax, cl
            jmp .escala
        .neg:
            neg ecx
            shr rax, cl
        .escala:
            mov edx, [r8 + 24]
            mul rdx
            shr rax, 32
            shl rdx, 32
            or rax, rdx
            add rax, [r8 + 16]
            db 0x0F, 0xAE, 0xE8         ; lfence
            cmp r10d, [r8]
            jne .otra
            mov {r}, rax
        fin
        restaura(b)
        devolver r
    fin

    público función ahora_ns(): nat64
        variable c, t, u: nat64
        si con_pv entonces
            t := lee_pv() + pv_desfase
            mientras cierto hacer
                u := pv_último
                si t <= u entonces
                    si t < u entonces pv_atrás := pv_atrás + 1 fin
                    devolver u
                fin
                si cambia_si(dirección(pv_último), u, t) entonces devolver t fin
            fin
        fin
        si con_tsc entonces
            t := tsc()
            ; (un procesador que lo lea un poco por detrás del que lo puso: el
            ; mismo instante; la prueba de Smp64 dice que no pasa)
            si t <= tsc0 entonces devolver ns0 fin
            devolver ns0 + tsc_a_ns(t - tsc0)
        fin
        c := cuenta() - cuenta0
        si fuente = HPET entonces devolver muldiv(c, hpet_periodo, 1000000) fin
        si fuente = PM entonces devolver muldiv(c, 1000000000, 3579545) fin
        devolver 0
    fin

    público función espera_us(us: nat64)
        variable fin_: nat64
        fin_ := ahora_ns() + us * 1000
        mientras ahora_ns() < fin_ hacer pausa() fin
    fin

    ; el HPET: lo pone a contar (sin sustituir al 8254: eso no hace falta)
    función pon_hpet(): bool
        variable cap: nat64
        si hpet_fís = 0 entonces devolver falso fin
        hpet := mapea_disp(hpet_fís, 0x400, sin_caché())
        cap := m64(hpet)
        hpet_periodo := cap >> 32
        si hpet_periodo = 0 o hpet_periodo > 100000000 entonces
            hpet := 0
            devolver falso
        fin
        hpet_temps := nat32((cap >> 8) yb 31) + 1
        hpet_64 := cap yb 0x2000 <> 0 y no hpet_32_forzado
        hpet_sustituye := cap yb 0x8000 <> 0
        pon_m64(hpet + 0x10, m64(hpet + 0x10) yb (nob nat64(3)))   ; parado y sin sustituir
        pon_m64(hpet + 0xF0, 0)
        ; [etapa 10 d] (hpet32, las pruebas) que dé la vuelta de los 32 bits a los 4 s
        si hpet_32_forzado entonces pon_m64(hpet + 0xF0, nat64(0xFFFFFFFF) - muldiv(4000000000, 1000000, hpet_periodo)) fin
        pon_m64(hpet + 0x10, m64(hpet + 0x10) ob 1)                 ; a contar
        devolver cierto
    fin

    ; mide 10 ms con el canal 2 del 8254 (sin interrupciones); falso si no anda
    público función diez_ms_pit(): bool
        variable i: nat32
        sale8(0x61, (entra8(0x61) yb 0xFD) ob 1)      ; la puerta del canal 2, abierta; sin altavoz
        sale8(0x43, 0xB0)                            ; canal 2, modo 0, los dos octetos
        sale8(0x42, 11932 yb 0xFF)                   ; 1193182 Hz * 10 ms
        sale8(0x42, 11932 >> 8)
        i := 0
        mientras entra8(0x61) yb 0x20 = 0 y i < 100000000 hacer i := i + 1 fin
        devolver i < 100000000
    fin

    ; [etapa 11 b] el TSC y la hora, leídos juntos (la hora antes y después,
    ; la vez que menos hay entre las dos); la hora, en muestra_ns
    variable muestra_ns: nat64
    función muestra_tsc(): nat64
        variable ta, tb, c, mejor, mc, mt: nat64
        variable i: nat32
        mejor := 0xFFFFFFFFFFFFFFFF
        i := 0
        mientras i < 8 hacer
            ta := ahora_ns()
            c := tsc()
            tb := ahora_ns()
            si tb - ta < mejor entonces
                mejor := tb - ta
                mc := c
                mt := ta + (tb - ta) div 2
            fin
            si i >= 1 y mejor < 20000 entonces i := 8 sino i := i + 1 fin
        fin
        muestra_ns := mt
        devolver mc
    fin

    ; [etapa 10 f] ¿es KVM, y su reloj (pvclock) dice que el TSC es estable?
    ; (CPUID 0x40000000: «KVMKVMKVM»; 0x40000001, el bit 3 o el 0: el reloj de
    ; KVM; se le pide una vez con su MSR, se mira PVCLOCK_TSC_STABLE_BIT y se
    ; le dice que pare)
    función mira_kvm()
        variable msr: nat32
        variable f: nat64
        variable i: nat32
        variable c: puntero a Cpu
        cpuid(1, 0)
        si rc yb 0x80000000 = 0 entonces devolver fin
        cpuid(0x40000000, 0)
        ; (QEMU sin KVM: su TSC lo saca del reloj del anfitrión, el mismo para todos)
        si rb = 0x54474354 y rc = 0x43544743 y rd = 0x47435447 entonces
            tcg_hay := cierto
            devolver
        fin
        si rb <> 0x4B4D564B o rc <> 0x564B4D56 o rd <> 0x4D entonces devolver fin
        kvm_hay := cierto
        cpuid(0x40000001, 0)
        si ra yb 8 <> 0 entonces msr := 0x4B564D01 sino si ra yb 1 <> 0 entonces msr := 0x12 sino devolver fin
        pv_msr := msr
        c := yo()
        f := pv_de(c.número)
        pv_este(c.número)
        i := 0
        mientras i < 1000000 y m32(f) = 0 hacer
            pausa()
            i := i + 1
        fin
        si m32(f) = 0 entonces
            pon_msr(msr, 0)
            pv_msr := 0
            devolver
        fin
        ; flags, el octeto 29: el bit 0, PVCLOCK_TSC_STABLE_BIT
        kvm_estable := (m32(f + 28) >> 8) yb 1 <> 0
    fin

    ; [etapa 10 f] desde ahora, ahora_ns() con el TSC (lo llama el arranque
    ; con todos los procesadores ya encendidos y probados)
    público función pasa_a_tsc()
        variable b: nat64
        si tsc_vale = TSC_NO o tsc_hz = 0 o con_tsc o con_pv entonces devolver fin
        b := sin_ints()
        si tsc_vale = TSC_PV entonces
            pv_desfase := ahora_ns() - lee_pv()
            pv_último := 0
            ensamblador
                db 0x0F, 0xAE, 0xF0         ; mfence
            fin
            con_pv := cierto
            restaura(b)
            devolver
        fin
        tsc_mult := muldiv(1000000000, nat64(1) << 32, tsc_hz)
        ns0 := ahora_ns()
        tsc0 := tsc()
        ensamblador
            db 0x0F, 0xAE, 0xF0         ; mfence
        fin
        con_tsc := cierto
        restaura(b)
    fin

    ; [etapa 11 a] (Suspende64, sin interrupciones) de vuelta de S3: el TSC, el
    ; HPET y el reloj de ACPI han vuelto a empezar; el monótono sigue en
    ; «antes» (lo dormido no cuenta, como CLOCK_MONOTONIC de Linux)
    público función tras_s3(antes: nat64)
        si hpet <> 0 entonces
            pon_m64(hpet + 0x10, m64(hpet + 0x10) yb (nob nat64(3)))
            pon_m64(hpet + 0xF0, 0)
            pon_m64(hpet + 0x10, m64(hpet + 0x10) ob 1)
        fin
        si fuente = HPET y hpet <> 0 entonces hpet_antes := m32(hpet + 0xF0) fin
        si fuente = PM entonces pm_antes := lee_pm() fin
        si con_pv entonces
            pv_desfase := antes - lee_pv()
        sino si con_tsc entonces
            ns0 := antes
            tsc0 := tsc()
        sino
            ; (con el HPET o el de ACPI: la cuenta sigue sumando desde donde iba)
        fin
        ensamblador
            db 0x0F, 0xAE, 0xF0         ; mfence
        fin
    fin

    público función prepara_reloj()
        variable t0, c0, c1: nat64
        si pon_hpet() entonces
            fuente := HPET
            hpet_antes := m32(hpet + 0xF0)
        sino si pm_tmr <> 0 entonces
            fuente := PM
            pm_antes := lee_pm()
        fin
        cuenta0 := cuenta()
        cpuid(0x80000000, 0)
        si ra >= 0x80000007 entonces
            cpuid(0x80000007, 0)
            tsc_invariante := rd yb 0x100 <> 0
        fin
        ; la frecuencia del TSC: 50 ms con el reloj ([etapa 11 b] el TSC y la
        ; hora leídos juntos, como la cuenta del APIC en Apic64.mide)
        si fuente <> NINGUNO entonces
            c0 := muestra_tsc()
            t0 := muestra_ns
            mientras ahora_ns() - t0 < 50000000 hacer pausa() fin
            c1 := muestra_tsc()
            tsc_hz := muldiv(c1 - c0, 1000000000, muestra_ns - t0)
        fin
        ; [etapa 10 f] ¿vale el TSC para el reloj del núcleo?
        mira_kvm()
        tsc_vale := TSC_NO
        si tsc_hz > 0 y no tsc_prohibido entonces
            si tsc_invariante entonces tsc_vale := TSC_INVARIANTE
            sino si kvm_estable entonces tsc_vale := TSC_KVM
            sino si tcg_hay entonces tsc_vale := TSC_TCG
            sino si tsc_forzado entonces tsc_vale := TSC_FORZADO
            sino si pv_msr <> 0 entonces tsc_vale := TSC_PV
            fin
        fin
    fin

    ; ---- el reloj de tiempo real (CMOS) ----
    función cmos(r: nat32): nat32
        sale8(0x70, r)
        devolver entra8(0x71)
    fin

    función bcd(v: nat32): nat32
        devolver (v >> 4) * 10 + (v yb 15)
    fin

    ; ¿hay CMOS? (la FADT puede decir que no)
    público función hay_cmos(): bool
        si hay_fadt y arq yb 0x20 <> 0 entonces devolver falso fin
        devolver cmos(0x0A) <> 0xFF
    fin

    ; los segundos, tal cual (para ver cuándo cambian)
    público función segundo_cmos(): nat32
        mientras cmos(0x0A) yb 0x80 <> 0 hacer pausa() fin
        devolver cmos(0)
    fin

    ; [etapa 4] la fecha y la hora del CMOS: día, mes, año (con el siglo), hora, minuto, segundo
    público función lee_fecha(ref d: nat32, ref me: nat32, ref año: nat32, ref h: nat32, ref mi: nat32, ref s: nat32)
        variable a, c, b, s2: nat32
        variable pm: bool
        mientras cierto hacer
            mientras cmos(0x0A) yb 0x80 <> 0 hacer pausa() fin
            s := cmos(0)
            mi := cmos(2)
            h := cmos(4)
            d := cmos(7)
            me := cmos(8)
            a := cmos(9)
            c := 0
            si siglo <> 0 entonces c := cmos(siglo) fin
            mientras cmos(0x0A) yb 0x80 <> 0 hacer pausa() fin
            s2 := cmos(0)
            si s2 = s entonces romper fin
        fin
        b := cmos(0x0B)
        pm := h yb 0x80 <> 0
        h := h yb 0x7F
        si b yb 4 = 0 entonces
            s := bcd(s)
            mi := bcd(mi)
            h := bcd(h)
            d := bcd(d)
            me := bcd(me)
            a := bcd(a)
            c := bcd(c)
        fin
        si b yb 2 = 0 y pm entonces h := (h mod 12) + 12 fin
        si c = 0 entonces c := 20 fin
        año := c * 100 + a
    fin

    ; [etapa 10] escribe en el CMOS (como lo tenga: BCD o binario, 12 o 24
    ; horas; el siglo, si la FADT dice dónde): con SET (el bit 7 del registro
    ; B) puesto mientras tanto, para que no avance a medias
    función pon_cmos(r: nat32, v: nat32)
        sale8(0x70, r)
        sale8(0x71, v)
    fin

    función a_bcd(v: nat32): nat32
        devolver ((v div 10) << 4) ob (v mod 10)
    fin

    público función pon_fecha(d: nat32, me: nat32, año: nat32, h: nat32, mi: nat32, s: nat32)
        variable b, hh, c, a: nat32
        variable pm: bool
        si no hay_cmos() entonces devolver fin
        b := cmos(0x0B)
        pon_cmos(0x0B, b ob 0x80)
        hh := h
        pm := falso
        si b yb 2 = 0 entonces
            ; (de 12 horas: 12 AM es 12, y el bit 7, PM)
            pm := h >= 12
            hh := h mod 12
            si hh = 0 entonces hh := 12 fin
        fin
        c := año div 100
        a := año mod 100
        si b yb 4 = 0 entonces
            s := a_bcd(s)
            mi := a_bcd(mi)
            hh := a_bcd(hh)
            d := a_bcd(d)
            me := a_bcd(me)
            a := a_bcd(a)
            c := a_bcd(c)
        fin
        si pm entonces hh := hh ob 0x80 fin
        pon_cmos(0, s)
        pon_cmos(2, mi)
        pon_cmos(4, hh)
        pon_cmos(7, d)
        pon_cmos(8, me)
        pon_cmos(9, a)
        si siglo <> 0 entonces pon_cmos(siglo, c) fin
        pon_cmos(0x0B, b yb 0x7F)
    fin

    ; la fecha y la hora: «23/11/2026 18:30:05»
    público función escribe_hora()
        variable s, mi, h, d, me, a: nat32
        lee_fecha(d, me, a, h, mi, s)
        escribir(d div 10, d mod 10, "/", me div 10, me mod 10, "/", a, " ")
        escribir(h div 10, h mod 10, ":", mi div 10, mi mod 10, ":", s div 10, s mod 10)
    fin

    ; [etapa 4] los segundos desde el 1/1/1970 (la hora del CMOS, tomada como UTC)
    público función segundos_unix(): nat64
        variable s, mi, h, d, me, a: nat32
        variable an, m, era, yoe, doy, doe, días: nat64
        lee_fecha(d, me, a, h, mi, s)
        ; (días desde la época: el algoritmo de «days_from_civil», con años desde el 0)
        an := nat64(a)
        m := nat64(me)
        si m <= 2 entonces an := an - 1 fin
        era := an div 400
        yoe := an - era * 400
        si m > 2 entonces doy := (153 * (m - 3) + 2) div 5 + nat64(d) - 1 sino doy := (153 * (m + 9) + 2) div 5 + nat64(d) - 1 fin
        doe := yoe * 365 + yoe div 4 - yoe div 100 + doy
        días := era * 146097 + doe - 719468
        devolver días * 86400 + nat64(h) * 3600 + nat64(mi) * 60 + nat64(s)
    fin

fin Reloj64.
