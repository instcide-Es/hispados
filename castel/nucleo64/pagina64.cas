; =============================================================================
;  pagina64.cas - Hispa-64: la memoria virtual (docs/64/HISPA-64.md, 2.3 y
;  etapa 1). Las tablas de páginas de cuatro niveles (PML4, PDPT, PD, PT), por
;  función: mapea (páginas de 4 KB, 2 MB o 1 GB), desmapea y traduce, con la
;  TLB al día (invlpg). Las tablas se piden a Fisica64 y se tocan por el mapa
;  directo. Y el espacio del núcleo de verdad, que sustituye al provisional del
;  arranque:
;    0xFFFF800000000000  el mapa directo: solo la RAM y lo de ACPI (y lo que
;                        haya dado el cargador), con las páginas más grandes
;                        que se pueda (1 GB, 2 MB, 4 KB); sin ejecutar (NX)
;    0xFFFFC00000000000  los dispositivos, mapeados a propósito (mapea_disp): la
;                        pantalla con «escritura combinada» (PAT), los registros
;                        sin caché
;    0xFFFFC80000000000  los bloques grandes del montón (monton64.cas)
;    0xFFFFE00000000000  [etapa 3] las pilas de los hilos y de los procesadores:
;                        sitios de 64 KB, la pila en los 32 KB de arriba y los
;                        de abajo sin poner (la guarda: quien se desborde
;                        falla en el acto, y Excep64 lo dice)
;    0xFFFFFFFF80000000  el núcleo: el código, de solo leer; los datos y la
;                        pila, sin ejecutar; una página de guarda (sin poner)
;                        debajo de la pila
;  y sin la identidad de abajo (la mitad baja queda para los programas).
;  Con NX (EFER.NXE), WP (el núcleo tampoco escribe en lo de solo leer), las
;  páginas globales (CR4.PGE) y la PAT (entrada 1: escritura combinada; 3: sin
;  caché).
;  [etapa 3] Con varios procesadores, quitar una página de las tablas no basta
;  con «invlpg» en el que la quita: los demás pueden tenerla en su TLB. Por eso
;  desmapea, después de soltar el cerrojo, llama a «derribo» (Smp64: un IPI a
;  los demás, que vacían esa dirección de su TLB, y espera a que lo hayan
;  hecho); solo entonces se puede dar el marco a otro. Quien llame a desmapea
;  no debe tener ningún cerrojo tomado (los demás no podrían atender el aviso
;  si esperasen por él con las interrupciones quitadas). desmapea_aquí no
;  avisa: para lo que nadie más ha podido ver aún.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Pagina64

    importar Cifras64, Cerrojo, Fisica64, Cpu64, Excep64

    público constante PRESENTE = 1
    público constante ESCRIBIR = 2
    público constante USUARIO = 4
    público constante PWT = 8
    público constante PCD = 16
    público constante GRANDE = 128
    público constante GLOBAL = 256
    público constante K4 = 0x1000
    público constante M2 = 0x200000
    público constante G1 = 0x40000000
    constante TABLAS_ARRANQUE = 274432          ; las de C_tablas (ARRANQUE64 de ccastel.py)

    público variable raíz: nat64                ; la PML4 en uso (física)
    público variable tablas: nat32              ; las tablas de páginas pedidas
    público variable hay_pat: bool
    público variable dm_1g, dm_2m, dm_4k: nat32 ; las páginas del mapa directo, por tamaños
    público variable quitado: nat64             ; el tamaño de lo último que ha quitado desmapea
    variable cerrojo: nat64
    variable hay_nx: bool
    ; [etapa 3]
    público variable derribo: nat64             ; derriba(v, n) de Smp64: vaciar la TLB de los demás
    variable pilas: arreglo [64] de nat64       ; los sitios de la zona de las pilas en uso (MAX_PILAS bits)
    variable pilas_cerrojo: nat64
    público variable n_pilas: nat32             ; las pilas en uso
    variable próx_disp: nat64
    ; las etiquetas del núcleo (virtuales): el principio, los datos, las tablas
    ; del arranque, la guarda, la pila y el final
    público variable k_ini, k_datos, k_tablas, k_guarda, k_pila, k_pila_fin, k_fin: nat64

    público función bit_nx(): nat64
        si hay_nx entonces devolver nat64(1) << 63 fin
        devolver 0
    fin

    ; las banderas de cada clase de página
    público función datos(): nat64
        devolver ESCRIBIR ob GLOBAL ob bit_nx()
    fin

    público función código(): nat64
        devolver GLOBAL
    fin

    público función combinada(): nat64      ; la PAT 1: escritura combinada (la pantalla)
        devolver ESCRIBIR ob GLOBAL ob PWT ob bit_nx()
    fin

    público función sin_caché(): nat64      ; la PAT 3: sin caché (los registros)
        devolver ESCRIBIR ob GLOBAL ob PWT ob PCD ob bit_nx()
    fin

    ; de virtual del núcleo a física
    público función base_núcleo(): nat64
        devolver 0xFFFFFFFF80000000
    fin

    función máscara(): nat64
        devolver 0x000FFFFFFFFFF000
    fin

    función tabla(f: nat64): puntero a nat64
        devolver puntero(virt(f))
    fin

    público función invlpg(v: nat64)
        ensamblador
            mov rax, {v}
            db 0x0F, 0x01, 0x38         ; invlpg [rax]
        fin
    fin

    función carga_cr3(f: nat64)
        ensamblador
            mov rax, {f}
            mov cr3, rax
        fin
    fin

    función lee_msr(n: nat32): nat64
        ensamblador
            mov ecx, {n}
            rdmsr
            shl rdx, 32
            or rax, rdx
        fin
    fin

    función pon_msr(n: nat32, v: nat64)
        ensamblador
            mov ecx, {n}
            mov rax, {v}
            mov rdx, rax
            shr rdx, 32
            wrmsr
        fin
    fin

    función cr0_ob(b: nat64)
        ensamblador
            mov rax, cr0
            or rax, {b}
            mov cr0, rax
        fin
    fin

    función cr4_ob(b: nat64)
        ensamblador
            mov rax, cr4
            or rax, {b}
            mov cr4, rax
        fin
    fin

    ; una tabla nueva, a cero (física); si no hay memoria, se para
    función nueva(): nat64
        variable f: nat64
        variable t: puntero a nat64
        variable i: nat32
        f := pide()
        si f = 0 entonces
            detén_ini("no queda memoria para las tablas de páginas")
            detén_fin()
        fin
        t := tabla(f)
        i := 0
        mientras i < 512 hacer
            t[i] := 0
            i := i + 1
        fin
        tablas := tablas + 1
        devolver f
    fin

    función índice(v: nat64, nivel: nat32): nat64
        devolver (v >> (12 + 9 * (nivel - 1))) yb 511
    fin

    ; el sitio de la entrada de v en el nivel «nivel» (1 la PT, 2 la PD, 3 la
    ; PDPT); con «crea», pone las tablas que falten; nulo si no está (o si hay
    ; una página grande por medio)
    función entrada(v: nat64, nivel: nat32, crea: bool): puntero a nat64
        variable t: puntero a nat64
        variable n: nat32
        variable e: nat64
        t := tabla(raíz)
        n := 4
        mientras n > nivel hacer
            e := t[índice(v, n)]
            si e yb PRESENTE = 0 entonces
                si no crea entonces devolver nulo fin
                e := nueva() ob PRESENTE ob ESCRIBIR
                t[índice(v, n)] := e
            sino si e yb GRANDE <> 0 entonces
                devolver nulo
            fin
            t := tabla(e yb máscara())
            n := n - 1
        fin
        devolver dirección(t[índice(v, nivel)])
    fin

    ; pone v -> f, de tam octetos (K4, M2 o G1), con esas banderas; dice si ha
    ; podido (no, si no están alineadas, si ya había algo, si no hay páginas
    ; de 1 GB)
    público función mapea(v: nat64, f: nat64, tam: nat64, fl: nat64): bool
        variable nivel: nat32
        variable p: puntero a nat64
        variable b: nat64
        variable bien: bool
        nivel := 1
        si tam = M2 entonces nivel := 2 fin
        si tam = G1 entonces nivel := 3 fin
        si nivel = 1 y tam <> K4 entonces devolver falso fin
        si v yb (tam - 1) <> 0 o f yb (tam - 1) <> 0 entonces devolver falso fin
        si nivel = 3 y no pag1g entonces devolver falso fin
        b := toma(dirección(cerrojo))
        p := entrada(v, nivel, cierto)
        bien := p <> nulo
        si bien entonces bien := valor(p) yb PRESENTE = 0 fin
        si bien entonces
            si nivel > 1 entonces
                valor(p) := f ob fl ob PRESENTE ob GRANDE
            sino
                valor(p) := f ob fl ob PRESENTE
            fin
            invlpg(v)
        fin
        suelta(dirección(cerrojo), b)
        devolver bien
    fin

    ; quita la página en la que está v (sea del tamaño que sea) y la quita de la
    ; TLB (de este procesador); devuelve la física donde empezaba (y su tamaño
    ; en «quitado»), o nob 0 si no había nada. Las tablas que se quedan vacías
    ; no se devuelven aún.
    público función desmapea_aquí(v: nat64): nat64
        variable t: puntero a nat64
        variable n: nat32
        variable e, r, b, tam: nat64
        b := toma(dirección(cerrojo))
        r := nob nat64(0)
        quitado := 0
        t := tabla(raíz)
        n := 4
        mientras n >= 1 hacer
            e := t[índice(v, n)]
            si e yb PRESENTE = 0 entonces romper fin
            si n = 1 o e yb GRANDE <> 0 entonces
                tam := nat64(1) << (12 + 9 * (n - 1))
                r := (e yb máscara()) yb (nob (tam - 1))
                t[índice(v, n)] := 0
                quitado := tam
                invlpg(v)
                romper
            fin
            t := tabla(e yb máscara())
            n := n - 1
        fin
        suelta(dirección(cerrojo), b)
        devolver r
    fin

    función llama2(f: nat64, a: nat64, b: nat64)
        ensamblador
            push qword {b}
            push qword {a}
            mov rax, {f}
            call rax
        fin
    fin

    ; [etapa 3] los demás procesadores, que vacíen de su TLB las n páginas de 4
    ; KB desde v (sin ningún cerrojo tomado)
    público función avisa_tlb(v: nat64, n: nat64)
        si derribo <> 0 entonces llama2(derribo, v, n) fin
    fin

    ; quita la página de v de las tablas y de la TLB de todos los procesadores
    ; (sin ningún cerrojo tomado); devuelve su física (o nob 0), como desmapea_aquí
    público función desmapea(v: nat64): nat64
        variable r: nat64
        r := desmapea_aquí(v)
        si r <> nob nat64(0) entonces avisa_tlb(v, 1) fin
        devolver r
    fin

    ; [etapa 3] una pila nueva de 32 KB (16 KB hasta la etapa 4) en la zona de las pilas, con su guarda
    ; debajo; devuelve lo alto (o 0 si no queda sitio o memoria)
    público función pila_nueva(): nat64
        variable b, base, f: nat64
        variable i, k: nat32
        b := toma(dirección(pilas_cerrojo))
        i := 0
        mientras i < MAX_PILAS y (pilas[i >> 6] >> (i yb 63)) yb 1 <> 0 hacer i := i + 1 fin
        si i >= MAX_PILAS entonces
            suelta(dirección(pilas_cerrojo), b)
            devolver 0
        fin
        pilas[i >> 6] := pilas[i >> 6] ob (nat64(1) << (i yb 63))
        n_pilas := n_pilas + 1
        suelta(dirección(pilas_cerrojo), b)
        base := ZONA_PILAS + nat64(i) * SITIO_PILA + SITIO_PILA div 2
        k := 0
        mientras k < PÁGINAS_PILA hacer
            f := pide()
            si f = 0 entonces
                ; (nadie la ha visto aún: sin avisar a los demás)
                mientras k > 0 hacer
                    k := k - 1
                    devuelve(desmapea_aquí(base + nat64(k) * K4))
                fin
                b := toma(dirección(pilas_cerrojo))
                pilas[i >> 6] := pilas[i >> 6] yb (nob (nat64(1) << (i yb 63)))
                n_pilas := n_pilas - 1
                suelta(dirección(pilas_cerrojo), b)
                devolver 0
            fin
            mapea(base + nat64(k) * K4, f, K4, datos())
            k := k + 1
        fin
        devolver base + SITIO_PILA div 2
    fin

    ; [etapa 3] devuelve la pila de lo alto «cima» (de pila_nueva): fuera de las
    ; tablas de todos (sin ningún cerrojo tomado) y sus marcos, a la memoria libre
    público función pila_suelta(cima: nat64)
        variable b, base: nat64
        variable f: arreglo [PÁGINAS_PILA] de nat64
        variable i, k: nat32
        base := cima - SITIO_PILA div 2
        si base < ZONA_PILAS o (base - ZONA_PILAS) yb (SITIO_PILA - 1) <> SITIO_PILA div 2 entonces
            detén_ini("se suelta una pila que no es de la zona de las pilas")
            hex16(cima)
            escribir("\n")
            detén_fin()
        fin
        i := nat32((base - ZONA_PILAS) div SITIO_PILA)
        k := 0
        mientras k < PÁGINAS_PILA hacer
            f[k] := desmapea_aquí(base + nat64(k) * K4)
            k := k + 1
        fin
        avisa_tlb(base, PÁGINAS_PILA)
        k := 0
        mientras k < PÁGINAS_PILA hacer
            si f[k] <> nob nat64(0) entonces devuelve(f[k]) fin
            k := k + 1
        fin
        b := toma(dirección(pilas_cerrojo))
        pilas[i >> 6] := pilas[i >> 6] yb (nob (nat64(1) << (i yb 63)))
        n_pilas := n_pilas - 1
        suelta(dirección(pilas_cerrojo), b)
    fin

    ; la física de v, o nob 0 si no está
    público función traduce(v: nat64): nat64
        variable t: puntero a nat64
        variable n: nat32
        variable e, tam: nat64
        t := tabla(raíz)
        n := 4
        mientras n >= 1 hacer
            e := t[índice(v, n)]
            si e yb PRESENTE = 0 entonces devolver nob nat64(0) fin
            si n = 1 o e yb GRANDE <> 0 entonces
                tam := nat64(1) << (12 + 9 * (n - 1))
                devolver ((e yb máscara()) yb (nob (tam - 1))) + (v yb (tam - 1))
            fin
            t := tabla(e yb máscara())
            n := n - 1
        fin
        devolver nob nat64(0)
    fin

    ; las banderas de la página de v (las de la entrada que la pone), o 0
    público función marcas_de(v: nat64): nat64
        variable t: puntero a nat64
        variable n: nat32
        variable e: nat64
        t := tabla(raíz)
        n := 4
        mientras n >= 1 hacer
            e := t[índice(v, n)]
            si e yb PRESENTE = 0 entonces devolver 0 fin
            si n = 1 o e yb GRANDE <> 0 entonces devolver e yb (nob máscara()) fin
            t := tabla(e yb máscara())
            n := n - 1
        fin
        devolver 0
    fin

    ; [a, b) de memoria física, en el mapa directo: con las páginas más grandes
    ; que se pueda; lo que ya esté puesto se deja
    público función mapea_directo(a: nat64, b: nat64)
        a := abajo(a)
        b := arriba(b)
        mientras a < b hacer
            si pag1g y a yb (G1 - 1) = 0 y b - a >= G1 y mapea(virt(a), a, G1, datos()) entonces
                dm_1g := dm_1g + 1
                a := a + G1
            sino si a yb (M2 - 1) = 0 y b - a >= M2 y mapea(virt(a), a, M2, datos()) entonces
                dm_2m := dm_2m + 1
                a := a + M2
            sino
                si mapea(virt(a), a, K4, datos()) entonces dm_4k := dm_4k + 1 fin
                a := a + K4
            fin
        fin
    fin

    ; un dispositivo (la pantalla, unos registros): [f, f + largo) de física, en
    ; la zona de los dispositivos, con esas banderas (combinada(), sin_caché());
    ; devuelve dónde se ve f. Cada uno empieza en un GB nuevo, en el mismo sitio
    ; dentro del GB que la física: así valen las páginas de 2 MB.
    público función mapea_disp(f: nat64, largo: nat64, fl: nat64): nat64
        variable a, b, v, v0: nat64
        a := abajo(f)
        b := arriba(f + largo)
        v0 := próx_disp + (a yb (G1 - 1))
        v := v0
        mientras a < b hacer
            si a yb (M2 - 1) = 0 y b - a >= M2 y mapea(v, a, M2, fl) entonces
                a := a + M2
                v := v + M2
            sino
                si no mapea(v, a, K4, fl) entonces
                    detén_ini("no se puede poner un dispositivo en las tablas de páginas")
                    hex16(a)
                    escribir("\n")
                    detén_fin()
                fin
                a := a + K4
                v := v + K4
            fin
        fin
        próx_disp := (v + G1 - 1) yb (nob nat64(G1 - 1))
        devolver v0 + (f yb 4095)
    fin

    función toma_etiquetas()
        ensamblador
            mov rax, C_ini
            mov {k_ini}, rax
            mov rax, C_datos
            mov {k_datos}, rax
            mov rax, C_tablas
            mov {k_tablas}, rax
            mov rax, C_guarda
            mov {k_guarda}, rax
            mov rax, C_pila
            mov {k_pila}, rax
            mov rax, C_pila_fin
            mov {k_pila_fin}, rax
            mov rax, _vacio_fin
            mov {k_fin}, rax
        fin
    fin

    ; dónde está el núcleo en la memoria física: [núcleo_fís_ini, núcleo_fís_fin)
    público función núcleo_fís_ini(): nat64
        toma_etiquetas()
        devolver abajo(k_ini) - base_núcleo()
    fin

    público función núcleo_fís_fin(): nat64
        toma_etiquetas()
        devolver arriba(k_fin) - base_núcleo()
    fin

    ; prepara el procesador: NX, la PAT, WP (antes de poner nada)
    público función prepara_páginas()
        toma_etiquetas()
        hay_nx := nx
        si hay_nx entonces pon_msr(0xC0000080, lee_msr(0xC0000080) ob 0x800) fin
        cpuid(1, 0)
        hay_pat := rd yb 0x10000 <> 0
        si hay_pat entonces
            ensamblador
                db 0x0F, 0x09           ; wbinvd
            fin
            ; WB, WC, UC-, UC, WB, WP, UC-, WT
            pon_msr(0x277, 0x0407050600070106)
        fin
        cr0_ob(0x10000)
        próx_disp := 0xFFFFC00000000000
    fin

    ; las tablas nuevas, con el núcleo (sin las tablas del arranque ni la página
    ; de guarda): se deja en raíz; el mapa directo lo pone después quien llama
    ; (mapea_directo con cada trozo de RAM)
    público función empieza_núcleo()
        variable v, fl: nat64
        raíz := nueva()
        v := abajo(k_ini)
        mientras v < arriba(k_fin) hacer
            si (v < k_tablas o v >= k_tablas + TABLAS_ARRANQUE) y (v < k_guarda o v >= k_pila) entonces
                fl := datos()
                si v < k_datos entonces fl := código() fin
                si no mapea(v, v - base_núcleo(), K4, fl) entonces
                    detén_ini("no se puede poner el núcleo en las tablas de páginas")
                    detén_fin()
                fin
            fin
            v := v + K4
        fin
    fin

    ; [etapa 3] otro procesador (el trampolín ya le ha puesto NX y WP): la PAT,
    ; las tablas de verdad y las páginas globales
    público función prepara_este()
        si hay_pat entonces pon_msr(0x277, 0x0407050600070106) fin
        cr0_ob(0x10000)
        carga_cr3(raíz)
        cr4_ob(0x80)
    fin

    ; pasa a las tablas nuevas y devuelve las del arranque a la memoria libre
    público función cambia()
        carga_cr3(raíz)
        cr4_ob(0x80)                    ; las páginas globales
        suelta_seguidos(k_tablas - base_núcleo(), TABLAS_ARRANQUE div 4096)
        guarda_ini := k_guarda
        guarda_fin := k_pila
        pila_ini := k_pila
        pila_fin := k_pila_fin
    fin

fin Pagina64.
