; =============================================================================
;  gdt64.cas - Hispa-64: la tabla de descriptores (GDT) del núcleo y la TSS
;  (docs/64/HISPA-64.md, etapa 1). La GDT del arranque está en su dirección
;  física (en 1 MB, por debajo); esta, en la mitad alta, y con lo que hará falta
;  para los programas (etapa 4: `syscall` quiere el código y los datos del
;  anillo 3 justo detrás de los del núcleo) y la TSS:
;    0x08 código del núcleo (64 bits)   0x10 datos del núcleo
;    0x18 datos del anillo 3            0x20 código del anillo 3 (64 bits)
;    0x28 la TSS (16 octetos)
;  La TSS de 64 bits ya no cambia de tarea: da las pilas. Tres pilas IST, cada
;  una para una excepción que no puede fiarse de la pila que haya: el doble
;  fallo (IST 1: si se ha desbordado la pila del núcleo, sin ella el
;  procesador se reiniciaría), el NMI (IST 2) y el fallo de máquina (IST 3).
;  Desde la etapa 3, cada procesador tiene las suyas (monta: la GDT y la TSS
;  en un bloque del montón, las pilas IST en la zona de las pilas, con su
;  guarda); estas, las de aquí, son las del que arranca.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Gdt64

    constante PILA_IST = 16384

    tipo Gdtr = estructura
        límite: nat16
        base: nat64
    fin

    variable gdt: arreglo [7] de nat64
    variable gdtr: Gdtr
    variable tss: arreglo [104] de byte
    variable pila_df: arreglo [PILA_IST] de byte
    variable pila_nmi: arreglo [PILA_IST] de byte
    variable pila_mc: arreglo [PILA_IST] de byte

    función pon64(en: nat32, v: nat64)
        variable p: puntero a nat64
        p := puntero(nat64(dirección(tss[en])))
        valor(p) := v
    fin

    ; lo alto de una pila, alineado a 16
    función cima(d: nat64): nat64
        devolver (d + PILA_IST) yb (nob nat64(15))
    fin

    público función ist(n: nat32): nat64
        variable p: puntero a nat64
        p := puntero(nat64(dirección(tss[36 + (n - 1) * 8])))
        devolver valor(p)
    fin

    ; [etapa 2] dónde están (para PorCpu64: en la etapa 3, una de cada por procesador)
    público función dir_gdt(): nat64
        devolver nat64(dirección(gdt))
    fin

    público función dir_tss(): nat64
        devolver nat64(dirección(tss))
    fin

    función p64(d: nat64, v: nat64)
        variable p: puntero a nat64
        p := puntero(d)
        valor(p) := v
    fin

    función p8(d: nat64, v: byte)
        variable p: puntero a byte
        p := puntero(d)
        valor(p) := v
    fin

    ; [etapa 3] pone la GDT en g (56 octetos) y la TSS en t (104), con lo alto
    ; de las tres pilas IST, y las carga (lgdt, ltr). Los procesadores se
    ; encienden de uno en uno: gdtr se puede compartir.
    público función monta(g: nat64, t: nat64, i1: nat64, i2: nat64, i3: nat64)
        variable i: nat32
        i := 0
        mientras i < 104 hacer
            p8(t + i, 0)
            i := i + 1
        fin
        p64(g, 0)
        p64(g + 8, (nat64(0x00AF9A00) << 32) ob 0xFFFF)
        p64(g + 16, (nat64(0x00CF9200) << 32) ob 0xFFFF)
        p64(g + 24, (nat64(0x00CFF200) << 32) ob 0xFFFF)
        p64(g + 32, (nat64(0x00AFFA00) << 32) ob 0xFFFF)
        ; la TSS: límite 103, base, tipo 0x89 (TSS de 64 bits disponible, presente)
        p64(g + 40, 103 ob ((t yb 0xFFFFFF) << 16) ob (nat64(0x89) << 40) ob (((t >> 24) yb 0xFF) << 56))
        p64(g + 48, t >> 32)
        p64(t + 36, i1)
        p64(t + 44, i2)
        p64(t + 52, i3)
        p8(t + 102, 104)                ; sin mapa de puertos (detrás del final)
        gdtr.límite := 55
        gdtr.base := g
        ensamblador
            lgdt {gdtr}
            mov ax, 0x28
            ltr ax
        fin
    fin

    ; pone la GDT nueva y la TSS del que arranca, y las carga
    público función pon_gdt()
        monta(nat64(dirección(gdt)), nat64(dirección(tss)), cima(nat64(dirección(pila_df))), cima(nat64(dirección(pila_nmi))), cima(nat64(dirección(pila_mc))))
    fin

fin Gdt64.
