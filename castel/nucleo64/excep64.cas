; =============================================================================
;  excep64.cas - Hispa-64: la tabla de interrupciones (IDT de 64 bits) con
;  las 32 excepciones del procesador, y lo que se dice de cada una, en español:
;  qué ha pasado, dónde (RIP, CS, RFLAGS, RSP), el número de error si lo hay, los
;  registros y, en un fallo de página, la dirección (CR2) y por qué. Un punto
;  de parada (int3) se cuenta y se sigue; las demás paran el procesador (con
;  «apagar» en la línea de órdenes, apagan QEMU con el código 99: las pruebas).
;  Desde la etapa 1: el doble fallo, el NMI y el fallo de máquina van con su
;  propia pila (IST, de la TSS de gdt64.cas), y un doble fallo por desbordar la
;  pila del núcleo se dice; con los nombres de nombre64.cas, en qué función
;  ha pasado y quién la ha llamado; y las paradas del propio núcleo (detén_ini
;  y detén_fin: el montón estropeado, memoria soltada dos veces...), igual, con
;  el código 98 en QEMU.
;  [etapa 3] Con varios procesadores: el primero que se para (por una
;  excepción o una parada del núcleo) para a los demás (al_parar: Smp64 les
;  manda un NMI) y lo explica él solo, diciendo en qué procesador ha pasado;
;  los demás, al ver que ya hay uno parándose, se quedan quietos sin decir
;  nada. Cada uno con sus pilas IST (las de su TSS, en su bloque de PorCpu64).
;  Un fallo de página «con red» (lee_con_red de Smp64: las pruebas de vaciar
;  la TLB de los demás) no para: vuelve adonde diga el bloque del procesador.
;  Y un desbordamiento de la pila de un hilo (en la zona de las pilas, cada una
;  con 32 KB sin poner debajo) se dice igual que el de la pila del núcleo.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Excep64

    importar Cifras64, Nombre64, Gdt64, PorCpu64, Entradas

    ; una puerta de la IDT de 64 bits: 16 octetos
    tipo Puerta = estructura
        bajo: nat16
        selector: nat16
        ist: byte
        tipo_: byte
        medio: nat16
        alto: nat32
        nada: nat32
    fin

    tipo Idtr = estructura
        límite: nat16
        base: nat64
    fin

    variable idt: arreglo [256] de Puerta
    variable idtr: Idtr
    público variable paradas: nat32         ; cuántas int3 se han atendido
    público variable apagar_al_fallar: bool
    variable dentro: nat32                  ; cuántas excepciones se están explicando
    público variable guarda_ini, guarda_fin: nat64   ; la página de guarda bajo la pila del núcleo
    público variable pila_ini, pila_fin: nat64       ; la pila del núcleo
    ; [etapa 3]
    público variable al_parar: nat64        ; la función que para a los demás procesadores (Smp64)
    público variable parados: nat32         ; cuántos se han parado (lo dice al_parar)
    público variable otros: nat32           ; a cuántos se ha mandado parar
    variable parada_de: nat64               ; 0, o el número + 1 del procesador que se está parando
    ; [etapa 4] lo que se hace con una excepción de un programa (Procesos):
    ; al_fallo_usuario(n, marco, error, cr2) devuelve cierto si se ha
    ; arreglado (una página que se pone al tocarla) y, si no, cierra el
    ; programa y no vuelve
    público variable al_fallo_usuario: nat64
    ; la zona de las pilas de los hilos y de los procesadores (Pagina64): cada
    ; sitio, 64 KB; la pila, los 32 KB de arriba (desde la etapa 5); los de abajo, sin poner
    público constante ZONA_PILAS = 0xFFFFE00000000000
    público constante SITIO_PILA = 65536            ; [etapa 5] 64 KB: la guarda (32) y la pila (32; eran 16)
    público constante PÁGINAS_PILA = 8
    público constante MAX_PILAS = 4096

    ; el marco que deja una función de interrupción: los quince registros, de r15
    ; (el primero, en [rbp]) a rax (en [rbp+112]); detrás, lo del procesador
    función marco(): nat64
        ensamblador
            mov rax, [rbp]
        fin
    fin

    función cr2(): nat64
        ensamblador
            mov rax, cr2
        fin
    fin

    función lee64(d: nat64): nat64
        variable p: puntero a nat64
        p := puntero(d)
        devolver valor(p)
    fin

    función nombre(n: nat32): puntero a byte
        según nat16(n)
            caso 0: devolver "División por cero (#DE): una división entre cero, o un cociente que no cabe"
            caso 1: devolver "Depuración (#DB): un aviso de los registros de depuración"
            caso 2: devolver "NMI: un aviso grave del hardware (la memoria, el bus o el vigilante)"
            caso 3: devolver "Punto de parada (#BP): una instrucción int3"
            caso 4: devolver "Desbordamiento (#OF): un «into» con el desbordamiento puesto"
            caso 5: devolver "Fuera de límites (#BR): un «bound» que no se cumple"
            caso 6: devolver "Instrucción no válida (#UD): el procesador no conoce (o no tiene) esa instrucción"
            caso 7: devolver "Sin coprocesador (#NM): coma flotante o SSE con el coprocesador apagado"
            caso 8: devolver "Doble fallo (#DF): ha fallado al atender otra excepción"
            caso 9: devolver "Desbordamiento del coprocesador (de los 386: no debería pasar)"
            caso 10: devolver "TSS no válido (#TS)"
            caso 11: devolver "Segmento no presente (#NP)"
            caso 12: devolver "Fallo de la pila (#SS): la pila apunta a donde no debe"
            caso 13: devolver "Protección general (#GP): algo prohibido (una dirección no canónica, un registro privilegiado, un selector malo...)"
            caso 14: devolver "Fallo de página (#PF): una dirección que no está en las tablas de páginas, o sin permiso"
            caso 16: devolver "Error de coma flotante (#MF)"
            caso 17: devolver "Comprobación de alineación (#AC)"
            caso 18: devolver "Comprobación de la máquina (#MC): el procesador ha visto un error del hardware"
            caso 19: devolver "Error de SIMD (#XM): una cuenta de SSE que no sale"
            caso 20: devolver "Virtualización (#VE)"
            caso 21: devolver "Protección del control (#CP): un salto o una vuelta que no cuadran (CET)"
            caso 28: devolver "Inyección del hipervisor (#HV)"
            caso 29: devolver "Comunicación con el VMM (#VC)"
            caso 30: devolver "Seguridad (#SX)"
            si no: devolver "Reservada (el procesador no debería darla)"
        fin
    fin

    ; [etapa 4] la puerta n lleva a la entrada de Entradas (que hace swapgs
    ; si se viene del anillo 3) y esta, a la función f
    función pon_puerta(n: nat32, f: nat64, ist: byte)
        manejadores[n] := f
        f := entrada_de(n)
        idt[n].bajo := nat16(f)
        idt[n].selector := 0x08
        idt[n].ist := ist
        idt[n].tipo_ := 0x8E            ; presente, anillo 0, puerta de interrupción de 64 bits
        idt[n].medio := nat16(f >> 16)
        idt[n].alto := nat32(f >> 32)
        idt[n].nada := 0
    fin

    ; lo que se dice de la excepción n; m es el marco; con_error, si el procesador
    ; ha dejado un número de error (entonces RIP va 8 octetos más allá)
    función rsp_ahora(): nat64
        ensamblador
            mov rax, rsp
        fin
    fin

    función pon64(d: nat64, v: nat64)
        variable p: puntero a nat64
        p := puntero(d)
        valor(p) := v
    fin

    función llama0(f: nat64)
        ensamblador
            mov rax, {f}
            call rax
        fin
    fin

    función llama4(f: nat64, a: nat64, b: nat64, c: nat64, d: nat64): bool
        ensamblador
            push qword {d}
            push qword {c}
            push qword {b}
            push qword {a}
            mov rax, {f}
            call rax
        fin
    fin

    ; [etapa 3] ¿es d de la guarda de una pila de la zona de las pilas?
    público función en_guarda(d: nat64): bool
        si d < ZONA_PILAS o d >= ZONA_PILAS + nat64(SITIO_PILA) * MAX_PILAS entonces devolver falso fin
        devolver (d - ZONA_PILAS) yb (SITIO_PILA - 1) < SITIO_PILA div 2
    fin

    ; [etapa 3] el primero que se para, se queda con la parada y para a los
    ; demás (devuelve cierto: que lo explique); si ya se está parando otro, este
    ; se queda quieto aquí mismo (y lo apunta en su bloque)
    función toma_la_parada(): bool
        variable c: puntero a Cpu
        variable yo_mismo, antes: nat64
        variable p: puntero a nat64
        c := yo_si_hay()
        si c = nulo entonces devolver cierto fin
        yo_mismo := nat64(c.número) + 1
        antes := yo_mismo
        p := dirección(parada_de)
        ensamblador
            mov rdi, {p}
            xor eax, eax
            mov rcx, {yo_mismo}
            db 0xF0, 0x48, 0x0F, 0xB1, 0x0F     ; lock cmpxchg [rdi], rcx
            mov {antes}, rax
        fin
        si antes = 0 entonces
            ; el primero: los demás, a pararse
            si al_parar <> 0 entonces llama0(al_parar) fin
            devolver cierto
        fin
        si antes = yo_mismo entonces devolver cierto fin      ; (otra, al explicar la primera)
        c.parado := 1
        quieto()
        devolver falso
    fin

    ; [etapa 3] lo de los demás procesadores y en cuál ha pasado
    función dónde()
        variable c: puntero a Cpu
        c := yo_si_hay()
        si c = nulo o n_cpus < 2 entonces devolver fin
        escribir("En el procesador ", c.número, " (APIC ", c.apic, ")")
        si otros > 0 entonces
            si parados >= otros y otros = 1 entonces escribir("; el otro se ha parado")
            sino si parados >= otros entonces escribir("; los otros ", otros, " se han parado")
            sino escribir("; de los otros ", otros, ", se han parado ", parados) fin
        fin
        escribir(".\n")
    fin

    función explica(n: nat32, m: nat64, con_error: bool)
        variable d, err, c2: nat64
        variable k: nat32
        variable c: puntero a Cpu
        variable i: nat64
        d := m + 120
        err := 0
        si con_error entonces
            err := lee64(d)
            d := d + 8
        fin
        si n = 14 entonces c2 := cr2() fin
        ; [etapa 4] desde el anillo 3: el marco de verdad está donde diga el
        ; falso (Entradas), y lo explica y lo arregla Procesos
        si lee64(d) = dir_salida() entonces d := lee64(d + 24) fin
        si lee64(d + 8) yb 3 = 3 y al_fallo_usuario <> 0 y n <> 2 y n <> 8 y n <> 18 entonces
            si llama4(al_fallo_usuario, nat64(n), d, err, c2) entonces devolver fin
        fin
        ; [etapa 3] un fallo de página con red: se vuelve adonde diga el procesador
        c := yo_si_hay()
        si n = 14 y c <> nulo entonces
            si c.red <> 0 entonces
                c.fallo := c2
                pon64(d, c.red)
                c.red := 0
                devolver
            fin
        fin
        si n = 3 entonces
            paradas := paradas + 1
            escribir("Punto de parada (int3) número ", paradas, " en RIP=")
            hex16(lee64(d) - 1)
            escribir(": atendido, sigue.\n")
            devolver
        fin
        si no toma_la_parada() entonces devolver fin
        ; una excepción al explicar otra (en la consola, por ejemplo): desde
        ; ahora, solo por el puerto serie
        dentro := dentro + 1
        si dentro > 1 entonces
            ensamblador
                mov qword [C_consola], 0
            fin
        fin
        escribir("\n*** Hispa-64 se ha parado: excepción ", n, " ***\n")
        escribir(nombre(n), "\n")
        dónde()
        k := 1
        mientras k <= 3 hacer
            i := ist(k)
            si c <> nulo entonces
                si k = 1 entonces i := c.ist1 sino si k = 2 entonces i := c.ist2 sino i := c.ist3 fin
            fin
            si rsp_ahora() < i y rsp_ahora() + 16384 >= i entonces
                escribir("(Se atiende con su propia pila: la IST ", k, " de la TSS.)\n")
            fin
            k := k + 1
        fin
        si n = 14 entonces
            escribir("Al ")
            si err yb 16 <> 0 entonces escribir("ejecutar en ")
            sino si err yb 2 <> 0 entonces escribir("escribir en ")
            sino escribir("leer de ") fin
            hex16(c2)
            si err yb 1 = 0 entonces escribir(": la página no está") sino escribir(": la página está, pero sin permiso") fin
            si err yb 4 <> 0 entonces escribir(" (desde un programa)") sino escribir(" (desde el núcleo)") fin
            si err yb 8 <> 0 entonces escribir(" (un bit reservado puesto en las tablas)") fin
            escribir(".\n")
        fin
        si con_error entonces
            escribir("Número de error: ")
            hex(err)
            si n <> 14 y err <> 0 entonces
                escribir(" (selector ")
                hex(err yb 0xFFF8)
                si err yb 2 <> 0 entonces escribir(", de la IDT") fin
                escribir(")")
            fin
            escribir("\n")
        fin
        si n = 8 y lee64(d + 24) >= guarda_ini y lee64(d + 24) < guarda_fin + 256 entonces
            escribir("La pila del núcleo se ha desbordado: RSP=")
            hex16(lee64(d + 24))
            escribir(" está en la página de guarda (")
            hex16(guarda_ini)
            escribir(" - ")
            hex16(guarda_fin - 1)
            escribir("),\nque no está en las tablas a propósito.\n")
        fin
        si n = 14 y c2 >= guarda_ini y c2 < guarda_fin entonces
            escribir("(Esa dirección es la página de guarda de la pila del núcleo: la pila se ha desbordado.)\n")
        fin
        si n = 8 y en_guarda(lee64(d + 24) - 8) entonces
            escribir("La pila de un hilo (o de un procesador) se ha desbordado: RSP=")
            hex16(lee64(d + 24))
            escribir(" está en la guarda de su pila (16 KB sin poner debajo de cada una).\n")
        fin
        si n = 14 y en_guarda(c2) entonces
            escribir("(Esa dirección es de la guarda de la pila de un hilo: su pila se ha desbordado.)\n")
        fin
        si cuántos > 0 entonces
            escribir("En la función ")
            si no nombra(lee64(d)) entonces escribir("(ninguna: no es código del núcleo)") fin
            escribir("\n")
        fin
        escribir("RIP=")
        hex16(lee64(d))
        escribir("  CS=")
        hex(lee64(d + 8))
        escribir("  RFLAGS=")
        hex(lee64(d + 16))
        escribir("  RSP=")
        hex16(lee64(d + 24))
        escribir("\nRAX=")
        hex16(lee64(m + 112))
        escribir(" RBX=")
        hex16(lee64(m + 88))
        escribir(" RCX=")
        hex16(lee64(m + 104))
        escribir(" RDX=")
        hex16(lee64(m + 96))
        escribir("\nRSI=")
        hex16(lee64(m + 72))
        escribir(" RDI=")
        hex16(lee64(m + 64))
        escribir(" RBP=")
        hex16(lee64(m + 80))
        escribir(" R8 =")
        hex16(lee64(m + 56))
        escribir("\nR9 =")
        hex16(lee64(m + 48))
        escribir(" R10=")
        hex16(lee64(m + 40))
        escribir(" R11=")
        hex16(lee64(m + 32))
        escribir(" R12=")
        hex16(lee64(m + 24))
        escribir("\nR13=")
        hex16(lee64(m + 16))
        escribir(" R14=")
        hex16(lee64(m + 8))
        escribir(" R15=")
        hex16(lee64(m))
        escribir("\n")
        llamadas(lee64(m + 80))
        escribir("El procesador queda parado. Apunte lo de arriba (o hágale una foto) y reinicie el equipo.\n")
        si apagar_al_fallar entonces salir(99) fin
        quieto()
    fin

    público función quieto()
        ensamblador
            cli
        .para:
            hlt
            jmp .para
        fin
    fin

    ; ¿puede ser rbp un marco de una función del núcleo? (en su pila, en la de un hilo o en una de las IST)
    función marco_bueno(r: nat64): bool
        si r yb 7 <> 0 entonces devolver falso fin
        ; [etapa 3] o en la pila de un hilo (en la zona de las pilas, fuera de su guarda)
        si r >= ZONA_PILAS y r < ZONA_PILAS + nat64(SITIO_PILA) * MAX_PILAS entonces
            devolver no en_guarda(r) y no en_guarda(r + 8)
        fin
        devolver r >= 0xFFFFFFFF80000000 y r < nob nat64(15)
    fin

    ; quién ha llamado a quién, siguiendo los RBP desde r (con los nombres, si se saben)
    público función llamadas(r: nat64)
        variable n, otra: nat32
        variable vuelta, antes: nat64
        si cuántos = 0 entonces devolver fin
        n := 0
        otra := 0
        antes := 1
        mientras n < 40 y marco_bueno(r) hacer
            vuelta := lee64(r + 8)
            si vuelta < 0xFFFFFFFF80000000 entonces romper fin
            si inicio(vuelta - 1) = antes entonces
                ; (la misma función otra vez: una que se llama a sí misma)
                otra := otra + 1
            sino
                si otra > 0 entonces escribir(" (y ", otra, " veces más)") fin
                otra := 0
                si n = 0 entonces escribir("Llamada desde: ") sino escribir(" <- ") fin
                si no nombra(vuelta - 1) entonces hex(vuelta) fin
                antes := inicio(vuelta - 1)
            fin
            n := n + 1
            r := lee64(r)
        fin
        si otra > 0 entonces escribir(" (y ", otra, " veces más, por lo menos)") fin
        si n > 0 entonces escribir("\n") fin
    fin

    ; una parada del propio núcleo (algo que no puede seguir): lo dice como
    ; las excepciones; detrás de detén_ini, quien la llama escribe el porqué
    ; (lo que haga falta) y acaba con detén_fin
    público función detén_ini(qué: puntero a byte)
        ; (sin interrupciones: que el hilo no cambie de procesador mientras se para)
        ensamblador
            cli
        fin
        si no toma_la_parada() entonces devolver fin
        escribir("\n*** Hispa-64 se ha parado: ", qué, " ***\n")
        dónde()
    fin

    público función detén_fin()
        variable r: nat64
        ; (con una variable, detén_fin tiene su marco: desde él, quién la ha llamado)
        ensamblador
            mov {r}, rbp
        fin
        llamadas(r)
        escribir("El procesador queda parado. Apunte lo de arriba (o hágale una foto) y reinicie el equipo.\n")
        si apagar_al_fallar entonces salir(98) fin
        quieto()
    fin

    interrupción función e0()
        explica(0, marco(), falso)
    fin

    interrupción función e1()
        explica(1, marco(), falso)
    fin

    interrupción función e2()
        explica(2, marco(), falso)
    fin

    interrupción función e3()
        explica(3, marco(), falso)
    fin

    interrupción función e4()
        explica(4, marco(), falso)
    fin

    interrupción función e5()
        explica(5, marco(), falso)
    fin

    interrupción función e6()
        explica(6, marco(), falso)
    fin

    interrupción función e7()
        explica(7, marco(), falso)
    fin

    interrupción función e8(código: nat64)
        explica(8, marco(), cierto)
    fin

    interrupción función e9()
        explica(9, marco(), falso)
    fin

    interrupción función e10(código: nat64)
        explica(10, marco(), cierto)
    fin

    interrupción función e11(código: nat64)
        explica(11, marco(), cierto)
    fin

    interrupción función e12(código: nat64)
        explica(12, marco(), cierto)
    fin

    interrupción función e13(código: nat64)
        explica(13, marco(), cierto)
    fin

    interrupción función e14(código: nat64)
        explica(14, marco(), cierto)
    fin

    interrupción función e15()
        explica(15, marco(), falso)
    fin

    interrupción función e16()
        explica(16, marco(), falso)
    fin

    interrupción función e17(código: nat64)
        explica(17, marco(), cierto)
    fin

    interrupción función e18()
        explica(18, marco(), falso)
    fin

    interrupción función e19()
        explica(19, marco(), falso)
    fin

    interrupción función e20()
        explica(20, marco(), falso)
    fin

    interrupción función e21(código: nat64)
        explica(21, marco(), cierto)
    fin

    interrupción función e22()
        explica(22, marco(), falso)
    fin

    interrupción función e23()
        explica(23, marco(), falso)
    fin

    interrupción función e24()
        explica(24, marco(), falso)
    fin

    interrupción función e25()
        explica(25, marco(), falso)
    fin

    interrupción función e26()
        explica(26, marco(), falso)
    fin

    interrupción función e27()
        explica(27, marco(), falso)
    fin

    interrupción función e28()
        explica(28, marco(), falso)
    fin

    interrupción función e29(código: nat64)
        explica(29, marco(), cierto)
    fin

    interrupción función e30(código: nat64)
        explica(30, marco(), cierto)
    fin

    interrupción función e31()
        explica(31, marco(), falso)
    fin

    ; [etapa 2] una interrupción más (del APIC, de un IOAPIC): el vector n a f
    público función pon_vector(n: nat32, f: nat64)
        pon_puerta(n, f, 0)
    fin

    ; [etapa 3] la IDT, en otro procesador (la misma para todos)
    público función carga_idt()
        ensamblador
            lidt {idtr}
        fin
    fin

    ; monta la IDT con las 32 excepciones y la carga
    público función prepara()

        pon_puerta(0, nat64(dirección(e0)), 0)
        pon_puerta(1, nat64(dirección(e1)), 0)
        pon_puerta(2, nat64(dirección(e2)), 2)
        pon_puerta(3, nat64(dirección(e3)), 0)
        pon_puerta(4, nat64(dirección(e4)), 0)
        pon_puerta(5, nat64(dirección(e5)), 0)
        pon_puerta(6, nat64(dirección(e6)), 0)
        pon_puerta(7, nat64(dirección(e7)), 0)
        pon_puerta(8, nat64(dirección(e8)), 1)
        pon_puerta(9, nat64(dirección(e9)), 0)
        pon_puerta(10, nat64(dirección(e10)), 0)
        pon_puerta(11, nat64(dirección(e11)), 0)
        pon_puerta(12, nat64(dirección(e12)), 0)
