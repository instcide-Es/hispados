            db 0x83, 0xFF, 0x07, 0x77, 0x5D, 0xB8, 0xF3, 0x00, 0x00, 0x00, 0x0F, 0xA3, 0xF8, 0x73, 0x53, 0x4C
            db 0x8D, 0x05, 0x1A, 0x0E, 0x00, 0x00, 0x45, 0x8B, 0x08, 0x41, 0xF7, 0xC1, 0x01, 0x00, 0x00, 0x00
            db 0x75, 0x3C, 0x49, 0x83, 0x78, 0x08, 0x00, 0x74, 0x39, 0x0F, 0xAE, 0xE8, 0x0F, 0x31, 0x48, 0xC1
            db 0xE2, 0x20, 0x48, 0x09, 0xD0, 0x49, 0x2B, 0x40, 0x10, 0x73, 0x02, 0x31, 0xC0, 0x49, 0xF7, 0x60
            db 0x20, 0x48, 0x0F, 0xAC, 0xD0, 0x20, 0x49, 0x03, 0x40, 0x18, 0x85, 0xFF, 0x74, 0x05, 0x83, 0xFF
            db 0x05, 0x75, 0x04, 0x49, 0x03, 0x40, 0x28, 0x45, 0x3B, 0x08, 0x75, 0xBA, 0xF8, 0xC3, 0xF3, 0x90
            db 0xEB, 0xB4, 0xF9, 0xC3, 0xE8, 0x97, 0xFF, 0xFF, 0xFF, 0x72, 0x14, 0x31, 0xD2, 0xB9, 0x00, 0xCA
            db 0x9A, 0x3B, 0x48, 0xF7, 0xF1, 0x48, 0x89, 0x06, 0x48, 0x89, 0x56, 0x08, 0x31, 0xC0, 0xC3, 0xB8
            db 0xE4, 0x00, 0x00, 0x00, 0x0F, 0x05, 0xC3, 0x48, 0x85, 0xFF, 0x74, 0x2B, 0x57, 0x56, 0x31, 0xFF
            db 0xE8, 0x6B, 0xFF, 0xFF, 0xFF, 0x5E, 0x5F, 0x72, 0x2D, 0x31, 0xD2, 0xB9, 0x00, 0xCA, 0x9A, 0x3B
            db 0x48, 0xF7, 0xF1, 0x48, 0x89, 0x07, 0x48, 0x89, 0xD0, 0x31, 0xD2, 0xB9, 0xE8, 0x03, 0x00, 0x00
            db 0x48, 0xF7, 0xF1, 0x48, 0x89, 0x47, 0x08, 0x48, 0x85, 0xF6, 0x74, 0x07, 0x48, 0xC7, 0x06, 0x00
            db 0x00, 0x00, 0x00, 0x31, 0xC0, 0xC3, 0xB8, 0x60, 0x00, 0x00, 0x00, 0x0F, 0x05, 0xC3, 0x57, 0x31
            db 0xFF, 0xE8, 0x2A, 0xFF, 0xFF, 0xFF, 0x5F, 0x72, 0x13, 0x31, 0xD2, 0xB9, 0x00, 0xCA, 0x9A, 0x3B
            db 0x48, 0xF7, 0xF1, 0x48, 0x85, 0xFF, 0x74, 0x03, 0x48, 0x89, 0x07, 0xC3, 0xB8, 0xC9, 0x00, 0x00
            db 0x00, 0x0F, 0x05, 0xC3
            ; </vdso>
        .fin:
        fin
    fin

    función p64(d: nat64, v: nat64)
        variable p: puntero a nat64
        p := puntero(d)
        valor(p) := v
    fin

    función copia(a: nat64, de: nat64, n: nat64)
        ensamblador
            mov rdi, {a}
            mov rsi, {de}
            mov rcx, {n}
            rep movsb
        fin
    fin

    función ceros(a: nat64, n: nat64)
        ensamblador
            mov rdi, {a}
            mov rcx, {n}
            xor eax, eax
            rep stosb
        fin
    fin

    ; los dos marcos, con el código y los datos (sin el reloj aún); falso si no hay memoria
    público función prepara_vdso(): bool
        vdso_código := pide()
        vdso_datos := pide()
        si vdso_código = 0 o vdso_datos = 0 entonces
            si vdso_código <> 0 entonces devuelve(vdso_código) fin
            si vdso_datos <> 0 entonces devuelve(vdso_datos) fin
            vdso_código := 0
            vdso_datos := 0
            devolver falso
        fin
        ceros(virt(vdso_código), 4096)
        ceros(virt(vdso_datos), 4096)
        copia(virt(vdso_código), octetos_vdso(), LARGO_VDSO)
        devolver cierto
    fin

    ; lo del reloj del núcleo y el desfase de la hora (REALTIME - MONOTONIC), al día
    público función vdso_al_día(desfase: nat64)
        variable d, b, sec: nat64
        si vdso_datos = 0 entonces devolver fin
        d := virt(vdso_datos)
        b := toma(dirección(cerrojo))
        sec := m64(d) yb 0xFFFFFFFF
        pon_m32(d, nat32((sec + 1) yb 0xFFFFFFFF))
        ensamblador
            db 0x0F, 0xAE, 0xF8         ; sfence
        fin
        si con_tsc entonces
            p64(d + 16, tsc0)
            p64(d + 24, ns0)
            p64(d + 32, tsc_mult)
        fin
        p64(d + 40, desfase)
        si con_tsc entonces p64(d + 8, 1) sino p64(d + 8, 0) fin
        ensamblador
            db 0x0F, 0xAE, 0xF8         ; sfence
        fin
        pon_m32(d, nat32((sec + 2) yb 0xFFFFFFFF))
        suelta(dirección(cerrojo), b)
    fin

fin Vdso64.
