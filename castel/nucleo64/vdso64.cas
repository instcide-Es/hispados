; =============================================================================
;  vdso64.cas - Hispa-64, etapa 10 f (docs/64/HISPA-64.md, sección 23): el
;  vDSO de los programas (vdso64.asm: la hora sin llamar al sistema). Al
;  preparar los procesos, dos marcos: el del código (los octetos de
;  vdso64.asm, que hace NASM: pruebas.sh mira que sean los mismos) y el de
;  los datos (lo del reloj del núcleo, Reloj64, y el desfase de la hora,
;  Hora64). Cada programa los tiene (Procesos.pon_vdso: de solo leer, el
;  código ejecutable, con la marca DISPOSITIVO: no son del programa, no se
;  sueltan al quitarlos, y al bifurcar se comparten tal cual), y su vector
;  auxiliar dice dónde (AT_SYSINFO_EHDR). Los datos se ponen al día con un
;  número de secuencia (impar mientras se cambian): el vDSO lee otra vez si
;  ha cambiado.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Vdso64

    importar Es64, Cerrojo, Fisica64, Reloj64

    público constante LARGO_VDSO = 708
    público variable vdso_código, vdso_datos: nat64     ; los marcos (físicos), o 0
    variable cerrojo: nat64

    ; los octetos de vdso64.asm (NASM)
