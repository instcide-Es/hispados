            db 0x9E, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x26, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
            db 0x00, 0x5F, 0x5F, 0x76, 0x64, 0x73, 0x6F, 0x5F, 0x63, 0x6C, 0x6F, 0x63, 0x6B, 0x5F, 0x67, 0x65
            db 0x74, 0x74, 0x69, 0x6D, 0x65, 0x00, 0x5F, 0x5F, 0x76, 0x64, 0x73, 0x6F, 0x5F, 0x67, 0x65, 0x74
            db 0x74, 0x69, 0x6D, 0x65, 0x6F, 0x66, 0x64, 0x61, 0x79, 0x00, 0x5F, 0x5F, 0x76, 0x64, 0x73, 0x6F
