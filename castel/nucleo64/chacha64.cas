; =============================================================================
;  chacha64.cas - Hispa-64, etapa 9: el azar del núcleo (docs/64/HISPA-64.md,
;  sección 15): getrandom, /dev/urandom y /dev/random, los números de
;  secuencia de TCP, los puertos y los identificadores de DHCP y DNS.
;  Un generador ChaCha20 (RFC 8439: 20 vueltas) con la clave borrada en cada
;  pedido («fast key erasure»: el bloque siguiente da la clave nueva, así lo
;  ya dado no se puede rehacer aunque luego se vea la clave). La clave se
;  mezcla con lo que haya de entropía: RDSEED y RDRAND si el procesador los
;  tiene (cada pedido), el TSC y el reloj (cada pedido, y lo que la red y
;  las interrupciones van echando con echa()); para mezclar, otro bloque de
;  ChaCha20 con la clave XOR lo nuevo. Sin RDRAND ni RDSEED, lo que dan las
;  esperas de los temporizadores y de la red: no es criptográfico del todo,
;  pero no se repite de un arranque a otro.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Chacha64

    importar Es64, Cerrojo, Reloj64, Entradas

    variable clave: arreglo [8] de nat32
    variable cuenta: nat64
    variable cerrojo_a: nat64
    variable mezcla: arreglo [8] de nat32     ; lo que se va echando (se junta en el pedido siguiente)
    variable mezcla_i: nat32
    público variable pedidos_azar, echados: nat64
    público variable con_hw: bool

    función rotl(x: nat32, n: nat32): nat32
        devolver (x << n) ob (x >> (32 - n))
    fin

    ; un bloque de 64 octetos (16 nat32) con la clave y la cuenta de ahora
    ; ([etapa 10 f] las 20 vueltas, en ensamblador: con lo de Castel, un
    ; getrandom de 8 octetos costaba unos 10 µs, y TestAK hace cientos de
    ; miles; ahora, menos de 1)
    función bloque(ref sal: arreglo [16] de nat32)
        variable x: arreglo [16] de nat32
        variable i: nat32
        x[0] := 0x61707865
        x[1] := 0x3320646E
        x[2] := 0x79622D32
        x[3] := 0x6B206574
        i := 0
        mientras i < 8 hacer
            x[4 + i] := clave[i]
            i := i + 1
        fin
        x[12] := nat32(cuenta yb 0xFFFFFFFF)
        x[13] := nat32(cuenta >> 32)
        x[14] := 0x48495350                       ; «HISP»
        x[15] := 0x41363421                       ; «A64!»
        bloque_de(nat64(dirección(x[0])), nat64(dirección(sal[0])))
        cuenta := cuenta + 1
    fin

    ; las 20 vueltas de ChaCha20 sobre xs (16 nat32), más xs, en d
    función bloque_de(xs: nat64, d: nat64)
        ensamblador
            push rbx
            mov rdi, {d}
            mov rsi, {xs}
            mov ecx, 8
        .copia:
            mov rax, [rsi + rcx * 8 - 8]
            mov [rdi + rcx * 8 - 8], rax
            dec ecx
            jnz .copia
            mov r8d, 10
        .vuelta:
            mov eax, [rdi + 0]
            mov ebx, [rdi + 16]
            mov ecx, [rdi + 32]
            mov edx, [rdi + 48]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 0], eax
            mov [rdi + 16], ebx
            mov [rdi + 32], ecx
            mov [rdi + 48], edx
            mov eax, [rdi + 4]
            mov ebx, [rdi + 20]
            mov ecx, [rdi + 36]
            mov edx, [rdi + 52]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 4], eax
            mov [rdi + 20], ebx
            mov [rdi + 36], ecx
            mov [rdi + 52], edx
            mov eax, [rdi + 8]
            mov ebx, [rdi + 24]
            mov ecx, [rdi + 40]
            mov edx, [rdi + 56]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 8], eax
            mov [rdi + 24], ebx
            mov [rdi + 40], ecx
            mov [rdi + 56], edx
            mov eax, [rdi + 12]
            mov ebx, [rdi + 28]
            mov ecx, [rdi + 44]
            mov edx, [rdi + 60]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 12], eax
            mov [rdi + 28], ebx
            mov [rdi + 44], ecx
            mov [rdi + 60], edx
            mov eax, [rdi + 0]
            mov ebx, [rdi + 20]
            mov ecx, [rdi + 40]
            mov edx, [rdi + 60]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 0], eax
            mov [rdi + 20], ebx
            mov [rdi + 40], ecx
            mov [rdi + 60], edx
            mov eax, [rdi + 4]
            mov ebx, [rdi + 24]
            mov ecx, [rdi + 44]
            mov edx, [rdi + 48]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 4], eax
            mov [rdi + 24], ebx
            mov [rdi + 44], ecx
            mov [rdi + 48], edx
            mov eax, [rdi + 8]
            mov ebx, [rdi + 28]
            mov ecx, [rdi + 32]
            mov edx, [rdi + 52]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 8], eax
            mov [rdi + 28], ebx
            mov [rdi + 32], ecx
            mov [rdi + 52], edx
            mov eax, [rdi + 12]
            mov ebx, [rdi + 16]
            mov ecx, [rdi + 36]
            mov edx, [rdi + 56]
            add eax, ebx
            xor edx, eax
            rol edx, 16
            add ecx, edx
            xor ebx, ecx
            rol ebx, 12
            add eax, ebx
            xor edx, eax
            rol edx, 8
            add ecx, edx
            xor ebx, ecx
            rol ebx, 7
            mov [rdi + 12], eax
            mov [rdi + 16], ebx
            mov [rdi + 36], ecx
            mov [rdi + 56], edx
            dec r8d
            jnz .vuelta
            mov ecx, 16
        .suma:
            mov eax, [rsi + rcx * 4 - 4]
            add [rdi + rcx * 4 - 4], eax
            dec ecx
            jnz .suma
            pop rbx
        fin
    fin

    ; [etapa 10 f] ¿da bloque_de lo del RFC 8439 (2.3.2)?
    variable esperado: arreglo [16] de nat32 = (0xE4E7F110, 0x15593BD1, 0x1FDD0F50, 0xC47120A3, 0xC7F4D1C7, 0x0368C033, 0x9AAA2204, 0x4E6CD4C3,
            0x466482D2, 0x09AA9F07, 0x05D7C214, 0xA2028BD9, 0xD19C12B5, 0xB94E16DE, 0xE883D0CB, 0x4E3C50A2)

    público función prueba_chacha(): bool
        variable x, sal: arreglo [16] de nat32
        variable i: nat32
        variable bien: bool
        x[0] := 0x61707865
        x[1] := 0x3320646E
        x[2] := 0x79622D32
        x[3] := 0x6B206574
        i := 0
        mientras i < 8 hacer
            x[4 + i] := (i * 4) ob ((i * 4 + 1) << 8) ob ((i * 4 + 2) << 16) ob ((i * 4 + 3) << 24)
            i := i + 1
        fin
        x[12] := 1
        x[13] := 0x09000000
        x[14] := 0x4A000000
        x[15] := 0
        bloque_de(nat64(dirección(x[0])), nat64(dirección(sal[0])))
        bien := cierto
        i := 0
        mientras i < 16 hacer
            si sal[i] <> esperado[i] entonces bien := falso fin
            i := i + 1
        fin
        devolver bien
    fin

    ; RDSEED o RDRAND (64 bits), o 0 si no hay o no da
    función del_procesador(): nat64
        variable r, ok_: nat64
        variable k: nat32
        r := 0
        ok_ := 0
        k := 0
        si con_rdseed entonces
            mientras ok_ = 0 y k < 20 hacer
                ensamblador
                    xor ecx, ecx
                    db 0x48, 0x0F, 0xC7, 0xF8       ; rdseed rax
                    db 0x0F, 0x92, 0xC1             ; setc cl
                    mov {r}, rax
                    mov {ok_}, rcx
                fin
                k := k + 1
            fin
        fin
        si ok_ = 0 y con_rdrand entonces
            k := 0
            mientras ok_ = 0 y k < 10 hacer
                ensamblador
                    xor ecx, ecx
                    db 0x48, 0x0F, 0xC7, 0xF0       ; rdrand rax
                    db 0x0F, 0x92, 0xC1             ; setc cl
                    mov {r}, rax
                    mov {ok_}, rcx
                fin
                k := k + 1
            fin
        fin
        si ok_ = 0 entonces devolver 0 fin
        devolver r
    fin

    ; (con el cerrojo) lo nuevo a la clave, y un bloque para que se mezcle
    función mezcla_clave()
        variable s: arreglo [16] de nat32
        variable r: nat64
        variable i: nat32
        r := del_procesador()
        clave[0] := clave[0] xob nat32(r yb 0xFFFFFFFF)
        clave[1] := clave[1] xob nat32(r >> 32)
        r := del_procesador()
        clave[2] := clave[2] xob nat32(r yb 0xFFFFFFFF)
        clave[3] := clave[3] xob nat32(r >> 32)
        r := tsc()
        clave[4] := clave[4] xob nat32(r yb 0xFFFFFFFF)
        clave[5] := clave[5] xob nat32(r >> 32)
        r := ahora_ns()
        clave[6] := clave[6] xob nat32(r yb 0xFFFFFFFF)
        clave[7] := clave[7] xob nat32(r >> 32)
        i := 0
        mientras i < 8 hacer
            clave[i] := clave[i] xob mezcla[i]
            mezcla[i] := 0
            i := i + 1
        fin
        bloque(s)
        i := 0
        mientras i < 8 hacer
            clave[i] := s[i] xob s[i + 8]
            i := i + 1
        fin
    fin

    ; echa algo de entropía (un tiempo, un contador: lo que sea)
    público función echa(x: nat64)
        variable b: nat64
        b := toma(dirección(cerrojo_a))
        mezcla[mezcla_i yb 7] := rotl(mezcla[mezcla_i yb 7], 5) xob nat32(x yb 0xFFFFFFFF) xob nat32(x >> 32) xob nat32(tsc() yb 0xFFFFFFFF)
        mezcla_i := mezcla_i + 1
        echados := echados + 1
        suelta(dirección(cerrojo_a), b)
    fin

    ; n octetos (hasta 4096) en d (memoria del núcleo). [etapa 10 f] Lo del
    ; procesador (RDSEED, RDRAND, que en una máquina virtual o con muchos a
    ; la vez puede costar miles de ciclos) y lo echado se mezclan en la clave
    ; cada 50 ms o cada 4096 pedidos, no en cada uno (como Linux, que lo hace
    ; cada minuto): cada pedido sigue con su clave nueva, sacada del último
    ; bloque y borrada la de antes («fast key erasure»), y con el TSC
    variable mezclada_ns, desde_mezcla: nat64
    público función llena(d: nat64, n: nat64)
        variable s: arreglo [16] de nat32
        variable b, hecho, k, i, t: nat64
        si n > 4096 entonces n := 4096 fin
        b := toma(dirección(cerrojo_a))
        pedidos_azar := pedidos_azar + 1
        t := ahora_ns()
        si desde_mezcla >= 4096 o t - mezclada_ns > 50000000 o t < mezclada_ns entonces
            mezcla_clave()
            mezclada_ns := t
            desde_mezcla := 0
        sino
            t := tsc()
            clave[4] := clave[4] xob nat32(t yb 0xFFFFFFFF)
            clave[5] := clave[5] xob nat32(t >> 32)
        fin
        desde_mezcla := desde_mezcla + 1
        hecho := 0
        mientras hecho < n hacer
            bloque(s)
            k := n - hecho
            si k > 64 entonces k := 64 fin
            copia(d + hecho, nat64(dirección(s[0])), k)
            hecho := hecho + k
        fin
        ; (la clave de después, de un bloque que no se ha dado)
        bloque(s)
        i := 0
        mientras i < 8 hacer
            clave[nat32(i)] := s[nat32(i)]
            i := i + 1
        fin
        i := 0
        mientras i < 16 hacer
            s[nat32(i)] := 0
            i := i + 1
        fin
        suelta(dirección(cerrojo_a), b)
    fin

    función copia(a: nat64, de: nat64, n: nat64)
        ensamblador
            mov rdi, {a}
            mov rsi, {de}
            mov rcx, {n}
            rep movsb
        fin
    fin

    público función azar64(): nat64
        variable x: nat64
        llena(nat64(dirección(x)), 8)
        devolver x
    fin

    público función azar32(): nat32
        devolver nat32(azar64() yb 0xFFFFFFFF)
    fin

    público función prepara_azar()
        variable i: nat32
        con_hw := con_rdrand o con_rdseed
        i := 0
        mientras i < 8 hacer
            clave[i] := nat32(tsc() yb 0xFFFFFFFF) xob (i * 0x9E3779B9)
            i := i + 1
        fin
        cuenta := tsc()
        mezcla_clave()
    fin

fin Chacha64.
