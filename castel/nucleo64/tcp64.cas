; =============================================================================
;  tcp64.cas - Hispa-64, etapa 9: TCP (RFC 793, 1122, 5681 y 6298; docs/64/
;  HISPA-64.md, sección 15), dentro del núcleo, con el cerrojo de la red:
;   - conectar (SYN, con la MSS), escuchar y aceptar (cada uno que llega es
;     un Sock nuevo; se da con accept cuando está ESTABLECIDO);
;   - lo que sale, del búfer de envío (64 KB), en trozos de la MSS, lo que
;     deje la ventana de la otra punta; lo que llega, al de recibir (64 KB),
;     en orden (lo que llega desordenado se tira y se contesta con el ACK de
;     lo que falta: la otra punta lo repite);
;   - la retransmisión con su plazo medido (Jacobson/Karels: SRTT y RTTVAR,
;     de 200 ms a 60 s, doblándose en cada repetición; 8 veces y se corta) y
;     la retransmisión rápida (tres ACK repetidos); la ventana a cero, con la
;     pregunta de un octeto (persist);
;   - el cierre bien hecho: FIN en las dos direcciones, FIN_WAIT_1 y 2,
;     CLOSING, CLOSE_WAIT, LAST_ACK y TIME_WAIT (2 s aquí); RST a lo que no
;     tiene conexión, y si se cierra con algo sin leer (como Linux);
;   - la ventana que se anuncia, al día cuando el programa lee.
;  [etapa 10] La escala de ventana (RFC 7323: la nuestra, 3; búferes de
;  256 KB), y lo que llega desordenado se guarda en su sitio (8 trozos) y se
;  dice con SACK (RFC 2018) en los ACK si la otra punta lo sabe; al llegar
;  lo que faltaba, se junta.
;  [etapa 11] Al mandar, el control de congestión (NewReno: RFC 5681 y
;  6582; la ventana de empezar, 10 segmentos, RFC 6928) y los SACK de la
;  otra punta (RFC 2018 y lo de RFC 6675): en la recuperación rápida se
;  repiten solo los huecos (lo que la otra punta no dice tener), no todo
;  desde lo primero sin confirmar; y SACK también en los segmentos con
;  datos (con menos datos: la MSS no cuenta las opciones, RFC 6691).
;  Lo de Hispa-Pentium (castel/nucleo32/rtcp.cas) es el modelo.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Tcp64

    importar Cifras64, Es64, Monton64, Reloj64, Sondeo64, Chacha64, Redcom64, Ip64

    constante F_FIN = 1
    constante F_SYN = 2
    constante F_RST = 4
    constante F_PSH = 8
    constante F_ACK = 16
    constante RTO_INI = 1000000000              ; 1 s
    constante RTO_MÍN = 200000000
    constante RTO_MÁX = 60000000000
    constante TIME_WAIT_NS = 2000000000
    constante FIN2_NS = 30000000000
    constante MAX_RETX = 8
    constante MAX_RETX_SYN = 5
    constante ECONNREFUSED = -111
    constante ECONNRESET = -104
    constante ETIMEDOUT = -110
    constante EHOSTUNREACH = -113
    público constante TCP_RX = 262144           ; [etapa 10] 256 KB (64 KB hasta la 9)
    público constante TCP_TX = 262144
    constante ESCALA = 3                        ; [etapa 10] la escala de la ventana que se anuncia (hasta 512 KB)
    público variable tcp_escaladas, tcp_sack, tcp_guardados, tcp_juntados: nat64
    público variable pierde_cada: nat32         ; [etapa 10] «red=pierde»: se tira uno de cada tantos segmentos con datos que llegan (para probar)
    variable pierde_cuenta: nat32

    público variable tcp_rst_rx, tcp_rst_tx, tcp_retx, tcp_rápidas, tcp_tirados, tcp_abiertas: nat64
    ; [etapa 11] los ACK que han traído SACK, los huecos repetidos por ellos y
    ; las recuperaciones rápidas acabadas (con todo confirmado)
    público variable tcp_sack_rx, tcp_huecos, tcp_recup_hechas, tcp_cwnd_máx: nat64

    ; las comparaciones de números de secuencia (que dan la vuelta)
    función antes(a: nat32, b: nat32): bool
        devolver ent32(a - b) < 0
    fin

    función antes_o_igual(a: nat32, b: nat32): bool
        devolver ent32(a - b) <= 0
    fin

    función mín(a: nat64, b: nat64): nat64
        si a < b entonces devolver a fin
        devolver b
    fin

    ; la ventana que se anuncia (con la escala: lo que cabe, en múltiplos de 2^escala)
    función ventana(s: puntero a Sock): nat32
        variable v: nat64
        v := rx_sitio(s)
        si s.marcas yb M_NO_LEE <> 0 entonces v := s.rx_tam fin
        si v > nat64(65535) << s.escala_rx entonces v := nat64(65535) << s.escala_rx fin
        v := (v >> s.escala_rx) << s.escala_rx
        devolver nat32(v)
    fin

    ; [etapa 10] las opciones de un SYN: la MSS, la escala (0xFF: no viene) y si sabe SACK
    función opciones_syn(d: nat64, lh: nat32, ref escala: nat32, ref sack: nat32)
        variable i, op, l: nat32
        escala := 0xFF
        sack := 0
        i := 20
        mientras i < lh hacer
            op := m8(d + i)
            si op = 0 entonces romper fin
            si op = 1 entonces
                i := i + 1
                seguir
            fin
            si i + 1 >= lh entonces romper fin
            l := m8(d + i + 1)
            si l < 2 entonces romper fin
            si op = 3 y l = 3 entonces escala := m8(d + i + 2) fin
            si op = 4 y l = 2 entonces sack := 1 fin
            i := i + l
        fin
        si escala <> 0xFF y escala > 14 entonces escala := 14 fin
    fin

    ; ---- [etapa 10] lo desordenado ----
    ; apunta el trozo [ini, fin) (ya puesto en el búfer), juntándolo con los que toque
    función apunta_ooo(s: puntero a Sock, ini: nat32, fin_: nat32)
        variable i, j: nat32
        i := 0
        mientras i < s.ooo_n hacer
            ; (se tocan o se pisan: uno solo)
            si antes_o_igual(s.ooo_ini[i], fin_) y antes_o_igual(ini, s.ooo_fin[i]) entonces
                si antes(s.ooo_ini[i], ini) entonces ini := s.ooo_ini[i] fin
                si antes(fin_, s.ooo_fin[i]) entonces fin_ := s.ooo_fin[i] fin
                j := i
                mientras j + 1 < s.ooo_n hacer
                    s.ooo_ini[j] := s.ooo_ini[j + 1]
                    s.ooo_fin[j] := s.ooo_fin[j + 1]
                    j := j + 1
                fin
                s.ooo_n := s.ooo_n - 1
                i := 0
                seguir
            fin
            i := i + 1
        fin
        si s.ooo_n >= MAX_OOO entonces devolver fin
        ; (el más reciente, el primero: así va el primero en el SACK, como pide la RFC 2018)
        j := s.ooo_n
        mientras j > 0 hacer
            s.ooo_ini[j] := s.ooo_ini[j - 1]
            s.ooo_fin[j] := s.ooo_fin[j - 1]
            j := j - 1
        fin
        s.ooo_ini[0] := ini
        s.ooo_fin[0] := fin_
        s.ooo_n := s.ooo_n + 1
    fin

    ; lo que ya tocaba de lo desordenado pasa a estar en orden
    función junta_ooo(s: puntero a Sock)
        variable i, j: nat32
        variable más: bool
        más := cierto
        mientras más hacer
            más := falso
            i := 0
            mientras i < s.ooo_n hacer
                si antes_o_igual(s.ooo_ini[i], s.rcv_nxt) entonces
                    si antes(s.rcv_nxt, s.ooo_fin[i]) entonces
                        s.rx_n := s.rx_n + nat64(s.ooo_fin[i] - s.rcv_nxt)
                        s.rcv_nxt := s.ooo_fin[i]
                        tcp_juntados := tcp_juntados + 1
                    fin
                    j := i
                    mientras j + 1 < s.ooo_n hacer
                        s.ooo_ini[j] := s.ooo_ini[j + 1]
                        s.ooo_fin[j] := s.ooo_fin[j + 1]
                        j := j + 1
                    fin
                    s.ooo_n := s.ooo_n - 1
                    más := cierto
                    romper
                fin
                i := i + 1
            fin
        fin
        Sondeo64.avisa()
    fin

    ; ---- mandar un segmento ----
    ; con las marcas f, la secuencia seq, y n octetos del búfer de envío desde «off»
    función manda(s: puntero a Sock, f: nat32, seq: nat32, off: nat64, n: nat32)
        variable u: nat64
        variable lh, v, k: nat32
        u := sitio_datos()
        lh := 20
        si f yb F_SYN <> 0 entonces
            ; [etapa 10] la MSS, y la escala y SACK (en el SYN; en el SYN+ACK, si los ha pedido la otra punta)
            lh := 24
            si s.escala_rx <> 0 o f = F_SYN entonces lh := lh + 4 fin
            si s.sack_ok <> 0 o f = F_SYN entonces lh := lh + 4 fin
        sino si f yb F_ACK <> 0 y f yb F_RST = 0 entonces
            ; [etapa 10] los SACK de lo desordenado (como mucho 4 trozos); [etapa
            ; 11] también con datos (quien manda deja sitio: carga_máx)
            lh := 20 + opc_sack(s)
        fin
        pon_be16(u, s.l_puerto)
        pon_be16(u + 2, s.r_puerto)
        pon_be32(u + 4, seq)
        si f yb F_ACK <> 0 entonces pon_be32(u + 8, s.rcv_nxt) sino pon_be32(u + 8, 0) fin
        pon_m8(u + 12, (lh div 4) << 4)
        pon_m8(u + 13, f)
        v := ventana(s)
        si f yb F_SYN <> 0 entonces
            ; (la ventana de un SYN nunca va con escala)
            si v > 65535 entonces v := 65535 fin
            pon_be16(u + 14, v)
        sino
            pon_be16(u + 14, v >> s.escala_rx)
        fin
        pon_be16(u + 16, 0)
        pon_be16(u + 18, 0)
        si f yb F_SYN <> 0 entonces
            pon_m8(u + 20, 2)
            pon_m8(u + 21, 4)
            pon_be16(u + 22, MTU - 40 - extra_ip(s.r_ip))      ; ([etapa 10 c] con IPv6, 20 menos)
            k := 24
            si s.escala_rx <> 0 o f = F_SYN entonces
                pon_m8(u + k, 1)
                pon_m8(u + k + 1, 3)
                pon_m8(u + k + 2, 3)
                pon_m8(u + k + 3, ESCALA)
                k := k + 4
            fin
            si s.sack_ok <> 0 o f = F_SYN entonces
                pon_m8(u + k, 1)
                pon_m8(u + k + 1, 1)
                pon_m8(u + k + 2, 4)
                pon_m8(u + k + 3, 2)
            fin
        sino si lh > 20 entonces
            pon_m8(u + 20, 1)
            pon_m8(u + 21, 1)
            pon_m8(u + 22, 5)
            pon_m8(u + 23, lh - 22)
            k := 0
            mientras k < s.ooo_n y k < 4 hacer
                pon_be32(u + 24 + nat64(k) * 8, s.ooo_ini[k])
                pon_be32(u + 28 + nat64(k) * 8, s.ooo_fin[k])
                k := k + 1
            fin
            tcp_sack := tcp_sack + 1
        fin
        si n > 0 entonces tx_mira(s, off, u + nat64(lh), nat64(n)) fin
        pon_be16(u + 16, plegar(suma(u, nat64(lh + n), suma_falsa(s.l_ip, s.r_ip, 6, lh + n))))
        s.rcv_adv := s.rcv_nxt + v
        s.segs_tx := s.segs_tx + 1
        ip_envía(s.l_ip, s.r_ip, 6, u, lh + n, s.ttl)
    fin

    función manda_ack(s: puntero a Sock)
        manda(s, F_ACK, s.snd_nxt, 0, 0)
    fin

    ; RST a lo que ha llegado sin conexión (de/a: las IP; d: el segmento)
    función manda_rst(de: nat32, a: nat32, d: nat64, n: nat32)
        variable u: nat64
        variable f, seq, ack, lon: nat32
        f := m8(d + 13)
        si f yb F_RST <> 0 entonces devolver fin
        lon := n - (m8(d + 12) >> 4) * 4
        si f yb F_SYN <> 0 entonces lon := lon + 1 fin
        si f yb F_FIN <> 0 entonces lon := lon + 1 fin
        u := sitio_datos()
        pon_be16(u, be16(d + 2))
        pon_be16(u + 2, be16(d))
        si f yb F_ACK <> 0 entonces
            seq := be32(d + 8)
            ack := 0
            pon_m8(u + 13, F_RST)
        sino
            seq := 0
            ack := be32(d + 4) + lon
            pon_m8(u + 13, F_RST ob F_ACK)
        fin
        pon_be32(u + 4, seq)
        pon_be32(u + 8, ack)
        pon_m8(u + 12, 5 << 4)
        pon_be16(u + 14, 0)
        pon_be16(u + 16, 0)
        pon_be16(u + 18, 0)
        pon_be16(u + 16, plegar(suma(u, 20, suma_falsa(a, de, 6, 20))))
        tcp_rst_tx := tcp_rst_tx + 1
        ip_envía(a, de, 6, u, 20, 0)
    fin

    función manda_rst_de(s: puntero a Sock)
        manda(s, F_RST ob F_ACK, s.snd_nxt, 0, 0)
        tcp_rst_tx := tcp_rst_tx + 1
    fin

    ; lo que está fuera y sin confirmar (octetos de datos, sin el SYN ni el FIN)
    función en_vuelo(s: puntero a Sock): nat64
        variable v: nat64
        v := nat64(s.snd_nxt - s.snd_una)
        si s.estado = T_SYN_ENVIADO o s.estado = T_SYN_RECIBIDO entonces devolver 0 fin
        si s.marcas yb M_FIN_ENVIADO <> 0 y v > 0 entonces v := v - 1 fin
        si v > s.tx_n entonces v := s.tx_n fin
        devolver v
    fin

    función pon_retx(s: puntero a Sock)
        si s.t_retx = 0 entonces s.t_retx := ahora_ns() + s.rto fin
    fin

    ; ---- [etapa 11] los SACK que llegan y la congestión ----
    ; lo que miden las opciones de SACK de un segmento que sale (0: no van)
    función opc_sack(s: puntero a Sock): nat32
        si s.sack_ok = 0 o s.ooo_n = 0 entonces devolver 0 fin
        si s.ooo_n > 4 entonces devolver 4 + 32 fin
        devolver 4 + 8 * s.ooo_n
    fin

    ; los datos que caben en un segmento (la MSS, menos las opciones que lleve)
    función carga_máx(s: puntero a Sock): nat64
        devolver nat64(s.mss - opc_sack(s))
    fin

    función máx(a: nat64, b: nat64): nat64
        si a > b entonces devolver a fin
        devolver b
    fin

    ; la ventana de congestión de empezar (al pasar a ESTABLECIDO: la MSS ya se sabe)
    función empieza_cwnd(s: puntero a Sock)
        s.cwnd := 10 * nat64(s.mss)
        s.ssthresh := nat64(0xFFFFFFFF)
        s.en_recup := 0
        s.sb_n := 0
    fin

    ; fuera los trozos ya confirmados (o mal)
    función sb_poda(s: puntero a Sock)
        variable i, j: nat32
        i := 0
        mientras i < s.sb_n hacer
            si antes_o_igual(s.sb_fin[i], s.snd_una) o antes(s.snd_max, s.sb_fin[i]) entonces
                j := i
                mientras j + 1 < s.sb_n hacer
                    s.sb_ini[j] := s.sb_ini[j + 1]
                    s.sb_fin[j] := s.sb_fin[j + 1]
                    j := j + 1
                fin
                s.sb_n := s.sb_n - 1
            sino
                si antes(s.sb_ini[i], s.snd_una) entonces s.sb_ini[i] := s.snd_una fin
                i := i + 1
            fin
        fin
    fin

    ; apunta [ini, fin) de lo que la otra punta dice tener; cierto si es nuevo
    función sb_añade(s: puntero a Sock, ini: nat32, fin_: nat32): bool
        variable i, j: nat32
        variable nuevo: bool
        si antes(ini, s.snd_una) entonces ini := s.snd_una fin
        si antes_o_igual(fin_, ini) o antes(s.snd_max, fin_) entonces devolver falso fin
        nuevo := cierto
        i := 0
        mientras i < s.sb_n hacer
            si antes_o_igual(s.sb_ini[i], fin_) y antes_o_igual(ini, s.sb_fin[i]) entonces
                ; (se tocan o se pisan: uno solo, el de los dos)
                si antes_o_igual(s.sb_ini[i], ini) y antes_o_igual(fin_, s.sb_fin[i]) entonces nuevo := falso fin
                si antes(s.sb_ini[i], ini) entonces ini := s.sb_ini[i] fin
                si antes(fin_, s.sb_fin[i]) entonces fin_ := s.sb_fin[i] fin
                j := i
                mientras j + 1 < s.sb_n hacer
                    s.sb_ini[j] := s.sb_ini[j + 1]
                    s.sb_fin[j] := s.sb_fin[j + 1]
                    j := j + 1
                fin
                s.sb_n := s.sb_n - 1
                i := 0
                seguir
            fin
            i := i + 1
        fin
        si s.sb_n >= MAX_SB entonces
            ; (sin sitio: se olvida el más bajo, que será el primero en confirmarse)
            j := 0
            mientras j + 1 < s.sb_n hacer
                s.sb_ini[j] := s.sb_ini[j + 1]
                s.sb_fin[j] := s.sb_fin[j + 1]
                j := j + 1
            fin
            s.sb_n := s.sb_n - 1
        fin
        ; (por orden de secuencia)
        i := s.sb_n
        mientras i > 0 y antes(ini, s.sb_ini[i - 1]) hacer
            s.sb_ini[i] := s.sb_ini[i - 1]
            s.sb_fin[i] := s.sb_fin[i - 1]
            i := i - 1
        fin
        s.sb_ini[i] := ini
        s.sb_fin[i] := fin_
        s.sb_n := s.sb_n + 1
        devolver nuevo
    fin

    ; los SACK de un segmento que llega (d, con lh de cabecera); cierto si
    ; dicen algo nuevo
    función lee_sack(s: puntero a Sock, d: nat64, lh: nat32): bool
        variable i, op, l, k: nat32
        variable nuevo, hay: bool
        nuevo := falso
        hay := falso
        si s.sack_ok = 0 entonces devolver falso fin
        i := 20
        mientras i < lh hacer
            op := m8(d + i)
            si op = 0 entonces romper fin
            si op = 1 entonces
                i := i + 1
                seguir
            fin
            si i + 1 >= lh entonces romper fin
            l := m8(d + i + 1)
            si l < 2 o i + l > lh entonces romper fin
            si op = 5 y l >= 10 entonces
                hay := cierto
                k := 2
                mientras k + 8 <= l hacer
                    si sb_añade(s, be32(d + i + k), be32(d + i + k + 4)) entonces nuevo := cierto fin
                    k := k + 8
                fin
            fin
            i := i + l
        fin
        si hay entonces tcp_sack_rx := tcp_sack_rx + 1 fin
        devolver nuevo
    fin

    ; el primer hueco desde «desde_»: lo que no dice tener la otra punta por
    ; debajo de lo más alto que dice tener (lo que se da por perdido). Sin
    ; SACK, ninguno. Da su principio y lo que mide (como mucho, un segmento)
    función hueco(s: puntero a Sock, desde_: nat32, ref ini: nat32, ref largo: nat64): bool
        variable x, alto, sig: nat32
        variable i: nat32
        variable otra: bool
        si s.sb_n = 0 entonces devolver falso fin
        alto := s.sb_fin[s.sb_n - 1]
        x := desde_
        si antes(x, s.snd_una) entonces x := s.snd_una fin
        otra := cierto
        mientras otra hacer
            otra := falso
            i := 0
            mientras i < s.sb_n hacer
                si antes_o_igual(s.sb_ini[i], x) y antes(x, s.sb_fin[i]) entonces
                    x := s.sb_fin[i]
                    otra := cierto
                fin
                i := i + 1
            fin
        fin
        si antes_o_igual(alto, x) entonces devolver falso fin
        sig := alto
        i := 0
        mientras i < s.sb_n hacer
            si antes(x, s.sb_ini[i]) y antes(s.sb_ini[i], sig) entonces sig := s.sb_ini[i] fin
            i := i + 1
        fin
        ini := x
        largo := mín(nat64(sig - x), carga_máx(s))
        devolver cierto
    fin

    ; repite el segmento que empieza en «seq» (largo octetos como mucho; de lo
    ; que ya ha salido: por debajo de snd_nxt)
    función repite(s: puntero a Sock, seq: nat32, largo: nat64)
        variable off, vuelo: nat64
        off := nat64(seq - s.snd_una)
        vuelo := en_vuelo(s)
        si off >= vuelo entonces
            ; (lo que falta es el FIN: otra vez, ya; antes de la recuperación
            ; con NewReno, el tercer ACK repetido lo volvía a mandar todo, el
            ; FIN también; sin esto, esperaba al plazo —doblado: segundos— y
            ; la conexión tardaba en cerrarse)
            si s.marcas yb M_FIN_ENVIADO <> 0 y seq = s.snd_max - 1 entonces
                manda(s, F_FIN ob F_ACK, seq, 0, 0)
                s.retx_total := s.retx_total + 1
                pon_retx(s)
            fin
            devolver
        fin
        largo := mín(mín(largo, vuelo - off), carga_máx(s))
        si largo = 0 entonces devolver fin
        manda(s, F_ACK ob F_PSH, seq, off, nat32(largo))
        s.retx_total := s.retx_total + 1
        si antes(s.retx_alto, seq + nat32(largo)) entonces s.retx_alto := seq + nat32(largo) fin
        pon_retx(s)
    fin

    ; el siguiente hueco por repetir en la recuperación (por encima de lo ya repetido)
    función repite_hueco(s: puntero a Sock): bool
        variable ini: nat32
        variable largo: nat64
        si no hueco(s, s.retx_alto, ini, largo) entonces devolver falso fin
        si antes_o_igual(s.snd_nxt, ini) entonces devolver falso fin
        repite(s, ini, largo)
        tcp_huecos := tcp_huecos + 1
        devolver cierto
    fin

    ; manda lo que haya y quepa en la ventana (y el FIN, si toca)
    público función sale_lo_que_haya(s: puntero a Sock)
        variable vuelo, libre, ventana_, n, k: nat64
        si s.estado <> T_ESTABLECIDO y s.estado <> T_ESPERA_CIERRE y s.estado <> T_FIN_ESPERA1 y s.estado <> T_CERRANDO y s.estado <> T_ÚLTIMO_ACK entonces devolver fin
        si s.cwnd = 0 entonces empieza_cwnd(s) fin
        k := 0
        mientras k < 64 hacer
            vuelo := en_vuelo(s)
            libre := s.tx_n - vuelo
            ; [etapa 11] lo que deje la otra punta y la congestión
            ventana_ := mín(nat64(s.snd_wnd), s.cwnd)
            si ventana_ > vuelo entonces ventana_ := ventana_ - vuelo sino ventana_ := 0 fin
            si libre = 0 o ventana_ = 0 entonces romper fin
            n := mín(mín(libre, ventana_), carga_máx(s))
            ; (sin Nagle con poco: lo pequeño sale ya; con TCP_NODELAY, igual)
            manda(s, F_ACK ob F_PSH, s.snd_nxt, vuelo, nat32(n))
            si s.snd_nxt = s.rtt_seq o s.rtt_t = 0 entonces
                s.rtt_seq := s.snd_nxt + nat32(n)
                s.rtt_t := ahora_ns()
            fin
            s.snd_nxt := s.snd_nxt + nat32(n)
            si antes(s.snd_max, s.snd_nxt) entonces s.snd_max := s.snd_nxt fin
            pon_retx(s)
            k := k + 1
        fin
        ; la ventana a cero con algo por mandar: a preguntar
        si s.snd_wnd = 0 y s.tx_n > en_vuelo(s) y s.t_persiste = 0 y s.t_retx = 0 entonces s.t_persiste := ahora_ns() + s.rto fin
        ; el FIN, cuando ya ha salido todo
        si s.marcas yb M_FIN_PENDIENTE <> 0 y s.marcas yb M_FIN_ENVIADO = 0 y en_vuelo(s) = s.tx_n entonces
            manda(s, F_FIN ob F_ACK, s.snd_nxt, 0, 0)
            s.snd_nxt := s.snd_nxt + 1
            si antes(s.snd_max, s.snd_nxt) entonces s.snd_max := s.snd_nxt fin
            s.marcas := s.marcas ob M_FIN_ENVIADO
            si s.estado = T_ESTABLECIDO entonces s.estado := T_FIN_ESPERA1 fin
            si s.estado = T_ESPERA_CIERRE entonces s.estado := T_ÚLTIMO_ACK fin
            pon_retx(s)
        fin
    fin

    ; ---- abrir ----
    ; connect: manda el SYN (s ya tiene l_ip, l_puerto, r_ip y r_puerto)
    público función tcp_conecta(s: puntero a Sock)
        s.iss := azar32()
        s.snd_una := s.iss
        s.snd_nxt := s.iss + 1
        s.snd_max := s.snd_nxt
        s.snd_wnd := 1
        s.mss := 536
        s.rto := RTO_INI
        s.srtt := 0
        s.escala_rx := 0                    ; [etapa 10] (se ofrecen la escala y SACK en el SYN: se ponen si los da la otra punta)
        s.escala_tx := 0
        s.sack_ok := 0
        s.ooo_n := 0
        s.estado := T_SYN_ENVIADO
        manda(s, F_SYN, s.iss, 0, 0)
        s.t_retx := ahora_ns() + s.rto
        s.retx_n := 0
        tcp_abiertas := tcp_abiertas + 1
    fin

    público función tcp_escucha(s: puntero a Sock, máx: nat32)
        si máx = 0 entonces máx := 1 fin
        si máx > COLA_ESCUCHA entonces máx := COLA_ESCUCHA fin
        s.cola_máx := máx
        s.estado := T_ESCUCHA
        s.marcas := s.marcas ob M_ESCUCHA
    fin

    ; el que espera en la cola de uno que escucha (accept): el primero, o nulo
    público función tcp_acepta(s: puntero a Sock): puntero a Sock
        variable c: puntero a Sock
        variable i: nat32
        si s.cola_n = 0 entonces devolver nulo fin
        c := puntero(s.cola[0])
        i := 1
        mientras i < s.cola_n hacer
            s.cola[i - 1] := s.cola[i]
            i := i + 1
        fin
        s.cola_n := s.cola_n - 1
        c.marcas := c.marcas yb (nob nat32(M_EN_COLA))
        c.padre := 0
        devolver c
    fin

    ; la MSS de las opciones de un SYN
    función mss_de(d: nat64, lh: nat32, ip: nat32): nat32
        variable i, op, l, m: nat32
        m := 536
        i := 20
        mientras i < lh hacer
            op := m8(d + i)
            si op = 0 entonces romper fin
            si op = 1 entonces
                i := i + 1
                seguir
            fin
            si i + 1 >= lh entonces romper fin
            l := m8(d + i + 1)
            si l < 2 entonces romper fin
            si op = 2 y l = 4 entonces m := be16(d + i + 2) fin
            i := i + l
        fin
        si m > MTU - 40 - extra_ip(ip) entonces m := MTU - 40 - extra_ip(ip) fin
        si m < 64 entonces m := 64 fin
        devolver m
    fin

    ; ---- buscar la conexión ----
    función busca(de: nat32, de_p: nat32, a: nat32, a_p: nat32): puntero a Sock
        variable i: nat32
        variable s, esc: puntero a Sock
        esc := nulo
        i := 0
        mientras i < MAX_SOCK hacer
            si socks[i] <> 0 entonces
                s := sock(i)
                si s.tipo_ = S_STREAM y s.l_puerto = a_p entonces
                    si s.estado <> T_ESCUCHA y s.estado <> T_CERRADO y s.r_ip = de y s.r_puerto = de_p y s.l_ip = a entonces devolver s fin
                    si s.estado = T_ESCUCHA y (s.l_ip = 0 o s.l_ip = a) y de_su_familia(s, a) entonces esc := s fin
                fin
            fin
            i := i + 1
        fin
        devolver esc
    fin

    ; ---- cerrar ----
    ; (la conexión se acaba) a CERRADO; si nadie la tiene, se suelta
    función acaba(s: puntero a Sock, e: ent32)
        si e <> 0 y s.error = 0 entonces s.error := e fin
        s.estado := T_CERRADO
        s.t_retx := 0
        s.t_persiste := 0
        s.t_fin := 0
        s.marcas := s.marcas ob M_FIN_RECIBIDO
        Sondeo64.avisa()
    fin

    ; ¿se puede soltar ya? (cerrada y sin programa que la tenga, ni en una cola)
    función suelta_si(s: puntero a Sock): bool
        si s.estado = T_CERRADO y s.marcas yb M_HUÉRFANO <> 0 y s.marcas yb M_EN_COLA = 0 entonces
            quita_sock(s)
            devolver cierto
        fin
        devolver falso
    fin

    ; shutdown(SHUT_WR) y close: el FIN, cuando salga lo que queda
    público función tcp_fin(s: puntero a Sock)
        si s.marcas yb M_FIN_PENDIENTE <> 0 entonces devolver fin
        s.marcas := s.marcas ob M_FIN_PENDIENTE
        sale_lo_que_haya(s)
    fin

    ; el programa ya no la tiene (close del último descriptor)
    público función tcp_suelta(s: puntero a Sock)
        variable i: nat32
        variable c: puntero a Sock
        s.marcas := s.marcas ob M_HUÉRFANO
        si s.estado = T_ESCUCHA entonces
            ; los que esperaban en la cola (y los que estaban llegando), fuera con RST
            i := 0
            mientras i < MAX_SOCK hacer
                si socks[i] <> 0 entonces
                    c := sock(i)
                    si c.padre = nat64(s) entonces
                        manda_rst_de(c)
                        c.padre := 0
                        c.marcas := (c.marcas yb (nob nat32(M_EN_COLA))) ob M_HUÉRFANO
                        acaba(c, 0)
                        suelta_si(c)
                    fin
                fin
                i := i + 1
            fin
            s.cola_n := 0
            acaba(s, 0)
        sino si s.estado = T_SYN_ENVIADO o s.estado = T_CERRADO entonces
            acaba(s, 0)
        sino si s.rx_n > 0 o s.estado = T_SYN_RECIBIDO entonces
            ; (con algo sin leer: RST, como Linux)
            manda_rst_de(s)
            acaba(s, 0)
        sino
            tcp_fin(s)
            si s.estado = T_FIN_ESPERA2 y s.t_fin = 0 entonces s.t_fin := ahora_ns() + FIN2_NS fin
        fin
        suelta_si(s)
    fin

    ; ---- lo que llega ----
    ; la RTT medida (ns): SRTT, RTTVAR y el plazo (RFC 6298)
    función mide(s: puntero a Sock, r: nat64)
        variable d: nat64
        si s.srtt = 0 entonces
            s.srtt := r
            s.rttvar := r div 2
        sino
            si s.srtt > r entonces d := s.srtt - r sino d := r - s.srtt fin
            s.rttvar := (3 * s.rttvar + d) div 4
            s.srtt := (7 * s.srtt + r) div 8
        fin
        s.rto := s.srtt + 4 * s.rttvar
        si s.rto < RTO_MÍN entonces s.rto := RTO_MÍN fin
        si s.rto > RTO_MÁX entonces s.rto := RTO_MÁX fin
    fin

    ; el ACK de lo enviado
    función confirma(s: puntero a Sock, ack: nat32, wnd: nat32, seq: nat32, hay_datos: bool, sack_nuevo: bool)
        variable n, datos, vuelo: nat64
        si s.cwnd = 0 entonces empieza_cwnd(s) fin
        si antes(s.snd_una, ack) y antes_o_igual(ack, s.snd_max) entonces
            n := nat64(ack - s.snd_una)
            datos := n
            ; (el FIN no está en el búfer)
            si s.marcas yb M_FIN_ENVIADO <> 0 y ack = s.snd_max entonces datos := datos - 1 fin
            si datos > s.tx_n entonces datos := s.tx_n fin
            tx_quita(s, datos)
            s.snd_una := ack
            si antes(s.snd_nxt, s.snd_una) entonces s.snd_nxt := s.snd_una fin
            si s.rtt_t <> 0 y antes_o_igual(s.rtt_seq, ack) entonces
                si s.retx_n = 0 entonces mide(s, ahora_ns() - s.rtt_t) fin
                s.rtt_t := 0
            fin
            s.retx_n := 0
            s.dupacks := 0
            si antes(s.retx_alto, s.snd_una) entonces s.retx_alto := s.snd_una fin
            sb_poda(s)
            si s.snd_una = s.snd_max entonces s.t_retx := 0 sino s.t_retx := ahora_ns() + s.rto fin
            ; [etapa 11] la congestión
            si s.en_recup <> 0 entonces
                si antes_o_igual(s.recover, ack) entonces
                    ; (todo lo de antes de la pérdida, confirmado: se acaba, RFC 6582)
                    s.en_recup := 0
                    s.cwnd := mín(s.ssthresh, en_vuelo(s) + nat64(s.mss))
                    tcp_recup_hechas := tcp_recup_hechas + 1
                sino
                    ; (un ACK parcial: lo siguiente perdido, ya; la ventana, desinflada)
                    si s.cwnd > n entonces s.cwnd := s.cwnd - n sino s.cwnd := 0 fin
                    s.cwnd := s.cwnd + nat64(s.mss)
                    si no repite_hueco(s) y antes_o_igual(s.retx_alto, s.snd_una) entonces repite(s, s.snd_una, nat64(s.mss)) fin
                fin
            sino si s.cwnd < s.ssthresh entonces
                s.cwnd := s.cwnd + mín(n, nat64(s.mss))        ; (el arranque lento)
            sino
                s.cwnd := s.cwnd + máx(1, nat64(s.mss) * nat64(s.mss) div s.cwnd)
            fin
            si s.cwnd < nat64(s.mss) entonces s.cwnd := nat64(s.mss) fin
            si s.cwnd > nat64(s.tx_tam) * 2 entonces s.cwnd := nat64(s.tx_tam) * 2 fin
            si s.cwnd > tcp_cwnd_máx entonces tcp_cwnd_máx := s.cwnd fin
            Sondeo64.avisa()
        sino si ack = s.snd_una y s.snd_una <> s.snd_max y no hay_datos y (wnd = s.snd_wnd o sack_nuevo) entonces
            ; un ACK repetido (o con SACK de algo nuevo)
            s.dupacks := s.dupacks + 1
            si s.en_recup <> 0 entonces
                ; (otro segmento ha salido de la red: la ventana se infla, y el hueco siguiente)
                s.cwnd := s.cwnd + nat64(s.mss)
                repite_hueco(s)
            sino si s.dupacks = 3 entonces
                tcp_rápidas := tcp_rápidas + 1
                vuelo := en_vuelo(s)
                s.rtt_t := 0
                si vuelo = 0 entonces
                    ; (solo falta el FIN: otra vez)
                    s.snd_nxt := s.snd_una
                    s.marcas := s.marcas yb (nob nat32(M_FIN_ENVIADO))
                sino
                    ; [etapa 11] la recuperación rápida (NewReno): la mitad, y se
                    ; repite lo primero sin confirmar; luego, los huecos que diga SACK
                    s.ssthresh := máx(vuelo div 2, 2 * nat64(s.mss))
                    s.cwnd := s.ssthresh + 3 * nat64(s.mss)
                    s.recover := s.snd_max
                    s.en_recup := 1
                    s.retx_alto := s.snd_una
                    repite(s, s.snd_una, nat64(s.mss))
                    repite_hueco(s)
                fin
            fin
        fin
        ; la ventana (RFC 793: si el segmento es más nuevo)
        si antes(s.snd_wl1, seq) o (s.snd_wl1 = seq y antes_o_igual(s.snd_wl2, ack)) entonces
            si s.snd_wnd = 0 y wnd > 0 entonces s.t_persiste := 0 fin
            s.snd_wnd := wnd
            s.snd_wl1 := seq
            s.snd_wl2 := ack
        fin
    fin

    ; uno que llega a una que escucha: un SYN
    función llega_syn(esc: puntero a Sock, de: nat32, a: nat32, d: nat64, n: nat32, lh: nat32)
        variable c: puntero a Sock
        variable i, pend, esc_, sack_: nat32
        ; (los que ya están llegando a ella cuentan para la cola)
        pend := 0
        i := 0
        mientras i < MAX_SOCK hacer
            si socks[i] <> 0 y sock(i).padre = nat64(esc) entonces pend := pend + 1 fin
            i := i + 1
        fin
        si pend >= esc.cola_máx entonces
            tcp_tirados := tcp_tirados + 1
            devolver
        fin
        c := nuevo_sock(S_STREAM, 6, TCP_RX, TCP_TX)
        si c = nulo entonces
            tcp_tirados := tcp_tirados + 1
            devolver
        fin
        c.l_ip := a
        c.dom := esc.dom                        ; [etapa 10 c]
        c.v6solo := esc.v6solo
        c.l_puerto := esc.l_puerto
        c.r_ip := de
        c.r_puerto := be16(d)
        c.marcas := M_LIGADO ob (esc.marcas yb (M_NODELAY ob M_KEEPALIVE))
        c.padre := nat64(esc)
        c.irs := be32(d + 4)
        c.rcv_nxt := c.irs + 1
        c.iss := azar32()
        c.snd_una := c.iss
        c.snd_nxt := c.iss + 1
        c.snd_max := c.snd_nxt
        c.snd_wnd := be16(d + 14)
        c.snd_wl1 := c.irs
        c.snd_wl2 := c.iss
        c.mss := mss_de(d, lh, de)
        ; [etapa 10] la escala y SACK, si los pide
        opciones_syn(d, lh, esc_, sack_)
        si esc_ <> 0xFF entonces
            c.escala_tx := esc_
            c.escala_rx := ESCALA
            tcp_escaladas := tcp_escaladas + 1
        fin
        c.sack_ok := sack_
        c.rto := RTO_INI
        c.estado := T_SYN_RECIBIDO
        c.t_vivo := ahora_ns()
        manda(c, F_SYN ob F_ACK, c.iss, 0, 0)
        c.t_retx := ahora_ns() + c.rto
        tcp_abiertas := tcp_abiertas + 1
    fin

    ; pasa a ESTABLECIDO una que llegó a una que escucha: a su cola
    función a_la_cola(c: puntero a Sock)
        variable esc: puntero a Sock
        esc := puntero(c.padre)
        si esc = nulo entonces devolver fin
        si esc.cola_n >= COLA_ESCUCHA entonces
            manda_rst_de(c)
            c.padre := 0
            c.marcas := c.marcas ob M_HUÉRFANO
            acaba(c, 0)
            suelta_si(c)
            devolver
        fin
        esc.cola[esc.cola_n] := nat64(c)
        esc.cola_n := esc.cola_n + 1
        c.marcas := c.marcas ob M_EN_COLA
        Sondeo64.avisa()
    fin

    ; lo que ha llegado (Ip64.ent_*): el segmento
    función tcp_entra()
        variable d: nat64
        variable n, de, a, de_p, a_p, seq, ack, f, lh, wnd, lon, cabe, dentro, k, esc_, sack_: nat32
        variable s: puntero a Sock
        variable fin_aquí: bool
        d := ent_d
        n := nat32(ent_n)
        de := ent_de
        a := ent_a
        si n < 20 entonces devolver fin
        si plegar(suma(d, nat64(n), suma_falsa(de, a, 6, n))) <> 0 entonces
            ip_malos := ip_malos + 1
            devolver
        fin
        de_p := be16(d)
        a_p := be16(d + 2)
        seq := be32(d + 4)
        ack := be32(d + 8)
        lh := (m8(d + 12) >> 4) * 4
        f := m8(d + 13)
        wnd := be16(d + 14)
        si lh < 20 o lh > n entonces devolver fin
        lon := n - lh
        s := busca(de, de_p, a, a_p)
        si s = nulo entonces
            manda_rst(de, a, d, n)
            devolver
        fin
        s.segs_rx := s.segs_rx + 1
        s.t_vivo := ahora_ns()
        ; [etapa 10] la ventana de la otra punta, con su escala (la de un SYN, nunca)
        si f yb F_SYN = 0 entonces wnd := wnd << s.escala_tx fin
        ; [etapa 10] «red=pierde»: para probar lo desordenado, uno de cada tantos, fuera
        si pierde_cada > 0 y lon > 0 y s.estado = T_ESTABLECIDO entonces
            pierde_cuenta := pierde_cuenta + 1
            si pierde_cuenta mod pierde_cada = 0 entonces devolver fin
        fin
        ; ---- uno que escucha ----
        si s.estado = T_ESCUCHA entonces
            si f yb F_RST <> 0 entonces devolver fin
            si f yb F_ACK <> 0 entonces
                manda_rst(de, a, d, n)
                devolver
            fin
            si f yb F_SYN <> 0 entonces llega_syn(s, de, a, d, n, lh) fin
            devolver
        fin
        ; ---- el SYN mandado: esperando el SYN+ACK ----
        si s.estado = T_SYN_ENVIADO entonces
            si f yb F_ACK <> 0 y (antes_o_igual(ack, s.iss) o antes(s.snd_max, ack)) entonces
                si f yb F_RST = 0 entonces manda_rst(de, a, d, n) fin
                devolver
            fin
            si f yb F_RST <> 0 entonces
                si f yb F_ACK <> 0 entonces
                    tcp_rst_rx := tcp_rst_rx + 1
                    acaba(s, ECONNREFUSED)
                    suelta_si(s)
                fin
                devolver
            fin
            si f yb F_SYN <> 0 y f yb F_ACK <> 0 entonces
                s.irs := seq
                s.rcv_nxt := seq + 1
                s.snd_una := ack
                s.snd_wnd := wnd
                s.snd_wl1 := seq
                s.snd_wl2 := ack
                s.mss := mss_de(d, lh, s.r_ip)
                ; [etapa 10] ¿ha contestado a la escala y a SACK?
                opciones_syn(d, lh, esc_, sack_)
                si esc_ <> 0xFF entonces
                    s.escala_tx := esc_
                    s.escala_rx := ESCALA
                    tcp_escaladas := tcp_escaladas + 1
                fin
                s.sack_ok := sack_
                si s.retx_n = 0 y s.t_retx <> 0 entonces mide(s, ahora_ns() - (s.t_retx - s.rto)) fin
                s.t_retx := 0
                s.retx_n := 0
                s.estado := T_ESTABLECIDO
                manda_ack(s)
                sale_lo_que_haya(s)
                Sondeo64.avisa()
            fin
            devolver
        fin
        ; ---- lo demás: ¿está dentro de la ventana? ----
        dentro := 1
        si lon = 0 entonces
            si antes(seq, s.rcv_nxt) y f yb (F_SYN ob F_FIN) = 0 entonces dentro := 0 fin
        sino
            si antes_o_igual(seq + lon, s.rcv_nxt) entonces dentro := 0 fin
        fin
        si antes(s.rcv_nxt + ventana(s) + 1, seq) entonces dentro := 0 fin
        si dentro = 0 y f yb F_RST = 0 entonces
            ; (repetido o fuera: se contesta con lo que se espera)
            si s.estado <> T_SYN_RECIBIDO entonces manda_ack(s) fin
            devolver
        fin
        si f yb F_RST <> 0 entonces
            si dentro <> 0 entonces
                tcp_rst_rx := tcp_rst_rx + 1
                si s.estado = T_SYN_RECIBIDO entonces
                    s.marcas := s.marcas ob M_HUÉRFANO
                    s.padre := 0
                    acaba(s, 0)
                sino
                    acaba(s, ECONNRESET)
                fin
                s.marcas := s.marcas ob M_RESETEADO
                suelta_si(s)
            fin
            devolver
        fin
        si f yb F_SYN <> 0 y s.estado <> T_SYN_RECIBIDO entonces
            ; (un SYN dentro de una conexión: se corta)
            manda_rst_de(s)
            acaba(s, ECONNRESET)
            suelta_si(s)
            devolver
        fin
        si f yb F_ACK = 0 entonces devolver fin
        ; ---- el ACK ----
        si s.estado = T_SYN_RECIBIDO entonces
            si antes(s.snd_una, ack) y antes_o_igual(ack, s.snd_max) entonces
                s.snd_una := ack
                s.snd_wnd := wnd
                s.snd_wl1 := seq
                s.snd_wl2 := ack
                s.t_retx := 0
                s.retx_n := 0
                s.estado := T_ESTABLECIDO
                a_la_cola(s)
                si s.estado = T_CERRADO entonces devolver fin
            sino
                manda_rst(de, a, d, n)
                devolver
            fin
        fin
        confirma(s, ack, wnd, seq, lon > 0, lee_sack(s, d, lh))
        ; lo nuestro, confirmado: ¿se acaba algo?
        si s.marcas yb M_FIN_ENVIADO <> 0 y s.snd_una = s.snd_max entonces
            si s.estado = T_FIN_ESPERA1 entonces
                s.estado := T_FIN_ESPERA2
                si s.marcas yb M_HUÉRFANO <> 0 entonces s.t_fin := ahora_ns() + FIN2_NS fin
            sino si s.estado = T_CERRANDO entonces
                s.estado := T_ESPERA_TIEMPO
                s.t_fin := ahora_ns() + TIME_WAIT_NS
            sino si s.estado = T_ÚLTIMO_ACK entonces
                acaba(s, 0)
                suelta_si(s)
                devolver
            fin
        fin
        ; ---- los datos ----
        fin_aquí := falso
        si lon > 0 o f yb F_FIN <> 0 entonces
            si s.estado = T_ESTABLECIDO o s.estado = T_FIN_ESPERA1 o s.estado = T_FIN_ESPERA2 entonces
                si lon > 0 entonces
                    si seq = s.rcv_nxt entonces
                        cabe := lon
                        si s.marcas yb M_NO_LEE <> 0 entonces
                            ; (shutdown(SHUT_RD): se confirma y se tira)
                            s.rcv_nxt := s.rcv_nxt + lon
                        sino
                            si nat64(cabe) > rx_sitio(s) entonces cabe := nat32(rx_sitio(s)) fin
                            si cabe > 0 entonces
                                rx_mete(s, d + lh, nat64(cabe))
                                s.rcv_nxt := s.rcv_nxt + cabe
                                Sondeo64.avisa()
                            fin
                            si cabe < lon entonces tcp_tirados := tcp_tirados + 1 fin
                        fin
                        si cabe = lon y f yb F_FIN <> 0 y s.ooo_n = 0 entonces fin_aquí := cierto fin
                        si s.ooo_n > 0 entonces junta_ooo(s) fin
                    sino si antes(seq, s.rcv_nxt) entonces
                        ; (empieza antes: lo que ya se tenía, fuera)
                        k := s.rcv_nxt - seq
                        si k < lon entonces
                            cabe := lon - k
                            si nat64(cabe) > rx_sitio(s) entonces cabe := nat32(rx_sitio(s)) fin
                            si cabe > 0 entonces
                                rx_mete(s, d + lh + k, nat64(cabe))
                                s.rcv_nxt := s.rcv_nxt + cabe
                                Sondeo64.avisa()
                            fin
                            si cabe = lon - k y f yb F_FIN <> 0 y s.ooo_n = 0 entonces fin_aquí := cierto fin
                            si s.ooo_n > 0 entonces junta_ooo(s) fin
                        fin
                    sino si s.marcas yb M_NO_LEE = 0 y rx_pon_en(s, nat64(seq - s.rcv_nxt), d + lh, nat64(lon)) entonces
                        ; [etapa 10] desordenado: a su sitio, apuntado (y el FIN, si lo trae, lo repetirá)
                        apunta_ooo(s, seq, seq + lon)
                        tcp_guardados := tcp_guardados + 1
                        s.ooo_guardados := s.ooo_guardados + 1
                    sino
                        tcp_tirados := tcp_tirados + 1          ; (desordenado y sin sitio: fuera)
                    fin
                sino si seq = s.rcv_nxt entonces
                    fin_aquí := cierto
                fin
                manda_ack(s)
            sino si s.estado = T_ESPERA_TIEMPO o s.estado = T_ESPERA_CIERRE o s.estado = T_CERRANDO o s.estado = T_ÚLTIMO_ACK entonces
                manda_ack(s)
            fin
        fin
        si fin_aquí y s.marcas yb M_FIN_RECIBIDO = 0 entonces
            s.rcv_nxt := s.rcv_nxt + 1
            s.marcas := s.marcas ob M_FIN_RECIBIDO
            manda_ack(s)
            si s.estado = T_ESTABLECIDO entonces
                s.estado := T_ESPERA_CIERRE
            sino si s.estado = T_FIN_ESPERA1 entonces
                ; (los dos a la vez)
                s.estado := T_CERRANDO
            sino si s.estado = T_FIN_ESPERA2 entonces
                s.estado := T_ESPERA_TIEMPO
                s.t_fin := ahora_ns() + TIME_WAIT_NS
            fin
            Sondeo64.avisa()
        fin
        sale_lo_que_haya(s)
    fin

    ; ICMP «inalcanzable» de una conexión que se está abriendo
    función tcp_inalcanzable(ip: nat64, l_p: nat64, r_p: nat64)
        variable i: nat32
        variable s: puntero a Sock
        i := 0
        mientras i < MAX_SOCK hacer
            si socks[i] <> 0 entonces
                s := sock(i)
                si s.tipo_ = S_STREAM y s.estado = T_SYN_ENVIADO y s.r_ip = nat32(ip) y s.l_puerto = nat32(l_p) y s.r_puerto = nat32(r_p) entonces
                    acaba(s, EHOSTUNREACH)
                    suelta_si(s)
                    devolver
                fin
            fin
            i := i + 1
        fin
    fin

    ; ---- los plazos (cada vuelta del hilo «red») ----
    función tic_de(s: puntero a Sock)
        variable ahora: nat64
        ahora := ahora_ns()
        si s.t_retx <> 0 y ahora >= s.t_retx entonces
            s.retx_n := s.retx_n + 1
            si (s.estado = T_SYN_ENVIADO y s.retx_n > MAX_RETX_SYN) o s.retx_n > MAX_RETX entonces
                acaba(s, ETIMEDOUT)
                si s.marcas yb M_HUÉRFANO <> 0 o s.padre <> 0 entonces
                    s.padre := 0
                    s.marcas := s.marcas ob M_HUÉRFANO
                fin
                suelta_si(s)
                devolver
            fin
            tcp_retx := tcp_retx + 1
            s.retx_total := s.retx_total + 1
            s.rto := s.rto * 2
            si s.rto > RTO_MÁX entonces s.rto := RTO_MÁX fin
            s.t_retx := ahora + s.rto
            s.rtt_t := 0
            si s.estado = T_SYN_ENVIADO entonces
                manda(s, F_SYN, s.iss, 0, 0)
            sino si s.estado = T_SYN_RECIBIDO entonces
                manda(s, F_SYN ob F_ACK, s.iss, 0, 0)
            sino
                ; (desde lo primero sin confirmar; [etapa 11] la congestión: un
                ; segmento, y la mitad de lo que había fuera como umbral; lo de
                ; SACK, olvidado: RFC 2018 deja que la otra punta lo tire)
                si s.cwnd = 0 entonces empieza_cwnd(s) fin
                s.ssthresh := máx(en_vuelo(s) div 2, 2 * nat64(s.mss))
                s.cwnd := nat64(s.mss)
                s.en_recup := 0
                s.sb_n := 0
                s.dupacks := 0
                s.snd_nxt := s.snd_una
                s.marcas := s.marcas yb (nob nat32(M_FIN_ENVIADO))
                si s.estado = T_FIN_ESPERA1 entonces s.estado := T_ESTABLECIDO fin
                si s.estado = T_ÚLTIMO_ACK entonces s.estado := T_ESPERA_CIERRE fin
                si s.estado = T_CERRANDO entonces s.estado := T_ESPERA_CIERRE fin
                s.t_retx := 0
                ; (al menos uno, aunque la ventana esté a cero)
                si s.snd_wnd = 0 entonces s.snd_wnd := 1 fin
                sale_lo_que_haya(s)
                si s.t_retx = 0 entonces s.t_retx := ahora + s.rto fin
            fin
        fin
        si s.t_persiste <> 0 y ahora >= s.t_persiste entonces
            ; la ventana sigue a cero: un octeto, a ver
            s.t_persiste := 0
            si s.snd_wnd = 0 y s.tx_n > en_vuelo(s) entonces
                s.snd_wnd := 1
                sale_lo_que_haya(s)
                s.snd_wnd := 0
            fin
        fin
        si s.t_fin <> 0 y ahora >= s.t_fin entonces
            acaba(s, 0)
            si s.marcas yb M_HUÉRFANO = 0 entonces s.t_fin := 0 fin
            suelta_si(s)
            devolver
        fin
        ; los que llegaban sin padre (el que escuchaba se cerró) se acaban
        si s.estado = T_CERRADO entonces suelta_si(s) fin
    fin

    público variable traza: bool
    variable próxima_traza: nat64

    ; («red=traza») cada 2 s, cómo está cada conexión
    función escribe_traza()
        variable i: nat32
        variable s: puntero a Sock
        i := 0
        mientras i < MAX_SOCK hacer
            si socks[i] <> 0 entonces
                s := sock(i)
                si s.tipo_ = S_STREAM entonces
                    escribir("TCP ", s.l_puerto, "->", s.r_puerto, " ", nombre_estado(s.estado), " una=", s.snd_una - s.iss, " nxt=", s.snd_nxt - s.iss, " max=", s.snd_max - s.iss, " wnd=", s.snd_wnd, " tx=", s.tx_n, " rx=", s.rx_n, " rcv=", s.rcv_nxt - s.irs, " adv=", s.rcv_adv - s.irs, " retx=", s.t_retx <> 0, " pers=", s.t_persiste <> 0, " m=")
                    hex16(nat64(s.marcas))
                    escribir(" refs=", s.refs, "\n")
                fin
            fin
            i := i + 1
        fin
    fin

    función tcp_tic()
        variable i: nat32
        si traza y ahora_ns() >= próxima_traza entonces
            próxima_traza := ahora_ns() + 2000000000
            escribe_traza()
        fin
        i := 0
        mientras i < MAX_SOCK hacer
            si socks[i] <> 0 y sock(i).tipo_ = S_STREAM entonces tic_de(sock(i)) fin
            i := i + 1
        fin
    fin

    ; (al leer el programa) si la ventana se ha abierto bastante, se dice
    público función tcp_leído(s: puntero a Sock)
        variable nueva: nat32
        si s.estado <> T_ESTABLECIDO y s.estado <> T_FIN_ESPERA1 y s.estado <> T_FIN_ESPERA2 entonces devolver fin
        nueva := s.rcv_nxt + ventana(s)
        si ent32(nueva - s.rcv_adv) >= ent32(2 * s.mss) o (ent32(s.rcv_adv - s.rcv_nxt) < ent32(s.mss) y ventana(s) >= s.mss) entonces manda_ack(s) fin
    fin

    público función nombre_estado(e: nat32): puntero a byte
        según nat16(e)
            caso T_CERRADO: devolver "CLOSED"
            caso T_ESCUCHA: devolver "LISTEN"
            caso T_SYN_ENVIADO: devolver "SYN_SENT"
            caso T_SYN_RECIBIDO: devolver "SYN_RECV"
            caso T_ESTABLECIDO: devolver "ESTABLISHED"
            caso T_FIN_ESPERA1: devolver "FIN_WAIT1"
            caso T_FIN_ESPERA2: devolver "FIN_WAIT2"
            caso T_CERRANDO: devolver "CLOSING"
            caso T_ESPERA_CIERRE: devolver "CLOSE_WAIT"
            caso T_ÚLTIMO_ACK: devolver "LAST_ACK"
            caso T_ESPERA_TIEMPO: devolver "TIME_WAIT"
        fin
        devolver "?"
    fin

    público función prepara_tcp()
        al_tcp_entra := nat64(dirección(tcp_entra))
        al_tcp_tic := nat64(dirección(tcp_tic))
        al_tcp_inalcanzable := nat64(dirección(tcp_inalcanzable))
    fin

fin Tcp64.
