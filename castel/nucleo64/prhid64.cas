    función hx2(v: nat32)
        variable d: nat32
        d := (v >> 4) yb 15
        si d < 10 entonces escribir_car('0' + d) sino escribir_car('A' + d - 10) fin
        d := v yb 15
        si d < 10 entonces escribir_car('0' + d) sino escribir_car('A' + d - 10) fin
    fin

    función hx4(v: nat32)
        hx2((v >> 8) yb 0xFF)
        hx2(v yb 0xFF)
    fin

    función octetos(q: puntero a byte, n: nat32)
        variable i: nat32
        i := 0
        mientras i < n hacer
            escribir(" ")
            hx2(q[i])
            i := i + 1
        fin
        escribir("\n")
    fin

    función enseña()
        analiza(dirección(desc[0]), n_desc, dis)
        analizado := cierto
        hid_descriptores := hid_descriptores + 1
        si dis.ratón entonces hid_ratones := hid_ratones + 1 fin
        si dis.absoluto entonces hid_absolutos := hid_absolutos + 1 fin
        si dis.teclado entonces hid_teclados := hid_teclados + 1 fin
        si dis.leds entonces hid_leds := hid_leds + 1 fin
        si dis.modo entonces hid_modos := hid_modos + 1 fin
        si dis.malo entonces hid_malos := hid_malos + 1 fin
        si no detalle entonces devolver fin
        escribir("  descriptor: ", n_desc, " octetos, ", dis.informes, " informes")
        si dis.malo entonces escribir(", mal hecho") fin
        escribir("\n")
        si dis.ratón entonces
            escribir("  ratón: informe ", dis.id, ", ", dis.n_botones, " botones en el bit ", dis.botones_bit, ", X en el ", dis.x_bit)
            escribir(", Y en el ", dis.y_bit, ", de ", dis.eje_bits, " bits; rueda en el ", dis.rueda_bit, ", de ", dis.rueda_bits, " bits; ", dis.largo, " octetos\n")
            si dis.pan_bits <> 0 entonces escribir("  pan: en el bit ", dis.pan_bit, ", de ", dis.pan_bits, " bits\n") fin
        sino
            escribir("  ratón: no\n")
        fin
        si dis.absoluto entonces
            escribir("  absoluto: informe ", dis.abs_id, ", ", dis.abs_n_botones, " botones en el bit ", dis.abs_botones_bit)
            escribir(", X en el ", dis.ax_bit, " (", dis.ax_bits, " bits, de ", dis.ax_mín, " a ", dis.ax_máx, ")")
            escribir(", Y en el ", dis.ay_bit, " (", dis.ay_bits, " bits, de ", dis.ay_mín, " a ", dis.ay_máx, ")")
            escribir("; rueda en el ", dis.abs_rueda_bit, ", de ", dis.abs_rueda_bits, " bits; ", dis.abs_largo, " octetos\n")
        sino
            escribir("  absoluto: no\n")
        fin
        si dis.teclado entonces
            escribir("  teclado: informe ", dis.tec_id, ", ", dis.mod_n, " modificadores en el bit ", dis.mod_bit)
            si dis.teclas_n > 0 entonces
                escribir(", ", dis.teclas_n, " teclas de ", dis.teclas_bits, " bits en el bit ", dis.teclas_bit, " (usos desde ")
                hx2(dis.teclas_uso)
                escribir("h, de ", dis.teclas_mín, " a ", dis.teclas_máx, ")")
            fin
            si dis.mapa_n > 0 entonces
                escribir(", un mapa de ", dis.mapa_n, " teclas en el bit ", dis.mapa_bit, " (desde ")
                hx2(dis.mapa_uso)
                escribir("h)")
            fin
            escribir("; ", dis.tec_largo, " octetos\n")
        sino
            escribir("  teclado: no\n")
        fin
        si dis.leds entonces
            escribir("  leds: informe ", dis.leds_id, ", ", dis.leds_n, " en el bit ", dis.leds_bit, "; ", dis.leds_largo, " octetos\n")
        fin
        si dis.modo entonces
            escribir("  modo: informe ", dis.modo_id, ", en el bit ", dis.modo_bit, ", de ", dis.modo_bits, " bits; el informe, ", dis.modo_largo, " octetos\n")
        sino
            escribir("  modo: no\n")
        fin
        escribir("  digitalizador: ", dis.digitalizador, "\n")
    fin

    función mira()
        si no analizado entonces enseña() fin
    fin

    función informe(q: puntero a byte, n: nat32)
        variable dx, dy, r, pan: ent32
        variable b: nat32
        mira()
        si lee_ratón(dis, q, n, dx, dy, b, r, pan) entonces
            hid_informes := hid_informes + 1
            si detalle entonces
                escribir("  informe: dx=", dx, " dy=", dy, " botones=", b, " rueda=", r, "\n")
                si dis.pan_bits <> 0 entonces escribir("  pan=", pan, "\n") fin
            fin
        sino si detalle entonces
            escribir("  informe: no es del ratón\n")
        fin
    fin

    función absoluto(q: puntero a byte, n: nat32)
        variable ax, ay, b: nat32
        variable r: ent32
        mira()
        si lee_absoluto(dis, q, n, ax, ay, b, r) entonces
            hid_informes := hid_informes + 1
            si detalle entonces escribir("  absoluto: x=", ax, " y=", ay, " botones=", b, " rueda=", r, "\n") fin
        sino si detalle entonces
            escribir("  absoluto: no es del puntero\n")
        fin
    fin

    función teclado(q: puntero a byte, n: nat32)
        variable m, c, i: nat32
        variable t: arreglo [8] de byte
        mira()
        si lee_teclado(dis, q, n, m, dirección(t[0]), c) entonces
            hid_informes := hid_informes + 1
            si detalle entonces
                escribir("  teclado: modificadores ")
                hx2(m)
                escribir("h, teclas")
                si c = 0 entonces escribir(" ninguna") fin
                i := 0
                mientras i < c hacer
                    escribir(" ")
                    hx2(t[i])
                    i := i + 1
                fin
                escribir("\n")
            fin
        sino si detalle entonces
            escribir("  teclado: no es del teclado (o demasiadas teclas a la vez)\n")
        fin
    fin

    función leds(v: nat32)
        variable q: arreglo [16] de byte
        variable n: nat32
        mira()
        n := pon_leds(dis, v, dirección(q[0]))
        si detalle entonces
            escribir("  leds ", v, ":")
            octetos(dirección(q[0]), n)
        fin
    fin

    función hid(q: puntero a byte, n: nat32)
        variable r: nat32
        r := lee_desc_i2c(q, n, hd)
        hid_hid := hid_hid + 1
        si no detalle entonces devolver fin
        escribir("  hid: ", qué_desc(r))
        si r = DI_BIEN entonces
            escribir(": ")
            hx4(hd.fabricante)
            escribir(":")
            hx4(hd.producto)
            escribir(", informe de ", hd.informe_largo, " octetos en ")
            hx4(hd.informe_reg)
            escribir("h, entrada en ")
            hx4(hd.entrada_reg)
            escribir("h (", hd.entrada_máx, "), órdenes en ")
            hx4(hd.orden_reg)
            escribir("h, datos en ")
            hx4(hd.datos_reg)
            escribir("h")
        fin
        escribir("\n")
    fin

    función modo()
        variable q: arreglo [64] de byte
        variable z: arreglo [16] de byte
        variable n, i: nat32
        mira()
        si no dis.modo o dis.modo_largo > 16 entonces
            si detalle entonces escribir("  modo: no se puede\n") fin
            devolver
        fin
        i := 0
        mientras i < 16 hacer
            z[i] := 0
            i := i + 1
        fin
        n := pon_característica(dirección(q[0]), hd, dis.modo_id, dirección(z[0]), dis.modo_largo)
        hid_órdenes := hid_órdenes + 1
        si detalle entonces
            escribir("  modo 0:")
            octetos(dirección(q[0]), n)
        fin
    fin

    función l16(q: puntero a byte, i: nat32): nat32
        devolver nat32(q[i]) ob (nat32(q[i + 1]) << 8)
    fin

    función orden(q: puntero a byte)
        variable ord_: arreglo [8] de byte
        variable n: nat32
        n := pon_orden(dirección(ord_[0]), l16(q, 0), l16(q, 2), l16(q, 4), l16(q, 6))
        hid_órdenes := hid_órdenes + 1
        si detalle entonces
            escribir("  orden:")
            octetos(dirección(ord_[0]), n)
        fin
    fin

    ; todos los guiones; con «con_detalle», lo de cada cosa
    público función prueba_hid(con_detalle: bool)
        variable p, q: puntero a byte
        variable t, n, i: nat32
        detalle := con_detalle
        n_desc := 0
        analizado := falso
        p := puntero(datos())
        mientras p[0] <> 0 hacer
            t := p[0]
            n := nat32(p[1]) ob (nat32(p[2]) << 8)
            q := p + 3
            si t = 'd' entonces
                i := 0
                mientras i < n y n_desc < 2048 hacer
                    desc[n_desc] := q[i]
                    n_desc := n_desc + 1
                    i := i + 1
                fin
                analizado := falso
            sino si t = '?' entonces
                enseña()
            sino si t = 'i' entonces
                informe(q, n)
            sino si t = 'a' entonces
                absoluto(q, n)
            sino si t = 'k' entonces
                teclado(q, n)
            sino si t = 'l' entonces
                leds(l16(q, 0))
            sino si t = 'h' entonces
                hid(q, n)
            sino si t = 'm' entonces
                modo()
            sino si t = 'o' entonces
                orden(q)
            sino si t = '-' entonces
                n_desc := 0
                analizado := falso
                si detalle entonces escribir("  --\n") fin
            fin
            p := p + 3 + n
        fin
    fin

fin PrHid64.
