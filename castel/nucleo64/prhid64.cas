; =============================================================================
;  prhid64.cas - Hispa-64, etapa 6: las pruebas de Hidesc64 (los descriptores
;  de informe HID), en el arranque, sin tocar el equipo. Los guiones de
;  i2chid/ (reales.txt: touchpads y una pantalla táctil de verdad, ELAN,
;  Synaptics y Dell, de las pruebas de Linux; sint.txt: informes, descriptores
;  HID de HID sobre I2C y órdenes hechos a mano, de Hispa-Pentium; qemu.txt:
;  el ratón, la tableta y el teclado USB de QEMU, y otros para lo del USB) van
;  dentro, como octetos (i2chid/hazdatos.py los pone entre «<datos>» y
;  «</datos>»; pruebas.sh mira que estén al día).
;  Sin «prueba=hid», una línea con lo que ha salido; con ella, lo de cada
;  descriptor y cada informe (lo que comprueba pruebas.sh). No depende de nada
;  del núcleo: también se puede probar en Linux (modelo linux64).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo PrHid64

    importar Hidesc64

    ; lo que ha salido (para el resumen)
    público variable hid_descriptores, hid_ratones, hid_absolutos, hid_teclados, hid_leds, hid_modos, hid_malos: nat32
    público variable hid_informes, hid_hid, hid_órdenes: nat32

    variable desc: arreglo [2048] de byte
    variable n_desc: nat32
    variable dis: Diseño
    variable hd: Desc_i2c
    variable analizado, detalle: bool

    ; los guiones, como octetos
    función datos(): nat64
        ensamblador
            mov rax, .ini
            jmp .fin
        .ini:
