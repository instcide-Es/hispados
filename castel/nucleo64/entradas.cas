    ; ¿qué tiene este procesador? (en el que arranca, una vez)
    público función mira_cpu()
        variable máx: nat32
        si visto entonces devolver fin
        visto := cierto
        sitio := nat64(dirección(entradas))     ; (para que el compilador no la quite)
        cpuid(0, 0)
        máx := ra
        cpuid(1, 0)
        con_pcid := rc yb 0x20000 <> 0
        con_rdrand := rc yb 0x40000000 <> 0
        si máx >= 7 entonces
            cpuid(7, 0)
            con_smep := rb yb 0x80 <> 0
            con_smap := rb yb 0x100000 <> 0
            con_umip := rc yb 4 <> 0
        fin
    fin

    ; sin PCID aunque lo haya («sinpcid» en la línea de órdenes: el TCG de QEMU
    ; no lo tiene, así que ese camino solo se prueba en el taller)
    público función sin_pcid()
        mira_cpu()
        con_pcid := falso
    fin

    función cr4_ob(b: nat64)
        ensamblador
            mov rax, cr4
            or rax, {b}
            mov cr4, rax
        fin
    fin

    función cr0_cambia(quita: nat64, pon: nat64)
        ensamblador
            mov rax, cr0
            mov rcx, {quita}
            not rcx
            and rax, rcx
            or rax, {pon}
            mov cr0, rax
        fin
    fin

    función cr0_ob_sse()
        cr0_cambia(0xC, 2)
    fin

    ; lo de este procesador para los programas: syscall (EFER.SCE, STAR,
    ; LSTAR, SFMASK), KERNEL_GS_BASE a cero, SMEP, SMAP, UMIP y PCID, y SSE
    ; (CR0.EM y TS fuera, MP; CR4.OSFXSR y OSXMMEXCPT: los programas de hoy lo
    ; usan; el núcleo no, y el planificador guarda y pone los de cada programa)
    público función prepara_cpu()
        variable b: nat64
        mira_cpu()
        pon_msr(0xC0000080, lee_msr(0xC0000080) ob 1)
        pon_msr(0xC0000081, (nat64(0x10) << 48) ob (nat64(0x08) << 32))
        pon_msr(0xC0000082, dir_sistema())
        pon_msr(0xC0000084, 0x47700)
        pon_msr(0xC0000102, 0)
        cr0_ob_sse()
        b := 0x600
        si con_smep entonces b := b ob 0x100000 fin
        si con_smap entonces b := b ob 0x200000 fin
        si con_umip entonces b := b ob 0x800 fin
        si con_pcid entonces b := b ob 0x20000 fin
        cr4_ob(b)
        ensamblador
            db 0xDB, 0xE3               ; fninit
        fin
    fin

    ; la primera entrada de un hilo en su programa: iretq al anillo 3, en rip
    ; con la pila en rsp, los registros a cero y las interrupciones puestas
    ; (el planificador ya ha puesto CR3, FS y la pila del núcleo). No vuelve.
    público función a_usuario(rip: nat64, rsp: nat64)
        ensamblador
            cli
            mov rax, {rsp}
            mov rcx, {rip}
            push 0x1B
            push rax
            push 0x202
            push 0x23
            push rcx
            xor eax, eax
            xor ebx, ebx
            xor ecx, ecx
            xor edx, edx
            xor esi, esi
            xor edi, edi
            xor ebp, ebp
            xor r8d, r8d
            xor r9d, r9d
            xor r10d, r10d
            xor r11d, r11d
            xor r12d, r12d
            xor r13d, r13d
            xor r14d, r14d
            xor r15d, r15d
            db 0x0F, 0x01, 0xF8         ; swapgs
            iretq
        fin
    fin

fin Entradas.
