; =============================================================================
;  entradas.cas - Hispa-64, etapa 4: las puertas de entrada al núcleo desde
;  los programas (docs/64/HISPA-64.md, sección 10).
;
;  Con programas en el anillo 3, cada interrupción y cada excepción puede
;  llegar estando en el anillo 3, con GS apuntando a lo que quiera el
;  programa: el núcleo lee lo de su procesador en gs:[0] (PorCpu64.yo), así
;  que, al entrar desde el anillo 3, hay que hacer «swapgs» (GS pasa a ser el
;  bloque del procesador, que estaba en KERNEL_GS_BASE) y, al volver, otra
;  vez. Las funciones de interrupción de Castel (las que guardan los quince
;  registros y vuelven con iretq) no lo saben hacer, así que la IDT no apunta
;  a ellas, sino a una entrada de aquí por vector (E64_vN: guarda RAX, pone el
;  número del vector y salta a lo común), que:
;    - si se viene del núcleo (CS del marco con RPL 0), salta a la función de
;      Castel (manejadores[N]) con la pila como estaba: igual que antes;
;    - si se viene del anillo 3, hace swapgs y pone debajo un marco de iretq
;      falso que «vuelve» a E64_salida (en el anillo 0, con la pila apuntando
;      al marco de verdad): la función de Castel acaba con su iretq, llega a
;      E64_salida, que hace swapgs y el iretq de verdad al programa;
;    - el NMI, el doble fallo y el fallo de máquina (con su IST: pueden llegar
;      en cualquier instrucción, también entre un swapgs y el sysret) miran
;      GS_BASE con rdmsr y hacen swapgs solo si es del programa (no vuelven).
;  Excep64.explica reconoce el marco falso (su RIP es E64_salida) y busca el de
;  verdad en su RSP.
;
;  La entrada de «syscall» (E64_sistema; LSTAR): swapgs, la pila del núcleo
;  del hilo (la del bloque del procesador, que pone el planificador al
;  cambiar de hilo, igual que TSS.RSP0), un marco como el de las
;  interrupciones (el de iretq y los quince registros: RAX en +112, RIP en
;  +120) y la función de Castel al_sistema(marco) (Sistema), con las
;  interrupciones puestas. Vuelve con sysret (RCX y R11 del marco).
;  STAR: el núcleo, 0x08 (y 0x10); el anillo 3, desde 0x10: los datos en
;  0x18 | 3 y el código de 64 bits en 0x20 | 3 (gdt64.cas). SFMASK quita IF,
;  TF, DF, AC y NT al entrar.
;
;  Y lo de cada procesador para los programas (prepara_cpu): EFER.SCE y los
;  MSR de syscall, SMEP y SMAP (el núcleo no ejecuta ni toca la memoria de los
;  programas sin querer: la toca por el mapa directo), UMIP y PCID, si los hay.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Entradas

    importar Es64, Cpu64

    ; donde están en el bloque del procesador (PorCpu64.Cpu): lo comprueba
    ; Procesos al empezar
    público constante CPU_PILA_SIS = 184
    público constante CPU_RSP_USUARIO = 192

    público variable manejadores: arreglo [256] de nat64   ; la función de Castel de cada vector
    público variable al_sistema: nat64          ; la función de las llamadas al sistema: al_sistema(marco)
    público variable con_smep, con_smap, con_umip, con_pcid, con_rdrand: bool
    variable visto: bool
    variable sitio: nat64

    ; la entrada del vector n (la que va en la IDT)
    público función entrada_de(n: nat32): nat64
        ensamblador
            lea rax, [E64_tabla]
            mov ecx, {n}
            mov rax, [rax+rcx*8]
        fin
    fin

    ; adonde «vuelve» el marco falso (Excep64 lo reconoce)
    público función dir_salida(): nat64
        ensamblador
            lea rax, [E64_salida]
        fin
    fin

    ; lo que se pone en LSTAR
    público función dir_sistema(): nat64
        ensamblador
            lea rax, [E64_sistema]
        fin
    fin

    ; (no se llama nunca: es el sitio del código de las entradas)
    función entradas()
        ensamblador
            jmp E64_fin
        ; ---- lo común: sin número de error (en la pila: RAX y el marco) ----
        E64_comun_sin:
            push rbx
            lea rbx, {manejadores}
            mov rbx, [rbx+rax*8]
            mov rax, [rsp+24]
            and eax, 3
            jz E64_nucleo
            db 0x0F, 0x01, 0xF8         ; swapgs
            mov rax, rsp
            add rax, 16
            push 0x10
            push rax
            db 0x9C                     ; pushfq (IF = 0: puerta de interrupción)
            push 0x08
            lea rax, [E64_salida]
            push rax
            push rbx
            mov rbx, [rsp+48]
            mov rax, [rsp+56]
            ret
        ; desde el núcleo: RBX y RAX como estaban, y a la función con el marco tal cual
        E64_nucleo:
            mov rax, [rsp+8]
            mov [rsp+8], rbx
            pop rbx
            ret
        ; ---- con número de error (en la pila: RAX, el error y el marco) ----
        E64_comun_con:
            push rbx
            lea rbx, {manejadores}
            mov rbx, [rbx+rax*8]
            mov rax, [rsp+32]
            and eax, 3
            jz E64_nucleo
            db 0x0F, 0x01, 0xF8         ; swapgs
            mov rax, rsp
            add rax, 24
            push 0x10
            push rax
            db 0x9C                     ; pushfq
            push 0x08
            lea rax, [E64_salida]
            push rax
            mov rax, [rsp+56]
            push rax
            push rbx
            mov rbx, [rsp+56]
            mov rax, [rsp+64]
            ret
        ; ---- el NMI, el doble fallo, el fallo de máquina: GS, según GS_BASE ----
        E64_comun_par:
            push rbx
            push rcx
            push rdx
            mov rbx, rax
            mov ecx, 0xC0000101
            rdmsr
            shr edx, 31
            jnz E64_par_ya
            db 0x0F, 0x01, 0xF8         ; swapgs
        E64_par_ya:
            pop rdx
            pop rcx
            lea rax, {manejadores}
            mov rbx, [rax+rbx*8]
            jmp E64_nucleo
        ; ---- la vuelta al anillo 3 de una interrupción ----
        E64_salida:
            db 0x0F, 0x01, 0xF8         ; swapgs
            iretq
        ; ---- syscall ----
        E64_sistema:
            db 0x0F, 0x01, 0xF8                                 ; swapgs
            db 0x65, 0x48, 0x89, 0x24, 0x25, 0xC0, 0, 0, 0      ; mov [gs:192], rsp
            db 0x65, 0x48, 0x8B, 0x24, 0x25, 0xB8, 0, 0, 0      ; mov rsp, [gs:184]
            push 0x1B
            db 0x65, 0xFF, 0x34, 0x25, 0xC0, 0, 0, 0            ; push qword [gs:192]
            push r11
            push 0x23
            push rcx
            push rax
            push rcx
            push rdx
            push rbx
            push rbp
            push rsi
            push rdi
            push r8
            push r9
            push r10
            push r11
            push r12
            push r13
            push r14
            push r15
            mov rbp, rsp
            cld
            sti
            mov rax, rsp
            push rax
            mov rax, {al_sistema}
            call rax
            cli
            pop r15
            pop r14
            pop r13
            pop r12
            pop r11
            pop r10
            pop r9
            pop r8
            pop rdi
            pop rsi
            pop rbp
            pop rbx
            pop rdx
            pop rcx
            pop rax
            mov rcx, [rsp]
            mov r11, [rsp+16]
            mov rsp, [rsp+24]
            db 0x0F, 0x01, 0xF8                                 ; swapgs
            db 0x48, 0x0F, 0x07                                 ; sysretq
        ; ---- una entrada por vector ----
        E64_v0:
            push rax
            mov eax, 0
            jmp E64_comun_sin
        E64_v1:
            push rax
            mov eax, 1
            jmp E64_comun_sin
        E64_v2:
            push rax
            mov eax, 2
            jmp E64_comun_par
        E64_v3:
            push rax
            mov eax, 3
            jmp E64_comun_sin
        E64_v4:
            push rax
            mov eax, 4
            jmp E64_comun_sin
