; =============================================================================
;  vfs64.cas - Hispa-64, etapa 5: el VFS, el sistema de archivos virtual
;  (docs/64/HISPA-64.md, sección 11): una sola forma de ver los archivos, sea
;  cual sea el sistema que los guarda.
;
;   - **Los montajes**: «/» es la unidad en memoria (los módulos del cargador,
;     de solo leer: un sistema de archivos más); cada volumen de un disco que
;     se sabe leer (FAT32, exFAT) se ve en «/» con el nombre de su disco o
;     partición: «/nvme0p1», «/sata0p2»... (y la raíz los lista como carpetas).
;   - **Las rutas**: absolutas, o desde una carpeta abierta (openat y
;     compañía) o desde la carpeta actual del proceso; con «.» y «..»
;     resueltos antes (no hay enlaces); se busca el montaje más largo que
;     encaje y, dentro, trozo a trozo, sin mirar mayúsculas (FAT, exFAT).
;   - **Lo abierto** (Abierto: el nodo, la posición, las marcas de open; lo
;     comparten los descriptores hechos con dup), y lo de Linux: open/openat
;     con O_CREAT, O_EXCL, O_TRUNC, O_APPEND y O_DIRECTORY, read y write (y
;     pread y pwrite), lseek, getdents64, stat/fstat/newfstatat (la estructura
;     de Linux x86-64), mkdir, unlink y rmdir, rename (también entre
;     carpetas), ftruncate, fsync y sync. Los errores, los de Linux.
;  Todo con el mutex del VFS (Nodos64): una operación a la vez; los discos
;  (la caché, NVMe, SATA) tienen sus propios cerrojos.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Vfs64

    importar Cifras64, Es64, Monton64, Hilos64, Sinc64, Discos64, Unidad64, Nodos64, Fat64, Exfat64, Fisica64, Espacios

    público constante O_ACCESO = 3
    público constante O_RDONLY = 0
    público constante O_WRONLY = 1
    público constante O_RDWR = 2
    público constante O_CREAT = 0x40
    público constante O_EXCL = 0x80
    público constante O_TRUNC = 0x200
    público constante O_APPEND = 0x400
    público constante O_DIRECTORY = 0x10000

    público tipo Abierto = estructura
        nodo: nat64
        pos: nat64
        marcas: nat64
        refs: nat64
        ruta: nat64                 ; su ruta absoluta (para openat desde ella)
    fin

    público variable abiertos: nat64            ; los Abierto que hay
    variable fs_error: ent64

    función ab(d: nat64): puntero a Abierto
        devolver puntero(d)
    fin

    función mm(m: nat32): puntero a Montaje
        devolver montaje(m)
    fin

    ; ---- la unidad en memoria como sistema de archivos ----
    función unidad_busca(m: nat32, nombre: puntero a byte): puntero a Nodo
        variable k: ent32
        variable n: puntero a Nodo
        ; [etapa 7] /lib, /usr y /bin son la misma unidad (el cargador
        ; dinámico de musl es /lib/ld-musl-x86_64.so.1, y sus bibliotecas,
        ; /lib o /usr/lib)
        si igual_nombre(nombre, "lib") o igual_nombre(nombre, "usr") o igual_nombre(nombre, "bin") entonces
            n := nodo(mm(m).raíz)
            toma_nodo(n)
            devolver n
        fin
        k := busca_archivo(nombre)
        si k < 0 entonces
            fs_error := ENOENT
            devolver nulo
        fin
        n := busca_nodo(m, nat64(k) + 1)
        si n <> nulo entonces devolver n fin
        n := nuevo_nodo(m, nat64(k) + 1, N_ARCHIVO)
        si n = nulo entonces
            fs_error := ENOMEM
            devolver nulo
        fin
        n.primero := nat64(k)
        n.tamaño := cuánto(nat32(k))
        n.mtime := ahora_unix()
        devolver n
    fin

    ; ---- lo de cada clase ----
    función fs_busca(m: nat32, d: puntero a Nodo, nombre: puntero a byte): puntero a Nodo
        variable n: puntero a Nodo
        n := nulo
        según nat16(mm(m).clase)
            caso FS_UNIDAD: n := unidad_busca(m, nombre)
            caso FS_FAT:
                n := fat_busca(m, d, nombre)
                fs_error := fat_error
            caso FS_EXFAT:
                n := ex_busca(m, d, nombre)
                fs_error := ex_error
        fin
        si n = nulo y fs_error = 0 entonces fs_error := ENOENT fin
        devolver n
    fin

    función fs_lee(n: puntero a Nodo, pos: nat64, a: nat64, cuánto_: nat64): ent64
        según nat16(mm(n.montaje).clase)
            caso FS_UNIDAD:
                si pos >= n.tamaño entonces devolver 0 fin
                si cuánto_ > n.tamaño - pos entonces cuánto_ := n.tamaño - pos fin
                copia_k(a, dónde(nat32(n.primero)) + pos, cuánto_)
                devolver ent64(cuánto_)
            caso FS_FAT: devolver fat_lee(n.montaje, n, pos, a, cuánto_)
            caso FS_EXFAT: devolver ex_lee(n.montaje, n, pos, a, cuánto_)
        fin
        devolver EIO
    fin

    ; suelta una referencia del nodo (si era la última de uno borrado, sus
    ; cúmulos; en exFAT, también la que tenía de su carpeta)
    función suelta(n: puntero a Nodo)
        variable p: nat64
        p := 0
        ; [etapa 10 h] con la última referencia, lo de sus páginas compartidas,
        ; al archivo (si aún tiene nombre), y las páginas, fuera
        si n.refs = 1 y n.comp <> 0 entonces
            si n.borrado = 0 entonces comp_vuelca_(n) fin
            comp_suelta_(n)
        fin
        si n.refs = 1 y n.borrado <> 0 y mm(n.montaje).clase = FS_FAT entonces fat_suelta(n.montaje, n) fin
        si n.refs = 1 y mm(n.montaje).clase = FS_EXFAT entonces p := ex_suelta(n.montaje, n) fin
        suelta_nodo(n)
        si p <> 0 entonces suelta(nodo(p)) fin
    fin

    ; ---- escribir, según la clase (FAT o exFAT) ----
    función fs_crea(m: nat32, d: puntero a Nodo, nombre: puntero a byte, carpeta: bool): puntero a Nodo
        variable n: puntero a Nodo
        si mm(m).clase = FS_EXFAT entonces
            n := ex_crea(m, d, nombre, carpeta)
            fs_error := ex_error
        sino
            n := fat_crea(m, d, nombre, carpeta)
            fs_error := fat_error
        fin
        si n = nulo y fs_error = 0 entonces fs_error := EIO fin
        devolver n
    fin

    función fs_escribe(n: puntero a Nodo, pos: nat64, de: nat64, cuánto_: nat64): ent64
        si mm(n.montaje).clase = FS_EXFAT entonces devolver ex_escribe(n.montaje, n, pos, de, cuánto_) fin
        devolver fat_escribe(n.montaje, n, pos, de, cuánto_)
    fin

    función fs_trunca(n: puntero a Nodo, t: nat64): ent64
        si mm(n.montaje).clase = FS_EXFAT entonces devolver ex_trunca(n.montaje, n, t) fin
        devolver fat_trunca(n.montaje, n, t)
    fin

    función fs_vacía_carpeta(m: nat32, n: puntero a Nodo): bool
        si mm(m).clase = FS_EXFAT entonces devolver ex_vacía_carpeta(m, n) fin
        devolver fat_vacía_carpeta(m, n)
    fin

    función fs_borra(m: nat32, d: puntero a Nodo, n: puntero a Nodo): ent64
        si mm(m).clase = FS_EXFAT entonces devolver ex_borra(m, d, n) fin
        devolver fat_borra(m, d, n)
    fin

    función fs_renombra(m: nat32, d1: puntero a Nodo, n: puntero a Nodo, d2: puntero a Nodo, nombre: puntero a byte): ent64
        si mm(m).clase = FS_EXFAT entonces devolver ex_renombra(m, d1, n, d2, nombre) fin
        devolver fat_renombra(m, d1, n, d2, nombre)
    fin

    función fs_vacía(m: nat32): ent64
        si mm(m).clase = FS_EXFAT entonces devolver ex_vacía(m) fin
        devolver fat_vacía(m)
    fin

    ; ---- las rutas ----
    ; la ruta absoluta y limpia (sin «.», «..», ni «//») de «ruta» vista desde
    ; la carpeta «base» (absoluta); en t (LARGO_RUTA); falso si es muy larga
    ; ([etapa 10 g] sin mirar los enlaces: normaliza y normaliza_e los siguen)
    función normaliza_l(base: puntero a byte, ruta: puntero a byte, t: puntero a byte): bool
        variable n, i, j, k: nat32
        variable fuente: puntero a byte
        variable vez: nat32
        t[0] := '/'
        t[1] := 0
        n := 1
        vez := 0
        si ruta[0] = '/' o base = nulo entonces vez := 1 fin
        mientras vez < 2 hacer
            si vez = 0 entonces fuente := base sino fuente := ruta fin
            i := 0
            mientras fuente[i] <> 0 hacer
                mientras fuente[i] = '/' hacer i := i + 1 fin
                si fuente[i] = 0 entonces romper fin
                j := i
                mientras fuente[j] <> 0 y fuente[j] <> '/' hacer j := j + 1 fin
                si j - i = 1 y fuente[i] = '.' entonces
                    ; nada
                sino si j - i = 2 y fuente[i] = '.' y fuente[i + 1] = '.' entonces
                    ; uno atrás
                    si n > 1 entonces
                        n := n - 1
                        mientras n > 0 y t[n - 1] <> '/' hacer n := n - 1 fin
                        si n > 1 entonces n := n - 1 fin
                    fin
                sino
                    si j - i >= Nodos64.LARGO_NOMBRE entonces devolver falso fin
                    si n + (j - i) + 2 >= LARGO_RUTA entonces devolver falso fin
                    si n > 1 entonces
                        t[n] := '/'
                        n := n + 1
                    fin
                    k := i
                    mientras k < j hacer
                        t[n] := fuente[k]
                        n := n + 1
                        k := k + 1
                    fin
                fin
                t[n] := 0
                i := j
            fin
            vez := vez + 1
        fin
        t[n] := 0
        devolver cierto
    fin

    función baja(c: nat32): nat32
        si c >= 'A' y c <= 'Z' entonces devolver c + 32 fin
        devolver c
    fin

    ; el montaje de la ruta absoluta t (el más largo que encaja); en «resto», dónde
    ; empieza lo de dentro de él
    función montaje_de(t: puntero a byte, ref resto: nat32): nat32
        variable m, mejor, l, mejor_l, i: nat32
        variable r: puntero a byte
        mejor := 0
        mejor_l := 0
        m := 0
        mientras m < n_montajes hacer
            si mm(m).en_uso <> 0 entonces
                r := dirección(mm(m).ruta[0])
                l := largo(r)
                si l = 1 entonces
                    si mejor_l = 0 entonces
                        mejor := m
                        mejor_l := 1
                    fin
                sino
                    i := 0
                    mientras i < l y baja(t[i]) = baja(r[i]) hacer i := i + 1 fin
                    si i = l y (t[l] = 0 o t[l] = '/') y l > mejor_l entonces
                        mejor := m
                        mejor_l := l
                    fin
                fin
            fin
            m := m + 1
        fin
        resto := mejor_l
        si mejor_l = 1 entonces resto := 0 fin
        devolver mejor
    fin

    ; el nodo de la ruta absoluta t (con una referencia), o nulo y fs_error
    ; con «padre»: el de su carpeta, y en «último» el último trozo (vacío si
    ; es la raíz de un montaje)
    función camina(t: puntero a byte, padre: bool, último: puntero a byte, ref m: nat32): puntero a Nodo
        variable resto, i, j, k: nat32
        variable n, sig: puntero a Nodo
        variable trozo: arreglo [256] de byte
        m := montaje_de(t, resto)
        n := nodo(mm(m).raíz)
        toma_nodo(n)
        si último <> nulo entonces último[0] := 0 fin
        i := resto
        mientras cierto hacer
            mientras t[i] = '/' hacer i := i + 1 fin
            si t[i] = 0 entonces devolver n fin
            j := i
            k := 0
            mientras t[j] <> 0 y t[j] <> '/' hacer
                si k < 255 entonces
                    trozo[k] := t[j]
                    k := k + 1
                fin
                j := j + 1
            fin
            trozo[k] := 0
            ; ¿es el último trozo?
            k := j
            mientras t[k] = '/' hacer k := k + 1 fin
            si padre y t[k] = 0 entonces
                si último <> nulo entonces copia_texto(último, dirección(trozo[0]), 256) fin
                devolver n
            fin
            si n.clase <> N_CARPETA entonces
                suelta(n)
                fs_error := ENOTDIR
                devolver nulo
            fin
            sig := fs_busca(m, n, dirección(trozo[0]))
            suelta(n)
            si sig = nulo entonces devolver nulo fin
            n := sig
            i := j
        fin
        devolver nulo
    fin

    ; ---- [etapa 10 g] los enlaces simbólicos ----
    ; FAT y exFAT no los tienen (en Linux, symlink en vfat da EPERM); /tmp, el
    ; disco en memoria, hace aquí de tmpfs, que sí: sus enlaces se guardan en
    ; esta tabla, en la memoria (la ruta absoluta del enlace, ya sin enlaces por
    ; en medio, y lo que dice, tal cual). Los sigue todo lo que va por una ruta
    ; (normaliza y normaliza_e, hasta 40 veces: después, ELOOP, como Linux), y
    ; los ven getdents64 (DT_LNK), lstat (S_IFLNK), readlink, unlink, rename,
    ; rmdir (ENOTEMPTY si la carpeta tiene alguno) y open con O_NOFOLLOW (ELOOP)
    ; o con O_CREAT y O_EXCL (EEXIST). Lo único que no es como Linux: «..» se
    ; resuelve antes que los enlaces (en la ruta, sin mirar el disco).
    público constante MAX_ENLACES = 256
    público constante ELOOP = -40
    público constante O_NOFOLLOW = 0x20000
    constante GALLETA_ENL = 0x4000000000000000         ; getdents64: de aquí en adelante, los enlaces
    variable enl_ruta, enl_dest, enl_hora: arreglo [MAX_ENLACES] de nat64   ; (enl_ruta 0: libre)
    público variable n_enlaces: nat32                   ; los que hay
    variable enl_mutex: Mutex                          ; (se toma con el del VFS o sin él; nunca al revés)

    función bajar(c: nat32): nat32
        si c >= 'A' y c <= 'Z' entonces devolver c + 32 fin
        devolver c
    fin

    ; si r (una ruta absoluta) es el principio de t, hasta un «/» o el final, su
    ; largo; si no, 0 (sin mirar las mayúsculas, como FAT)
    función prefijo_ruta(r: puntero a byte, t: puntero a byte): nat32
        variable i: nat32
        i := 0
        mientras r[i] <> 0 y bajar(r[i]) = bajar(t[i]) hacer i := i + 1 fin
        si r[i] <> 0 entonces devolver 0 fin
        si t[i] = 0 o t[i] = '/' entonces devolver i fin
        devolver 0
    fin

    ; (con enl_cerrojo) el enlace que es t, o MAX_ENLACES
    función enlace_de(t: puntero a byte): nat32
        variable i, l: nat32
        si n_enlaces = 0 entonces devolver MAX_ENLACES fin
        i := 0
        mientras i < MAX_ENLACES hacer
            si enl_ruta[i] <> 0 entonces
                l := prefijo_ruta(puntero(enl_ruta[i]), t)
                si l > 0 y t[l] = 0 entonces devolver i fin
            fin
            i := i + 1
        fin
        devolver MAX_ENLACES
    fin

    ; sigue los enlaces de t (absoluta y limpia, LARGO_RUTA): los de en medio
    ; siempre; el último, si «último»; falso y el error si da más de 40 vueltas
    ; (ELOOP) o sale muy larga (ENAMETOOLONG)
    función sigue_enlaces(t: puntero a byte, último: bool, ref err: ent64): bool
        variable i, mejor, l, ml, vueltas, j, k: nat32
        variable b: nat64
        variable bloque, padre, dest, nueva: puntero a byte
        si n_enlaces = 0 entonces devolver cierto fin
        bloque := nulo
        vueltas := 0
        mientras cierto hacer
            si bloque = nulo entonces
                bloque := reserva(3 * LARGO_RUTA)
                si bloque = nulo entonces
                    err := ENOMEM
                    devolver falso
                fin
                padre := bloque
                dest := dirección(bloque[LARGO_RUTA])
                nueva := dirección(bloque[2 * LARGO_RUTA])
            fin
            cierra_mutex(dirección(enl_mutex))
            mejor := MAX_ENLACES
            ml := 0
            i := 0
            mientras i < MAX_ENLACES hacer
                si enl_ruta[i] <> 0 entonces
                    l := prefijo_ruta(puntero(enl_ruta[i]), t)
                    si l > 0 y (t[l] = '/' o último) y (mejor = MAX_ENLACES o l < ml) entonces
                        mejor := i
                        ml := l
                    fin
                fin
                i := i + 1
            fin
            si mejor < MAX_ENLACES entonces
                ; su carpeta y lo que dice
                copia_texto(padre, puntero(enl_ruta[mejor]), LARGO_RUTA)
                copia_texto(dest, puntero(enl_dest[mejor]), LARGO_RUTA)
            fin
            abre_mutex(dirección(enl_mutex))
            si mejor = MAX_ENLACES entonces
                libera(bloque)
                devolver cierto
            fin
            vueltas := vueltas + 1
            si vueltas > 40 entonces
                libera(bloque)
                err := ELOOP
                devolver falso
            fin
            j := ml
            mientras j > 0 y padre[j] <> '/' hacer j := j - 1 fin
            si j = 0 entonces padre[1] := 0 sino padre[j] := 0 fin
            si no normaliza_l(padre, dest, nueva) entonces
                libera(bloque)
                err := ENAMETOOLONG
                devolver falso
            fin
            ; y lo que seguía en t
            k := largo(nueva)
            si k = 1 y t[ml] = '/' entonces k := 0 fin            ; («/» y «/resto»: «/resto»)
            j := ml
            mientras t[j] <> 0 hacer
                si k + 1 >= LARGO_RUTA entonces
                    libera(bloque)
                    err := ENAMETOOLONG
                    devolver falso
                fin
                nueva[k] := t[j]
                k := k + 1
                j := j + 1
            fin
            nueva[k] := 0
            copia_texto(t, nueva, LARGO_RUTA)
        fin
        devolver cierto
    fin

    ; normaliza_l y los enlaces (todos)
    público función normaliza(base: puntero a byte, ruta: puntero a byte, t: puntero a byte): bool
        variable err: ent64
        devolver normaliza_e(base, ruta, t, cierto, err)
    fin

    ; normaliza_l y los enlaces: los de en medio, y el último si «último»;
    ; falso y el error (ENAMETOOLONG, ELOOP, ENOMEM)
    público función normaliza_e(base: puntero a byte, ruta: puntero a byte, t: puntero a byte, último: bool, ref err: ent64): bool
        err := ENAMETOOLONG
        si no normaliza_l(base, ruta, t) entonces devolver falso fin
        err := 0
        devolver sigue_enlaces(t, último, err)
    fin

    ; ¿es el montaje m el disco en memoria de /tmp (el que tiene enlaces)?
    función de_memoria(m: nat32): bool
        devolver mm(m).clase = FS_FAT y mm(m).disco <> 0xFFFFFFFF y clase_dk(mm(m).disco) = D_MEM
    fin

    ; ¿es t (absoluta, sin enlaces en medio) un enlace? Lo que dice, en d
    ; (LARGO_RUTA, si no es nulo), y su largo; -1 si no lo es
    público función vfs_enlace(t: puntero a byte, d: puntero a byte): ent64
        variable i: nat32
        variable b: nat64
        variable r: ent64
        si n_enlaces = 0 entonces devolver -1 fin
        cierra_mutex(dirección(enl_mutex))
        i := enlace_de(t)
        r := -1
        si i < MAX_ENLACES entonces
            r := ent64(largo(puntero(enl_dest[i])))
            si d <> nulo entonces copia_texto(d, puntero(enl_dest[i]), LARGO_RUTA) fin
        fin
        abre_mutex(dirección(enl_mutex))
        devolver r
    fin

    ; quita el enlace t; falso si no lo es
    función quita_enlace(t: puntero a byte): bool
        variable i: nat32
        variable b, r, d: nat64
        r := 0
        d := 0
        cierra_mutex(dirección(enl_mutex))
        i := enlace_de(t)
        si i < MAX_ENLACES entonces
            r := enl_ruta[i]
            d := enl_dest[i]
            enl_ruta[i] := 0
            enl_dest[i] := 0
            n_enlaces := n_enlaces - 1
        fin
        abre_mutex(dirección(enl_mutex))
        si r = 0 entonces devolver falso fin
        libera(puntero(r))
        libera(puntero(d))
        devolver cierto
    fin

    ; ¿hay algún enlace dentro de la carpeta t? (rmdir: ENOTEMPTY)
    función enlaces_en(t: puntero a byte): bool
        variable i, l: nat32
        variable b: nat64
        variable r: puntero a byte
        variable hay: bool
        si n_enlaces = 0 entonces devolver falso fin
        hay := falso
        cierra_mutex(dirección(enl_mutex))
        i := 0
        mientras i < MAX_ENLACES y no hay hacer
            si enl_ruta[i] <> 0 entonces
                r := puntero(enl_ruta[i])
                l := prefijo_ruta(t, r)
                si l > 0 y r[l] = '/' entonces hay := cierto fin
            fin
            i := i + 1
        fin
        abre_mutex(dirección(enl_mutex))
        devolver hay
    fin

    ; ---- abrir y cerrar ----
    función nuevo_abierto(n: puntero a Nodo, marcas: nat64, t: puntero a byte): puntero a Abierto
        variable a: puntero a Abierto
        variable r: nat64
        a := puntero(nat64(reserva(tamaño(Abierto))))
        si a = nulo entonces devolver nulo fin
        r := nat64(reserva(nat64(largo(t)) + 1))
        si r = 0 entonces
            libera(puntero(nat64(a)))
            devolver nulo
        fin
        copia_texto(puntero(r), t, largo(t) + 1)
        a.nodo := nat64(n)
        a.pos := 0
        a.marcas := marcas
        a.refs := 1
        a.ruta := r
        abiertos := abiertos + 1
        devolver a
    fin

    ; abre «ruta» (desde la carpeta base, absoluta; nulo: «/») con las marcas
    ; de open de Linux; nulo y en «err» el error si no se puede
    público función vfs_abre(base: puntero a byte, ruta: puntero a byte, marcas: nat64, ref err: ent64): puntero a Abierto
        variable t: puntero a byte
        variable último: arreglo [256] de byte
        variable d, n: puntero a Nodo
        variable m: nat32
        variable a: puntero a Abierto
        variable escribe: bool
        err := 0
        si ruta[0] = 0 entonces
            err := ENOENT
            devolver nulo
        fin
        t := reserva(LARGO_RUTA)
        si t = nulo entonces
            err := ENOMEM
            devolver nulo
        fin
        ; ([etapa 10 g] el último trozo, si es un enlace: con O_NOFOLLOW, ELOOP;
        ; con O_CREAT y O_EXCL, EEXIST; si no, se sigue)
        si no normaliza_e(base, ruta, t, falso, err) entonces
            libera(t)
            devolver nulo
        fin
        si vfs_enlace(t, nulo) >= 0 entonces
            si marcas yb O_NOFOLLOW <> 0 entonces err := ELOOP
            sino si marcas yb (O_CREAT ob O_EXCL) = O_CREAT ob O_EXCL entonces err := EEXIST
            sino si no sigue_enlaces(t, cierto, err) entonces
                si err = 0 entonces err := ELOOP fin
            fin
            si err <> 0 entonces
                libera(t)
                devolver nulo
            fin
        fin
        escribe := marcas yb O_ACCESO <> O_RDONLY
        cierra_vfs()
        fs_error := 0
        d := camina(t, cierto, dirección(último[0]), m)
        si d = nulo entonces
            err := fs_error
        sino si último[0] = 0 entonces
            ; la raíz de un montaje
            n := d
        sino
            si d.clase <> N_CARPETA entonces
                err := ENOTDIR
                suelta(d)
                d := nulo
            sino
                n := fs_busca(m, d, dirección(último[0]))
                si n = nulo entonces
                    si fs_error <> ENOENT o marcas yb O_CREAT = 0 entonces
                        err := fs_error
                    sino si mm(m).solo_leer <> 0 entonces
                        err := EROFS
                    sino
                        n := fs_crea(m, d, dirección(último[0]), falso)
                        si n = nulo entonces err := fs_error fin
                    fin
                sino si marcas yb (O_CREAT ob O_EXCL) = O_CREAT ob O_EXCL entonces
                    err := EEXIST
                    suelta(n)
                    n := nulo
                fin
                suelta(d)
            fin
        fin
        a := nulo
        si err = 0 entonces
            si n.clase = N_CARPETA y escribe entonces err := EISDIR
            sino si n.clase <> N_CARPETA y marcas yb O_DIRECTORY <> 0 entonces err := ENOTDIR
            sino si (escribe o marcas yb O_TRUNC <> 0) y mm(m).solo_leer <> 0 entonces err := EROFS
            fin
            si err = 0 y marcas yb O_TRUNC <> 0 y escribe y n.clase = N_ARCHIVO y n.tamaño > 0 entonces
                err := fs_trunca(n, 0)
            fin
            si err = 0 entonces
                a := nuevo_abierto(n, marcas, t)
                si a = nulo entonces err := ENOMEM fin
            fin
            si err <> 0 entonces suelta(n) fin
        fin
        abre_vfs()
        libera(t)
        si err = 0 y a = nulo entonces err := ENOMEM fin
        devolver a
    fin

    ; un descriptor más para lo mismo (dup)
    público función vfs_otro(a: puntero a Abierto)
        cierra_vfs()
        a.refs := a.refs + 1
        abre_vfs()
    fin

    ; [etapa 10 h] (Candados64.al_soltar) quien quita los candados OFD y de
    ; flock de lo abierto que se suelta
    público variable al_soltar_abierto: nat64

    función llama1_(f: nat64, x: nat64)
        ensamblador
            push qword {x}
            mov rax, {f}
            call rax
        fin
    fin

    público función vfs_cierra(a: puntero a Abierto)
        cierra_vfs()
        si a.refs > 1 entonces
            a.refs := a.refs - 1
        sino
            ; ([etapa 10 h] M4: sus candados OFD, fuera, con este mutex: solo
            ; aquí se sabe de verdad que es la última referencia)
            si al_soltar_abierto <> 0 entonces llama1_(al_soltar_abierto, nat64(a)) fin
            suelta(nodo(a.nodo))
            libera(puntero(a.ruta))
            libera(puntero(nat64(a)))
            abiertos := abiertos - 1
        fin
        abre_vfs()
    fin

    público función vfs_ruta(a: puntero a Abierto): puntero a byte
        devolver puntero(a.ruta)
    fin

    público función vfs_es_carpeta(a: puntero a Abierto): bool
        devolver nodo(a.nodo).clase = N_CARPETA
    fin

    ; [etapa 10 f] si es un archivo de la unidad en memoria, dónde se ve
    ; (virtual, en el mapa directo); si no, 0 (Sistema: mmap sin copiar)
    público función vfs_de_unidad(a: puntero a Abierto): nat64
        variable n: puntero a Nodo
        n := nodo(a.nodo)
        si n.clase = N_ARCHIVO y mm(n.montaje).clase = FS_UNIDAD entonces devolver dónde(nat32(n.primero)) fin
        devolver 0
    fin

    público función vfs_tamaño(a: puntero a Abierto): nat64
        devolver nodo(a.nodo).tamaño
    fin


    ; ---- [etapa 10 h] las páginas compartidas de un archivo ----
    ; mmap MAP_SHARED de escribir de un archivo: sus páginas (desde la 0 del
    ; archivo, de 4 KB) son de verdad las mismas para todos los que lo mapean
    ; (como la caché de páginas de Linux, pero solo para los archivos que se
    ; mapean así). Mientras las tiene, ellas son lo que vale del archivo en su
    ; trozo: read las lee de ahí (encima de lo del disco), write escribe en el
    ; disco y en ellas, ftruncate pone a cero lo que pasa del final (si luego
    ; crece, se ve a cero, como Linux), y lo de ellas va al archivo con msync,
    ; fsync, sync y al soltar el nodo (la última referencia: los mmap tienen
    ; la suya, con lo abierto). Lo que se escribe en la memoria más allá del
    ; final del archivo, en la última página, no va al archivo (como Linux).
    ; Todo con el mutex del VFS; sus marcos se comparten como los de /dev/shm
    ; (Espacios.comparte_marco: el Comp tiene uno; cada página puesta, otro).
    público constante MÁX_COMP_PÁG = 262144     ; 1 GB de un archivo así
    público tipo Comp = estructura
        n: nat64                    ; sus páginas (de la 0 a la n - 1)
        cabe: nat64
        marcos: nat64               ; (del montón) n nat64: el marco de cada una
    fin
    público variable comp_vivos, comp_páginas, comp_volcadas: nat64

    función comp_(n: puntero a Nodo): puntero a Comp
        devolver puntero(n.comp)
    fin

    función marco_comp(c: puntero a Comp, i: nat64): nat64
        variable pm: puntero a nat64
        pm := puntero(c.marcos + i * 8)
        devolver valor(pm)
    fin

    ; (con el mutex) que tenga sus páginas hasta la «hasta» (sin ella): las
    ; nuevas, con lo del archivo (lo que pase del final, a cero)
    función comp_prepara_(nd: puntero a Nodo, tope_: nat64): ent64
        variable c: puntero a Comp
        variable nm, f, pos, k: nat64
        variable r: ent64
        variable pm: puntero a nat64
        si tope_ > MÁX_COMP_PÁG entonces devolver ENOMEM fin
        si nd.comp = 0 entonces
            c := puntero(nat64(reserva(tamaño(Comp))))
            si c = nulo entonces devolver ENOMEM fin
            ceros_k(nat64(c), tamaño(Comp))
            nd.comp := nat64(c)
            comp_vivos := comp_vivos + 1
        fin
        c := comp_(nd)
        si tope_ > c.cabe entonces
            k := c.cabe * 2
            si k < tope_ entonces k := tope_ fin
            si k < 16 entonces k := 16 fin
            si k > MÁX_COMP_PÁG entonces k := MÁX_COMP_PÁG fin
            nm := nat64(reserva(k * 8))
            si nm = 0 entonces devolver ENOMEM fin
            si c.n > 0 entonces copia_k(nm, c.marcos, c.n * 8) fin
            si c.marcos <> 0 entonces libera(puntero(c.marcos)) fin
            c.marcos := nm
            c.cabe := k
        fin
        mientras c.n < tope_ hacer
            f := pide()
            si f = 0 entonces devolver ENOMEM fin
            ceros_k(virt(f), 4096)
            pos := c.n * 4096
            si pos < nd.tamaño entonces
                k := nd.tamaño - pos
                si k > 4096 entonces k := 4096 fin
                r := fs_lee(nd, pos, virt(f), k)
                si r < 0 entonces
                    devuelve(f)
                    devolver r
                fin
            fin
            pm := puntero(c.marcos + c.n * 8)
            valor(pm) := f
            c.n := c.n + 1
            comp_páginas := comp_páginas + 1
        fin
        devolver 0
    fin

    ; (con el mutex) las páginas, fuera (quien las tenga puestas, las tiene hasta quitarlas)
    función comp_suelta_(nd: puntero a Nodo)
        variable c: puntero a Comp
        variable i: nat64
        c := comp_(nd)
        i := 0
        mientras i < c.n hacer
            Espacios.suelta_marco_u(marco_comp(c, i))
            i := i + 1
        fin
        comp_páginas := comp_páginas - c.n
        si c.marcos <> 0 entonces libera(puntero(c.marcos)) fin
        libera(puntero(nat64(c)))
        nd.comp := 0
        comp_vivos := comp_vivos - 1
    fin

    ; (con el mutex) lo de las páginas, al archivo (hasta su final)
    función comp_vuelca_(nd: puntero a Nodo): ent64
        variable c: puntero a Comp
        variable i, pos, k: nat64
        variable r: ent64
        c := comp_(nd)
        si mm(nd.montaje).solo_leer <> 0 entonces devolver 0 fin
        i := 0
        mientras i < c.n y i * 4096 < nd.tamaño hacer
            pos := i * 4096
            k := nd.tamaño - pos
            si k > 4096 entonces k := 4096 fin
            r := fs_escribe(nd, pos, virt(marco_comp(c, i)), k)
            si r < 0 entonces devolver r fin
            comp_volcadas := comp_volcadas + 1
            i := i + 1
        fin
        devolver 0
    fin

    ; (con el mutex) lo leído de [pos, pos + n) en k: lo de las páginas, encima
    función comp_lee_(nd: puntero a Nodo, pos: nat64, k: nat64, n: nat64)
        variable c: puntero a Comp
        variable i, d, t: nat64
        c := comp_(nd)
        mientras n > 0 hacer
            i := pos >> 12
            si i >= c.n entonces devolver fin
            d := pos yb 4095
            t := 4096 - d
            si t > n entonces t := n fin
            copia_k(k, virt(marco_comp(c, i)) + d, t)
            pos := pos + t
            k := k + t
            n := n - t
        fin
    fin

    ; (con el mutex) lo escrito en [pos, pos + n) desde k, también en las páginas
    función comp_escribe_(nd: puntero a Nodo, pos: nat64, k: nat64, n: nat64)
        variable c: puntero a Comp
        variable i, d, t: nat64
        c := comp_(nd)
        mientras n > 0 hacer
            i := pos >> 12
            si i >= c.n entonces devolver fin
            d := pos yb 4095
            t := 4096 - d
            si t > n entonces t := n fin
            copia_k(virt(marco_comp(c, i)) + d, k, t)
            pos := pos + t
            k := k + t
            n := n - t
        fin
    fin

    ; (con el mutex) truncado a t: lo de las páginas desde t, a cero
    función comp_trunca_(nd: puntero a Nodo, t: nat64)
        variable c: puntero a Comp
        variable i, d: nat64
        c := comp_(nd)
        i := t >> 12
        d := t yb 4095
        mientras i < c.n hacer
            ceros_k(virt(marco_comp(c, i)) + d, 4096 - d)
            d := 0
            i := i + 1
        fin
    fin

    ; (Sistema.mapea_, con el mutex de la memoria) que «a» tenga sus páginas
    ; compartidas hasta la «hasta» (sin ella)
    público función vfs_comp_prepara(a: puntero a Abierto, tope_: nat64): ent64
        variable r: ent64
        cierra_vfs()
        r := comp_prepara_(nodo(a.nodo), tope_)
        abre_vfs()
        devolver r
    fin

    ; el marco de la página i (ya preparada), con una cuenta más (para ponerlo)
    público función vfs_comp_marco(a: puntero a Abierto, i: nat64): nat64
        variable c: puntero a Comp
        variable f: nat64
        cierra_vfs()
        f := 0
        c := comp_(nodo(a.nodo))
        si c <> nulo y i < c.n entonces
            f := marco_comp(c, i)
            Espacios.comparte_marco(f)
        fin
        abre_vfs()
        devolver f
    fin

    ; msync: lo de las páginas, al archivo (con MS_SYNC, también al disco)
    público función vfs_comp_vuelca(a: puntero a Abierto, al_disco: bool): ent64
        variable r: ent64
        variable nd: puntero a Nodo
        nd := nodo(a.nodo)
        cierra_vfs()
        r := 0
        si nd.comp <> 0 entonces r := comp_vuelca_(nd) fin
        si r = 0 y al_disco y (mm(nd.montaje).clase = FS_FAT o mm(nd.montaje).clase = FS_EXFAT) y mm(nd.montaje).solo_leer = 0 entonces
            si fs_vacía(nd.montaje) < 0 entonces r := EIO fin
        fin
        abre_vfs()
        devolver r
    fin

    ; ---- leer y escribir ----
    ; lee desde «pos» (o, si pos es -1, desde la suya, y la adelanta)
    público función vfs_lee(a: puntero a Abierto, pos: ent64, k: nat64, n: nat64): ent64
        variable r: ent64
        variable nd: puntero a Nodo
        variable p: nat64
        si a.marcas yb O_ACCESO = O_WRONLY entonces devolver EBADF fin
        nd := nodo(a.nodo)
        si nd.clase = N_CARPETA entonces devolver EISDIR fin
        cierra_vfs()
        si pos < 0 entonces
            p := a.pos
            r := fs_lee(nd, p, k, n)
            si r > 0 entonces a.pos := a.pos + nat64(r) fin
        sino
            p := nat64(pos)
            r := fs_lee(nd, p, k, n)
        fin
        si r > 0 y nd.comp <> 0 entonces comp_lee_(nd, p, k, nat64(r)) fin      ; [etapa 10 h]
        abre_vfs()
        devolver r
    fin

    público función vfs_escribe(a: puntero a Abierto, pos: ent64, k: nat64, n: nat64): ent64
        variable r: ent64
        variable nd: puntero a Nodo
        variable p: nat64
        si a.marcas yb O_ACCESO = O_RDONLY entonces devolver EBADF fin
        nd := nodo(a.nodo)
        si mm(nd.montaje).solo_leer <> 0 entonces devolver EROFS fin
        si n = 0 entonces devolver 0 fin
        cierra_vfs()
        si pos < 0 entonces
            p := a.pos
            si a.marcas yb O_APPEND <> 0 entonces p := nd.tamaño fin
        sino
            p := nat64(pos)
        fin
        si nd.montaje = casa_montaje y n > TROZO_CASA entonces
            r := escribe_a_trozos(nd, p, k, n)
        sino
            r := fs_escribe(nd, p, k, n)
        fin
        si pos < 0 y r > 0 entonces a.pos := p + nat64(r) fin
        si r > 0 y nd.comp <> 0 entonces comp_escribe_(nd, p, k, nat64(r)) fin  ; [etapa 10 h]
        abre_vfs()
        devolver r
    fin

    ; [etapa 11 a] en la casa, lo grande a trozos de 1 MB: cada trozo es una
    ; escritura entera (el tamaño al día), y entre dos se confirma el diario si
    ; hace falta (lo confirmado, siempre después de un trozo: un archivo
    ; cortado ahí, nunca la FAT a medias); lo escrito, o el error si no se
    ; ha escrito nada
    constante TROZO_CASA = 1048576
    función escribe_a_trozos(nd: puntero a Nodo, p: nat64, k: nat64, n: nat64): ent64
        variable hecho, t: nat64
        variable r: ent64
        hecho := 0
        mientras hecho < n hacer
            t := n - hecho
            si t > TROZO_CASA entonces t := TROZO_CASA fin
            r := fs_escribe(nd, p + hecho, k + hecho, t)
            si r <= 0 entonces
                si hecho > 0 entonces devolver ent64(hecho) fin
                devolver r
            fin
            hecho := hecho + nat64(r)
            si nat64(r) < t entonces devolver ent64(hecho) fin
            si al_soltar_vfs <> 0 y cb_diario_lleno() entonces llama_v(al_soltar_vfs) fin
        fin
        devolver ent64(hecho)
    fin

    función llama_v(f: nat64)
        ensamblador
            mov rax, {f}
            call rax
        fin
    fin

    público función vfs_sitúa(a: puntero a Abierto, d: ent64, de_dónde: nat64): ent64
        variable n: ent64
        si de_dónde = 0 entonces n := d
        sino si de_dónde = 1 entonces n := ent64(a.pos) + d
        sino si de_dónde = 2 entonces n := ent64(nodo(a.nodo).tamaño) + d
        sino devolver EINVAL fin
        si n < 0 entonces devolver EINVAL fin
        a.pos := nat64(n)
        devolver n
    fin

    público función vfs_trunca(a: puntero a Abierto, t: nat64): ent64
        variable r: ent64
        variable nd: puntero a Nodo
        nd := nodo(a.nodo)
        si nd.clase = N_CARPETA entonces devolver EISDIR fin
        si a.marcas yb O_ACCESO = O_RDONLY entonces devolver EINVAL fin
        si mm(nd.montaje).solo_leer <> 0 entonces devolver EROFS fin
        cierra_vfs()
        r := fs_trunca(nd, t)
        si r >= 0 y nd.comp <> 0 entonces comp_trunca_(nd, t) fin               ; [etapa 10 h]
        abre_vfs()
        devolver r
    fin

    ; ---- vaciar ----
    público función vfs_fsync(a: puntero a Abierto): ent64
        variable r: ent64
        variable m: nat32
        m := nodo(a.nodo).montaje
        si (mm(m).clase <> FS_FAT y mm(m).clase <> FS_EXFAT) o mm(m).solo_leer <> 0 entonces devolver 0 fin
        cierra_vfs()
        ; [etapa 10 h] lo de sus páginas compartidas, antes
        si nodo(a.nodo).comp <> 0 entonces comp_vuelca_(nodo(a.nodo)) fin
        r := fs_vacía(m)
        abre_vfs()
        si r < 0 entonces devolver EIO fin
        devolver 0
    fin

    ; sync: todos los volúmenes; cuántos bloques ha escrito (o -1)
    público función vfs_sync(): ent64
        variable m: nat32
        variable r, t: ent64
        variable x: nat64
        cierra_vfs()
        t := 0
        ; [etapa 10 h] lo de las páginas compartidas de los archivos, antes
        x := nodos
        mientras x <> 0 hacer
            si nodo(x).comp <> 0 y nodo(x).borrado = 0 entonces comp_vuelca_(nodo(x)) fin
            x := nodo(x).sig
        fin
        m := 0
        mientras m < n_montajes hacer
            si mm(m).en_uso <> 0 y (mm(m).clase = FS_FAT o mm(m).clase = FS_EXFAT) y mm(m).solo_leer = 0 entonces
                r := fs_vacía(m)
                si r < 0 entonces t := -1 sino si t >= 0 entonces t := t + r fin
            fin
            m := m + 1
        fin
        abre_vfs()
        devolver t
    fin

    ; ---- stat ----
    función p64(d: nat64, v: nat64)
        pon_m64(d, v)
    fin

    ; la «struct stat» de Linux x86-64 (144 octetos) del nodo, en k
    función llena_stat(n: puntero a Nodo, k: nat64)
        variable modo, oc: nat64
        ceros_k(k, 144)
        p64(k, nat64(n.montaje) + 1)
        si n.clave = 0 entonces p64(k + 8, 1) sino p64(k + 8, n.clave + 1) fin
        p64(k + 16, 1)
        si n.clase = N_CARPETA entonces
            modo := 0x4000 ob 0x1ED            ; S_IFDIR, 0755
            p64(k + 16, 2)
        sino
            modo := 0x8000 ob 0x1A4            ; S_IFREG, 0644
        fin
        si mm(n.montaje).solo_leer <> 0 entonces modo := modo yb (nob nat64(0x92)) fin
        pon_m32(k + 24, nat32(modo))
        p64(k + 48, n.tamaño)
        p64(k + 56, 4096)
        oc := mm(n.montaje).oct_cúmulo
        si oc = 0 entonces oc := 512 fin
        p64(k + 64, ((n.tamaño + oc - 1) div oc) * (oc div 512))
        p64(k + 72, n.mtime)
        p64(k + 88, n.mtime)
        p64(k + 104, n.mtime)
    fin

    público función vfs_fstat(a: puntero a Abierto, k: nat64): ent64
        cierra_vfs()
        llena_stat(nodo(a.nodo), k)
        abre_vfs()
        devolver 0
    fin

    público función vfs_stat(base: puntero a byte, ruta: puntero a byte, k: nat64): ent64
        devolver vfs_stat_e(base, ruta, k, cierto)
    fin

    ; [etapa 10 g] stat (sigue: cierto) y lstat (falso: de un enlace, lo suyo:
    ; S_IFLNK, 0777, el largo de lo que dice)
    público función vfs_stat_e(base: puntero a byte, ruta: puntero a byte, k: nat64, sigue: bool): ent64
        variable t: puntero a byte
        variable n: puntero a Nodo
        variable m: nat32
        variable r: ent64
        variable i: nat32
        variable b: nat64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces devolver ENOMEM fin
        si no normaliza_e(base, ruta, t, sigue, r) entonces
            libera(t)
            devolver r
        fin
        si no sigue y n_enlaces > 0 entonces
            cierra_mutex(dirección(enl_mutex))
            i := enlace_de(t)
            si i < MAX_ENLACES entonces
                ceros_k(k, 144)
                p64(k, 0x7000)                          ; (st_dev: el de los enlaces)
                p64(k + 8, 3000000 + nat64(i))
                p64(k + 16, 1)
                pon_m32(k + 24, 0xA000 ob 0x1FF)        ; S_IFLNK, 0777
                p64(k + 48, nat64(largo(puntero(enl_dest[i]))))
                p64(k + 56, 4096)
                p64(k + 72, enl_hora[i])
                p64(k + 88, enl_hora[i])
                p64(k + 104, enl_hora[i])
            fin
            abre_mutex(dirección(enl_mutex))
            si i < MAX_ENLACES entonces
                libera(t)
                devolver 0
            fin
        fin
        cierra_vfs()
        fs_error := 0
        n := camina(t, falso, nulo, m)
        si n = nulo entonces
            r := fs_error
        sino
            llena_stat(n, k)
            suelta(n)
            r := 0
        fin
        abre_vfs()
        libera(t)
        devolver r
    fin

    ; [etapa 10 g] symlink: el enlace «ruta» (desde base) que dice «destino»;
    ; en /tmp y en «/» mismo (en los demás: EPERM, como vfat; dentro de «/»,
    ; EROFS)
    público función vfs_symlink(destino: puntero a byte, base: puntero a byte, ruta: puntero a byte): ent64
        variable t, r, d: puntero a byte
        variable último: arreglo [256] de byte
        variable dn, n: puntero a Nodo
        variable m, i: nat32
        variable err: ent64
        variable b: nat64
        si destino[0] = 0 o ruta[0] = 0 entonces devolver ENOENT fin
        si largo(destino) + 1 >= LARGO_RUTA entonces devolver ENAMETOOLONG fin
        t := reserva(LARGO_RUTA)
        si t = nulo entonces devolver ENOMEM fin
        si no normaliza_e(base, ruta, t, falso, err) entonces
            libera(t)
            devolver err
        fin
        r := reserva(nat64(largo(t)) + 1)
        d := reserva(nat64(largo(destino)) + 1)
        si r = nulo o d = nulo entonces
            si r <> nulo entonces libera(r) fin
            si d <> nulo entonces libera(d) fin
            libera(t)
            devolver ENOMEM
        fin
        copia_texto(r, t, LARGO_RUTA)
        copia_texto(d, destino, LARGO_RUTA)
        cierra_vfs()
        err := 0
        dn := carpeta_de(t, dirección(último[0]), m, err)
        si dn <> nulo entonces
            ; ([etapa 10 g] y en «/», la unidad en memoria: sus archivos no se
            ; cambian, pero un enlace va en la tabla, como el «ln -s» de quien
            ; manda en un Linux: Ladybird busca lo suyo en ../share/Lagom de
            ; donde está el programa, /share/Lagom, que así puede ir a /tmp)
            si mm(m).clase = FS_UNIDAD y dn = nodo(mm(m).raíz) entonces
                n := fs_busca(m, dn, dirección(último[0]))
                si n <> nulo entonces
                    err := EEXIST
                    suelta(n)
                fin
            sino si mm(m).solo_leer <> 0 entonces
                err := EROFS
            sino si no de_memoria(m) entonces
                err := EPERM
            sino
                n := fs_busca(m, dn, dirección(último[0]))
                si n <> nulo entonces
                    err := EEXIST
                    suelta(n)
                sino si fs_error <> ENOENT entonces
                    err := fs_error
                fin
            fin
            suelta(dn)
        sino si err = EBUSY entonces
            err := EEXIST
        fin
        si err = 0 entonces
            cierra_mutex(dirección(enl_mutex))
            si enlace_de(t) < MAX_ENLACES entonces
                err := EEXIST
            sino
                i := 0
                mientras i < MAX_ENLACES y enl_ruta[i] <> 0 hacer i := i + 1 fin
                si i >= MAX_ENLACES entonces
                    err := ENOSPC
                sino
                    enl_ruta[i] := nat64(r)
                    enl_dest[i] := nat64(d)
                    enl_hora[i] := ahora_unix()
                    n_enlaces := n_enlaces + 1
                fin
            fin
            abre_mutex(dirección(enl_mutex))
        fin
        abre_vfs()
        libera(t)
        si err <> 0 entonces
            libera(r)
            libera(d)
        fin
        devolver err
    fin

    ; [etapa 10 g] readlink: lo que dice el enlace «ruta» (en d, LARGO_RUTA) y
    ; su largo; -1 si no es un enlace (y lo demás, lo mira quien llama)
    público función vfs_readlink(base: puntero a byte, ruta: puntero a byte, d: puntero a byte, ref err: ent64): ent64
        variable t: puntero a byte
        variable r: ent64
        err := 0
        si n_enlaces = 0 entonces devolver -1 fin
        t := reserva(LARGO_RUTA)
        si t = nulo entonces
            err := ENOMEM
            devolver -1
        fin
        r := -1
        si normaliza_e(base, ruta, t, falso, err) entonces r := vfs_enlace(t, d) fin
        libera(t)
        devolver r
    fin

    ; [etapa 10 g] statfs y fstatfs: la «struct statfs» de Linux x86-64 (120
    ; octetos) del montaje m: el tipo (la unidad, RAMFS_MAGIC; /tmp, el disco en
    ; memoria, TMPFS_MAGIC, que es lo que hace; FAT, MSDOS_SUPER_MAGIC; exFAT,
    ; EXFAT_SUPER_MAGIC), el tamaño de bloque (el del cúmulo), los bloques, los
    ; libres (si se saben), el largo de un nombre (255) y ST_RDONLY
    función llena_statfs(m: nat32, k: nat64)
        variable oc, clase_fs, libres: nat64
        ceros_k(k, 120)
        clase_fs := 0x858458F6                          ; RAMFS_MAGIC (la unidad en memoria)
        si mm(m).clase = FS_FAT entonces clase_fs := 0x4D44 fin            ; MSDOS_SUPER_MAGIC
        si mm(m).clase = FS_EXFAT entonces clase_fs := 0x2011BAB0 fin      ; EXFAT_SUPER_MAGIC
        si de_memoria(m) entonces clase_fs := 0x01021994 fin               ; TMPFS_MAGIC
        oc := mm(m).oct_cúmulo
        si oc = 0 entonces oc := 4096 fin
        libres := mm(m).libres
        si libres = 0xFFFFFFFF o mm(m).clase = FS_UNIDAD entonces libres := 0 fin
        p64(k, clase_fs)
        p64(k + 8, oc)                              ; f_bsize
        p64(k + 16, mm(m).cúmulos)                  ; f_blocks
        p64(k + 24, libres)                         ; f_bfree
        p64(k + 32, libres)                         ; f_bavail
        p64(k + 40, 0)                              ; f_files (no se sabe)
        p64(k + 48, 0)                              ; f_ffree
        pon_m32(k + 56, m + 1)                      ; f_fsid
        p64(k + 64, 255)                            ; f_namelen
        p64(k + 72, oc)                             ; f_frsize
        si mm(m).solo_leer <> 0 entonces p64(k + 80, 1) fin           ; f_flags: ST_RDONLY
    fin

    público función vfs_fstatfs(a: puntero a Abierto, k: nat64): ent64
        llena_statfs(nodo(a.nodo).montaje, k)
        devolver 0
    fin

    público función vfs_statfs(base: puntero a byte, ruta: puntero a byte, k: nat64): ent64
        variable t: puntero a byte
        variable n: puntero a Nodo
        variable m: nat32
        variable r: ent64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces devolver ENOMEM fin
        si no normaliza_e(base, ruta, t, cierto, r) entonces
            libera(t)
            devolver r
        fin
        cierra_vfs()
        fs_error := 0
        n := camina(t, falso, nulo, m)
        si n = nulo entonces
            r := fs_error
        sino
            llena_statfs(m, k)
            suelta(n)
            r := 0
        fin
        abre_vfs()
        libera(t)
        devolver r
    fin

    ; ---- getdents64 ----
    ; la siguiente entrada de la carpeta (galleta: por dónde va)
    función fs_lista(n: puntero a Nodo, ref galleta: nat64, nombre: puntero a byte, ref carpeta: bool, ref ino: nat64): bool
        variable m, k: nat32
        variable x: puntero a Montaje
        m := n.montaje
        x := mm(m)
        según nat16(x.clase)
            caso FS_FAT: devolver fat_lista(m, n, galleta, nombre, carpeta, ino)
            caso FS_EXFAT: devolver ex_lista(m, n, galleta, nombre, carpeta, ino)
            caso FS_UNIDAD:
                ; «.», «..», los archivos y los montajes (sin el de «/»)
                si galleta < 2 entonces
                    nombre[0] := '.'
                    nombre[1] := 0
                    si galleta = 1 entonces
                        nombre[1] := '.'
                        nombre[2] := 0
                    fin
                    carpeta := cierto
                    ino := 1
                    galleta := galleta + 1
                    devolver cierto
                fin
                si galleta - 2 < n_archivos entonces
                    copia_texto(nombre, nombre_de(nat32(galleta - 2)), 256)
                    carpeta := falso
                    ino := galleta
                    galleta := galleta + 1
                    devolver cierto
                fin
                k := nat32(galleta - 2 - n_archivos)
                mientras k < n_montajes hacer
                    si mm(k).en_uso <> 0 y largo(dirección(mm(k).ruta[0])) > 1 entonces
                        copia_texto(nombre, dirección(mm(k).ruta[1]), 256)
                        carpeta := cierto
                        ino := 1000000 + k
                        galleta := 2 + n_archivos + k + 1
                        devolver cierto
                    fin
                    k := k + 1
                fin
                devolver falso
        fin
        devolver falso
    fin

    ; [etapa 10 g] el siguiente enlace de la carpeta c desde la galleta g
    ; (GALLETA_ENL más su sitio en la tabla): su nombre, y g, al de después
    función enlace_en_lista(c: puntero a byte, ref g: nat64, nombre: puntero a byte, ref ino: nat64): bool
        variable i, l, j: nat32
        variable b: nat64
        variable r: puntero a byte
        variable hay: bool
        si n_enlaces = 0 entonces devolver falso fin
        hay := falso
        cierra_mutex(dirección(enl_mutex))
        i := nat32(g - GALLETA_ENL)
        mientras i < MAX_ENLACES y no hay hacer
            si enl_ruta[i] <> 0 entonces
                r := puntero(enl_ruta[i])
                ; su carpeta: hasta el último «/»
                l := largo(r)
                mientras l > 0 y r[l] <> '/' hacer l := l - 1 fin
                j := 0
                si l = 0 entonces
                    hay := c[0] = '/' y c[1] = 0
                sino
                    mientras j < l y bajar(r[j]) = bajar(c[j]) hacer j := j + 1 fin
                    hay := j = l y c[l] = 0
                fin
                si hay entonces
                    copia_texto(nombre, dirección(r[l + 1]), 256)
                    ino := 3000000 + nat64(i)
                fin
            fin
            i := i + 1
        fin
        abre_mutex(dirección(enl_mutex))
        g := GALLETA_ENL + nat64(i)
        devolver hay
    fin

    ; llena k (n octetos) con entradas «linux_dirent64»: lo que ha llenado
    público función vfs_lista(a: puntero a Abierto, k: nat64, n: nat64): ent64
        variable nd: puntero a Nodo
        variable nombre: arreglo [256] de byte
        variable g, ino: nat64
        variable carpeta: bool
        variable l, rec: nat64
        variable hecho: nat64
        variable tipo_: nat32
        nd := nodo(a.nodo)
        si nd.clase <> N_CARPETA entonces devolver ENOTDIR fin
        cierra_vfs()
        hecho := 0
        mientras cierto hacer
            g := a.pos
            ; ([etapa 10 g] después de lo del disco, los enlaces de la carpeta: DT_LNK)
            tipo_ := 8
            si g < GALLETA_ENL entonces
                si no fs_lista(nd, g, dirección(nombre[0]), carpeta, ino) entonces
                    g := GALLETA_ENL
                    a.pos := g
                fin
            fin
            si g >= GALLETA_ENL entonces
                si no enlace_en_lista(puntero(a.ruta), g, dirección(nombre[0]), ino) entonces romper fin
                carpeta := falso
                tipo_ := 10
            fin
            l := largo(dirección(nombre[0]))
            rec := (19 + l + 1 + 7) yb (nob nat64(7))
            si hecho + rec > n entonces
                abre_vfs()
                si hecho = 0 entonces devolver EINVAL fin
                devolver ent64(hecho)
            fin
            ceros_k(k + hecho, rec)
            pon_m64(k + hecho, ino)
            pon_m64(k + hecho + 8, g)
            pon_m16(k + hecho + 16, nat32(rec))
            si carpeta entonces pon_m8(k + hecho + 18, 4) sino pon_m8(k + hecho + 18, tipo_) fin
            copia_k(k + hecho + 19, nat64(dirección(nombre[0])), l)
            hecho := hecho + rec
            a.pos := g
        fin
        abre_vfs()
        devolver ent64(hecho)
    fin

    ; ---- crear carpetas, borrar, renombrar ----
    ; la carpeta y el último trozo de la ruta (en t, ya absoluta): con una
    ; referencia a la carpeta; nulo y el error si no es una carpeta
    función carpeta_de(t: puntero a byte, último: puntero a byte, ref m: nat32, ref err: ent64): puntero a Nodo
        variable d: puntero a Nodo
        fs_error := 0
        d := camina(t, cierto, último, m)
        si d = nulo entonces
            err := fs_error
            devolver nulo
        fin
        si último[0] = 0 entonces
            ; la raíz de un montaje (o «/»)
            suelta(d)
            err := EBUSY
            devolver nulo
        fin
        si d.clase <> N_CARPETA entonces
            suelta(d)
            err := ENOTDIR
            devolver nulo
        fin
        devolver d
    fin

    público función vfs_mkdir(base: puntero a byte, ruta: puntero a byte): ent64
        variable t: puntero a byte
        variable último: arreglo [256] de byte
        variable d, n: puntero a Nodo
        variable m: nat32
        variable err: ent64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces devolver ENOMEM fin
        si no normaliza_e(base, ruta, t, falso, err) entonces
            libera(t)
            devolver err
        fin
        si vfs_enlace(t, nulo) >= 0 entonces            ; ([etapa 10 g] un enlace)
            libera(t)
            devolver EEXIST
        fin
        cierra_vfs()
        err := 0
        d := carpeta_de(t, dirección(último[0]), m, err)
        si d <> nulo entonces
            n := fs_busca(m, d, dirección(último[0]))
            si n <> nulo entonces
                err := EEXIST
                suelta(n)
            sino si fs_error <> ENOENT entonces
                err := fs_error
            sino si mm(m).solo_leer <> 0 entonces
                err := EROFS
            sino
                n := fs_crea(m, d, dirección(último[0]), cierto)
                si n = nulo entonces err := fs_error sino suelta(n) fin
            fin
            suelta(d)
        sino si err = EBUSY entonces
            err := EEXIST
        fin
        abre_vfs()
        libera(t)
        devolver err
    fin

    ; unlink (carpeta: falso) o rmdir (carpeta: cierto)
    público función vfs_borra(base: puntero a byte, ruta: puntero a byte, carpeta: bool): ent64
        variable t: puntero a byte
        variable último: arreglo [256] de byte
        variable d, n: puntero a Nodo
        variable m: nat32
        variable err: ent64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces devolver ENOMEM fin
        si no normaliza_e(base, ruta, t, falso, err) entonces
            libera(t)
            devolver err
        fin
        ; ([etapa 10 g] un enlace: unlink lo quita; rmdir, ENOTDIR)
        si vfs_enlace(t, nulo) >= 0 entonces
            si carpeta entonces err := ENOTDIR sino si no quita_enlace(t) entonces err := ENOENT fin
            libera(t)
            devolver err
        fin
        cierra_vfs()
        err := 0
        d := carpeta_de(t, dirección(último[0]), m, err)
        si d <> nulo entonces
            n := fs_busca(m, d, dirección(último[0]))
            si n = nulo entonces
                err := fs_error
            sino
                si mm(m).solo_leer <> 0 entonces err := EROFS
                sino si carpeta y n.clase <> N_CARPETA entonces err := ENOTDIR
                sino si no carpeta y n.clase = N_CARPETA entonces err := EISDIR
                sino si carpeta y (no fs_vacía_carpeta(m, n) o enlaces_en(t)) entonces err := ENOTEMPTY
                fin
                si err = 0 entonces err := fs_borra(m, d, n) fin
                suelta(n)
            fin
            suelta(d)
        fin
        abre_vfs()
        libera(t)
        devolver err
    fin

    ; ¿empieza b por a seguido de «/»? (mover una carpeta dentro de sí misma)
    función dentro_de(a: puntero a byte, b: puntero a byte): bool
        variable i: nat32
        i := 0
        mientras a[i] <> 0 y baja(a[i]) = baja(b[i]) hacer i := i + 1 fin
        devolver a[i] = 0 y b[i] = '/'
    fin

    función mismo_texto(a: puntero a byte, b: puntero a byte): bool
        variable i: nat32
        i := 0
        mientras a[i] = b[i] y a[i] <> 0 hacer i := i + 1 fin
        devolver a[i] = b[i]
    fin

    público función vfs_renombra(base1: puntero a byte, ruta1: puntero a byte, base2: puntero a byte, ruta2: puntero a byte): ent64
        variable t1, t2: puntero a byte
        variable ú1, ú2: arreglo [256] de byte
        variable d1, d2, n, otro: puntero a Nodo
        variable m1, m2: nat32
        variable err: ent64
        variable hecho: bool
        t1 := reserva(LARGO_RUTA)
        t2 := reserva(LARGO_RUTA)
        si t1 = nulo o t2 = nulo entonces
            si t1 <> nulo entonces libera(t1) fin
            si t2 <> nulo entonces libera(t2) fin
            devolver ENOMEM
        fin
        err := 0
        si no normaliza_e(base1, ruta1, t1, falso, err) entonces hecho := falso
        sino si no normaliza_e(base2, ruta2, t2, falso, err) entonces hecho := falso
        fin
        ; ([etapa 10 g] los enlaces: el que se mueve, en la tabla; el que se pisa, fuera)
        si err = 0 y n_enlaces > 0 entonces
            si vfs_enlace(t1, nulo) >= 0 entonces
                err := renombra_enlace(t1, t2)
                libera(t1)
                libera(t2)
                devolver err
            fin
            si vfs_enlace(t2, nulo) >= 0 entonces quita_enlace(t2) fin
        fin
        cierra_vfs()
        d1 := nulo
        d2 := nulo
        n := nulo
        si err = 0 entonces d1 := carpeta_de(t1, dirección(ú1[0]), m1, err) fin
        si err = 0 entonces d2 := carpeta_de(t2, dirección(ú2[0]), m2, err) fin
        si err = 0 y m1 <> m2 entonces err := EXDEV fin
        si err = 0 y mm(m1).solo_leer <> 0 entonces err := EROFS fin
        si err = 0 entonces
            n := fs_busca(m1, d1, dirección(ú1[0]))
            si n = nulo entonces err := fs_error fin
        fin
        si err = 0 y n.clase = N_CARPETA y dentro_de(t1, t2) entonces err := EINVAL fin
        hecho := falso
        si err = 0 entonces
            otro := fs_busca(m2, d2, dirección(ú2[0]))
            si otro = nulo y fs_error <> ENOENT entonces
                err := fs_error
            sino si otro <> nulo y otro = n entonces
                ; el mismo: nada, o solo cambian las mayúsculas
                suelta(otro)
                otro := nulo
                si no mismo_texto(dirección(ú1[0]), dirección(ú2[0])) entonces err := fs_renombra(m1, d1, n, d2, dirección(ú2[0])) fin
                hecho := cierto
            sino si otro <> nulo entonces
                si n.clase = N_CARPETA y otro.clase <> N_CARPETA entonces err := ENOTDIR
                sino si n.clase <> N_CARPETA y otro.clase = N_CARPETA entonces err := EISDIR
                sino si otro.clase = N_CARPETA y no fs_vacía_carpeta(m2, otro) entonces err := ENOTEMPTY
                sino err := fs_borra(m2, d2, otro)
                fin
                suelta(otro)
            fin
            si err = 0 y no hecho entonces err := fs_renombra(m1, d1, n, d2, dirección(ú2[0])) fin
            ; ([etapa 10 g] una carpeta movida: los enlaces de dentro, con ella)
            si err = 0 y n.clase = N_CARPETA y n_enlaces > 0 entonces mueve_enlaces(t1, t2) fin
        fin
        si n <> nulo entonces suelta(n) fin
        si d1 <> nulo entonces suelta(d1) fin
        si d2 <> nulo entonces suelta(d2) fin
        abre_vfs()
        libera(t1)
        libera(t2)
        devolver err
    fin

    ; [etapa 10 g] rename de un enlace (t1) a t2 (sin enlaces en medio): en la
    ; misma carpeta de /tmp o en otra de /tmp; lo que haya en t2, fuera (un
    ; archivo o un enlace; una carpeta, EISDIR)
    función renombra_enlace(t1: puntero a byte, t2: puntero a byte): ent64
        variable ú: arreglo [256] de byte
        variable d, otro: puntero a Nodo
        variable m: nat32
        variable i: nat32
        variable err: ent64
        variable b, viejo, r: nat64
        r := nat64(reserva(nat64(largo(t2)) + 1))
        si r = 0 entonces devolver ENOMEM fin
        copia_texto(puntero(r), t2, LARGO_RUTA)
        cierra_vfs()
        err := 0
        d := carpeta_de(t2, dirección(ú[0]), m, err)
        si d <> nulo entonces
            si no de_memoria(m) entonces
                err := EXDEV
            sino
                otro := fs_busca(m, d, dirección(ú[0]))
                si otro <> nulo entonces
                    si otro.clase = N_CARPETA entonces err := EISDIR sino err := fs_borra(m, d, otro) fin
                    suelta(otro)
                fin
            fin
            suelta(d)
        fin
        abre_vfs()
        si err = 0 y vfs_enlace(t2, nulo) >= 0 y no mismo_sin_mayúsculas(t1, t2) entonces quita_enlace(t2) fin
        viejo := 0
        si err = 0 entonces
            cierra_mutex(dirección(enl_mutex))
            i := enlace_de(t1)
            si i < MAX_ENLACES entonces
                viejo := enl_ruta[i]
                enl_ruta[i] := r
                r := 0
            sino
                err := ENOENT
            fin
            abre_mutex(dirección(enl_mutex))
        fin
        si viejo <> 0 entonces libera(puntero(viejo)) fin
        si r <> 0 entonces libera(puntero(r)) fin
        devolver err
    fin

    función mismo_sin_mayúsculas(a: puntero a byte, b: puntero a byte): bool
        variable l: nat32
        l := prefijo_ruta(a, b)
        devolver l > 0 y b[l] = 0
    fin

    ; [etapa 10 g] la carpeta t1 se ha movido a t2: los enlaces de dentro,
    ; con ella (t2 y lo que seguía)
    función mueve_enlaces(t1: puntero a byte, t2: puntero a byte)
        variable i, l, l2, j: nat32
        variable b, nuevo, viejo: nat64
        variable r, x: puntero a byte
        i := 0
        mientras i < MAX_ENLACES hacer
            nuevo := nat64(reserva(LARGO_RUTA))
            si nuevo = 0 entonces devolver fin
            viejo := 0
            cierra_mutex(dirección(enl_mutex))
            si enl_ruta[i] <> 0 entonces
                r := puntero(enl_ruta[i])
                l := prefijo_ruta(t1, r)
                si l > 0 y r[l] = '/' y nat64(largo(t2)) + nat64(largo(r) - l) + 1 < LARGO_RUTA entonces
                    x := puntero(nuevo)
                    copia_texto(x, t2, LARGO_RUTA)
                    l2 := largo(x)
                    j := l
                    mientras r[j] <> 0 hacer
                        x[l2] := r[j]
                        l2 := l2 + 1
                        j := j + 1
                    fin
                    x[l2] := 0
                    viejo := enl_ruta[i]
                    enl_ruta[i] := nuevo
                    nuevo := 0
                fin
            fin
            abre_mutex(dirección(enl_mutex))
            si viejo <> 0 entonces libera(puntero(viejo)) fin
            si nuevo <> 0 entonces libera(puntero(nuevo)) fin
            i := i + 1
        fin
    fin

    ; ¿es «ruta» una carpeta? (chdir); su ruta absoluta, en t
    público función vfs_carpeta(base: puntero a byte, ruta: puntero a byte, t: puntero a byte): ent64
        variable n: puntero a Nodo
        variable m: nat32
        variable err: ent64
        si no normaliza(base, ruta, t) entonces devolver ENAMETOOLONG fin
        cierra_vfs()
        fs_error := 0
        n := camina(t, falso, nulo, m)
        err := 0
        si n = nulo entonces
            err := fs_error
        sino
            si n.clase <> N_CARPETA entonces err := ENOTDIR fin
            suelta(n)
        fin
        abre_vfs()
        devolver err
    fin

    ; un archivo entero a la memoria del núcleo (para arrancar un programa de
    ; un disco): el bloque del montón (o 0) y su tamaño en «tam»
    público función vfs_entero(ruta: puntero a byte, ref tam: nat64, ref err: ent64): nat64
        variable a: puntero a Abierto
        variable b: nat64
        variable r: ent64
        tam := 0
        a := vfs_abre(nulo, ruta, O_RDONLY, err)
        si a = nulo entonces devolver 0 fin
        si nodo(a.nodo).clase <> N_ARCHIVO entonces
            vfs_cierra(a)
            err := EISDIR
            devolver 0
        fin
        tam := nodo(a.nodo).tamaño
        si tam > nat64(256) << 20 entonces
            vfs_cierra(a)
            err := EFBIG
            devolver 0
        fin
        b := nat64(reserva(tam + 1))
        si b = 0 entonces
            vfs_cierra(a)
            err := ENOMEM
            devolver 0
        fin
        r := vfs_lee(a, 0, b, tam)
        vfs_cierra(a)
        si r < 0 o nat64(r) <> tam entonces
            libera(puntero(b))
            err := EIO
            devolver 0
        fin
        devolver b
    fin

    ; [etapa 10 e] lo mismo, pero si es de la unidad en memoria, sin copiarlo:
    ; su dirección en la unidad (prestado: cierto; no se libera). Para execve:
    ; los programas de la unidad (TestAK, 5 MB, lanza 85 grupos) ya no se
    ; copian en el montón cada vez (5 MB de reserva y su cuarentena, cada uno)
    público función vfs_entero_o_unidad(ruta: puntero a byte, ref tam: nat64, ref err: ent64, ref prestado: bool): nat64
        variable a: puntero a Abierto
        variable n: puntero a Nodo
        variable d: nat64
        prestado := falso
        tam := 0
        a := vfs_abre(nulo, ruta, O_RDONLY, err)
        si a = nulo entonces devolver 0 fin
        n := nodo(a.nodo)
        si n.clase = N_ARCHIVO y mm(n.montaje).clase = FS_UNIDAD entonces
            tam := n.tamaño
            d := dónde(nat32(n.primero))
            vfs_cierra(a)
            prestado := cierto
            devolver d
        fin
        vfs_cierra(a)
        devolver vfs_entero(ruta, tam, err)
    fin

    ; ---- montar ----
    función nuevo_montaje(ruta: puntero a byte, disco: nat32): nat32
        variable m: nat32
        si n_montajes >= MAX_MONTAJES entonces devolver 0xFFFFFFFF fin
        m := n_montajes
        ceros_k(nat64(dirección(montajes[m])), tamaño(Montaje))
        copia_texto(dirección(montajes[m].ruta[0]), ruta, 32)
        montajes[m].disco := disco
        devolver m
    fin

    ; «/» (la unidad en memoria) y cada volumen que se sepa leer
    público función prepara_vfs()
        variable m, d: nat32
        variable r: puntero a Nodo
        variable ruta: arreglo [32] de byte
        casa_montaje := 0xFFFFFFFF
        m := nuevo_montaje("/", 0xFFFFFFFF)
        r := nuevo_nodo(m, 0, N_CARPETA)
        montajes[m].raíz := nat64(r)
        montajes[m].clase := FS_UNIDAD
        montajes[m].solo_leer := 1
        montajes[m].en_uso := 1
        n_montajes := 1
        d := 0
        mientras d < n_dk hacer
            ; los volúmenes: las particiones, y los discos sin tabla
            si es_parte(d) o tabla_dk(d) = 3 o tabla_dk(d) = 0 entonces
                ruta[0] := '/'
                copia_texto(dirección(ruta[1]), nombre_dk(d), 31)
                m := nuevo_montaje(dirección(ruta[0]), d)
                si m <> 0xFFFFFFFF entonces
                    si fat_monta(m) entonces
                        fat_etiqueta(m)
                        si no escribible(d) entonces montajes[m].solo_leer := 1 fin
                        montajes[m].en_uso := 1
                        n_montajes := n_montajes + 1
                    sino si ex_monta(m) entonces
                        montajes[m].en_uso := 1
                        n_montajes := n_montajes + 1
                    fin
                fin
            fin
            d := d + 1
        fin
    fin

    público función escribe_montajes()
        variable m: nat32
        variable x: puntero a Montaje
        m := 0
        mientras m < n_montajes hacer
            x := mm(m)
            escribir("  ", x.ruta, ": ")
            según nat16(x.clase)
                caso FS_UNIDAD: escribir("la unidad en memoria (", n_archivos, " archivos), de solo leer\n")
                caso FS_FAT, FS_EXFAT:
                    si x.clase = FS_FAT entonces escribir("FAT", x.bits_fat) sino escribir("exFAT") fin
                    si x.etiqueta[0] <> 0 entonces escribir(" «", x.etiqueta, "»") fin
                    escribir(", ")
                    tamaño_legible(x.cúmulos * x.oct_cúmulo)
                    escribir(" en ", x.cúmulos, " cúmulos de ")
                    si x.oct_cúmulo < 1024 entonces escribir(x.oct_cúmulo, " octetos") sino escribir(x.oct_cúmulo div 1024, " KB") fin
                    si x.libres <> 0xFFFFFFFF entonces
                        escribir(", ")
                        tamaño_legible(x.libres * x.oct_cúmulo)
                        escribir(" libres")
                    fin
                    si x.solo_leer <> 0 entonces escribir("; de solo leer\n") sino escribir("; de leer y escribir\n") fin
            fin
            m := m + 1
        fin
    fin

fin Vfs64.
