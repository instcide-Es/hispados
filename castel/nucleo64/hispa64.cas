; =============================================================================
;  hispa64.cas - Hispa-64 (docs/64/HISPA-64.md): el núcleo, etapa 7 (musl y
;  POSIX: hilos, señales, futex, fork con copiar al escribir, tuberías, mmap
;  de archivos, ELF dinámicos y PIE, AVX), sobre la 6 (el USB:
;  xHCI, concentradores, HID y memorias; el teclado con el mapa español, el
;  touchpad I2C-HID, la consola como terminal y el intérprete de órdenes en
;  el anillo 3) y la 5 (los discos y los archivos).
;  Lo carga GRUB por multiboot2 (con UEFI de 64 bits: \EFI\BOOT\BOOTX64.EFI; o
;  con la BIOS) o QEMU con -kernel (multiboot), en 1 MB; corre en la mitad alta
;  (0xFFFFFFFF80100000: «modelo hispa64», que también pasa al modo largo con
;  unas tablas provisionales). Aquí:
;   - la IDT con las excepciones explicadas en español, y la GDT con la TSS y
;     las pilas IST (el doble fallo, el NMI, el fallo de máquina);
;   - lo que ha dejado el cargador (la línea de órdenes, la pantalla del GOP,
;     el mapa de memoria, la RSDP de ACPI, los módulos: HISPA64.SIM, los nombres
;     de las funciones), la consola en la pantalla y el puerto serie, CPUID;
;   - la memoria física (fisica64.cas), las tablas de páginas de verdad
;     (pagina64.cas: el núcleo, el mapa directo solo de la RAM, la pantalla con
;     escritura combinada, sin la identidad de abajo) y el montón (monton64.cas),
;     con sus pruebas (prmem64.cas);
;   - [etapa 2] las tablas de ACPI (acpi64.cas), los relojes (reloj64.cas: el
;     HPET o el de ACPI, el TSC, el CMOS), el APIC local y los IOAPIC
;     (apic64.cas: el tic del núcleo, el teclado PS/2, la SCI y el botón de
;     encendido), PCI y PCIe (pci64.cas) y lo de cada procesador (porcpu64.cas);
;   - [etapa 3] los demás procesadores (smp64.cas: encenderlos, vaciar su TLB,
;     pararlos), los hilos del núcleo y el planificador (hilos64.cas), los
;     sucesos, los semáforos y los mutex (sinc64.cas), y sus pruebas
;     (prsmp64.cas); desde ahí, lo que sigue corre en el hilo «principal».
;  Línea de órdenes: «apagar» (acaba en QEMU por el puerto 0xF4: las pruebas) y
;  «prueba=X», que provoca algo para ver lo que dice: pagina, division, gp, ud
;  (las excepciones de siempre), doble (un doble fallo: desbordar la pila del
;  núcleo), identidad (leer de 1 MB, que ya no está), nx (ejecutar en los
;  datos), codigo (escribir en el código), nmi (esperar un NMI), monton (la
;  prueba larga del montón), corrupcion (escribir más allá de un bloque),
;  dosveces (liberar un bloque dos veces); y de la etapa 2: teclado (esperar
;  teclas), boton (esperar el botón de encendido: apaga por ACPI), acpiapagar
;  (apagar por ACPI, ya), sintic (sin el temporizador del APIC); y «sinmedir»
;  (no se cuentan los tics de un segundo: las pruebas de las excepciones); de
;  la etapa 3: panicoap (un fallo de página en otro procesador), paradaap (una
;  parada del núcleo en otro procesador), pilahilo (desbordar la pila de un
;  hilo), «sinsmp» (sin encender los demás procesadores), «sinpruebas» (sin
;  las pruebas de los hilos) y «ocioso=hlt» u «ocioso=mwait» (el reposo); de
;  la etapa 4: «sinpcid» (sin PCID aunque lo haya; «sinpruebas» quita también
;  las pruebas de los programas); de la etapa 5: «escribir» (se puede escribir
;  en los discos: si no, todos son de solo leer), «sinmsix» y «sinmsi» (los
;  discos sin esas interrupciones: se mira la cola), «dir=RUTA» (ARCHIVOS dir
;  RUTA: lo que hay), «rapido=RUTA» (escribir y leer 8 MB) y «programa=RUTA»
;  (arrancar un programa de un disco).
;   - [etapa 4] los programas: las entradas desde el anillo 3 (entradas.cas:
;     swapgs, syscall/sysret), los espacios de direcciones (espacios.cas), la
;     unidad en memoria (unidad64.cas: los módulos del cargador), los procesos
;     y el cargador de ELF64 (procesos.cas), las llamadas al sistema de Linux
;     (sistema.cas) y sus pruebas (prproc64.cas, con los programas de
;     programas/).
;   - [etapa 5] los discos y los archivos: las interrupciones por mensaje
;     (msi64.cas), NVMe (nvme64.cas), SATA por AHCI (ahci64.cas), los discos,
;     sus particiones (GPT y MBR) y la caché de bloques con escritura diferida
;     (discos64.cas), lo común de los sistemas de archivos (nodos64.cas),
;     FAT32 (fat64.cas), exFAT (exfat64.cas), el VFS (vfs64.cas: los montajes,
;     las rutas, lo abierto) y sus pruebas (prdisc64.cas, con el programa
;     ARCHIVOS); al apagar, lo que quede en la caché, al disco.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Hispa64

    modelo hispa64

    importar Cifras64, Cpu64, Pant64, Excep64, Gdt64, Fisica64, Pagina64, Monton64, Nombre64, PrMem64
    importar Es64, Acpi64, Reloj64, Apic64, Pci64, PorCpu64, Cerrojo, Hilos64, Smp64, PrSmp64
    importar Entradas, Espacios, Unidad64, Procesos, Sistema, PrProc64
    importar Msi64, Nvme64, Ahci64, Discos64, Nodos64, Fat64, Exfat64, Vfs64, PrDisc64
    importar Raton64, Usbvigia, Usbhid64, Xhci64
    importar Tty64, Teclas64
    importar I2chid64
    importar PrMusl64
    importar Hda64, Disp64, Casa64, Suspende64
    importar Acpica64
    importar Registro64
    importar Sondeo64, Chacha64, Hora64, Objet64, Redcom64, Prt64, Intel64, Rtl64, Virtio64, Usbred64, Ip64, Tcp64, Red64, PrRed64

    constante VERSIÓN = "0.11.10"
    constante MB1 = 0x2BADB002
    constante MB2 = 0x36D76289
    constante MAX_MÓDULOS = 128                 ; (16 hasta la etapa 6; 64 hasta la 10 e: con los de la 10 f ya eran 65)

    variable magia, info: nat32
    variable info_largo: nat64
    variable línea: arreglo [256] de byte
    variable cargador: arreglo [80] de byte
    variable con_uefi: nat32                    ; 0 no, 32 o 64: de cuántos bits es el firmware
    variable fb_dir: nat64
    variable fb_paso, fb_ancho, fb_alto: nat32
    variable fb_bpp, fb_tipo, fb_r, fb_v, fb_a: byte
    variable hay_fb: bool
    variable fb_virt: nat64                     ; dónde se ve la pantalla después
    variable rsdp: nat64                        ; (virtual: en la información del cargador)
    variable rsdp_v2: bool
    variable mapa: nat64                        ; la etiqueta del mapa de memoria (multiboot2; virtual)
    variable mapa1, mapa1_largo: nat64          ; el mapa de multiboot (virtual)
    variable mod_ini, mod_fin: arreglo [MAX_MÓDULOS] de nat64    ; los módulos (física)
    variable mod_nombre: arreglo [MAX_MÓDULOS] de nat64          ; su línea (virtual: su copia en mod_texto)
    constante LARGO_LÍNEA_MOD = 256             ; [etapa 7] (eran 64: las rutas largas de -initrd se cortaban)
    variable mod_texto: arreglo [MAX_MÓDULOS * LARGO_LÍNEA_MOD] de byte       ; (copiada al leerla: la de multiboot no está apartada)
    variable módulos: nat32
    variable sim_índice: nat32                  ; el módulo de los nombres (HISPA64.SIM)

    función l8(d: nat64): byte
        variable p: puntero a byte
        p := puntero(d)
        devolver valor(p)
    fin

    función l32(d: nat64): nat32
        variable p: puntero a nat32
        p := puntero(d)
        devolver valor(p)
    fin

    función l64(d: nat64): nat64
        variable p: puntero a nat64
        p := puntero(d)
        devolver valor(p)
    fin

    función copia(d: nat64, ref t: arreglo [256] de byte)
        variable i: nat32
        i := 0
        mientras i < 255 y l8(d + i) <> 0 hacer
            t[i] := l8(d + i)
            i := i + 1
        fin
        t[i] := 0
    fin

    función copia_nombre(d: nat64)
        variable i: nat32
        i := 0
        mientras i < 79 y l8(d + i) <> 0 hacer
            cargador[i] := l8(d + i)
            i := i + 1
        fin
        cargador[i] := 0
    fin

    ; ¿está esa palabra, entera, en la línea de órdenes?
    función tiene(pal: puntero a byte): bool
        variable i, j: nat32
        i := 0
        mientras línea[i] <> 0 hacer
            si i = 0 o línea[i - 1] = ' ' entonces
                j := 0
                mientras pal[j] <> 0 y línea[i + j] = pal[j] hacer j := j + 1 fin
                si pal[j] = 0 y (línea[i + j] = 0 o línea[i + j] = ' ') entonces devolver cierto fin
            fin
            i := i + 1
        fin
        devolver falso
    fin

    función un_módulo(ini: nat64, fin_: nat64, nombre: nat64)
        variable i: nat32
        si módulos >= MAX_MÓDULOS o fin_ <= ini entonces devolver fin
        mod_ini[módulos] := ini
        mod_fin[módulos] := fin_
        ; (la línea, copiada ya: lo de multiboot que no es la información en sí puede reutilizarse)
        i := 0
        mientras i < LARGO_LÍNEA_MOD - 1 y nombre <> 0 hacer
            si l8(nombre + i) = 0 entonces romper fin
            mod_texto[módulos * LARGO_LÍNEA_MOD + i] := l8(nombre + i)
            i := i + 1
        fin
        mod_texto[módulos * LARGO_LÍNEA_MOD + i] := 0
        mod_nombre[módulos] := nat64(dirección(mod_texto[módulos * LARGO_LÍNEA_MOD]))
        módulos := módulos + 1
    fin

    ; las etiquetas de multiboot2: de 8 en 8 octetos, hasta la de tipo 0 (todo,
    ; por el mapa directo: la información está en la memoria física)
    función lee_mb2()
        variable d, fin_: nat64
        variable t, n: nat32
        d := virt(nat64(info))
        info_largo := nat64(l32(d))
        fin_ := d + info_largo
        d := d + 8
        mientras d < fin_ hacer
            t := l32(d)
            n := l32(d + 4)
            si t = 0 entonces romper fin
            según nat16(t)
                caso 1: copia(d + 8, línea)
                caso 2: copia_nombre(d + 8)
                caso 3: un_módulo(nat64(l32(d + 8)), nat64(l32(d + 12)), d + 16)
                caso 6: mapa := d
                caso 8:
                    fb_dir := l64(d + 8)
                    fb_paso := l32(d + 16)
                    fb_ancho := l32(d + 20)
                    fb_alto := l32(d + 24)
                    fb_bpp := l8(d + 28)
                    fb_tipo := l8(d + 29)
                    fb_r := l8(d + 32)
                    fb_v := l8(d + 34)
                    fb_a := l8(d + 36)
                    hay_fb := fb_tipo = 1
                caso 11: con_uefi := 32
                caso 12: con_uefi := 64
                caso 14: si rsdp = 0 entonces rsdp := d + 8 fin
                caso 15:
                    rsdp := d + 8
                    rsdp_v2 := cierto
            fin
            d := d + ((nat64(n) + 7) yb (nob nat64(7)))
        fin
    fin

    ; la información de multiboot (QEMU -kernel): la línea de órdenes, el mapa y los módulos
    función lee_mb1()
        variable fl, n, i: nat32
        variable d, m: nat64
        d := virt(nat64(info))
        info_largo := 120
        fl := l32(d)
        si fl yb 4 <> 0 entonces copia(virt(nat64(l32(d + 16))), línea) fin
        si fl yb 8 <> 0 entonces
            n := l32(d + 20)
            m := virt(nat64(l32(d + 24)))
            i := 0
            mientras i < n hacer
                un_módulo(nat64(l32(m + i * 16)), nat64(l32(m + i * 16 + 4)), virt(nat64(l32(m + i * 16 + 8))))
                i := i + 1
            fin
        fin
        si fl yb 64 <> 0 entonces
            mapa1_largo := nat64(l32(d + 44))
            mapa1 := virt(nat64(l32(d + 48)))
        fin
        si fl yb 512 <> 0 entonces copia_nombre(virt(nat64(l32(d + 64)))) fin
    fin

    función tipo_memoria(t: nat32)
        según nat16(t)
            caso 1: escribir("disponible")
            caso 2: escribir("reservada")
            caso 3: escribir("ACPI (se puede recuperar)")
            caso 4: escribir("ACPI NVS (se guarda al dormir)")
            caso 5: escribir("defectuosa")
            caso 20: escribir("código del firmware (UEFI)")
            si no: escribir("tipo ", t)
        fin
    fin

    variable trozos_mapa: nat32
    variable acpi_ini, acpi_fin: arreglo [64] de nat64      ; lo de ACPI, para el mapa directo
    variable n_acpi: nat32

    ; un trozo del mapa del firmware: se escribe y, si es disponible, va a la memoria física
    función un_trozo(b: nat64, l: nat64, t: nat32)
        escribir("  ")
        hex16(b)
        escribir(" - ")
        hex16(b + l - 1)
        escribir("  ")
        tamaño_legible(l)
        escribir("  ")
        tipo_memoria(t)
        escribir("\n")
        trozos_mapa := trozos_mapa + 1
        si t = 1 entonces añade(b, l) fin
        si (t = 3 o t = 4) y n_acpi < 64 entonces
            acpi_ini[n_acpi] := b
            acpi_fin[n_acpi] := b + l
            n_acpi := n_acpi + 1
        fin
    fin

    función el_mapa()
        variable d, fin_: nat64
        variable tam: nat32
        escribir("Mapa de memoria (lo que dice el firmware):\n")
        si mapa <> 0 entonces
            tam := l32(mapa + 8)
            d := mapa + 16
            fin_ := mapa + l32(mapa + 4)
            mientras d + tam <= fin_ hacer
                un_trozo(l64(d), l64(d + 8), l32(d + 16))
                d := d + tam
            fin
        sino si mapa1 <> 0 entonces
            d := mapa1
            fin_ := d + mapa1_largo
            mientras d < fin_ hacer
                un_trozo(l64(d + 4), l64(d + 12), l32(d + 20))
                d := d + l32(d) + 4
            fin
        sino
            escribir("  (el cargador no ha dado el mapa)\n")
        fin
    fin

    ; [etapa 10 e] lo que se escribe va a Registro64.apunta_letra (el registro
    ; del arranque, ARRANQUE.TXT), que lo pasa a la pantalla si en_pantalla
    función pon_consola()
        variable f: nat64
        f := nat64(dirección(apunta_letra))
        ensamblador
            mov rax, {f}
            mov [C_consola], rax
        fin
    fin

    función sí_no(b: bool)
        si b entonces escribir("sí") sino escribir("no") fin
    fin

    función para_ya(qué: puntero a byte)
        detén_ini(qué)
        detén_fin()
    fin

    ; la memoria: la física, las tablas de páginas nuevas y el montón
    función memoria()
        variable i: nat32
        variable fb_largo, nk: nat64
        variable sim: nat32
        prepara_páginas()
        ; lo que no se da: el núcleo, la información del cargador, sus módulos, la pantalla
        aparta(núcleo_fís_ini(), núcleo_fís_fin())
        aparta(nat64(info), nat64(info) + info_largo)
        i := 0
        mientras i < módulos hacer
            aparta(mod_ini[i], mod_fin[i])
            i := i + 1
        fin
        fb_largo := nat64(fb_paso) * fb_alto
        si hay_fb entonces aparta(fb_dir, fb_dir + fb_largo) fin
        si no prepara_marcos() entonces para_ya("no hay sitio en la memoria para el mapa de los marcos libres") fin
        ; las tablas de verdad: el núcleo, el mapa directo (la RAM, lo de ACPI, lo
        ; del cargador) y la pantalla
        empieza_núcleo()
        i := 0
        mientras i < n_ram hacer
            mapea_directo(ram_ini[i], ram_fin[i])
            i := i + 1
        fin
        i := 0
        mientras i < n_acpi hacer
            mapea_directo(acpi_ini[i], acpi_fin[i])
            i := i + 1
        fin
        mapea_directo(nat64(info), nat64(info) + info_largo)
        i := 0
        mientras i < módulos hacer
            mapea_directo(mod_ini[i], mod_fin[i])
            i := i + 1
        fin
        si hay_fb entonces fb_virt := mapea_disp(fb_dir, fb_largo, combinada()) fin
        ; (sin la consola mientras se cambia de tablas: la pantalla se ve en otro sitio)
        ensamblador
            mov qword [C_consola], 0
        fin
        cambia()
        si hay_fb entonces
            mueve(fb_virt)
            en_pantalla := hay()
        fin
        pon_consola()
        prepara_montón()
        ; los nombres de las funciones: el módulo que tenga la forma de HISPA64.SIM
        i := 0
        mientras i < módulos y cuántos = 0 hacer
            pon(virt(mod_ini[i]), mod_fin[i] - mod_ini[i])
            si cuántos > 0 entonces
                sim := i
                sim_índice := i
            fin
            i := i + 1
        fin
        ; lo que se cuenta
        nk := (núcleo_fís_fin() - núcleo_fís_ini()) - 274432
        pon_color(14, 0)
        escribir("Memoria: ")
        tamaño_legible(libres << 12)
        escribir(" libres en ", trozos(), " trozos (de ")
        tamaño_legible(disponible)
        escribir(" que da el firmware); ")
        tamaño_legible(nk + mapa_largo + (nat64(tablas) << 12) + (páginas << 12))
        escribir(" usados por el núcleo\n")
        pon_color(7, 0)
        escribir("  el núcleo, ")
        tamaño_legible(nk)
        escribir(" (en ")
        hex16(k_ini)
        escribir("); el mapa de los marcos, ")
        tamaño_legible(mapa_largo)
        escribir("; ", tablas, " tablas de páginas\n")
        escribir("  mapa directo (desde 0xFFFF800000000000), solo de la RAM y lo de ACPI, en páginas de 1 GB: ", dm_1g, "; de 2 MB: ")
        escribir(dm_2m, "; de 4 KB: ", dm_4k, "; sin ejecutar (NX: ")
        sí_no(nx)
        escribir(")\n  sin la identidad de abajo: ")
        si traduce(0x100000) = nob nat64(0) entonces escribir("1 MB ya no está en las tablas\n") sino escribir("¡SIGUE ESTANDO!\n") fin
        si hay_fb entonces
            escribir("  la pantalla, en ")
            hex16(fb_virt)
            si hay_pat entonces escribir(", con escritura combinada (PAT)\n") sino escribir(" (sin PAT)\n") fin
        fin
        i := 0
        mientras i < módulos hacer
            escribir("  módulo del cargador: ")
            si l8(mod_nombre[i]) = 0 entonces escribir("(sin nombre)") sino escribe_texto(mod_nombre[i]) fin
            escribir(", ")
            tamaño_legible(mod_fin[i] - mod_ini[i])
            escribir(" en ")
            hex(mod_ini[i])
            si cuántos > 0 y i = sim entonces escribir(": los nombres de ", cuántos, " funciones (HISPA64.SIM)") fin
            escribir("\n")
            i := i + 1
        fin
    fin

    función escribe_texto(d: nat64)
        variable n: nat32
        n := 0
        mientras n < 60 y l8(d + n) <> 0 hacer
            escribir_car(l8(d + n))
            n := n + 1
        fin
    fin

    función hondo(n: nat64): nat64
        variable relleno: arreglo [200] de byte
        relleno[n yb 127] := byte(n)
        devolver hondo(n + 1) + relleno[(n + 1) yb 127]
    fin

    función provoca()
        variable p: puntero a nat64
        variable q: puntero a byte
        si tiene("prueba=pagina") entonces
            escribir("Prueba: leer de 0x0000500000000000, que no está en las tablas...\n")
            escribir(l64(nat64(0x5000) << 32), "\n")
        fin
        si tiene("prueba=gp") entonces
            escribir("Prueba: leer de 0x0000800000000000, que no es canónica...\n")
            escribir(l64(nat64(0x8000) << 32), "\n")
        fin
        si tiene("prueba=identidad") entonces
            escribir("Prueba: leer de 0x100000 (1 MB, donde se cargó el núcleo), que ya no está en las tablas...\n")
            escribir(l64(0x100000), "\n")
        fin
        si tiene("prueba=codigo") entonces
            escribir("Prueba: escribir en el código del núcleo, que es de solo leer...\n")
            p := puntero(k_ini + 64)
            valor(p) := 0
        fin
        si tiene("prueba=nx") entonces
            escribir("Prueba: ejecutar en un bloque del montón (los datos no se ejecutan)...\n")
            q := reserva(16)
            q[0] := 0xC3                    ; ret
            p := puntero(nat64(q))
            ensamblador
                mov rax, {p}
                call rax
            fin
        fin
        si tiene("prueba=doble") entonces
            escribir("Prueba: una función que se llama a sí misma sin fin, hasta desbordar la pila del núcleo...\n")
            escribir(hondo(0), "\n")
        fin
        si tiene("prueba=corrupcion") entonces
            escribir("Prueba: escribir un octeto más allá de un bloque de 100 y liberarlo...\n")
            q := reserva(100)
            q[100] := 0x41
            libera(q)
        fin
        si tiene("prueba=dosveces") entonces
            escribir("Prueba: liberar dos veces un bloque...\n")
            q := reserva(40)
            libera(q)
            libera(q)
        fin
        si tiene("prueba=nmi") entonces
            escribir("Prueba: esperando un NMI (en QEMU: «nmi» en el monitor)...\n")
            ensamblador
                cli
            .espera:
                hlt
                jmp .espera
            fin
        fin
        si tiene("prueba=division") entonces
            escribir("Prueba: dividir entre cero...\n")
            ensamblador
                xor edx, edx
                xor ecx, ecx
                mov eax, 7
                div ecx
            fin
        fin
        si tiene("prueba=ud") entonces
            escribir("Prueba: una instrucción que no existe (ud2)...\n")
            ensamblador
                db 0x0F, 0x0B
            fin
        fin
        ; [etapa 3] en otro procesador
        si tiene("prueba=panicoap") entonces provoca_smp(1) fin
        si tiene("prueba=paradaap") entonces provoca_smp(2) fin
        si tiene("prueba=pilahilo") entonces provoca_smp(3) fin
        si tiene("prueba=vigilante") entonces provoca_smp(4) fin
    fin

    ; ---- [etapa 4] los programas ----
    ; los módulos del cargador (menos el de los nombres), a la unidad en memoria
    función unidad()
        variable i: nat32
        i := 0
        mientras i < módulos hacer
            si cuántos = 0 o i <> sim_índice entonces añade_archivo(mod_ini[i], mod_fin[i], mod_nombre[i]) fin
            i := i + 1
        fin
    fin

    ; ---- [etapa 5] los discos y los archivos ----
    función etapa5()
        variable v: arreglo [210] de byte
        escribir("Discos:\n")
        prepara_nvme(tiene("sinmsix"))
        prepara_ahci(tiene("sinmsi"))
        si no tiene("sinusb") entonces prepara_usb(tiene("sinmsix"), tiene("sinmsi")) fin
        si no tiene("sinsonido") entonces prepara_hda() fin            ; [etapa 11] el sonido (HD Audio)
        si no prepara_bloques(tiene("escribir"), no tiene("sintmp")) entonces escribir("  sin memoria para la caché de bloques\n") fin
        escribir("  la caché de bloques: ", cb_n, " bloques de 4 KB (")
        tamaño_legible(nat64(cb_n) * 4096)
        escribir("), con escritura diferida (a los 5 s, o al vaciar)\n")
        escribe_discos()
        prepara_vfs()
        ; [etapa 11 a] la casa (/casa, con su diario), antes de que se use nada
        si no tiene("sincasa") entonces
            valor_de("casa=", dirección(v[0]))
            prepara_casa(dirección(v[0]))
            si tiene("prueba=cortediario1") entonces prepara_corte(1) fin
            si tiene("prueba=cortediario2") entonces prepara_corte(2) fin
        fin
        escribir("Archivos (el VFS): ", n_montajes, " montajes\n")
        escribe_montajes()
        ; [etapa 10 e] el registro, ya (si se queda después, queda esto)
        registro("(sigue: guardado con los discos ya vistos)")
        ; [etapa 10 f] prueba=parada: una parada del núcleo en otro procesador,
        ; con el registro ya guardado una vez: ARRANQUE.TXT, otra vez al pararse
        si tiene("prueba=parada") entonces provoca_smp(2) fin
        si tiene("prueba=paradafallo") entonces provoca_smp(1) fin     ; (un fallo de página del núcleo)
    fin

    ; [etapa 10 e] guarda el registro del arranque (ARRANQUE.TXT: Registro64)
    ; y dice dónde; sin puerto serie, o con «registro»; con «sinregistro», no
    función registro(última: puntero a byte)
        si tiene("sinregistro") entonces devolver fin
        si guarda_registro(tiene("registro"), última) entonces
            escribir("Registro: lo de arriba, en ARRANQUE.TXT de ", reg_guardado, "\n")
        fin
    fin

    ; el valor de «nombre=valor» de la línea de órdenes, en t (vacío si no está)
    función valor_de(nombre: puntero a byte, t: puntero a byte)
        variable i, j, k: nat32
        t[0] := 0
        i := 0
        mientras línea[i] <> 0 hacer
            si i = 0 o línea[i - 1] = ' ' entonces
                j := 0
                mientras nombre[j] <> 0 y línea[i + j] = nombre[j] hacer j := j + 1 fin
                si nombre[j] = 0 entonces
                    k := 0
                    mientras línea[i + j] <> 0 y línea[i + j] <> ' ' y k < 200 hacer
                        t[k] := línea[i + j]
                        j := j + 1
                        k := k + 1
                    fin
                    t[k] := 0
                    devolver
                fin
            fin
            i := i + 1
        fin
    fin

    ; (pruebas5) v detrás de lo que ya hay en l (de 240 octetos). [etapa 10 d]
    ; En una función aparte: dentro de pruebas5, un «je» quedaba a 127
    ; octetos justos y NASM y ensambla.py lo sacaban de distinto tamaño (los
    ; dos, núcleos buenos: NASM, largo; ensambla.py, corto)
    función añade_arg(l: puntero a byte, v: puntero a byte)
        variable i, j: nat32
        i := 0
        mientras l[i] <> 0 hacer i := i + 1 fin
        j := 0
        mientras v[j] <> 0 y i < 238 hacer
            l[i] := v[j]
            i := i + 1
            j := j + 1
        fin
        l[i] := 0
    fin

    ; [etapa 5] las pruebas de los discos y de los archivos (después de las de los programas)
    función pruebas5()
        variable v: arreglo [210] de byte
        variable l: arreglo [240] de byte
        l[0] := 0
        valor_de("dir=", dirección(v[0]))
        si v[0] = 0 entonces
            valor_de("rapido=", dirección(v[0]))
            si v[0] <> 0 entonces copia_texto(dirección(l[0]), "ARCHIVOS rapido ", 240) fin
        sino
            copia_texto(dirección(l[0]), "ARCHIVOS dir ", 240)
        fin
        si l[0] <> 0 entonces añade_arg(dirección(l[0]), dirección(v[0])) fin
        si tiene("sinpruebas") o no tic_va entonces
            pruebas_discos(falso, nulo)
        sino
            pruebas_discos(cierto, dirección(l[0]))
            ; un programa de un disco, por su ruta («programa=/sata0p1/boot/prog/HOLA»)
            valor_de("programa=", dirección(v[0]))
            si v[0] <> 0 entonces corre_de_disco(dirección(v[0])) fin
        fin
    fin

    ; [etapa 6] «prueba=raton»: 10 s diciendo lo que hace el puntero (las
    ; pruebas lo mueven con el monitor de QEMU) y las teclas USB que llegan
    función prueba_ratón()
        variable px, py, r: ent32
        variable b, n: nat32
        variable t0, rel, abs_, tec: nat64
        escribir("Puntero: 10 s mirando el ratón y la tableta (")
        escribe_ratón()
        escribir(")\n")
        px := ptr_x
        py := ptr_y
        b := ptr_botones
        r := ptr_rueda
        tec := uh_teclas
        n := 0
        t0 := ahora_ns()
        mientras ahora_ns() - t0 < 10000000000 hacer
            si ptr_x <> px o ptr_y <> py o ptr_botones <> b o ptr_rueda <> r entonces
                px := ptr_x
                py := ptr_y
                b := ptr_botones
                r := ptr_rueda
                escribir("Puntero: ")
                escribe_ratón()
                si ptr_último = 2 entonces escribir(" (tableta)") sino escribir(" (ratón)") fin
                escribir("\n")
                n := n + 1
            fin
            si uh_teclas <> tec entonces
                tec := uh_teclas
                escribir("Tecla USB: uso ")
                hex(nat64(uh_última))
                escribir("\n")
            fin
            duerme_ms(10)
        fin
        escribir("Puntero: ", n, " cambios; ", ptr_relativos, " del ratón y ", ptr_absolutos, " de la tableta, ", ptr_clics, " clics; teclas USB: ", uh_teclas, ", LED puestos: ", uh_leds, "\n")
    fin

    ; [etapa 11 b] HWP (Intel, desde Skylake: CPUID 6, EAX bit 7): que el
    ; procesador elija su frecuencia él solo, bajándola en reposo. Se pone
    ; IA32_PM_ENABLE (0x770, una vez para todo el paquete) y, en cada
    ; procesador (un hilo fijo en cada uno), IA32_HWP_REQUEST (0x774): del
    ; más bajo al más alto de IA32_HWP_CAPABILITIES (0x771), sin «deseado»
    ; (lo decide él) y, si lo tiene, la preferencia (EPP) a medias (0x80),
    ; como Linux. Sin HWP, la frecuencia es la que deja el firmware (los
    ; P-states de _PSS, para más adelante); en reposo, hlt o mwait.
    variable hwp_pedido: nat64
    variable hwp_hecho: arreglo [64] de nat32
    función hwp_aquí(k: nat64)
        pon_msr(0x774, hwp_pedido)
        hwp_hecho[k] := 1
    fin

    función prepara_hwp()
        variable cap, epp: nat64
        variable alto, bajo, garantizado, eficiente, i, n, hechos: nat32
        variable h: arreglo [64] de nat64
        variable c: puntero a Cpu
        cpuid(0, 0)
        si ra < 6 entonces devolver fin
        cpuid(6, 0)
        si ra yb 0x80 = 0 entonces
            escribir("Energía: sin HWP (el procesador no deja que elija él la frecuencia): la que deja el firmware; en reposo, hlt o mwait\n")
            devolver
        fin
        epp := 0
        si ra yb 0x400 <> 0 entonces epp := nat64(0x80) << 24 fin
        pon_msr(0x770, 1)
        cap := lee_msr(0x771)
        alto := nat32(cap yb 0xFF)
        garantizado := nat32((cap >> 8) yb 0xFF)
        eficiente := nat32((cap >> 16) yb 0xFF)
        bajo := nat32((cap >> 24) yb 0xFF)
        hwp_pedido := nat64(bajo) ob (nat64(alto) << 8) ob epp
        n := 0
        i := 0
        mientras i < n_cpus y i < 64 hacer
            c := cpu(i)
            hwp_hecho[i] := 0
            si c.en_marcha <> 0 entonces
                h[n] := nat64(crea(nat64(dirección(hwp_aquí)), nat64(i), "hwp", NORMAL, i))
                n := n + 1
            fin
            i := i + 1
        fin
        i := 0
        mientras i < n hacer
            une(puntero(h[i]))
            i := i + 1
        fin
        hechos := 0
        i := 0
        mientras i < 64 hacer
            hechos := hechos + hwp_hecho[i]
            i := i + 1
        fin
        escribir("Energía: HWP puesto (el procesador elige la frecuencia y la baja en reposo): rendimiento de ", bajo, " a ", alto, " (garantizado ", garantizado, ", el más eficiente ", eficiente, ")")
        si epp <> 0 entonces escribir("; la preferencia (EPP), a medias") fin
        escribir("; en ", hechos, " procesadores\n")
    fin

    ; [etapa 11 b] apagar: por ACPICA (_PTS(5), \_S5 y SLP_EN) si está en
    ; marcha; si no (o si el equipo sigue encendido), lo de siempre (\_S5
    ; buscado a ojo en la DSDT)
    función apaga_todo()
        si en_marcha_acpica entonces
            escribir("Apagar: por ACPICA (_PTS(5), \\_S5 y SLP_EN)\n")
            apaga_acpica()
            escribir("Apagar: ACPICA no ha apagado el equipo; lo de siempre (\\_S5 de la DSDT)\n")
        fin
        apaga_equipo()
    fin

    ; [etapa 5] antes de apagar: lo que quede sin escribir, al disco (sync)
    función al_apagar(cerrar: bool)
        variable n: nat64
        variable r: ent64
        pant_al_día()                       ; [etapa 8] lo que quede por dibujar
        si cb_n = 0 entonces devolver fin
        n := cb_sucios
        r := vfs_sync()
        si n > 0 o r > 0 entonces
            escribir("Al apagar: ", n, " bloques sin escribir en la caché; vaciados (sync): ")
            si r < 0 entonces escribir("¡alguno ha fallado!\n") sino escribir(r, " escritos\n") fin
        fin
        si cerrar entonces cierra_casa() fin   ; [etapa 11 a] la casa, cerrada bien (solo al apagar de verdad)
    fin

    ; [etapa 11 a] (Suspende64.s3_aparatos) de vuelta de S3: los aparatos otra vez
    función reanuda_aparatos()
        si reanuda_pantalla() entonces escribir("Suspender: la pantalla (la de Bochs), otra vez en su modo\n") fin
        repinta_fb()
        si nv_n_ctl + sa_n_ctl > 0 entonces escribir("Suspender: los discos, otra vez: ", nvme_reanuda(), " de ", nv_n_ctl, " NVMe y ", ahci_reanuda(), " de ", sa_n_discos, " SATA\n") fin
        si xh_n > 0 entonces escribir("Suspender: el USB, otra vez: ", usb_reanuda(), " de ", xh_n, " controladoras (lo enchufado, otra vez enumerado)\n") fin
        si in_n > 0 entonces escribir("Suspender: la red, otra vez: ", in_reanuda(), " de ", in_n, " tarjetas Intel\n") fin
    fin

    ; [etapa 11 a] prueba=suspender: se suspende (QEMU: «system_wakeup» desde el
    ; monitor, o el reloj) y, de vuelta, que todo siga: los procesadores con su
    ; tic, la hora
    función prueba_suspender()
        variable v0, t0, s0: nat64
        variable i: nat32
        si no sabe entonces
            fallos := fallos + 1
            escribir("  MAL: prueba=suspender, y no se sabe suspender aquí\n")
            devolver
        fin
        v0 := veces
        s0 := real_s()
        pide_suspender := cierto
        t0 := ahora_ns()
        mientras veces = v0 y ahora_ns() - t0 < 120000000000 hacer duerme_ms(50) fin
        si veces = v0 entonces
            fallos := fallos + 1
            escribir("  MAL: prueba=suspender: no ha vuelto\n")
            devolver
        fin
        ; un hilo en cada procesador, que corre allí; y dormir
        t0 := ahora_ns()
        duerme_ms(200)
        i := prueba_procesadores()
        escribir("Prueba de suspender: de vuelta; un hilo en cada procesador: ", i, " de ", n_cpus, "; dormir 200 ms: ", (ahora_ns() - t0) div 1000000 - 0, " ms con lo de los hilos; la hora real, ", real_s() - s0, " s más\n")
        si i <> n_cpus o aps_vueltos + 1 <> nat32(n_en_marcha) entonces
            fallos := fallos + 1
            escribir("  MAL: prueba=suspender: no todos los procesadores han vuelto\n")
        fin
        ; el disco de la casa, de vuelta: escribir, fsync, leer y borrar
        si casa_m <> 0xFFFFFFFF entonces
            si prueba_disco_s3() entonces
                escribir("Prueba de suspender: el disco de la casa, de vuelta: 256 KB escritos con fsync, leídos y bien\n")
            sino
                fallos := fallos + 1
                escribir("  MAL: prueba=suspender: el disco de la casa no va después de volver\n")
            fin
        fin
    fin

    función prueba_disco_s3(): bool
        variable a: puntero a Abierto
        variable err: ent64
        variable b: nat64
        variable i: nat64
        variable bien: bool
        b := nat64(reserva(262144))
        si b = 0 entonces devolver falso fin
        i := 0
        mientras i < 262144 hacer
            pon_m8(b + i, nat32((i * 7 + (i >> 10)) yb 255))
            i := i + 1
        fin
        bien := falso
        a := vfs_abre(nulo, "/casa/.s3-prueba", O_RDWR ob O_CREAT ob O_TRUNC, err)
        si a <> nulo entonces
            si vfs_escribe(a, 0, b, 262144) = 262144 y vfs_fsync(a) = 0 entonces
                Nodos64.ceros_k(b, 262144)
                si vfs_lee(a, 0, b, 262144) = 262144 entonces
                    bien := cierto
                    i := 0
                    mientras i < 262144 y bien hacer
                        si m8(b + i) <> nat32((i * 7 + (i >> 10)) yb 255) entonces bien := falso fin
                        i := i + 1
                    fin
                fin
            fin
            vfs_cierra(a)
            vfs_borra(nulo, "/casa/.s3-prueba", falso)
        fin
        libera(puntero(b))
        devolver bien
    fin

    función hilo_batería_baja(arg: nat64)
        duerme_ms(8000)
        prueba_batería_baja()
    fin

    ; ---- [etapa 9] la hora, el azar y la red ----
    función etapa9_hora()
        variable v: arreglo [210] de byte
        prepara_azar()
        valor_de("zona=", dirección(v[0]))
        prepara_hora(dirección(v[0]), tiene("cmos=utc"), tiene("cmos=quieto"))
    fin

    función etapa9()
        variable v: arreglo [210] de byte
        variable h: arreglo [210] de byte
        valor_de("trazaprog=", dirección(v[0]))                ; [etapa 10 h] cada llamada de un programa
        copia_texto(dirección(Sistema.traza_prog[0]), dirección(v[0]), 32)
        Procesos.dice_al_matar := tiene("trazamata")      ; [etapa 10 h] con SIGKILL, dónde estaba cada hilo
        valor_de("ip=", dirección(v[0]))
        valor_de("hosts=", dirección(h[0]))
        Ip64.sin_ipv6 := tiene("sinipv6")          ; [etapa 10 c]
        Procesos.prueba_salida := tiene("prueba=salida")     ; [etapa 10 c] la tabla de arreglos
        Sistema.traza_rutas := tiene("traza=rutas")         ; [etapa 10 g] lo que buscan los programas y no está
        si tiene("sinred") entonces
            ; ([etapa 11] con «lo»: los programas que usan 127.0.0.1 siguen yendo)
            escribir("(sinred: sin las tarjetas de red; solo «lo», 127.0.0.1)\n")
            prepara_red(dirección(v[0]), cierto, falso, cierto)
            prepara_sockets(dirección(h[0]))
            devolver
        fin
        escribe_prt(tiene("prueba=prt"))        ; [etapa 10] las rutas de las INTx (_PRT), antes de las tarjetas
        prepara_red(dirección(v[0]), tiene("sindhcp"), tiene("realtek=ensayo"), falso)
        prepara_sockets(dirección(h[0]))
        Tcp64.traza := tiene("red=traza")
        si tiene("red=pierde") entonces Tcp64.pierde_cada := 23 fin       ; [etapa 10] (para probar lo desordenado y SACK)
    fin

    función etapa4()
        etapa9_hora()
        prepara_procesos()
        prepara_pidfd()                         ; [etapa 10 i] el hilo «pidfd» (Objet64)
        prepara_sistema()
        si tiene("sinpruebas") entonces
            escribir("(sinpruebas: sin las pruebas de los programas)\n")
        sino si no tic_va entonces
            escribir("(Sin el tic: sin las pruebas de los programas.)\n")
        sino
            pruebas_procesos()
        fin
    fin

    ; ---- [etapa 3] los demás procesadores y el planificador ----
    función lista_apic(tipo_: nat32)
        variable i, n: nat32
        variable c: puntero a Cpu
        n := 0
        i := 0
        mientras i < n_cpus hacer
            c := cpu(i)
            si c.en_marcha <> 0 y (tipo_ = 0 o c.tipo_núcleo = tipo_) entonces
                si n > 0 entonces escribir(",") fin
                si n < 16 entonces
                    escribir(" ", c.apic)
                sino si n = 16 entonces
                    escribir(" ...")
                fin
                n := n + 1
            fin
            i := i + 1
        fin
    fin

    función etapa3()
        variable n: nat32
        tsc_antes := tsc()
        mira_reposo(tiene("ocioso=hlt"), tiene("ocioso=mwait"))
        si no arranca_planificador() entonces para_ya("no hay memoria para el planificador") fin
        prepara_pantalla()                  ; [etapa 8] el hilo que dibuja la consola
        si tiene("sinsmp") entonces
            arranca_solo()
        sino
            arranca_aps()
        fin
        n := nat32(n_en_marcha)
        ; [etapa 10 f] el reloj del núcleo, con el TSC si vale y no va hacia atrás entre ellos
        si tsc_vale <> TSC_NO y (tsc_saltos = 0 o tsc_vale = TSC_PV) entonces pasa_a_tsc() fin
        pon_color(14, 0)
        escribir("Procesadores: ", n)
        si n = 1 entonces escribir(" en marcha (APIC") sino escribir(" en marcha (APIC") fin
        lista_apic(0)
        escribir(")")
        pon_color(7, 0)
        si no_contestan > 0 entonces escribir("; ", no_contestan, " no contestan (INIT-SIPI-SIPI, 3 s)") fin
        si de_más > 0 entonces escribir("; ", de_más, " más en la MADT, sin encender (como mucho ", MAX_CPUS, ")") fin
        si tiene("sinsmp") entonces escribir(" (sinsmp: los demás, apagados)") fin
        escribir("\n")
        si n_p + n_e > 0 entonces
            escribir("  híbrido: ", n_p, " de rendimiento (P: APIC")
            lista_apic(0x40)
            escribir(") y ", n_e, " eficientes (E: APIC")
            lista_apic(0x20)
            escribir(")\n")
        fin
        ; [etapa 10 f]
        escribir("  el reloj del núcleo: ")
        si con_pv entonces
            escribir("el de KVM (pvclock, con el TSC; sin dejarlo ir hacia atrás de un procesador a otro)\n")
        sino si con_tsc entonces
            escribir("el TSC (")
            si tsc_vale = TSC_INVARIANTE entonces escribir("invariante")
            sino si tsc_vale = TSC_KVM entonces escribir("de KVM, estable")
            sino si tsc_vale = TSC_TCG entonces escribir("de QEMU sin KVM")
            sino escribir("reloj=tsc")
            fin
            escribir(", sin ir hacia atrás de un procesador a otro: ", tsc_pruebas, " pruebas de ", VUELTAS_TSC, " vueltas por cada uno)\n")
        sino si tsc_prohibido entonces
            escribir("el de siempre (reloj=hpet)\n")
        sino si tsc_vale <> TSC_NO entonces
            escribir("el de siempre: el TSC va hacia atrás de un procesador a otro (", tsc_saltos, " veces; hasta ", tsc_peor, " cuentas)\n")
        sino
            escribir("el de siempre: el TSC no es invariante")
            si kvm_hay entonces escribir(" (ni el de KVM estable)") fin
            escribir("\n")
        fin
        si trampolín <> 0 entonces
            escribir("  con INIT-SIPI-SIPI y el trampolín en ")
            hex(trampolín)
            escribir(" (16, 32 y 64 bits); cada uno con su GDT, su TSS y sus pilas IST, la PAT, NX y WP, su APIC local")
            si tic_va entonces escribir(" y su tic\n") sino escribir(" (sin tic: prueba=sintic)\n") fin
        fin
        escribir("Planificador: una cola por procesador, con robo de trabajo; 4 prioridades; turnos de ", CUANTO * 10, " ms; la tarea ociosa, con ", reposo, "\n")
        si tiene("sinpruebas") entonces
            escribir("(sinpruebas: sin las pruebas de los hilos)\n")
        sino si no tic_va entonces
            escribir("(Sin el tic no hay turnos ni se despierta a los dormidos: sin las pruebas de los hilos.)\n")
        sino
            pruebas_smp()
        fin
        carga()
    fin

    ; lo ocupado que ha estado cada procesador desde que se encendió (o desde la última vez)
    variable tsc_antes: nat64
    variable ocioso_antes: arreglo [64] de nat64

    función carga()
        variable i: nat32
        variable t, d, oc: nat64
        variable c: puntero a Cpu
        t := tsc()
        d := t - tsc_antes
        escribir("Carga (ocupado):")
        i := 0
        mientras i < n_cpus hacer
            c := cpu(i)
            si c.en_marcha <> 0 entonces
                oc := c.tsc_ocioso - ocioso_antes[i]
                ocioso_antes[i] := c.tsc_ocioso
                si oc > d entonces oc := d fin
                si d > 0 entonces escribir(" ", i, ": ", ((d - oc) * 100) div d, " %") fin
            fin
            i := i + 1
        fin
        escribir("\n")
        tsc_antes := t
    fin

    ; ---- [etapa 2] ACPI, los relojes, las interrupciones y PCI ----
    variable tics_1s, tics_cmos: nat64
    variable prueba_io: nat64
    variable prueba_io_gsi: nat32
    variable prueba_io_de: puntero a byte

    función mis_tics(): nat64
        variable c: puntero a Cpu
        c := yo()
        devolver c.tics
    fin

    función marcas_mps(m: nat32)
        variable p, d: nat32
        p := m yb 3
        d := (m >> 2) yb 3
        si d = 3 entonces escribir(" por nivel") sino si d = 1 entonces escribir(" por flanco") fin
        si p = 3 entonces escribir(", activa en bajo") sino si p = 1 entonces escribir(", activa en alto") fin
    fin

    función cuenta_acpi()
        variable i: nat32
        escribir("ACPI: ")
        si no hay_acpi entonces
            escribir("no se encuentra la RSDP (ni la da el cargador ni está en la memoria de la BIOS)\n")
            devolver
        fin
        si acpi_rev >= 2 entonces escribir("2.0 o más") sino escribir("1.0") fin
        escribir(", de «", oem, "»")
        si rsdp = 0 entonces escribir(" (la RSDP, buscada en la memoria de la BIOS)") fin
        si con_xsdt entonces escribir("; XSDT en ") sino escribir("; RSDT en ") fin
        hex(raíz_fís)
        escribir(", ", n_tablas - 1, " tablas:")
        i := 1
        mientras i < n_tablas hacer
            escribir(" ")
            escribe_firma(t_firma[i])
            i := i + 1
        fin
        si mal_sumadas = 0 entonces escribir(" (todas con la suma bien)\n") sino escribir(" (", mal_sumadas, " con la suma mal: se usan igual)\n") fin
        si zonas() > 0 entonces escribir("  (", zonas(), " trozos de memoria reservada puestos en las tablas de páginas para leerlas)\n") fin
        si hay_madt entonces
            escribir("  procesadores (MADT): ", n_cpu)
            si n_cpu = 1 entonces escribir(" encendido (APIC") sino escribir(" encendidos (APIC") fin
            i := 0
            mientras i < n_cpu y i < 16 hacer
                si i > 0 entonces escribir(",") fin
                escribir(" ", cpu_apic[i])
                i := i + 1
            fin
            si n_cpu > 16 entonces escribir("...") fin
            escribir(")")
            si n_cpu_más > 0 entonces escribir(", y ", n_cpu_más, " que se pueden encender") fin
            si híbrido entonces escribir("; híbrido: cuáles son P y cuáles E, al encenderlos (más abajo)") fin
            escribir("\n  APIC local en ")
            hex(lapic_fís)
            si con_8259 entonces escribir("; con 8259 (se tapa)") fin
            escribir("\n")
            i := 0
            mientras i < n_ioapic hacer
                escribir("  IOAPIC ", io_id[i], " en ")
                hex(io_fís[i])
                escribir(", GSI ", io_gsi[i], " a ", io_gsi[i] + entradas(i) - 1, " (", entradas(i), " entradas, versión ")
                hex(nat64(versión_io(i)))
                escribir(")\n")
                i := i + 1
            fin
            si n_iso > 0 entonces
                escribir("  IRQ de ISA cambiadas:")
                i := 0
                mientras i < n_iso hacer
                    si i > 0 entonces escribir(";") fin
                    escribir(" ", iso_irq[i], " -> GSI ", iso_gsi[i])
                    marcas_mps(iso_marcas[i])
                    i := i + 1
                fin
                escribir("\n")
            fin
        sino
            escribir("  sin MADT: un solo procesador, sin IOAPIC\n")
        fin
        si hay_fadt entonces
            escribir("  FADT: ")
            si reducido() entonces escribir("hardware reducido; ") fin
            si pm_tmr <> 0 entonces
                escribir("reloj de ACPI en el puerto ")
                hex(nat64(pm_tmr))
                si pm_32 entonces escribir(" (32 bits)") sino escribir(" (24 bits)") fin
            sino
                escribir("sin reloj de ACPI")
            fin
            escribir(", la SCI en la IRQ ", sci)
            escribir(", 8042: ")
            si arq yb 2 <> 0 entonces escribir("sí") sino escribir("no lo dice") fin
            si botón_fijo() entonces escribir(", botón de encendido fijo") sino escribir(", el botón de encendido lo lleva el AML") fin
            si hay_s5 entonces escribir(", apagar (\\_S5): SLP_TYP ", slp5a) sino escribir(", sin \\_S5") fin
            escribir("\n")
        fin
        si hpet_fís <> 0 entonces
            escribir("  HPET en ")
            hex(hpet_fís)
            escribir("\n")
        sino
            escribir("  sin HPET\n")
        fin
        si n_mcfg > 0 entonces
            escribir("  MCFG: PCIe por ECAM en ")
            hex(mc_base[0])
            escribir(", segmento ", mc_seg[0], ", buses ", mc_bus_ini[0], " a ", mc_bus_fin[0])
            si n_mcfg > 1 entonces escribir(" (y ", n_mcfg - 1, " segmentos más)") fin
            escribir("\n")
        sino
            escribir("  sin MCFG: la configuración de PCI, por los puertos 0xCF8 y 0xCFC\n")
        fin
    fin

    función cuenta_reloj()
        variable h: nat64
        escribir("Reloj: ")
        si fuente = HPET entonces
            h := hz()
            escribir("el HPET, a ", h div 1000000, ",", (h mod 1000000) div 1000, " MHz, ", hpet_temps, " temporizadores, contador de ")
            si hpet_64 entonces escribir("64 bits") sino escribir("32 bits") fin
        sino si fuente = PM entonces
            escribir("el reloj de ACPI (sin HPET), a 3,579 MHz")
        sino
            escribir("ninguno (sin HPET ni reloj de ACPI): se mide con el 8254")
        fin
        escribir("\n  TSC: ", tsc_hz div 1000000, " MHz; invariante: ")
        si tsc_invariante entonces escribir("sí") sino escribir("no") fin
        si tcg_hay entonces escribir("; QEMU sin KVM (TCG)") fin
        si kvm_hay entonces
            escribir("; KVM, ")
            si kvm_estable entonces escribir("con el TSC estable (pvclock)") sino escribir("sin el TSC estable") fin
        fin
        escribir("\n")
    fin

    ; espera hasta que pasen esos nanosegundos (con las interrupciones encendidas)
    función espera_ns(ns: nat64)
        variable t0: nat64
        t0 := ahora_ns()
        mientras ahora_ns() - t0 < ns hacer pausa() fin
    fin

    ; el IOAPIC, de verdad: el temporizador 0 del HPET (de una vez, 20 veces,
    ; a 10 ms) o, si no hay HPET, el 8254 (100 por segundo, durante 200 ms),
    ; por una GSI a V_PRUEBA
    función prueba_ioapic()
        variable conf, rutas, cada, t0: nat64
        variable g, k: nat32
        variable bien: bool
        ; el 8254 (si lo hay), callado: su IRQ 0 va también a la GSI 2
        sale8(0x43, 0x30)
        sale8(0x40, 1)
        sale8(0x40, 0)
        espera_ns(1000000)
        n_prueba := 0
        prueba_io_gsi := 0xFFFFFFFF
        si fuente = HPET entonces
            conf := m64(hpet + 0x100)
            rutas := conf >> 32
            g := 0xFFFFFFFF
            k := 31
            mientras cierto hacer
                si (rutas >> k) yb 1 <> 0 y (g = 0xFFFFFFFF o k >= 16 o g < 16) entonces
                    si g = 0xFFFFFFFF o k >= 16 entonces g := k fin
                fin
                si k = 0 entonces romper fin
                k := k - 1
            fin
            si g = 0xFFFFFFFF entonces
                prueba_io_de := "el temporizador 0 del HPET (no dice por qué GSI puede ir)"
                devolver
            fin
            bien := dirige(g, V_PRUEBA, 5, falso)
            si no bien entonces
                prueba_io_de := "el temporizador 0 del HPET (su GSI no es de ningún IOAPIC)"
                devolver
            fin
            ; de una vez (no periódico), 10 ms cada vez, 20 veces: cada una
            ; tiene que llegar antes de 50 ms
            cada := muldiv(10000000, 1000000, hpet_periodo)       ; 10 ms
            conf := conf yb (nob nat64(0x7F4E))                   ; sin FSB, por flanco, de una vez, apagado
            conf := conf ob (nat64(g) << 9)
            pon_m64(hpet + 0x100, conf ob 4)                       ; encendido
            k := 0
            mientras k < 20 hacer
                pon_m64(hpet + 0x108, m64(hpet + 0xF0) + cada)
                t0 := ahora_ns()
                mientras n_prueba = k y ahora_ns() - t0 < 50000000 hacer pausa() fin
                si n_prueba = k entonces romper fin
                k := k + 1
            fin
            pon_m64(hpet + 0x100, conf)
            prueba_io_de := "el temporizador 0 del HPET"
        sino
            g := dirige_isa(0, V_PRUEBA)
            si g = 0xFFFFFFFF entonces
                prueba_io_de := "el 8254 (su IRQ no es de ningún IOAPIC)"
                devolver
            fin
            sale8(0x43, 0x34)                                      ; canal 0, modo 2, 100 por segundo
            sale8(0x40, 11932 yb 0xFF)
            sale8(0x40, 11932 >> 8)
            espera_ns(205000000)
            sale8(0x43, 0x30)
            sale8(0x40, 1)
            sale8(0x40, 0)
            prueba_io_de := "el canal 0 del 8254"
        fin
        espera_ns(1000000)
        tapa(g)
        prueba_io_gsi := g
        prueba_io := n_prueba
    fin

    función etapa2()
        variable t0, k0, k1, t1, p0, h0: nat64
        variable s0, s1, i: nat32
        variable c: puntero a Cpu
        pon_pila_bsp(k_pila_fin)
        lee_acpi(rsdp)
        prepara_apic()
        cuenta_acpi()
        hpet_32_forzado := tiene("hpet32")
        tsc_prohibido := tiene("reloj=hpet")              ; [etapa 10 f]
        tsc_forzado := tiene("reloj=tsc")
        prepara_reloj()
        cuenta_reloj()
        c := yo()
        escribir("APIC local: ")
        si x2 entonces
            escribir("en x2APIC")
        sino
            escribir("en xAPIC, en ")
            hex(lapic_base)
        fin
        escribir(", el de este procesador es el ", c.apic, "; versión ")
        hex(nat64(apic_lee(0x30) yb 0xFF))
        escribir("; el 8259, tapado\n")
        si tiene("prueba=sintic") entonces
            escribir("Tic: sin el temporizador del APIC (prueba=sintic)\n")
        sino si pon_tic() entonces
            escribir("  su temporizador: ", por_10ms, " cuentas cada 10 ms (entre 16), medido con ", medido_con, "; el tic, ", HZ, " por segundo, al vector ")
            hex(nat64(V_TIC))
            escribir("\n")
        sino
            escribir("  su temporizador no se puede medir: sin tic\n")
        fin
        enciende()
        si tic_va y fuente <> NINGUNO y no tiene("sinmedir") entonces
            ; 1 s con el reloj: los tics que llegan y [etapa 11 b] los que no
            ; (el procesador parado desde fuera: Apic64.tic los cuenta con el
            ; TSC), que suman los 100; y cada cuánto da el tic el
            ; temporizador, contra el TSC (lo que de verdad se ha programado)
            c := yo()
            k0 := mis_tics()
            p0 := c.perdidos
            h0 := c.huecos
            t0 := ahora_ns()
            mientras ahora_ns() - t0 < 1000000000 hacer espera_int() fin
            tics_1s := mis_tics() - k0
            escribir("Tic: ", tics_1s, " tics en 1 s (")
            si fuente = HPET entonces escribir("medido con el HPET") sino escribir("medido con el reloj de ACPI") fin
            escribir("), ", c.perdidos - p0, " que no han llegado (", c.huecos - h0, " huecos)")
            ; y entre dos cambios del segundo del CMOS (otro reloj, que no es el que ha medido)
            si hay_cmos() entonces
                t0 := ahora_ns()
                s0 := segundo_cmos()
                s1 := s0
                mientras s1 = s0 y ahora_ns() - t0 < 1500000000 hacer
                    espera_int()
                    s1 := segundo_cmos()
                fin
                k0 := mis_tics()
                p0 := c.perdidos
                s0 := s1
                t1 := ahora_ns()
                mientras s1 = s0 y ahora_ns() - t1 < 1500000000 hacer
                    espera_int()
                    s1 := segundo_cmos()
                fin
                k1 := mis_tics()
                si s1 <> s0 entonces
                    tics_cmos := k1 - k0
                    escribir("; entre dos cambios del segundo del CMOS: ", tics_cmos, " tics y ", c.perdidos - p0, " que no han llegado")
                fin
            fin
            p0 := periodo_tic_us()
            si p0 <> 0 entonces
                escribir("; el temporizador, cada ", p0 div 1000, ",", (p0 div 100) mod 10, (p0 div 10) mod 10, " ms (contra el TSC)")
            fin
            escribir("\n")
        fin
        prueba_ioapic()
        escribir("IOAPIC: ", prueba_io_de)
        si prueba_io_gsi <> 0xFFFFFFFF entonces
            escribir(", por la GSI ", prueba_io_gsi, ", al vector ")
            hex(nat64(V_PRUEBA))
            si fuente = HPET entonces escribir(": ", prueba_io, " de 20 interrupciones (cada 10 ms)") sino escribir(": ", prueba_io, " interrupciones en 200 ms (100 por segundo)") fin
            si prueba_io = 0 entonces escribir(" (no llega)") fin
        fin
        escribir("\n")
        escribir("Teclado PS/2: ")
        si pon_teclado() entonces
            escribir("la IRQ 1, por la GSI ", teclado_gsi, ", al vector ")
            hex(nat64(V_ISA + 1))
            escribir("\n")
        sino
            escribir("no hay 8042\n")
        fin
        escribir("Botón de encendido: ")
        si no botón_fijo() entonces
            escribir("no es de los fijos de ACPI (lo lleva el AML: más adelante, con ACPICA)\n")
        sino si no modo_acpi() entonces
            escribir("el firmware no pasa al modo ACPI\n")
        sino si no pon_sci_con_botón() entonces
            escribir("la SCI no es de ningún IOAPIC\n")
        sino
            escribir("en modo ACPI; la SCI por la GSI ", sci_gsi)
            si hay_s5 entonces escribir("; pulsarlo apaga el equipo\n") sino escribir("; sin \\_S5 no se sabe apagar\n") fin
        fin
        ; PCI
        busca()
        escribir("PCI")
        si ecam <> 0 entonces escribir(" (PCIe, por ECAM)") sino escribir(" (por los puertos 0xCF8)") fin
        escribir(": ", pci_n, " funciones en los buses ", bus_ini, " a ", bus_fin)
        si n_puentes > 0 entonces escribir(", ", n_puentes, " puentes") fin
        si n_altas > 0 entonces escribir(", ", n_altas, " BAR por encima de 4 GB") fin
        escribir("\n")
        escribe_pci()
        si hay_cmos() entonces
            escribir("Hora (CMOS): ")
            escribe_hora()
            escribir("\n")
        fin
        i := 0
    fin

    ; lo que se pide a mano en la línea de órdenes, de la etapa 2
    función pruebas2()
        variable t0: nat64
        variable k, n: ent32
        si tiene("prueba=teclado") entonces
            escribir("Prueba: esperando teclas (15 s como mucho)...\n")
            t0 := ahora_ns()
            n := 0
            mientras n < 4 y ahora_ns() - t0 < 15000000000 hacer
                k := tecla()
                si k >= 0 entonces
                    escribir("Tecla: código ")
                    hex(nat64(k))
                    si k yb 0x80 <> 0 entonces escribir(" (soltada)\n") sino escribir(" (pulsada)\n") fin
                    n := n + 1
                sino
                    espera_int()
                fin
            fin
        fin
        si tiene("prueba=boton") entonces
            escribir("Prueba: esperando el botón de encendido...\n")
            t0 := ahora_ns()
            mientras no botón y ahora_ns() - t0 < 30000000000 hacer espera_int() fin
            si botón entonces
                escribir("Botón de encendido pulsado: se apaga el equipo (ACPI, S5).\n")
                apaga_todo()
            fin
            escribir("No se ha podido apagar.\n")
        fin
        si tiene("prueba=acpiapagar") entonces
            escribir("Prueba: apagar por ACPI (S5, SLP_TYP ", slp5a, ")...\n")
            apaga_todo()
            escribir("No se ha podido apagar.\n")
        fin
    fin

    ; ---- [etapa 6] la consola, el teclado y los programas que arrancan programas ----
    variable fallos6: nat32

    función mal6(qué: puntero a byte)
        fallos6 := fallos6 + 1
        pon_color(12, 0)
        escribir("  MAL: ", qué, "\n")
        pon_color(7, 0)
    fin

    función etapa6()
        variable p: puntero a Proceso
        variable r, t0: nat64
        prepara_tty()
        si no prepara_teclas() entonces mal6("no se pone en marcha el hilo del teclado") fin
        escribir("Consola: una terminal (modo canónico con eco y edición de línea, y crudo), ")
        si hay() entonces escribir("de ", columnas, " x ", filas) sino escribir("por el puerto serie") fin
        escribir("; el teclado, con el mapa español (PS/2 y HID)\n")
        si tiene("sinpruebas") o no tic_va entonces devolver fin
        si busca_archivo("HIJOS") < 0 entonces
            escribir("(sin el programa HIJOS en la unidad: sin las pruebas de fork, execve y wait4)\n")
            devolver
        fin
        t0 := ahora_ns()
        p := lanza("HIJOS")
        si p = nulo entonces
            mal6("no arranca HIJOS")
            devolver
        fin
        r := espera_proceso(p)
        escribir("Programa «HIJOS»: acaba con el código ", r)
        si r = 0 entonces escribir(", como debe (en ", (ahora_ns() - t0) div 1000000, " ms)\n") sino
            escribir("\n")
            mal6("HIJOS no acaba con el código que debe")
        fin
        ; (los huérfanos que dejó acaban solos)
        t0 := ahora_ns()
        mientras (vivos > 0 o en_tabla > 0) y ahora_ns() - t0 < 3000000000 hacer duerme_ms(10) fin
        escribir("Después de los hijos: ", vivos, " procesos, ", en_tabla, " en la tabla, ", n_espacios, " espacios, ", tablas_usuario, " tablas de programas; ")
        escribir(forks, " fork, ", execs, " execve, ", zombis_recogidos, " recogidos por wait4, ", huérfanos_n, " huérfanos\n")
        si vivos <> 0 o en_tabla <> 0 o n_espacios <> 0 o tablas_usuario <> 0 entonces mal6("quedan procesos, zombis o espacios") fin
    fin

    ; [etapa 10 h] t detrás de lo que ya hay en d (de máx octetos, con el 0)
    función junta(d: puntero a byte, t: puntero a byte, máx: nat32)
        variable i, j: nat32
        i := 0
        mientras d[i] <> 0 hacer i := i + 1 fin
        j := 0
        mientras t[j] <> 0 y i + 1 < máx hacer
            d[i] := t[j]
            i := i + 1
            j := j + 1
        fin
        d[i] := 0
    fin

    ; el intérprete de órdenes (ORDENES, de la unidad) en la consola, hasta que
    ; acabe («salir») o se pulse el botón de encendido; falso si no está
    función intérprete(): bool
        variable p: puntero a Proceso
        variable r: nat64
        variable v: arreglo [210] de byte
        variable orden: arreglo [230] de byte
        ; [etapa 8] con «escritorio» en la línea: antes, el escritorio (VENTANAS);
        ; al salir de él, el intérprete
        si tiene("escritorio") y busca_archivo("VENTANAS") >= 0 entonces
            ; [etapa 10 h] con «navegador» (o «navegador=URL»), el escritorio
            ; con el Navegador (Ladybird con ventana) abierto
            valor_de("navegador=", dirección(v[0]))
            si (tiene("navegador") o v[0] <> 0) y busca_archivo("NAVEGADOR") >= 0 entonces
                copia_texto(dirección(orden[0]), "VENTANAS NAVEGADOR", 220)
                si v[0] <> 0 entonces
                    junta(dirección(orden[0]), "=", 220)
                    junta(dirección(orden[0]), dirección(v[0]), 220)
                fin
                p := lanza(dirección(orden[0]))
            sino
                p := lanza("VENTANAS")
            fin
            si p <> nulo entonces
                mientras no ha_acabado(p) y no botón hacer duerme_ms(20) fin
                si botón entonces devolver cierto fin
                r := espera_proceso(p)
                escribir("El escritorio ha acabado (código ", r, ").\n")
            fin
        fin
        si busca_archivo("ORDENES") < 0 entonces
            escribir("(No está el intérprete de órdenes, ORDENES, en la unidad.)\n")
            devolver falso
        fin
        p := lanza("ORDENES")
        si p = nulo entonces
            escribir("No se ha podido arrancar el intérprete de órdenes: ", motivo, "\n")
            devolver falso
        fin
        mientras no ha_acabado(p) y no botón hacer duerme_ms(20) fin
        si botón entonces devolver cierto fin
        r := espera_proceso(p)
        escribir("El intérprete de órdenes ha acabado (código ", r, ").\n")
        devolver cierto
    fin

    ; en el equipo de verdad (sin «apagar»): el intérprete de órdenes; al
    ; salir de él (o con el botón de encendido), se apaga el equipo
    función en_marcha()
        variable s, s0: nat32
        pon_color(14, 0)
        escribir("(Hispa-64 en marcha: el intérprete de órdenes; «salir» o el botón de encendido apagan el equipo.)\n")
        pon_color(7, 0)
        si tic_va y va entonces
            si intérprete() entonces
                escribir("\nSe apaga el equipo.\n")
                al_apagar(cierto)
                apaga_todo()
                escribir("No se ha podido apagar: mantenga pulsado el botón.\n")
            fin
        fin
        s0 := 99
        mientras cierto hacer
            si botón entonces
                escribir("\nBotón de encendido pulsado: se apaga el equipo.\n")
                al_apagar(cierto)
                apaga_todo()
                escribir("No se ha podido apagar: mantenga pulsado el botón.\n")
                apaga()
                mientras cierto hacer espera_int() fin
            fin
            si hay_cmos() entonces
                s := segundo_cmos()
                si s <> s0 entonces
                    s0 := s
                    escribir("\rReloj: ")
                    escribe_hora()
                    escribir(" (tics: ", mis_tics(), "; ")
                    carga_corta()
                    escribir(")   ")
                fin
            fin
            si va y tic_va entonces duerme_ms(10) sino si tic_va entonces espera_int() sino pausa() fin
        fin
    fin

    ; lo ocupado de cada procesador en el último rato, corto (para la línea del reloj)
    función carga_corta()
        variable i: nat32
        variable t, d, oc: nat64
        variable c: puntero a Cpu
        t := tsc()
        d := t - tsc_antes
        escribir("ocupados:")
        i := 0
        mientras i < n_cpus y i < 16 hacer
            c := cpu(i)
            si c.en_marcha <> 0 entonces
                oc := c.tsc_ocioso - ocioso_antes[i]
                ocioso_antes[i] := c.tsc_ocioso
                si oc > d entonces oc := d fin
                si d > 0 entonces escribir(" ", ((d - oc) * 100) div d, "%") fin
            fin
            i := i + 1
        fin
        tsc_antes := t
    fin

    función pon_sci_con_botón(): bool
        pon_botón()
        devolver pon_sci()
    fin

    función principal(): byte
        variable temprana: bool
        ensamblador
            mov eax, [C_mb_magia]
            mov {magia}, eax
            mov eax, [C_mb_info]
            mov {info}, eax
        fin
        pon_gdt()
        prepara_bsp()
        prepara()
        si magia = MB2 entonces lee_mb2() sino si magia = MB1 entonces lee_mb1() fin
        apagar_al_fallar := tiene("apagar")
        lee()
        ; la consola, ya, si la pantalla está en los 64 primeros GB (los de las
        ; tablas del arranque); si no, cuando estén las de verdad
        temprana := hay_fb y fb_dir + nat64(fb_paso) * fb_alto <= nat64(64) << 30
        si temprana entonces
            si abre(virt(fb_dir), fb_ancho, fb_alto, fb_paso, fb_bpp, fb_r, fb_v, fb_a) entonces en_pantalla := cierto fin
        fin
        pon_consola()                   ; ([etapa 10 e] con pantalla o sin ella: el registro)
        pon_color(14, 0)
        escribir("Hispa-64 ", VERSIÓN, " \xC4 Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.\n")
        pon_color(7, 0)
        escribir("Etapa 8: la pantalla para los programas, las ventanas y la oficina, en Castel de 64 bits.\n\n")
        ; el cargador
        escribir("Cargador: ")
        si cargador[0] <> 0 entonces escribir(cargador, ", ") fin
        si magia = MB2 entonces escribir("multiboot2") sino si magia = MB1 entonces escribir("multiboot") sino escribir("¿?") fin
        si con_uefi = 64 entonces escribir(", con UEFI de 64 bits")
        sino si con_uefi = 32 entonces escribir(", con UEFI de 32 bits")
        sino si magia = MB2 entonces escribir(", con la BIOS") fin
        escribir("\n")
        si línea[0] <> 0 entonces escribir("Línea de órdenes: ", línea, "\n") fin
        ; el procesador
        escribir("Procesador: ", nombre_limpio(), "\n")
        escribir("  ", fabricante, ", familia ", familia(), ", modelo ", modelo(), ", revisión ", revisión())
        escribir("; ", lógicos(), " procesadores lógicos en el paquete (según CPUID)\n")
        escribir("  páginas de 1 GB: ")
        sí_no(pag1g)
        escribir("; NX: ")
        sí_no(nx)
        escribir("; x2APIC: ")
        sí_no(x2apic)
        escribir("; HWP: ")
        sí_no(hwp)
        escribir("; híbrido (núcleos P y E): ")
        sí_no(híbrido)
        escribir("\n")
        escribir("  direcciones físicas de ", bits_físicos(), " bits\n")
        ; la memoria
        el_mapa()
        memoria()
        ; [etapa 4] la mitad alta, compartida (antes de encender los demás); lo
        ; de este procesador para los programas; la unidad en memoria
        prepara_mitad_alta()
        si tiene("sinpcid") entonces sin_pcid() fin
        prepara_cpu()
        pon_tsc_aux(0)                  ; [etapa 10 g] el número de este (el 0), para rdtscp (getcpu)
        unidad()
        si hay_fb y no temprana entonces
            si abre(fb_virt, fb_ancho, fb_alto, fb_paso, fb_bpp, fb_r, fb_v, fb_a) entonces en_pantalla := cierto fin
        fin
        ; [etapa 8] la pantalla para los programas (/dev/fb0) y los demás dispositivos
        si hay_fb entonces prepara_disp(fb_dir) sino prepara_disp(0) fin
        escribir("El núcleo, en la mitad alta: ")
        hex16(k_ini)
        escribir(" (código, de solo leer), los datos sin ejecutar desde ")
        hex16(k_datos)
        escribir("\n  la pila, de ")
        hex16(k_pila)
        escribir(" a ")
        hex16(k_pila_fin)
        escribir(", con una página de guarda debajo\n")
        escribir("TSS con pilas propias (IST) para el doble fallo (")
        hex16(ist(1))
        escribir("), el NMI (")
        hex16(ist(2))
        escribir(") y el fallo de máquina (")
        hex16(ist(3))
        escribir(")\n")
        ; la pantalla
        escribir("Pantalla: ")
        si hay_fb entonces
            escribir(fb_ancho, " x ", fb_alto, " puntos, ", fb_bpp, " bits por punto, ", fb_paso, " octetos por línea, en ")
            hex(fb_dir)
            si fb_dir >= nat64(1) << 32 entonces escribir(" (por encima de 4 GB)") fin
            escribir("\n")
            si hay() entonces
                escribir("  consola de ", columnas, " x ", filas, " letras")
                si escala_letra() > 1 entonces escribir(", con la letra al ", escala_letra(), " x ", escala_letra()) fin
                escribir("\n")
            sino
                escribir("  sin consola en ella (no es de 32 ni de 24 bits por punto)\n")
            fin
        sino
            escribir("ninguna gráfica (solo el puerto serie)\n")
        fin
        ; [etapa 2] ACPI, los relojes, las interrupciones, PCI
        etapa2()
        ; las pruebas de la memoria de cada arranque (cortas)
        prueba_páginas()
        prueba_montón(2000, 64)
        si tiene("prueba=monton") entonces prueba_montón(100000, 1000) fin
        agranda_registro()              ; [etapa 10 e] el registro del arranque, a 1 MB del montón (después de su prueba)
        ; [etapa 3] los demás procesadores y el planificador
        etapa3()
        ; [etapa 11 b] ACPICA, antes de las tarjetas (las rutas de las INTx de los _PRT)
        si no tiene("sinacpica") entonces prepara_acpica(tiene("acpi=registro"), tiene("acpi=sinini")) fin
        si tiene("prueba=acpica") entonces prueba_acpica() fin
        si no tiene("sinhwp") entonces prepara_hwp() fin
        prepara_ratón()
        etapa5()
        prepara_i2chid(tiene("sini2c"), tiene("prueba=hid"), tiene("prueba=barcero"))     ; [etapa 6] HID (sus pruebas) e I2C-HID
        etapa4()
        etapa9()                            ; [etapa 9] las tarjetas de red, la pila y los sockets
        pruebas5()
        si tiene("prueba=raton") entonces prueba_ratón() fin
        ; las excepciones: un punto de parada, que se atiende y se sigue
        escribir("Excepciones: las 32 en la IDT, explicadas en español. Una int3 de prueba:\n  ")
        ensamblador
            int3
        fin
        provoca()
        pruebas2()
        etapa6()
        ; [etapa 7] musl: los programas de C de hoy
        ak_todas := tiene("ak=todas")
        valor_de("mcasa=", dirección(mcasa[0]))   ; [etapa 11 a] (como mucho 200)
        con_ladybird := tiene("ladybird")      ; [etapa 10 g]
        medidas := tiene("medidas")             ; [etapa 10 f]
        si no tiene("sinpruebas") y no tiene("sinmusl") y tic_va entonces pruebas_musl() fin
        ; [etapa 9] la red
        si no tiene("sinpruebas") y no tiene("sinred") y tic_va entonces pruebas_red() fin
        ; [etapa 11 a] suspender (S3): si el equipo sabe; «sins3», no
        si no tiene("sins3") y tic_va entonces
            s3_aparatos := nat64(dirección(reanuda_aparatos))
            s3_traza := tiene("s3=traza")
            sin_mtrr := tiene("s3=sinmtrr")
            si prepara_suspender() entonces
                escribir("Suspender: se puede (\\_S3 y la FACS; ", n_cpus, " procesadores; la tapa o el menú Inicio)\n")
            sino
                escribir("Suspender: no se puede (", fallo, ")\n")
            fin
            si tiene("prueba=suspender") entonces prueba_suspender() fin
        fin
        si fallos + fallos_proc + fallos_disco + fallos6 + fallos7 + fallos9 + fallos_acpica > 0 entonces
            pon_color(12, 0)
            escribir("Hispa-64 etapa 11: con fallos (los «MAL» de arriba).\n")
            pon_color(7, 0)
            registro("(el arranque, entero)")         ; [etapa 10 e]
            si apagar_al_fallar entonces
                al_apagar(cierto)
                devolver 43
            fin
        sino
            pon_color(10, 0)
            escribir("Hispa-64 etapa 11: todo en orden.\n")
            pon_color(7, 0)
        fin
        si fallos + fallos_proc + fallos_disco + fallos6 + fallos7 + fallos9 + fallos_acpica = 0 entonces registro("(el arranque, entero)") fin   ; [etapa 10 e]
        al_apagar(falso)
        ; [etapa 6] con «ordenes» (las pruebas): el intérprete, y al salir, se apaga
        si apagar_al_fallar y tiene("ordenes") entonces
            intérprete()
            al_apagar(cierto)
            devolver 42
        fin
        si apagar_al_fallar entonces
            al_apagar(cierto)
            devolver 42
        fin
        ; [etapa 11 a] prueba=bateriabaja (sin «apagar»): con el intérprete o el
        ; escritorio ya en marcha, la batería de mentira baja al 9 % y luego al 2 %
        si tiene("prueba=bateriabaja") entonces crea(nat64(dirección(hilo_batería_baja)), 0, "prueba-bateria", NORMAL, CUALQUIERA) fin
        en_marcha()
        devolver 0
    fin

fin Hispa64.
