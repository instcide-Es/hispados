; =============================================================================
;  prmusl64.cas - Hispa-64, etapa 7: las pruebas de cada arranque con los
;  programas hechos con musl (docs/64/HISPA-64.md, sección 13; los hace
;  programas/hazlos.sh con el musl-gcc del árbol de construcción):
;
;    MHOLA, MHOLAD, MHOLAP    printf, malloc, el entorno, los archivos, la
;                             hora, qsort...: estático, dinámico (con
;                             ld-musl y libsaludo.so, que carga con mmap) y
;                             estático de posición libre (static-pie)
;    MHILOS, MHILOSD          8 hilos con un mutex y una condición, TLS,
;                             pthread_join, un semáforo, AVX entre hilos
;    MSENALES, MSENALESD      sigaction, la máscara, kill, raise, tgkill, los
;                             fallos (SIGSEGV, SIGFPE, SIGILL) atendidos, la
;                             pila de las señales, SA_RESTART, SIGCHLD, y un
;                             hijo que no llama al sistema cerrado con kill
;    MPROCESOS, MPROCESOSD    fork (copiar al escribir), execve, wait,
;                             tuberías, dup2, posix_spawn, popen
;    MMAPA, MMAPAD            mmap de un archivo (privado y compartido de
;                             solo leer), MAP_SHARED anónima entre procesos
;    LUA PRUEBA.LUA           Lua 5.5, sin cambiar nada
;
;  Cada uno dice lo suyo y acaba con 0; después, nada de más (procesos,
;  espacios, memoria, montón, tuberías).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo PrMusl64

    importar Cifras64, Pant64, Es64, Cerrojo, Fisica64, Pagina64, Monton64, Reloj64, Hilos64, Smp64, Entradas, Espacios, Unidad64, Procesos, Sistema, Futex64, Tubos64, Disp64, Redcom64, Hda64, Unix64, Discos64

    público variable fallos7: nat32
    público variable medidas: bool              ; [etapa 10 f] «medidas»: lo que llevan execve, los fallos de página y las llamadas
    público variable con_ladybird: bool         ; [etapa 10 g] «ladybird»: MJS y MWEB
    público variable ak_todas: bool             ; [etapa 10 e] «ak=todas»: MAK con los 85 grupos de TestAK (si no, 12)

    función mal(qué: puntero a byte)
        fallos7 := fallos7 + 1
        pon_color(12, 0)
        escribir("  MAL: ", qué, "\n")
        pon_color(7, 0)
    fin


    función memoria_ahora(): nat64
        vacía_cuarentena()                      ; ([etapa 10 c] lo del montón que espera, devuelto)
        ; ([etapa 10 d] y lo guardado en /tmp, el disco en memoria: es suyo)
        devolver libres + páginas + nat64(tablas) + mem_usadas
    fin

    ; arranca la línea, espera a que acabe y mira su código
    función corre(línea: puntero a byte, esperado: nat64)
        variable p: puntero a Proceso
        variable r, t0: nat64
        t0 := ahora_ns()
        p := lanza(línea)
        si p = nulo entonces
            escribir("Programa «", línea, "»: no se ha podido arrancar: ", motivo, "\n")
            mal("no arranca")
            devolver
        fin
        r := espera_proceso(p)
        escribir("Programa «", línea, "»: acaba con el código ", r)
        si r = esperado entonces
            escribir(", como debe (en ", (ahora_ns() - t0) div 1000000, " ms)\n")
        sino
            escribir("\n")
            mal("no acaba con el código que debe")
        fin
    fin

    público variable mcasa: arreglo [210] de byte          ; [etapa 11 a] «mcasa=...»
    variable mcasa_línea: arreglo [48] de byte

        público función pruebas_musl()
        variable mem0, montón0, pilas0, t0: nat64
        variable i: nat32
        pon_color(14, 0)
        escribir("musl: los programas de C de hoy, con la biblioteca de C de musl (estáticos, dinámicos con ld-musl y PIE)")
        pon_color(7, 0)
        escribir("\n  AVX: ")
        si con_xsave entonces escribir("sí (xsave, XCR0 = ", xcr0, ", ", tam_fpu, " octetos por hilo)") sino escribir("no (fxsave, 512 octetos por hilo)") fin
        escribir("; RDRAND: ")
        si con_rdrand entonces escribir("sí") sino escribir("no") fin
        escribir("; RDSEED: ")
        si con_rdseed entonces escribir("sí") sino escribir("no") fin
        escribir("\n")
        si busca_archivo("MHOLA") < 0 entonces
            escribir("(Sin los programas de musl en la unidad: sin sus pruebas.)\n")
            devolver
        fin
        ; [etapa 11 a] con «mcasa=escribe» o «mcasa=comprueba» (la prueba del corte de luz), antes que nada
        si mcasa[0] <> 0 y busca_archivo("MCASA") >= 0 entonces
            mcasa_línea[0] := 'M'
            mcasa_línea[1] := 'C'
            mcasa_línea[2] := 'A'
            mcasa_línea[3] := 'S'
            mcasa_línea[4] := 'A'
            mcasa_línea[5] := ' '
            i := 0
            mientras mcasa[i] <> 0 y i < 31 hacer
                mcasa_línea[6 + i] := mcasa[i]
                i := i + 1
            fin
            mcasa_línea[6 + i] := 0
            corre(dirección(mcasa_línea[0]), 0)
            devolver        ; (las pruebas de la casa: solo eso)
        fin
        mem0 := memoria_ahora()
        montón0 := en_uso
        pilas0 := nat64(n_pilas)
        corre("MHOLA uno dos", 0)
        si busca_archivo("MHOLAD") >= 0 entonces corre("MHOLAD uno dos", 0) fin
        si busca_archivo("MHOLAP") >= 0 entonces corre("MHOLAP uno dos", 0) fin
        si busca_archivo("MHILOS") >= 0 entonces corre("MHILOS", 0) fin
        si busca_archivo("MHILOSD") >= 0 entonces corre("MHILOSD", 0) fin
        si busca_archivo("MSENALES") >= 0 entonces corre("MSENALES", 0) fin
        si busca_archivo("MSENALESD") >= 0 entonces corre("MSENALESD", 0) fin
        si busca_archivo("MPROCESOS") >= 0 entonces corre("MPROCESOS", 0) fin
        si busca_archivo("MPROCESOSD") >= 0 entonces corre("MPROCESOSD", 0) fin
        si busca_archivo("MMAPA") >= 0 entonces corre("MMAPA", 0) fin
        si busca_archivo("MMAPAD") >= 0 entonces corre("MMAPAD", 0) fin
        si busca_archivo("MDISP") >= 0 entonces corre("MDISP", 0) fin          ; [etapa 8] los dispositivos
        si busca_archivo("MRED") >= 0 entonces corre("MRED", 0) fin            ; [etapa 9] los sockets por 127.0.0.1, eventfd, timerfd, el azar
        si busca_archivo("MRED6") >= 0 entonces corre("MRED6", 0) fin          ; [etapa 10 c] IPv6 por ::1
        si busca_archivo("MUNIX") >= 0 entonces corre("MUNIX", 0) fin          ; [etapa 10 d] AF_UNIX, SCM_RIGHTS y memfd
        si busca_archivo("MCASA") >= 0 entonces corre("MCASA", 0) fin          ; [etapa 11 a] la casa (/casa), si la hay
        si busca_archivo("MENERGIA") >= 0 entonces corre("MENERGIA", 0) fin    ; [etapa 11 a] /dev/energia
        si busca_archivo("MPOSIX") >= 0 entonces corre("MPOSIX", 0) fin        ; [etapa 10 g] enlaces, descriptores, memfd, madvise, mremap, EDEADLK
        si busca_archivo("MRELOJ") >= 0 entonces corre("MRELOJ", 0) fin        ; [etapa 10 f] el vDSO y la hora
        si busca_archivo("MRELOJD") >= 0 entonces corre("MRELOJD", 0) fin      ; [etapa 10 f] lo mismo, dinámico (el vDSO, una biblioteca más)
        si busca_archivo("MCANDADOS") >= 0 entonces corre("MCANDADOS", 0) fin  ; [etapa 10 f] los cerrojos de fcntl (y sqlite)
        si busca_archivo("MIPC") >= 0 entonces corre("MIPC", 0) fin            ; [etapa 10 d] IPC entre dos procesos, como Ladybird (C++)
        si busca_archivo("MCXX") >= 0 entonces corre("MCXX", 0) fin            ; [etapa 10] C++ (la libstdc++ con musl)
        si busca_archivo("MCXXD") >= 0 entonces corre("MCXXD", 0) fin          ; [etapa 10 c] C++ dinámico (libstdc++.so.6)
        si busca_archivo("MTEXTO") >= 0 entonces corre("MTEXTO", 0) fin        ; [etapa 10] HarfBuzz y FreeType
        ; [etapa 10 b] ICU y libcurl; [etapa 10 c] otra vez antes del sonido: los
        ; cortes de MSONIDO después de MCURL eran las conexiones de MCURL que se
        ; soltaban (TIME_WAIT) mientras sonaba, un aviso de vaciar la TLB por
        ; cada página de sus búferes (la cuarentena de Monton64 lo arregla)
        si busca_archivo("MICU") >= 0 entonces corre("MICU", 0) fin            ; ICU (con icudt78l.dat)
        si busca_archivo("MIMG") >= 0 entonces corre("MIMG", 0) fin            ; [etapa 10 e] zlib, libpng, libjpeg-turbo y libwebp
        si busca_archivo("MLIBS") >= 0 entonces corre("MLIBS", 0) fin          ; [etapa 10 e] las demás bibliotecas que pide Ladybird
        si busca_archivo("MSKIA") >= 0 entonces corre("MSKIA", 0) fin          ; [etapa 10 e] Skia, con el procesador
        si busca_archivo("MCRIPTO") >= 0 entonces corre("MCRIPTO", 0) fin      ; [etapa 10 i] la WebCrypto de Ladybird (BearSSL y monocypher)
        ; [etapa 10 e] las pruebas de AK de Ladybird (TestAK): 12 grupos; con
        ; «ak=todas», los 85 (cada grupo es un proceso de 5 MB: con TCG, unos 200 s)
        si busca_archivo("MAK") >= 0 entonces
            si ak_todas entonces corre("MAK todas", 0) sino corre("MAK", 0) fin
        fin
        si busca_archivo("MRUST") >= 0 entonces corre("MRUST uno dos", 0) fin  ; [etapa 10 f] Rust (con nuestra musl)
        ; [etapa 10 f] las pruebas de LibUnicode, LibURL, LibIPC y LibGfx de
        ; Ladybird (TestLB, de 46 MB, con los datos de ICU dentro: solo en el
        ; arranque de KVM, que las lleva en la unidad)
        si busca_archivo("MLB") >= 0 entonces corre("MLB", 0) fin
        ; [etapa 10 g] las pruebas de LibJS (test-js-runtime, 48 MB, y MJS con las
        ; pruebas dentro) y el navegador sin ventana (MWEB: el Hub de Ladybird
        ; con WebContent y los suyos): con «ladybird» (el arranque de KVM de
        ; pruebas.sh, y la entrada del menú de la imagen con el navegador)
        si con_ladybird y busca_archivo("MJS") >= 0 entonces corre("MJS", 0) fin
        si con_ladybird y busca_archivo("MWEB") >= 0 entonces corre("MWEB", 0) fin
        ; [etapa 10 i] las pruebas de la WebCrypto de Ladybird (MWEB --cripto: sus
        ; 80 páginas de Tests/LibWeb/Text/input/Crypto, servidas por 127.0.0.1)
        si con_ladybird y busca_archivo("MWEB") >= 0 entonces corre("MWEB --cripto", 0) fin
        si busca_archivo("MCURL") >= 0 entonces corre("MCURL", 0) fin          ; libcurl por 127.0.0.1
        si busca_archivo("MSONIDO") >= 0 entonces
            corre("MSONIDO", 0)                                                 ; [etapa 11] el sonido (/dev/dsp)
            si hay_hda entonces escribir("  el sonido: ", hda_octetos, " octetos al anillo, ", hda_sin_datos, " veces sin datos, ", hda_lpib_atrás, " veces LPIB hacia atrás\n") fin
        fin
        si busca_archivo("LUA") >= 0 y busca_archivo("PRUEBA.LUA") >= 0 entonces corre("LUA /PRUEBA.LUA uno dos", 0) fin
        ; (los que quedasen sueltos acaban solos)
        t0 := ahora_ns()
        mientras (vivos > 0 o en_tabla > 0) y ahora_ns() - t0 < 3000000000 hacer duerme_ms(10) fin
        ; ([etapa 9] y los sockets de MRED que se quedan un rato en TIME_WAIT: 2 s)
        t0 := ahora_ns()
        mientras socks_vivos > 0 y ahora_ns() - t0 < 4000000000 hacer duerme_ms(10) fin
        ; (los hilos acabados los suelta la tarea ociosa en cuanto dejan su procesador)
        t0 := ahora_ns()
        mientras (memoria_ahora() <> mem0 o en_uso <> montón0 o nat64(n_pilas) <> pilas0) y ahora_ns() - t0 < 1000000000 hacer
            recoge()
            duerme_ms(10)
        fin
        escribir("Después de musl: ", vivos, " procesos, ", en_tabla, " en la tabla, ", n_espacios, " espacios, ", tablas_usuario, " tablas de programas, ", Tubos64.tubos, " tuberías; ")
        escribir(hilos_creados, " hilos creados, ", señales_entregadas, " señales entregadas, ", Futex64.esperas, " esperas de futex, ")
        escribir(páginas_compartidas, " páginas compartidas al bifurcar (", copias_rotas, " copiadas al escribir, ", copias_propias, " sin copiar); ")
        escribir(páginas_prestadas, " páginas de la unidad prestadas a los programas, sin copiarlas\n")       ; [etapa 10 f]
        escribir("  la memoria: ")
        si memoria_ahora() = mem0 entonces escribir("la de antes") sino escribir("¡distinta! (", mem0, " -> ", memoria_ahora(), " marcos)") fin
        escribir("; el montón: ", en_uso, " bloques")
        si en_uso = montón0 entonces escribir(" (los de antes)") sino escribir(" (antes, ", montón0, ")") fin
        escribir("; las pilas: ", n_pilas)
        si nat64(n_pilas) = pilas0 entonces escribir(" (las de antes)") sino escribir(" (antes, ", pilas0, ")") fin
        escribir("\n")
        si medidas entonces cuenta_medidas() fin
        si vivos <> 0 o en_tabla <> 0 o n_espacios <> 0 o tablas_usuario <> 0 o Tubos64.tubos <> 0 entonces mal("quedan procesos, espacios o tuberías") fin
        si memoria_ahora() <> mem0 entonces mal("se ha perdido memoria") fin
        si en_uso <> montón0 entonces mal("se han perdido bloques del montón") fin
        si shm_vivos <> 0 o shm_páginas <> 0 entonces mal("queda memoria compartida (/dev/shm)") fin
        si unix_vivos <> 0 entonces mal("quedan sockets de Unix") fin
        si nat64(n_pilas) <> pilas0 entonces mal("se han perdido pilas") fin
    fin


    ; [etapa 10 f] las medidas («medidas»), en µs (con el TSC)
    función us(c: nat64): nat64
        si tsc_hz = 0 entonces devolver 0 fin
        devolver muldiv(c, 1000000, tsc_hz)
    fin

    función cuenta_medidas()
        variable i, k, mejor: nat32
        variable hecho: arreglo [512] de bool
        variable m: nat64
        escribir("  medidas: ", execs, " execve, ", us(tsc_exec) div (execs + 1), " µs de media (cargar el programa: ", us(tsc_carga) div (execs + 1), "); ")
        escribir(n_fallos, " fallos de página que ponen una, ", muldiv(us(tsc_fallos), 1000, n_fallos + 1), " ns de media; deshacer los espacios al acabar, ", us(tsc_salidas) div 1000, " ms en total\n")
        escribir("  las llamadas que más llevan (con lo que esperan):")
        i := 0
        mientras i < 512 hacer
            hecho[i] := falso
            i := i + 1
        fin
        k := 0
        mientras k < 12 hacer
            m := 0
            mejor := 0
            i := 0
            mientras i < 512 hacer
                si no hecho[i] y llam_tsc[i] > m entonces
                    m := llam_tsc[i]
                    mejor := i
                fin
                i := i + 1
            fin
            si m = 0 entonces romper fin
            hecho[mejor] := cierto
            escribir(" ", mejor, ": ", llam_n[mejor], " en ", us(llam_tsc[mejor]) div 1000, " ms (", us(llam_tsc[mejor]) div llam_n[mejor], " µs);")
            k := k + 1
        fin
        escribir("\n")
    fin

fin PrMusl64.
