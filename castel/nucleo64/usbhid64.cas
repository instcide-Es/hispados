; =============================================================================
;  usbhid64.cas - Hispa-64, etapa 6: los teclados, ratones y tabletas USB (la
;  clase HID, 03; docs/64/HISPA-64.md, sección 12).
;
;  Cada interfaz HID con un extremo de interrupción de entrada: se lee su
;  descriptor de informe y lo analiza Hidesc64 (dónde van los botones, los
;  ejes, la rueda, las teclas); con eso, en el protocolo de informes (el de
;  verdad: con la rueda, y las tabletas con su posición absoluta). Si el
;  descriptor no se entiende y es un teclado o un ratón de arranque
;  (subclase 1), el protocolo de arranque (8 octetos el teclado, 3 el ratón).
;  El vigía (usbvigia.cas) mira los informes que llegan: las teclas, como
;  pulsadas y soltadas, a Teclas64 (con el mapa español); los movimientos, a
;  Raton64. Los LED del teclado (Bloq Mayús, Bloq Num), con SET_REPORT
;  cuando cambian.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Usbhid64

    importar Cifras64, Es64, Fisica64, Monton64, Hilos64, Xhci64, Usb64, Raton64, Hidesc64, Teclas64

    público constante MAX_HID = 8
    público constante H_TECLADO = 1
    público constante H_RATÓN = 2
    público constante H_TABLETA = 3

    tipo Hid = estructura
        hay: bool
        aparato, interfaz, número, ext: nat32
        clase: nat32                ; H_TECLADO, H_RATÓN, H_TABLETA
        arranque: bool              ; con el protocolo de arranque
        largo: nat32                ; del informe que se pide
        pedido: bool
        página: nat64               ; (física) el informe en 0; lo de antes (teclas) en 0x100
        antes: arreglo [8] de byte  ; (teclado) los modificadores y las teclas del informe anterior
        d: Diseño                   ; lo que dice su descriptor de informe
        leds: nat32                 ; (teclado) los LED puestos
    fin

    variable hids: arreglo [MAX_HID] de Hid
    público variable uh_teclados, uh_ratones, uh_tabletas, uh_informes, uh_teclas, uh_fallos: nat64
    público variable uh_última: nat32           ; el último uso de tecla pulsado (para las pruebas)

    función h8(h: nat32, k: nat32): nat32
        devolver m8(virt(hids[h].página) + nat64(k))
    fin

    ; una tecla HID (página 7) pulsada o soltada
    función tecla_usb(uso: nat32, pulsada: bool)
        si pulsada entonces
            uh_teclas := uh_teclas + 1
            uh_última := uso
        fin
        tecla_hid(uso, pulsada)
    fin

    variable leds_vistos: nat32
    público variable uh_leds: nat64             ; las veces que se han puesto los LED

    ; los LED de cada teclado (SET_REPORT de salida), si han cambiado
    función pon_los_leds()
        variable k, n, l, id: nat32
        variable a: puntero a Aparato
        variable q: puntero a byte
        si leds_cambio = leds_vistos entonces devolver fin
        leds_vistos := leds_cambio
        l := leds_teclado()
        k := 0
        mientras k < MAX_HID hacer
            si hids[k].hay y hids[k].clase = H_TECLADO y hids[k].leds <> l entonces
                a := aparato(hids[k].aparato)
                q := puntero(de_control(a))
                si hids[k].arranque entonces
                    q[0] := byte(l)
                    n := 1
                sino
                    n := pon_leds(hids[k].d, l, q)
                fin
                si n > 0 entonces
                    si hids[k].arranque o no hids[k].d.con_id entonces id := 0 sino id := hids[k].d.leds_id fin
                    u_control(a, 0x21, 0x09, 0x0200 ob id, hids[k].número, n)
                    uh_leds := uh_leds + 1
                fin
                hids[k].leds := l
            fin
            k := k + 1
        fin
    fin

    ; el informe de arranque del teclado: los modificadores (bits de 0xE0 a
    ; 0xE7) y hasta 6 teclas; lo que cambia respecto del anterior
    función teclado_arranque(h: nat32, n: nat32)
        variable t: arreglo [8] de byte
        variable k: nat32
        si n < 3 entonces devolver fin
        ; (un informe de «demasiadas teclas»: 0x01 en todas; se tira)
        si h8(h, 2) = 1 entonces devolver fin
        k := 0
        mientras k < 8 hacer
            si k < n entonces t[k] := byte(h8(h, k)) sino t[k] := 0 fin
            k := k + 1
        fin
        teclas_cambian(h, dirección(t[0]))
    fin

    ; el teclado por su descriptor: lo que dice, como el de arranque
    función teclado_informe(h: nat32, n: nat32)
        variable t: arreglo [8] de byte
        variable mods, cuántas, k: nat32
        k := 0
        mientras k < 8 hacer
            t[k] := 0
            k := k + 1
        fin
        si no lee_teclado(hids[h].d, puntero(virt(hids[h].página)), n, mods, dirección(t[2]), cuántas) entonces devolver fin
        t[0] := byte(mods)
        teclas_cambian(h, dirección(t[0]))
    fin

    ; lo que ha cambiado del teclado (t: los modificadores y, desde el 2, hasta 6 teclas)
    función teclas_cambian(h: nat32, t: puntero a byte)
        variable k, j, u, n: nat32
        variable está: bool
        n := 8
        ; los modificadores
        k := 0
        mientras k < 8 hacer
            si ((t[0] xob hids[h].antes[0]) >> k) yb 1 <> 0 entonces tecla_usb(0xE0 + k, (t[0] >> k) yb 1 <> 0) fin
            k := k + 1
        fin
        ; las soltadas: las de antes que no están
        k := 2
        mientras k < 8 hacer
            u := hids[h].antes[k]
            si u > 3 entonces
                está := falso
                j := 2
                mientras j < n y j < 8 hacer
                    si t[j] = u entonces está := cierto fin
                    j := j + 1
                fin
                si no está entonces tecla_usb(u, falso) fin
            fin
            k := k + 1
        fin
        ; las pulsadas: las de ahora que no estaban
        k := 2
        mientras k < n y k < 8 hacer
            u := t[k]
            si u > 3 entonces
                está := falso
                j := 2
                mientras j < 8 hacer
                    si hids[h].antes[j] = u entonces está := cierto fin
                    j := j + 1
                fin
                si no está entonces tecla_usb(u, cierto) fin
            fin
            k := k + 1
        fin
        k := 0
        mientras k < 8 hacer
            hids[h].antes[k] := t[k]
            k := k + 1
        fin
    fin

    función con_signo8(v: nat32): ent32
        si v >= 128 entonces devolver ent32(v) - 256 fin
        devolver ent32(v)
    fin

    función ratón_arranque(h: nat32, n: nat32)
        variable rueda: ent32
        si n < 3 entonces devolver fin
        rueda := 0
        si n >= 4 entonces rueda := con_signo8(h8(h, 3)) fin
        ratón_mueve(con_signo8(h8(h, 1)), con_signo8(h8(h, 2)), rueda, h8(h, 0) yb 7, 1)
    fin

    ; un informe que ha llegado
    función procesa(h: nat32, n: nat32)
        variable dx, dy, rueda, pan: ent32
        variable b, ax, ay: nat32
        variable p: puntero a byte
        uh_informes := uh_informes + 1
        p := puntero(virt(hids[h].página))
        si hids[h].arranque entonces
            si hids[h].clase = H_TECLADO entonces teclado_arranque(h, n) sino ratón_arranque(h, n) fin
        sino si hids[h].clase = H_TECLADO entonces
            teclado_informe(h, n)
        sino si hids[h].clase = H_RATÓN entonces
            si lee_ratón(hids[h].d, p, n, dx, dy, b, rueda, pan) entonces ratón_mueve(dx, dy, rueda, b, 1) fin
        sino si hids[h].clase = H_TABLETA entonces
            si lee_absoluto(hids[h].d, p, n, ax, ay, b, rueda) entonces
                ratón_absoluto(ax, ay, nat32(hids[h].d.ax_máx - hids[h].d.ax_mín), nat32(hids[h].d.ay_máx - hids[h].d.ay_mín), rueda, b)
            fin
        fin
    fin

    ; lee su descriptor de informe y lo analiza: cierto si se entiende
    función descriptor(h: nat32, a: puntero a Aparato, i: nat32): bool
        variable largo: nat32
        variable r: ent32
        largo := a.interfaces[i].largo_informe
        si largo = 0 o largo > 2048 entonces largo := 2048 fin
        r := u_control(a, 0x81, PIDE_DESCRIPTOR, 0x2200, hids[h].número, largo)
        si r <= 0 entonces devolver falso fin
        si no analiza(puntero(de_control(a)), nat32(r), hids[h].d) entonces devolver falso fin
        devolver no hids[h].d.malo
    fin

    ; la interfaz i del aparato ai, si es HID con un extremo de interrupción de entrada
    función toma(ai: nat32, i: nat32): bool
        variable a: puntero a Aparato
        variable k, e: nat32
        a := aparato(ai)
        si a.interfaces[i].clase <> 3 entonces devolver falso fin
        e := busca_ext(a, i, 3, cierto)
        si e = U_NINGUNO entonces devolver falso fin
        k := 0
        mientras k < MAX_HID y hids[k].hay hacer k := k + 1 fin
        si k >= MAX_HID entonces devolver falso fin
        hids[k].aparato := ai
        hids[k].interfaz := i
        hids[k].número := a.interfaces[i].número
        hids[k].ext := e
        hids[k].pedido := falso
        hids[k].página := página_de(a.ctl)
        si hids[k].página = 0 entonces devolver falso fin
        ; por su descriptor de informe (el protocolo de informes)
        hids[k].arranque := falso
        hids[k].largo := a.ext[e].paquete
        si hids[k].largo > 64 entonces hids[k].largo := 64 fin
        si descriptor(k, a, i) y (hids[k].d.teclado o hids[k].d.ratón o hids[k].d.absoluto) entonces
            si hids[k].d.teclado entonces
                hids[k].clase := H_TECLADO
                uh_teclados := uh_teclados + 1
            sino si hids[k].d.absoluto entonces
                hids[k].clase := H_TABLETA
                uh_tabletas := uh_tabletas + 1
            sino
                hids[k].clase := H_RATÓN
                uh_ratones := uh_ratones + 1
            fin
            si a.interfaces[i].subclase = 1 entonces u_control(a, 0x21, 0x0B, 1, hids[k].número, 0) fin      ; SET_PROTOCOL (informes)
            u_control(a, 0x21, 0x0A, 0, hids[k].número, 0)            ; SET_IDLE
            hids[k].hay := cierto
            a.dueño := DE_HID
            devolver cierto
        fin
        ; si no, el protocolo de arranque
        si a.interfaces[i].subclase = 1 y a.interfaces[i].protocolo = 1 entonces
            hids[k].clase := H_TECLADO
            hids[k].largo := 8
            uh_teclados := uh_teclados + 1
        sino si a.interfaces[i].subclase = 1 y a.interfaces[i].protocolo = 2 entonces
            hids[k].clase := H_RATÓN
            hids[k].largo := 4
            uh_ratones := uh_ratones + 1
        sino
            suelta_página(hids[k].página)
            devolver falso
        fin
        hids[k].arranque := cierto
        u_control(a, 0x21, 0x0B, 0, hids[k].número, 0)                ; SET_PROTOCOL (arranque)
        u_control(a, 0x21, 0x0A, 0, hids[k].número, 0)                ; SET_IDLE (solo al cambiar)
        hids[k].hay := cierto
        a.dueño := DE_HID
        devolver cierto
    fin

    público función hid_nuevo(ai: nat32)
        variable a: puntero a Aparato
        variable i: nat32
        a := aparato(ai)
        si a = nulo o a.dueño <> DE_NADIE entonces devolver fin
        i := 0
        mientras i < a.n_interfaces hacer
            toma(ai, i)
            i := i + 1
        fin
    fin

    público función prepara_hid()
        variable i: nat32
        i := 0
        mientras i < MAX_APARATOS hacer
            si aparato(i) <> nulo y aparato(i).usado entonces hid_nuevo(i) fin
            i := i + 1
        fin
    fin

    público función hid_se_va(ai: nat32)
        variable k: nat32
        k := 0
        mientras k < MAX_HID hacer
            si hids[k].hay y hids[k].aparato = ai entonces
                hids[k].hay := falso
                suelta_página(hids[k].página)
                aparato(ai).dueño := DE_NADIE
            fin
            k := k + 1
        fin
    fin

    ; (el vigía) los informes que han llegado, y otro pedido
    público función hid_mira()
        variable k: nat32
        variable a: puntero a Aparato
        variable r: ent32
        pon_los_leds()
        k := 0
        mientras k < MAX_HID hacer
            si hids[k].hay entonces
                a := aparato(hids[k].aparato)
                si no hids[k].pedido entonces
                    u_pide_informe(a, hids[k].ext, hids[k].página, hids[k].largo)
                    hids[k].pedido := cierto
                sino
                    r := u_informe(a, hids[k].ext, hids[k].largo)
                    si r <> -3 entonces
                        hids[k].pedido := falso
                        si r > 0 entonces procesa(k, nat32(r)) sino uh_fallos := uh_fallos + 1 fin
                        u_pide_informe(a, hids[k].ext, hids[k].página, hids[k].largo)
                        hids[k].pedido := cierto
                    fin
                fin
            fin
            k := k + 1
        fin
    fin

    público función escribe_clase(ai: nat32)
        variable k: nat32
        variable a: puntero a Aparato
        a := aparato(ai)
        si a.dueño = DE_ALM entonces escribir("; almacenamiento (SCSI, Bulk-Only)") fin
        k := 0
        mientras k < MAX_HID hacer
            si hids[k].hay y hids[k].aparato = ai entonces
                escribir("; HID: ")
                según nat16(hids[k].clase)
                    caso H_TECLADO: escribir("teclado")
                    caso H_RATÓN: escribir("ratón")
                    caso H_TABLETA: escribir("tableta")
                fin
                si hids[k].arranque entonces
                    escribir(" (protocolo de arranque)")
                sino
                    escribir(" (por su descriptor")
                    si hids[k].clase = H_RATÓN y hids[k].d.rueda_bits <> 0 entonces escribir(", con rueda") fin
                    si hids[k].clase = H_TABLETA entonces escribir(", de 0 a ", hids[k].d.ax_máx) fin
                    si hids[k].clase = H_TECLADO y hids[k].d.leds entonces escribir(", con LED") fin
                    escribir(")")
                fin
            fin
            k := k + 1
        fin
    fin

fin Usbhid64.
