; =============================================================================
;  sistema.cas - Hispa-64, etapa 4: las llamadas al sistema (docs/64/HISPA-64.md,
;  2.6 y sección 10). Llegan por «syscall» (Entradas.E64_sistema) con el marco
;  de los registros: el número en RAX, los argumentos en RDI, RSI, RDX, R10, R8
;  y R9, y lo que se devuelve en RAX (un error, en negativo: -EFAULT...).
;  **Los números y la forma, los de Linux x86-64**: así la libc (musl, etapa 7)
;  se porta casi sin tocarla, y un programa estático de Linux que solo use
;  estas corre tal cual. Las que hay en la etapa 4:
;    0 read, 1 write, 2 open, 3 close, 8 lseek, 9 mmap, 10 mprotect,
;    11 munmap, 12 brk, 16 ioctl (-ENOTTY), 20 writev, 24 sched_yield,
;    35 nanosleep, 39 getpid, 60 exit, 63 uname, 102/104/107/108 getuid y
;    compañía (0), 158 arch_prctl (FS y GS), 186 gettid, 218 set_tid_address,
;    228 clock_gettime, 231 exit_group, 257 openat;
;  las demás, -ENOSYS (y se dicen las tres primeras de cada programa).
;  Todo puntero del programa se comprueba (Procesos.copia_de, copia_a,
;  texto_de: cada página, suya y con permiso): uno que apunte al núcleo, a nada
;  o a algo de solo leer cuando se va a escribir da -EFAULT, nunca un fallo
;  del núcleo. Los archivos: la consola (0, 1, 2; leer da 0: la entrada llega
;  en la etapa 6) y los de la unidad en memoria (Unidad64), de solo leer.
;  Lo que el programa escribe en la consola, si viene en UTF-8 (lo de Linux), se
;  pasa a la página 437 (la de la consola); lo que no es UTF-8 (lo de Castel,
;  que ya escribe en 437) va tal cual.
;  [etapa 6] La consola es una terminal (Tty64): read de la consola espera
;  una línea (o lo que pida el modo crudo); ioctl de terminal (TCGETS, TCSETS,
;  TIOCGWINSZ, TIOCGPGRP...); /dev/tty y /dev/console se pueden abrir. Y las
;  llamadas nuevas: 7 poll, 13 rt_sigaction y 14 rt_sigprocmask (lo mínimo:
;  SIG_IGN y SIG_DFL), 23 select, 56 clone (solo como fork), 57 fork, 58
;  vfork (como fork), 59 execve, 61 wait4, 109 setpgid, 110 getppid, 111
;  getpgrp, 112 setsid, 121 getpgid, 124 getsid, 270 pselect6, 271 ppoll;
;  O_CLOEXEC (open, dup3, fcntl) se cierra en execve.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Sistema

    importar Cifras64, Es64, Cerrojo, Fisica64, Pagina64, Monton64, PorCpu64, Excep64, Reloj64, Hilos64, Entradas, Espacios, Unidad64, Procesos, Vfs64, Tty64

    constante EPERM = -1
    constante ENOENT = -2
    constante EBADF = -9
    constante ENOMEM = -12
    constante EFAULT = -14
    constante ENODEV = -19
    constante ENOTDIR = -20
    constante EISDIR = -21
    constante EINVAL = -22
    constante EMFILE = -24
    constante ENOTTY = -25
    constante ESPIPE = -29
    constante EROFS = -30
    constante ENOSYS = -38
    constante LARGO_RUTA = 1024
    constante ENAMETOOLONG = -36
    constante O_CLOEXEC = 0x80000
    constante EINTR = -4
    constante ECHILD = -10
    constante TROZO = 16384                     ; lo que se copia de una vez (read, write, getdents64)

    público variable llamadas: nat64            ; cuántas se han atendido
    variable época: nat64                       ; los segundos de Unix al arrancar
    variable época_ns: nat64                    ; ahora_ns() entonces

    función l64(d: nat64): nat64
        variable p: puntero a nat64
        p := puntero(d)
        devolver valor(p)
    fin

    función p64(d: nat64, v: nat64)
        variable p: puntero a nat64
        p := puntero(d)
        valor(p) := v
    fin

    ; ¿es fd un archivo abierto del programa?
    función fd_bien(p: puntero a Proceso, fd: nat64): bool
        si fd >= MAX_FD entonces devolver falso fin
        devolver p.fd_clase[nat32(fd)] <> 0
    fin

    ; ---- la consola [etapa 6: Tty64, que pasa lo de UTF-8 a la página 437] ----
    ; write a la consola: n octetos desde v (del programa), de 512 en 512
    función escribe_consola(p: puntero a Proceso, v: nat64, n: nat64): ent64
        variable t: arreglo [512] de byte
        variable hecho, trozo, b: nat64
        hecho := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > 512 entonces trozo := 512 fin
            si no copia_de(p, nat64(dirección(t[0])), v + hecho, trozo) entonces
                si hecho = 0 entonces devolver EFAULT fin
                devolver ent64(hecho)
            fin
            tty_escribe(dirección(t[0]), nat32(trozo))
            hecho := hecho + trozo
        fin
        devolver ent64(hecho)
    fin

    ; ---- los archivos [etapa 5: por el VFS] ----
    función abierto(p: puntero a Proceso, fd: nat64): puntero a Abierto
        devolver puntero(p.fd_obj[nat32(fd)])
    fin

    ; el primer descriptor libre desde «desde», o -1
    función fd_libre(p: puntero a Proceso, mínimo_: nat32): ent32
        variable fd: nat32
        fd := mínimo_
        mientras fd < MAX_FD y p.fd_clase[fd] <> 0 hacer fd := fd + 1 fin
        si fd >= MAX_FD entonces devolver -1 fin
        devolver ent32(fd)
    fin

    ; una ruta del programa, a un bloque del montón (lo suelta quien llama); nulo y el error
    función ruta_de(p: puntero a Proceso, v: nat64, ref err: ent64): puntero a byte
        variable t: puntero a byte
        variable r: ent64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces
            err := ENOMEM
            devolver nulo
        fin
        r := texto_de(p, t, v, LARGO_RUTA)
        si r < 0 entonces
            libera(t)
            err := r
            devolver nulo
        fin
        err := 0
        devolver t
    fin

    ; la carpeta desde la que se ve una ruta de un «...at»: la actual
    ; (AT_FDCWD, -100) o la de un descriptor que sea una carpeta
    función base_de(p: puntero a Proceso, dirfd: ent64, ref err: ent64): puntero a byte
        err := 0
        si dirfd = -100 entonces devolver dirección(p.dir_actual[0]) fin
        si dirfd < 0 entonces
            err := EBADF
            devolver nulo
        fin
        si no fd_bien(p, nat64(dirfd)) entonces
            err := EBADF
            devolver nulo
        fin
        si p.fd_clase[nat32(dirfd)] <> F_ARCHIVO entonces
            err := ENOTDIR
            devolver nulo
        fin
        si no vfs_es_carpeta(abierto(p, nat64(dirfd))) entonces
            err := ENOTDIR
            devolver nulo
        fin
        devolver vfs_ruta(abierto(p, nat64(dirfd)))
    fin

    ; read y pread (pos: -1, la del archivo)
    función lee(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64, pos: ent64): ent64
        variable k: nat64
        variable hecho, trozo: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver tty_lee(p, v, n)
        fin
        si n = 0 entonces devolver 0 fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        hecho := 0
        r := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > TROZO entonces trozo := TROZO fin
            si pos < 0 entonces r := vfs_lee(abierto(p, fd), -1, k, trozo) sino r := vfs_lee(abierto(p, fd), pos + ent64(hecho), k, trozo) fin
            si r <= 0 entonces romper fin
            si no copia_a(p, v + hecho, k, nat64(r)) entonces
                r := EFAULT
                romper
            fin
            hecho := hecho + nat64(r)
            si nat64(r) < trozo entonces romper fin
        fin
        libera(puntero(k))
        si hecho = 0 y r < 0 entonces devolver r fin
        devolver ent64(hecho)
    fin

    ; write y pwrite
    función escribe(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64, pos: ent64): ent64
        variable k: nat64
        variable hecho, trozo: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si pos >= 0 entonces devolver ESPIPE fin
            si n = 0 entonces devolver 0 fin
            devolver escribe_consola(p, v, n)
        fin
        si n = 0 entonces devolver 0 fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        hecho := 0
        r := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > TROZO entonces trozo := TROZO fin
            si no copia_de(p, k, v + hecho, trozo) entonces
                r := EFAULT
                romper
            fin
            si pos < 0 entonces r := vfs_escribe(abierto(p, fd), -1, k, trozo) sino r := vfs_escribe(abierto(p, fd), pos + ent64(hecho), k, trozo) fin
            si r <= 0 entonces romper fin
            hecho := hecho + nat64(r)
            si nat64(r) < trozo entonces romper fin
        fin
        libera(puntero(k))
        si hecho = 0 y r < 0 entonces devolver r fin
        devolver ent64(hecho)
    fin

    ; readv y writev
    función vectores(p: puntero a Proceso, fd: nat64, iov: nat64, cuántos: nat64, escribir_: bool): ent64
        variable par: arreglo [2] de nat64
        variable i: nat64
        variable total, r: ent64
        si cuántos > 1024 entonces devolver EINVAL fin
        si no fd_bien(p, fd) entonces devolver EBADF fin
        total := 0
        i := 0
        mientras i < cuántos hacer
            si no copia_de(p, nat64(dirección(par[0])), iov + i * 16, 16) entonces
                si total = 0 entonces devolver EFAULT fin
                devolver total
            fin
            si escribir_ entonces r := escribe(p, fd, par[0], par[1], -1) sino r := lee(p, fd, par[0], par[1], -1) fin
            si r < 0 entonces
                si total = 0 entonces devolver r fin
                devolver total
            fin
            total := total + r
            si nat64(r) < par[1] entonces devolver total fin
            i := i + 1
        fin
        devolver total
    fin

    ; [etapa 6] ¿es la ruta la de la consola?
    función mismo(a: puntero a byte, b: puntero a byte): bool
        variable i: nat32
        i := 0
        mientras a[i] <> 0 y a[i] = b[i] hacer i := i + 1 fin
        devolver a[i] = b[i]
    fin

    función es_consola(t: puntero a byte): bool
        devolver mismo(t, "/dev/tty") o mismo(t, "/dev/console") o mismo(t, "/dev/tty0") o mismo(t, "/dev/stdin") o mismo(t, "/dev/stdout") o mismo(t, "/dev/stderr")
    fin

    función abre(p: puntero a Proceso, dirfd: ent64, ruta: nat64, marcas_: nat64): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable fd: ent32
        variable a: puntero a Abierto
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        ; [etapa 6] la consola: /dev/tty y /dev/console
        si es_consola(t) entonces
            libera(t)
            fd := fd_libre(p, 0)
            si fd < 0 entonces devolver EMFILE fin
            p.fd_clase[nat32(fd)] := F_CONSOLA
            p.fd_obj[nat32(fd)] := 0
            si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
            devolver ent64(fd)
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        fd := fd_libre(p, 0)
        si fd < 0 entonces
            libera(t)
            devolver EMFILE
        fin
        si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
        a := vfs_abre(base, t, marcas_ yb (nob nat64(O_CLOEXEC)), err)
        libera(t)
        si a = nulo entonces devolver err fin
        p.fd_clase[nat32(fd)] := F_ARCHIVO
        p.fd_obj[nat32(fd)] := nat64(a)
        devolver ent64(fd)
    fin

    función cierra(p: puntero a Proceso, fd: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_ARCHIVO entonces vfs_cierra(abierto(p, fd)) fin
        p.fd_clase[nat32(fd)] := 0
        p.fd_obj[nat32(fd)] := 0
        p.fd_cloexec[nat32(fd)] := 0
        devolver 0
    fin

    ; dup, dup2, dup3 y fcntl(F_DUPFD): a «a» (o al primero libre desde «desde»)
    función duplica(p: puntero a Proceso, fd: nat64, a: ent64, mínimo_: nat32): ent64
        variable n: ent32
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si a >= 0 entonces
            si a >= MAX_FD entonces devolver EBADF fin
            si nat64(a) = fd entonces devolver a fin
            si fd_bien(p, nat64(a)) entonces cierra(p, nat64(a)) fin
            n := ent32(a)
        sino
            n := fd_libre(p, mínimo_)
            si n < 0 entonces devolver EMFILE fin
        fin
        p.fd_clase[nat32(n)] := p.fd_clase[nat32(fd)]
        p.fd_obj[nat32(n)] := p.fd_obj[nat32(fd)]
        p.fd_cloexec[nat32(n)] := 0
        si p.fd_clase[nat32(n)] = F_ARCHIVO entonces vfs_otro(abierto(p, fd)) fin
        devolver ent64(n)
    fin

    ; (dup3 y F_DUPFD_CLOEXEC) el descriptor nuevo, con FD_CLOEXEC
    función con_cloexec(p: puntero a Proceso, r: ent64): ent64
        si r >= 0 entonces p.fd_cloexec[nat32(r)] := 1 fin
        devolver r
    fin

    función fcntl_(p: puntero a Proceso, fd: nat64, orden: nat64, arg: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si orden = 0 entonces devolver duplica(p, fd, -1, nat32(arg)) fin               ; F_DUPFD
        si orden = 1030 entonces devolver con_cloexec(p, duplica(p, fd, -1, nat32(arg))) fin      ; F_DUPFD_CLOEXEC
        si orden = 1 entonces devolver ent64(p.fd_cloexec[nat32(fd)]) fin                ; F_GETFD
        si orden = 2 entonces                                                            ; F_SETFD
            p.fd_cloexec[nat32(fd)] := nat32(arg yb 1)
            devolver 0
        fin
        si orden = 4 entonces devolver 0 fin                                             ; F_SETFL
        si orden = 3 entonces                                                            ; F_GETFL
            si p.fd_clase[nat32(fd)] = F_CONSOLA entonces devolver 2 fin
            devolver ent64(abierto(p, fd).marcas yb 0x403)
        fin
        devolver EINVAL
    fin

    función sitúa(p: puntero a Proceso, fd: nat64, d: ent64, de_dónde: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces devolver ESPIPE fin
        devolver vfs_sitúa(abierto(p, fd), d, de_dónde)
    fin

    ; la «struct stat» (144 octetos) de la consola
    función stat_consola(k: nat64)
        variable i: nat32
        i := 0
        mientras i < 144 hacer
            pon_m8(k + i, 0)
            i := i + 1
        fin
        pon_m64(k + 16, 1)
        pon_m32(k + 24, 0x2000 ob 0x1B6)        ; S_IFCHR, 0666
        pon_m64(k + 40, 0x8801)                 ; (como /dev/pts/1)
        pon_m64(k + 56, 1024)
    fin

    función fstat_(p: puntero a Proceso, fd: nat64, v: nat64): ent64
        variable st: arreglo [18] de nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            stat_consola(nat64(dirección(st[0])))
            r := 0
        sino
            r := vfs_fstat(abierto(p, fd), nat64(dirección(st[0])))
        fin
        si r < 0 entonces devolver r fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    ; stat, lstat y newfstatat (con AT_EMPTY_PATH y la ruta vacía: el del descriptor)
    función stat_(p: puntero a Proceso, dirfd: ent64, ruta: nat64, v: nat64, marcas_: nat64): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable st: arreglo [18] de nat64
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        si es_consola(t) entonces
            libera(t)
            stat_consola(nat64(dirección(st[0])))
            si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
            devolver 0
        fin
        si t[0] = 0 entonces
            libera(t)
            si marcas_ yb 0x1000 = 0 entonces devolver ENOENT fin
            si dirfd = -100 entonces devolver stat_ruta(p, dirección(p.dir_actual[0]), v) fin
            si dirfd < 0 entonces devolver EBADF fin
            devolver fstat_(p, nat64(dirfd), v)
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        err := vfs_stat(base, t, nat64(dirección(st[0])))
        libera(t)
        si err < 0 entonces devolver err fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    función stat_ruta(p: puntero a Proceso, t: puntero a byte, v: nat64): ent64
        variable st: arreglo [18] de nat64
        variable err: ent64
        err := vfs_stat(nulo, t, nat64(dirección(st[0])))
        si err < 0 entonces devolver err fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    función lista_(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64): ent64
        variable k: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver ENOTDIR fin
        si n > TROZO entonces n := TROZO fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        r := vfs_lista(abierto(p, fd), k, n)
        si r > 0 entonces
            si no copia_a(p, v, k, nat64(r)) entonces r := EFAULT fin
        fin
        libera(puntero(k))
        devolver r
    fin

    ; mkdir (0), unlink (1), rmdir (2) y access (3), desde dirfd
    función con_ruta(p: puntero a Proceso, dirfd: ent64, ruta: nat64, qué: nat32): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable st: arreglo [18] de nat64
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        si t[0] = 0 entonces
            libera(t)
            devolver ENOENT
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        si qué = 0 entonces err := vfs_mkdir(base, t)
        sino si qué = 1 entonces err := vfs_borra(base, t, falso)
        sino si qué = 2 entonces err := vfs_borra(base, t, cierto)
        sino err := vfs_stat(base, t, nat64(dirección(st[0])))
        fin
        libera(t)
        devolver err
    fin

    función renombra_(p: puntero a Proceso, dirfd1: ent64, ruta1: nat64, dirfd2: ent64, ruta2: nat64): ent64
        variable t1, t2, b1, b2: puntero a byte
        variable err: ent64
        t1 := ruta_de(p, ruta1, err)
        si t1 = nulo entonces devolver err fin
        t2 := ruta_de(p, ruta2, err)
        si t2 = nulo entonces
            libera(t1)
            devolver err
        fin
        b1 := nulo
        b2 := nulo
        si t1[0] <> '/' entonces b1 := base_de(p, dirfd1, err) fin
        si err = 0 y t2[0] <> '/' entonces b2 := base_de(p, dirfd2, err) fin
        si err = 0 y (t1[0] = 0 o t2[0] = 0) entonces err := ENOENT fin
        si err = 0 entonces err := vfs_renombra(b1, t1, b2, t2) fin
        libera(t1)
        libera(t2)
        devolver err
    fin

    función trunca_(p: puntero a Proceso, fd: nat64, t: ent64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si t < 0 entonces devolver EINVAL fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver EINVAL fin
        devolver vfs_trunca(abierto(p, fd), nat64(t))
    fin

    ; truncate(ruta, tamaño): abre, acorta y cierra
    función trunca_ruta(p: puntero a Proceso, ruta: nat64, t: ent64): ent64
        variable fd, r: ent64
        fd := abre(p, -100, ruta, 1)
        si fd < 0 entonces devolver fd fin
        r := trunca_(p, nat64(fd), t)
        cierra(p, nat64(fd))
        devolver r
    fin

    función fsync_(p: puntero a Proceso, fd: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces devolver EINVAL fin
        devolver vfs_fsync(abierto(p, fd))
    fin

    función getcwd_(p: puntero a Proceso, v: nat64, n: nat64): ent64
        variable l: nat64
        l := 0
        mientras p.dir_actual[nat32(l)] <> 0 hacer l := l + 1 fin
        l := l + 1
        si n < l entonces devolver -34 fin                     ; ERANGE
        si no copia_a(p, v, nat64(dirección(p.dir_actual[0])), l) entonces devolver EFAULT fin
        devolver ent64(l)
    fin

    ; chdir (fd < 0) y fchdir
    función chdir_(p: puntero a Proceso, ruta: nat64, fd: ent64): ent64
        variable t, base, nueva: puntero a byte
        variable err: ent64
        variable i: nat32
        nueva := reserva(LARGO_RUTA)
        si nueva = nulo entonces devolver ENOMEM fin
        si fd >= 0 entonces
            base := base_de(p, fd, err)
            si base = nulo entonces
                libera(nueva)
                devolver err
            fin
            err := vfs_carpeta(nulo, base, nueva)
        sino
            t := ruta_de(p, ruta, err)
            si t = nulo entonces
                libera(nueva)
                devolver err
            fin
            si t[0] = 0 entonces err := ENOENT sino err := vfs_carpeta(dirección(p.dir_actual[0]), t, nueva) fin
            libera(t)
        fin
        si err = 0 entonces
            i := 0
            mientras nueva[i] <> 0 hacer i := i + 1 fin
            si i > 255 entonces err := ENAMETOOLONG fin
        fin
        si err = 0 entonces
            i := 0
            mientras nueva[i] <> 0 hacer
                p.dir_actual[i] := nueva[i]
                i := i + 1
            fin
            p.dir_actual[i] := 0
        fin
        libera(nueva)
        devolver err
    fin

    ; ---- la memoria ----
    función mapea_(p: puntero a Proceso, dir_: nat64, largo: nat64, prot: nat64, marcas_: nat64, fd: ent64): ent64
        variable a, l: nat64
        si largo = 0 o prot yb (nob nat64(7)) <> 0 entonces devolver EINVAL fin
        si marcas_ yb 3 <> 1 y marcas_ yb 3 <> 2 entonces devolver EINVAL fin
        ; (de un archivo: etapa 7; como Linux, -EBADF si no está abierto)
        si marcas_ yb 0x20 = 0 entonces
            si fd < 0 entonces devolver EBADF fin
            si no fd_bien(p, nat64(fd)) entonces devolver EBADF fin
            devolver ENODEV
        fin
        l := arriba(largo)
        si l < largo o l > nat64(1) << 40 entonces devolver ENOMEM fin
        si marcas_ yb 0x10 <> 0 entonces
            ; MAP_FIXED: ahí, quitando lo que hubiese
            si dir_ yb 4095 <> 0 entonces devolver EINVAL fin
            si dir_ < MÍNIMO entonces devolver EPERM fin
            si dir_ + l < dir_ o dir_ + l > TOPE entonces devolver ENOMEM fin
            si no quita_de(p, dir_, dir_ + l) entonces devolver ENOMEM fin
            si no pon_región(p, dir_, dir_ + l, nat32(prot), R_MMAP) entonces devolver ENOMEM fin
            devolver ent64(dir_)
        fin
        a := 0
        ; la pista, si está libre
        si dir_ >= MÍNIMO y dir_ yb 4095 = 0 y dir_ + l > dir_ y dir_ + l <= TOPE entonces
            si hueco(p, l, dir_, dir_ + l) = dir_ entonces a := dir_ fin
        fin
        si a = 0 y marcas_ yb 0x40 <> 0 entonces a := hueco(p, l, 0x40000000, 0x80000000) fin    ; MAP_32BIT
        si a = 0 y marcas_ yb 0x40 = 0 entonces
            a := hueco(p, l, p.mmap_próx, TOPE - PILA_PROG)
            si a = 0 entonces a := hueco(p, l, nat64(0x1000) << 32, TOPE - PILA_PROG) fin
        fin
        si a = 0 entonces devolver ENOMEM fin
        si no pon_región(p, a, a + l, nat32(prot), R_MMAP) entonces devolver ENOMEM fin
        si marcas_ yb 0x40 = 0 entonces p.mmap_próx := a + l fin
        devolver ent64(a)
    fin

    función desmapea_(p: puntero a Proceso, dir_: nat64, largo: nat64): ent64
        variable l: nat64
        si dir_ yb 4095 <> 0 o largo = 0 entonces devolver EINVAL fin
        l := arriba(largo)
        si l < largo o dir_ + l < dir_ o dir_ + l > TOPE entonces devolver EINVAL fin
        si no quita_de(p, dir_, dir_ + l) entonces devolver ENOMEM fin
        devolver 0
    fin

    función protege_(p: puntero a Proceso, dir_: nat64, largo: nat64, prot: nat64): ent64
        variable l: nat64
        si dir_ yb 4095 <> 0 o prot yb (nob nat64(7)) <> 0 entonces devolver EINVAL fin
        si largo = 0 entonces devolver 0 fin
        l := arriba(largo)
        si l < largo o dir_ + l < dir_ o dir_ + l > TOPE entonces devolver ENOMEM fin
        devolver protege(p, dir_, dir_ + l, nat32(prot))
    fin

    ; brk: lo nuevo, o lo de antes si no se puede (como Linux)
    función brk_(p: puntero a Proceso, nuevo: nat64): ent64
        variable viejo_fin, nuevo_fin: nat64
        variable i: nat32
        variable hecho: bool
        si nuevo < p.brk_ini o nuevo - p.brk_ini > nat64(1) << 30 entonces devolver ent64(p.brk) fin
        viejo_fin := arriba(p.brk)
        nuevo_fin := arriba(nuevo)
        si nuevo_fin > viejo_fin entonces
            si hueco(p, nuevo_fin - viejo_fin, viejo_fin, nuevo_fin) <> viejo_fin entonces devolver ent64(p.brk) fin
            ; (se alarga la región del montón, si la hay; si no, una nueva)
            hecho := falso
            i := 0
            mientras nat64(i) < p.n_reg hacer
                si p.reg_clase[i] = R_MONTÓN y p.reg_fin[i] = viejo_fin entonces
                    p.reg_fin[i] := nuevo_fin
                    hecho := cierto
                fin
                i := i + 1
            fin
            si no hecho entonces
                si no pon_región(p, viejo_fin, nuevo_fin, LEER ob ESCRIBE, R_MONTÓN) entonces devolver ent64(p.brk) fin
            fin
        sino si nuevo_fin < viejo_fin entonces
            si no quita_de(p, nuevo_fin, viejo_fin) entonces devolver ent64(p.brk) fin
        fin
        p.brk := nuevo
        devolver ent64(nuevo)
    fin

    ; ---- el tiempo ----
    función reloj(p: puntero a Proceso, cuál: nat64, v: nat64): ent64
        variable ts: arreglo [2] de nat64
        variable ns: nat64
        ns := ahora_ns()
        según cuál
            caso 0, 5: ns := época * 1000000000 + (ns - época_ns)      ; REALTIME, REALTIME_COARSE
            caso 1, 4, 6, 7: ns := ns                                   ; MONOTONIC, _RAW, _COARSE, BOOTTIME
            si no: devolver EINVAL
        fin
        ts[0] := ns div 1000000000
        ts[1] := ns mod 1000000000
        si no copia_a(p, v, nat64(dirección(ts[0])), 16) entonces devolver EFAULT fin
        devolver 0
    fin

    función duerme_(p: puntero a Proceso, v: nat64): ent64
        variable ts: arreglo [2] de nat64
        si no copia_de(p, nat64(dirección(ts[0])), v, 16) entonces devolver EFAULT fin
        si ts[0] >= nat64(1) << 62 o ts[1] >= 1000000000 entonces devolver EINVAL fin
        si ts[0] > 1000000 entonces ts[0] := 1000000 fin
        duerme_ns(ts[0] * 1000000000 + ts[1])
        devolver 0
    fin

    ; ---- lo demás ----
    función pon_texto(t: puntero a byte, en: nat32, s: puntero a byte)
        variable i: nat32
        i := 0
        mientras s[i] <> 0 hacer
            t[en + i] := s[i]
            i := i + 1
        fin
    fin

    función nombre_(p: puntero a Proceso, v: nat64): ent64
        variable t: arreglo [390] de byte
        variable i: nat32
        i := 0
        mientras i < 390 hacer
            t[i] := 0
            i := i + 1
        fin
        pon_texto(dirección(t[0]), 0, "Hispa-64")
        pon_texto(dirección(t[0]), 65, "hispa64")
        pon_texto(dirección(t[0]), 130, "0.6.0")
        pon_texto(dirección(t[0]), 195, "etapa 6 (la entrada y el intérprete)")
        pon_texto(dirección(t[0]), 260, "x86_64")
        pon_texto(dirección(t[0]), 325, "(none)")
        si no copia_a(p, v, nat64(dirección(t[0])), 390) entonces devolver EFAULT fin
        devolver 0
    fin

    función arch_(p: puntero a Proceso, qué: nat64, v: nat64): ent64
        variable h: puntero a Hilo
        variable b, x: nat64
        h := actual()
        según qué
            caso 0x1002, 0x1001:
                si v >= nat64(0x8000) << 32 entonces devolver EPERM fin
                b := sin_ints()
                si qué = 0x1002 entonces
                    pon_msr(0xC0000100, v)
                    h.fs_u := v
                sino
                    pon_msr(0xC0000102, v)          ; (el GS del programa, mientras se está en el núcleo)
                    h.gs_u := v
                fin
                restaura(b)
                devolver 0
            caso 0x1003, 0x1004:
                b := sin_ints()
                si qué = 0x1003 entonces x := lee_msr(0xC0000100) sino x := lee_msr(0xC0000102) fin
                restaura(b)
                si no copia_a(p, v, nat64(dirección(x)), 8) entonces devolver EFAULT fin
                devolver 0
            si no: devolver EINVAL
        fin
    fin

    ; ---- [etapa 6] poll y select ----
    ; lo que está listo de fd de lo pedido en ev (las marcas de poll: POLLIN 1,
    ; POLLOUT 4, POLLRDNORM 0x40, POLLWRNORM 0x100; POLLNVAL 0x20 si no está abierto)
    función listo_de(p: puntero a Proceso, fd: ent64, ev: nat32): nat32
        si fd < 0 entonces devolver 0 fin
        si no fd_bien(p, nat64(fd)) entonces devolver 0x20 fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si hay_datos() entonces devolver ev yb 0x145 fin
            devolver ev yb 0x104
        fin
        ; (los archivos, siempre listos)
        devolver ev yb 0x145
    fin

    ; duerme hasta «límite» (ns de ahora_ns; nob 0: sin límite) o hasta que la
    ; consola tenga algo (si se mira)
    función espera_hasta(p: puntero a Proceso, límite: nat64, mira_consola: bool)
        variable ahora, d: nat64
        si mira_consola entonces
            espera_datos(p, límite)
            devolver
        fin
        ahora := ahora_ns()
        si ahora >= límite entonces devolver fin
        d := límite - ahora
        si d > 1000000000 entonces d := 1000000000 fin
        duerme_ns(d)
    fin

    ; el límite de un plazo en ms (negativo: sin límite)
    función límite_ms(ms: ent64): nat64
        si ms < 0 entonces devolver nob nat64(0) fin
        devolver ahora_ns() + nat64(ms) * 1000000
    fin

    ; el límite de un timespec (s, ns) o timeval (s, µs: escala 1000) del programa; 0: sin límite
    función límite_de(p: puntero a Proceso, v: nat64, escala: nat64, ref err: ent64): nat64
        variable ts: arreglo [2] de nat64
        err := 0
        si v = 0 entonces devolver nob nat64(0) fin
        si no copia_de(p, nat64(dirección(ts[0])), v, 16) entonces
            err := EFAULT
            devolver 0
        fin
        si ent64(ts[0]) < 0 o ts[1] * escala >= 1000000000 entonces
            err := EINVAL
            devolver 0
        fin
        si ts[0] > 1000000 entonces ts[0] := 1000000 fin
        devolver ahora_ns() + ts[0] * 1000000000 + ts[1] * escala
    fin

    ; poll y ppoll
    función sondea(p: puntero a Proceso, v: nat64, n: nat64, límite: nat64): ent64
        variable fds: arreglo [64] de nat64
        variable i: nat32
        variable listos: ent64
        variable fd: ent64
        variable ev, rev: nat32
        variable consola: bool
        si n > 64 entonces devolver EINVAL fin
        si n > 0 entonces
            si no copia_de(p, nat64(dirección(fds[0])), v, n * 8) entonces devolver EFAULT fin
        fin
        mientras cierto hacer
            listos := 0
            consola := falso
            i := 0
            mientras nat64(i) < n hacer
                fd := ent64(ent32(nat32(fds[i] yb 0xFFFFFFFF)))
                ev := nat32((fds[i] >> 32) yb 0xFFFF)
                rev := listo_de(p, fd, ev)
                si fd >= 0 y rev = 0 y fd_bien(p, nat64(fd)) entonces
                    si p.fd_clase[nat32(fd)] = F_CONSOLA y ev yb 0x41 <> 0 entonces consola := cierto fin
                fin
                fds[i] := (fds[i] yb 0xFFFFFFFF) ob ((nat64(ev) yb 0xFFFF) << 32) ob (nat64(rev) << 48)
                si rev <> 0 entonces listos := listos + 1 fin
                i := i + 1
            fin
            si listos > 0 o ahora_ns() >= límite o p.matar <> 0 entonces romper fin
            espera_hasta(p, límite, consola)
        fin
        si n > 0 entonces
            si no copia_a(p, v, nat64(dirección(fds[0])), n * 8) entonces devolver EFAULT fin
        fin
        si listos = 0 y p.matar <> 0 entonces devolver EINTR fin
        devolver listos
    fin

    ; select y pselect6 (los descriptores hasta MAX_FD)
    función selecciona(p: puntero a Proceso, n: nat64, vr: nat64, vw: nat64, ve: nat64, límite: nat64): ent64
        variable r, w, e, rr, ww: nat64
        variable largo: nat64
        variable i: nat32
        variable listos: ent64
        variable consola: bool
        si n > 1024 entonces devolver EINVAL fin
        largo := ((n + 63) div 64) * 8
        si largo > 8 entonces largo := 8 fin
        r := 0
        w := 0
        e := 0
        si largo > 0 entonces
            si vr <> 0 entonces
                si no copia_de(p, nat64(dirección(r)), vr, largo) entonces devolver EFAULT fin
            fin
            si vw <> 0 entonces
                si no copia_de(p, nat64(dirección(w)), vw, largo) entonces devolver EFAULT fin
            fin
            si ve <> 0 entonces
                si no copia_de(p, nat64(dirección(e)), ve, largo) entonces devolver EFAULT fin
            fin
        fin
        si n < 64 entonces
            r := r yb ((nat64(1) << n) - 1)
            w := w yb ((nat64(1) << n) - 1)
            e := e yb ((nat64(1) << n) - 1)
        fin
        i := 0
        mientras i < 64 hacer
            si (r ob w ob e) yb (nat64(1) << i) <> 0 entonces
                si no fd_bien(p, nat64(i)) entonces devolver EBADF fin
            fin
            i := i + 1
        fin
        mientras cierto hacer
            listos := 0
            rr := 0
            ww := 0
            consola := falso
            i := 0
            mientras i < MAX_FD hacer
                si r yb (nat64(1) << i) <> 0 entonces
                    si listo_de(p, ent64(i), 1) <> 0 entonces
                        rr := rr ob (nat64(1) << i)
                        listos := listos + 1
                    sino
                        consola := cierto
                    fin
                fin
                si w yb (nat64(1) << i) <> 0 entonces
                    ww := ww ob (nat64(1) << i)
                    listos := listos + 1
                fin
                i := i + 1
            fin
            si listos > 0 o ahora_ns() >= límite o p.matar <> 0 entonces romper fin
            espera_hasta(p, límite, consola)
        fin
        e := 0
        si largo > 0 entonces
            si vr <> 0 entonces
                si no copia_a(p, vr, nat64(dirección(rr)), largo) entonces devolver EFAULT fin
            fin
            si vw <> 0 entonces
                si no copia_a(p, vw, nat64(dirección(ww)), largo) entonces devolver EFAULT fin
            fin
            si ve <> 0 entonces
                si no copia_a(p, ve, nat64(dirección(e)), largo) entonces devolver EFAULT fin
            fin
        fin
        si listos = 0 y p.matar <> 0 entonces devolver EINTR fin
        devolver listos
    fin

    ; ---- [etapa 6] las señales, lo mínimo (las de verdad, con musl: etapa 7) ----
    ; rt_sigaction: se guarda lo de cada una (SIG_DFL 0, SIG_IGN 1 o una
    ; función, que aún no se llama); SIGKILL y SIGSTOP no se pueden cambiar
    función sigaction_(p: puntero a Proceso, sig: nat64, v_act: nat64, v_viejo: nat64, tam: nat64): ent64
        variable act: arreglo [4] de nat64
        si sig < 1 o sig > 64 entonces devolver EINVAL fin
        si tam <> 8 entonces devolver EINVAL fin
        si v_viejo <> 0 entonces
            act[0] := p.acción[nat32(sig)]
            act[1] := 0
            act[2] := 0
            act[3] := 0
            si no copia_a(p, v_viejo, nat64(dirección(act[0])), 32) entonces devolver EFAULT fin
        fin
        si v_act <> 0 entonces
            si sig = 9 o sig = 19 entonces devolver EINVAL fin
            si no copia_de(p, nat64(dirección(act[0])), v_act, 32) entonces devolver EFAULT fin
            p.acción[nat32(sig)] := act[0]
        fin
        devolver 0
    fin

    función sigprocmask_(p: puntero a Proceso, v_viejo: nat64, tam: nat64): ent64
        variable x: nat64
        si tam <> 8 entonces devolver EINVAL fin
        x := 0
        si v_viejo <> 0 entonces
            si no copia_a(p, v_viejo, nat64(dirección(x)), 8) entonces devolver EFAULT fin
        fin
        devolver 0
    fin

    ; clone: solo como fork (SIGCHLD, y como mucho CLONE_CHILD_SETTID y
    ; CLONE_CHILD_CLEARTID, sin pila); los hilos de POSIX, con musl (etapa 7)
    función clone_(p: puntero a Proceso, m: nat64, marcas_: nat64, pila: nat64): ent64
        si pila <> 0 o marcas_ yb (nob nat64(0x01200000 ob 0xFF)) <> 0 entonces devolver EINVAL fin
        devolver bifurca(p, m)
    fin

    función setpgid_(p: puntero a Proceso, pid: nat64, g: nat64): ent64
        si pid <> 0 y pid <> p.id entonces devolver -3 fin          ; ESRCH (solo el suyo, por ahora)
        si ent64(g) < 0 entonces devolver EINVAL fin
        si g = 0 entonces g := p.id fin
        p.grupo := g
        devolver 0
    fin

    función desconocida(p: puntero a Proceso, n: nat64): ent64
        variable b: nat64
        p.desconocidas := p.desconocidas + 1
        si p.desconocidas <= 3 entonces
            b := toma_atento(dirección(cerrojo_consola))
            escribir("El programa ", p.nombre, " (proceso ", p.id, ") ha pedido la llamada al sistema ", n, ", que Hispa-64 aún no tiene (devuelve -ENOSYS).\n")
            suelta(dirección(cerrojo_consola), b)
        fin
        devolver ENOSYS
    fin

    ; la llamada del marco m (Entradas): el resultado, en su RAX
    función atiende(m: nat64)
        variable p: puntero a Proceso
        variable n, a1, a2, a3, a4, a5, lím: nat64
        variable r: ent64
        p := mío()
        n := l64(m + 112)
        a1 := l64(m + 64)
        a2 := l64(m + 72)
        a3 := l64(m + 96)
        a4 := l64(m + 40)
        a5 := l64(m + 56)
        llamadas := llamadas + 1
        según n
            caso 0: r := lee(p, a1, a2, a3, -1)
            caso 1: r := escribe(p, a1, a2, a3, -1)
            caso 2: r := abre(p, -100, a1, a2)
            caso 3: r := cierra(p, a1)
            caso 4, 6: r := stat_(p, -100, a1, a2, 0)
            caso 5: r := fstat_(p, a1, a2)
            caso 8: r := sitúa(p, a1, ent64(a2), a3)
            caso 9: r := mapea_(p, a1, a2, a3, a4, ent64(a5))
            caso 10: r := protege_(p, a1, a2, a3)
            caso 11: r := desmapea_(p, a1, a2)
            caso 12: r := brk_(p, a1)
            caso 7: r := sondea(p, a1, a2, límite_ms(ent64(ent32(nat32(a3 yb 0xFFFFFFFF)))))
            caso 13: r := sigaction_(p, a1, a2, a3, a4)
            caso 14: r := sigprocmask_(p, a3, a4)
            caso 16:
                si no fd_bien(p, a1) entonces
                    r := EBADF
                sino si p.fd_clase[nat32(a1)] = F_CONSOLA entonces
                    r := tty_ioctl(p, a2 yb 0xFFFFFFFF, a3)
                sino
                    r := ENOTTY
                fin
            caso 23:
                lím := límite_de(p, a5, 1000, r)
                si r = 0 entonces r := selecciona(p, a1, a2, a3, a4, lím) fin
            caso 56: r := clone_(p, m, a1, a2)
            caso 57, 58: r := bifurca(p, m)
            caso 59: r := ejecuta(p, m, a1, a2, a3)
            caso 61: r := espera_hijo(p, ent64(ent32(nat32(a1 yb 0xFFFFFFFF))), a2, a3, a4)
            caso 109: r := setpgid_(p, a1, a2)
            caso 110: r := ent64(p.padre)
            caso 111: r := ent64(p.grupo)
            caso 112:
                p.grupo := p.id
                r := ent64(p.id)
            caso 121, 124:
                si a1 = 0 o a1 = p.id entonces r := ent64(p.grupo) sino r := -3 fin
            caso 270:
                lím := límite_de(p, a5, 1, r)
                si r = 0 entonces r := selecciona(p, a1, a2, a3, a4, lím) fin
            caso 271:
                lím := límite_de(p, a3, 1, r)
                si r = 0 entonces r := sondea(p, a1, a2, lím) fin
            caso 17:
                si ent64(a4) < 0 entonces r := EINVAL sino r := lee(p, a1, a2, a3, ent64(a4)) fin
            caso 18:
                si ent64(a4) < 0 entonces r := EINVAL sino r := escribe(p, a1, a2, a3, ent64(a4)) fin
            caso 19: r := vectores(p, a1, a2, a3, falso)
            caso 20: r := vectores(p, a1, a2, a3, cierto)
            caso 21: r := con_ruta(p, -100, a1, 3)
            caso 24:
                cede()
                r := 0
            caso 32: r := duplica(p, a1, -1, 0)
            caso 33: r := duplica(p, a1, ent64(a2), 0)
            caso 35: r := duerme_(p, a1)
            caso 39, 186: r := ent64(p.id)
            caso 60, 231: sal(a1, 0)
            caso 63: r := nombre_(p, a1)
            caso 72: r := fcntl_(p, a1, a2, a3)
            caso 74, 75: r := fsync_(p, a1)
            caso 76: r := trunca_ruta(p, a1, ent64(a2))
            caso 77: r := trunca_(p, a1, ent64(a2))
            caso 79: r := getcwd_(p, a1, a2)
            caso 80: r := chdir_(p, a1, -1)
            caso 81: r := chdir_(p, 0, ent64(a1))
            caso 82: r := renombra_(p, -100, a1, -100, a2)
            caso 83: r := con_ruta(p, -100, a1, 0)
            caso 84: r := con_ruta(p, -100, a1, 2)
            caso 87: r := con_ruta(p, -100, a1, 1)
            caso 102, 104, 107, 108: r := 0
            caso 158: r := arch_(p, a1, a2)
            caso 162:
                vfs_sync()
                r := 0
            caso 217: r := lista_(p, a1, a2, a3)
            caso 218:
                p.tid_dir := a1
                r := ent64(p.id)
            caso 228: r := reloj(p, a1, a2)
            caso 257: r := abre(p, ent64(a1), a2, a3)
            caso 258: r := con_ruta(p, ent64(a1), a2, 0)
            caso 262: r := stat_(p, ent64(a1), a2, a3, a4)
            caso 263:
                si a3 yb 0x200 <> 0 entonces r := con_ruta(p, ent64(a1), a2, 2) sino r := con_ruta(p, ent64(a1), a2, 1) fin
            caso 264: r := renombra_(p, ent64(a1), a2, ent64(a3), a4)
            caso 269: r := con_ruta(p, ent64(a1), a2, 3)
            caso 292:
                si a1 = a2 entonces
                    r := EINVAL
                sino
                    r := duplica(p, a1, ent64(a2), 0)
                    si a3 yb O_CLOEXEC <> 0 entonces r := con_cloexec(p, r) fin
                fin
            caso 316:
                si a5 <> 0 entonces r := EINVAL sino r := renombra_(p, ent64(a1), a2, ent64(a3), a4) fin
            si no: r := desconocida(p, n)
        fin
        p64(m + 112, nat64(r))
        ; (las marcas_ que puede devolver sysret: las de las cuentas, con IF)
        p64(m + 136, (l64(m + 136) yb 0xCD5) ob 0x202)
        si l64(m + 120) >= TOPE entonces sal(0, SIGSEGV) fin
        ; [etapa 6] Ctrl+C (o lo que lo cierre): ahora, al volver
        si p.matar <> 0 entonces sal(0, p.matar) fin
    fin

    ; las llamadas al sistema, en marcha (después de Procesos.prepara_procesos)
    público función prepara_sistema()
        época := segundos_unix()
        época_ns := ahora_ns()
        al_sistema := nat64(dirección(atiende))
    fin

fin Sistema.
