; =============================================================================
;  sistema.cas - Hispa-64, etapa 4: las llamadas al sistema (docs/64/HISPA-64.md,
;  2.6 y sección 10). Llegan por «syscall» (Entradas.E64_sistema) con el marco
;  de los registros: el número en RAX, los argumentos en RDI, RSI, RDX, R10, R8
;  y R9, y lo que se devuelve en RAX (un error, en negativo: -EFAULT...).
;  **Los números y la forma, los de Linux x86-64**: así la libc (musl, etapa 7)
;  se porta casi sin tocarla, y un programa estático de Linux que solo use
;  estas corre tal cual. Las que hay en la etapa 4:
;    0 read, 1 write, 2 open, 3 close, 8 lseek, 9 mmap, 10 mprotect,
;    11 munmap, 12 brk, 16 ioctl (-ENOTTY), 20 writev, 24 sched_yield,
;    35 nanosleep, 39 getpid, 60 exit, 63 uname, 102/104/107/108 getuid y
;    compañía (0), 158 arch_prctl (FS y GS), 186 gettid, 218 set_tid_address,
;    228 clock_gettime, 231 exit_group, 257 openat;
;  las demás, -ENOSYS (y se dicen las tres primeras de cada programa).
;  Todo puntero del programa se comprueba (Procesos.copia_de, copia_a,
;  texto_de: cada página, suya y con permiso): uno que apunte al núcleo, a nada
;  o a algo de solo leer cuando se va a escribir da -EFAULT, nunca un fallo
;  del núcleo. Los archivos: la consola (0, 1, 2; leer da 0: la entrada llega
;  en la etapa 6) y los de la unidad en memoria (Unidad64), de solo leer.
;  Lo que el programa escribe en la consola, si viene en UTF-8 (lo de Linux), se
;  pasa a la página 437 (la de la consola); lo que no es UTF-8 (lo de Castel,
;  que ya escribe en 437) va tal cual.
;  [etapa 6] La consola es una terminal (Tty64): read de la consola espera
;  una línea (o lo que pida el modo crudo); ioctl de terminal (TCGETS, TCSETS,
;  TIOCGWINSZ, TIOCGPGRP...); /dev/tty y /dev/console se pueden abrir. Y las
;  llamadas nuevas: 7 poll, 13 rt_sigaction y 14 rt_sigprocmask (lo mínimo:
;  SIG_IGN y SIG_DFL), 23 select, 56 clone (solo como fork), 57 fork, 58
;  vfork (como fork), 59 execve, 61 wait4, 109 setpgid, 110 getppid, 111
;  getpgrp, 112 setsid, 121 getpgid, 124 getsid, 270 pselect6, 271 ppoll;
;  O_CLOEXEC (open, dup3, fcntl) se cierra en execve.
;  [etapa 7] Lo que pide musl (sección 13): 15 rt_sigreturn, 13 rt_sigaction
;  y 14 rt_sigprocmask de verdad, 127 rt_sigpending, 130 rt_sigsuspend, 131
;  sigaltstack, 34 pause, 62 kill, 200 tkill, 234 tgkill; 56 clone (hilos:
;  CLONE_THREAD; CLONE_VM con CLONE_VFORK; y como fork), 60 exit (el hilo),
;  231 exit_group, 202 futex, 273 set_robust_list, 274 get_robust_list; 22
;  pipe y 293 pipe2 (Tubos64); 9 mmap de archivos (MAP_PRIVATE y MAP_SHARED
;  de solo leer: una copia; MAP_SHARED anónima, compartida de verdad con los
;  hijos); 28 madvise; 318 getrandom (RDRAND, o RDSEED, o lo del TSC); 230
;  clock_nanosleep (y nanosleep, que se interrumpe), 229 clock_getres, 96
;  gettimeofday, 201 time; 302 prlimit64, 97 getrlimit, 160 setrlimit; 203 y
;  204 sched_setaffinity y sched_getaffinity; 99 sysinfo; 95 umask; 98
;  getrusage; las de ioctl de la consola (TCGETS, TCSETS, TIOCGWINSZ...) y
;  FIONREAD de las tuberías. Al volver, Procesos.antes_de_volver: las
;  señales y repetir lo interrumpido (SA_RESTART); rt_sigreturn vuelve con
;  iretq (todos los registros).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Sistema

    importar Cifras64, Es64, Cerrojo, Fisica64, Pagina64, Monton64, PorCpu64, Excep64, Reloj64, Hilos64, Smp64, Entradas, Espacios, Unidad64, Procesos, Vfs64, Tty64, Futex64, Tubos64, Disp64, Sondeo64, Azar64, Hora64, Objet64, Redcom64, Red64

    constante EPERM = -1
    constante ENOENT = -2
    constante EBADF = -9
    constante ENOMEM = -12
    constante EFAULT = -14
    constante ENODEV = -19
    constante ENOTDIR = -20
    constante EISDIR = -21
    constante EINVAL = -22
    constante EMFILE = -24
    constante ENOTTY = -25
    constante ESPIPE = -29
    constante EROFS = -30
    constante ENOSYS = -38
    constante LARGO_RUTA = 1024
    constante ENAMETOOLONG = -36
    constante O_CLOEXEC = 0x80000
    constante EINTR = -4
    constante ECHILD = -10
    constante EAGAIN = -11
    constante EACCES = -13
    constante ESRCH = -3
    constante O_NONBLOCK = 0x800
    constante TROZO = 16384                     ; lo que se copia de una vez (read, write, getdents64)

    público variable llamadas: nat64            ; cuántas se han atendido
    variable época: nat64                       ; los segundos de Unix al arrancar
    variable época_ns: nat64                    ; ahora_ns() entonces

    función l64(d: nat64): nat64
        variable p: puntero a nat64
        p := puntero(d)
        devolver valor(p)
    fin

    función p64(d: nat64, v: nat64)
        variable p: puntero a nat64
        p := puntero(d)
        valor(p) := v
    fin

    ; [etapa 8] ¿es de una tubería? (las clases 3 y 4)
    función es_tubo(c: nat32): bool
        devolver c = F_TUBO_L o c = F_TUBO_E
    fin

    ; [etapa 9] ¿es de las nuevas? (sockets, eventfd, timerfd, /dev/urandom, los textos)
    función es_nueva(c: nat32): bool
        devolver c = F_SOCKET o es_objeto(c)
    fin

    ; ¿es fd un archivo abierto del programa?
    función fd_bien(p: puntero a Proceso, fd: nat64): bool
        si fd >= MAX_FD entonces devolver falso fin
        devolver p.fd_clase[nat32(fd)] <> 0
    fin

    ; ---- la consola [etapa 6: Tty64, que pasa lo de UTF-8 a la página 437] ----
    ; write a la consola: n octetos desde v (del programa), de 512 en 512
    función escribe_consola(p: puntero a Proceso, v: nat64, n: nat64): ent64
        variable t: arreglo [512] de byte
        variable hecho, trozo, b: nat64
        hecho := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > 512 entonces trozo := 512 fin
            si no copia_de(p, nat64(dirección(t[0])), v + hecho, trozo) entonces
                si hecho = 0 entonces devolver EFAULT fin
                devolver ent64(hecho)
            fin
            tty_escribe(dirección(t[0]), nat32(trozo))
            hecho := hecho + trozo
        fin
        devolver ent64(hecho)
    fin

    ; ---- los archivos [etapa 5: por el VFS] ----
    función abierto(p: puntero a Proceso, fd: nat64): puntero a Abierto
        devolver puntero(p.fd_obj[nat32(fd)])
    fin

    ; el primer descriptor libre desde «desde», o -1
    función fd_libre(p: puntero a Proceso, mínimo_: nat32): ent32
        variable fd: nat32
        fd := mínimo_
        mientras fd < MAX_FD y p.fd_clase[fd] <> 0 hacer fd := fd + 1 fin
        si fd >= MAX_FD entonces devolver -1 fin
        devolver ent32(fd)
    fin

    ; una ruta del programa, a un bloque del montón (lo suelta quien llama); nulo y el error
    función ruta_de(p: puntero a Proceso, v: nat64, ref err: ent64): puntero a byte
        variable t: puntero a byte
        variable r: ent64
        t := reserva(LARGO_RUTA)
        si t = nulo entonces
            err := ENOMEM
            devolver nulo
        fin
        r := texto_de(p, t, v, LARGO_RUTA)
        si r < 0 entonces
            libera(t)
            err := r
            devolver nulo
        fin
        err := 0
        devolver t
    fin

    ; la carpeta desde la que se ve una ruta de un «...at»: la actual
    ; (AT_FDCWD, -100) o la de un descriptor que sea una carpeta
    función base_de(p: puntero a Proceso, dirfd: ent64, ref err: ent64): puntero a byte
        err := 0
        si dirfd = -100 entonces devolver dirección(p.dir_actual[0]) fin
        si dirfd < 0 entonces
            err := EBADF
            devolver nulo
        fin
        si no fd_bien(p, nat64(dirfd)) entonces
            err := EBADF
            devolver nulo
        fin
        si p.fd_clase[nat32(dirfd)] <> F_ARCHIVO entonces
            err := ENOTDIR
            devolver nulo
        fin
        si no vfs_es_carpeta(abierto(p, nat64(dirfd))) entonces
            err := ENOTDIR
            devolver nulo
        fin
        devolver vfs_ruta(abierto(p, nat64(dirfd)))
    fin

    ; read y pread (pos: -1, la del archivo)
    función lee(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64, pos: ent64): ent64
        variable k: nat64
        variable hecho, trozo: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver tty_lee(p, v, n)
        fin
        ; [etapa 7] las tuberías (y epoll, que no se lee)
        si p.fd_clase[nat32(fd)] = F_EPOLL entonces devolver EINVAL fin
        si p.fd_clase[nat32(fd)] = F_TUBO_E entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_TUBO_L entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver tubo_lee(p, p.fd_obj[nat32(fd)], v, n, p.fd_nobloq[nat32(fd)] <> 0)
        fin
        ; [etapa 9] los sockets y los objetos
        si p.fd_clase[nat32(fd)] = F_SOCKET entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver lee_sock(p, fd, v, n)
        fin
        si es_objeto(p.fd_clase[nat32(fd)]) entonces devolver lee_objeto(p, p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], v, n, p.fd_nobloq[nat32(fd)] <> 0) fin
        ; [etapa 8] los dispositivos (Disp64)
        si es_de_disp(p.fd_clase[nat32(fd)]) entonces devolver lee_disp(p, p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], v, n, p.fd_nobloq[nat32(fd)] <> 0) fin
        si n = 0 entonces devolver 0 fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        hecho := 0
        r := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > TROZO entonces trozo := TROZO fin
            si pos < 0 entonces r := vfs_lee(abierto(p, fd), -1, k, trozo) sino r := vfs_lee(abierto(p, fd), pos + ent64(hecho), k, trozo) fin
            si r <= 0 entonces romper fin
            si no copia_a(p, v + hecho, k, nat64(r)) entonces
                r := EFAULT
                romper
            fin
            hecho := hecho + nat64(r)
            si nat64(r) < trozo entonces romper fin
        fin
        libera(puntero(k))
        si hecho = 0 y r < 0 entonces devolver r fin
        devolver ent64(hecho)
    fin

    ; write y pwrite
    función escribe(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64, pos: ent64): ent64
        variable k: nat64
        variable hecho, trozo: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si pos >= 0 entonces devolver ESPIPE fin
            si n = 0 entonces devolver 0 fin
            devolver escribe_consola(p, v, n)
        fin
        ; [etapa 7] las tuberías (y epoll, que no se escribe)
        si p.fd_clase[nat32(fd)] = F_EPOLL entonces devolver EINVAL fin
        si p.fd_clase[nat32(fd)] = F_TUBO_L entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_TUBO_E entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver tubo_escribe(p, p.fd_obj[nat32(fd)], v, n, p.fd_nobloq[nat32(fd)] <> 0)
        fin
        si p.fd_clase[nat32(fd)] = F_SOCKET entonces
            si pos >= 0 entonces devolver ESPIPE fin
            devolver escribe_sock(p, fd, v, n)
        fin
        si es_objeto(p.fd_clase[nat32(fd)]) entonces devolver escribe_objeto(p, p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], v, n, p.fd_nobloq[nat32(fd)] <> 0) fin
        si es_de_disp(p.fd_clase[nat32(fd)]) entonces devolver escribe_disp(p, p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], v, n) fin
        si n = 0 entonces devolver 0 fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        hecho := 0
        r := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > TROZO entonces trozo := TROZO fin
            si no copia_de(p, k, v + hecho, trozo) entonces
                r := EFAULT
                romper
            fin
            si pos < 0 entonces r := vfs_escribe(abierto(p, fd), -1, k, trozo) sino r := vfs_escribe(abierto(p, fd), pos + ent64(hecho), k, trozo) fin
            si r <= 0 entonces romper fin
            hecho := hecho + nat64(r)
            si nat64(r) < trozo entonces romper fin
        fin
        libera(puntero(k))
        si hecho = 0 y r < 0 entonces devolver r fin
        devolver ent64(hecho)
    fin

    ; readv y writev
    función vectores(p: puntero a Proceso, fd: nat64, iov: nat64, cuántos: nat64, escribir_: bool): ent64
        variable par: arreglo [2] de nat64
        variable i: nat64
        variable total, r: ent64
        si cuántos > 1024 entonces devolver EINVAL fin
        si no fd_bien(p, fd) entonces devolver EBADF fin
        total := 0
        i := 0
        mientras i < cuántos hacer
            si no copia_de(p, nat64(dirección(par[0])), iov + i * 16, 16) entonces
                si total = 0 entonces devolver EFAULT fin
                devolver total
            fin
            si escribir_ entonces r := escribe(p, fd, par[0], par[1], -1) sino r := lee(p, fd, par[0], par[1], -1) fin
            si r < 0 entonces
                si total = 0 entonces devolver r fin
                devolver total
            fin
            total := total + r
            si nat64(r) < par[1] entonces devolver total fin
            i := i + 1
        fin
        devolver total
    fin

    ; [etapa 6] ¿es la ruta la de la consola?
    función mismo(a: puntero a byte, b: puntero a byte): bool
        variable i: nat32
        i := 0
        mientras a[i] <> 0 y a[i] = b[i] hacer i := i + 1 fin
        devolver a[i] = b[i]
    fin

    función es_consola(t: puntero a byte): bool
        devolver mismo(t, "/dev/tty") o mismo(t, "/dev/console") o mismo(t, "/dev/tty0") o mismo(t, "/dev/stdin") o mismo(t, "/dev/stdout") o mismo(t, "/dev/stderr")
    fin

    función abre(p: puntero a Proceso, dirfd: ent64, ruta: nat64, marcas_: nat64): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable fd: ent32
        variable dc: nat32
        variable dob: nat64
        variable a: puntero a Abierto
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        ; [etapa 6] la consola: /dev/tty y /dev/console
        si es_consola(t) entonces
            libera(t)
            fd := fd_libre(p, 0)
            si fd < 0 entonces devolver EMFILE fin
            p.fd_clase[nat32(fd)] := F_CONSOLA
            p.fd_obj[nat32(fd)] := 0
            si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
            devolver ent64(fd)
        fin
        ; [etapa 8] los dispositivos: /dev/fb0, /dev/input/event0, /dev/shm/..., /dev/null, /dev/zero
        dc := es_disp(t)
        si dc <> 0 entonces
            fd := fd_libre(p, 0)
            si fd < 0 entonces
                libera(t)
                devolver EMFILE
            fin
            err := abre_disp(p, t, dc, marcas_, dob)
            libera(t)
            si err < 0 entonces devolver err fin
            p.fd_clase[nat32(fd)] := dc
            p.fd_obj[nat32(fd)] := dob
            si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
            si marcas_ yb O_NONBLOCK <> 0 entonces p.fd_nobloq[nat32(fd)] := 1 sino p.fd_nobloq[nat32(fd)] := 0 fin
            devolver ent64(fd)
        fin
        ; [etapa 9] /dev/urandom, /dev/random y los textos de la red
        si mismo(t, "/dev/urandom") o mismo(t, "/dev/random") o es_texto_red(t) entonces
            fd := fd_libre(p, 0)
            si fd < 0 entonces
                libera(t)
                devolver EMFILE
            fin
            si es_texto_red(t) entonces
                dob := texto_red(t)
                dc := F_TEXTO
            sino
                dob := 0
                dc := F_AZAR
            fin
            libera(t)
            si dc = F_TEXTO y dob = 0 entonces devolver ENOMEM fin
            p.fd_clase[nat32(fd)] := dc
            p.fd_obj[nat32(fd)] := dob
            si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
            p.fd_nobloq[nat32(fd)] := 0
            devolver ent64(fd)
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        fd := fd_libre(p, 0)
        si fd < 0 entonces
            libera(t)
            devolver EMFILE
        fin
        si marcas_ yb O_CLOEXEC <> 0 entonces p.fd_cloexec[nat32(fd)] := 1 sino p.fd_cloexec[nat32(fd)] := 0 fin
        a := vfs_abre(base, t, marcas_ yb (nob nat64(O_CLOEXEC)), err)
        libera(t)
        si a = nulo entonces devolver err fin
        p.fd_clase[nat32(fd)] := F_ARCHIVO
        p.fd_obj[nat32(fd)] := nat64(a)
        devolver ent64(fd)
    fin

    función cierra(p: puntero a Proceso, fd: nat64): ent64
        variable c: nat32
        variable ob_: nat64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        c := p.fd_clase[nat32(fd)]
        ob_ := p.fd_obj[nat32(fd)]
        p.fd_clase[nat32(fd)] := 0
        p.fd_obj[nat32(fd)] := 0
        p.fd_nobloq[nat32(fd)] := 0
        cierra_fd_obj(c, ob_)
        p.fd_clase[nat32(fd)] := 0
        p.fd_obj[nat32(fd)] := 0
        p.fd_cloexec[nat32(fd)] := 0
        devolver 0
    fin

    ; dup, dup2, dup3 y fcntl(F_DUPFD): a «a» (o al primero libre desde «desde»)
    función duplica(p: puntero a Proceso, fd: nat64, a: ent64, mínimo_: nat32): ent64
        variable n: ent32
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si a >= 0 entonces
            si a >= MAX_FD entonces devolver EBADF fin
            si nat64(a) = fd entonces devolver a fin
            si fd_bien(p, nat64(a)) entonces cierra(p, nat64(a)) fin
            n := ent32(a)
        sino
            n := fd_libre(p, mínimo_)
            si n < 0 entonces devolver EMFILE fin
        fin
        p.fd_clase[nat32(n)] := p.fd_clase[nat32(fd)]
        p.fd_obj[nat32(n)] := p.fd_obj[nat32(fd)]
        p.fd_cloexec[nat32(n)] := 0
        p.fd_nobloq[nat32(n)] := p.fd_nobloq[nat32(fd)]
        otro_fd(p, nat32(n))
        devolver ent64(n)
    fin

    ; (dup3 y F_DUPFD_CLOEXEC) el descriptor nuevo, con FD_CLOEXEC
    función con_cloexec(p: puntero a Proceso, r: ent64): ent64
        si r >= 0 entonces p.fd_cloexec[nat32(r)] := 1 fin
        devolver r
    fin

    función fcntl_(p: puntero a Proceso, fd: nat64, orden: nat64, arg: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si orden = 0 entonces devolver duplica(p, fd, -1, nat32(arg)) fin               ; F_DUPFD
        si orden = 1030 entonces devolver con_cloexec(p, duplica(p, fd, -1, nat32(arg))) fin      ; F_DUPFD_CLOEXEC
        si orden = 1 entonces devolver ent64(p.fd_cloexec[nat32(fd)]) fin                ; F_GETFD
        si orden = 2 entonces                                                            ; F_SETFD
            p.fd_cloexec[nat32(fd)] := nat32(arg yb 1)
            devolver 0
        fin
        si orden = 4 entonces                                                            ; F_SETFL
            si es_tubo(p.fd_clase[nat32(fd)]) o es_de_disp(p.fd_clase[nat32(fd)]) o es_nueva(p.fd_clase[nat32(fd)]) entonces p.fd_nobloq[nat32(fd)] := nat32((arg >> 11) yb 1) fin
            devolver 0
        fin
        si orden = 3 entonces                                                            ; F_GETFL
            si p.fd_clase[nat32(fd)] = F_CONSOLA entonces devolver 2 fin
            si p.fd_clase[nat32(fd)] = F_TUBO_L entonces devolver ent64(nat64(p.fd_nobloq[nat32(fd)]) << 11) fin
            si p.fd_clase[nat32(fd)] = F_TUBO_E entonces devolver ent64(1 ob (nat64(p.fd_nobloq[nat32(fd)]) << 11)) fin
            si p.fd_clase[nat32(fd)] = F_EPOLL entonces devolver 2 fin
            si es_de_disp(p.fd_clase[nat32(fd)]) o es_nueva(p.fd_clase[nat32(fd)]) entonces devolver ent64(2 ob (nat64(p.fd_nobloq[nat32(fd)]) << 11)) fin
            devolver ent64(abierto(p, fd).marcas yb 0x403)
        fin
        devolver EINVAL
    fin

    función sitúa(p: puntero a Proceso, fd: nat64, d: ent64, de_dónde: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_TEXTO entonces devolver sitúa_texto(p.fd_obj[nat32(fd)], d, de_dónde) fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver ESPIPE fin
        devolver vfs_sitúa(abierto(p, fd), d, de_dónde)
    fin

    ; la «struct stat» (144 octetos) de la consola
    función stat_consola(k: nat64)
        variable i: nat32
        i := 0
        mientras i < 144 hacer
            pon_m8(k + i, 0)
            i := i + 1
        fin
        pon_m64(k + 16, 1)
        pon_m32(k + 24, 0x2000 ob 0x1B6)        ; S_IFCHR, 0666
        pon_m64(k + 40, 0x8801)                 ; (como /dev/pts/1)
        pon_m64(k + 56, 1024)
    fin

    función fstat_(p: puntero a Proceso, fd: nat64, v: nat64): ent64
        variable st: arreglo [18] de nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            stat_consola(nat64(dirección(st[0])))
            r := 0
        sino si p.fd_clase[nat32(fd)] = F_EPOLL entonces
            ; [etapa 7] un epoll: un archivo sin nombre, 0600
            stat_consola(nat64(dirección(st[0])))
            pon_m32(nat64(dirección(st[0])) + 24, 0x8000 ob 0x180)
            pon_m64(nat64(dirección(st[0])) + 40, 0)
            r := 0
        sino si p.fd_clase[nat32(fd)] = F_SOCKET entonces
            ceros_mem(nat64(dirección(st[0])), 144)
            stat_sock(nat64(dirección(st[0])), p.fd_obj[nat32(fd)])
            r := 0
        sino si es_objeto(p.fd_clase[nat32(fd)]) entonces
            ceros_mem(nat64(dirección(st[0])), 144)
            stat_objeto(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], nat64(dirección(st[0])))
            r := 0
        sino si es_de_disp(p.fd_clase[nat32(fd)]) entonces
            ; [etapa 8] un dispositivo (Disp64)
            ceros_mem(nat64(dirección(st[0])), 144)
            stat_disp(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], nat64(dirección(st[0])))
            r := 0
        sino si es_tubo(p.fd_clase[nat32(fd)]) entonces
            ; [etapa 7] una tubería: S_IFIFO, 0600
            stat_consola(nat64(dirección(st[0])))
            pon_m32(nat64(dirección(st[0])) + 24, 0x1000 ob 0x180)
            pon_m64(nat64(dirección(st[0])) + 40, 0)
            pon_m64(nat64(dirección(st[0])) + 8, p.fd_obj[nat32(fd)] >> 4)
            pon_m64(nat64(dirección(st[0])) + 56, 4096)
            r := 0
        sino
            r := vfs_fstat(abierto(p, fd), nat64(dirección(st[0])))
        fin
        si r < 0 entonces devolver r fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    ; stat, lstat y newfstatat (con AT_EMPTY_PATH y la ruta vacía: el del descriptor)
    función stat_(p: puntero a Proceso, dirfd: ent64, ruta: nat64, v: nat64, marcas_: nat64): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable st: arreglo [18] de nat64
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        si es_consola(t) entonces
            libera(t)
            stat_consola(nat64(dirección(st[0])))
            si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
            devolver 0
        fin
        ; [etapa 8] /dev/fb0, /dev/input/event0, /dev/null y /dev/zero (los de /dev/shm, por su descriptor)
        si es_disp(t) <> 0 y es_disp(t) <> F_SHM entonces
            ceros_mem(nat64(dirección(st[0])), 144)
            stat_disp(es_disp(t), 0, nat64(dirección(st[0])))
            libera(t)
            si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
            devolver 0
        fin
        si t[0] = 0 entonces
            libera(t)
            si marcas_ yb 0x1000 = 0 entonces devolver ENOENT fin
            si dirfd = -100 entonces devolver stat_ruta(p, dirección(p.dir_actual[0]), v) fin
            si dirfd < 0 entonces devolver EBADF fin
            devolver fstat_(p, nat64(dirfd), v)
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        err := vfs_stat(base, t, nat64(dirección(st[0])))
        libera(t)
        si err < 0 entonces devolver err fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    función stat_ruta(p: puntero a Proceso, t: puntero a byte, v: nat64): ent64
        variable st: arreglo [18] de nat64
        variable err: ent64
        err := vfs_stat(nulo, t, nat64(dirección(st[0])))
        si err < 0 entonces devolver err fin
        si no copia_a(p, v, nat64(dirección(st[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    función lista_(p: puntero a Proceso, fd: nat64, v: nat64, n: nat64): ent64
        variable k: nat64
        variable r: ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver ENOTDIR fin
        si n > TROZO entonces n := TROZO fin
        k := nat64(reserva(TROZO))
        si k = 0 entonces devolver ENOMEM fin
        r := vfs_lista(abierto(p, fd), k, n)
        si r > 0 entonces
            si no copia_a(p, v, k, nat64(r)) entonces r := EFAULT fin
        fin
        libera(puntero(k))
        devolver r
    fin

    ; mkdir (0), unlink (1), rmdir (2) y access (3), desde dirfd
    función con_ruta(p: puntero a Proceso, dirfd: ent64, ruta: nat64, qué: nat32): ent64
        variable t, base: puntero a byte
        variable err: ent64
        variable st: arreglo [18] de nat64
        t := ruta_de(p, ruta, err)
        si t = nulo entonces devolver err fin
        si t[0] = 0 entonces
            libera(t)
            devolver ENOENT
        fin
        ; [etapa 8] shm_unlink: /dev/shm/NOMBRE
        si qué = 1 y es_disp(t) = F_SHM entonces
            err := borra_shm(t)
            libera(t)
            devolver err
        fin
        base := nulo
        si t[0] <> '/' entonces
            base := base_de(p, dirfd, err)
            si base = nulo entonces
                libera(t)
                devolver err
            fin
        fin
        si qué = 0 entonces err := vfs_mkdir(base, t)
        sino si qué = 1 entonces err := vfs_borra(base, t, falso)
        sino si qué = 2 entonces err := vfs_borra(base, t, cierto)
        sino err := vfs_stat(base, t, nat64(dirección(st[0])))
        fin
        libera(t)
        devolver err
    fin

    función renombra_(p: puntero a Proceso, dirfd1: ent64, ruta1: nat64, dirfd2: ent64, ruta2: nat64): ent64
        variable t1, t2, b1, b2: puntero a byte
        variable err: ent64
        t1 := ruta_de(p, ruta1, err)
        si t1 = nulo entonces devolver err fin
        t2 := ruta_de(p, ruta2, err)
        si t2 = nulo entonces
            libera(t1)
            devolver err
        fin
        b1 := nulo
        b2 := nulo
        si t1[0] <> '/' entonces b1 := base_de(p, dirfd1, err) fin
        si err = 0 y t2[0] <> '/' entonces b2 := base_de(p, dirfd2, err) fin
        si err = 0 y (t1[0] = 0 o t2[0] = 0) entonces err := ENOENT fin
        si err = 0 entonces err := vfs_renombra(b1, t1, b2, t2) fin
        libera(t1)
        libera(t2)
        devolver err
    fin

    función trunca_(p: puntero a Proceso, fd: nat64, t: ent64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si t < 0 entonces devolver EINVAL fin
        si p.fd_clase[nat32(fd)] = F_SHM entonces devolver trunca_shm(p.fd_obj[nat32(fd)], nat64(t)) fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver EINVAL fin
        devolver vfs_trunca(abierto(p, fd), nat64(t))
    fin

    ; truncate(ruta, tamaño): abre, acorta y cierra
    función trunca_ruta(p: puntero a Proceso, ruta: nat64, t: ent64): ent64
        variable fd, r: ent64
        fd := abre(p, -100, ruta, 1)
        si fd < 0 entonces devolver fd fin
        r := trunca_(p, nat64(fd), t)
        cierra(p, nat64(fd))
        devolver r
    fin

    función fsync_(p: puntero a Proceso, fd: nat64): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver EINVAL fin
        devolver vfs_fsync(abierto(p, fd))
    fin

    función getcwd_(p: puntero a Proceso, v: nat64, n: nat64): ent64
        variable l: nat64
        l := 0
        mientras p.dir_actual[nat32(l)] <> 0 hacer l := l + 1 fin
        l := l + 1
        si n < l entonces devolver -34 fin                     ; ERANGE
        si no copia_a(p, v, nat64(dirección(p.dir_actual[0])), l) entonces devolver EFAULT fin
        devolver ent64(l)
    fin

    ; chdir (fd < 0) y fchdir
    función chdir_(p: puntero a Proceso, ruta: nat64, fd: ent64): ent64
        variable t, base, nueva: puntero a byte
        variable err: ent64
        variable i: nat32
        nueva := reserva(LARGO_RUTA)
        si nueva = nulo entonces devolver ENOMEM fin
        si fd >= 0 entonces
            base := base_de(p, fd, err)
            si base = nulo entonces
                libera(nueva)
                devolver err
            fin
            err := vfs_carpeta(nulo, base, nueva)
        sino
            t := ruta_de(p, ruta, err)
            si t = nulo entonces
                libera(nueva)
                devolver err
            fin
            si t[0] = 0 entonces err := ENOENT sino err := vfs_carpeta(dirección(p.dir_actual[0]), t, nueva) fin
            libera(t)
        fin
        si err = 0 entonces
            i := 0
            mientras nueva[i] <> 0 hacer i := i + 1 fin
            si i > 255 entonces err := ENAMETOOLONG fin
        fin
        si err = 0 entonces
            i := 0
            mientras nueva[i] <> 0 hacer
                p.dir_actual[i] := nueva[i]
                i := i + 1
            fin
            p.dir_actual[i] := 0
        fin
        libera(nueva)
        devolver err
    fin

    ; ---- la memoria ----
    función mapea_(p: puntero a Proceso, dir_: nat64, largo: nat64, prot: nat64, marcas_: nat64, fd: ent64, desp: nat64): ent64
        variable a, l: nat64
        variable ab: puntero a Abierto
        variable ext, dc: nat32
        variable dob: nat64
        variable r: ent64
        variable anónima, compartida: bool
        dc := 0
        dob := 0
        si largo = 0 o prot yb (nob nat64(7)) <> 0 entonces devolver EINVAL fin
        si marcas_ yb 3 = 0 entonces devolver EINVAL fin
        compartida := marcas_ yb 3 <> 2                 ; MAP_SHARED (y MAP_SHARED_VALIDATE)
        anónima := marcas_ yb 0x20 <> 0
        ab := nulo
        ext := 0
        si anónima y compartida entonces ext := R_COMPARTIDA fin
        ; [etapa 7] de un archivo: una copia de lo que tiene (MAP_PRIVATE, y
        ; MAP_SHARED de solo leer); MAP_SHARED de escribir, aún no
        si no anónima entonces
            si fd < 0 entonces devolver EBADF fin
            si no fd_bien(p, nat64(fd)) entonces devolver EBADF fin
            ; [etapa 8] la pantalla y la memoria compartida (Disp64): siempre compartidas
            si p.fd_clase[nat32(fd)] = F_FB o p.fd_clase[nat32(fd)] = F_SHM entonces
                si desp yb 4095 <> 0 entonces devolver EINVAL fin
                dc := p.fd_clase[nat32(fd)]
                dob := p.fd_obj[nat32(fd)]
                ext := R_DISP
            sino si p.fd_clase[nat32(fd)] <> F_ARCHIVO entonces devolver ENODEV fin
            si dc = 0 entonces
                ab := abierto(p, nat64(fd))
                si vfs_es_carpeta(ab) entonces devolver ENODEV fin
                si ab.marcas yb O_ACCESO = O_WRONLY entonces devolver EACCES fin
                si desp yb 4095 <> 0 entonces devolver EINVAL fin
                si compartida y prot yb 2 <> 0 entonces
                    si ab.marcas yb O_ACCESO <> O_RDWR entonces devolver EACCES fin
                    devolver ENODEV
                fin
                ext := R_ARCHIVO
            fin
        fin
        l := arriba(largo)
        si l < largo o l > nat64(1) << 40 entonces devolver ENOMEM fin
        cierra_mem(p)
        a := 0
        si marcas_ yb 0x10 <> 0 entonces
            ; MAP_FIXED: ahí, quitando lo que hubiese
            r := 0
            si dir_ yb 4095 <> 0 entonces r := EINVAL
            sino si dir_ < MÍNIMO entonces r := EPERM
            sino si dir_ + l < dir_ o dir_ + l > TOPE entonces r := ENOMEM
            sino si no quita_de(p, dir_, dir_ + l) entonces r := ENOMEM
            fin
            si r < 0 entonces
                abre_mem(p)
                devolver r
            fin
            a := dir_
        sino
            ; la pista, si está libre
            si dir_ >= MÍNIMO y dir_ yb 4095 = 0 y dir_ + l > dir_ y dir_ + l <= TOPE entonces
                si hueco(p, l, dir_, dir_ + l) = dir_ entonces a := dir_ fin
            fin
            si a = 0 y marcas_ yb 0x40 <> 0 entonces a := hueco(p, l, 0x40000000, 0x80000000) fin    ; MAP_32BIT
            si a = 0 y marcas_ yb 0x40 = 0 entonces
                a := hueco(p, l, p.mmap_próx, TOPE - PILA_PROG)
                si a = 0 entonces a := hueco(p, l, nat64(0x1000) << 32, TOPE - PILA_PROG) fin
            fin
            si a = 0 entonces
                abre_mem(p)
                devolver ENOMEM
            fin
        fin
        si no pon_región_ext(p, a, a + l, nat32(prot), R_MMAP, ext) entonces
            abre_mem(p)
            devolver ENOMEM
        fin
        si marcas_ yb 0x50 = 0 entonces p.mmap_próx := a + l fin
        si dc <> 0 entonces
            r := mapea_dispo(p, dc, dob, a, l, desp, nat32(prot))
            si r < 0 entonces
                quita_de(p, a, a + l)
                abre_mem(p)
                devolver r
            fin
        fin
        si ab <> nulo entonces
            r := llena_de_archivo(p, a, l, ab, desp, nat32(prot))
            si r < 0 entonces
                quita_de(p, a, a + l)
                abre_mem(p)
                devolver r
            fin
        fin
        abre_mem(p)
        devolver ent64(a)
    fin

    ; [etapa 7] (con el mutex de la memoria) las páginas de [a, a + l) con lo
    ; del archivo desde «desp» (lo que pase del final, a cero al tocarlo)
    función llena_de_archivo(p: puntero a Proceso, a: nat64, l: nat64, ab: puntero a Abierto, desp: nat64, prot: nat32): ent64
        variable tam, v, pos, f, n: nat64
        variable r: ent64
        variable e: puntero a Espacio
        e := puntero(p.espacio)
        tam := vfs_tamaño(ab)
        v := a
        mientras v < a + l y desp + (v - a) < tam hacer
            pos := desp + (v - a)
            f := pide()
            si f = 0 entonces devolver ENOMEM fin
            ceros_mem(virt(f), 4096)
            n := tam - pos
            si n > 4096 entonces n := 4096 fin
            r := vfs_lee(ab, ent64(pos), virt(f), n)
            si r < 0 entonces
                devuelve(f)
                devolver r
            fin
            si no mapea_u(e, v, f, marcas_de_prot(prot)) entonces
                devuelve(f)
                devolver ENOMEM
            fin
            v := v + 4096
        fin
        ; (sin ningún permiso: las páginas se quedan, sin la marca de usuario)
        si prot = 0 entonces remarca_rango(e, a, a + l, 0, cierto) fin
        devolver 0
    fin

    función marcas_de_prot(prot: nat32): nat64
        variable fl: nat64
        fl := 0
        si prot yb 2 <> 0 entonces fl := ESCRIBIR fin
        si prot yb 4 = 0 entonces fl := fl ob bit_nx() fin
        devolver fl
    fin

    ; [etapa 7] madvise: MADV_DONTNEED (4) suelta las páginas de la memoria
    ; anónima y privada (al tocarlas otra vez, a cero, como en Linux); lo
    ; demás (MADV_FREE, las pistas), aceptado sin más
    función aconseja(p: puntero a Proceso, dir_: nat64, largo: nat64, qué: nat64): ent64
        variable l: nat64
        variable i: nat32
        variable solo_anónima: bool
        si dir_ yb 4095 <> 0 entonces devolver EINVAL fin
        l := arriba(largo)
        si l < largo o dir_ + l < dir_ o dir_ + l > TOPE entonces devolver EINVAL fin
        si qué <> 4 entonces devolver 0 fin
        cierra_mem(p)
        solo_anónima := cierto
        i := 0
        mientras nat64(i) < p.n_reg hacer
            si p.reg_ini[i] < dir_ + l y p.reg_fin[i] > dir_ y p.reg_ext[i] <> 0 entonces solo_anónima := falso fin
            i := i + 1
        fin
        si solo_anónima entonces quita_rango(puntero(p.espacio), dir_, dir_ + l) fin
        abre_mem(p)
        devolver 0
    fin

    función desmapea_(p: puntero a Proceso, dir_: nat64, largo: nat64): ent64
        variable l: nat64
        si dir_ yb 4095 <> 0 o largo = 0 entonces devolver EINVAL fin
        l := arriba(largo)
        si l < largo o dir_ + l < dir_ o dir_ + l > TOPE entonces devolver EINVAL fin
        cierra_mem(p)
        si no quita_de(p, dir_, dir_ + l) entonces
            abre_mem(p)
            devolver ENOMEM
        fin
        abre_mem(p)
        devolver 0
    fin

    función protege_(p: puntero a Proceso, dir_: nat64, largo: nat64, prot: nat64): ent64
        variable l: nat64
        variable r: ent64
        si dir_ yb 4095 <> 0 o prot yb (nob nat64(7)) <> 0 entonces devolver EINVAL fin
        si largo = 0 entonces devolver 0 fin
        l := arriba(largo)
        si l < largo o dir_ + l < dir_ o dir_ + l > TOPE entonces devolver ENOMEM fin
        cierra_mem(p)
        r := protege(p, dir_, dir_ + l, nat32(prot))
        abre_mem(p)
        devolver r
    fin

    ; brk: lo nuevo, o lo de antes si no se puede (como Linux)
    función brk_(p: puntero a Proceso, nuevo: nat64): ent64
        variable r: ent64
        cierra_mem(p)
        r := brk__(p, nuevo)
        abre_mem(p)
        devolver r
    fin

    función brk__(p: puntero a Proceso, nuevo: nat64): ent64
        variable viejo_fin, nuevo_fin: nat64
        variable i: nat32
        variable hecho: bool
        si nuevo < p.brk_ini o nuevo - p.brk_ini > nat64(1) << 30 entonces devolver ent64(p.brk) fin
        viejo_fin := arriba(p.brk)
        nuevo_fin := arriba(nuevo)
        si nuevo_fin > viejo_fin entonces
            si hueco(p, nuevo_fin - viejo_fin, viejo_fin, nuevo_fin) <> viejo_fin entonces devolver ent64(p.brk) fin
            ; (se alarga la región del montón, si la hay; si no, una nueva)
            hecho := falso
            i := 0
            mientras nat64(i) < p.n_reg hacer
                si p.reg_clase[i] = R_MONTÓN y p.reg_fin[i] = viejo_fin entonces
                    p.reg_fin[i] := nuevo_fin
                    hecho := cierto
                fin
                i := i + 1
            fin
            si no hecho entonces
                si no pon_región(p, viejo_fin, nuevo_fin, LEER ob ESCRIBE, R_MONTÓN) entonces devolver ent64(p.brk) fin
            fin
        sino si nuevo_fin < viejo_fin entonces
            si no quita_de(p, nuevo_fin, viejo_fin) entonces devolver ent64(p.brk) fin
        fin
        p.brk := nuevo
        devolver ent64(nuevo)
    fin

    ; ---- el tiempo ----
    función reloj(p: puntero a Proceso, cuál: nat64, v: nat64): ent64
        variable ts: arreglo [2] de nat64
        variable ns: nat64
        ns := ahora_ns()
        según cuál
            caso 0, 5: ns := real_ns()                                  ; REALTIME, REALTIME_COARSE ([etapa 9] Hora64)
            caso 1, 4, 6, 7: ns := ns                                   ; MONOTONIC, _RAW, _COARSE, BOOTTIME
            caso 2, 3: ns := ns                                         ; [etapa 7] PROCESS_CPUTIME, THREAD_CPUTIME (lo que lleva en marcha)
            si no: devolver EINVAL
        fin
        ts[0] := ns div 1000000000
        ts[1] := ns mod 1000000000
        si no copia_a(p, v, nat64(dirección(ts[0])), 16) entonces devolver EFAULT fin
        devolver 0
    fin

    ; nanosleep y [etapa 7] clock_nanosleep (con TIMER_ABSTIME): se
    ; interrumpen con una señal (-EINTR, y lo que quedaba en «v_resto»)
    función duerme_(p: puntero a Proceso, v: nat64, v_resto: nat64): ent64
        devolver duerme_reloj(p, 1, 0, v, v_resto)
    fin

    función duerme_reloj(p: puntero a Proceso, cuál: nat64, marcas_: nat64, v: nat64, v_resto: nat64): ent64
        variable ts: arreglo [2] de nat64
        variable límite, ahora, d: nat64
        si cuál <> 0 y cuál <> 1 y cuál <> 7 entonces devolver EINVAL fin
        si no copia_de(p, nat64(dirección(ts[0])), v, 16) entonces devolver EFAULT fin
        si ts[0] >= nat64(1) << 62 o ts[1] >= 1000000000 entonces devolver EINVAL fin
        si ts[0] > 100000000 entonces ts[0] := 100000000 fin
        d := ts[0] * 1000000000 + ts[1]
        ahora := ahora_ns()
        si marcas_ yb 1 <> 0 entonces
            ; TIMER_ABSTIME: hasta esa hora (la de ese reloj)
            si cuál = 0 entonces
                si d <= real_ns() entonces devolver 0 fin
                límite := real_a_mono(d)
            sino
                límite := d
            fin
        sino
            límite := ahora + d
        fin
        si no duerme_hasta(p, límite) entonces devolver 0 fin
        ; (interrumpido)
        si v_resto <> 0 y marcas_ yb 1 = 0 entonces
            ahora := ahora_ns()
            d := 0
            si límite > ahora entonces d := límite - ahora fin
            ts[0] := d div 1000000000
            ts[1] := d mod 1000000000
            copia_a(p, v_resto, nat64(dirección(ts[0])), 16)
        fin
        devolver EINTR
    fin

    ; ---- lo demás ----
    función pon_texto(t: puntero a byte, en: nat32, s: puntero a byte)
        variable i: nat32
        i := 0
        mientras s[i] <> 0 hacer
            t[en + i] := s[i]
            i := i + 1
        fin
    fin

    función nombre_(p: puntero a Proceso, v: nat64): ent64
        variable t: arreglo [390] de byte
        variable i: nat32
        i := 0
        mientras i < 390 hacer
            t[i] := 0
            i := i + 1
        fin
        pon_texto(dirección(t[0]), 0, "Hispa-64")
        pon_texto(dirección(t[0]), 65, "hispa64")
        pon_texto(dirección(t[0]), 130, "0.9.0")
        pon_texto(dirección(t[0]), 195, "etapa 9 (la red)")
        pon_texto(dirección(t[0]), 260, "x86_64")
        pon_texto(dirección(t[0]), 325, "(none)")
        si no copia_a(p, v, nat64(dirección(t[0])), 390) entonces devolver EFAULT fin
        devolver 0
    fin

    función arch_(p: puntero a Proceso, qué: nat64, v: nat64): ent64
        variable h: puntero a Hilo
        variable b, x: nat64
        h := actual()
        según qué
            caso 0x1002, 0x1001:
                si v >= nat64(0x8000) << 32 entonces devolver EPERM fin
                b := sin_ints()
                si qué = 0x1002 entonces
                    pon_msr(0xC0000100, v)
                    h.fs_u := v
                sino
                    pon_msr(0xC0000102, v)          ; (el GS del programa, mientras se está en el núcleo)
                    h.gs_u := v
                fin
                restaura(b)
                devolver 0
            caso 0x1003, 0x1004:
                b := sin_ints()
                si qué = 0x1003 entonces x := lee_msr(0xC0000100) sino x := lee_msr(0xC0000102) fin
                restaura(b)
                si no copia_a(p, v, nat64(dirección(x)), 8) entonces devolver EFAULT fin
                devolver 0
            si no: devolver EINVAL
        fin
    fin

    ; ---- [etapa 6] poll y select ----
    ; lo que está listo de fd de lo pedido en ev (las marcas de poll: POLLIN 1,
    ; POLLOUT 4, POLLRDNORM 0x40, POLLWRNORM 0x100; POLLNVAL 0x20 si no está abierto)
    función listo_de(p: puntero a Proceso, fd: ent64, ev: nat32): nat32
        si fd < 0 entonces devolver 0 fin
        si no fd_bien(p, nat64(fd)) entonces devolver 0x20 fin
        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces
            si hay_datos() entonces devolver ev yb 0x145 fin
            devolver ev yb 0x104
        fin
        ; [etapa 7] las tuberías (POLLHUP y POLLERR, aunque no se pidan)
        si es_tubo(p.fd_clase[nat32(fd)]) entonces
            devolver tubo_listo(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)]) yb (ev ob 0x18)
        fin
        ; [etapa 9] los sockets y los objetos
        si p.fd_clase[nat32(fd)] = F_SOCKET entonces devolver listo_sock(p.fd_obj[nat32(fd)], ev) fin
        si es_objeto(p.fd_clase[nat32(fd)]) entonces devolver listo_objeto(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], ev) fin
        ; [etapa 8] los dispositivos (los sucesos: si hay en su cola)
        si es_de_disp(p.fd_clase[nat32(fd)]) entonces devolver listo_disp(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)], ev) fin
        ; (los archivos, siempre listos)
        devolver ev yb 0x145
    fin

    ; duerme hasta «límite» (ns de ahora_ns; nob 0: sin límite) o hasta que la
    ; consola tenga algo (si se mira)
    función espera_hasta(p: puntero a Proceso, g0: nat64, límite: nat64, con_disp: bool)
        variable ahora: nat64
        ahora := ahora_ns()
        si ahora >= límite entonces devolver fin
        ; ([etapa 9] lo despierta quien cambia algo —Sondeo64—; los sucesos del
        ; teclado y del ratón para los programas, de 10 en 10 ms como antes)
        si con_disp y límite - ahora > 10000000 entonces límite := ahora + 10000000 fin
        espera_cambio(p, g0, límite)
    fin

    ; [etapa 9] lo que pide fd a la espera: el plazo de un timerfd, y si es de los que no avisan
    función mira_espera(p: puntero a Proceso, fd: ent64, ref lt: nat64, ref disp_: bool)
        variable v: nat64
        si fd < 0 entonces devolver fin
        si no fd_bien(p, nat64(fd)) entonces devolver fin
        si es_de_disp(p.fd_clase[nat32(fd)]) entonces disp_ := cierto fin
        v := vence_de(p.fd_clase[nat32(fd)], p.fd_obj[nat32(fd)])
        si v < lt entonces lt := v fin
    fin

    ; el límite de un plazo en ms (negativo: sin límite)
    función límite_ms(ms: ent64): nat64
        si ms < 0 entonces devolver nob nat64(0) fin
        devolver ahora_ns() + nat64(ms) * 1000000
    fin

    ; el límite de un timespec (s, ns) o timeval (s, µs: escala 1000) del programa; 0: sin límite
    función límite_de(p: puntero a Proceso, v: nat64, escala: nat64, ref err: ent64): nat64
        variable ts: arreglo [2] de nat64
        err := 0
        si v = 0 entonces devolver nob nat64(0) fin
        si no copia_de(p, nat64(dirección(ts[0])), v, 16) entonces
            err := EFAULT
            devolver 0
        fin
        si ent64(ts[0]) < 0 o ts[1] * escala >= 1000000000 entonces
            err := EINVAL
            devolver 0
        fin
        si ts[0] > 1000000 entonces ts[0] := 1000000 fin
        devolver ahora_ns() + ts[0] * 1000000000 + ts[1] * escala
    fin

    ; poll y ppoll
    función sondea(p: puntero a Proceso, v: nat64, n: nat64, límite: nat64): ent64
        variable g0, lt: nat64
        variable fds: arreglo [64] de nat64
        variable i: nat32
        variable listos: ent64
        variable fd: ent64
        variable ev, rev: nat32
        variable consola, tubos_: bool
        si n > 64 entonces devolver EINVAL fin
        si n > 0 entonces
            si no copia_de(p, nat64(dirección(fds[0])), v, n * 8) entonces devolver EFAULT fin
        fin
        mientras cierto hacer
            listos := 0
            consola := falso
            tubos_ := falso
            g0 := Sondeo64.gen
            lt := límite
            i := 0
            mientras nat64(i) < n hacer
                fd := ent64(ent32(nat32(fds[i] yb 0xFFFFFFFF)))
                ev := nat32((fds[i] >> 32) yb 0xFFFF)
                rev := listo_de(p, fd, ev)
                mira_espera(p, fd, lt, tubos_)
                si fd >= 0 y rev = 0 y fd_bien(p, nat64(fd)) entonces
                    si p.fd_clase[nat32(fd)] = F_CONSOLA y ev yb 0x41 <> 0 entonces consola := cierto fin
                fin
                fds[i] := (fds[i] yb 0xFFFFFFFF) ob ((nat64(ev) yb 0xFFFF) << 32) ob (nat64(rev) << 48)
                si rev <> 0 entonces listos := listos + 1 fin
                i := i + 1
            fin
            si listos > 0 o ahora_ns() >= límite o interrumpido(p) entonces romper fin
            espera_hasta(p, g0, lt, tubos_)
        fin
        si n > 0 entonces
            si no copia_a(p, v, nat64(dirección(fds[0])), n * 8) entonces devolver EFAULT fin
        fin
        si listos = 0 y interrumpido(p) entonces devolver ERESTARTNOHAND fin
        devolver listos
    fin

    ; select y pselect6 (los descriptores hasta MAX_FD)
    función selecciona(p: puntero a Proceso, n: nat64, vr: nat64, vw: nat64, ve: nat64, límite: nat64): ent64
        variable g0, lt: nat64
        variable r, w, e, rr, ww: nat64
        variable largo: nat64
        variable i: nat32
        variable listos: ent64
        variable consola, tubos_: bool
        si n > 1024 entonces devolver EINVAL fin
        largo := ((n + 63) div 64) * 8
        si largo > 8 entonces largo := 8 fin
        r := 0
        w := 0
        e := 0
        si largo > 0 entonces
            si vr <> 0 entonces
                si no copia_de(p, nat64(dirección(r)), vr, largo) entonces devolver EFAULT fin
            fin
            si vw <> 0 entonces
                si no copia_de(p, nat64(dirección(w)), vw, largo) entonces devolver EFAULT fin
            fin
            si ve <> 0 entonces
                si no copia_de(p, nat64(dirección(e)), ve, largo) entonces devolver EFAULT fin
            fin
        fin
        si n < 64 entonces
            r := r yb ((nat64(1) << n) - 1)
            w := w yb ((nat64(1) << n) - 1)
            e := e yb ((nat64(1) << n) - 1)
        fin
        i := 0
        mientras i < 64 hacer
            si (r ob w ob e) yb (nat64(1) << i) <> 0 entonces
                si no fd_bien(p, nat64(i)) entonces devolver EBADF fin
            fin
            i := i + 1
        fin
        mientras cierto hacer
            listos := 0
            rr := 0
            ww := 0
            consola := falso
            tubos_ := falso
            g0 := Sondeo64.gen
            lt := límite
            i := 0
            mientras i < MAX_FD hacer
                si r yb (nat64(1) << i) <> 0 entonces
                    si listo_de(p, ent64(i), 1) <> 0 entonces
                        rr := rr ob (nat64(1) << i)
                        listos := listos + 1
                    sino
                        consola := cierto
                    fin
                fin
                si w yb (nat64(1) << i) <> 0 entonces
                    ; ([etapa 7] una tubería llena no está lista)
                    si listo_de(p, ent64(i), 4) <> 0 entonces
                        ww := ww ob (nat64(1) << i)
                        listos := listos + 1
                    fin
                fin
                si (r ob w) yb (nat64(1) << i) <> 0 entonces mira_espera(p, ent64(i), lt, tubos_) fin
                i := i + 1
            fin
            si listos > 0 o ahora_ns() >= límite o interrumpido(p) entonces romper fin
            espera_hasta(p, g0, lt, tubos_)
        fin
        e := 0
        si largo > 0 entonces
            si vr <> 0 entonces
                si no copia_a(p, vr, nat64(dirección(rr)), largo) entonces devolver EFAULT fin
            fin
            si vw <> 0 entonces
                si no copia_a(p, vw, nat64(dirección(ww)), largo) entonces devolver EFAULT fin
            fin
            si ve <> 0 entonces
                si no copia_a(p, ve, nat64(dirección(e)), largo) entonces devolver EFAULT fin
            fin
        fin
        si listos = 0 y interrumpido(p) entonces devolver ERESTARTNOHAND fin
        devolver listos
    fin

    ; ---- [etapa 7] las señales ----
    ; rt_sigaction: lo de cada una (la función, o SIG_DFL 0, o SIG_IGN 1;
    ; sa_flags, sa_restorer y sa_mask); SIGKILL y SIGSTOP no se pueden
    ; cambiar. Una que pasa a ignorarse deja de estar pendiente.
    función sigaction_(p: puntero a Proceso, sig: nat64, v_act: nat64, v_viejo: nat64, tam: nat64): ent64
        variable act: arreglo [4] de nat64
        variable k: nat32
        si sig < 1 o sig > 64 entonces devolver EINVAL fin
        si tam <> 8 entonces devolver EINVAL fin
        k := nat32(sig)
        si v_act <> 0 entonces
            si sig = 9 o sig = 19 entonces devolver EINVAL fin
        fin
        si v_viejo <> 0 entonces
            act[0] := p.acción[k]
            act[1] := p.acc_marcas[k]
            act[2] := p.acc_rest[k]
            act[3] := p.acc_másc[k]
            si no copia_a(p, v_viejo, nat64(dirección(act[0])), 32) entonces devolver EFAULT fin
        fin
        si v_act <> 0 entonces
            si no copia_de(p, nat64(dirección(act[0])), v_act, 32) entonces devolver EFAULT fin
            p.acción[k] := act[0]
            p.acc_marcas[k] := act[1]
            p.acc_rest[k] := act[2]
            p.acc_másc[k] := act[3] yb (nob nat64(NO_BLOQUEABLES))
            si act[0] = 1 o (act[0] = 0 y (sig = SIGCHLD o sig = SIGURG o sig = SIGWINCH o sig = SIGCONT)) entonces olvida_señal(p, sig) fin
        fin
        devolver 0
    fin

    ; rt_sigprocmask: la máscara del hilo (SIG_BLOCK 0, SIG_UNBLOCK 1,
    ; SIG_SETMASK 2); SIGKILL y SIGSTOP no se bloquean
    función sigprocmask_(p: puntero a Proceso, cómo: nat64, v_set: nat64, v_viejo: nat64, tam: nat64): ent64
        variable h: puntero a Hilo
        variable viejo, x: nat64
        si tam <> 8 entonces devolver EINVAL fin
        h := actual()
        viejo := h.s_másc
        si v_set <> 0 entonces
            si no copia_de(p, nat64(dirección(x)), v_set, 8) entonces devolver EFAULT fin
            según cómo
                caso 0: h.s_másc := (h.s_másc ob x) yb (nob nat64(NO_BLOQUEABLES))
                caso 1: h.s_másc := h.s_másc yb (nob x)
                caso 2: h.s_másc := x yb (nob nat64(NO_BLOQUEABLES))
                si no: devolver EINVAL
            fin
        fin
        si v_viejo <> 0 entonces
            si no copia_a(p, v_viejo, nat64(dirección(viejo)), 8) entonces devolver EFAULT fin
        fin
        devolver 0
    fin

    ; rt_sigpending: las pendientes que tiene bloqueadas
    función sigpending_(p: puntero a Proceso, v: nat64, tam: nat64): ent64
        variable h: puntero a Hilo
        variable x: nat64
        si tam <> 8 entonces devolver EINVAL fin
        h := actual()
        x := (h.s_pend ob p.s_pend) yb h.s_másc
        si no copia_a(p, v, nat64(dirección(x)), 8) entonces devolver EFAULT fin
        devolver 0
    fin

    ; rt_sigsuspend: con esa máscara, hasta que llegue una señal (la máscara
    ; de antes vuelve al acabar su función: uc_sigmask); y pause
    función sigsuspend_(p: puntero a Proceso, v: nat64, tam: nat64): ent64
        variable h: puntero a Hilo
        variable x: nat64
        si tam <> 8 entonces devolver EINVAL fin
        si no copia_de(p, nat64(dirección(x)), v, 8) entonces devolver EFAULT fin
        h := actual()
        h.s_guardada := h.s_másc ob (nat64(1) << 63)
        h.s_másc := x yb (nob nat64(NO_BLOQUEABLES))
        duerme_hasta(p, nob nat64(0))
        devolver ERESTARTNOHAND
    fin

    ; sigaltstack: la pila de las señales del hilo (ss_sp, ss_flags, ss_size)
    función sigaltstack_(p: puntero a Proceso, m: nat64, v_ss: nat64, v_viejo: nat64): ent64
        variable h: puntero a Hilo
        variable t: arreglo [3] de nat64
        variable sp: nat64
        variable en: bool
        h := actual()
        sp := l64(m + 144)
        en := h.alt_tam > 0 y h.alt_marcas yb 2 = 0 y sp >= h.alt_sp y sp < h.alt_sp + h.alt_tam
        si v_viejo <> 0 entonces
            t[0] := h.alt_sp
            t[1] := 0
            si h.alt_tam = 0 o h.alt_marcas yb 2 <> 0 entonces t[1] := 2 sino si en entonces t[1] := 1 fin
            t[2] := h.alt_tam
            si no copia_a(p, v_viejo, nat64(dirección(t[0])), 24) entonces devolver EFAULT fin
        fin
        si v_ss <> 0 entonces
            si no copia_de(p, nat64(dirección(t[0])), v_ss, 24) entonces devolver EFAULT fin
            si en entonces devolver EPERM fin
            t[1] := t[1] yb 0xFFFFFFFF
            si t[1] yb 2 <> 0 entonces
                h.alt_sp := 0
                h.alt_tam := 0
                h.alt_marcas := 2
            sino
                si t[1] yb 0x7FFFFFFF <> 0 entonces devolver EINVAL fin
                si t[2] < 2048 entonces devolver ENOMEM fin
                h.alt_sp := t[0]
                h.alt_tam := t[2]
                h.alt_marcas := 0
            fin
        fin
        devolver 0
    fin

    ; clone: [etapa 7] con CLONE_THREAD, un hilo (pthread_create); con
    ; CLONE_VM y CLONE_VFORK, un hijo con el espacio del padre (posix_spawn);
    ; sin CLONE_VM, como fork (con la pila nueva, si la da)
    función clone_(p: puntero a Proceso, m: nat64, marcas_: nat64, pila: nat64, v_ptid: nat64, v_ctid: nat64, tls: nat64): ent64
        si marcas_ yb 0x10000 <> 0 entonces
            si marcas_ yb 0x900 <> 0x900 entonces devolver EINVAL fin           ; CLONE_VM y CLONE_SIGHAND
            devolver crea_hilo(p, m, marcas_, pila, v_ptid, v_ctid, tls)
        fin
        si marcas_ yb 0x100 <> 0 entonces
            si marcas_ yb 0x4000 = 0 entonces devolver EINVAL fin                ; (CLONE_VM sin CLONE_VFORK: aún no)
            devolver bifurca_(p, m, cierto, pila)
        fin
        devolver bifurca_(p, m, falso, pila)
    fin

    ; [etapa 7] pipe y pipe2 (O_CLOEXEC, O_NONBLOCK)
    función tubo_(p: puntero a Proceso, v: nat64, marcas_: nat64): ent64
        variable fds: arreglo [2] de nat32
        variable a, b: ent32
        variable t: nat64
        si marcas_ yb (nob nat64(O_CLOEXEC ob O_NONBLOCK)) <> 0 entonces devolver EINVAL fin
        a := fd_libre(p, 0)
        si a < 0 entonces devolver EMFILE fin
        p.fd_clase[nat32(a)] := F_TUBO_L               ; (apartado mientras se busca el otro)
        b := fd_libre(p, 0)
        p.fd_clase[nat32(a)] := 0
        si b < 0 entonces devolver EMFILE fin
        t := nuevo_tubo()
        si t = 0 entonces devolver ENOMEM fin
        fds[0] := nat32(a)
        fds[1] := nat32(b)
        si no copia_a(p, v, nat64(dirección(fds[0])), 8) entonces
            cierra_fd_obj(F_TUBO_L, t)
            cierra_fd_obj(F_TUBO_E, t)
            devolver EFAULT
        fin
        p.fd_clase[nat32(a)] := F_TUBO_L
        p.fd_obj[nat32(a)] := t
        p.fd_clase[nat32(b)] := F_TUBO_E
        p.fd_obj[nat32(b)] := t
        p.fd_cloexec[nat32(a)] := nat32((marcas_ >> 19) yb 1)
        p.fd_cloexec[nat32(b)] := nat32((marcas_ >> 19) yb 1)
        p.fd_nobloq[nat32(a)] := nat32((marcas_ >> 11) yb 1)
        p.fd_nobloq[nat32(b)] := nat32((marcas_ >> 11) yb 1)
        devolver 0
    fin

    ; ---- [etapa 9] eventfd, timerfd, clock_settime ----
    ; un descriptor nuevo de la clase c con el objeto d (y O_NONBLOCK, O_CLOEXEC de «marcas_»)
    función fd_de_objeto(p: puntero a Proceso, c: nat32, d: nat64, marcas_: nat64): ent64
        variable fd: ent32
        fd := fd_libre(p, 0)
        si fd < 0 entonces
            cierra_objeto(nat64(c), d)
            devolver EMFILE
        fin
        p.fd_clase[nat32(fd)] := c
        p.fd_obj[nat32(fd)] := d
        p.fd_nobloq[nat32(fd)] := nat32((marcas_ >> 11) yb 1)
        p.fd_cloexec[nat32(fd)] := nat32((marcas_ >> 19) yb 1)
        devolver ent64(fd)
    fin

    función evento_(p: puntero a Proceso, inicial: nat64, marcas_: nat64): ent64
        variable d: nat64
        si marcas_ yb (nob nat64(0x80801)) <> 0 entonces devolver EINVAL fin
        d := nuevo_evento(inicial yb 0xFFFFFFFF, marcas_ yb 1 <> 0)
        si d = 0 entonces devolver ENOMEM fin
        devolver fd_de_objeto(p, F_EVENTO, d, marcas_)
    fin

    función tempo_(p: puntero a Proceso, reloj_: nat64, marcas_: nat64): ent64
        variable d: nat64
        si reloj_ <> 0 y reloj_ <> 1 y reloj_ <> 7 entonces devolver EINVAL fin
        si marcas_ yb (nob nat64(0x80800)) <> 0 entonces devolver EINVAL fin
        d := nuevo_tempo(reloj_)
        si d = 0 entonces devolver ENOMEM fin
        devolver fd_de_objeto(p, F_TEMPO, d, marcas_)
    fin

    ; timerfd_settime (pon) y timerfd_gettime
    función con_tempo(p: puntero a Proceso, fd: nat64, marcas_: nat64, v1: nat64, v2: nat64, pon: bool): ent64
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si p.fd_clase[nat32(fd)] <> F_TEMPO entonces devolver EINVAL fin
        si pon entonces devolver tempo_pon(p, p.fd_obj[nat32(fd)], marcas_, v1, v2) fin
        devolver tempo_lee_hora(p, p.fd_obj[nat32(fd)], v1)
    fin

    ; clock_settime (timespec, escala 1) y settimeofday (timeval, escala 1000): CLOCK_REALTIME
    función pon_hora(p: puntero a Proceso, reloj_: nat64, v: nat64, escala: nat64): ent64
        variable ts: arreglo [2] de nat64
        si reloj_ <> 0 entonces devolver EINVAL fin
        si v = 0 entonces devolver 0 fin
        si no copia_de(p, nat64(dirección(ts[0])), v, 16) entonces devolver EFAULT fin
        si ts[1] * escala >= 1000000000 o ts[0] >= nat64(1) << 40 entonces devolver EINVAL fin
        pon_real_ns(ts[0] * 1000000000 + ts[1] * escala)
        devolver 0
    fin

    ; [etapa 7] getrandom: RDRAND (o RDSEED), o lo del TSC si no hay
    función azar_(p: puntero a Proceso, v: nat64, n: nat64): ent64
        variable t: arreglo [512] de byte
        variable hecho, trozo: nat64
        ; [etapa 9] de Azar64 (ChaCha20 con RDSEED, RDRAND y los tiempos)
        si n > 1048576 entonces n := 1048576 fin
        hecho := 0
        mientras hecho < n hacer
            trozo := n - hecho
            si trozo > 512 entonces trozo := 512 fin
            llena(nat64(dirección(t[0])), trozo)
            si no copia_a(p, v + hecho, nat64(dirección(t[0])), trozo) entonces
                si hecho = 0 entonces devolver EFAULT fin
                devolver ent64(hecho)
            fin
            hecho := hecho + trozo
        fin
        devolver ent64(hecho)
    fin

    variable azar_x: nat64
    función un_azar(): nat64
        variable r, ok_: nat64
        variable k: nat32
        r := 0
        ok_ := 0
        k := 0
        si con_rdrand entonces
            mientras ok_ = 0 y k < 10 hacer
                ensamblador
                    xor ecx, ecx
                    db 0x48, 0x0F, 0xC7, 0xF0       ; rdrand rax
                    db 0x0F, 0x92, 0xC1             ; setc cl
                    mov {r}, rax
                    mov {ok_}, rcx
                fin
                k := k + 1
            fin
        sino si con_rdseed entonces
            mientras ok_ = 0 y k < 100 hacer
                ensamblador
                    xor ecx, ecx
                    db 0x48, 0x0F, 0xC7, 0xF8       ; rdseed rax
                    db 0x0F, 0x92, 0xC1             ; setc cl
                    mov {r}, rax
                    mov {ok_}, rcx
                fin
                k := k + 1
            fin
        fin
        ; (y siempre, mezclado con el TSC: si no hay ninguna de las dos, es lo que hay)
        azar_x := (azar_x xob tsc()) * 6364136223846793005 + 1442695040888963407
        devolver r xob (azar_x xob (azar_x >> 29))
    fin

    ; [etapa 7] prlimit64, getrlimit: los límites (los de siempre)
    función límite_rec(p: puntero a Proceso, pid: nat64, rec: nat64, v_nuevo: nat64, v_viejo: nat64): ent64
        variable l: arreglo [2] de nat64
        si pid <> 0 y pid <> p.id entonces devolver ESRCH fin
        si rec >= 16 entonces devolver EINVAL fin
        si v_viejo <> 0 entonces
            l[0] := nob nat64(0)
            l[1] := nob nat64(0)
            si rec = 3 entonces l[0] := PILA_PROG fin                    ; RLIMIT_STACK
            si rec = 7 entonces                                          ; RLIMIT_NOFILE
                l[0] := MAX_FD
                l[1] := MAX_FD
            fin
            si rec = 4 entonces l[0] := 0 fin                            ; RLIMIT_CORE
            si no copia_a(p, v_viejo, nat64(dirección(l[0])), 16) entonces devolver EFAULT fin
        fin
        devolver 0
    fin

    ; [etapa 7] sched_getaffinity: los procesadores en marcha
    función afinidad_(p: puntero a Proceso, largo: nat64, v: nat64): ent64
        variable x: nat64
        si largo < 8 entonces devolver EINVAL fin
        x := nob nat64(0)
        si n_en_marcha < 64 entonces x := (nat64(1) << nat64(n_en_marcha)) - 1 fin
        si no copia_a(p, v, nat64(dirección(x)), 8) entonces devolver EFAULT fin
        devolver 8
    fin

    ; [etapa 7] sysinfo: lo que lleva en marcha, la memoria, los procesos
    función sysinfo_(p: puntero a Proceso, v: nat64): ent64
        variable t: arreglo [14] de nat64
        variable i: nat32
        i := 0
        mientras i < 14 hacer
            t[i] := 0
            i := i + 1
        fin
        t[0] := ahora_ns() div 1000000000
        t[4] := marcos * 4096
        t[5] := libres * 4096
        t[10] := en_tabla
        t[13] := 1                      ; mem_unit
        si no copia_a(p, v, nat64(dirección(t[0])), 112) entonces devolver EFAULT fin
        devolver 0
    fin

    ; [etapa 7] lo de olvidar una señal pendiente que pasa a ignorarse
    función olvida_señal(p: puntero a Proceso, s: nat64)
        variable b, x: nat64
        variable i: nat32
        variable t: puntero a Hilo
        x := nob (nat64(1) << (s - 1))
        b := toma(dirección(p.h_cerrojo))
        p.s_pend := p.s_pend yb x
        i := 0
        mientras i < MAX_HILOS hacer
            si p.hilos[i] <> 0 entonces
                t := puntero(p.hilos[i])
                t.s_pend := t.s_pend yb x
            fin
            i := i + 1
        fin
        suelta(dirección(p.h_cerrojo), b)
    fin

    función setpgid_(p: puntero a Proceso, pid: nat64, g: nat64): ent64
        si pid <> 0 y pid <> p.id entonces devolver -3 fin          ; ESRCH (solo el suyo, por ahora)
        si ent64(g) < 0 entonces devolver EINVAL fin
        si g = 0 entonces g := p.id fin
        p.grupo := g
        devolver 0
    fin

    función desconocida(p: puntero a Proceso, n: nat64): ent64
        variable b: nat64
        p.desconocidas := p.desconocidas + 1
        si p.desconocidas <= 3 entonces
            b := toma_atento(dirección(cerrojo_consola))
            escribir("El programa ", p.nombre, " (proceso ", p.id, ") ha pedido la llamada al sistema ", n, ", que Hispa-64 aún no tiene (devuelve -ENOSYS).\n")
            suelta(dirección(cerrojo_consola), b)
        fin
        devolver ENOSYS
    fin

    ; la llamada del marco m (Entradas): el resultado, en su RAX. [etapa 7]
    ; Devuelve 1 si hay que volver con iretq (rt_sigreturn: también RCX y R11)
    función atiende(m: nat64): nat64
        variable p: puntero a Proceso
        variable h: puntero a Hilo
        variable n, a1, a2, a3, a4, a5, a6, lím, iret: nat64
        variable r: ent64
        p := mío()
        h := actual()
        n := l64(m + 112)
        a1 := l64(m + 64)
        a2 := l64(m + 72)
        a3 := l64(m + 96)
        a4 := l64(m + 40)
        a5 := l64(m + 56)
        a6 := l64(m + 48)
        iret := 0
        suma_atómica(dirección(llamadas), 1)
        según n
            caso 0: r := lee(p, a1, a2, a3, -1)
            caso 1: r := escribe(p, a1, a2, a3, -1)
            caso 2: r := abre(p, -100, a1, a2)
            caso 3: r := cierra(p, a1)
            caso 4, 6: r := stat_(p, -100, a1, a2, 0)
            caso 5: r := fstat_(p, a1, a2)
            caso 8: r := sitúa(p, a1, ent64(a2), a3)
            caso 9: r := mapea_(p, a1, a2, a3, a4, ent64(ent32(nat32(a5 yb 0xFFFFFFFF))), a6)
            caso 10: r := protege_(p, a1, a2, a3)
            caso 11: r := desmapea_(p, a1, a2)
            caso 12: r := brk_(p, a1)
            caso 7: r := sondea(p, a1, a2, límite_ms(ent64(ent32(nat32(a3 yb 0xFFFFFFFF)))))
            caso 13: r := sigaction_(p, a1, a2, a3, a4)
            caso 14: r := sigprocmask_(p, a1, a2, a3, a4)
            caso 15:
                r := vuelve_de_señal(p, m)
                iret := 1
            caso 16:
                si no fd_bien(p, a1) entonces
                    r := EBADF
                sino si p.fd_clase[nat32(a1)] = F_CONSOLA entonces
                    r := tty_ioctl(p, a2 yb 0xFFFFFFFF, a3)
                sino si p.fd_clase[nat32(a1)] = F_SOCKET entonces
                    r := ioctl_sock(p, a1, a2, a3)
                sino si es_objeto(p.fd_clase[nat32(a1)]) y a2 yb 0xFFFFFFFF = 0x5421 entonces
                    ; FIONBIO
                    si copia_de(p, nat64(dirección(lím)), a3, 4) entonces
                        p.fd_nobloq[nat32(a1)] := 0
                        si lím yb 0xFFFFFFFF <> 0 entonces p.fd_nobloq[nat32(a1)] := 1 fin
                        r := 0
                    sino
                        r := EFAULT
                    fin
                sino si es_de_disp(p.fd_clase[nat32(a1)]) entonces
                    r := ioctl_disp(p, p.fd_clase[nat32(a1)], p.fd_obj[nat32(a1)], a2, a3)
                sino si p.fd_clase[nat32(a1)] = F_TUBO_L y a2 yb 0xFFFFFFFF = 0x541B entonces
                    ; FIONREAD
                    lím := tubo_cuánto(p.fd_obj[nat32(a1)])
                    si copia_a(p, a3, nat64(dirección(lím)), 4) entonces r := 0 sino r := EFAULT fin
                sino
                    r := ENOTTY
                fin
            caso 23:
                lím := límite_de(p, a5, 1000, r)
                si r = 0 entonces r := selecciona(p, a1, a2, a3, a4, lím) fin
            caso 56: r := clone_(p, m, a1, a2, a3, a4, a5)
            caso 57, 58: r := bifurca(p, m)
            caso 59: r := ejecuta(p, m, a1, a2, a3)
            caso 61: r := espera_hijo(p, ent64(ent32(nat32(a1 yb 0xFFFFFFFF))), a2, a3, a4)
            caso 109: r := setpgid_(p, a1, a2)
            caso 110: r := ent64(p.padre)
            caso 111: r := ent64(p.grupo)
            caso 112:
                p.grupo := p.id
                r := ent64(p.id)
            caso 121, 124:
                si a1 = 0 o a1 = p.id entonces r := ent64(p.grupo) sino r := -3 fin
            caso 270:
                lím := límite_de(p, a5, 1, r)
                si r = 0 entonces r := selecciona(p, a1, a2, a3, a4, lím) fin
            caso 271:
                lím := límite_de(p, a3, 1, r)
                si r = 0 entonces r := sondea(p, a1, a2, lím) fin
            caso 17:
                si ent64(a4) < 0 entonces r := EINVAL sino r := lee(p, a1, a2, a3, ent64(a4)) fin
            caso 18:
                si ent64(a4) < 0 entonces r := EINVAL sino r := escribe(p, a1, a2, a3, ent64(a4)) fin
            caso 19: r := vectores(p, a1, a2, a3, falso)
            caso 20: r := vectores(p, a1, a2, a3, cierto)
            caso 21: r := con_ruta(p, -100, a1, 3)
            caso 24:
                cede()
                r := 0
            caso 32: r := duplica(p, a1, -1, 0)
            caso 33: r := duplica(p, a1, ent64(a2), 0)
            caso 35: r := duerme_(p, a1, a2)
            caso 39: r := ent64(p.id)
            caso 186: r := ent64(h.tid)
            caso 60: sal_hilo(a1)
            caso 231: sal(a1, 0)
            ; [etapa 7]
            caso 22: r := tubo_(p, a1, 0)
            caso 293: r := tubo_(p, a1, a2)
            caso 25: r := ENOMEM                            ; mremap: no (musl copia)
            caso 28: r := aconseja(p, a1, a2, a3)
            caso 34:
                duerme_hasta(p, nob nat64(0))
                r := ERESTARTNOHAND
            caso 62: r := mata(p, ent64(ent32(nat32(a1 yb 0xFFFFFFFF))), a2)
            caso 200: r := mata_hilo(p, 0, a1, a2)
            caso 234: r := mata_hilo(p, a1, a2, a3)
            caso 127: r := sigpending_(p, a1, a2)
            caso 130: r := sigsuspend_(p, a1, a2)
            caso 131: r := sigaltstack_(p, m, a1, a2)
            caso 202: r := futex_(p, a1, a2, a3 yb 0xFFFFFFFF, a4, a5, a6)
            caso 273:
                si a2 <> 24 entonces r := EINVAL sino
                    h.robusta := a1
                    h.robusta_largo := a2
                    r := 0
                fin
            caso 274:
                si a1 <> 0 y a1 <> h.tid entonces r := ESRCH sino
                    lím := 24
                    si copia_a(p, a2, nat64(dirección(h.robusta)), 8) y copia_a(p, a3, nat64(dirección(lím)), 8) entonces r := 0 sino r := EFAULT fin
                fin
            caso 318: r := azar_(p, a1, a2)
            ; [etapa 9] la red y lo que pide
            caso 41: r := socket_(p, a1, a2, a3)
            caso 42: r := connect_(p, a1, a2, a3)
            caso 43: r := accept_(p, a1, a2, a3, 0)
            caso 288: r := accept_(p, a1, a2, a3, a4)
            caso 44: r := sendto_(p, a1, a2, a3, a4, a5, a6)
            caso 45: r := recvfrom_(p, a1, a2, a3, a4, a5, a6)
            caso 46: r := sendmsg_(p, a1, a2, a3)
            caso 47: r := recvmsg_(p, a1, a2, a3)
            caso 48: r := shutdown_(p, a1, a2)
            caso 49: r := bind_(p, a1, a2, a3)
            caso 50: r := listen_(p, a1, a2)
            caso 51: r := nombre_sock(p, a1, a2, a3, falso)
            caso 52: r := nombre_sock(p, a1, a2, a3, cierto)
            caso 53: r := -95                              ; socketpair (AF_UNIX): EOPNOTSUPP
            caso 54: r := setsockopt_(p, a1, a2, a3, a4, a5)
            caso 55: r := getsockopt_(p, a1, a2, a3, a4, a5)
            caso 284: r := evento_(p, a1, 0)
            caso 290: r := evento_(p, a1, a2)
            caso 283: r := tempo_(p, a1, a2)
            caso 286: r := con_tempo(p, a1, a2, a3, a4, cierto)
            caso 287: r := con_tempo(p, a1, 0, a2, 0, falso)
            caso 227: r := pon_hora(p, a1, a2, 1)
            caso 164: r := pon_hora(p, 0, a1, 1000)
            caso 230: r := duerme_reloj(p, a1, a2, a3, a4)
            caso 229:
                si a2 <> 0 entonces
                    lím := 0
                    si copia_a(p, a2, nat64(dirección(lím)), 8) entonces
                        lím := 1
                        si copia_a(p, a2 + 8, nat64(dirección(lím)), 8) entonces r := 0 sino r := EFAULT fin
                    sino
                        r := EFAULT
                    fin
                sino
                    r := 0
                fin
            caso 96: r := hora_del_día(p, a1)
            caso 201:
                lím := real_s()
                r := ent64(lím)
                si a1 <> 0 entonces
                    si no copia_a(p, a1, nat64(dirección(lím)), 8) entonces r := EFAULT fin
                fin
            caso 302: r := límite_rec(p, a1, a2, a3, a4)
            caso 97: r := límite_rec(p, 0, a1, 0, a2)
            caso 160: r := 0
            caso 203: r := 0
            caso 204: r := afinidad_(p, a2, a3)
            caso 99: r := sysinfo_(p, a1)
            caso 95: r := 18                                 ; umask: 022
            caso 98: r := uso_(p, a2)
            caso 213:
                si ent64(ent32(nat32(a1 yb 0xFFFFFFFF))) <= 0 entonces r := EINVAL sino r := epoll_crea(p, 0) fin
            caso 291: r := epoll_crea(p, a1)
            caso 233: r := epoll_ctl_(p, a1, a2, a3, a4)
            caso 232: r := epoll_espera(p, a1, a2, a3, límite_ms(ent64(ent32(nat32(a4 yb 0xFFFFFFFF)))), 0)
            caso 281: r := epoll_espera(p, a1, a2, a3, límite_ms(ent64(ent32(nat32(a4 yb 0xFFFFFFFF)))), a5)
            caso 324, 334, 435, 439: r := ENOSYS             ; membarrier, rseq, clone3, faccessat2 (musl se las arregla sin ellas)
            caso 63: r := nombre_(p, a1)
            caso 72: r := fcntl_(p, a1, a2, a3)
            caso 74, 75: r := fsync_(p, a1)
            caso 76: r := trunca_ruta(p, a1, ent64(a2))
            caso 77: r := trunca_(p, a1, ent64(a2))
            caso 79: r := getcwd_(p, a1, a2)
            caso 80: r := chdir_(p, a1, -1)
            caso 81: r := chdir_(p, 0, ent64(a1))
            caso 82: r := renombra_(p, -100, a1, -100, a2)
            caso 83: r := con_ruta(p, -100, a1, 0)
            caso 84: r := con_ruta(p, -100, a1, 2)
            caso 87: r := con_ruta(p, -100, a1, 1)
            caso 102, 104, 107, 108: r := 0
            caso 158: r := arch_(p, a1, a2)
            caso 162:
                vfs_sync()
                r := 0
            caso 217: r := lista_(p, a1, a2, a3)
            caso 218:
                h.borra_tid := a1
                r := ent64(h.tid)
            caso 228: r := reloj(p, a1, a2)
            caso 257: r := abre(p, ent64(a1), a2, a3)
            caso 258: r := con_ruta(p, ent64(a1), a2, 0)
            caso 262: r := stat_(p, ent64(a1), a2, a3, a4)
            caso 263:
                si a3 yb 0x200 <> 0 entonces r := con_ruta(p, ent64(a1), a2, 2) sino r := con_ruta(p, ent64(a1), a2, 1) fin
            caso 264: r := renombra_(p, ent64(a1), a2, ent64(a3), a4)
            caso 269: r := con_ruta(p, ent64(a1), a2, 3)
            caso 292:
                si a1 = a2 entonces
                    r := EINVAL
                sino
                    r := duplica(p, a1, ent64(a2), 0)
                    si a3 yb O_CLOEXEC <> 0 entonces r := con_cloexec(p, r) fin
                fin
            caso 316:
                si a5 <> 0 entonces r := EINVAL sino r := renombra_(p, ent64(a1), a2, ent64(a3), a4) fin
            si no: r := desconocida(p, n)
        fin
        p64(m + 112, nat64(r))
        ; (las marcas_ que puede devolver sysret: las de las cuentas, con IF)
        p64(m + 136, (l64(m + 136) yb 0xCD5) ob 0x202)
        si l64(m + 120) >= TOPE entonces sal(0, SIGSEGV) fin
        ; [etapa 7] las señales (Ctrl+C, kill...), que el proceso acabe, y
        ; repetir lo interrumpido
        antes_de_volver(m, cierto, n)
        si l64(m + 120) >= TOPE entonces sal(0, SIGSEGV) fin
        devolver iret
    fin

    ; ---- [etapa 7] epoll ----
    ; Un epoll (F_EPOLL) es la lista de lo que se mira (hasta 64: el
    ; descriptor, lo que se pide y el dato del programa); epoll_wait mira cada
    ; uno como poll (listo_de) y duerme como poll (de 10 en 10 ms, o la consola,
    ; y una señal lo despierta). EPOLLONESHOT, de verdad; EPOLLET, como si no
    ; (avisa mientras siga listo: lo que se lee no se pierde). Un descriptor
    ; que se cierra sin quitarlo deja de mirarse.
    constante F_EPOLL = 5
    constante MAX_EP = 64
    tipo Epoll = estructura
        refs, n: nat64
        fd, ev, dato: arreglo [MAX_EP] de nat64
    fin

    función ep_(d: nat64): puntero a Epoll
        devolver puntero(d)
    fin

    ; las de cada descriptor de otra clase: una referencia más (dup, fork) o una menos (close)
    función otro_obj(clase: nat64, d: nat64)
        variable e: puntero a Epoll
        si clase = F_EPOLL entonces
            e := ep_(d)
            suma_atómica(dirección(e.refs), 1)
        sino si clase = F_SOCKET entonces
            otro_sock(d)
        sino si es_objeto(nat32(clase)) entonces
            otro_objeto(clase, d)
        sino si es_de_disp(nat32(clase)) entonces
            otro_disp(clase, d)
        sino
            otro_(clase, d)
        fin
    fin

    función cierra_obj(clase: nat64, d: nat64)
        variable e: puntero a Epoll
        si clase = F_EPOLL entonces
            e := ep_(d)
            si suma_atómica(dirección(e.refs), nob nat64(0)) = 1 entonces libera(puntero(d)) fin
        sino si clase = F_SOCKET entonces
            cierra_sock(d)
        sino si es_objeto(nat32(clase)) entonces
            cierra_objeto(clase, d)
        sino si es_de_disp(nat32(clase)) entonces
            cierra_disp(clase, d)
        sino
            cierra_(clase, d)
        fin
    fin

    función epoll_crea(p: puntero a Proceso, marcas_: nat64): ent64
        variable fd: ent32
        variable e: puntero a Epoll
        si marcas_ yb (nob nat64(O_CLOEXEC)) <> 0 entonces devolver EINVAL fin
        fd := fd_libre(p, 0)
        si fd < 0 entonces devolver EMFILE fin
        e := puntero(nat64(reserva(tamaño(Epoll))))
        si e = nulo entonces devolver ENOMEM fin
        ceros_mem(nat64(e), tamaño(Epoll))
        e.refs := 1
        p.fd_clase[nat32(fd)] := F_EPOLL
        p.fd_obj[nat32(fd)] := nat64(e)
        p.fd_nobloq[nat32(fd)] := 0
        p.fd_cloexec[nat32(fd)] := nat32((marcas_ >> 19) yb 1)
        devolver ent64(fd)
    fin

    función epoll_de(p: puntero a Proceso, epfd: nat64, ref err: ent64): puntero a Epoll
        err := 0
        si no fd_bien(p, epfd) entonces
            err := EBADF
            devolver nulo
        fin
        si p.fd_clase[nat32(epfd)] <> F_EPOLL entonces
            err := EINVAL
            devolver nulo
        fin
        devolver ep_(p.fd_obj[nat32(epfd)])
    fin

    ; epoll_ctl: EPOLL_CTL_ADD 1, DEL 2, MOD 3 (struct epoll_event: 4 octetos de
    ; lo que se pide y 8 del dato, juntos)
    función epoll_ctl_(p: puntero a Proceso, epfd: nat64, op: nat64, fd: nat64, v_ev: nat64): ent64
        variable e: puntero a Epoll
        variable err: ent64
        variable i, k: nat32
        variable t: arreglo [2] de nat64
        e := epoll_de(p, epfd, err)
        si e = nulo entonces devolver err fin
        si no fd_bien(p, fd) entonces devolver EBADF fin
        si fd = epfd entonces devolver EINVAL fin
        k := 0xFFFFFFFF
        i := 0
        mientras nat64(i) < e.n hacer
            si e.fd[i] = fd entonces k := i fin
            i := i + 1
        fin
        si op = 1 o op = 3 entonces
            si no copia_de(p, nat64(dirección(t[0])), v_ev, 12) entonces devolver EFAULT fin
        fin
        según op
            caso 1:
                si k <> 0xFFFFFFFF entonces devolver -17 fin          ; EEXIST
                si e.n >= MAX_EP entonces devolver -28 fin           ; ENOSPC
                k := nat32(e.n)
                e.n := e.n + 1
                e.fd[k] := fd
                e.ev[k] := t[0] yb 0xFFFFFFFF
                e.dato[k] := (t[0] >> 32) ob (t[1] << 32)
            caso 2:
                si k = 0xFFFFFFFF entonces devolver ENOENT fin
                e.n := e.n - 1
                e.fd[k] := e.fd[nat32(e.n)]
                e.ev[k] := e.ev[nat32(e.n)]
                e.dato[k] := e.dato[nat32(e.n)]
            caso 3:
                si k = 0xFFFFFFFF entonces devolver ENOENT fin
                e.ev[k] := t[0] yb 0xFFFFFFFF
                e.dato[k] := (t[0] >> 32) ob (t[1] << 32)
            si no: devolver EINVAL
        fin
        devolver 0
    fin

    ; epoll_wait y epoll_pwait (con la máscara de señales de mientras, si la da)
    función epoll_espera(p: puntero a Proceso, epfd: nat64, v_evs: nat64, máx: nat64, límite: nat64, v_másc: nat64): ent64
        variable e: puntero a Epoll
        variable err, n: ent64
        variable i: nat32
        variable fd, ev, rev, x, vieja: nat64
        variable buf: puntero a nat32
        variable consola, tubos_, con_másc: bool
        variable h: puntero a Hilo
        variable g0, lt: nat64
        e := epoll_de(p, epfd, err)
        si e = nulo entonces devolver err fin
        si ent64(ent32(nat32(máx yb 0xFFFFFFFF))) <= 0 o máx > 1024 entonces devolver EINVAL fin
        h := actual()
        con_másc := falso
        vieja := h.s_másc
        si v_másc <> 0 entonces
            si no copia_de(p, nat64(dirección(x)), v_másc, 8) entonces devolver EFAULT fin
            h.s_másc := x yb (nob nat64(NO_BLOQUEABLES))
            con_másc := cierto
        fin
        buf := puntero(nat64(reserva(máx * 12 + 16)))
        si buf = nulo entonces devolver ENOMEM fin
        n := 0
        mientras cierto hacer
            n := 0
            consola := falso
            tubos_ := falso
            g0 := Sondeo64.gen
            lt := límite
            i := 0
            mientras nat64(i) < e.n y nat64(n) < máx hacer
                fd := e.fd[i]
                ev := e.ev[i]
                si fd_bien(p, fd) y ev yb 0xFFFF <> 0 entonces
                    rev := nat64(listo_de(p, ent64(fd), nat32(ev yb 0xFFFF) ob 0x18))
                    si rev <> 0 entonces
                        buf[nat32(n) * 3] := nat32(rev)
                        buf[nat32(n) * 3 + 1] := nat32(e.dato[i] yb 0xFFFFFFFF)
                        buf[nat32(n) * 3 + 2] := nat32(e.dato[i] >> 32)
                        n := n + 1
                        ; (EPOLLONESHOT: no avisa más hasta otro EPOLL_CTL_MOD)
                        si ev yb 0x40000000 <> 0 entonces e.ev[i] := ev yb 0xFFFF0000 fin
                    sino
                        si p.fd_clase[nat32(fd)] = F_CONSOLA entonces consola := cierto fin
                        mira_espera(p, ent64(fd), lt, tubos_)
                    fin
                fin
                i := i + 1
            fin
            si n > 0 o ahora_ns() >= límite o interrumpido(p) entonces romper fin
            espera_hasta(p, g0, lt, tubos_)
        fin
        si n > 0 entonces
            si no copia_a(p, v_evs, nat64(buf), nat64(n) * 12) entonces n := EFAULT fin
        sino si interrumpido(p) entonces
            n := EINTR
        fin
        libera(puntero(nat64(buf)))
        si con_másc entonces h.s_másc := vieja fin
        devolver n
    fin

    ; [etapa 7] gettimeofday
    función hora_del_día(p: puntero a Proceso, v: nat64): ent64
        variable tv: arreglo [2] de nat64
        variable ns: nat64
        si v = 0 entonces devolver 0 fin
        ns := real_ns()
        tv[0] := ns div 1000000000
        tv[1] := (ns mod 1000000000) div 1000
        si no copia_a(p, v, nat64(dirección(tv[0])), 16) entonces devolver EFAULT fin
        devolver 0
    fin

    ; [etapa 7] getrusage: a cero
    función uso_(p: puntero a Proceso, v: nat64): ent64
        variable ru: arreglo [18] de nat64
        ceros_mem(nat64(dirección(ru[0])), 144)
        si no copia_a(p, v, nat64(dirección(ru[0])), 144) entonces devolver EFAULT fin
        devolver 0
    fin

    ; las llamadas al sistema, en marcha (después de Procesos.prepara_procesos)
    público función prepara_sistema()
        prepara_futex()
        prepara_tubos()
        al_otro_fd := nat64(dirección(otro_obj))
        al_cierra_fd := nat64(dirección(cierra_obj))
        al_sistema := nat64(dirección(atiende))
    fin

fin Sistema.
