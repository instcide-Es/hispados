; =============================================================================
;  apic64.cas - Hispa-64: las interrupciones (docs/64/HISPA-64.md, etapa 2), sin
;  el 8259 (se le cambian los vectores y se tapa entero: así una interrupción
;  suya «espuria» no parece una excepción) y sin el 8254:
;    - el APIC local, en x2APIC si el procesador lo tiene (por los MSR; si no,
;      por su memoria, sin caché), con su temporizador medido contra el reloj
;      (el HPET, o el de ACPI, o, si no hay otro, el canal 2 del 8254) y puesto
;      a dar el tic del núcleo (100 por segundo; el vector 0x40);
;    - los IOAPIC de la MADT: todas sus entradas tapadas, y las que se piden
;      (una IRQ de ISA, con los cambios de la MADT; o una GSI) a un vector,
;      hacia el procesador que arranca;
;    - lo que atiende: el tic, el teclado PS/2 (la IRQ 1: guarda los códigos),
;      la SCI de ACPI (el botón de encendido), una prueba (el vector 0x32) y la
;      espuria del APIC.
;  Lo que es de cada procesador (su APIC, sus tics) va por PorCpu64.
;  [etapa 3] Los avisos entre procesadores (IPI: ipi, ipi_a_los_demás; los
;  usa Smp64 para encenderlos, vaciar la TLB y parar, y Hilos64 para que
;  replanifique otro) y el tic de cada uno, que llama al planificador (al_tic).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Apic64

    importar Cifras64, Pagina64, Es64, Acpi64, Reloj64, Excep64, Cpu64, PorCpu64, Cerrojo

    público constante V_ISA = 0x30              ; las IRQ de ISA, desde aquí (0x31 el teclado)
    público constante V_PRUEBA = 0x3E
    público constante V_TIC = 0x40
    público constante V_ERROR = 0xFE
    público constante V_ESPURIA = 0xFF
    público constante HZ = 100

    público variable x2: bool                   ; ¿en x2APIC?
    público variable lapic: nat64               ; (xAPIC) dónde se ven sus registros
    público variable lapic_base: nat64          ; la física (del MSR)
    público variable por_10ms: nat32            ; cuentas del temporizador en 10 ms (dividido entre 16)
    público variable medido_con: puntero a byte
    público variable tic_va: bool
    público variable n_espurias, n_prueba, n_sci, n_botón, n_otras: nat64
    ; el teclado: los códigos que llegan (una cola)
    variable cola: arreglo [64] de byte
    público variable cola_pon, cola_toma: nat32
    público variable teclado_gsi: nat32
    ; [etapa 6] si no es 0, la función (de Teclas64) que recibe cada código del
    ; teclado, al_teclado(código), en vez de la cola
    público variable al_teclado: nat64
    ; los IOAPIC, ya a la vista
    variable io_v: arreglo [8] de nat64
    variable io_n: arreglo [8] de nat32         ; cuántas entradas tiene cada uno
    público variable sci_gsi: nat32
    público variable botón: bool                ; se ha pulsado el botón de encendido
    público variable al_tic: nat64              ; [etapa 3] lo que se hace en cada tic (Hilos64)

    ; ---- el APIC local ----
    público función apic_lee(r: nat32): nat32
        si x2 entonces devolver nat32(lee_msr(0x800 + (r >> 4))) fin
        devolver m32(lapic + r)
    fin

    público función apic_pon(r: nat32, v: nat32)
        si x2 entonces
            pon_msr(0x800 + (r >> 4), nat64(v))
        sino
            pon_m32(lapic + r, v)
        fin
    fin

    público función eoi()
        si x2 entonces pon_msr(0x80B, 0) sino pon_m32(lapic + 0xB0, 0) fin
    fin

    ; el número de APIC de este procesador
    público función mi_id(): nat32
        si x2 entonces devolver nat32(lee_msr(0x802)) fin
        devolver m32(lapic + 0x20) >> 24
    fin

    ; el 8259: los vectores a 0x20-0x2F (lejos de las excepciones) y tapado
    función tapa_8259()
        sale8(0x20, 0x11)
        sale8(0xA0, 0x11)
        sale8(0x21, 0x20)
        sale8(0xA1, 0x28)
        sale8(0x21, 4)
        sale8(0xA1, 2)
        sale8(0x21, 1)
        sale8(0xA1, 1)
        sale8(0x21, 0xFF)
        sale8(0xA1, 0xFF)
    fin

    ; pone el APIC local de este procesador (el BSP ahora; en la etapa 3, cada uno)
    público función pon_lapic()
        variable b: nat64
        variable c: puntero a Cpu
        b := lee_msr(0x1B)
        ; (de apagado a x2APIC no se puede ir de una vez: antes, a xAPIC)
        si b yb 0x800 = 0 entonces
            b := b ob 0x800                         ; encendido
            pon_msr(0x1B, b)
        fin
        si x2apic y b yb 0x400 = 0 entonces
            b := b ob 0xC00                         ; en x2APIC
            pon_msr(0x1B, b)
        fin
        x2 := b yb 0x400 <> 0
        lapic_base := b yb (nob nat64(0xFFF))
        lapic_base := lapic_base yb ((nat64(1) << 52) - 1)
        si no x2 y lapic = 0 entonces lapic := mapea_disp(lapic_base, 0x1000, sin_caché()) fin
        apic_pon(0x80, 0)                                ; TPR: todas
        apic_pon(0xF0, 0x100 ob V_ESPURIA)               ; encendido, con su vector espurio
        apic_pon(0x350, 0x10000)                         ; LINT0 tapada (el 8259)
        si nmi_lint = 0 entonces apic_pon(0x350, 0x400) sino apic_pon(0x360, 0x400) fin   ; el NMI
        apic_pon(0x370, V_ERROR)                         ; los errores del APIC
        apic_pon(0x320, 0x10000)                         ; el temporizador, tapado
        apic_pon(0x280, 0)
        apic_pon(0x280, 0)
        eoi()
        c := yo()
        c.apic := mi_id()
    fin

    ; ---- los IOAPIC ----
    función io_lee(i: nat32, r: nat32): nat32
        pon_m32(io_v[i], r)
        devolver m32(io_v[i] + 0x10)
    fin

    función io_pon(i: nat32, r: nat32, v: nat32)
        pon_m32(io_v[i], r)
        pon_m32(io_v[i] + 0x10, v)
    fin

    público función entradas(i: nat32): nat32
        devolver io_n[i]
    fin

    público función versión_io(i: nat32): nat32
        devolver io_lee(i, 1) yb 0xFF
    fin

    función pon_ioapics()
        variable i, k: nat32
        i := 0
        mientras i < n_ioapic hacer
            io_v[i] := mapea_disp(io_fís[i], 0x20, sin_caché())
            io_n[i] := ((io_lee(i, 1) >> 16) yb 0xFF) + 1
            k := 0
            mientras k < io_n[i] hacer
                io_pon(i, 0x10 + k * 2, 0x10000)    ; tapada
                k := k + 1
            fin
            i := i + 1
        fin
    fin

    ; la GSI g al vector v (con las marcas de la MADT: polaridad y disparo, MPS
    ; INTI; las de ISA, por flanco y altas si no dicen otra cosa), hacia este
    ; procesador; falso si ningún IOAPIC la lleva
    público función dirige(g: nat32, v: nat32, marcas: nat32, isa: bool): bool
        variable i, k, bajo, pol, disp: nat32
        variable c: puntero a Cpu
        c := yo()
        i := 0
        mientras i < n_ioapic hacer
            si g >= io_gsi[i] y g < io_gsi[i] + io_n[i] entonces
                k := g - io_gsi[i]
                pol := marcas yb 3
                disp := (marcas >> 2) yb 3
                bajo := v
                ; activa en bajo: 3; por nivel: 3 (o, sin decir, lo de PCI si no es de ISA)
                si pol = 3 o (pol = 0 y no isa) entonces bajo := bajo ob 0x2000 fin
                si disp = 3 o (disp = 0 y no isa) entonces bajo := bajo ob 0x8000 fin
                io_pon(i, 0x11 + k * 2, c.apic << 24)
                io_pon(i, 0x10 + k * 2, bajo)
                devolver cierto
            fin
            i := i + 1
        fin
        devolver falso
    fin

    público función tapa(g: nat32)
        variable i, k: nat32
        i := 0
        mientras i < n_ioapic hacer
            si g >= io_gsi[i] y g < io_gsi[i] + io_n[i] entonces
                k := g - io_gsi[i]
                io_pon(i, 0x10 + k * 2, io_lee(i, 0x10 + k * 2) ob 0x10000)
            fin
            i := i + 1
        fin
    fin

    ; una IRQ de ISA al vector v; devuelve su GSI
    público función dirige_isa(irq: nat32, v: nat32): nat32
        variable m, g: nat32
        g := gsi_de(irq, m)
        si dirige(g, v, m, cierto) entonces devolver g fin
        devolver 0xFFFFFFFF
    fin

    ; ---- [etapa 3] los avisos entre procesadores (IPI) ----
    ; espera a que el APIC haya mandado el aviso anterior (xAPIC: el bit 12)
    función espera_envío()
        variable i: nat32
        si x2 entonces devolver fin
        i := 0
        mientras m32(lapic + 0x300) yb 0x1000 <> 0 y i < 1000000 hacer
            pausa()
            i := i + 1
        fin
    fin

    ; manda un aviso (la parte baja del ICR: el vector y el modo) al APIC «a»
    público función ipi(a: nat32, bajo: nat32)
        variable b: nat64
        b := sin_ints()
        si x2 entonces
            pon_msr(0x830, (nat64(a) << 32) ob bajo)
        sino
            espera_envío()
            pon_m32(lapic + 0x310, a << 24)
            pon_m32(lapic + 0x300, bajo)
            espera_envío()
        fin
        restaura(b)
    fin

    ; a todos los demás procesadores (la abreviatura «todos menos yo»)
    público función ipi_a_los_demás(bajo: nat32)
        variable b: nat64
        b := sin_ints()
        si x2 entonces
            pon_msr(0x830, nat64(bajo ob 0xC0000))
        sino
            espera_envío()
            pon_m32(lapic + 0x310, 0)
            pon_m32(lapic + 0x300, bajo ob 0xC0000)
            espera_envío()
        fin
        restaura(b)
    fin

    función llama0(f: nat64)
        ensamblador
            mov rax, {f}
            call rax
        fin
    fin

    función llama1(f: nat64, a: nat64)
        ensamblador
            push qword {a}
            mov rax, {f}
            call rax
        fin
    fin

    ; ---- lo que se atiende ----
    interrupción función tic()
        variable c: puntero a Cpu
        variable t, d, p: nat64
        c := yo()
        c.tics := c.tics + 1
        ; [etapa 11 b] si el procesador ha estado parado desde fuera (en una
        ; máquina virtual, el anfitrión cargado no le da su hilo), los tics del
        ; temporizador de ese rato se juntan en uno (el APIC no guarda más de
        ; uno pendiente): se cuentan los que faltan por el TSC, para que las
        ; medidas del tiempo sepan qué parte no es del sistema
        si tsc_hz <> 0 entonces
            t := tsc()
            si c.tsc_tic <> 0 entonces
                d := t - c.tsc_tic
                p := tsc_hz div HZ
                si d > p + p div 2 entonces
                    c.perdidos := c.perdidos + (d + p div 2) div p - 1
                    c.huecos := c.huecos + 1
                fin
            fin
            c.tsc_tic := t
        fin
        eoi()
        si al_tic <> 0 entonces llama0(al_tic) fin
    fin

    interrupción función espuria()
        n_espurias := n_espurias + 1
    fin

    interrupción función espuria_8259()
        n_espurias := n_espurias + 1
    fin

    interrupción función error_apic()
        apic_pon(0x280, 0)
        eoi()
    fin

    interrupción función prueba()
        n_prueba := n_prueba + 1
        eoi()
    fin

    interrupción función teclado()
        variable c: nat32
        mientras entra8(0x64) yb 1 <> 0 hacer
            c := entra8(0x60)
            si al_teclado <> 0 entonces
                llama1(al_teclado, nat64(c))
            sino si cola_pon - cola_toma < 64 entonces
                cola[cola_pon yb 63] := byte(c)
                cola_pon := cola_pon + 1
            fin
        fin
        eoi()
    fin

    interrupción función sci_acpi()
        n_sci := n_sci + 1
        si botón_pulsado() entonces
            botón := cierto
            n_botón := n_botón + 1
        sino
            ; algo que no se sabe atender (sin AML): si no para, se tapa la SCI
            n_otras := n_otras + 1
            si n_otras >= 1000 y sci_gsi <> 0xFFFFFFFF entonces tapa(sci_gsi) fin
        fin
        eoi()
    fin

    ; el siguiente código del teclado, o -1
    público función tecla(): ent32
        variable c: byte
        si cola_toma = cola_pon entonces devolver -1 fin
        c := cola[cola_toma yb 63]
        cola_toma := cola_toma + 1
        devolver ent32(c)
    fin

    ; ---- el temporizador del APIC local ----
    ; [etapa 11 b] su cuenta (CCR) y la hora, leídas juntas: la hora antes y
    ; después de la cuenta, y solo si entre las dos hay poco (si no, otra
    ; vez; la primera vez también se repite, que en el TCG de QEMU traducir
    ; el código ya es un rato). Antes se ponía la cuenta y luego se leía la
    ; hora, y lo que pasara entre las dos (traducir el código, el anfitrión
    ; sin darle su hilo al procesador) se contaba como del temporizador, que
    ; salía lento: con el servidor cargado, 72 tics en 1 s en vez de 100
    variable muestra_ns: nat64
    función muestra_ccr(): nat64
        variable ta, tb, c, mejor, mc, mt: nat64
        variable i: nat32
        mejor := 0xFFFFFFFFFFFFFFFF
        i := 0
        mientras i < 8 hacer
            ta := ahora_ns()
            c := nat64(apic_lee(0x390))
            tb := ahora_ns()
            si tb - ta < mejor entonces
                mejor := tb - ta
                mc := c
                mt := ta + (tb - ta) div 2
            fin
            si i >= 1 y mejor < 20000 entonces i := 8 sino i := i + 1 fin
        fin
        muestra_ns := mt
        devolver mc
    fin

    ; cuántas cuentas da en 10 ms (dividido entre 16), con el reloj que haya
    función mide(): nat32
        variable t0, c0, c1: nat64
        apic_pon(0x3E0, 3)                               ; entre 16
        apic_pon(0x320, 0x10000 ob V_TIC)                ; tapado, de una vez
        si fuente <> NINGUNO entonces
            ; 20 ms entre dos muestras de la cuenta y la hora, leídas juntas
            apic_pon(0x380, 0xFFFFFFFF)
            c0 := muestra_ccr()
            t0 := muestra_ns
            mientras ahora_ns() - t0 < 20000000 hacer pausa() fin
            c1 := muestra_ccr()
            si fuente = HPET entonces medido_con := "el HPET" sino medido_con := "el reloj de ACPI" fin
            si c1 >= c0 o muestra_ns <= t0 entonces devolver 0 fin
            devolver nat32(muldiv(c0 - c1, 10000000, muestra_ns - t0))
        sino
            apic_pon(0x380, 0xFFFFFFFF)
            si no diez_ms_pit() entonces devolver 0 fin
            medido_con := "el canal 2 del 8254"
        fin
        devolver 0xFFFFFFFF - apic_lee(0x390)
    fin

    ; pone el tic: el temporizador del APIC, periódico, HZ por segundo
    público función pon_tic(): bool
        variable c: puntero a Cpu
        si por_10ms = 0 entonces por_10ms := mide() fin
        si por_10ms < 10 entonces devolver falso fin
        apic_pon(0x3E0, 3)
        apic_pon(0x320, 0x20000 ob V_TIC)                ; periódico
        apic_pon(0x380, por_10ms * 100 div HZ)
        c := yo()
        c.tsc_tic := 0
        tic_va := cierto
        devolver cierto
    fin

    público función para_tic()
        variable c: puntero a Cpu
        apic_pon(0x320, 0x10000 ob V_TIC)
        c := yo()
        c.tsc_tic := 0
        tic_va := falso
    fin

    ; [etapa 11 b] cada cuánto da el tic el temporizador del APIC, en
    ; microsegundos, medido contra el TSC (no contra los tics que llegan, que
    ; en una máquina virtual cargada se pierden): su cuenta (CCR) y el TSC,
    ; leídos juntos (el TSC antes y después de la cuenta, y solo si entre
    ; los dos hay poco), al principio y al final de 4 ms en los que la cuenta
    ; no da la vuelta (si la da, otra vez). Lo que el procesador esté parado
    ; desde fuera entre medias no cambia nada: la cuenta y el TSC siguen.
    ; 0 si no se puede (sin TSC medido o sin tic)
    variable ccr_tsc: nat64
    función ccr_y_tsc(): nat64
        variable ta, tb, c, mejor, mc, i: nat64
        mejor := 0xFFFFFFFFFFFFFFFF
        i := 0
        mientras i < 8 hacer
            ta := tsc()
            c := nat64(apic_lee(0x390))
            tb := tsc()
            si tb - ta < mejor entonces
                mejor := tb - ta
                mc := c
                ccr_tsc := ta + (tb - ta) div 2
            fin
            i := i + 1
        fin
        devolver mc
    fin

    público función periodo_tic_us(): nat64
        variable c0, c1, t0, t1, ini, n: nat64
        si tsc_hz = 0 o no tic_va entonces devolver 0 fin
        ini := nat64(apic_lee(0x380))
        n := 0
        mientras n < 10 hacer
            c0 := ccr_y_tsc()
            t0 := ccr_tsc
            ; (que no dé la vuelta en los 4 ms: si queda poco, se espera a la siguiente)
            si c0 > ini div 2 entonces
                mientras tsc() - t0 < tsc_hz div 250 hacer pausa() fin
                c1 := ccr_y_tsc()
                t1 := ccr_tsc
                si c1 < c0 y t1 > t0 entonces
                    ; ini cuentas, a (c0 - c1) cuentas por (t1 - t0) vueltas del TSC
                    devolver muldiv(muldiv(ini, t1 - t0, c0 - c1), 1000000, tsc_hz)
                fin
            sino
                mientras tsc() - t0 < tsc_hz div 500 hacer pausa() fin
            fin
            n := n + 1
        fin
        devolver 0
    fin

    ; todo lo de las interrupciones del procesador que arranca
    público función prepara_apic()
        pon_vector(V_TIC, nat64(dirección(tic)))
        pon_vector(V_ESPURIA, nat64(dirección(espuria)))
        pon_vector(0x27, nat64(dirección(espuria_8259)))
        pon_vector(0x2F, nat64(dirección(espuria_8259)))
        pon_vector(V_ERROR, nat64(dirección(error_apic)))
        pon_vector(V_PRUEBA, nat64(dirección(prueba)))
        pon_vector(V_ISA + 1, nat64(dirección(teclado)))
        pon_vector(V_ISA + 9, nat64(dirección(sci_acpi)))
        tapa_8259()
        pon_lapic()
        pon_ioapics()
        teclado_gsi := 0xFFFFFFFF
        sci_gsi := 0xFFFFFFFF
    fin

    ; el teclado PS/2 (la IRQ 1), si hay 8042
    público función pon_teclado(): bool
        variable i: nat32
        si entra8(0x64) = 0xFF entonces devolver falso fin
        i := 0
        mientras entra8(0x64) yb 1 <> 0 y i < 64 hacer
            entra8(0x60)
            i := i + 1
        fin
        teclado_gsi := dirige_isa(1, V_ISA + 1)
        devolver teclado_gsi <> 0xFFFFFFFF
    fin

    ; la SCI de ACPI (su GSI la dice la FADT; si es de ISA, con su cambio)
    público función pon_sci(): bool
        variable m, g: nat32
        si sci = 0 y no hay_fadt entonces devolver falso fin
        g := sci
        m := 0
        si sci < 16 entonces g := gsi_de(sci, m) fin
        ; la SCI es por nivel y activa en bajo si la MADT no dice otra cosa
        si m = 0 entonces m := 0xF fin
        si no dirige(g, V_ISA + 9, m, falso) entonces devolver falso fin
        sci_gsi := g
        devolver cierto
    fin

fin Apic64.
