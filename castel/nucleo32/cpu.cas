; =============================================================================
;  cpu.cas - lo del procesador y la placa en el núcleo de Hispa-Pentium: la
;  tabla de descriptores (GDT) con los segmentos del anillo 0 y del anillo 3 y
;  el TSS; la tabla de interrupciones (IDT); los dos 8259 y el reloj 8253; y
;  las piezas sueltas que solo se dicen en ensamblador (CR0, CR2, CR3, cli y
;  sti, parar el procesador).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Cpu

    ; ---- los selectores de la GDT ----
    público constante CÓDIGO_NÚCLEO = 0x08
    público constante DATOS_NÚCLEO = 0x10
    público constante CÓDIGO_USUARIO = 0x1B      ; 0x18, con el anillo 3 en sus dos bits bajos
    público constante DATOS_USUARIO = 0x23       ; 0x20 | 3
    público constante SEL_TSS = 0x28
    ; [WIN32] los de los programas de Windows (win32.cas, docs/pentium/WIN32.md):
    ; código y datos del anillo 3 con base 0x40000000 (la dirección 0 del
    ; programa es la 0x40000000 de verdad) y su TEB (FS)
    público constante CÓDIGO_WIN32 = 0x33
    público constante DATOS_WIN32 = 0x3B
    público constante TEB_WIN32 = 0x43
    público constante BASE_WIN32 = 0x40000000
    público constante TEB_LINEAL = 0xBFBF0000   ; (por debajo de la zona de la pila)

    ; ---- las clases de puerta de la IDT ----
    público constante PUERTA_NÚCLEO = 0x8E       ; interrupción de 32 bits, presente, anillo 0
    público constante PUERTA_USUARIO = 0xEE      ; lo mismo, pero se puede llamar desde el anillo 3

    ; ---- los puertos ----
    público constante PIC1 = 0x20                ; el controlador principal (y 0x21, sus datos)
    público constante PIC2 = 0xA0                ; el secundario (y 0xA1)
    público constante FIN_INT = 0x20             ; «fin de interrupción»
    constante PIT_CANAL0 = 0x40
    constante PIT_ORDEN = 0x43
    constante PIT_HZ = 1193182
    público constante HZ = 100                   ; los tics del reloj por segundo

    tipo Puerta = estructura                    ; una entrada de la IDT (8 octetos)
        desp_bajo: nat16
        selector: nat16
        cero: byte
        clase: byte
        desp_alto: nat16
    fin
    tipo Registro_tabla = estructura            ; lo que cargan «lgdt» y «lidt»
        límite: nat16
        base: nat32
    fin

    variable idt: arreglo [256] de Puerta
    variable idtr: Registro_tabla
    ; la GDT: cada descriptor, dos palabras de 32 bits
    variable gdt: arreglo [18] de nat32         ; [WIN32] 18: tres más
    variable gdtr: Registro_tabla
    ; el TSS: de él solo se usan ESP0 y SS0 (la pila del anillo 0 que el
    ; procesador toma al entrar desde el anillo 3)
    variable tss: arreglo [26] de nat32

    ; -------------------------------------------------------------------------
    ;  La GDT y el TSS
    ; -------------------------------------------------------------------------
    ; la GDT nueva: la del arranque (código y datos del núcleo, planos) y, detrás,
    ; los mismos del anillo 3 y el TSS. Los registros de datos se quedan con el
    ; selector de datos del usuario (plano también, y el anillo 0 lo puede usar):
    ; así, al pasar a una tarea del anillo 3, no hay que tocarlos. La pila del
    ; núcleo (SS) sí es la del anillo 0.
    público función prepara_gdt()
        variable b: nat32
        gdt[0] := 0
        gdt[1] := 0
        gdt[2] := 0x0000FFFF                    ; 0x08: código, anillo 0, 4 GB
        gdt[3] := 0x00CF9A00
        gdt[4] := 0x0000FFFF                    ; 0x10: datos, anillo 0
        gdt[5] := 0x00CF9200
        gdt[6] := 0x0000FFFF                    ; 0x18: código, anillo 3
        gdt[7] := 0x00CFFA00
        gdt[8] := 0x0000FFFF                    ; 0x20: datos, anillo 3
        gdt[9] := 0x00CFF200
        b := nat32(dirección(tss))              ; 0x28: el TSS (de 32 bits, libre), 104 octetos
        gdt[10] := (b << 16) ob (tamaño(tss) - 1)
        gdt[11] := (b yb 0xFF000000) ob 0x00008900 ob ((b >> 16) yb 0xFF)
        ; [WIN32] 0x30, 0x38: código y datos del anillo 3 desde 0x40000000,
        ; 2 GB (hasta 0xBFFFFFFF); 0x40: la TEB de los programas Win32, 4 K
        gdt[12] := 0x0000FFFF
        gdt[13] := 0x40C7FA00
        gdt[14] := 0x0000FFFF
        gdt[15] := 0x40C7F200
        gdt[16] := 0x00000FFF
        gdt[17] := 0xBF40F2BF
        tss[2] := DATOS_NÚCLEO                  ; SS0
        tss[25] := nat32(tamaño(tss)) << 16     ; sin mapa de puertos (cae fuera del TSS)
        gdtr.límite := tamaño(gdt) - 1
        gdtr.base := nat32(dirección(gdt))
        ensamblador
            lgdt {gdtr}
            mov ax, {DATOS_USUARIO}
            mov ds, ax
            mov es, ax
            mov fs, ax
            mov gs, ax
            mov ax, {DATOS_NÚCLEO}
            mov ss, ax
            mov ax, {SEL_TSS}
            ltr ax
        fin
    fin

    ; la pila del anillo 0 de la tarea que va a correr (su tope)
    público función pon_pila_núcleo(tope: nat32)
        tss[1] := tope
    fin

    público función pila_núcleo(): nat32
        devolver tss[1]
    fin

    ; -------------------------------------------------------------------------
    ;  La IDT
    ; -------------------------------------------------------------------------
    público función pon_puerta(n: nat32, rutina: nat32, clase: byte)
        idt[n].desp_bajo := rutina
        idt[n].selector := CÓDIGO_NÚCLEO
        idt[n].cero := 0
        idt[n].clase := clase
        idt[n].desp_alto := rutina >> 16
    fin

    público función carga_idt()
        idtr.límite := tamaño(idt) - 1
        idtr.base := nat32(dirección(idt))
        ensamblador
            lidt {idtr}
        fin
    fin

    ; los dos 8259, a 0x20-0x27 y 0x28-0x2F (la BIOS los deja encima de las
    ; excepciones); todas las líneas tapadas menos el reloj (0) y el teclado (1)
    público función prepara_pic()
        sacar_puerto(PIC1, 0x11)
        sacar_puerto(PIC2, 0x11)
        sacar_puerto(PIC1 + 1, 0x20)
        sacar_puerto(PIC2 + 1, 0x28)
        sacar_puerto(PIC1 + 1, 4)
        sacar_puerto(PIC2 + 1, 2)
        sacar_puerto(PIC1 + 1, 1)
        sacar_puerto(PIC2 + 1, 1)
        sacar_puerto(PIC1 + 1, 0xFC)
        sacar_puerto(PIC2 + 1, 0xFF)
    fin

    público función prepara_reloj()
        variable divisor: nat32
        divisor := PIT_HZ div HZ
        sacar_puerto(PIT_ORDEN, 0x36)           ; canal 0, las dos mitades, onda cuadrada
        sacar_puerto(PIT_CANAL0, divisor)
        sacar_puerto(PIT_CANAL0, divisor >> 8)
    fin

    ; -------------------------------------------------------------------------
    ;  Las interrupciones, quietas o no
    ; -------------------------------------------------------------------------
    ; tapa las interrupciones y dice cómo estaban (las banderas): para un trozo
    ; que no se puede cortar a medias. Detrás, reponer(lo que ha dado).
    público función sin_interrupciones(): nat32
        ensamblador
            pushfd
            pop eax
            cli
        fin
    fin

    público función reponer(antes: nat32)
        si antes yb 0x200 <> 0 entonces
            ensamblador
                sti
            fin
        fin
    fin

    público función permitir_interrupciones()
        ensamblador
            sti
        fin
    fin

    ; espera a la interrupción siguiente (con «hlt»: el procesador descansa)
    público función esperar_interrupción()
        ensamblador
            sti
            hlt
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Los registros de control
    ; -------------------------------------------------------------------------
    público función leer_cr0(): nat32
        ensamblador
            mov eax, cr0
        fin
    fin

    ; la dirección que ha causado el último fallo de página
    público función leer_cr2(): nat32
        ensamblador
            mov eax, cr2
        fin
    fin

    ; el directorio de páginas en uso (su dirección física)
    público función leer_cr3(): nat32
        ensamblador
            mov eax, cr3
        fin
    fin

    ; cambia de directorio (y, con ello, vacía lo que el procesador recordaba
    ; de las páginas: la TLB)
    público función poner_cr3(directorio: nat32)
        ensamblador
            mov eax, {directorio}
            mov cr3, eax
        fin
    fin

    ; enciende la paginación (CR0.PG) con ese directorio
    público función activar_paginación(directorio: nat32)
        ensamblador
            mov eax, {directorio}
            mov cr3, eax
            mov eax, cr0
            or eax, 0x80000000
            mov cr0, eax
        fin
    fin

fin Cpu.
