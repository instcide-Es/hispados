; =============================================================================
;  llamadas.cas - las llamadas al sistema de Hispa-Pentium, para los programas
;  del anillo 3 («modelo usuario»): el teclado, los archivos del disco (leer,
;  escribir, crear, borrar, las carpetas), lanzar otros programas y
;  esperarlos, los argumentos, la memoria; y las ventanas del escritorio
;  (hacer una, dibujar en ella, sus sucesos, los menús emergentes), el
;  portapapeles y los terminales. Cada función es
;  una «int 0x80» con su número (los de nucleo32/usuario.cas). escribir() y
;  salir() son del lenguaje y ya van por ahí.
;  Lo que no puede ser da un número de PRIMER_ERROR para arriba: se mira con
;  es_error().
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Llamadas

    ; ---- los errores ----
    público constante NO_HAY = 0xFFFFFFFF       ; no existe ese archivo
    público constante SIN_DISCO = 0xFFFFFFFE    ; no hay disco, o no es FAT
    público constante LLENO = 0xFFFFFFFD        ; demasiados archivos abiertos
    público constante MAL = 0xFFFFFFFC          ; el manejador no vale, o el disco falla
    público constante NO_PROGRAMA = 0xFFFFFFFB  ; el archivo no es un programa de Hispa-Pentium
    público constante SIN_MEMORIA = 0xFFFFFFFA  ; no hay memoria (o no quedan tareas)
    público constante NO_VALE = 0xFFFFFFF9      ; lo que se pide no tiene sentido
    público constante DISCO_LLENO = 0xFFFFFFF8  ; no queda sitio en el disco (o en la raíz)
    público constante YA_EXISTE = 0xFFFFFFF7    ; ya hay algo con ese nombre
    público constante EN_USO = 0xFFFFFFF6       ; está abierto (o es la carpeta de trabajo de alguien)
    público constante PROTEGIDO = 0xFFFFFFF5    ; es de solo lectura, o es la raíz
    público constante NO_VACÍA = 0xFFFFFFF4     ; la carpeta tiene algo dentro
    público constante NOMBRE_MALO = 0xFFFFFFF3  ; el nombre no vale (8+3, sin letras raras)
    público constante ES_CARPETA = 0xFFFFFFF2   ; es una carpeta, y hacía falta un archivo
    público constante NO_CARPETA = 0xFFFFFFF1   ; no es una carpeta
    público constante PRIMER_ERROR = 0xFFFFFFF0

    ; ---- cómo se abre un archivo: abrir_para(nombre, ...) ----
    público constante PARA_LEER = 0             ; solo para leer (un archivo o una carpeta)
    público constante PARA_ESCRIBIR = 1         ; uno que ya está, para leer y escribir
    público constante PARA_CREAR = 2            ; nuevo (si ya estaba, se queda vacío), para escribir
    público constante PARA_AÑADIR = 3           ; para escribir al final (si no estaba, se crea)

    ; ---- desde dónde se mueve la posición: mover(m, cuánto, ...) ----
    público constante DESDE_INICIO = 0
    público constante DESDE_AQUÍ = 1
    público constante DESDE_FINAL = 2

    ; ---- las teclas que no son letras (lo que da tecla()) ----
    público constante TECLA_ESPECIAL = 0x100    ; de aquí arriba, no son letras
    público constante TECLA_ARRIBA = 0x148
    público constante TECLA_ABAJO = 0x150
    público constante TECLA_IZQUIERDA = 0x14B
    público constante TECLA_DERECHA = 0x14D
    público constante TECLA_INICIO = 0x147
    público constante TECLA_FIN = 0x14F
    público constante TECLA_SUPR = 0x153
    público constante TECLA_RE_PÁG = 0x149
    público constante TECLA_AV_PÁG = 0x151
    público constante TECLA_F1 = 0x13B
    público constante TECLA_F3 = 0x13D
    público constante TECLA_F8 = 0x142
    público constante TECLA_MAYÚS_TAB = 0x10F   ; Mayús+Tab (en una ventana del escritorio): el control de antes
    público constante CTRL_C = 3

    público constante CORTADA = 254             ; el código de un programa acabado con Ctrl+C
    público constante SIN_SALIDA = 0xFFFFFFFF   ; redirigir(SIN_SALIDA): otra vez a la pantalla
    público constante MAX_LARGO = 256           ; lo que ocupa un nombre largo (con su 0)

    ; ---- los atributos de una entrada de carpeta ----
    público constante SOLO_LECTURA = 0x01
    público constante OCULTO = 0x02
    público constante DE_SISTEMA = 0x04
    público constante CARPETA = 0x10

    ; ---- lo que se sabe de una unidad: info_unidad(n, ...) ----
    público constante MEDIO_MEMORIA = 0         ; los archivos que trajo el cargador
    público constante MEDIO_IDE = 1
    público constante MEDIO_SATA = 2
    público constante MEDIO_USB = 3
    público tipo Info_unidad = estructura
        letra: byte                             ; 0: un disco sin ningún volumen que se pueda leer
        clase: byte                             ; 12, 16 o 32 (FAT); 1: en memoria; 0: nada
        medio: byte                             ; MEDIO_...
        solo_lectura: byte
        total_k, libre_k: nat32                 ; en K (libre_k = 0xFFFFFFFF: no se sabe)
        del_sistema: nat32                      ; 1: es la unidad del sistema
        nombre: arreglo [41] de byte            ; el modelo del disco
        etiqueta: arreglo [12] de byte          ; el nombre del volumen
        quitable: byte                          ; 1: una memoria USB que se puede quitar con seguridad (130)
        relleno: arreglo [2] de byte
    fin

    ; ---- lo que se sabe de un disco: info_disco(n, ...) ----
    público tipo Info_disco = estructura
        clase: nat32                            ; MEDIO_IDE, MEDIO_SATA o MEDIO_USB
        sectores: nat32                         ; de 512 octetos
        se_puede: nat32                         ; 1: el programa INSTALAR puede escribir en él
        del_sistema: nat32                      ; 1: lleva la unidad del sistema
        modelo: arreglo [44] de byte
    fin
    tipo Pedido_disco = estructura
        lba, n: nat32
        datos: puntero a byte
    fin
    variable pedido: Pedido_disco

    ; ---- los datos del sistema: dato(...) ----
    público constante DATO_MARCOS_LIBRES = 0    ; los marcos de 4 K libres
    público constante DATO_MARCOS = 1           ; los que hay
    público constante DATO_MIS_PÁGINAS = 2      ; las páginas de este programa
    público constante DATO_VERSIÓN = 3          ; 0x0008 es la 0.8
    público constante DATO_TAREAS = 4
    público constante DATO_FAT = 5              ; 12, 16 o 32 (0 si no hay disco)
    público constante DATO_CLUSTER = 6          ; los octetos de un cluster del disco
    público constante DATO_CLUSTERS_LIBRES = 7  ; (0xFFFFFFFF si no se sabe)
    público constante DATO_CLUSTERS = 8
    público constante DATO_HZ = 9               ; los tics por segundo
    público constante DATO_FECHA = 10           ; la fecha (arriba) y la hora (abajo), como las guarda la FAT
    público constante DATO_ANCHO_PANTALLA = 11  ; el ancho de la pantalla gráfica (0 si no hay)
    público constante DATO_ALTO_PANTALLA = 12
    público constante DATO_ESCRITORIO = 13      ; 1 si el escritorio está en marcha

    público constante SIGUE = 0xFFFFFF00        ; lo que da acabada() si la tarea no ha acabado

    ; ---- las ventanas: los sucesos (lo que da suceso()) ----
    público constante EV_TECLA = 1              ; a: la tecla (como las da tecla())
    público constante EV_RATÓN_BAJA = 2         ; a, b: dónde (dentro de la ventana); c: los botones pulsados
    público constante EV_RATÓN_SUBE = 3
    público constante EV_RATÓN_MUEVE = 4
    público constante EV_CERRAR = 5             ; se ha pulsado el botón de cerrar
    público constante EV_TAMAÑO = 6             ; a, b: el ancho y el alto nuevos (hay que volver a pintar todo)
    público constante EV_FOCO = 7               ; a: 1 si pasa a ser la ventana activa, 0 si deja de serlo
    público constante EV_SALE = 9               ; el ratón ya no está encima
    público constante EV_UNIDADES = 12          ; ha aparecido o desaparecido una unidad (una memoria USB): hay que mirarlas otra vez
    público constante EV_MENÚ = 10              ; se ha cerrado el menú que se pidió: a, la opción elegida (desde 0; SIN_ELEGIR si ninguna); b, su etiqueta
    público constante SIN_ELEGIR = 0xFFFFFFFF
    público constante BOTÓN_IZQUIERDO = 1       ; en «c» de los sucesos del ratón: los botones pulsados...
    público constante BOTÓN_DERECHO = 2
    público constante CON_MAYÚS = 0x100         ; ...las teclas de cambio (también en «b» de EV_TECLA, como 1)...
    público constante CON_CONTROL = 0x200
    público constante TECLA_CON_MAYÚS = 1       ; en «b» de EV_TECLA: la tecla (una flecha, Inicio, Fin...) llegó con Mayús
    público constante ANCHO_LETRA = 8           ; lo que mide cada letra del texto
    público constante ALTO_LETRA = 16

    público tipo Suceso = estructura
        clase, a, b, c: nat32
    fin

    ; lo que se le pide dibujar al núcleo (la llamada 34)
    tipo Orden = estructura
        op: nat32
        x, ye, ancho, alto: ent32
        tinta, tinta2: nat32
        datos: puntero a byte
        n: ent32
    fin
    constante OP_RECTÁNGULO = 1
    constante OP_DEGRADADO = 2
    constante OP_MARCO = 3
    constante OP_LÍNEA = 4
    constante OP_TEXTO = 5
    constante OP_TEXTO_FONDO = 6
    constante OP_MAPA = 7
    constante OP_DESPLAZAR = 8
    constante OP_REDONDEADO = 9
    constante OP_NEGRITA = 10
    constante OP_DISQUETE = 11
    variable ord: Orden

    ; lo que se le pide para abrir un menú emergente (la llamada 39)
    tipo PideMenú = estructura
        x, ye: ent32
        opciones: puntero a byte
        inactivas: nat32
        etiqueta: nat32
    fin
    variable pide: PideMenú

    ; una entrada de una carpeta (32 octetos)
    público tipo Entrada = estructura
        nombre: arreglo [13] de byte            ; «NOMBRE.EXT», acabado en 0
        atributos: byte
        reservado: nat16
        tamaño: nat32
        fecha, hora: nat16                      ; como las guarda la FAT
        cluster: nat32
        libre: nat32
    fin

    función llamada(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        ensamblador
            mov eax, {n}
            mov ebx, {a}
            mov ecx, {b}
            mov edx, {c}
            int 0x80
        fin
    fin

    público función es_error(r: nat32): bool
        devolver r >= PRIMER_ERROR
    fin

    ; por qué no ha podido ser, para decirlo
    público función texto_error(e: nat32): puntero a byte
        según e
            caso NO_HAY: devolver "no existe"
            caso SIN_DISCO: devolver "no hay disco (o no es FAT)"
            caso LLENO: devolver "hay demasiados archivos abiertos"
            caso MAL: devolver "el disco falla"
            caso NO_PROGRAMA: devolver "no es un programa de Hispa-Pentium"
            caso SIN_MEMORIA: devolver "no hay memoria"
            caso DISCO_LLENO: devolver "no queda sitio en el disco"
            caso YA_EXISTE: devolver "ya existe"
            caso EN_USO: devolver "está en uso"
            caso PROTEGIDO: devolver "es de solo lectura"
            caso NO_VACÍA: devolver "la carpeta no está vacía"
            caso NOMBRE_MALO: devolver "el nombre no vale (son 8 letras, un punto y 3; y no CON, NUL, PRN...)"
            caso ES_CARPETA: devolver "es una carpeta"
            caso NO_CARPETA: devolver "no es una carpeta"
        fin
        devolver "no puede ser"
    fin

    ; ---- las tareas y el reloj ----
    público función dormir(n: nat32)
        llamada(3, n, 0, 0)
    fin

    público función tics(): nat32
        devolver llamada(4, 0, 0, 0)
    fin

    público función mi_tarea(): nat32
        devolver llamada(5, 0, 0, 0)
    fin

    ; lanza el programa de ese archivo, con esos argumentos (un texto, o
    ; nulo): da el número de su tarea, o un error
    público función lanzar(nombre: puntero a byte, args: puntero a byte): nat32
        devolver llamada(10, nat32(nombre), nat32(args), 0)
    fin

    ; espera a que acabe una tarea que se ha lanzado: da su código de salida
    ; (255 si el núcleo ha tenido que acabarla)
    público función esperar(tarea: nat32): nat32
        devolver llamada(11, tarea, 0, 0)
    fin

    ; los argumentos con que se ha lanzado este programa, a «destino» (donde
    ; caben «cabe» octetos, con el 0 del final). Da su largo.
    público función argumentos(destino: puntero a byte, cabe: nat32): nat32
        devolver llamada(14, nat32(destino), cabe, 0)
    fin

    ; Ctrl+C acaba los programas en marcha; el que dice aquí que lo atiende
    ; él (un intérprete de órdenes) no se acaba: le llega como una tecla
    ; (CTRL_C) si no había otro programa que acabar, y hubo_corte() se lo dice
    público función atender_corte(sí: bool)
        si sí entonces llamada(29, 1, 0, 0) sino llamada(29, 0, 0, 0) fin
    fin

    ; ¿se ha pulsado Ctrl+C desde la última vez que se preguntó?
    público función hubo_corte(): bool
        devolver llamada(30, 0, 0, 0) = 1
    fin

    ; ---- el teclado y la pantalla ----
    ; espera una tecla y da su letra (de la página 437); o, si no es una
    ; letra, TECLA_ARRIBA, TECLA_SUPR... (de TECLA_ESPECIAL para arriba)
    público función tecla(): nat32
        devolver llamada(6, 0, 0, 0)
    fin

    ; la tecla que haya pulsada, o 0 si no hay ninguna (no espera)
    público función tecla_si_hay(): nat32
        devolver llamada(6, 1, 0, 0)
    fin

    ; pone el teclado español (cierto) o el de EE. UU. (falso)
    público función poner_teclado(español: bool)
        si español entonces llamada(31, 1, 0, 0) sino llamada(31, 0, 0, 0) fin
    fin

    ; ¿es el teclado el español?
    público función teclado_español(): bool
        devolver llamada(31, 2, 0, 0) = 1
    fin

    público función borrar_pantalla()
        llamada(16, 0, 0, 0)
    fin

    ; escribe n octetos tal cual
    público función escribir_trozo(p: puntero a byte, n: nat32): nat32
        devolver llamada(1, nat32(p), n, 0)
    fin

    ; ---- leer una línea, con su historia ----
    constante HISTORIA = 8                      ; las líneas que se recuerdan
    constante ANCHO = 128                       ; lo que cabe de cada una
    variable historia: arreglo [HISTORIA * ANCHO] de byte
    variable guardadas: nat32                   ; las que se han guardado desde el principio
    variable atrás: arreglo [ANCHO] de byte

    ; el cursor, n sitios atrás
    función retrocede(n: nat32)
        variable i, k: nat32
        mientras n > 0 hacer
            k := n
            si k > ANCHO entonces k := ANCHO fin
            para i desde 0 hasta k - 1 hacer atrás[i] := 8 fin
            escribir_trozo(atrás, k)
            n := n - k
        fin
    fin

    ; pinta la línea desde «pos» hasta su final, «sobran» espacios más (para
    ; tapar lo que había) y deja el cursor otra vez en «pos»
    función pinta_cola(t: puntero a byte, pos: nat32, largo: nat32, sobran: nat32)
        variable i: nat32
        si largo > pos entonces escribir_trozo(t + pos, largo - pos) fin
        para i desde 1 hasta sobran hacer escribir_car(' ') fin
        retrocede(largo - pos + sobran)
    fin

    ; lee una línea del teclado (hasta Intro), enseñándola; la deja en
    ; «destino» (donde caben «cabe» octetos, con el 0 del final) y da su
    ; largo. Se corrige con Retroceso y Supr, moviéndose con las flechas,
    ; Inicio y Fin; Esc la borra; las flechas de arriba y abajo traen las
    ; líneas de antes (las ocho últimas). Con Ctrl+C se deja: da 0.
    público función leer_línea(destino: puntero a byte, cabe: nat32): nat32
        variable c, largo, pos, h, i, n, antes: nat32
        variable vieja: puntero a byte
        largo := 0
        pos := 0
        h := guardadas
        si cabe > ANCHO entonces cabe := ANCHO fin
        mientras cierto hacer
            c := tecla()
            si c = '\n' entonces
                escribir("\n")
                destino[largo] := 0
                ; a la historia, si no es la misma de antes
                si largo > 0 entonces
                    vieja := dirección(historia[((guardadas + HISTORIA - 1) mod HISTORIA) * ANCHO])
                    i := 0
                    si guardadas > 0 entonces
                        mientras i < largo y vieja[i] = destino[i] hacer i := i + 1 fin
                    fin
                    si guardadas = 0 o i < largo o vieja[i] <> 0 entonces
                        vieja := dirección(historia[(guardadas mod HISTORIA) * ANCHO])
                        para i desde 0 hasta largo hacer vieja[i] := destino[i] fin
                        guardadas := guardadas + 1
                    fin
                fin
                devolver largo
            sino si c = CTRL_C entonces
                escribir("^C\n")
                destino[0] := 0
                devolver 0
            sino si c = 8 entonces
                si pos > 0 entonces
                    para i desde pos hasta largo - 1 hacer destino[i - 1] := destino[i] fin
                    pos := pos - 1
                    largo := largo - 1
                    retrocede(1)
                    pinta_cola(destino, pos, largo, 1)
                fin
            sino si c = TECLA_SUPR entonces
                si pos < largo entonces
                    para i desde pos + 1 hasta largo - 1 hacer destino[i - 1] := destino[i] fin
                    largo := largo - 1
                    pinta_cola(destino, pos, largo, 1)
                fin
            sino si c = TECLA_IZQUIERDA entonces
                si pos > 0 entonces
                    pos := pos - 1
                    retrocede(1)
                fin
            sino si c = TECLA_DERECHA entonces
                si pos < largo entonces
                    escribir_car(destino[pos])
                    pos := pos + 1
                fin
            sino si c = TECLA_INICIO entonces
                retrocede(pos)
                pos := 0
            sino si c = TECLA_FIN entonces
                si largo > pos entonces escribir_trozo(destino + pos, largo - pos) fin
                pos := largo
            sino si c = TECLA_ARRIBA o c = TECLA_ABAJO o c = 27 entonces
                ; otra línea de la historia (o ninguna) en lugar de esta
                antes := largo
                n := h
                si c = TECLA_ARRIBA entonces
                    si h > 0 y h + HISTORIA > guardadas entonces n := h - 1 fin
                sino si c = TECLA_ABAJO entonces
                    si h < guardadas entonces n := h + 1 fin
                sino
                    n := guardadas
                fin
                si n <> h o c = 27 entonces
                    h := n
                    retrocede(pos)
                    largo := 0
                    si h < guardadas entonces
                        vieja := dirección(historia[(h mod HISTORIA) * ANCHO])
                        mientras vieja[largo] <> 0 y largo + 1 < cabe hacer
                            destino[largo] := vieja[largo]
                            largo := largo + 1
                        fin
                    fin
                    pos := 0
                    si antes > largo entonces pinta_cola(destino, 0, largo, antes - largo) sino pinta_cola(destino, 0, largo, 0) fin
                    si largo > 0 entonces escribir_trozo(destino, largo) fin
                    pos := largo
                fin
            sino si c >= ' ' y c < TECLA_ESPECIAL y largo + 1 < cabe entonces
                i := largo
                mientras i > pos hacer
                    destino[i] := destino[i - 1]
                    i := i - 1
                fin
                destino[pos] := c
                largo := largo + 1
                escribir_car(c)
                pos := pos + 1
                si pos < largo entonces pinta_cola(destino, pos, largo, 0) fin
            fin
        fin
        devolver largo
    fin

    ; ---- los archivos ----
    ; abre un archivo o una carpeta («\» es la raíz) para leer: da su
    ; manejador, o un error. Los nombres que no empiezan por una barra se
    ; entienden desde la carpeta de trabajo; «.» y «..» valen.
    público función abrir(nombre: puntero a byte): nat32
        devolver llamada(7, nat32(nombre), PARA_LEER, 0)
    fin

    ; abre un archivo para lo que se diga: PARA_LEER, PARA_ESCRIBIR (uno que
    ; ya está), PARA_CREAR (nuevo; si estaba, queda vacío) o PARA_AÑADIR
    ; (para escribir al final; se crea si no estaba)
    público función abrir_para(nombre: puntero a byte, modo: nat32): nat32
        devolver llamada(7, nat32(nombre), modo, 0)
    fin

    ; un archivo nuevo, para escribir (si ya estaba, queda vacío)
    público función crear(nombre: puntero a byte): nat32
        devolver llamada(7, nat32(nombre), PARA_CREAR, 0)
    fin

    ; escribe n octetos en el archivo, desde su posición (crece si hace
    ; falta): da los escritos (menos de n si el disco se llena), o un error
    público función escribir_archivo(m: nat32, origen: puntero a byte, n: nat32): nat32
        devolver llamada(18, m, nat32(origen), n)
    fin

    ; mueve la posición del archivo a «cuánto» octetos (con signo) del
    ; principio (DESDE_INICIO), de donde está (DESDE_AQUÍ) o del final
    ; (DESDE_FINAL): da la posición nueva, o un error. Más allá del final se
    ; puede ir: al escribir, lo de en medio queda a cero.
    público función mover(m: nat32, cuánto: ent32, origen: nat32): nat32
        devolver llamada(19, m, nat32(cuánto), origen)
    fin

    ; deja el archivo con el tamaño de su posición: lo corta ahí (o lo
    ; alarga con ceros)
    público función cortar(m: nat32): nat32
        devolver llamada(20, m, 0, 0)
    fin

    público función borrar(nombre: puntero a byte): nat32
        devolver llamada(21, nat32(nombre), 0, 0)
    fin

    ; cambia de nombre un archivo o una carpeta (un archivo, también a otra carpeta)
    público función renombrar(viejo: puntero a byte, nuevo: puntero a byte): nat32
        devolver llamada(22, nat32(viejo), nat32(nuevo), 0)
    fin

    público función crear_carpeta(nombre: puntero a byte): nat32
        devolver llamada(23, nat32(nombre), 0, 0)
    fin

    ; borra una carpeta (tiene que estar vacía)
    público función borrar_carpeta(nombre: puntero a byte): nat32
        devolver llamada(24, nat32(nombre), 0, 0)
    fin

    ; la carpeta de trabajo del programa pasa a ser esa (la heredan los que lance)
    público función cambiar_carpeta(nombre: puntero a byte): nat32
        devolver llamada(25, nat32(nombre), 0, 0)
    fin

    ; la unidad de trabajo del programa pasa a ser la de esa letra ('X'), con
    ; su raíz como carpeta de trabajo; con 0, solo se pregunta. Da la letra
    ; de la unidad de trabajo que queda (o un error: no hay tal unidad).
    público función unidad(letra: nat32): nat32
        devolver llamada(42, letra, 0, 0)
    fin

    ; lo que se sabe de la unidad número «cuál» (0, 1, 2...: primero las
    ; unidades, por su letra; luego los discos sin ninguna unidad que se
    ; pueda leer, con la letra a 0). Falso si no hay tantas.
    público función info_unidad(cuál: nat32, ref i: Info_unidad): bool
        devolver llamada(43, cuál, nat32(dirección(i)), 0) = 1
    fin

    ; la carpeta de trabajo, a «destino» (donde caben «cabe» octetos): «\» o
    ; «\UNA\OTRA». Da su largo.
    público función carpeta_actual(destino: puntero a byte, cabe: nat32): nat32
        devolver llamada(26, nat32(destino), cabe, 0)
    fin

    ; lo que escriba el programa de aquí en adelante (y los que lance) va al
    ; archivo m, abierto para escribir, con los finales de línea del DOS; con
    ; SIN_SALIDA, otra vez a la pantalla
    público función redirigir(m: nat32): nat32
        devolver llamada(27, m, 0, 0)
    fin

    ; lee hasta n octetos: da los leídos (0 al final), o un error
    público función leer(m: nat32, destino: puntero a byte, n: nat32): nat32
        devolver llamada(8, m, nat32(destino), n)
    fin

    público función cerrar(m: nat32)
        llamada(9, m, 0, 0)
    fin

    ; la entrada siguiente de una carpeta abierta; falso cuando no hay más
    público función entrada(m: nat32, ref e: Entrada): bool
        devolver llamada(12, m, nat32(dirección(e)), 0) = 1
    fin

    ; lo mismo, con su nombre largo (el corto si no tiene) en «nombre», donde
    ; tienen que caber MAX_LARGO octetos
    público función entrada_larga(m: nat32, ref e: Entrada, nombre: puntero a byte): bool
        devolver llamada(28, m, nat32(dirección(e)), nat32(nombre)) = 1
    fin

    ; lo que mide un archivo abierto
    público función largo_de(m: nat32): nat32
        devolver llamada(13, m, 0, 0)
    fin

    ; ---- la memoria y el sistema ----
    público función dato(cuál: nat32): nat32
        devolver llamada(15, cuál, 0, 0)
    fin

    ; pide n octetos más de memoria, detrás de lo que ya tiene el programa:
    ; da dónde empiezan (a cero), o nulo si no hay
    público función más_memoria(n: nat32): puntero a byte
        variable r: nat32
        r := llamada(17, n, 0, 0)
        si r >= PRIMER_ERROR entonces devolver nulo fin
        devolver puntero(r)
    fin

    ; devuelve los n últimos octetos pedidos con más_memoria()
    público función menos_memoria(n: nat32): bool
        devolver llamada(17, 0 - n, 0, 0) < PRIMER_ERROR
    fin

    ; ¿ha acabado la tarea (una que se ha lanzado)? Sin esperarla: da su
    ; código de salida si ha acabado (y queda recogida), o SIGUE
    público función acabada(tarea: nat32): nat32
        devolver llamada(11, tarea, 1, 0)
    fin

    ; ---- el escritorio y las ventanas ----
    ; pone en marcha el escritorio (el entorno gráfico): cierto si queda en marcha
    público función escritorio(): bool
        devolver llamada(38, 0, 0, 0) = 1
    fin

    ; una ventana nueva con ese nombre en el título, de ese ancho y ese alto
    ; por dentro: da su número, o un error (no hay escritorio, no hay memoria)
    público función ventana(nombre: puntero a byte, ancho: nat32, alto: nat32): nat32
        devolver llamada(32, nat32(nombre), ancho, alto)
    fin

    público función cerrar_ventana(v: nat32)
        llamada(33, v, 0, 0)
    fin

    ; cambia el nombre del título de la ventana
    público función título(v: nat32, nombre: puntero a byte)
        llamada(36, v, nat32(nombre), 0)
    fin

    ; el suceso siguiente de la ventana (una tecla, el ratón, cerrar...):
    ; cierto si lo hay. Con «espera», se queda hasta que llegue uno.
    público función suceso(v: nat32, ref s: Suceso, espera: bool): bool
        si espera entonces devolver llamada(35, v, nat32(dirección(s)), 1) = 1 fin
        devolver llamada(35, v, nat32(dirección(s)), 0) = 1
    fin

    función dibuja(v: nat32, op: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, tinta: nat32, tinta2: nat32)
        ord.op := op
        ord.x := x
        ord.ye := yy
        ord.ancho := ancho
        ord.alto := alto
        ord.tinta := tinta
        ord.tinta2 := tinta2
        llamada(34, v, nat32(dirección(ord)), 0)
    fin

    ; un rectángulo lleno de un color (0xRRGGBB); las medidas, en puntos,
    ; desde la esquina de arriba a la izquierda de lo de dentro de la ventana
    público función rectángulo(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, tinta: nat32)
        dibuja(v, OP_RECTÁNGULO, x, yy, ancho, alto, tinta, 0)
    fin

    ; de un color arriba a otro abajo
    público función degradado(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, arriba: nat32, abajo: nat32)
        dibuja(v, OP_DEGRADADO, x, yy, ancho, alto, arriba, abajo)
    fin

    ; lo mismo, con las esquinas redondas
    público función redondeado(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, radio: ent32, arriba: nat32, abajo: nat32)
        ord.n := radio
        dibuja(v, OP_REDONDEADO, x, yy, ancho, alto, arriba, abajo)
    fin

    ; el borde de un rectángulo
    público función marco(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, tinta: nat32)
        dibuja(v, OP_MARCO, x, yy, ancho, alto, tinta, 0)
    fin

    público función línea(v: nat32, x1: ent32, y1: ent32, x2: ent32, y2: ent32, tinta: nat32)
        dibuja(v, OP_LÍNEA, x1, y1, x2, y2, tinta, 0)
    fin

    ; n letras (de la página 437), solo sus puntos
    público función texto_n(v: nat32, x: ent32, yy: ent32, t: puntero a byte, n: nat32, tinta: nat32)
        ord.datos := t
        ord.n := ent32(n)
        dibuja(v, OP_TEXTO, x, yy, 0, 0, tinta, 0)
    fin

    ; un texto acabado en 0
    público función texto(v: nat32, x: ent32, yy: ent32, t: puntero a byte, tinta: nat32)
        variable n: nat32
        n := 0
        mientras t[n] <> 0 hacer n := n + 1 fin
        texto_n(v, x, yy, t, n, tinta)
    fin

    ; en negrita
    público función texto_negrita(v: nat32, x: ent32, yy: ent32, t: puntero a byte, tinta: nat32)
        variable n: nat32
        n := 0
        mientras t[n] <> 0 hacer n := n + 1 fin
        ord.datos := t
        ord.n := ent32(n)
        dibuja(v, OP_NEGRITA, x, yy, 0, 0, tinta, 0)
    fin

    ; n letras sobre un fondo de color (tapa lo que había)
    público función texto_fondo(v: nat32, x: ent32, yy: ent32, t: puntero a byte, n: nat32, tinta: nat32, fondo: nat32)
        ord.datos := t
        ord.n := ent32(n)
        dibuja(v, OP_TEXTO_FONDO, x, yy, 0, 0, tinta, fondo)
    fin

    ; un dibujo de ancho x alto puntos de 32 bits (0xRRGGBB cada uno)
    público función mapa(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, puntos: puntero a nat32)
        ord.datos := puntero(puntos)
        dibuja(v, OP_MAPA, x, yy, ancho, alto, 0, 0)
    fin

    ; lo que hay en el rectángulo sube n puntos (para pasar las líneas de un texto)
    público función desplazar(v: nat32, x: ent32, yy: ent32, ancho: ent32, alto: ent32, n: ent32)
        ord.n := n
        dibuja(v, OP_DESPLAZAR, x, yy, ancho, alto, 0, 0)
    fin

    ; el disquete de la casa, de ese lado
    público función disquete(v: nat32, x: ent32, yy: ent32, lado: ent32)
        dibuja(v, OP_DISQUETE, x, yy, lado, lado, 0, 0)
    fin

    ; las veces seguidas que se ha pulsado el ratón ahí (1; 2, el doble clic;
    ; 3, el triple): con la «c» de un suceso EV_RATÓN_BAJA
    público función veces(c: nat32): nat32
        devolver c >> 16
    fin

    ; abre un menú emergente en el punto (x, yy) de la ventana, con esas
    ; opciones (un texto, separadas por «|»; «-» es una raya). «inactivas»: un
    ; bit por opción (contando las rayas) para las que salen en gris. Al
    ; cerrarse, a la ventana le llega EV_MENÚ con la opción elegida (o
    ; SIN_ELEGIR) y esa etiqueta. Pedir el mismo estando abierto lo cierra.
    público función menú(v: nat32, x: ent32, yy: ent32, opciones: puntero a byte, inactivas: nat32, etiqueta: nat32)
        pide.x := x
        pide.ye := yy
        pide.opciones := opciones
        pide.inactivas := inactivas
        pide.etiqueta := etiqueta
        llamada(39, v, nat32(dirección(pide)), 0)
    fin

    ; ---- el portapapeles del sistema (un texto, con sus líneas acabadas en «\n») ----
    ; guarda n letras: lo que se copia o se corta
    público función al_portapapeles(p: puntero a byte, n: nat32): bool
        devolver llamada(40, 0, nat32(p), n) < PRIMER_ERROR
    fin

    ; lo que hay guardado, a «destino» (hasta «cabe» letras): da cuántas
    público función del_portapapeles(destino: puntero a byte, cabe: nat32): nat32
        variable r: nat32
        r := llamada(40, 1, nat32(destino), cabe)
        si r >= PRIMER_ERROR entonces devolver 0 fin
        devolver r
    fin

    ; cuántas letras hay guardadas
    público función en_portapapeles(): nat32
        devolver llamada(40, 2, 0, 0)
    fin

    ; lanza un programa y lo suelta: no hay que esperarlo (lo recoge el
    ; núcleo al acabar). Da su número de tarea, o un error.
    público función lanzar_suelto(nombre: puntero a byte, args: puntero a byte): nat32
        devolver llamada(41, nat32(nombre), nat32(args), 0)
    fin

    ; ---- los terminales (para un programa que tiene a otros dentro de su ventana) ----
    ; hace un terminal: los programas que se lancen desde ahora escriben en
    ; él y leen sus teclas de él. Falso si no quedan.
    público función hacer_terminal(): bool
        devolver llamada(37, 0, 0, 0) < PRIMER_ERROR
    fin

    ; lo que han escrito los programas de dentro: hasta «cabe» octetos. Da cuántos.
    público función leer_terminal(destino: puntero a byte, cabe: nat32): nat32
        devolver llamada(37, 1, nat32(destino), cabe)
    fin

    ; una tecla para los programas de dentro: falso si no cabe (hay muchas
    ; esperando: se le da más tarde)
    público función teclear(c: nat32): bool
        devolver llamada(37, 2, c, 0) = 0
    fin

    ; Ctrl+C para los programas de dentro
    público función cortar_terminal()
        llamada(37, 3, 0, 0)
    fin

    ; -------------------------------------------------------------------------
    ;  Para instalar el sistema (INSTALAR.BIN) y para el asistente del primer
    ;  arranque (ASISTE.BIN): la pantalla de texto, los discos sector a
    ;  sector, reiniciar, el reloj del PC y los ajustes (desde la 0.7)
    ; -------------------------------------------------------------------------
    ; escribe n letras de t en la pantalla de texto, en esa columna (0 a 79)
    ; y esa fila (0 a 24), con ese color (el de la VGA: el fondo arriba)
    público función texto_en(columna: nat32, fila: nat32, color: nat32, t: puntero a byte, n: nat32)
        llamada(60, columna ob (fila << 8) ob (color << 16), nat32(t), n)
    fin

    ; lo mismo, n veces la misma letra (para borrar y para las rayas)
    público función letras_en(columna: nat32, fila: nat32, color: nat32, letra: nat32, n: nat32)
        llamada(60, columna ob (fila << 8) ob (color << 16) ob 0x80000000, letra, n)
    fin

    ; el cursor de la pantalla de texto (una fila de 25 para arriba: no se ve)
    público función cursor_en(columna: nat32, fila: nat32)
        llamada(62, columna ob (fila << 8), 0, 0)
    fin

    ; un texto solo al puerto serie (para ver desde fuera lo que pasa)
    público función al_serie(t: puntero a byte)
        variable n: nat32
        n := 0
        mientras t[n] <> 0 hacer n := n + 1 fin
        llamada(61, nat32(t), n, 0)
    fin

    ; lo que se sabe del disco número n (desde 0). Falso si no hay tal disco.
    público función info_disco(n: nat32, ref i: Info_disco): bool
        devolver llamada(63, n, nat32(dirección(i)), 0) = 1
    fin

    ; trae n sectores (hasta 128) del disco d, desde su sector lba
    público función leer_disco(d: nat32, lba: nat32, n: nat32, destino: puntero a byte): bool
        pedido.lba := lba
        pedido.n := n
        pedido.datos := destino
        devolver llamada(64, d, nat32(dirección(pedido)), 0) = 0
    fin

    ; los lleva al disco. Solo vale con «instalar» en la línea del cargador,
    ; en un disco de dentro que no sea el del sistema (nunca una memoria USB)
    público función escribir_disco(d: nat32, lba: nat32, n: nat32, origen: puntero a byte): bool
        pedido.lba := lba
        pedido.n := n
        pedido.datos := origen
        devolver llamada(65, d, nat32(dirección(pedido)), 0) = 0
    fin

    público función reiniciar()
        llamada(66, 0, 0, 0)
    fin

    ; pone en hora el reloj del PC: la fecha y la hora como las guarda la FAT
    público función poner_reloj(fecha: nat32, hora: nat32)
        llamada(67, fecha, hora, 0)
    fin

    ; el núcleo lee otra vez los ajustes (\HISPA\HISPA.INI). Falso si no están.
    público función releer_ajustes(): bool
        devolver llamada(68, 0, 0, 0) = 1
    fin

    ; el nombre del usuario (vacío si no se sabe), a destino
    público función nombre_usuario(destino: puntero a byte, cabe: nat32)
        destino[0] := 0
        llamada(68, 1, nat32(destino), cabe)
    fin

    público función nombre_equipo(destino: puntero a byte, cabe: nat32)
        destino[0] := 0
        llamada(68, 3, nat32(destino), cabe)
    fin

    ; ¿está el sistema instalado en el disco (y no arrancado de la memoria USB)?
    público función sistema_instalado(): bool
        devolver llamada(68, 2, 0, 0) = 1
    fin

    ; ---- el USB en caliente (desde la 0.8) ----
    público constante QUITADA = 0               ; lo que da quitar_memoria(): ya se puede quitar
    público constante NO_HAY_UNIDAD = 1
    público constante NO_ES_USB = 2
    público constante ES_DEL_SISTEMA = 3        ; el sistema corre desde ella: no se quita

    ; quitar con seguridad la memoria USB de esa unidad (su letra): lo
    ; pendiente se escribe y la memoria se para
    público función quitar_memoria(letra: nat32): nat32
        devolver llamada(130, letra, 0, 0)
    fin

    ; las veces que han aparecido o desaparecido unidades
    público función cambios_unidades(): nat32
        devolver llamada(131, 0, 0, 0)
    fin

    ; ---- (explorador) los atributos y soltar fuera de la ventana ----
    público constante ARCHIVADO = 0x20          ; el atributo de «archivo» (cambiado desde la última copia)
    público constante MEDIO_CD = 4              ; (pentium-cd) un lector de CD o DVD
    ; los atributos de un archivo o una carpeta (SOLO_LECTURA, OCULTO,
    ; DE_SISTEMA, CARPETA, ARCHIVADO), o un error
    público función atributos_de(nombre: puntero a byte): nat32
        devolver llamada(170, nat32(nombre), 0xFFFFFFFF, 0)
    fin

    ; los cambia (solo lectura, oculto, de sistema y archivo): da los que quedan
    público función poner_atributos(nombre: puntero a byte, nuevos: nat32): nat32
        devolver llamada(170, nat32(nombre), nuevos, 0)
    fin

    tipo Suelta = estructura
        x, ye: ent32
        ruta: puntero a byte
    fin
    variable suelta: Suelta

    ; lo que se arrastra desde la ventana v (una ruta entera, con su letra)
    ; se ha soltado en el punto (x, yy) de ella, que cae fuera: el escritorio
    ; lo pone en el tapiz (un acceso) o, en el dock, lo fija
    público función soltar_fuera(v: nat32, x: ent32, yy: ent32, ruta: puntero a byte): nat32
        suelta.x := x
        suelta.ye := yy
        suelta.ruta := ruta
        devolver llamada(171, v, nat32(dirección(suelta)), 0)
    fin

    ; los menús con flechas (la barra de menús): con esta marca en la
    ; etiqueta de menú(), las flechas a los lados lo cierran y el suceso
    ; EV_MENÚ trae A_LA_IZQUIERDA o A_LA_DERECHA
    público constante CON_FLECHAS = 0x40000000
    público constante A_LA_IZQUIERDA = 0xFFFFFFFE
    público constante A_LA_DERECHA = 0xFFFFFFFD

fin Llamadas.
