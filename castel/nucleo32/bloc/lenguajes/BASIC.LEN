nombre=Hispa-BASIC / QBasic
extensiones=BAS BI BM HBA
distingue=no
comentario='
comentario_palabra=REM NOTA
comillas="
letras=$%!#&
numeros=si
prefijos=&H &O &B
etiquetas=numeros
operadores=+-*/\^=<>:;,.
; GW-BASIC y QBasic
claves=PRINT INPUT LET IF THEN ELSE ELSEIF FOR TO STEP NEXT GOTO GOSUB RETURN
claves=WHILE WEND DO LOOP UNTIL DIM REDIM DATA READ RESTORE END STOP CONT
claves=ON ERROR RESUME OPEN CLOSE AS OUTPUT APPEND RANDOM BINARY WRITE GET PUT
claves=FIELD LINE USING DEF FN SUB FUNCTION DECLARE CALL SHARED STATIC CONST
claves=SELECT CASE IS EXIT TYPE AND OR NOT XOR MOD EQV IMP SWAP CLEAR KILL NAME
claves=FILES SYSTEM SHELL CHAIN COMMON RANDOMIZE RUN LIST NEW LOAD SAVE MERGE
claves=AUTO RENUM DELETE EDIT TRON TROFF OPTION BASE
; Hispa-BASIC, en español
claves=IMPRIMIR PREGUNTAR SEA SI ENTONCES SINO PARA HASTA PASO SIGUIENTE IR IRA
claves=LLAMAR VOLVER MIENTRAS FINMIENTRAS DIMENSION DATOS LEER RELEER FIN PARAR
claves=SEGUIR EJECUTAR LISTAR NUEVO CARGAR GUARDAR LIMPIAR EN Y O NO SALIR
claves=ALEATORIO VACIAR CAMBIAR ABRIR CERRAR ESCRIBIR REANUDAR USANDO QUITAR
claves=RENUMERAR EDITAR BORRAR RENOMBRAR ARCHIVOS
tipos=INTEGER LONG SINGLE DOUBLE STRING
propias=ABS ASC ATN CDBL CHR$ CINT CLNG COS CSNG CSRLIN CVI CVS CVD EOF EXP FIX
propias=FRE HEX$ INKEY$ INP INPUT$ INSTR INT LEFT$ LEN LOC LOF LOG LCASE$ LTRIM$
propias=MID$ MKI$ MKS$ MKD$ OCT$ PEEK POINT POS RIGHT$ RND RTRIM$ SGN SIN SPACE$
propias=SPC SQR STR$ STRING$ TAB TAN TIMER UCASE$ VAL VARPTR DATE$ TIME$
propias=CLS LOCATE COLOR WIDTH SCREEN PSET PRESET CIRCLE DRAW PAINT SOUND PLAY
propias=BEEP POKE OUT WAIT KEY VIEW WINDOW PALETTE SLEEP
plegado=bloques
abre=FOR DO WHILE SUB FUNCTION SELECT TYPE PARA MIENTRAS
cierra=NEXT LOOP WEND SIGUIENTE FINMIENTRAS ELSEIF
cierra_doble=END FIN
abre_al_final=THEN ENTONCES
no_abre_tras=DECLARE EXIT
