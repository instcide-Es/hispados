; =============================================================================
;  ahci.cas - los discos SATA del núcleo de Hispa-Pentium, por una
;  controladora AHCI (la de los PC de 2006 en adelante: PCI clase 01, subclase
;  06, interfaz 01). Según «Serial ATA AHCI 1.3».
;
;  La controladora se ve en la memoria (su registro base número 5): unos
;  registros generales y, por cada puerto, 0x80 octetos. A cada puerto con un
;  disco se le da una página: la lista de órdenes (32 cabeceras de 32
;  octetos; solo se usa la primera), el sitio donde el disco deja lo que
;  contesta (FIS recibidos) y la tabla de la orden (el FIS de la orden y la
;  lista de trozos de memoria, PRD). Los datos van por DMA: el disco los deja
;  (o los toma) él solo en una página del núcleo, y de ahí se copian adonde
;  se piden (así da igual de dónde sea la memoria de quien pide).
;
;  Órdenes: IDENTIFY, READ DMA EXT y WRITE DMA EXT (LBA de 48 bits; las de 28
;  si el disco es de los de antes) y FLUSH CACHE. No se usa la interrupción:
;  se mira el puerto hasta que acaba la orden. A la primera no se reinicia
;  la controladora (los discos ya giran: los arrancó la BIOS); se le pide a
;  la BIOS que la suelte si la norma lo prevé, se encienden los puertos (en
;  las de Intel, también en su registro PCS del PCI, como hace Linux), se
;  despierta el enlace, y cada puerto con algo enchufado va como dice la
;  norma (AHCI 1.3, 10.1.2): parar ST y FRE (y esperar CR y FR), darle sus
;  tablas (CLB, FB), FRE = 1, limpiar SERR e IS y SOLO ENTONCES mirar TFD
;  (TFD sale del FIS que manda el disco: con FRE = 0 se queda como estaba).
;  Si el disco sigue ocupado (BSY o DRQ), un COMRESET del puerto CON FRE = 1,
;  para que el FIS que manda el disco al volver el enlace llegue (es lo que
;  le pasaba al ICH7 del Toshiba NB250: el FIS del COMRESET de la BIOS se
;  había perdido y TFD se quedaba en 80h); luego ST = 1 e IDENTIFY. Si así
;  no sale ningún disco, la segunda vuelta: COMRESET de cada puerto y más
;  espera a que el disco gire; y, salvo en el ICH6 y el ICH7, antes se
;  reinicia la controladora entera (GHC.HR), como Linux (en el ICH7, el
;  reinicio deja los puertos sin enlace: no se hace).
;
;  Lo que va encontrando (la controladora, sus registros y, por cada puerto,
;  SSTS, TFD y la firma) se apunta en el registro del arranque (ARRANQUE.TXT)
;  y lo enseña la orden «disco» de la consola: en un PC de verdad, para
;  saber dónde se para si no sale el disco.
;
;  De fábrica NO se escribe (como en ata.cas): solo si «escritura» es cierto.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Ahci

    importar Pci, Paginas, Marcos, Tareas, Mem32, Formato, Registro, Textos32, Multiboot

    público constante SECTOR = 512
    público constante MAX_SATA = 4              ; los discos que se llevan

    ; ---- los registros generales ----
    constante CAP = 0x00
    constante GHC = 0x04
    constante PI = 0x0C                         ; los puertos que hay (un bit cada uno)
    constante VS = 0x10                         ; la versión de la norma
    constante CAP2 = 0x24
    constante BOHC = 0x28                       ; el traspaso desde la BIOS
    ; ---- los de cada puerto (desde 0x100 + 0x80 * puerto) ----
    constante P_CLB = 0x00                      ; la lista de órdenes
    constante P_FB = 0x08                       ; los FIS recibidos
    constante P_IS = 0x10
    constante P_IE = 0x14
    constante P_CMD = 0x18
    constante P_TFD = 0x20                      ; el estado del disco (como el del puerto 0x1F7)
    constante P_SIG = 0x24
    constante P_SSTS = 0x28
    constante P_SCTL = 0x2C
    constante P_SERR = 0x30
    constante P_CI = 0x38                       ; las órdenes en marcha

    constante CMD_ST = 0x0001                   ; el puerto atiende órdenes
    constante CMD_SUD = 0x0002                  ; que el disco gire (con CAP.SSS)
    constante CMD_POD = 0x0004                  ; que tenga corriente (con CMD_CPD)
    constante CMD_CPD = 0x100000
    constante CMD_ICC = 0xF0000000              ; el estado del enlace que se pide
    constante CMD_ACTIVO = 0x10000000           ; (1: activo, que se despierte)
    constante CMD_ALPE = 0x04000000             ; el ahorro de energía del enlace, solo...
    constante CMD_ASP = 0x08000000              ; ...y el de «dormido»: se quitan, como Linux
    constante CAP_SSS = 0x08000000              ; los discos giran uno a uno (escalonado)
    constante GHC_AE = 0x80000000
    constante GHC_HR = 0x00000001
    constante PCI_PCS = 0x92                    ; (Intel) los puertos encendidos, bits 0 a 3
    constante CMD_FRE = 0x0010                  ; y recibe FIS
    constante CMD_FR = 0x4000
    constante CMD_CR = 0x8000

    constante FIRMA_DISCO = 0x00000101
    constante FIRMA_ATAPI = 0xEB140101          ; un lector de CD o DVD
    constante FIRMA_MULTI = 0x96690101          ; un multiplicador de puertos
    constante FIRMA_SEMB = 0xC33C0101           ; un puente de gestión

    constante ORDEN_IDENTIFICAR = 0xEC
    constante ORDEN_LEER = 0xC8                 ; READ DMA
    constante ORDEN_LEER48 = 0x25               ; READ DMA EXT
    constante ORDEN_ESCRIBIR = 0xCA
    constante ORDEN_ESCRIBIR48 = 0x35
    constante ORDEN_ASENTAR = 0xE7
    constante ORDEN_ASENTAR48 = 0xEA

    constante POR_VEZ = 8                       ; los sectores de cada orden (una página)

    público tipo Sata = estructura
        hay: bool
        lba48: bool
        puerto: nat32
        sectores: nat32                         ; (hasta 2 TB: lo que cabe en 32 bits)
        tablas: nat32                           ; su página: lista, FIS y tabla de la orden
        datos: nat32                            ; su página para los datos
        modelo: arreglo [41] de byte
    fin

    público variable satas: arreglo [MAX_SATA] de Sata
    público variable cuántos: nat32
    público variable hay_ahci: bool             ; hay controladora
    público variable aparato: nat32             ; cuál es (su número de PCI)
    público variable puertos_con_algo: nat32    ; los puertos con algo enchufado (aunque no sea un disco)
    público variable sectores_leídos, sectores_escritos, fallos_de_disco: nat32
    público variable escritura: bool

    variable reg: puntero a nat32               ; los registros, a la vista del núcleo
    variable cerrojo: Cerrojo
    variable cap: nat32                         ; lo que dice la controladora de sí
    variable espera_disco: nat32                ; las centésimas que se espera a que el disco esté listo

    ; ---- lo que se ha visto, para el registro del arranque y la orden «disco» ----
    público constante CABE_INFORME = 4000
    público variable informe: arreglo [CABE_INFORME] de byte
    variable informe_largo: nat32
    variable renglón: arreglo [160] de byte
    variable dd: arreglo [6] de nat32

    ; apunta una línea en el informe (con formato, hasta 6 datos)
    función di(plantilla: puntero a byte, a: nat32, b: nat32, c: nat32, d: nat32, e: nat32)
        variable i: nat32
        dd[0] := a
        dd[1] := b
        dd[2] := c
        dd[3] := d
        dd[4] := e
        formatear(renglón, 160, plantilla, dd)
        i := 0
        mientras renglón[i] <> 0 y informe_largo + 1 < CABE_INFORME hacer
            informe[informe_largo] := renglón[i]
            informe_largo := informe_largo + 1
            i := i + 1
        fin
        informe[informe_largo] := 0
    fin

    ; ¿se ha pedido esta prueba en la línea del cargador? («ahci=reinicio»...)
    función prueba(qué: puntero a byte): bool
        devolver buscar(línea_del_cargador(), qué) <> nulo
    fin

    función lee(d: nat32): nat32
        devolver reg[d >> 2]
    fin

    función pon(d: nat32, v: nat32)
        reg[d >> 2] := v
    fin

    función del_puerto(p: nat32, d: nat32): nat32
        devolver 0x100 + p * 0x80 + d
    fin

    ; espera (hasta «cs» centésimas) a que los bits «máscara» del registro d
    ; valgan «valor». Falso si se pasa el tiempo.
    función espera(d: nat32, máscara: nat32, valor_: nat32, cs: nat32): bool
        variable tope, vueltas: nat32
        tope := tics + cs + 1
        vueltas := 0
        mientras (lee(d) yb máscara) <> valor_ hacer
            vueltas := vueltas + 1
            si tics > tope o vueltas > 40000000 entonces devolver falso fin
        fin
        devolver cierto
    fin

    ; espera (hasta «cs» centésimas) a que el puerto p tenga enlace (SSTS.DET
    ; = 3). Como Linux (sata_link_debounce): si no se ve nada enchufado
    ; (DET = 0) durante 15 centésimas seguidas, el puerto está vacío y no se
    ; espera más (un disco contesta al COMRESET en unos milisegundos, aunque
    ; tarde luego en girar). Así una controladora con puertos vacíos no
    ; retrasa el arranque un segundo por puerto.
    función espera_enlace(p: nat32, cs: nat32): bool
        variable tope, vacío_desde, vueltas, d: nat32
        tope := tics + cs + 1
        vacío_desde := tics
        vueltas := 0
        mientras cierto hacer
            d := lee(del_puerto(p, P_SSTS)) yb 0x0F
            si d = 3 entonces devolver cierto fin
            si d <> 0 entonces vacío_desde := tics fin
            vueltas := vueltas + 1
            si tics > tope o tics - vacío_desde >= 15 o vueltas > 40000000 entonces devolver falso fin
        fin
        devolver falso
    fin

    ; se queda «cs» centésimas sin hacer nada
    función pausa(cs: nat32)
        variable tope, vueltas: nat32
        tope := tics + cs + 1
        vueltas := 0
        mientras tics <= tope y vueltas < cs * 200000 hacer
            lee(CAP)
            vueltas := vueltas + 1
        fin
    fin

    ; para el puerto: ni órdenes ni FIS
    función para_puerto(p: nat32): bool
        variable c: nat32
        c := lee(del_puerto(p, P_CMD))
        si c yb (CMD_ST ob CMD_CR ob CMD_FRE ob CMD_FR) = 0 entonces devolver cierto fin
        pon(del_puerto(p, P_CMD), c yb nob CMD_ST)
        si no espera(del_puerto(p, P_CMD), CMD_CR, 0, 60) entonces devolver falso fin
        pon(del_puerto(p, P_CMD), lee(del_puerto(p, P_CMD)) yb nob CMD_FRE)
        devolver espera(del_puerto(p, P_CMD), CMD_FR, 0, 60)
    fin

    ; manda al disco s la orden «orden» con el sector «lba» y la cuenta «n»;
    ; «octetos» de datos van (escribe) o vienen por su página de datos.
    función manda(s: nat32, orden: nat32, lba: nat32, n: nat32, octetos: nat32, escribe: bool): bool
        variable cab, prd: puntero a nat32
        variable fis: puntero a byte
        variable p, b: nat32
        variable bien: bool
        p := satas[s].puerto
        b := satas[s].tablas
        ; el disco, libre (ni ocupado ni pidiendo datos)
        si no espera(del_puerto(p, P_TFD), 0x88, 0, 300) entonces devolver falso fin
        llenar(puntero(b + 0x500), 0x80 + 16, 0)
        ; la cabecera de la orden 0: el FIS mide 5 palabras; si se escribe,
        ; el bit 6; una entrada en la lista de trozos si hay datos
        cab := puntero(b)
        cab[0] := 5
        si escribe entonces cab[0] := cab[0] ob 0x40 fin
        si octetos <> 0 entonces cab[0] := cab[0] ob 0x10000 fin
        cab[1] := 0
        cab[2] := b + 0x500
        cab[3] := 0
        ; el FIS de la orden (del núcleo al disco)
        fis := puntero(b + 0x500)
        fis[0] := 0x27
        fis[1] := 0x80                          ; es una orden
        fis[2] := orden
        fis[4] := lba
        fis[5] := lba >> 8
        fis[6] := lba >> 16
        fis[7] := 0x40                          ; con LBA
        si satas[s].lba48 entonces
            fis[8] := lba >> 24
        sino
            fis[7] := 0x40 ob ((lba >> 24) yb 0x0F)
        fin
        fis[12] := n
        fis[13] := n >> 8
        ; el único trozo de memoria: la página de datos
        si octetos <> 0 entonces
            prd := puntero(b + 0x580)
            prd[0] := satas[s].datos
            prd[1] := 0
            prd[2] := 0
            prd[3] := octetos - 1
        fin
        pon(del_puerto(p, P_IS), 0xFFFFFFFF)
        pon(del_puerto(p, P_CI), 1)
        ; hasta que la orden sale de la lista, o el disco da un error (bit 30)
        bien := cierto
        b := tics + 1000
        n := 0
        mientras lee(del_puerto(p, P_CI)) yb 1 <> 0 y bien hacer
            n := n + 1
            si lee(del_puerto(p, P_IS)) yb 0x40000000 <> 0 o tics > b o n > 200000000 entonces bien := falso fin
        fin
        si lee(del_puerto(p, P_IS)) yb 0x40000000 <> 0 o lee(del_puerto(p, P_TFD)) yb 0x01 <> 0 entonces bien := falso fin
        si no bien entonces
            ; que el puerto quede listo para otra orden: parar y arrancar
            fallos_de_disco := fallos_de_disco + 1
            pon(del_puerto(p, P_CMD), lee(del_puerto(p, P_CMD)) yb nob CMD_ST)
            espera(del_puerto(p, P_CMD), CMD_CR, 0, 60)
            pon(del_puerto(p, P_SERR), 0xFFFFFFFF)
            pon(del_puerto(p, P_IS), 0xFFFFFFFF)
            pon(del_puerto(p, P_CMD), lee(del_puerto(p, P_CMD)) ob CMD_ST)
        fin
        devolver bien
    fin

    ; el COMRESET del puerto p (parado): que el enlace se rehaga desde cero, sin
    ; dejar que se duerma (IPM = 3); da cierto si vuelve a haber enlace
    función reinicia_puerto(p: nat32): bool
        variable c: nat32
        c := lee(del_puerto(p, P_SCTL)) yb 0xFFFFF0F0
        pon(del_puerto(p, P_SCTL), c ob 0x301)
        pausa(2)                                                ; (la norma: 1 ms al menos)
        pon(del_puerto(p, P_SCTL), c ob 0x300)
        espera_enlace(p, 100)
        pon(del_puerto(p, P_SERR), 0xFFFFFFFF)
        devolver (lee(del_puerto(p, P_SSTS)) yb 0x0F) = 3
    fin

    ; que el puerto tenga corriente, que el disco gire (si los discos giran
    ; uno a uno: CAP.SSS) y que el enlace se despierte (puede venir dormido:
    ; en los portátiles, para ahorrar). Da cierto si se ha encendido algo
    ; que estaba apagado.
    función enciende_puerto(p: nat32): bool
        variable c, n: nat32
        c := lee(del_puerto(p, P_CMD))
        n := c
        si cap yb CAP_SSS <> 0 entonces n := n ob CMD_SUD fin
        si c yb CMD_CPD <> 0 entonces n := n ob CMD_POD fin
        n := n yb nob (CMD_ALPE ob CMD_ASP)                     ; (como Linux, «max_performance»)
        si n <> c entonces pon(del_puerto(p, P_CMD), n) fin
        si (n yb CMD_ICC) = 0 entonces pon(del_puerto(p, P_CMD), n ob CMD_ACTIVO) fin
        devolver n <> c
    fin

    ; lo que tiene el puerto p ahora, para el registro (tras cada paso)
    función di_puerto(p: nat32, qué: puntero a byte)
        di("ahci: puerto %u: %s: SSTS %08X, TFD %08X, SERR %08X", p, nat32(qué), lee(del_puerto(p, P_SSTS)), lee(del_puerto(p, P_TFD)), lee(del_puerto(p, P_SERR)))
        di(", CMD %08X, SIG %08X\n", lee(del_puerto(p, P_CMD)), lee(del_puerto(p, P_SIG)), 0, 0, 0)
    fin

    ; prepara el puerto p y, si tiene un disco, lo apunta. Con «a_fondo» (la
    ; segunda vuelta), siempre el COMRESET y esperar más a que el disco esté
    ; listo. El orden, el de la norma (AHCI 1.3, 10.1.2): parar el puerto,
    ; sus tablas, FRE = 1, limpiar SERR e IS, mirar TFD (y, si sigue
    ; ocupado, el COMRESET, con FRE = 1), ST = 1.
    función mira_puerto(p: nat32, a_fondo: bool)
        variable s, i, t, firma: nat32
        variable id: puntero a nat16
        variable reiniciar: bool
        di("ahci: puerto %u: SSTS %08X, CMD %08X, TFD %08X, SIG %08X\n", p, lee(del_puerto(p, P_SSTS)), lee(del_puerto(p, P_CMD)), lee(del_puerto(p, P_TFD)), lee(del_puerto(p, P_SIG)))
        si enciende_puerto(p) entonces espera_enlace(p, 100) fin
        t := lee(del_puerto(p, P_SSTS))
        ; a la primera, sin enlace: nada enchufado (en la segunda, el
        ; COMRESET puede traerlo)
        si (t yb 0x0F) <> 3 y no a_fondo entonces
            si (t yb 0x0F) <> 0 entonces di("ahci: puerto %u: sin enlace (SSTS %08X)\n", p, t, 0, 0, 0) fin
            devolver
        fin
        si cuántos >= MAX_SATA entonces devolver fin
        ; 1. parado: ST = 0 y FRE = 0, y esperar CR = 0 y FR = 0
        si no para_puerto(p) entonces
            di("ahci: puerto %u: no se para (CMD %08X)\n", p, lee(del_puerto(p, P_CMD)), 0, 0, 0)
            devolver
        fin
        ; 2. sus tablas: la lista de órdenes (CLB) y el sitio de los FIS (FB)
        s := cuántos
        satas[s].hay := falso
        satas[s].puerto := p
        si satas[s].tablas = 0 entonces satas[s].tablas := reservar_marco() fin
        si satas[s].datos = 0 entonces satas[s].datos := reservar_marco() fin
        si satas[s].tablas = 0 o satas[s].datos = 0 entonces devolver fin
        llenar(puntero(satas[s].tablas), 0x600, 0)
        pon(del_puerto(p, P_CLB), satas[s].tablas)
        pon(del_puerto(p, P_CLB + 4), 0)
        pon(del_puerto(p, P_FB), satas[s].tablas + 0x400)
        pon(del_puerto(p, P_FB + 4), 0)
        pon(del_puerto(p, P_IE), 0)                             ; sin interrupciones: se mira
        ; 3. FRE = 1 (y esperar FR): desde ahora, lo que mande el disco llega
        pon(del_puerto(p, P_CMD), lee(del_puerto(p, P_CMD)) ob CMD_FRE)
        espera(del_puerto(p, P_CMD), CMD_FR, CMD_FR, 50)
        ; 4. limpiar SERR (también DIAG.X, que si no, el puerto no arranca) e IS
        pon(del_puerto(p, P_SERR), 0xFFFFFFFF)
        pon(del_puerto(p, P_IS), 0xFFFFFFFF)
        di_puerto(p, "tras FRE=1")
        ; 5. TFD, ya con FRE = 1. Si el disco sigue ocupado (BSY o DRQ) al
        ; medio segundo, o sin enlace, o en la segunda vuelta: el COMRESET,
        ; con FRE = 1, para que llegue el FIS que el disco manda al volver el
        ; enlace (con «ahci=ocupado», siempre: la prueba de este camino)
        reiniciar := a_fondo o prueba("ahci=ocupado") o (lee(del_puerto(p, P_SSTS)) yb 0x0F) <> 3
        si no reiniciar entonces reiniciar := no espera(del_puerto(p, P_TFD), 0x88, 0, 50) fin
        si reiniciar entonces
            reinicia_puerto(p)
            pon(del_puerto(p, P_SERR), 0xFFFFFFFF)
            pon(del_puerto(p, P_IS), 0xFFFFFFFF)
            di_puerto(p, "tras COMRESET")
        fin
        t := lee(del_puerto(p, P_SSTS))
        si (t yb 0x0F) <> 3 entonces                            ; nada enchufado (o sin enlace)
            si (t yb 0x0F) <> 0 entonces di("ahci: puerto %u: sin enlace (SSTS %08X)\n", p, t, 0, 0, 0) fin
            para_puerto(p)                                      ; (que no reciba nada en esas tablas)
            devolver
        fin
        puertos_con_algo := puertos_con_algo + 1
        ; que el disco esté listo (un disco que gira puede tardar unos
        ; segundos) y que haya dicho quién es (la firma llega con su FIS)
        si no espera(del_puerto(p, P_TFD), 0x88, 0, espera_disco) entonces
            di("ahci: puerto %u: el disco sigue ocupado (TFD %08X)\n", p, lee(del_puerto(p, P_TFD)), 0, 0, 0)
        fin
        si lee(del_puerto(p, P_SIG)) = 0xFFFFFFFF entonces
            i := tics + 100
            mientras lee(del_puerto(p, P_SIG)) = 0xFFFFFFFF y tics <= i hacer lee(CAP) fin
        fin
        ; 6. ST = 1: el puerto atiende órdenes
        pon(del_puerto(p, P_SERR), 0xFFFFFFFF)
        pon(del_puerto(p, P_CMD), lee(del_puerto(p, P_CMD)) ob CMD_ST)
        di_puerto(p, "tras ST=1")
        ; un lector de CD (ATAPI) u otra cosa: no es un disco. (Con una firma
        ; que no se conoce, o sin firma, se le pregunta igual: IDENTIFY.)
        firma := lee(del_puerto(p, P_SIG))
        si firma = FIRMA_ATAPI o firma = FIRMA_MULTI o firma = FIRMA_SEMB entonces
            di("ahci: puerto %u: no es un disco (firma %08X)\n", p, firma, 0, 0, 0)
            si firma = FIRMA_ATAPI entonces apunta_atapi(p) fin       ; (CD) para ahcicd.cas
            devolver
        fin
        satas[s].lba48 := falso
        si no manda(s, ORDEN_IDENTIFICAR, 0, 0, SECTOR, falso) entonces
            di("ahci: puerto %u: IDENTIFY falla (firma %08X, TFD %08X, IS %08X, SERR %08X)\n", p, firma, lee(del_puerto(p, P_TFD)), lee(del_puerto(p, P_IS)), lee(del_puerto(p, P_SERR)))
            devolver
        fin
        id := puntero(satas[s].datos)
        si id[49] yb 0x200 = 0 entonces                         ; sin LBA: no es de esta época
            di("ahci: puerto %u: el disco no sabe LBA\n", p, 0, 0, 0, 0)
            devolver
        fin
        satas[s].sectores := nat32(id[60]) ob (nat32(id[61]) << 16)
        si id[83] yb 0x400 <> 0 entonces
            satas[s].lba48 := cierto
            si id[102] <> 0 o id[103] <> 0 entonces
                satas[s].sectores := 0xFFFFFFFF                 ; más de 2 TB: se ve hasta ahí
            sino si id[100] <> 0 o id[101] <> 0 entonces
                satas[s].sectores := nat32(id[100]) ob (nat32(id[101]) << 16)
            fin
        fin
        para i desde 0 hasta 19 hacer
            satas[s].modelo[i * 2] := id[27 + i] >> 8
            satas[s].modelo[i * 2 + 1] := id[27 + i]
        fin
        i := 40
        mientras i > 0 y (satas[s].modelo[i - 1] = ' ' o satas[s].modelo[i - 1] = 0) hacer i := i - 1 fin
        satas[s].modelo[i] := 0
        si satas[s].sectores = 0 entonces devolver fin
        satas[s].hay := cierto
        cuántos := cuántos + 1
        di("ahci: puerto %u: disco %s, %u MB\n", p, nat32(dirección(satas[s].modelo[0])), satas[s].sectores div 2048, 0, 0)
    fin

    ; los puertos que hay: PI (si la BIOS no lo ha puesto, los que dice CAP)
    función los_puertos(): nat32
        variable pi: nat32
        pi := lee(PI)
        si prueba("ahci=pi0") entonces pi := 0 fin
        si pi = 0 entonces
            pi := 0xFFFFFFFF
            si (cap yb 0x1F) < 31 entonces pi := (nat32(1) << ((cap yb 0x1F) + 1)) - 1 fin
            di("ahci: PI vale 0: se miran los puertos que dice CAP (%08X)\n", pi, 0, 0, 0, 0)
        fin
        devolver pi
    fin

    ; en las de Intel de antes (ICH6 a la serie 100), cada puerto se enciende
    ; también en el registro PCS del PCI (0x92: un bit por puerto); si la BIOS
    ; ha dejado alguno apagado, se enciende (como ahci_intel_pcs_quirk, en
    ; Linux). A la primera, solo en las del ICH6 y el ICH7 (las de esta
    ; avería); en la segunda vuelta, en todas las de Intel.
    ; ¿es la AHCI de un ICH6 o un ICH7 de Intel?
    función ich6_o_7(): bool
        variable id: nat32
        si prueba("ahci=ich7") entonces devolver cierto fin     ; (para probar en QEMU el camino del ICH7)
        id := pci_leer(aparato, 0)
        si id yb 0xFFFF <> 0x8086 entonces devolver falso fin
        id := id >> 16
        devolver id = 0x2652 o id = 0x2653 o id = 0x27C1 o id = 0x27C5 o id = 0x27C3
    fin

    función enciende_pcs(pi: nat32, todas: bool)
        variable pcs: nat32
        si pci_leer(aparato, 0) yb 0xFFFF <> 0x8086 entonces devolver fin
        si no todas y no ich6_o_7() entonces devolver fin
        pi := pi yb 0x3F
        pcs := pci_leer16(aparato, PCI_PCS)
        si (pcs yb pi) <> pi entonces
            pci_escribir16(aparato, PCI_PCS, pcs ob pi)
            di("ahci: PCS de %04X a %04X (los puertos encendidos)\n", pcs, pci_leer16(aparato, PCI_PCS), 0, 0, 0)
            pausa(20)
        fin
    fin

    ; la segunda vuelta: se reinicia la controladora entera (GHC.HR) y se
    ; dejan como estaban CAP y PI (en Intel se escriben una vez: la BIOS)
    función reinicia_controladora(pi: nat32)
        variable p: nat32
        para p desde 0 hasta 31 hacer
            si pi yb (nat32(1) << p) <> 0 entonces para_puerto(p) fin
        fin
        pon(GHC, lee(GHC) ob GHC_AE)
        pon(GHC, lee(GHC) ob GHC_HR)
        si no espera(GHC, GHC_HR, 0, 100) entonces di("ahci: la controladora no acaba de reiniciarse (GHC %08X)\n", lee(GHC), 0, 0, 0, 0) fin
        pon(GHC, lee(GHC) ob GHC_AE)
        pon(CAP, cap)
        pon(PI, pi)
        pon(GHC, lee(GHC) yb nob 2)
        enciende_pcs(pi, cierto)
        di("ahci: reiniciada: CAP %08X, GHC %08X, PI %08X\n", lee(CAP), lee(GHC), lee(PI), 0, 0)
    fin

    ; (con «ahci=desalineada»: se comprueba que unos registros que no
    ; empiezan en una página se ven bien: la ABAR del ICH7 va a 1 KB)
    función prueba_desalineada(base: nat32)
        variable v: nat32
        variable otra: puntero a nat32
        v := mapear_aparato(base + 0x100, 0x80)
        si v = 0 entonces
            di("ahci: prueba de la base desalineada: no se puede ver\n", 0, 0, 0, 0, 0)
            devolver
        fin
        otra := puntero(v)
        si v yb 0xFFF = 0x100 y otra[P_SSTS >> 2] = lee(del_puerto(0, P_SSTS)) y otra[P_SIG >> 2] = lee(del_puerto(0, P_SIG)) y otra[P_CLB >> 2] = lee(del_puerto(0, P_CLB)) entonces
            di("ahci: prueba de la base desalineada (%08X): bien\n", base + 0x100, 0, 0, 0, 0)
        sino
            di("ahci: prueba de la base desalineada (%08X): MAL\n", base + 0x100, 0, 0, 0, 0)
        fin
    fin

    ; las controladoras de discos que hay en el PCI (clase 01), para el
    ; registro, cuando no se encuentra la AHCI
    función lista_controladoras()
        variable a, n: nat32
        a := pci_busca(0x010000, 0xFF0000, NO_HAY_PCI)
        n := 0
        mientras a <> NO_HAY_PCI y n < 16 hacer
            di("ahci: en el PCI, %02X:%02X.%u: %08X, clase %06X\n", (a >> 16) yb 0xFF, (a >> 11) yb 0x1F, (a >> 8) yb 7, pci_leer(a, 0), pci_leer(a, PCI_CLASE) >> 8)
            a := pci_busca(0x010000, 0xFF0000, a)
            n := n + 1
        fin
        si n = 0 entonces di("ahci: en el PCI no hay controladoras de discos (clase 01)\n", 0, 0, 0, 0, 0) fin
    fin

    ; busca la controladora AHCI y sus discos. Da cuántos discos hay.
    público función identificar(): nat32
        variable base, pi, p, v, vuelta: nat32
        cuántos := 0
        puertos_con_algo := 0
        hay_ahci := falso
        informe_largo := 0
        informe[0] := 0
        aparato := pci_busca(0x010601, 0xFFFFFF, NO_HAY_PCI)
        si aparato = NO_HAY_PCI entonces
            di("ahci: no hay controladora AHCI (clase 01 06 01)\n", 0, 0, 0, 0, 0)
            lista_controladoras()
            apunta_solo(informe)
            devolver 0
        fin
        di("ahci: controladora %02X:%02X.%u, %04X:%04X", (aparato >> 16) yb 0xFF, (aparato >> 11) yb 0x1F, (aparato >> 8) yb 7, pci_leer(aparato, 0) yb 0xFFFF, pci_leer(aparato, 0) >> 16)
        di(", orden %04X, ABAR %08X\n", pci_leer16(aparato, PCI_ORDEN), pci_leer(aparato, PCI_BAR0 + 20), 0, 0, 0)
        base := pci_memoria(aparato, 5)
        si base = 0 entonces
            di("ahci: la ABAR no vale (no es de memoria, o está por encima de 4 GB)\n", 0, 0, 0, 0, 0)
            apunta_solo(informe)
            devolver 0
        fin
        pci_enciende(aparato)
        v := mapear_aparato(base, 0x1100)
        si v = 0 entonces
            di("ahci: no se pueden ver sus registros\n", 0, 0, 0, 0, 0)
            apunta_solo(informe)
            devolver 0
        fin
        reg := puntero(v)
        tomar(cerrojo)
        hay_ahci := cierto
        ; antes de nada, en modo AHCI (la norma: GHC.AE, lo primero)
        pon(GHC, lee(GHC) ob GHC_AE)
        cap := lee(CAP)
        di("ahci: CAP %08X, GHC %08X, PI %08X, VS %08X", cap, lee(GHC), lee(PI), lee(VS), 0)
        si pci_leer(aparato, 0) yb 0xFFFF = 0x8086 entonces di(", MAP/PCS %08X", pci_leer(aparato, 0x90), 0, 0, 0, 0) fin
        di("\n", 0, 0, 0, 0, 0)
        si prueba("ahci=desalineada") entonces prueba_desalineada(base) fin
        ; que la BIOS la suelte, si la norma lo prevé en esta controladora
        ; (CAP2 es de la 1.2: en una 1.1, como la del ICH7, ni se mira)
        si lee(VS) >= 0x00010200 y lee(CAP2) yb 1 <> 0 entonces
            pon(BOHC, lee(BOHC) ob 2)
            espera(BOHC, 1, 0, 200)
        fin
        pon(GHC, lee(GHC) yb nob 2)                             ; sin interrupciones
        pi := los_puertos()
        enciende_pcs(pi, falso)
        ; la primera vuelta, como lo dejó la BIOS; si no sale ningún disco,
        ; la segunda, reiniciando todo (con «ahci=reinicio», solo la segunda)
        vuelta := 0
        si prueba("ahci=reinicio") entonces vuelta := 1 fin
        mientras vuelta < 2 y cuántos = 0 hacer
            espera_disco := 300
            si vuelta = 1 entonces
                ; (en el ICH6 y el ICH7, GHC.HR deja los puertos sin enlace,
                ; que no vuelve: solo el COMRESET de cada puerto; con
                ; «ahci=hr», la controladora entera también, para probarlo)
                si ich6_o_7() y no prueba("ahci=hr") entonces
                    di("ahci: ningún disco: COMRESET de cada puerto (en el ICH6/ICH7, sin reiniciar la controladora)\n", 0, 0, 0, 0, 0)
                sino
                    di("ahci: ningún disco: se reinicia la controladora\n", 0, 0, 0, 0, 0)
                    reinicia_controladora(pi)
                fin
                espera_disco := 1000
            fin
            puertos_con_algo := 0
            para p desde 0 hasta 31 hacer
                si pi yb (nat32(1) << p) <> 0 entonces mira_puerto(p, vuelta = 1) fin
            fin
            vuelta := vuelta + 1
        fin
        soltar(cerrojo)
        si cuántos = 0 entonces di("ahci: ningún disco (puertos con algo: %u)\n", puertos_con_algo, 0, 0, 0, 0) fin
        apunta_solo(informe)
        devolver cuántos
    fin

    ; trae n sectores del disco s, desde el sector lba, a destino
    público función leer_sectores(s: nat32, lba: nat32, n: nat32, destino: puntero a byte): bool
        variable k, orden: nat32
        variable bien: bool
        si s >= MAX_SATA entonces devolver falso fin
        si no satas[s].hay o lba >= satas[s].sectores o n > satas[s].sectores - lba entonces devolver falso fin
        orden := ORDEN_LEER
        si satas[s].lba48 entonces orden := ORDEN_LEER48 fin
        tomar(cerrojo)
        bien := cierto
        mientras bien y n > 0 hacer
            k := n
            si k > POR_VEZ entonces k := POR_VEZ fin
            bien := manda(s, orden, lba, k, k * SECTOR, falso)
            si bien entonces
                copiar_memoria(destino, puntero(satas[s].datos), k * SECTOR)
                destino := destino + k * SECTOR
                sectores_leídos := sectores_leídos + k
                lba := lba + k
                n := n - k
            fin
        fin
        soltar(cerrojo)
        devolver bien
    fin

    ; lleva n sectores de origen al disco s, desde el sector lba
    público función escribir_sectores(s: nat32, lba: nat32, n: nat32, origen: puntero a byte): bool
        variable k, orden: nat32
        variable bien: bool
        si s >= MAX_SATA o no escritura entonces devolver falso fin    ; (sin permiso, ni una orden de escribir al disco)
        si no satas[s].hay o lba >= satas[s].sectores o n > satas[s].sectores - lba entonces devolver falso fin
        orden := ORDEN_ESCRIBIR
        si satas[s].lba48 entonces orden := ORDEN_ESCRIBIR48 fin
        tomar(cerrojo)
        bien := cierto
        mientras bien y n > 0 hacer
            k := n
            si k > POR_VEZ entonces k := POR_VEZ fin
            copiar_memoria(puntero(satas[s].datos), origen, k * SECTOR)
            bien := manda(s, orden, lba, k, k * SECTOR, cierto)
            si bien entonces
                origen := origen + k * SECTOR
                sectores_escritos := sectores_escritos + k
                lba := lba + k
                n := n - k
            fin
        fin
        soltar(cerrojo)
        devolver bien
    fin

    ; le dice al disco s que pase a la superficie lo que tenga guardado
    público función asentar(s: nat32): bool
        variable bien: bool
        variable orden: nat32
        si s >= MAX_SATA o no escritura entonces devolver falso fin
        si no satas[s].hay entonces devolver falso fin
        orden := ORDEN_ASENTAR
        si satas[s].lba48 entonces orden := ORDEN_ASENTAR48 fin
        tomar(cerrojo)
        bien := manda(s, orden, 0, 0, 0, falso)
        soltar(cerrojo)
        devolver bien
    fin

    ; -------------------------------------------------------------------------
    ;  (CD) Los lectores de CD y DVD (ATAPI) de la controladora: aquí solo se
    ;  apuntan sus puertos (y se paran, que no usen las tablas de los
    ;  discos); los lleva ahcicd.cas, con estas dos funciones para sus
    ;  registros.
    ; -------------------------------------------------------------------------
    público constante MAX_SATA_CD = 4
    público variable puertos_atapi: arreglo [MAX_SATA_CD] de nat32
    público variable cuántos_atapi: nat32

    función apunta_atapi(p: nat32)
        variable i: nat32
        para_puerto(p)
        para i desde 1 hasta cuántos_atapi hacer
            si puertos_atapi[i - 1] = p entonces devolver fin     ; (la segunda vuelta)
        fin
        si cuántos_atapi < MAX_SATA_CD entonces
            puertos_atapi[cuántos_atapi] := p
            cuántos_atapi := cuántos_atapi + 1
        fin
    fin

    ; el registro d (P_CMD, P_TFD...: 0x00 a 0x7F) del puerto p
    público función reg_atapi(p: nat32, d: nat32): nat32
        devolver lee(del_puerto(p, d))
    fin

    público función pon_reg_atapi(p: nat32, d: nat32, v: nat32)
        pon(del_puerto(p, d), v)
    fin

fin Ahci.
