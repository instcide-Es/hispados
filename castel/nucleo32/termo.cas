; =============================================================================
;  termo.cas - (TERMO) lo que el núcleo de Hispa-Pentium le da a TERMO.BIN, el
;  Termómetro (nucleo32/termo/): leer las temperaturas del procesador y lo
;  que el servicio de ACPI ha leído de las zonas térmicas. SOLO LEE: ni un
;  registro del procesador, ni del controlador embebido, se escribe desde
;  aquí (lo único que se escribe es el registro índice del SMN de AMD, que
;  no cambia nada: dice qué se va a leer; y, con la 220 y EDX = 1, un 0 en
;  los MSR de los motivos de freno, para borrar sus marcas de registro, que
;  son volátiles: ni límites ni frecuencias). Las llamadas (usuario.cas):
;
;   220  un registro del procesador (MSR) de la lista de abajo: EBX el
;        registro, ECX dónde dejarlo (8 octetos: lo bajo y lo alto)
;        -> 1; 0 si el procesador no lo tiene (la lectura da la excepción 13
;        y se recoge: rdmsr «seguro»); NO_VALE si no está en la lista
;          19Ch IA32_THERM_STATUS (Intel, el núcleo que corre)
;          1B1h IA32_PACKAGE_THERM_STATUS (Intel, todo el procesador)
;          1A2h MSR_TEMPERATURE_TARGET (Intel: la TjMax)
;          E7h, E8h IA32_MPERF, IA32_APERF (la frecuencia de verdad)
;          198h IA32_PERF_STATUS, CEh MSR_PLATFORM_INFO, 17h IA32_PLATFORM_ID
;          y EEh (Core 2: el bit de la TjMax de los de portátil)
;   221  la configuración PCI, para leer, de la lista: el bus 0, aparato
;        18h, función 3 (el «control varios» de los AMD de K8 a la familia
;        16h: sus registros 00h, 08h, A4h, E4h y FCh) y el 00h del 0:0.0
;        (quién es el puente) -> lo leído (4 octetos); NO_VALE si no vale
;   222  el SMN de AMD: EBX la dirección, solo 00059800h (familia 17h en
;        adelante: la temperatura, por 0:0.0 60h/64h, como amd_smn_read de
;        Linux) y D8200CA4h (familia 15h modelos 60h-7Fh, Carrizo y
;        Bristol Ridge: por 0:0.0 B8h/BCh, como amd_nb_index_read; antes,
;        por error, D8200C64h, que en el ThinkPad A275 daba 114,3 °C fijos);
;        solo con un procesador AMD y su puente (1022h) en 0:0.0 -> lo leído
;   223  las zonas térmicas: ECX = 0 (cualquiera), EBX dónde dejar lo último
;        que dio el servicio (1024 octetos) -> 1, o 0 si aún no hay; ECX = 1
;        (solo el servicio de ACPI) lo da él, desde EBX -> 1 si alguien lo ha
;        pedido en los últimos 10 s (si no, no hace falta que lo lea)
;   225  (TERMO) las gráficas NVIDIA (Maxwell y Pascal) y los puertos PCI
;        Express: «Las gráficas NVIDIA», abajo (lo único que puede escribir el
;        núcleo aquí, y solo si el Termómetro lo pide: lo volátil que hace
;        nouveau para encender el sensor, y el bit «memoria» y D3hot->D0 de
;        pci_enable_device; se pierde al apagar)
;   224  la prueba de esfuerzo: EBX = 1, ECX 1 o 0 (cargar o parar); EBX = 0
;        -> 1 si hay que seguir cargando (y el Termómetro ha preguntado por
;        las zonas hace menos de 6 s: si se cuelga o se cierra, la carga para);
;        (con la carga, también los demás procesadores: «Los otros
;        procesadores», abajo; EBX = 4, su tabla)
;        EBX = 5: el registro del arranque (ECX octetos como mucho, en EDX)
;        EBX = 2: los tics que ha corrido la tarea ociosa (el «hlt»); 3: los
;        del reloj (con los dos, lo ocupado que está el procesador)
;        EBX = 6: (TERMO) los demás procesadores, dormidos y despiertos otra
;        vez (los que se han parado solos tras un parón del equipo); EBX = 7:
;        en qué se va el procesador (las órdenes de la memoria USB y los tics
;        de cada tarea): en ECX, EDX octetos
;        (TERMO-FUERTE, 0.8.12) EBX = 1 con ECX bit 1: la carga «fuerte» en
;        los demás procesadores (SSE2, abajo; solo si el núcleo ha encendido
;        el SSE2); EBX = 8: la coma flotante del núcleo (100h más Tareas.sse:
;        1 FXSAVE, 2 SSE, 4 SSE2; un núcleo de antes da 0); en la tabla de
;        EBX = 4, el cuarto número es la carga pedida (1 fuerte) y, de cada
;        procesador, +28 su CR0 al llegar (CD y NW: la caché) con el bit 31
;        si hace la fuerte
;        En la 220, también (Intel de Nehalem en adelante) 3F8h, 3F9h, 3FAh,
;        3FCh, 3FDh y 3FEh: lo que lleva el paquete y el núcleo en C3, C6 y C7;
;        34h (MSR_SMI_COUNT: los SMI del firmware que ha atendido); 179h,
;        17Ah y de 400h a 47Fh (Machine Check: los errores de hardware);
;        y 690h, 6B0h, 6B1h: por qué se frena (PROCHOT, térmico, la alarma
;        del regulador de tensión, los límites de potencia y de corriente)
;        (TERMO, potencia.c) Y la potencia, solo leer: RAPL (606h unidades,
;        611h paquete, 613h tiempo frenado, 619h memoria, 639h núcleos, 641h
;        gráfica, 64Dh el equipo entero), los límites (610h PL1/PL2, 614h
;        TDP, 65Ch el del equipo, 1ADh las relaciones de turbo, 648h a 64Ch
;        el TDP configurable), 64Fh (por qué se frena, de Skylake en
;        adelante), 60Dh y 630h a 632h (el paquete en PC2, PC8, PC9, PC10);
;        en AMD (familia 17h en adelante) C0010299h, C001029Ah y C001029Bh
;        (las unidades y la energía del núcleo y del paquete).
;        Con EDX = 1 (solo Intel, solo 19Ch, 1B1h, 690h, 6B0h, 6B1h y 64Fh):
;        escribe 0 en él (wrmsr «seguro»), lo que borra sus marcas de
;        registro (R/WC0) sin tocar nada más (lo demás es de solo lectura)
;        -> 1 bien, 0 si no se deja
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Termo

    importar Cpu, Tareas, Paginas, Mem32, Energia, Multiboot, Formato, Registro, Usbalm, Textos32

    constante NO_VALE = 0xFFFFFFF9              ; (el de usuario.cas)
    constante TAM_BLOQUE = 1024

    variable bloque: arreglo [1024] de byte
    variable hay_bloque: bool
    variable visto: nat32                       ; los tics de la última vez que se pidió (223)
    variable carga: nat32
    variable carga_fuerte: bool                 ; (TERMO-FUERTE) la carga fuerte (SSE2) en los demás procesadores
    variable r_cpu: arreglo [4] de nat32        ; lo que da cpuid
    ; el rdmsr que puede fallar: dónde está y dónde se sigue (semilla.cas,
    ; la excepción 13, mira «recupera»)
    variable msr_ins, msr_sigue: nat32
    público variable msr_lo, msr_hi: nat32      ; (PSTATE) lo leído, también para semilla.cas
    variable en_msr, msr_falló: bool

    función cpuid(hoja: nat32)
        ensamblador
            push ebx
            mov eax, {hoja}
            xor ecx, ecx
            db 0x0F, 0xA2               ; cpuid
            mov {r_cpu}, eax
            mov {r_cpu+4}, ebx
            mov {r_cpu+8}, ecx
            mov {r_cpu+12}, edx
            pop ebx
        fin
    fin

    ; 1 Intel, 2 AMD, 0 otro
    función fabricante(): nat32
        cpuid(0)
        si r_cpu[1] = 0x756E6547 y r_cpu[3] = 0x49656E69 y r_cpu[2] = 0x6C65746E entonces devolver 1 fin   ; GenuineIntel
        si r_cpu[1] = 0x68747541 y r_cpu[3] = 0x69746E65 y r_cpu[2] = 0x444D4163 entonces devolver 2 fin   ; AuthenticAMD
        devolver 0
    fin

    ; (semilla.cas, la excepción 13 en el núcleo) si ha sido el rdmsr de
    ; aquí, se apunta que ha fallado y se da dónde seguir; si no, 0
    público función recupera(eip: nat32): nat32
        si en_msr y eip = msr_ins entonces
            msr_falló := cierto
            devolver msr_sigue
        fin
        devolver 0
    fin

    público función rdmsr_seguro(m: nat32): bool     ; (PSTATE) público: el estado P de semilla.cas
        variable b: nat32
        b := sin_interrupciones()
        msr_falló := falso
        msr_lo := 0
        msr_hi := 0
        en_msr := cierto
        ensamblador
            lea eax, [.ins]
            mov {msr_ins}, eax
            lea eax, [.sigue]
            mov {msr_sigue}, eax
            mov ecx, {m}
        .ins:
            db 0x0F, 0x32               ; rdmsr
            mov {msr_lo}, eax
            mov {msr_hi}, edx
        .sigue:
        fin
        en_msr := falso
        reponer(b)
        devolver no msr_falló
    fin

    ; (PSTATE) escribir un MSR sin que un #GP pare el núcleo (lo mismo que
    ; rdmsr_seguro: la excepción 13 de semilla.cas mira «recupera»). Solo
    ; desde el núcleo (semilla.cas: IA32_PERF_CTL); los programas no llegan
    público función wrmsr_seguro(m: nat32, lo: nat32, hi: nat32): bool
        variable b: nat32
        b := sin_interrupciones()
        msr_falló := falso
        en_msr := cierto
        ensamblador
            lea eax, [.ins]
            mov {msr_ins}, eax
            lea eax, [.sigue]
            mov {msr_sigue}, eax
            mov ecx, {m}
            mov eax, {lo}
            mov edx, {hi}
        .ins:
            db 0x0F, 0x30               ; wrmsr
        .sigue:
        fin
        en_msr := falso
        reponer(b)
        devolver no msr_falló
    fin

    función msr_de_la_lista(m: nat32): bool
        según m
            caso 0x19C, 0x1B1, 0x1A2, 0xE7, 0xE8, 0x198, 0xCE, 0x17, 0xEE: devolver cierto
            ; (TERMO) MSR_SMI_COUNT (Intel de Nehalem en adelante): cuántas
            ; interrupciones del firmware (SMI) ha atendido el procesador
            caso 0x34: devolver cierto
            ; (TERMO) la residencia en los estados de reposo (Intel de Nehalem en
            ; adelante): el paquete en C3, C6 y C7, el núcleo en C3, C6 y C7
            caso 0x3F8, 0x3F9, 0x3FA, 0x3FC, 0x3FD, 0x3FE: devolver cierto
            ; (TERMO) por qué se frena (Intel de Haswell en adelante): el
            ; núcleo, la gráfica integrada y el anillo (MSR_*_PERF_LIMIT_REASONS)
            caso 0x690, 0x6B0, 0x6B1: devolver cierto
            ; (TERMO) la potencia (potencia.c): RAPL, los límites, el turbo,
            ; el TDP configurable, los motivos de Skylake y los C-states que
            ; faltaban (PC2, PC8 a PC10); solo leer
            caso 0x606, 0x610, 0x611, 0x613, 0x614, 0x619, 0x639, 0x641, 0x64D, 0x65C: devolver cierto
            caso 0x1AD, 0x648, 0x649, 0x64A, 0x64B, 0x64C, 0x64F: devolver cierto
            caso 0x60D, 0x630, 0x631, 0x632: devolver cierto
            ; (TERMO) Machine Check: MCG_CAP, MCG_STATUS y los bancos (CTL,
            ; STATUS, ADDR, MISC de hasta 32): los errores de hardware que ha
            ; anotado el procesador (caché, memoria, bus, PCIe), solo leer
            caso 0x179, 0x17A: devolver cierto
        fin
        si m >= 0x400 y m < 0x480 entonces devolver cierto fin
        ; (TERMO) AMD de la familia 17h en adelante: las unidades de RAPL y la
        ; energía del núcleo y del paquete (aparte del «según»: lejos de los demás)
        si m >= 0xC0010299 y m <= 0xC001029B entonces devolver cierto fin
        devolver falso
    fin

    función lee_pci(d: nat32): nat32
        variable b, r: nat32
        b := sin_interrupciones()
        escribe_puerto(0xCF8, 4, 0x80000000 ob (d yb 0x00FFFFFC))
        r := lee_puerto(0xCFC, 4)
        reponer(b)
        devolver r
    fin

    función pci_de_la_lista(d: nat32): bool
        si d yb 3 <> 0 entonces devolver falso fin
        si d = 0 entonces devolver cierto fin                   ; 0:0.0, quién es
        si d yb 0xFFFFFF00 <> (0x18 << 11) ob (3 << 8) entonces devolver falso fin
        según d yb 0xFF
            caso 0x00, 0x08, 0xA4, 0xE4, 0xFC: devolver cierto
        fin
        devolver falso
    fin

    ; el SMN, por el índice y el dato del 0:0.0, de una vez
    función lee_smn(dir: nat32): nat32
        variable b, r, ind: nat32
        si dir = 0x00059800 entonces ind := 0x60 sino ind := 0xB8 fin
        b := sin_interrupciones()
        escribe_puerto(0xCF8, 4, 0x80000000 ob ind)
        escribe_puerto(0xCFC, 4, dir)
        escribe_puerto(0xCF8, 4, 0x80000000 ob (ind + 4))
        r := lee_puerto(0xCFC, 4)
        reponer(b)
        devolver r
    fin


    ; =========================================================================
    ;  (TERMO) Los otros procesadores, solo para la prueba de esfuerzo
    ; =========================================================================
    ;  Hispa-Pentium usa un procesador (el «BSP»); los demás (los «AP»: los
    ;  otros núcleos y sus hilos) se quedan como los deja la BIOS, dormidos
    ;  esperando una señal de arranque. Para que la prueba caliente de verdad
    ;  un portátil de 4 núcleos (el MSI GT80), al empezar la carga se les
    ;  despierta (INIT, SIPI, SIPI a todos menos a este, como hace cualquier
    ;  sistema) en un trampolín de dos páginas de la memoria baja (libres
    ;  según el mapa de multiboot y lejos de lo del cargador; lo que había se
    ;  guarda y se repone al acabar). Allí pasan a modo protegido con su GDT,
    ;  su IDT (cualquier excepción: «hlt», nunca un triple fallo) y su pila, y
    ;  solo hacen esto, con las interrupciones cerradas: cuentas de coma
    ;  flotante mientras la bandera lo pida (la ligera, x87: una cadena de
    ;  fsqrt; o, desde la 0.8.12, la fuerte, SSE2: «termo_ap_fuerte», con la
    ;  caché encendida), y de vez en cuando leen su propio
    ;  MSR 19Ch (la temperatura de su núcleo) y lo dejan en una tabla. No tocan
    ;  nada del núcleo. Se paran: cuando se baja la bandera, o si el latido
    ;  (cada llamada 223/224 del Termómetro) no cambia en unos 10 s (unos
    ;  20.000 millones de ciclos); entonces «hlt». Al acabar, otro INIT los
    ;  deja como estaban y se repone la memoria. Si algo no está (sin APIC,
    ;  APIC apagado, sin sitio en la memoria baja), no se despierta a nadie y
    ;  se dice por qué (224 con 4: el motivo).
    ;  El trampolín (las dos páginas, desde B):
    ;    +000h el código (16 bits y luego 32), +400h la GDT, +420h su GDTR,
    ;    +430h el IDTR, +440h ORDEN (1: cargar), +444h cuántos han llegado,
    ;    +448h el latido, +44Ch la carga (1: la fuerte), +500h la IDT (32
    ;    puertas, todas a «hlt»), +600h lo que suma la fuerte, +610h su MXCSR,
    ;    +800h la tabla (16 x 32 octetos: el APIC ID, el estado (1 cargando, 2
    ;    parado), las vueltas, el último 19Ch, cuántas lecturas, el latido y el
    ;    TSC que vio, y su CR0 al llegar con el bit 31 si hace la fuerte), +A00h
    ;    el bloque de la fuerte (1344 octetos, 168 dobles), +1000h las pilas
    constante AP_MAX = 16
    público variable ap_base: nat32              ; (RAM) público: termoram.cas no despierta a nadie mientras la carga los tiene
    variable ap_activos, ap_motivo, ap_lapic: nat32
    variable ap_x2: bool
    variable ap_guardado: arreglo [8192] de byte

    ; el código del trampolín: dónde empieza y acaba, y su «hlt»
    función trampolín(ref ini: nat32, ref fin_: nat32, ref alto: nat32)
        variable a, b, c: nat32
        ensamblador
            lea eax, [termo_ap_inicio]
            mov {a}, eax
            lea eax, [termo_ap_fin]
            mov {b}, eax
            lea eax, [termo_ap_alto]
            mov {c}, eax
            jmp termo_ap_sigue
        termo_ap_inicio:
            ; (en 16 bits; a mano, como lo da NASM: los ensambladores propios
            ; —ensambla.py, ENSAMB32, ENSAMB64— no tienen «bits 16» ni el salto
            ; lejano de 32 bits) cli; mov ax, cs; mov ds, ax; o32 lgdt [0x420];
            ; mov eax, cr0; or al, 1; mov cr0, eax; jmp dword 0x08:1Bh (el de
            ; termo_ap_32: 27 octetos más allá de termo_ap_inicio)
            db 0xFA, 0x8C, 0xC8, 0x8E, 0xD8, 0x66, 0x0F, 0x01, 0x16, 0x20, 0x04
            db 0x0F, 0x20, 0xC0, 0x0C, 0x01, 0x0F, 0x22, 0xC0
            db 0x66, 0xEA, 0x1B, 0x00, 0x00, 0x00, 0x08, 0x00
        termo_ap_32:
            mov ax, 0x10
            mov ds, ax
            mov es, ax
            mov ss, ax
            mov fs, ax
            mov gs, ax
            db 0x0F, 0x01, 0x1D, 0x30, 0x04, 0x00, 0x00     ; lidt [0x430]
            mov eax, 1
            db 0xF0, 0x0F, 0xC1, 0x05, 0x44, 0x04, 0x00, 0x00   ; lock xadd [0x444], eax (486: a mano, el núcleo es «cpu 386»)
            cmp eax, 16
            jae termo_ap_alto
            mov esp, eax
            shl esp, 8
            add esp, 0x1100
            mov edi, eax
            shl edi, 5
            add edi, 0x800
            mov eax, 1
            db 0x0F, 0xA2               ; cpuid: el APIC ID, arriba de EBX
            shr ebx, 24
            mov [edi], ebx
            xor ebp, ebp
            xor eax, eax
            db 0x0F, 0xA2
            cmp eax, 6
            jb termo_ap_sin_dts
            mov eax, 6
            db 0x0F, 0xA2
            and eax, 1
            mov ebp, eax                ; 1: tiene sensor (Intel: 19Ch)
        termo_ap_sin_dts:
            mov dword [edi+4], 1
            mov eax, cr0                ; (TERMO-FUERTE) cómo llega: CR0 (CD y NW: la caché, como la deja la BIOS)
            and eax, 0x7FFFFFFF
            mov [edi+28], eax
            db 0xDB, 0xE3               ; fninit (a mano: ensambla.py no sabe el x87)
            ; (TERMO-FUERTE) la carga fuerte, si se pide (+44Ch) y este
            ; procesador tiene FXSAVE y SSE2: la caché encendida (CD y NW a
            ; 0, como hace cualquier sistema con sus procesadores), el x87
            ; de verdad (EM a 0, MP y NE a 1), CR4.OSFXSR y OSXMMEXCPT, MXCSR
            ; (+610h) y los registros: XMM7, lo que se suma (+600h); XMM0 a
            ; XMM6, los primeros del bloque (+A00h). La marca: el bit 31 de
            ; +28 (CR0 nunca lo tiene aquí: sin paginación)
            cmp dword [0x44C], 1
            jne termo_ap_ligera
            mov eax, 1
            db 0x0F, 0xA2               ; cpuid
            and edx, 0x05000000         ; FXSR (24) y SSE2 (26)
            cmp edx, 0x05000000
            jne termo_ap_ligera
            mov eax, cr0
            and eax, 0x9FFFFFF3
            or eax, 0x22
            mov cr0, eax
            db 0x0F, 0x20, 0xE0         ; mov eax, cr4
            or eax, 0x600
            db 0x0F, 0x22, 0xE0         ; mov cr4, eax
            db 0x0F, 0xAE, 0x15, 0x10, 0x06, 0x00, 0x00         ; ldmxcsr [0x610]
            db 0x66, 0x0F, 0x28, 0x3D, 0x00, 0x06, 0x00, 0x00   ; movapd xmm7, [0x600]
            db 0x66, 0x0F, 0x28, 0x05, 0x00, 0x0A, 0x00, 0x00   ; movapd xmm0, [0xA00]
            db 0x66, 0x0F, 0x28, 0x0D, 0x10, 0x0A, 0x00, 0x00   ; movapd xmm1, [0xA10]
            db 0x66, 0x0F, 0x28, 0x15, 0x20, 0x0A, 0x00, 0x00   ; movapd xmm2, [0xA20]
            db 0x66, 0x0F, 0x28, 0x1D, 0x30, 0x0A, 0x00, 0x00   ; movapd xmm3, [0xA30]
            db 0x66, 0x0F, 0x28, 0x25, 0x40, 0x0A, 0x00, 0x00   ; movapd xmm4, [0xA40]
            db 0x66, 0x0F, 0x28, 0x2D, 0x50, 0x0A, 0x00, 0x00   ; movapd xmm5, [0xA50]
            db 0x66, 0x0F, 0x28, 0x35, 0x60, 0x0A, 0x00, 0x00   ; movapd xmm6, [0xA60]
            or dword [edi+28], 0x80000000
        termo_ap_ligera:
            mov eax, [0x448]
            mov [edi+20], eax
            db 0x0F, 0x31               ; rdtsc
            mov [edi+24], edx
        termo_ap_vuelta:
            cmp dword [0x440], 1
            jne termo_ap_para
            test dword [edi+28], 0x80000000
            jnz termo_ap_fuerte
            mov ecx, 100000
            db 0xD9, 0xE8               ; fld1
        termo_ap_carga:
            db 0xD9, 0xFA               ; fsqrt
            db 0xD8, 0xC0               ; fadd st0, st0
            db 0xD9, 0xFA               ; fsqrt
            dec ecx
            jnz termo_ap_carga
            db 0xDD, 0xD8               ; fstp st0
            jmp termo_ap_cuenta
            ; (TERMO-FUERTE) la carga fuerte: siete cadenas independientes
            ; de x := x * a + c (mulpd con un operando del bloque, addpd con
            ; XMM7), dos dobles en cada registro: las dos unidades de coma
            ; flotante del núcleo ocupadas casi siempre, y el bloque (1344
            ; octetos) leído de la caché L1, sin ir a la memoria. Con a entre
            ; 1 - 2^-14 y 1 - 2^-17 y c = 2^-13, x se queda entre 2 y 16: ni
            ; desbordamientos ni números subnormales (que irían despacio).
            ; 40.000 pasadas de 12 trozos: unos 4 millones de ciclos, como
            ; una vuelta de la ligera
        termo_ap_fuerte:
            mov edx, 40000
        termo_ap_pasada:
            mov esi, 0xA00
            mov ecx, 12
        termo_ap_trozo:
            db 0x66, 0x0F, 0x59, 0x06           ; mulpd xmm0, [esi]
            db 0x66, 0x0F, 0x58, 0xC7           ; addpd xmm0, xmm7
            db 0x66, 0x0F, 0x59, 0x4E, 0x10     ; mulpd xmm1, [esi+16]
            db 0x66, 0x0F, 0x58, 0xCF           ; addpd xmm1, xmm7
            db 0x66, 0x0F, 0x59, 0x56, 0x20     ; mulpd xmm2, [esi+32]
            db 0x66, 0x0F, 0x58, 0xD7           ; addpd xmm2, xmm7
            db 0x66, 0x0F, 0x59, 0x5E, 0x30     ; mulpd xmm3, [esi+48]
            db 0x66, 0x0F, 0x58, 0xDF           ; addpd xmm3, xmm7
            db 0x66, 0x0F, 0x59, 0x66, 0x40     ; mulpd xmm4, [esi+64]
            db 0x66, 0x0F, 0x58, 0xE7           ; addpd xmm4, xmm7
            db 0x66, 0x0F, 0x59, 0x6E, 0x50     ; mulpd xmm5, [esi+80]
            db 0x66, 0x0F, 0x58, 0xEF           ; addpd xmm5, xmm7
            db 0x66, 0x0F, 0x59, 0x76, 0x60     ; mulpd xmm6, [esi+96]
            db 0x66, 0x0F, 0x58, 0xF7           ; addpd xmm6, xmm7
            add esi, 112
            dec ecx
            jnz termo_ap_trozo
            dec edx
            jnz termo_ap_pasada
        termo_ap_cuenta:
            inc dword [edi+8]
            mov eax, [0x448]
            cmp eax, [edi+20]
            je termo_ap_igual
            mov [edi+20], eax
            db 0x0F, 0x31
            mov [edi+24], edx
            jmp termo_ap_temp
        termo_ap_igual:
            db 0x0F, 0x31
            sub edx, [edi+24]
            cmp edx, 5
            jae termo_ap_para
        termo_ap_temp:
            test ebp, ebp
            jz termo_ap_vuelta
            mov eax, [edi+8]
            and eax, 15
            jnz termo_ap_vuelta
            mov ecx, 0x19C
            db 0x0F, 0x32               ; rdmsr
            mov [edi+12], eax
            inc dword [edi+16]
            jmp termo_ap_vuelta
        termo_ap_para:
            mov dword [edi+4], 2
        termo_ap_alto:
            cli
            hlt
            jmp termo_ap_alto
        termo_ap_fin:
        termo_ap_sigue:
        fin
        ini := a
        fin_ := b
        alto := c
    fin
    ; esperar, por el reloj del núcleo (las interrupciones van en las
    ; llamadas): n microsegundos, de 10 ms en 10 ms (lo corto, un tic entero:
    ; esperar de más no estorba). Por el puerto 80h (lo de siempre) en QEMU con
    ; KVM eran más de 6 s; con tope de vueltas por si el reloj no corre
    función espera_us(n: nat32)
        variable t0, ticks, i: nat32
        ticks := (n + 9999) div 10000 + 1
        t0 := tics
        i := 0
        mientras tics - t0 < ticks y i < 200000000 hacer
            i := i + 1
        fin
    fin

    función wrmsr(m: nat32, lo: nat32, hi: nat32)
        ensamblador
            mov ecx, {m}
            mov eax, {lo}
            mov edx, {hi}
            db 0x0F, 0x30               ; wrmsr
        fin
    fin

    ; un IPI a todos menos a este (v: el ICR de abajo)
    función ipi_todos(v: nat32)
        variable p: puntero a nat32
        variable n: nat32
        si ap_x2 entonces
            wrmsr(0x830, v, 0)
            devolver
        fin
        p := puntero(ap_lapic + 0x310)
        p[0] := 0
        p := puntero(ap_lapic + 0x300)
        p[0] := v
        n := 0
        mientras p[0] yb 0x1000 <> 0 y n < 100000 hacer
            n := n + 1
        fin
    fin

    ; ¿se solapa [a, a + n) con las dos páginas de b?
    función solapa(b: nat32, a: nat32, n: nat32): bool
        si a = 0 entonces devolver falso fin
        devolver a < b + 0x2000 y a + n > b
    fin

    ; las dos páginas del trampolín: libres en el mapa, por debajo de 640 K,
    ; y sin nada del cargador (su información, el mapa, la línea, los módulos)
    función elige_páginas(): nat32
        variable b, i, k, n: nat32
        variable r: puntero a Región
        variable dentro: bool
        n := regiones()
        si n = 0 entonces devolver 0 fin
        b := 0x8F000
        mientras b >= 0x2000 hacer
            dentro := falso
            para i desde 0 hasta n - 1 hacer
                r := región(i)
                si r <> nulo y r.clase = Multiboot.LIBRE y r.base_alta = 0 y r.base <= b y r.base + r.largo >= b + 0x2000 entonces dentro := cierto fin
            fin
            si dentro y (solapa(b, dirección_info(), 0x100) o solapa(b, dirección_mapa(), largo_mapa())) entonces dentro := falso fin
            si dentro y (solapa(b, nat32(línea_del_cargador()), 0x400) o solapa(b, dirección_módulos(), módulos() * 16)) entonces dentro := falso fin
            si dentro entonces
                k := 0
                mientras k < módulos() y no solapa(b, nat32(módulo_texto(k)), 0x100) hacer
                    k := k + 1
                fin
                si k = módulos() entonces devolver b fin
            fin
            b := b - 0x1000
        fin
        devolver 0
    fin

    ; pone un descriptor de 8 octetos en p: la base, el límite (4 K), «clase»
    función descriptor(p: puntero a nat32, base: nat32, clase: nat32)
        p[0] := 0x0000FFFF ob ((base yb 0xFFFF) << 16)
        p[1] := ((base >> 16) yb 0xFF) ob (clase << 8) ob 0x00CF0000 ob (base yb 0xFF000000)
    fin

    ; los para y los deja como estaban (INIT), y repone la memoria baja
    función duerme_ap()
        variable p: puntero a nat32
        variable i, n, parados, b, x: nat32
        ; (la llaman el Termómetro y su tarea de carga, quizá a la vez: solo una)
        x := sin_interrupciones()
        b := ap_base
        ap_base := 0
        reponer(x)
        si b = 0 entonces devolver fin
        p := puntero(b + 0x440)
        p[0] := 0
        n := 0
        parados := 0
        mientras n < 30 hacer
            parados := 0
            para i desde 0 hasta AP_MAX - 1 hacer
                p := puntero(b + 0x800 + i * 32 + 4)
                si p[0] <> 1 entonces parados := parados + 1 fin
            fin
            si parados = AP_MAX entonces n := 30 sino espera_us(5000) fin
            n := n + 1
        fin
        ipi_todos(0x000C4500)                   ; INIT: esperando otra vez, como los deja la BIOS
        espera_us(10000)
        copiar_memoria(puntero(b), puntero(dirección(ap_guardado)), 8192)
        imprimir2("termo: AP: dormidos otra vez (%u; parados %u)\n", ap_activos, parados)
        ap_activos := 0
    fin

    ; el latido: mientras el Termómetro pregunte, siguen
    función late()
        variable p: puntero a nat32
        si ap_base = 0 entonces devolver fin
        p := puntero(ap_base + 0x448)
        p[0] := p[0] + 1
    fin

    ; despierta a los demás: cuántos han llegado (0: nadie; ap_motivo dice por qué)
    función despierta_ap(): nat32
        variable ini, fin_, alto, b, i, n, ant: nat32
        variable p: puntero a nat32
        variable q: puntero a byte
        si ap_base <> 0 entonces devolver ap_activos fin
        ap_activos := 0
        cpuid(1)
        si r_cpu[3] yb 0x200 = 0 o r_cpu[3] yb 0x20 = 0 entonces
            ap_motivo := 1                      ; sin APIC (o sin MSR)
            devolver 0
        fin
        si no rdmsr_seguro(0x1B) o msr_lo yb 0x800 = 0 entonces
            ap_motivo := 2                      ; el APIC, apagado
            devolver 0
        fin
        ap_x2 := msr_lo yb 0x400 <> 0
        si ap_x2 entonces
            si no rdmsr_seguro(0x80F) o msr_lo yb 0x100 = 0 entonces
                ap_motivo := 2
                devolver 0
            fin
        sino
            si ap_lapic = 0 entonces ap_lapic := mapear_aparato(msr_lo yb 0xFFFFF000, 4096) fin
            si ap_lapic = 0 entonces
                ap_motivo := 3                  ; no se puede ver el APIC
                devolver 0
            fin
            p := puntero(ap_lapic + 0xF0)
            si p[0] yb 0x100 = 0 entonces
                ap_motivo := 2
                devolver 0
            fin
        fin
        b := elige_páginas()
        si b = 0 entonces
            ap_motivo := 4                      ; sin sitio en la memoria baja
            devolver 0
        fin
        trampolín(ini, fin_, alto)
        si fin_ - ini > 0x400 entonces
            ap_motivo := 5
            devolver 0
        fin
        ; lo que había, guardado; y el trampolín, puesto
        copiar_memoria(puntero(dirección(ap_guardado)), puntero(b), 8192)
        llenar(puntero(b), 8192, 0)
        copiar_memoria(puntero(b), puntero(ini), fin_ - ini)
        descriptor(puntero(b + 0x408), b, 0x9A)         ; el código (base b)
        descriptor(puntero(b + 0x410), b, 0x92)         ; los datos
        q := puntero(b + 0x420)
        q[0] := 23
        q[1] := 0
        p := puntero(b + 0x422)
        p[0] := b + 0x400
        q := puntero(b + 0x430)
        q[0] := 255
        q[1] := 0
        p := puntero(b + 0x432)
        p[0] := b + 0x500
        para i desde 0 hasta 31 hacer
            p := puntero(b + 0x500 + i * 8)
            p[0] := 0x00080000 ob ((alto - ini) yb 0xFFFF)
            p[1] := 0x00008E00
        fin
        ; (TERMO-FUERTE) lo de la carga fuerte: lo que se suma (2^-13, en los
        ; dos dobles de +600h), MXCSR (+610h: todo enmascarado) y el bloque
        ; (+A00h, 168 dobles): a entre 1 - 2^-14 y 1 - 2^-17 (la palabra alta,
        ; de 3FEFFF80h a 3FEFFFBFh; la baja, a 0)
        p := puntero(b + 0x600)
        p[0] := 0
        p[1] := 0x3F200000
        p[2] := 0
        p[3] := 0x3F200000
        p[4] := 0x1F80
        para i desde 0 hasta 167 hacer
            p := puntero(b + 0xA00 + i * 8)
            p[0] := 0
            p[1] := 0x3FEFFF80 + ((i * 37) mod 64)
        fin
        p := puntero(b + 0x440)
        p[0] := 1                                       ; ORDEN: cargar
        p[1] := 0
        p[2] := 1
        si carga_fuerte entonces p[3] := 1 sino p[3] := 0 fin   ; (TERMO-FUERTE) +44Ch: 1, la fuerte
        ap_base := b
        ; INIT, y dos SIPI al trampolín (el vector: la página)
        ipi_todos(0x000C4500)
        espera_us(10000)
        ipi_todos(0x000C4600 ob (b >> 12))
        espera_us(300)
        ipi_todos(0x000C4600 ob (b >> 12))
        ; los que lleguen en 200 ms (a cada uno, se le espera; el que no, no está)
        p := puntero(b + 0x444)
        ant := 0
        n := 0
        mientras n < 20 hacer
            espera_us(10000)
            n := n + 1
        fin
        ap_activos := p[0]
        si ap_activos > AP_MAX entonces ap_activos := AP_MAX fin
        si ap_activos = 0 entonces
            ap_motivo := 6                      ; nadie ha contestado (un solo procesador)
            duerme_ap()
            devolver 0
        fin
        ap_motivo := 0
        imprimir2("termo: AP: el trampolín en %xh; han llegado %u procesadores más\n", b, ap_activos)
        devolver ap_activos
    fin

    ; =========================================================================
    ;  (TERMO) Las gráficas NVIDIA (Maxwell GM107/GM108/GM20x: GTX 970M/980M
    ;  del MSI GT80; Pascal GP10x: GTX 1050 del ASUS GL553V), como nouveau
    ;  (nvkm/subdev/therm, fuse) y envytools (ptherm.xml). Se recorren TODOS
    ;  los buses (0 a 255, todas las funciones: también detrás de los puertos
    ;  raíz y de los conmutadores PLX/PEX) y, de cada aparato 10DE de clase
    ;  03, se dice qué se ve (ID, subsistema, BAR0, estado de energía, el
    ;  enlace PCIe) y, si se puede, la temperatura:
    ;   - Maxwell (nvkm g84_temp_get, la de gm107/gm200): el fusible 1A8h
    ;     (BAR0+212A8h, la ventana del fuse de GM107 es 21100h) igual a 1 y
    ;     la temperatura en BAR0+20400h (°C). Si el sensor está apagado (20008h
    ;     bit 31 a 0) o forzado (bit 15), nouveau (g84_sensor_setup, al
    ;     arrancar en todas) hace 20008h <- (v y no 80008000h) o 80000000h y
    ;     2000Ch <- v y no 80000003h, y espera 20 ms: con c bit 1, se hace
    ;     igual, UNA vez (registros de la tarjeta: se pierde al apagar).
    ;   - Pascal (nvkm gp100_temp_get): BAR0+20460h, válida si el bit 29;
    ;     (v y 1FFF8h) >> 8 en °C. nouveau no escribe nada.
    ;   - Una lectura 0BADFxxxh (el «priv ring» de NVIDIA: el bloque sin reloj
    ;     o sin iniciar) no es una temperatura: se dice.
    ;  Lo único más que puede escribir (con c bit 1, todo volátil: se pierde
    ;  al apagar; como pci_enable_device de Linux): el bit «memoria» de la
    ;  orden PCI si el BAR0 está puesto dentro de la ventana del puente; y
    ;  D3hot -> D0 solo si la tarjeta dice No_Soft_Reset (no pierde su
    ;  configuración; espera 10 ms). Nunca relojes, voltajes ni ventiladores,
    ;  ni la VBIOS. En D3cold (Optimus: el puerto con el enlace caído) la
    ;  tarjeta ni contesta: no se la despierta (no se llama a _PS0/_ON).
    ;  La llamada 225: EBX el número de la gráfica (0, 1...), ECX dónde dejar
    ;  la ficha (32 octetos con EDX bit 0 a 0, los de siempre; 96 con EDX bit
    ;  0 a 1: Ficha_gpu de nvidia.h), EDX bit 1: se permiten las escrituras
    ;  volátiles de arriba -> 1, o 0 si no hay tantas. Con EBX = 100h + k:
    ;  el puerto PCI Express k (raíz o de bajada de un conmutador; 96
    ;  octetos, Ficha_puerto de nvidia.h) -> 1, o 0 si no hay tantos.
    ;  Estados: 0 bien; 1 apagada (D3); 2 sin la memoria activada; 3 BAR0
    ;  raro o sin asignar; 4 no es Maxwell ni Pascal; 5 sin fusible; 6 sensor
    ;  apagado; 7 sensor forzado; 8 lectura imposible; 9 dormida (el enlace
    ;  del puerto, caído: Optimus); 10 lectura 0BADFxxxh (el bloque, sin reloj)
    ; =========================================================================
    constante GPU_MAX = 4
    constante PUERTO_MAX = 16
    variable gpu_bdf: arreglo [4] de nat32
    variable gpu_pag0, gpu_pag20, gpu_pag21: arreglo [4] de nat32     ; las páginas del BAR0, vistas (0: sin ver)
    variable gpu_cuantas: nat32
    variable gpu_puerto: arreglo [4] de nat32     ; el puente del que cuelga (bus/aparato/función ob 80000000h; 0: ninguno)
    variable gpu_hecho: arreglo [4] de nat32      ; las escrituras volátiles hechas (bits de la ficha, palabra 15)
    variable gpu_orden0: arreglo [4] de nat32     ; la orden PCI como estaba al verla la primera vez
    variable gpu_buscado: bool
    variable puertos: arreglo [16] de nat32
    variable puertos_n: nat32

    función escribe_pci(d: nat32, v: nat32)
        variable b: nat32
        b := sin_interrupciones()
        escribe_puerto(0xCF8, 4, 0x80000000 ob (d yb 0x00FFFFFC))
        escribe_puerto(0xCFC, 4, v)
        reponer(b)
    fin

    ; la capacidad «cuál» (01 energía, 10h PCI Express) del aparato d (0: no la tiene)
    función capacidad(d: nat32, cuál: nat32): nat32
        variable cap, n, v: nat32
        si lee_pci(d ob 4) yb 0x00100000 = 0 entonces devolver 0 fin
        cap := lee_pci(d ob 0x34) yb 0xFC
        n := 0
        mientras cap >= 0x40 y n < 48 hacer
            v := lee_pci(d ob cap)
            si v yb 0xFF = cuál entonces devolver cap fin
            cap := (v >> 8) yb 0xFC
            n := n + 1
        fin
        devolver 0
    fin

    ; el puente (de cualquier bus) cuyo bus de detrás es «bus» (0 si no hay)
    función puerto_de(bus: nat32): nat32
        variable b, ap, f, d, v: nat32
        para b desde 0 hasta 255 hacer
            para ap desde 0 hasta 31 hacer
                para f desde 0 hasta 7 hacer
                    d := (b << 16) ob (ap << 11) ob (f << 8)
                    v := lee_pci(d) yb 0xFFFF
                    si v = 0xFFFF o v = 0 entonces
                        si f = 0 entonces romper fin
                    sino
                        si (lee_pci(d ob 0x0C) >> 16) yb 0x7F = 1 y (lee_pci(d ob 0x18) >> 8) yb 0xFF = bus entonces devolver d ob 0x80000000 fin
                        si f = 0 y (lee_pci(d ob 0x0C) >> 16) yb 0x80 = 0 entonces romper fin
                    fin
                fin
            fin
        fin
        devolver 0
    fin

    ; ¿está despierto el enlace del puerto? (su capacidad PCI Express, la 10h:
    ; Link Disable apagado y, si sabe decirlo, el enlace de datos activo)
    función enlace_vivo(p: nat32): bool
        variable d, cap: nat32
        si p = 0 entonces devolver cierto fin
        d := p yb 0x00FFFFFF
        cap := capacidad(d, 0x10)
        si cap = 0 entonces devolver cierto fin
        si lee_pci(d ob (cap + 0x10)) yb 0x10 <> 0 entonces devolver falso fin      ; Link Disable
        si lee_pci(d ob (cap + 0x0C)) yb 0x00100000 <> 0 y lee_pci(d ob (cap + 0x10)) yb 0x20000000 = 0 entonces devolver falso fin   ; DLL Link Active
        devolver cierto
    fin

    ; todos los buses y todas las funciones: las NVIDIA de clase 03 (03xxxx:
    ; la VGA, 0300h, y la «3D», 0302h, la segunda del SLI) y los puertos PCI
    ; Express (raíz, 4; de bajada de un conmutador, 6)
    función busca_gpu()
        variable bus, ap, f, d, v, c, cab, cap: nat32
        gpu_buscado := cierto
        gpu_cuantas := 0
        puertos_n := 0
        para bus desde 0 hasta 255 hacer
            para ap desde 0 hasta 31 hacer
                para f desde 0 hasta 7 hacer
                    d := (bus << 16) ob (ap << 11) ob (f << 8)
                    v := lee_pci(d)
                    si v yb 0xFFFF = 0xFFFF o v yb 0xFFFF = 0 entonces
                        si f = 0 entonces romper fin
                    sino
                        cab := (lee_pci(d ob 0x0C) >> 16) yb 0xFF
                        c := lee_pci(d ob 8)
                        si v yb 0xFFFF = 0x10DE y c >> 24 = 3 y gpu_cuantas < GPU_MAX entonces
                            gpu_bdf[gpu_cuantas] := d
                            si bus <> 0 entonces gpu_puerto[gpu_cuantas] := puerto_de(bus) sino gpu_puerto[gpu_cuantas] := 0 fin
                            gpu_orden0[gpu_cuantas] := lee_pci(d ob 4)
                            gpu_cuantas := gpu_cuantas + 1
                        fin
                        si cab yb 0x7F = 1 y puertos_n < PUERTO_MAX entonces
                            cap := capacidad(d, 0x10)
                            si cap <> 0 entonces
                                v := (lee_pci(d ob cap) >> 20) yb 0xF
                                si v = 4 o v = 6 entonces
                                    puertos[puertos_n] := d
                                    puertos_n := puertos_n + 1
                                fin
                            fin
                        fin
                        si f = 0 y cab yb 0x80 = 0 entonces romper fin
                    fin
                fin
            fin
        fin
    fin

    ; una palabra del BAR0 (de la lista), con sus páginas ya vistas
    función gpu_lee(i: nat32, des: nat32): nat32
        variable p: puntero a nat32
        si des < 0x1000 entonces
            p := puntero(gpu_pag0[i] + des)
        sino si des >= 0x21000 entonces
            p := puntero(gpu_pag21[i] + (des - 0x21000))
        sino
            p := puntero(gpu_pag20[i] + (des - 0x20000))
        fin
        devolver p[0]
    fin

    función gpu_escribe(i: nat32, des: nat32, v: nat32)
        variable p: puntero a nat32
        p := puntero(gpu_pag20[i] + (des - 0x20000))
        p[0] := v
    fin

    ; ¿es una lectura del «priv ring» que no ha contestado (0BADFxxxh)?
    función badf(v: nat32): bool
        devolver v yb 0xFFF00000 = 0xBAD00000
    fin

    ; el puerto k: Ficha_puerto (nvidia.h)
    función ficha_puerto(k: nat32, dest: nat32): nat32
        variable p: puntero a nat32
        variable d, cap, sec: nat32
        si k >= puertos_n entonces devolver 0 fin
        p := puntero(dest)
        d := puertos[k]
        p[0] := d
        p[1] := lee_pci(d)
        cap := capacidad(d, 0x10)
        p[2] := lee_pci(d ob cap)
        p[3] := lee_pci(d ob (cap + 0x0C))
        p[4] := lee_pci(d ob (cap + 0x10))
        p[5] := lee_pci(d ob (cap + 0x14))
        p[6] := lee_pci(d ob (cap + 0x18))
        p[7] := lee_pci(d ob 0x18)
        sec := (p[7] >> 8) yb 0xFF
        p[8] := 0xFFFFFFFF
        p[9] := 0
        si sec <> 0 entonces
            p[8] := lee_pci(sec << 16)
            si p[8] yb 0xFFFF <> 0xFFFF entonces p[9] := lee_pci((sec << 16) ob 8) fin
        fin
        p[10] := 0xFFFFFFFF
        si lee_pci(0) yb 0xFFFF = 0x8086 entonces p[10] := lee_pci(0x54) fin     ; DEVEN del 0:0.0 de Intel (qué puertos PEG ha dejado la BIOS)
        p[11] := lee_pci(d ob 4)
        p[12] := lee_pci(d ob 0x20)
        devolver 1
    fin

    función atender_gpu(i: nat32, dest: nat32, c: nat32): nat32
        variable p: puntero a nat32
        variable d, v, cap, bar, boot, chip, tam, pm, pu, ventana: nat32
        variable escribe: bool
        tam := 32
        si c yb 1 <> 0 entonces tam := 96 fin
        escribe := c yb 2 <> 0
        si no usuario_puede(actual.cr3, dest, tam, cierto) entonces devolver NO_VALE fin
        si no gpu_buscado entonces busca_gpu() fin
        si i >= 0x100 entonces
            si tam <> 96 entonces devolver NO_VALE fin
            llenar(puntero(dest), 96, 0)
            devolver ficha_puerto(i - 0x100, dest)
        fin
        si i >= gpu_cuantas entonces devolver 0 fin
        p := puntero(dest)
        llenar(puntero(dest), tam, 0)
        d := gpu_bdf[i]
        p[0] := d
        pu := gpu_puerto[i] yb 0x00FFFFFF
        si tam = 96 entonces
            p[9] := gpu_orden0[i]
            p[14] := gpu_puerto[i]
            p[15] := gpu_hecho[i]
            si gpu_puerto[i] <> 0 entonces
                cap := capacidad(pu, 0x10)
                si cap <> 0 entonces
                    p[20] := lee_pci(pu ob (cap + 0x10))
                    p[21] := lee_pci(pu ob (cap + 0x18))
                fin
            fin
        fin
        ; 1. (Optimus) el enlace del puerto, despierto; y la gráfica, contestando
        si no enlace_vivo(gpu_puerto[i]) entonces
            p[2] := 9
            devolver 1
        fin
        si lee_pci(d) yb 0xFFFF = 0xFFFF entonces
            p[2] := 9
            devolver 1
        fin
        p[1] := lee_pci(d)
        si tam = 96 entonces
            p[8] := lee_pci(d ob 0x2C)
            p[10] := lee_pci(d ob 0x10)
            p[19] := lee_pci(d ob 8)
            p[11] := 0xFFFFFFFF
            cap := capacidad(d, 1)
            si cap <> 0 entonces p[11] := lee_pci(d ob (cap + 4)) fin
            cap := capacidad(d, 0x10)
            si cap <> 0 entonces
                p[12] := lee_pci(d ob (cap + 0x0C))
                p[13] := lee_pci(d ob (cap + 0x10))
            fin
        fin
        ; 2. encendida (D0), por su capacidad de energía (la 01); de D3hot a
        ; D0 solo con No_Soft_Reset (bit 3: no pierde la configuración)
        cap := capacidad(d, 1)
        si cap <> 0 entonces
            pm := lee_pci(d ob (cap + 4))
            si pm yb 3 <> 0 entonces
                si escribe y pm yb 3 = 3 y pm yb 8 <> 0 y gpu_hecho[i] yb 2 = 0 entonces
                    escribe_pci(d ob (cap + 4), pm yb 0xFFFF7FFC)     ; (sin tocar PME_Status, bit 15: se borra escribiendo 1)
                    espera_us(10000)
                    gpu_hecho[i] := gpu_hecho[i] ob 2
                    imprimir2("termo: GPU %u: de D3 a D0 (No_Soft_Reset: sin perder la configuración; volátil)\n", i + 1, 0)
                fin
                si lee_pci(d ob (cap + 4)) yb 3 <> 0 entonces
                    si pm yb 8 = 0 entonces gpu_hecho[i] := gpu_hecho[i] ob 0x10 fin
                    si tam = 96 entonces p[15] := gpu_hecho[i] fin
                    p[2] := 1
                    devolver 1
                fin
            fin
        fin
        ; 3. BAR0: de memoria, 32 bits, sin «prefetch», alineado a 16 MB
        bar := lee_pci(d ob 0x10)
        si bar yb 0xF <> 0 o bar yb 0x00FFFFFF <> 0 o bar = 0 entonces
            p[2] := 3
            devolver 1
        fin
        ; 4. la memoria, activada; si no, como pci_enable_device: solo si el
        ; BAR0 cae en la ventana de memoria del puente y el puente la tiene
        si lee_pci(d ob 4) yb 2 = 0 entonces
            si escribe y gpu_hecho[i] yb 1 = 0 entonces
                si gpu_puerto[i] = 0 entonces
                    ventana := 1
                sino
                    v := lee_pci(pu ob 0x20)
                    ventana := 0
                    si lee_pci(pu ob 4) yb 2 <> 0 y bar >= (v yb 0xFFF0) << 16 y bar + 0xFFFFFF <= (v yb 0xFFF00000) ob 0xFFFFF entonces ventana := 1 fin
                    si ventana = 0 entonces gpu_hecho[i] := gpu_hecho[i] ob 0x20 fin
                fin
                si ventana = 1 entonces
                    escribe_pci(d ob 4, (lee_pci(d ob 4) yb 0xFFFF) ob 2)      ; (la mitad alta, el estado: se borra escribiendo 1; no se toca)
                    gpu_hecho[i] := gpu_hecho[i] ob 1
                    imprimir2("termo: GPU %u: la memoria activada (bit 1 de la orden PCI; volátil, como pci_enable_device)\n", i + 1, 0)
                fin
            fin
            si lee_pci(d ob 4) yb 2 = 0 entonces
                si tam = 96 entonces p[15] := gpu_hecho[i] fin
                p[2] := 2
                devolver 1
            fin
        fin
        si gpu_pag0[i] = 0 entonces
            gpu_pag0[i] := mapear_aparato(bar, 4096)
            gpu_pag20[i] := mapear_aparato(bar + 0x20000, 4096)
            gpu_pag21[i] := mapear_aparato(bar + 0x21000, 4096)
        fin
        si gpu_pag0[i] = 0 o gpu_pag20[i] = 0 o gpu_pag21[i] = 0 entonces
            p[2] := 3
            devolver 1
        fin
        ; 5. PMC_BOOT_0: Pascal (GP10x, 13xh), Maxwell (GM107/GM108, 117h y
        ; 118h; GM200/GM204/GM206, 120h, 124h, 126h)
        boot := gpu_lee(i, 0)
        p[3] := boot
        chip := (boot yb 0x1FF00000) >> 20
        si boot <> 0xFFFFFFFF y chip >= 0x130 y chip <= 0x13B entonces
            v := gpu_lee(i, 0x20460)
            p[4] := v
            si tam = 96 entonces p[18] := v fin
            si badf(v) entonces
                p[2] := 10
                devolver 1
            fin
            si v yb 0x20000000 = 0 entonces
                p[2] := 6
                devolver 1
            fin
            v := (v yb 0x1FFF8) >> 8
            p[5] := v
            si v > 130 entonces p[2] := 8 fin
            devolver 1
        fin
        si boot = 0xFFFFFFFF o (chip <> 0x124 y chip <> 0x117 y chip <> 0x118 y chip <> 0x120 y chip <> 0x126) entonces
            p[2] := 4
            devolver 1
        fin
        ; 6. el fusible del sensor calibrado (nvkm_fuse_read(1A8h), GM107: 21100h + 1A8h)
        v := gpu_lee(i, 0x212A8)
        si tam = 96 entonces p[16] := v fin
        si v <> 1 entonces
            p[2] := 5
            si badf(v) entonces p[2] := 10 fin
            devolver 1
        fin
        ; 7. el sensor: encendido (bit 31) y sin forzar (bit 15); si no, lo de
        ; nouveau (g84_sensor_setup), una vez y solo con permiso
        v := gpu_lee(i, 0x20008)
        si escribe y gpu_hecho[i] yb 4 = 0 y no badf(v) y (v yb 0x80000000 = 0 o v yb 0x8000 <> 0) entonces
            gpu_escribe(i, 0x20008, (v yb 0x7FFF7FFF) ob 0x80000000)
            gpu_escribe(i, 0x2000C, gpu_lee(i, 0x2000C) yb 0x7FFFFFFC)
            espera_us(20000)
            gpu_hecho[i] := gpu_hecho[i] ob 4
            imprimir2("termo: GPU %u: el sensor de temperatura encendido como nouveau (20008h era %xh; volátil)\n", i + 1, v)
            v := gpu_lee(i, 0x20008)
        fin
        p[4] := v
        si tam = 96 entonces
            p[15] := gpu_hecho[i]
            p[17] := gpu_lee(i, 0x2000C)
        fin
        si badf(v) entonces
            p[2] := 10
            devolver 1
        fin
        si v yb 0x80000000 = 0 entonces
            p[2] := 6
            devolver 1
        fin
        si v yb 0x8000 <> 0 entonces
            p[2] := 7
            devolver 1
        fin
        v := gpu_lee(i, 0x20400)
        si tam = 96 entonces p[18] := v fin
        si badf(v) entonces
            p[2] := 10
            devolver 1
        fin
        v := v yb 0xFF
        p[5] := v
        si v > 130 entonces p[2] := 8 fin
        p[6] := gpu_lee(i, 0x20408)
        p[7] := gpu_lee(i, 0x20074)
        devolver 1
    fin
    ; las llamadas 220 a 224 (usuario.cas)
    público función atender_termo(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable p: puntero a nat32
        variable k, n_t: nat32
        según n
            caso 220:
                si no msr_de_la_lista(a) entonces devolver NO_VALE fin
                si no usuario_puede(actual.cr3, b, 8, cierto) entonces devolver NO_VALE fin
                si fabricante() = 0 entonces devolver 0 fin
                cpuid(1)
                si r_cpu[3] yb 0x20 = 0 entonces devolver 0 fin    ; sin MSR
                ; (TERMO) EDX = 1: borrar las marcas de registro de un MSR de
                ; motivos de freno (escribir 0: sus marcas son R/WC0 y lo demás,
                ; de solo lectura); nada más se escribe
                si c = 1 entonces
                    si fabricante() <> 1 entonces devolver NO_VALE fin
                    según a
                        caso 0x19C, 0x1B1, 0x690, 0x6B0, 0x6B1, 0x64F:
                            si wrmsr_seguro(a, 0, 0) entonces devolver 1 fin
                            devolver 0
                    fin
                    devolver NO_VALE
                fin
                si no rdmsr_seguro(a) entonces devolver 0 fin
                p := puntero(b)
                p[0] := msr_lo
                p[1] := msr_hi
                devolver 1
            caso 221:
                si no pci_de_la_lista(a) entonces devolver NO_VALE fin
                devolver lee_pci(a)
            caso 222:
                si a <> 0x00059800 y a <> 0xD8200CA4 entonces devolver NO_VALE fin
                si fabricante() <> 2 entonces devolver NO_VALE fin
                si lee_pci(0) yb 0xFFFF <> 0x1022 entonces devolver NO_VALE fin
                devolver lee_smn(a)
            caso 223:
                si c = 1 entonces
                    si actual.id <> servicio_acpi() entonces devolver NO_VALE fin
                    si no usuario_puede(actual.cr3, a, TAM_BLOQUE, falso) entonces devolver NO_VALE fin
                    copiar_memoria(puntero(dirección(bloque)), puntero(a), TAM_BLOQUE)
                    hay_bloque := cierto
                    si visto <> 0 y tics - visto < 10 * HZ entonces devolver 1 fin
                    devolver 0
                fin
                si no usuario_puede(actual.cr3, a, TAM_BLOQUE, cierto) entonces devolver NO_VALE fin
                visto := tics
                si visto = 0 entonces visto := 1 fin
                late()                                  ; (TERMO) los otros procesadores siguen
                si no hay_bloque entonces devolver 0 fin
                copiar_memoria(puntero(a), puntero(dirección(bloque)), TAM_BLOQUE)
                devolver 1
            caso 225:
                devolver atender_gpu(a, b, c)           ; (TERMO) las gráficas NVIDIA (c: la ficha larga, las escrituras volátiles)
            caso 224:
                ; (TERMO) 2: los tics de la tarea ociosa; 3: los del reloj (la
                ; ocupación del procesador: lo que no ha corrido la ociosa)
                si a = 2 entonces devolver tics_de_la_ociosa() fin
                si a = 3 entonces devolver tics fin
                ; (TERMO) 4: lo de los otros procesadores (528 octetos: cuántos,
                ; el motivo si no, la página del trampolín, 0, y su tabla)
                si a = 4 entonces
                    si no usuario_puede(actual.cr3, b, 528, cierto) entonces devolver NO_VALE fin
                    p := puntero(b)
                    p[0] := ap_activos
                    p[1] := ap_motivo
                    p[2] := ap_base
                    si carga_fuerte entonces p[3] := 1 sino p[3] := 0 fin   ; (TERMO-FUERTE) la que se ha pedido
                    si ap_base <> 0 entonces
                        copiar_memoria(puntero(b + 16), puntero(ap_base + 0x800), 512)
                    sino
                        llenar(puntero(b + 16), 512, 0)
                    fin
                    devolver ap_activos
                fin
                ; (TERMO) 5: el registro del arranque (lo de ARRANQUE.TXT: el
                ; USB, los discos, las unidades), hasta c octetos en b -> los
                ; copiados. Para enseñarlo en pantalla si la memoria USB no
                ; aparece (y entonces no hay ARRANQUE.TXT que leer)
                si a = 5 entonces
                    k := registro_largo
                    si k > c entonces k := c fin
                    si k = 0 entonces devolver 0 fin
                    si no usuario_puede(actual.cr3, b, k, cierto) entonces devolver NO_VALE fin
                    copiar_memoria(puntero(b), puntero(dirección(registro)), k)
                    devolver k
                fin
                ; (TERMO) 6: los otros procesadores, otra vez (los que se han
                ; parado solos porque el latido no cambiaba: un parón largo del
                ; equipo, p. ej. el firmware con sus SMI, que no deja correr a
                ; nadie pero el TSC sigue contando): se duermen y se despiertan.
                ; Solo con la carga en marcha -> cuántos han llegado
                si a = 6 entonces
                    si carga <> 1 entonces devolver 0 fin
                    duerme_ap()
                    k := despierta_ap()
                    visto := tics
                    devolver k
                fin
                ; (TERMO) 7: en qué se va el procesador (para decir qué ha
                ; frenado al Termómetro): 32 octetos de la memoria USB (las
                ; órdenes, las que han tardado más de 500 ms, la que más (en
                ; tics), los reinicios, los fallos) y luego, de cada tarea viva
                ; (hasta c octetos), 24: su número, sus tics, su estado y su nombre
                si a = 7 entonces
                    si c < 32 o c > 32 + 24 * MAX_TAREAS entonces devolver NO_VALE fin
                    si no usuario_puede(actual.cr3, b, c, cierto) entonces devolver NO_VALE fin
                    p := puntero(b)
                    p[0] := Usbalm.órdenes
                    p[1] := Usbalm.lentas
                    p[2] := Usbalm.la_más_lenta
                    p[3] := Usbalm.reinicios
                    p[4] := Usbalm.fallos_de_disco
                    p[5] := tics
                    p[6] := tics_de_la_ociosa()
                    p[7] := 0
                    n_t := 0
                    para k desde 0 hasta MAX_TAREAS - 1 hacer
                        si tareas[k].estado <> Tareas.LIBRE y tareas[k].estado <> ACABADA y 32 + (n_t + 1) * 24 <= c entonces
                            p := puntero(b + 32 + n_t * 24)
                            p[0] := tareas[k].id
                            p[1] := tareas[k].tics_usados
                            p[2] := tareas[k].estado
                            llenar(puntero(b + 32 + n_t * 24 + 12), 12, 0)
                            si tareas[k].nombre <> nulo entonces copiar_hasta(puntero(b + 32 + n_t * 24 + 12), tareas[k].nombre, 12) fin
                            n_t := n_t + 1
                        fin
                    fin
                    devolver n_t
                fin
                ; (TERMO-FUERTE) 8: la coma flotante que ha encendido el núcleo
                ; (Tareas.sse: 1 FXSAVE, 2 SSE, 4 SSE2), con 100h (un núcleo
                ; de antes de la 0.8.12 da 0: sin carga en marcha, esto le
                ; llega como «¿sigue la carga?»)
                si a = 8 entonces devolver 0x100 ob Tareas.sse fin
                si a = 1 entonces
                    carga := b yb 1
                    ; (TERMO-FUERTE) ECX bit 1: la carga fuerte (SSE2) en los
                    ; demás procesadores; solo si el núcleo ha encendido el SSE2
                    carga_fuerte := b yb 2 <> 0 y Tareas.sse yb Tareas.SSE_SSE2 <> 0
                    si carga = 1 entonces
                        despierta_ap()                  ; (TERMO) los demás procesadores, a cargar también
                        visto := tics
                    sino
                        duerme_ap()
                    fin
                    devolver carga
                fin
                si carga = 1 y tics - visto < 6 * HZ entonces
                    late()
                    devolver 1
                fin
                si carga = 1 entonces imprimir2("termo: la carga se para: el Termómetro no pregunta (tics %u, la última vez %u)\n", tics, visto) fin
                carga := 0
                duerme_ap()
                devolver 0
        fin
        devolver NO_VALE
    fin

fin Termo.
