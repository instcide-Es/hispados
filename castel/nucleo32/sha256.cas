; =============================================================================
;  sha256.cas - el resumen SHA-256 (FIPS 180-4), en Castel, para los
;  programas del anillo 3 de Hispa-Pentium (PAQUETES lo usa para comprobar
;  cada archivo de un paquete antes de instalarlo). Un resumen a la vez:
;  empezar(), añadir() los trozos que se quiera (de cualquier tamaño) y
;  acabar(), que da las 64 cifras hexadecimales (en minúsculas) y un 0.
;  Cuenta hasta 4 GB por resumen (los archivos de la FAT no pasan de ahí).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Sha256

    variable k: arreglo [64] de nat32 = (
        0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
        0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
        0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
        0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
        0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
        0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
        0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
        0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2)

    variable h: arreglo [8] de nat32           ; el resumen, según va
    variable w: arreglo [64] de nat32
    variable bloque: arreglo [64] de byte      ; lo que aún no llena un bloque
    variable en_bloque: nat32
    variable total: nat32                      ; los octetos añadidos

    ; un bloque de 64 octetos (desde p) al resumen
    función comprime(p: puntero a byte)
        variable i, a, b, c, d, e, f, g, hh, x, s0, s1, t1, t2: nat32
        para i desde 0 hasta 15 hacer
            w[i] := (nat32(p[i * 4]) << 24) ob (nat32(p[i * 4 + 1]) << 16) ob (nat32(p[i * 4 + 2]) << 8) ob nat32(p[i * 4 + 3])
        fin
        para i desde 16 hasta 63 hacer
            x := w[i - 15]
            s0 := ((x >> 7) ob (x << 25)) xob ((x >> 18) ob (x << 14)) xob (x >> 3)
            x := w[i - 2]
            s1 := ((x >> 17) ob (x << 15)) xob ((x >> 19) ob (x << 13)) xob (x >> 10)
            w[i] := w[i - 16] + s0 + w[i - 7] + s1
        fin
        a := h[0]
        b := h[1]
        c := h[2]
        d := h[3]
        e := h[4]
        f := h[5]
        g := h[6]
        hh := h[7]
        para i desde 0 hasta 63 hacer
            s1 := ((e >> 6) ob (e << 26)) xob ((e >> 11) ob (e << 21)) xob ((e >> 25) ob (e << 7))
            t1 := hh + s1 + ((e yb f) xob ((nob e) yb g)) + k[i] + w[i]
            s0 := ((a >> 2) ob (a << 30)) xob ((a >> 13) ob (a << 19)) xob ((a >> 22) ob (a << 10))
            t2 := s0 + ((a yb b) xob (a yb c) xob (b yb c))
            hh := g
            g := f
            f := e
            e := d + t1
            d := c
            c := b
            b := a
            a := t1 + t2
        fin
        h[0] := h[0] + a
        h[1] := h[1] + b
        h[2] := h[2] + c
        h[3] := h[3] + d
        h[4] := h[4] + e
        h[5] := h[5] + f
        h[6] := h[6] + g
        h[7] := h[7] + hh
    fin

    público función empezar()
        h[0] := 0x6A09E667
        h[1] := 0xBB67AE85
        h[2] := 0x3C6EF372
        h[3] := 0xA54FF53A
        h[4] := 0x510E527F
        h[5] := 0x9B05688C
        h[6] := 0x1F83D9AB
        h[7] := 0x5BE0CD19
        en_bloque := 0
        total := 0
    fin

    ; n octetos más, desde p
    público función añadir(p: puntero a byte, n: nat32)
        variable i: nat32
        total := total + n
        i := 0
        ; (lo que quedaba a medias, primero)
        mientras en_bloque > 0 y i < n hacer
            bloque[en_bloque] := p[i]
            en_bloque := en_bloque + 1
            i := i + 1
            si en_bloque = 64 entonces
                comprime(bloque)
                en_bloque := 0
            fin
        fin
        ; los bloques enteros, sin copiarlos
        mientras n - i >= 64 hacer
            comprime(p + i)
            i := i + 64
        fin
        mientras i < n hacer
            bloque[en_bloque] := p[i]
            en_bloque := en_bloque + 1
            i := i + 1
        fin
    fin

    ; acaba el resumen: sus 64 cifras hexadecimales y un 0, a «salida» (65 octetos)
    público función acabar(salida: puntero a byte)
        variable i, j, v, bits_alto, bits_bajo: nat32
        variable cifras: puntero a byte
        cifras := "0123456789abcdef"
        bits_alto := total >> 29
        bits_bajo := total << 3
        bloque[en_bloque] := 0x80
        en_bloque := en_bloque + 1
        si en_bloque > 56 entonces
            mientras en_bloque < 64 hacer
                bloque[en_bloque] := 0
                en_bloque := en_bloque + 1
            fin
            comprime(bloque)
            en_bloque := 0
        fin
        mientras en_bloque < 56 hacer
            bloque[en_bloque] := 0
            en_bloque := en_bloque + 1
        fin
        bloque[56] := bits_alto >> 24
        bloque[57] := bits_alto >> 16
        bloque[58] := bits_alto >> 8
        bloque[59] := bits_alto
        bloque[60] := bits_bajo >> 24
        bloque[61] := bits_bajo >> 16
        bloque[62] := bits_bajo >> 8
        bloque[63] := bits_bajo
        comprime(bloque)
        en_bloque := 0
        para i desde 0 hasta 7 hacer
            v := h[i]
            para j desde 0 hasta 7 hacer
                salida[i * 8 + j] := cifras[(v >> (28 - j * 4)) yb 0xF]
            fin
        fin
        salida[64] := 0
    fin

fin Sha256.
