; =============================================================================
;  usbhid.cas - los teclados y los ratones USB del núcleo de Hispa-Pentium
;  (la clase HID, 03), también los paneles táctiles que se presentan como un
;  ratón (el de los MacBook).
;
;  El teclado, con el «protocolo de arranque»: cada informe son ocho octetos
;  (los modificadores —Mayús, Control, Alt...— y hasta seis teclas
;  pulsadas). Comparando cada informe con el anterior se sabe qué se ha
;  pulsado y qué se ha soltado, y eso se le da a consola.cas con los mismos
;  códigos que da un teclado PS/2: así el teclado español, los acentos,
;  Ctrl+C y todo lo demás son los mismos. La repetición de una tecla que se
;  deja pulsada (que en un teclado PS/2 la hace el propio teclado) se hace
;  aquí.
;
;  El ratón, con el protocolo de arranque si lo tiene (los botones y lo que
;  se ha movido, en los tres primeros octetos); si no, se lee su descriptor
;  de informe y se busca en él dónde van los botones y los ejes X e Y
;  (relativos), con su identificador de informe si lo lleva.
;
;  Una tarea del núcleo mira cada centésima de segundo si ha llegado algún
;  informe (las tuberías de interrupción de usb.cas). Los que se enchufan en
;  marcha llegan por nuevo() y los que se van, por se_va() (usbcal.cas): al
;  irse un teclado se sueltan las teclas que tenía pulsadas, y al irse un
;  ratón, sus botones.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Usbhid

    importar Usb, Usbbase, Consola, Raton, Tareas, Registro, Mem32, Hiddesc

    constante MAX_HID = 6
    ; (PANEL) lo que dice el Panel de control (Teclado: el retardo y la velocidad de repetición)
    público variable repite_tras: nat32 = 50    ; centésimas hasta que una tecla empieza a repetirse
    público variable repite_cada: nat32 = 4     ; y cada cuántas se repite

    tipo Hid = estructura
        usado: bool
        teclado: bool                           ; si no, es un ratón
        aparato: nat32
        tubo: nat32
        largo: nat32                            ; los octetos que se piden cada vez
        anterior: arreglo [8] de byte           ; (teclado) el informe de antes
        cambiada: bool                          ; (teclado de Apple europeo) dos teclas van cambiadas
        interfaz: nat32                         ; (0.8.10) su número (para las luces)
        luces: nat32                            ; (0.8.10) las puestas con SET_REPORT (FFh: aún ninguna)
        dis: Diseño                             ; (ratón) dónde va cada cosa en el informe (hiddesc.cas)
    fin

    público variable teclados, ratones: nat32   ; los que hay
    público variable informes: nat32            ; los que han llegado
    público variable fallos_tubo: nat32         ; las veces que una tubería ha dado un fallo
    variable último_ratón: arreglo [8] de byte  ; el último informe de un ratón, tal cual
    variable último_largo: nat32
    variable informes_dichos: nat32             ; (TERMO) los primeros informes, al registro
    variable luces_dichas: nat32                ; (0.8.10) los cambios de las luces, al registro (los 16 primeros)
    variable hids: arreglo [MAX_HID] de Hid
    variable n_hids: nat32                      ; los que hay (en «hids», donde haya sitio)
    variable en_marcha: bool                    ; la tarea que los atiende
    variable descriptor: arreglo [512] de byte  ; un descriptor de informe
    variable descriptor_largo: nat32
    ; lo que se sabe del último ratón sin protocolo de arranque (para enseñarlo)
    público variable ratón_por_descriptor: bool
    variable repite, repite_cuándo: nat32       ; la tecla que se repite (su código) y el tic en que toca

    ; el código de rastreo (el de un teclado PS/2) de cada tecla USB, por su
    ; «uso»; con el bit 7, lleva 0xE0 delante. 0: no se usa.
    variable de_uso: arreglo [105] de byte = "\0\0\0\0\x1E\x30\x2E\x20\x12\x21\x22\x23\x17\x24\x25\x26\x32\x31\x18\x19\x10\x13\x1F\x14\x16\x2F\x11\x2D\x15\x2C\x02\x03\x04\x05\x06\x07\x08\x09\x0A\x0B\x1C\x01\x0E\x0F\x39\x0C\x0D\x1A\x1B\x2B\x2B\x27\x28\x29\x33\x34\x35\x3A\x3B\x3C\x3D\x3E\x3F\x40\x41\x42\x43\x44\x57\x58\xB7\x46\0\xD2\xC7\xC9\xD3\xCF\xD1\xCD\xCB\xD0\xC8\x45\xB5\x37\x4A\x4E\x9C\x4F\x50\x51\x4B\x4C\x4D\x47\x48\x49\x52\x53\x56\xDD"
    ; los modificadores (un bit cada uno): Control, Mayús, Alt y el logo, los de la izquierda y los de la derecha
    variable de_modificador: arreglo [9] de byte = "\x1D\x2A\x38\xDB\x9D\x36\xB8\xDC"
    ; los teclados de Apple con la distribución europea (ISO): en ellos la
    ; tecla de la izquierda del 1 y la de al lado de Mayús dan los usos
    ; cambiados (los productos 05AC:xxxx de esta lista)
    variable apple_iso: arreglo [15] de byte = "\x24\x31\x37\x40\x43\x46\x4A\x4D\x53\x5A\x63\x73\x91\x1B"   ; (todos son 05AC:02xx)

    ; -------------------------------------------------------------------------
    ;  El teclado
    ; -------------------------------------------------------------------------
    ; manda a la consola el código de una tecla (con «suelta», al soltarla)
    función tecla(código: nat32, suelta: bool)
        si código = 0 entonces devolver fin
        si código yb 0x80 <> 0 entonces tecla_de_fuera(0xE0) fin
        si suelta entonces
            tecla_de_fuera((código yb 0x7F) ob 0x80)
        sino
            tecla_de_fuera(código yb 0x7F)
        fin
    fin

    función código_de(ref h: Hid, uso: nat32): nat32
        si h.cambiada entonces
            si uso = 0x35 entonces
                uso := 0x64
            sino si uso = 0x64 entonces
                uso := 0x35
            fin
        fin
        si uso > 0x65 entonces devolver 0 fin
        devolver de_uso[uso]
    fin

    función está(p: puntero a byte, uso: nat32): bool
        variable i: nat32
        para i desde 2 hasta 7 hacer
            si p[i] = uso entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; un informe de teclado: lo que ha cambiado desde el anterior
    función informe_teclado(ref h: Hid, p: puntero a byte)
        variable i, antes, ahora_: nat32
        si p[2] = 1 y p[3] = 1 entonces devolver fin       ; (demasiadas teclas a la vez: no dice cuáles)
        ; los modificadores
        antes := h.anterior[0]
        ahora_ := p[0]
        para i desde 0 hasta 7 hacer
            si (antes xob ahora_) yb (nat32(1) << i) <> 0 entonces
                tecla(de_modificador[i], ahora_ yb (nat32(1) << i) = 0)
            fin
        fin
        ; las teclas que se han soltado y las que se han pulsado
        para i desde 2 hasta 7 hacer
            si h.anterior[i] > 3 y no está(p, h.anterior[i]) entonces
                tecla(código_de(h, h.anterior[i]), cierto)
                si repite = código_de(h, h.anterior[i]) entonces repite := 0 fin
            fin
        fin
        para i desde 2 hasta 7 hacer
            si p[i] > 3 y no está(h.anterior, p[i]) entonces
                tecla(código_de(h, p[i]), falso)
                repite := código_de(h, p[i])
                repite_cuándo := tics + repite_tras
            fin
        fin
        para i desde 0 hasta 7 hacer h.anterior[i] := p[i] fin
    fin

    ; -------------------------------------------------------------------------
    ;  El ratón (dónde va cada cosa lo dice hiddesc.cas; I2CHID)
    ; -------------------------------------------------------------------------
    función informe_ratón(ref h: Hid, p: puntero a byte, n: nat32)
        variable b: nat32
        variable dx, dy, r: ent32
        si no lee_ratón(h.dis, p, n, dx, dy, b, r) entonces devolver fin
        ratón_de_fuera(dx, dy, b yb 7)
        si h.dis.rueda_bits <> 0 entonces
            si r <> 0 y r > -16 y r < 16 entonces ruedado(r) fin
        sino
            si h.dis.con_id entonces
                p := p + 1
                n := n - 1
            fin
            ; (NAVEGADOR) la rueda: con el protocolo de arranque (X e Y de 8 bits
            ; detrás de los botones), la mayoría la manda en el cuarto octeto
            si h.dis.x_bit = 8 y h.dis.y_bit = 16 y h.dis.eje_bits = 8 y n >= 4 entonces
                dx := campo(p, 24, 8)
                si dx <> 0 y dx > -16 y dx < 16 entonces ruedado(dx) fin
            fin
        fin
    fin

    ; busca en el descriptor de informe (ya leído) el informe del ratón (los
    ; ejes X e Y relativos), y dónde van en él los botones y los ejes. Falso
    ; si no lo hay.
    función mira_descriptor(ref h: Hid): bool
        devolver analiza(descriptor, descriptor_largo, h.dis)
    fin

    ; -------------------------------------------------------------------------
    ;  Buscar los que hay, y la tarea que los atiende
    ; -------------------------------------------------------------------------
    función es_apple_iso(producto: nat32): bool
        variable i: nat32
        si (producto >> 8) <> 2 entonces devolver falso fin
        para i desde 0 hasta 13 hacer
            si apple_iso[i] = (producto yb 0xFF) entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; esa interfaz (la k) del aparato a es un teclado o un ratón: se prepara
    función mira(a: nat32, k: nat32)
        variable i, e, interfaz, n: nat32
        variable r: ent32
        variable arranque: bool
        variable d: arreglo [4] de nat32
        ; un sitio libre
        n := 0
        mientras n < MAX_HID y hids[n].usado hacer n := n + 1 fin
        si n >= MAX_HID entonces devolver fin
        ; su extremo de interrupción de entrada
        e := NINGUNO
        para i desde 1 hasta aparatos[a].n_extremos hacer
            si aparatos[a].extremos[i - 1].interfaz = k y aparatos[a].extremos[i - 1].clase = 3 y aparatos[a].extremos[i - 1].número yb 0x80 <> 0 y e = NINGUNO entonces
                e := i - 1
            fin
        fin
        si e = NINGUNO entonces devolver fin
        interfaz := aparatos[a].interfaces[k].número
        llenar(puntero(nat32(dirección(hids[n]))), tamaño(Hid), 0)
        hids[n].aparato := a
        hids[n].teclado := aparatos[a].interfaces[k].protocolo = 1
        hids[n].largo := aparatos[a].extremos[e].paquete
        si hids[n].largo > 64 entonces hids[n].largo := 64 fin
        hids[n].cambiada := aparatos[a].fabricante = 0x05AC y es_apple_iso(aparatos[a].producto)
        ; el protocolo de arranque (si la interfaz dice tenerlo), y que no
        ; repita el informe si no cambia nada
        arranque := falso
        si aparatos[a].interfaces[k].subclase = 1 entonces
            r := control(a, 0x21, 0x0B, 0, interfaz, nulo, 0)
            arranque := r >= 0
        fin
        control(a, 0x21, 0x0A, 0, interfaz, nulo, 0)
        si hids[n].teclado entonces
            ; (se pide el paquete entero: hay teclados que mandan algún octeto
            ; más detrás de los ocho de siempre)
            si hids[n].largo < 8 entonces hids[n].largo := 8 fin
            teclados := teclados + 1
            ; (0.8.10) las luces, las del núcleo (Bloq Num apagado al
            ; arrancar): el firmware puede dejar Bloq Num encendido y los
            ; teclados sin teclado numérico aparte dan números en U I O...
            hids[n].interfaz := interfaz
            hids[n].luces := 0xFF
            pon_luces(hids[n])
            d[0] := a
            d[1] := hids[n].luces yb 1
            si d[1] = 0 entonces d[1] := nat32("apagado") sino d[1] := nat32("encendido") fin
            d[2] := nat32("bien")
            si hids[n].luces = 0xFF entonces d[2] := nat32("no lo acepta") fin
            apunta("usb: teclado (aparato %u): Bloq Num %s (SET_REPORT de las luces: %s)\n", d)
        sino
            ; un ratón de arranque: botones, X e Y, un octeto cada uno
            hids[n].dis.ratón := cierto
            hids[n].dis.n_botones := 3
            hids[n].dis.botones_bit := 0
            hids[n].dis.x_bit := 8
            hids[n].dis.y_bit := 16
            hids[n].dis.eje_bits := 8
            si no arranque entonces
                ; sin protocolo de arranque: lo que diga su descriptor de informe
                r := control(a, 0x81, PIDE_DESCRIPTOR, 0x2200, interfaz, descriptor, 512)
                descriptor_largo := 0
                si r > 0 entonces descriptor_largo := nat32(r) fin
                ratón_por_descriptor := cierto
                si no mira_descriptor(hids[n]) entonces devolver fin
            fin
            ratones := ratones + 1
            hay_ratón_usb := cierto
        fin
        hids[n].tubo := tubo_abre(a, e)
        si hids[n].tubo = NINGUNO entonces
            si hids[n].teclado entonces teclados := teclados - 1 sino ratones := ratones - 1 fin
            devolver
        fin
        tubo_pide(hids[n].tubo, hids[n].largo)
        hids[n].usado := cierto
        n_hids := n_hids + 1
    fin

    función guarda_último(p: puntero a byte, n: nat32)
        variable i: nat32
        ; (TERMO) los 8 primeros informes de los ratones, al registro del
        ; arranque (el Acer One 10: el panel del teclado mueve pero no hace
        ; clic: ¿dónde lleva el botón?)
        si informes_dichos < 8 entonces
            informes_dichos := informes_dichos + 1
            apunta1("usb: informe de un ratón (%u octetos):", n)
            i := 0
            mientras i < n y i < 16 hacer
                apunta1(" %02X", p[i])
                i := i + 1
            fin
            apunta0("\n")
        fin
        último_largo := n
        para i desde 0 hasta 7 hacer
            si i < n entonces último_ratón[i] := p[i] sino último_ratón[i] := 0 fin
        fin
    fin

    ; (0.8.10) las luces del teclado, como las tiene el núcleo (SET_REPORT
    ; del informe de salida 0); si no lo acepta, luces se queda en FFh
    función pon_luces(ref h: Hid)
        variable l: arreglo [4] de byte
        variable v: nat32
        v := luces_usb()
        l[0] := byte(v)
        si control(h.aparato, 0x21, 0x09, 0x0200, h.interfaz, l, 1) >= 0 entonces
            h.luces := v
        sino
            h.luces := 0xFF
        fin
    fin

    ; la tarea que recoge los informes: cada centésima mira las tuberías
    función atiende(nada: nat32)
        variable i: nat32
        variable r: ent32
        mientras cierto hacer
            para i desde 0 hasta MAX_HID - 1 hacer
                si hids[i].usado entonces
                    r := tubo_mira(hids[i].tubo, hids[i].largo)
                    si r <> T_ESPERA entonces
                        si r > 0 entonces
                            informes := informes + 1
                            si hids[i].teclado entonces
                                si r >= 8 entonces informe_teclado(hids[i], tubo_datos(hids[i].tubo)) fin
                            sino
                                guarda_último(tubo_datos(hids[i].tubo), nat32(r))
                                informe_ratón(hids[i], tubo_datos(hids[i].tubo), nat32(r))
                            fin
                        sino si r < 0 entonces
                            fallos_tubo := fallos_tubo + 1
                        fin
                        tubo_pide(hids[i].tubo, hids[i].largo)
                    fin
                fin
            fin
            ; (0.8.10) las luces, si han cambiado (Bloq Num, Bloq Mayús)
            para i desde 0 hasta MAX_HID - 1 hacer
                si hids[i].usado y hids[i].teclado y hids[i].luces <> 0xFF y hids[i].luces <> luces_usb() entonces
                    pon_luces(hids[i])
                    si luces_dichas < 16 entonces
                        luces_dichas := luces_dichas + 1
                        apunta2("usb: teclado (aparato %u): luces %02Xh (bit 0, Bloq Num; bit 1, Bloq Mayús)\n", hids[i].aparato, luces_usb())
                    fin
                fin
            fin
            ; la tecla que sigue pulsada se repite
            si repite <> 0 y tics >= repite_cuándo entonces
                tecla(repite, falso)
                repite_cuándo := tics + repite_cada
            fin
            dormir(1)
        fin
    fin

    ; busca los teclados y los ratones entre los aparatos que ha enumerado
    ; usb.cas, y pone en marcha la tarea que los atiende. Da cuántos hay.
    ; (TERMO) cada interfaz HID (clase 3) de cada aparato, al registro del
    ; arranque: su subclase, su protocolo y su descriptor de informe en
    ; hexadecimal (hasta 256 octetos), para ver dónde lleva un panel táctil
    ; el botón (el Acer One 10: Synaptics 06CB:2968, mueve pero no hace clic)
    función apunta_hid(a: nat32, k: nat32)
        variable r: ent32
        variable i, n: nat32
        variable d: arreglo [4] de nat32
        d[0] := a
        d[1] := aparatos[a].interfaces[k].número
        d[2] := aparatos[a].interfaces[k].subclase
        d[3] := aparatos[a].interfaces[k].protocolo
        apunta("usb: aparato %u, interfaz %u: HID, subclase %u, protocolo %u", d)
        r := control(a, 0x81, PIDE_DESCRIPTOR, 0x2200, aparatos[a].interfaces[k].número, descriptor, 512)
        si r <= 0 entonces
            apunta0("; su descriptor de informe, no lo da\n")
            devolver
        fin
        n := nat32(r)
        apunta1("; su descriptor de informe, %u octetos:", n)
        i := 0
        mientras i < n y i < 256 hacer
            si i mod 32 = 0 entonces apunta0("\n  ") fin
            apunta1("%02X ", descriptor[i])
            i := i + 1
        fin
        apunta0("\n")
    fin

    público función prepara(): nat32
        variable a, k: nat32
        para a desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[a].usado entonces
                para k desde 1 hasta aparatos[a].n_interfaces hacer
                    si aparatos[a].interfaces[k - 1].clase = 3 entonces apunta_hid(a, k - 1) fin
                    si aparatos[a].interfaces[k - 1].clase = 3 y (aparatos[a].interfaces[k - 1].protocolo = 1 o aparatos[a].interfaces[k - 1].protocolo = 2) entonces
                        mira(a, k - 1)
                    fin
                fin
            fin
        fin
        pon_en_marcha()
        devolver n_hids
    fin

    función pon_en_marcha()
        si n_hids = 0 o en_marcha entonces devolver fin
        si crear_tarea("usb", nat32(dirección(atiende)), 0) <> nulo entonces en_marcha := cierto fin
    fin

    ; el aparato a se acaba de enchufar: si es un teclado o un ratón (o
    ; varios), se prepara como los del arranque. Da cuántos.
    público función nuevo(a: nat32): nat32
        variable k, n: nat32
        n := n_hids
        para k desde 1 hasta aparatos[a].n_interfaces hacer
            si aparatos[a].interfaces[k - 1].clase = 3 y (aparatos[a].interfaces[k - 1].protocolo = 1 o aparatos[a].interfaces[k - 1].protocolo = 2) entonces
                mira(a, k - 1)
            fin
        fin
        pon_en_marcha()
        devolver n_hids - n
    fin

    ; el aparato a se ha desenchufado: sus teclados y ratones dejan de
    ; atenderse; lo que tuvieran pulsado se suelta (que no se quede una tecla
    ; ni un botón apretados para siempre)
    público función se_va(a: nat32)
        variable i, k, b: nat32
        para i desde 0 hasta MAX_HID - 1 hacer
            si hids[i].usado y hids[i].aparato = a entonces
                hids[i].usado := falso
                n_hids := n_hids - 1
                dormir(2)                       ; (por si la tarea estaba con él)
                si hids[i].teclado entonces
                    para b desde 0 hasta 7 hacer
                        si hids[i].anterior[0] yb (nat32(1) << b) <> 0 entonces tecla(de_modificador[b], cierto) fin
                    fin
                    para k desde 2 hasta 7 hacer
                        si hids[i].anterior[k] > 3 entonces tecla(código_de(hids[i], hids[i].anterior[k]), cierto) fin
                    fin
                    repite := 0
                    teclados := teclados - 1
                sino
                    ratón_de_fuera(0, 0, 0)
                    ratones := ratones - 1
                fin
            fin
        fin
    fin

    ; lo que da el descriptor de informe del último ratón sin protocolo de
    ; arranque (un panel táctil): sus octetos, para apuntarlos
    público función enseña_descriptor()
        variable i: nat32
        si no ratón_por_descriptor entonces devolver fin
        apunta1("usb: un ratón (o un panel) sin protocolo de arranque; su descriptor de informe, %u octetos:", descriptor_largo)
        i := 0
        mientras i < descriptor_largo y i < 160 hacer
            si i mod 24 = 0 entonces apunta0("\n  ") fin
            apunta1("%02X ", descriptor[i])
            i := i + 1
        fin
        apunta0("\n")
    fin

    ; cómo van los teclados y los ratones: cuántos informes han llegado,
    ; cuántos fallos han dado las tuberías, y el último informe de un ratón
    público función enseña_estado()
        variable i: nat32
        variable d: arreglo [4] de nat32
        d[0] := tics div 100
        d[1] := informes
        d[2] := fallos_tubo
        apunta("usb: a los %u s: %u informes de teclados y ratones, %u fallos de sus tuberías", d)
        si último_largo <> 0 entonces
            apunta1("; el último de un ratón, %u octetos:", último_largo)
            i := 0
            mientras i < último_largo y i < 8 hacer
                apunta1(" %02X", último_ratón[i])
                i := i + 1
            fin
        fin
        apunta0("\n")
    fin

    ; (dispositivos) ¿atiende este módulo el aparato USB a? 1: como teclado;
    ; 2: como ratón; 3: las dos cosas; 0: no
    público función lleva(a: nat32): nat32
        variable i, r: nat32
        r := 0
        para i desde 0 hasta MAX_HID - 1 hacer
            si hids[i].usado y hids[i].aparato = a entonces
                si hids[i].teclado entonces r := r ob 1 sino r := r ob 2 fin
            fin
        fin
        devolver r
    fin

fin Usbhid.
