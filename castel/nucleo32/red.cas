; =============================================================================
;  red.cas - lo que el núcleo de Hispa-Pentium pone para la red. La red de
;  verdad (los controladores de las tarjetas y la pila TCP/IP) es un programa
;  del anillo 3, el SERVICIO DE RED (RED.BIN, ured.cas); el núcleo solo hace
;  de cartero entre él y los programas que usan la red, y le da lo que un
;  programa normal no tiene: los puertos de E/S, memoria física seguida para
;  que la tarjeta lea y escriba (DMA) y los registros de la tarjeta a la vista.
;
;  Un programa pide algo a la red (llamada 90) con una cabecera de ocho
;  palabras (la orden y sus datos; la octava, cuántos octetos van detrás) y,
;  si hace falta, unos octetos (hasta MAX_DATOS): el núcleo los copia, se los
;  pasa al servicio y deja al programa esperando hasta que el servicio
;  conteste (otra cabecera y otros octetos, que el núcleo le copia a él). Con
;  Ctrl+C el programa deja de esperar: lo que conteste luego el servicio se
;  tira (cada pedido lleva su número de serie). Cuando acaba un programa que
;  ha usado la red, se le avisa al servicio (para que cierre lo suyo).
;
;  Las llamadas (de la 90 a la 98: la 110 y las siguientes son de otra cosa):
;    90  pedir a la red: EBX, la cabecera (8 palabras: se lee y se escribe
;        la respuesta encima); ECX, los octetos (los que salen y donde se
;        dejan los que vuelven); EDX, cuántos caben allí  -> la primera
;        palabra de la respuesta (SIN_RED: no hay servicio)
;    91  (el servicio) apuntarse como servicio de red: le da los puertos
;        (IOPL 3). Solo un programa a la vez, y solo RED.BIN
;    92  (el servicio) el pedido siguiente, a EBX (Pedido_red y los
;        octetos detrás: caben 64 + MAX_DATOS); con ECX tics de espera si no
;        hay ninguno                                   -> 1, o 0 si no hay
;    93  (el servicio) contestar: EBX, el hueco; ECX, la Respuesta_red
;    94  (el servicio) EBX páginas seguidas de memoria física (hasta 16), a
;        su vista; a ECX, su dirección física          -> dónde se ven
;    95  (el servicio) los registros de un aparato a su vista: EBX, la
;        dirección física; ECX, cuántos octetos        -> dónde se ven
;    96  (el servicio) cómo está la red (EBX: RED_...), su IP (ECX) y el
;        aparato PCI que hace DMA (EDX; 0xFFFFFFFF: ninguno), para el icono
;        del escritorio y para pararlo si el servicio se acaba
;    97  cómo está la red: a EBX (si no es 0), la IP   -> RED_...
;    98  (el servicio) la línea de interrupción de su tarjeta (EBX, de 1 a
;        15; 0: ninguna): cuando llega, se tapa y el servicio se despierta;
;        se destapa en su próxima llamada 92
;    99  (TLS) pedir al SERVICIO TLS (TLS.BIN, nucleo32/tls/): como la 90,
;        pero el pedido va a TLS.BIN, que hace las conexiones cifradas (y
;        pide a RED.BIN, por la 90, las TCP que lleva debajo). TLS.BIN se
;        apunta con la 91 (sin puertos), coge sus pedidos con la 92 y los
;        contesta con la 93, igual que RED.BIN: cada hueco sabe a cuál de
;        los dos va                                   -> (SIN_TLS: no hay)
;
;   100  (WIFI) pedir al SERVICIO WI-FI (WIFI.BIN, nucleo32/wifi/): como la
;        90, pero el pedido va a WIFI.BIN (la ventana del Wi-Fi: buscar,
;        conectar...). WIFI.BIN se apunta con la 91 y, como RED.BIN, tiene
;        los puertos, su memoria de DMA (la 94, hasta 1024 páginas) y los
;        registros de su tarjeta (la 95); con la 96 dice cómo está (para el
;        icono: el estado y las barras de la señal) y su tarjeta. Las tramas
;        se las pasa a RED.BIN por la 90, como un programa más (rwifi.cas)
;                                                     -> (SIN_WIFI: no hay)
;
;  Si el servicio se acaba (o lo acaban), el núcleo apaga el DMA de su
;  tarjeta antes de devolver su memoria, quita los registros de su vista y
;  contesta SIN_RED a los que esperaban.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Red

    importar Tareas, Paginas, Marcos, Monton, Mem32, Cpu, Pci, Textos32

    ; ---- lo que dice la llamada 97 (y pone el servicio con la 96) ----
    público constante RED_NADA = 0              ; no hay servicio de red
    público constante RED_SIN_TARJETA = 1       ; no hay ninguna tarjeta que se sepa llevar
    público constante RED_SIN_CABLE = 2         ; la tarjeta no tiene enlace
    público constante RED_BUSCANDO = 3          ; con enlace, pidiendo la IP (DHCP)
    público constante RED_CONECTADA = 4         ; con IP

    público constante SIN_RED = 0xFFFFFFEF      ; no hay servicio de red
    público constante SIN_TLS = 0xFFFFFFE3      ; (TLS) no hay servicio TLS (TLS.BIN)
    público constante SIN_WIFI = 0xFFFFFFE1     ; (WIFI) no hay servicio Wi-Fi (WIFI.BIN)
    ; (WIFI) lo que dice WIFI.BIN con la 96 (para el icono de la bandeja)
    público constante WIFI_NADA = 0             ; no hay servicio Wi-Fi
    público constante WIFI_SIN_TARJETA = 1      ; no hay tarjeta, o no se ha podido encender
    público constante WIFI_SIN_CONECTAR = 2
    público constante WIFI_CONECTANDO = 3
    público constante WIFI_CONECTADA = 4
    ; (WIFI) lo que prefiere RED.BIN (RED.INI, «Preferir=»): Automático, Cable o Wi-Fi
    público constante PREFIERE_AUTO = 0
    público constante PREFIERE_CABLE = 1
    público constante PREFIERE_WIFI = 2
    constante NO_VALE = 0xFFFFFFF9
    constante EN_USO = 0xFFFFFFF6
    constante SIN_MEMORIA = 0xFFFFFFFA

    público constante MAX_DATOS = 8192          ; lo más que va en un pedido o en una respuesta
    constante MAX_HUECOS = 16
    constante H_LIBRE = 0
    constante H_PEDIDO = 1                      ; esperando a que el servicio lo coja
    constante H_EN_SERVICIO = 2                 ; lo tiene el servicio
    constante H_RESPONDIDO = 3
    constante AVISO_ACABÓ = 0xFFFF              ; (la orden de un aviso: ha acabado la tarea tal)
    constante AVISO_PREFERIR = 0xFFFE           ; (WIFI) el escritorio (Configuración) pide Cable, Wi-Fi o Automático: cab[1]
    constante ZONA_INICIO = 0xA0000000          ; donde ve el servicio la memoria de DMA y los registros
    constante ZONA_FINAL = 0xB0000000
    constante MAX_TROZOS = 8

    ; (TLS) a qué servicio va un pedido
    constante A_RED = 0
    constante A_TLS = 1
    constante A_WIFI = 2                        ; (WIFI)
    constante A_NADIE = 3

    tipo Hueco = estructura
        estado: nat32
        destino: nat32                          ; (TLS) A_RED o A_TLS
        tarea: puntero a Tarea
        id, serie, cabe, largo: nat32
        cab: arreglo [8] de nat32
        datos: puntero a byte                   ; (del montón: MAX_DATOS)
    fin

    ; lo que recibe el servicio (la llamada 92); detrás, los octetos
    tipo Pedido_red = estructura
        hueco, serie, tarea, cabe, largo: nat32
        relleno: arreglo [3] de nat32
        cab: arreglo [8] de nat32
    fin
    ; lo que da el servicio al contestar (la llamada 93)
    tipo Respuesta_red = estructura
        serie: nat32
        datos: nat32                            ; dónde están los octetos (cab[7] de ellos)
        cab: arreglo [8] de nat32
    fin

    variable huecos: arreglo [MAX_HUECOS] de Hueco
    variable serie: nat32
    ; (TLS) lo de los servicios: [0, MAX_TAREAS) el de red; detrás, el TLS; (WIFI) y el Wi-Fi
    variable usaron: arreglo [3 * MAX_TAREAS] de nat32  ; las tareas que han usado la red
    variable avisos: arreglo [3 * MAX_TAREAS] de nat32  ; las que han acabado, para decírselo al servicio
    variable n_avisos: arreglo [3] de nat32

    público variable servicio: puntero a Tarea          ; nulo: no hay
    variable servicio_id: nat32
    variable servicio_espera: bool
    ; (TLS) el servicio TLS (TLS.BIN)
    público variable servicio_tls: puntero a Tarea
    variable servicio_tls_id: nat32
    variable tls_espera: bool
    público variable sin_tls: bool                       ; no está TLS.BIN: no se vuelve a intentar
    ; (WIFI) el servicio Wi-Fi (WIFI.BIN)
    público variable servicio_wifi: puntero a Tarea
    variable servicio_wifi_id: nat32
    variable wifi_espera: bool
    público variable estado_wifi: nat32                  ; WIFI_... (lo que dijo WIFI.BIN con la 96)
    público variable barras_wifi: nat32                  ; la señal, de 0 a 4 rayitas
    público variable señal_wifi: ent32                   ; en dBm
    variable aparato_wifi: nat32
    público variable por_wifi: bool                      ; RED.BIN va por el Wi-Fi (bit 9 de su 96)
    público variable preferir_red: nat32                 ; PREFIERE_... (bits 12 y 13 de la 96 de RED.BIN)
    variable preferencia_pedida: nat32 = 0xFFFFFFFF      ; la que ha pedido el escritorio, para RED.BIN
    público variable estado_red: nat32
    público variable ip_red: nat32                       ; (como va en la red: el primer octeto, abajo)
    público variable cambios_red: nat32                  ; sube cuando cambia (el escritorio repinta el icono)
    público variable apagada: bool                       ; «sinred» en la línea del cargador
    público variable sin_tarjeta: bool                   ; el servicio ya dijo que no hay tarjeta: no se vuelve a lanzar
    variable aparato: nat32
    ; (WIFI) lo de la vista de cada servicio: [0] RED.BIN, [1] WIFI.BIN
    variable zona: arreglo [2] de nat32
    variable trozo_v, trozo_n: arreglo [2 * MAX_TROZOS] de nat32   ; los registros puestos a la vista (para quitarlos)
    variable n_trozos: arreglo [2] de nat32
    variable irq_red: nat32
    público variable irqs_red: nat32

    ; ---- ayudantes ----
    público función hay_servicio(): bool
        devolver servicio <> nulo y servicio.id = servicio_id y servicio.estado <> ACABADA y servicio.estado <> LIBRE
    fin

    función es_servicio(): bool
        devolver hay_servicio() y servicio = actual
    fin

    ; (TLS)
    público función hay_tls(): bool
        devolver servicio_tls <> nulo y servicio_tls.id = servicio_tls_id y servicio_tls.estado <> ACABADA y servicio_tls.estado <> LIBRE
    fin

    función es_tls(): bool
        devolver hay_tls() y servicio_tls = actual
    fin

    ; (TLS) ¿de cuál de los dos servicios es la tarea actual?
    ; (WIFI)
    público función hay_wifi(): bool
        devolver servicio_wifi <> nulo y servicio_wifi.id = servicio_wifi_id y servicio_wifi.estado <> ACABADA y servicio_wifi.estado <> LIBRE
    fin

    función es_wifi(): bool
        devolver hay_wifi() y servicio_wifi = actual
    fin

    función destino_actual(): nat32
        si es_servicio() entonces devolver A_RED fin
        si es_tls() entonces devolver A_TLS fin
        si es_wifi() entonces devolver A_WIFI fin
        devolver A_NADIE
    fin

    función hay_destino(d: nat32): bool
        si d = A_TLS entonces devolver hay_tls() fin
        si d = A_WIFI entonces devolver hay_wifi() fin
        devolver hay_servicio()
    fin

    ; ¿puede el programa leer (o escribir) ahí? (si cae en su pila, sin
    ; estrenar, antes se le ponen esas páginas; como en usuario.cas)
    función puede(inicio: nat32, n: nat32, para_escribir: bool): bool
        variable p: nat32
        si n > 0 y inicio >= PILA_INICIO y inicio < PILA_FINAL y inicio + n > inicio y inicio + n <= PILA_FINAL entonces
            p := inicio yb 0xFFFFF000
            mientras p < inicio + n hacer
                si banderas_de(actual.cr3, p) = 0 y no atender_pila(actual.cr3, p, actual.esp_usuario) entonces devolver falso fin
                p := p + PÁGINA
            fin
        fin
        devolver usuario_puede(actual.cr3, inicio, n, para_escribir)
    fin

    función despierta_servicio()
        si servicio_espera y hay_servicio() entonces despertar_dormida(servicio) fin
    fin

    función despierta(d: nat32)
        si d = A_TLS entonces
            si tls_espera y hay_tls() entonces despertar_dormida(servicio_tls) fin
        sino si d = A_WIFI entonces
            si wifi_espera y hay_wifi() entonces despertar_dormida(servicio_wifi) fin
        sino
            despierta_servicio()
        fin
    fin

    función apunta_uso(id: nat32, d: nat32)
        variable i, libre, b: nat32
        b := d * MAX_TAREAS
        libre := MAX_TAREAS
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            si usaron[b + i] = id entonces devolver fin
            si usaron[b + i] = 0 y libre = MAX_TAREAS entonces libre := i fin
        fin
        si libre < MAX_TAREAS entonces usaron[b + libre] := id fin
    fin

    ; -------------------------------------------------------------------------
    ;  Pedir (los programas) y contestar (el servicio)
    ; -------------------------------------------------------------------------
    función pedir(a: nat32, b: nat32, c: nat32, d: nat32): nat32
        variable cab: puntero a nat32
        variable h: puntero a Hueco
        variable i, largo, bi, r, sin: nat32
        sin := SIN_RED
        si d = A_TLS entonces sin := SIN_TLS fin
        si d = A_WIFI entonces sin := SIN_WIFI fin
        si no hay_destino(d) entonces devolver sin fin
        ; (el de red no pide a nadie; el TLS y el Wi-Fi, solo al de red)
        si es_servicio() o (d = A_TLS y es_tls()) o (d = A_WIFI y es_wifi()) entonces devolver NO_VALE fin
        si no puede(a, 32, cierto) entonces devolver NO_VALE fin
        cab := puntero(a)
        largo := cab[7]
        si largo > MAX_DATOS o c > 0x10000000 entonces devolver NO_VALE fin
        si largo > 0 y no puede(b, largo, falso) entonces devolver NO_VALE fin
        si c > 0 y no puede(b, c, cierto) entonces devolver NO_VALE fin
        h := nulo
        para i desde 0 hasta MAX_HUECOS - 1 hacer
            si h = nulo y huecos[i].estado = H_LIBRE entonces h := dirección(huecos[i]) fin
        fin
        si h = nulo entonces devolver SIN_MEMORIA fin
        si h.datos = nulo entonces
            h.datos := reservar(MAX_DATOS)
            si h.datos = nulo entonces devolver SIN_MEMORIA fin
        fin
        para i desde 0 hasta 7 hacer h.cab[i] := cab[i] fin
        si largo > 0 entonces copiar_memoria(h.datos, puntero(b), largo) fin
        h.largo := largo
        h.cabe := c
        si h.cabe > MAX_DATOS entonces h.cabe := MAX_DATOS fin
        h.tarea := actual
        h.id := actual.id
        h.destino := d
        apunta_uso(actual.id, d)
        bi := sin_interrupciones()
        serie := serie + 1
        h.serie := serie
        h.estado := H_PEDIDO
        despierta(d)
        mientras h.estado <> H_RESPONDIDO hacer
            si actual.matar o no hay_destino(d) entonces
                ; (con Ctrl+C: lo que conteste el servicio se tirará, por la serie)
                h.estado := H_LIBRE
                reponer(bi)
                devolver sin
            fin
            bloquear()
        fin
        reponer(bi)
        para i desde 0 hasta 7 hacer cab[i] := h.cab[i] fin
        largo := h.cab[7]
        si largo > h.cabe entonces largo := h.cabe fin
        cab[7] := largo
        si largo > 0 entonces copiar_memoria(puntero(b), h.datos, largo) fin
        r := h.cab[0]
        h.estado := H_LIBRE
        devolver r
    fin

    ; el servicio coge el pedido siguiente (o un aviso)
    función siguiente(a: nat32, espera: nat32): nat32
        variable p: puntero a Pedido_red
        variable h: puntero a Hueco
        variable i, bi, vueltas, d: nat32
        d := destino_actual()
        si d = A_NADIE entonces devolver NO_VALE fin
        si no puede(a, tamaño(Pedido_red) + MAX_DATOS, cierto) entonces devolver NO_VALE fin
        p := puntero(a)
        ; la interrupción de la tarjeta, otra vez destapada
        si d = A_RED y irq_red <> 0 entonces destapa_irq(irq_red) fin
        vueltas := 0
        mientras vueltas < 2 hacer
            bi := sin_interrupciones()
            si d = A_RED y preferencia_pedida <> 0xFFFFFFFF entonces
                ; (WIFI) lo que ha elegido el escritorio: Cable, Wi-Fi o Automático
                p.hueco := 0xFFFFFFFF
                p.serie := 0
                p.tarea := 0
                p.cabe := 0
                p.largo := 0
                para i desde 0 hasta 7 hacer p.cab[i] := 0 fin
                p.cab[0] := AVISO_PREFERIR
                p.cab[1] := preferencia_pedida
                preferencia_pedida := 0xFFFFFFFF
                reponer(bi)
                devolver 1
            fin
            si n_avisos[d] > 0 entonces
                n_avisos[d] := n_avisos[d] - 1
                p.hueco := 0xFFFFFFFF
                p.serie := 0
                p.tarea := avisos[d * MAX_TAREAS + n_avisos[d]]
                p.cabe := 0
                p.largo := 0
                para i desde 0 hasta 7 hacer p.cab[i] := 0 fin
                p.cab[0] := AVISO_ACABÓ
                reponer(bi)
                devolver 1
            fin
            para i desde 0 hasta MAX_HUECOS - 1 hacer
                h := dirección(huecos[i])
                si h.estado = H_PEDIDO y h.destino = d entonces
                    h.estado := H_EN_SERVICIO
                    reponer(bi)
                    p.hueco := i
                    p.serie := h.serie
                    p.tarea := h.id
                    p.cabe := h.cabe
                    p.largo := h.largo
                    para i desde 0 hasta 7 hacer p.cab[i] := h.cab[i] fin
                    si h.largo > 0 entonces copiar_memoria(puntero(a + tamaño(Pedido_red)), h.datos, h.largo) fin
                    devolver 1
                fin
            fin
            si espera = 0 o vueltas = 1 entonces
                reponer(bi)
                devolver 0
            fin
            si d = A_TLS entonces tls_espera := cierto sino si d = A_WIFI entonces wifi_espera := cierto sino servicio_espera := cierto fin
            dormir(espera)
            si d = A_TLS entonces tls_espera := falso sino si d = A_WIFI entonces wifi_espera := falso sino servicio_espera := falso fin
            reponer(bi)
            vueltas := vueltas + 1
        fin
        devolver 0
    fin

    función contestar(hu: nat32, a: nat32): nat32
        variable r: puntero a Respuesta_red
        variable h: puntero a Hueco
        variable i, largo, bi, d: nat32
        d := destino_actual()
        si d = A_NADIE o hu >= MAX_HUECOS entonces devolver NO_VALE fin
        si no puede(a, tamaño(Respuesta_red), falso) entonces devolver NO_VALE fin
        r := puntero(a)
        h := dirección(huecos[hu])
        ; (si el programa se ha ido, el hueco ya es de otro, o de nadie)
        si h.estado <> H_EN_SERVICIO o h.serie <> r.serie o h.destino <> d entonces devolver NO_VALE fin
        largo := r.cab[7]
        si largo > h.cabe entonces largo := h.cabe fin
        si largo > 0 y no puede(r.datos, largo, falso) entonces devolver NO_VALE fin
        si largo > 0 entonces copiar_memoria(h.datos, puntero(r.datos), largo) fin
        para i desde 0 hasta 7 hacer h.cab[i] := r.cab[i] fin
        h.cab[7] := largo
        bi := sin_interrupciones()
        h.estado := H_RESPONDIDO
        despertar_tarea(h.tarea)
        reponer(bi)
        devolver 0
    fin

    ; -------------------------------------------------------------------------
    ;  Lo que solo puede el servicio
    ; -------------------------------------------------------------------------
    ; (TLS) TLS.BIN se apunta como servicio TLS: sin puertos ni memoria de DMA
    función apuntarse_tls(): nat32
        si hay_tls() entonces
            si servicio_tls = actual entonces devolver 0 fin
            devolver EN_USO
        fin
        si es_servicio() entonces devolver NO_VALE fin
        servicio_tls := actual
        servicio_tls_id := actual.id
        sin_tls := falso
        devolver 0
    fin

    ; (WIFI) WIFI.BIN se apunta como servicio Wi-Fi: con los puertos, como RED.BIN
    función apuntarse_wifi(): nat32
        variable p: puntero a nat32
        si hay_wifi() entonces
            si servicio_wifi = actual entonces devolver 0 fin
            devolver EN_USO
        fin
        si es_servicio() o es_tls() entonces devolver NO_VALE fin
        servicio_wifi := actual
        servicio_wifi_id := actual.id
        zona[1] := ZONA_INICIO
        n_trozos[1] := 0
        aparato_wifi := 0xFFFFFFFF
        estado_wifi := WIFI_SIN_TARJETA
        barras_wifi := 0
        cambios_red := cambios_red + 1
        p := puntero(actual.pila_tope - 12)
        valor(p) := valor(p) ob 0x3000
        devolver 0
    fin

    ; (WIFI) 0: lo de RED.BIN; 1: lo de WIFI.BIN
    función de_quién(): nat32
        si es_wifi() entonces devolver 1 fin
        devolver 0
    fin

    función apuntarse(): nat32
        variable p: puntero a nat32
        si iguales_sin_caja(actual.nombre, "TLS.BIN") entonces devolver apuntarse_tls() fin
        si iguales_sin_caja(actual.nombre, "WIFI.BIN") entonces devolver apuntarse_wifi() fin       ; (WIFI)
        si es_tls() o es_wifi() entonces devolver NO_VALE fin
        si hay_servicio() entonces
            si servicio = actual entonces devolver 0 fin
            devolver EN_USO
        fin
        si no iguales_sin_caja(actual.nombre, "RED.BIN") entonces devolver NO_VALE fin
        servicio := actual
        servicio_id := actual.id
        zona[0] := ZONA_INICIO
        n_trozos[0] := 0
        aparato := 0xFFFFFFFF
        irq_red := 0
        estado_red := RED_SIN_TARJETA
        cambios_red := cambios_red + 1
        sin_tarjeta := falso
        ; los puertos: IOPL 3 en las banderas que repondrá «iretd" al volver
        ; al anillo 3 (lo apilado por el procesador, arriba de su pila del núcleo)
        p := puntero(actual.pila_tope - 12)
        valor(p) := valor(p) ob 0x3000
        devolver 0
    fin

    función memoria_dma(n: nat32, física: nat32): nat32
        variable m, i, v, z: nat32
        variable f: puntero a nat32
        z := de_quién()
        si n = 0 o (n > 16 y z = 0) o n > 1024 entonces devolver NO_VALE fin     ; (WIFI: el montón de brcmsmac, hasta 4 MB)
        si zona[z] + n * PÁGINA > ZONA_FINAL entonces devolver SIN_MEMORIA fin
        si no puede(física, 4, cierto) entonces devolver NO_VALE fin
        m := reservar_seguidos(n)
        si m = 0 entonces devolver SIN_MEMORIA fin
        para i desde 0 hasta n - 1 hacer
            si no mapear(actual.cr3, zona[z] + i * PÁGINA, m + i * PÁGINA, ESCRIBIR ob USUARIO) entonces
                ; (lo puesto se devolverá con su espacio de direcciones; lo que no, aquí)
                mientras i < n hacer
                    soltar_marco(m + i * PÁGINA)
                    i := i + 1
                fin
                devolver SIN_MEMORIA
            fin
        fin
        v := zona[z]
        zona[z] := zona[z] + n * PÁGINA
        f := puntero(física)
        valor(f) := m
        devolver v
    fin

    función registros(física: nat32, octetos: nat32): nat32
        variable d, n, i, v, z: nat32
        z := de_quién()
        d := física yb (PÁGINA - 1)
        n := (d + octetos + PÁGINA - 1) div PÁGINA
        si octetos = 0 o n > 64 o n_trozos[z] >= MAX_TROZOS entonces devolver NO_VALE fin
        si zona[z] + n * PÁGINA > ZONA_FINAL entonces devolver SIN_MEMORIA fin
        ; (solo lo que no es memoria de verdad: los registros de un aparato)
        si física < límite entonces devolver NO_VALE fin
        para i desde 0 hasta n - 1 hacer
            si no mapear(actual.cr3, zona[z] + i * PÁGINA, (física yb 0xFFFFF000) + i * PÁGINA, ESCRIBIR ob USUARIO ob 0x18) entonces devolver SIN_MEMORIA fin   ; (0x18: sin caché)
        fin
        trozo_v[z * MAX_TROZOS + n_trozos[z]] := zona[z]
        trozo_n[z * MAX_TROZOS + n_trozos[z]] := n
        n_trozos[z] := n_trozos[z] + 1
        v := zona[z] + d
        zona[z] := zona[z] + n * PÁGINA
        devolver v
    fin

    ; ---- la interrupción de la tarjeta: se tapa y despierta al servicio ----
    función tapa_irq(n: nat32)
        si n < 8 entonces
            sacar_puerto(0x21, meter_puerto(0x21) ob byte(1 << n))
        sino
            sacar_puerto(0xA1, meter_puerto(0xA1) ob byte(1 << (n - 8)))
        fin
    fin

    función destapa_irq(n: nat32)
        variable b: nat32
        b := sin_interrupciones()
        si n < 8 entonces
            sacar_puerto(0x21, meter_puerto(0x21) yb byte(nob (1 << n)))
        sino
            sacar_puerto(0xA1, meter_puerto(0xA1) yb byte(nob (1 << (n - 8))))
            sacar_puerto(0x21, meter_puerto(0x21) yb 0xFB)      ; (y la del esclavo, la 2)
        fin
        reponer(b)
    fin

    función llegó_irq()
        irqs_red := irqs_red + 1
        si irq_red <> 0 entonces tapa_irq(irq_red) fin
        si irq_red >= 8 entonces sacar_puerto(0xA0, 0x20) fin
        sacar_puerto(0x20, 0x20)
        despierta_servicio()
    fin

    ; una puerta por cada línea que puede tener una tarjeta PCI (las demás,
    ; del reloj, el teclado, el ratón y los discos, no se dan)
    interrupción función irq3()
        llegó_irq()
    fin
    interrupción función irq5()
        llegó_irq()
    fin
    interrupción función irq7()
        llegó_irq()
    fin
    interrupción función irq9()
        llegó_irq()
    fin
    interrupción función irq10()
        llegó_irq()
    fin
    interrupción función irq11()
        llegó_irq()
    fin

    función pon_irq(n: nat32): nat32
        variable r: nat32
        si irq_red <> 0 entonces
            tapa_irq(irq_red)
            irq_red := 0
        fin
        si n = 0 entonces devolver 0 fin
        r := 0
        según nat16(n)
            caso 3: r := nat32(dirección(irq3))
            caso 5: r := nat32(dirección(irq5))
            caso 7: r := nat32(dirección(irq7))
            caso 9: r := nat32(dirección(irq9))
            caso 10: r := nat32(dirección(irq10))
            caso 11: r := nat32(dirección(irq11))
        fin
        si r = 0 entonces devolver NO_VALE fin
        pon_puerta(0x20 + n, r, PUERTA_NÚCLEO)
        irq_red := n
        destapa_irq(n)
        devolver 0
    fin

    ; -------------------------------------------------------------------------
    ;  Cuando acaba una tarea (la llama usuario.cas, en recoge_lo_suyo)
    ; -------------------------------------------------------------------------
    público función acabó(t: puntero a Tarea)
        variable i, j, bi, d: nat32
        ; (TLS) el servicio TLS: los que le esperaban, con SIN_TLS; y, como
        ; también ha usado la red, se le dice al de red más abajo
        si hay_tls() y servicio_tls = t entonces
            bi := sin_interrupciones()
            servicio_tls := nulo
            n_avisos[A_TLS] := 0
            para i desde 0 hasta MAX_HUECOS - 1 hacer
                si huecos[i].destino = A_TLS y (huecos[i].estado = H_PEDIDO o huecos[i].estado = H_EN_SERVICIO) entonces
                    huecos[i].cab[0] := SIN_TLS
                    huecos[i].cab[7] := 0
                    huecos[i].estado := H_RESPONDIDO
                    despertar_tarea(huecos[i].tarea)
                fin
            fin
            para i desde 0 hasta MAX_TAREAS - 1 hacer usaron[MAX_TAREAS + i] := 0 fin
            reponer(bi)
        fin
        ; (WIFI) el servicio Wi-Fi: su tarjeta deja de hacer DMA, sus registros
        ; fuera de su vista, los que le esperaban con SIN_WIFI; y, como ha
        ; usado la red, se le dice a RED.BIN más abajo
        si hay_wifi() y servicio_wifi = t entonces
            si aparato_wifi <> 0xFFFFFFFF entonces pci_escribir16(aparato_wifi, PCI_ORDEN, pci_leer16(aparato_wifi, PCI_ORDEN) yb 0xFFFB) fin
            para i desde 0 hasta MAX_TROZOS - 1 hacer
                si i < n_trozos[1] entonces
                    para j desde 0 hasta trozo_n[MAX_TROZOS + i] - 1 hacer desmapear(t.cr3, trozo_v[MAX_TROZOS + i] + j * PÁGINA) fin
                fin
            fin
            n_trozos[1] := 0
            bi := sin_interrupciones()
            servicio_wifi := nulo
            estado_wifi := WIFI_NADA
            barras_wifi := 0
            cambios_red := cambios_red + 1
            n_avisos[A_WIFI] := 0
            para i desde 0 hasta MAX_HUECOS - 1 hacer
                si huecos[i].destino = A_WIFI y (huecos[i].estado = H_PEDIDO o huecos[i].estado = H_EN_SERVICIO) entonces
                    huecos[i].cab[0] := SIN_WIFI
                    huecos[i].cab[7] := 0
                    huecos[i].estado := H_RESPONDIDO
                    despertar_tarea(huecos[i].tarea)
                fin
            fin
            para i desde 0 hasta MAX_TAREAS - 1 hacer usaron[2 * MAX_TAREAS + i] := 0 fin
            reponer(bi)
        fin
        si hay_servicio() y servicio = t entonces
            ; la tarjeta deja de leer y escribir en la memoria (que va a volver
            ; a los marcos libres) y su interrupción, tapada
            si irq_red <> 0 entonces
                tapa_irq(irq_red)
                irq_red := 0
            fin
            si aparato <> 0xFFFFFFFF entonces pci_escribir16(aparato, PCI_ORDEN, pci_leer16(aparato, PCI_ORDEN) yb 0xFFFB) fin
            ; los registros, fuera de su vista (no son marcos que devolver)
            para i desde 0 hasta MAX_TROZOS - 1 hacer
                si i < n_trozos[0] entonces
                    para j desde 0 hasta trozo_n[i] - 1 hacer desmapear(t.cr3, trozo_v[i] + j * PÁGINA) fin
                fin
            fin
            n_trozos[0] := 0
            bi := sin_interrupciones()
            servicio := nulo
            si estado_red = RED_SIN_TARJETA entonces sin_tarjeta := cierto fin
            estado_red := RED_NADA
            ip_red := 0
            por_wifi := falso                       ; (WIFI)
            cambios_red := cambios_red + 1
            n_avisos[A_RED] := 0
            ; los que esperaban, con SIN_RED
            para i desde 0 hasta MAX_HUECOS - 1 hacer
                si huecos[i].destino = A_RED y (huecos[i].estado = H_PEDIDO o huecos[i].estado = H_EN_SERVICIO) entonces
                    huecos[i].cab[0] := SIN_RED
                    huecos[i].cab[7] := 0
                    huecos[i].estado := H_RESPONDIDO
                    despertar_tarea(huecos[i].tarea)
                fin
            fin
            para i desde 0 hasta MAX_TAREAS - 1 hacer usaron[i] := 0 fin
            reponer(bi)
            devolver
        fin
        para d desde A_RED hasta A_WIFI hacer      ; (WIFI) también el servicio Wi-Fi
            para i desde 0 hasta MAX_TAREAS - 1 hacer
                si usaron[d * MAX_TAREAS + i] = t.id entonces
                    usaron[d * MAX_TAREAS + i] := 0
                    bi := sin_interrupciones()
                    si n_avisos[d] < MAX_TAREAS entonces
                        avisos[d * MAX_TAREAS + n_avisos[d]] := t.id
                        n_avisos[d] := n_avisos[d] + 1
                    fin
                    despierta(d)
                    reponer(bi)
                fin
            fin
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Las llamadas (usuario.cas manda aquí de la 90 a la 99)
    ; -------------------------------------------------------------------------
    público función atender_red(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable p: puntero a nat32
        si apagada entonces devolver SIN_RED fin
        según nat16(n)
            caso 90: devolver pedir(a, b, c, A_RED)
            caso 99: devolver pedir(a, b, c, A_TLS)        ; (TLS)
            caso 100: devolver pedir(a, b, c, A_WIFI)      ; (WIFI)
            caso 91: devolver apuntarse()
            caso 92: devolver siguiente(a, b)
            caso 93: devolver contestar(a, b)
            caso 94:
                si no es_servicio() y no es_wifi() entonces devolver NO_VALE fin
                devolver memoria_dma(a, b)
            caso 95:
                si no es_servicio() y no es_wifi() entonces devolver NO_VALE fin
                devolver registros(a, b)
            caso 96:
                si es_wifi() entonces
                    ; (WIFI) WIFI.BIN: el estado (y las barras, bits 8-10), la señal y su tarjeta
                    si estado_wifi <> (a yb 0xFF) o barras_wifi <> ((a >> 8) yb 7) entonces cambios_red := cambios_red + 1 fin
                    estado_wifi := a yb 0xFF
                    barras_wifi := (a >> 8) yb 7
                    señal_wifi := ent32(b)
                    aparato_wifi := c
                    devolver 0
                fin
                si no es_servicio() entonces devolver NO_VALE fin
                ; (WIFI) el bit 9: por el Wi-Fi; los 12 y 13: lo que prefiere
                si estado_red <> (a yb 0xFF) o ip_red <> b o por_wifi <> ((a >> 9) yb 1 = 1) o preferir_red <> ((a >> 12) yb 3) entonces cambios_red := cambios_red + 1 fin
                estado_red := a yb 0xFF
                por_wifi := (a >> 9) yb 1 = 1
                preferir_red := (a >> 12) yb 3
                ip_red := b
                aparato := c
                devolver 0
            caso 97:
                si a <> 0 entonces
                    si no puede(a, 4, cierto) entonces devolver NO_VALE fin
                    p := puntero(a)
                    valor(p) := ip_red
                fin
                si no hay_servicio() entonces devolver RED_NADA fin
                devolver estado_red
            caso 98:
                si no es_servicio() entonces devolver NO_VALE fin
                devolver pon_irq(a)
        fin
        devolver NO_VALE
    fin

    ; (dispositivos) la tarjeta que lleva el servicio de red: su número de PCI
    ; (NO_HAY_PCI si no hay servicio o aún no lo ha dicho)
    ; (WIFI) la tarjeta Wi-Fi que lleva WIFI.BIN (NO_HAY_PCI si no hay servicio o no tiene tarjeta)
    público función aparato_de_wifi(): nat32
        si no hay_wifi() o estado_wifi = WIFI_NADA o estado_wifi = WIFI_SIN_TARJETA entonces devolver NO_HAY_PCI fin
        devolver aparato_wifi
    fin

    ; (WIFI) el escritorio (Configuración) pide Cable, Wi-Fi o Automático:
    ; se le pasa a RED.BIN (que lo guarda en RED.INI y lo aplica)
    público función pedir_preferencia(v: nat32)
        variable bi: nat32
        si v > PREFIERE_WIFI entonces devolver fin
        bi := sin_interrupciones()
        preferencia_pedida := v
        preferir_red := v
        cambios_red := cambios_red + 1
        despierta_servicio()
        reponer(bi)
    fin

    público función aparato_de_red(): nat32
        si no hay_servicio() o estado_red = RED_NADA o estado_red = RED_SIN_TARJETA entonces devolver NO_HAY_PCI fin
        devolver aparato
    fin

fin Red.
