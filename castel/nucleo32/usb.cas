; =============================================================================
;  usb.cas - el USB del núcleo de Hispa-Pentium: buscar las controladoras
;  (xHCI, EHCI y UHCI: xhci.cas, ehci.cas y uhci.cas), quitárselas a la BIOS, y enumerar lo
;  que hay enchufado, también detrás de concentradores: a cada aparato se le
;  da dirección, se leen sus descriptores (quién es, sus interfaces y sus
;  extremos) y se le pone su configuración. Quedan apuntados en «aparatos»;
;  de ahí los toman las clases: usbhid.cas (teclados y ratones) y usbalm.cas
;  (memorias).
;
;  Lo que dan las controladoras se usa por aquí, sin saber cuál hay debajo:
;  control(), granel() y las tuberías de interrupción. Un cerrojo hace que
;  las tareas hablen por el USB de una en una.
;
;  Al arrancar se enumera lo que hay enchufado; lo que se enchufa y se
;  desenchufa después lo atiende usbcal.cas (con enchufa_raíz,
;  enchufa_concentrador y quita, de aquí). Un aparato que se ha ido queda
;  marcado («ido») antes de quitarlo: lo que se le pida falla en el acto.
;  Con «sinusb» en la línea del cargador no se toca nada: el USB se queda
;  como lo dejó la BIOS.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Usb

    importar Pci, Marcos, Tareas, Usbbase, Ehci, Xhci, Uhci, Mem32, Registro

    público constante MAX_APARATOS = 16
    público constante MAX_TUBOS = 12
    público constante NINGUNO = 0xFFFFFFFF
    constante MAX_NIVEL = 5                     ; los concentradores que puede haber en fila

    ; ---- las peticiones de siempre ----
    público constante PIDE_ESTADO = 0
    público constante QUITA_CARACTERÍSTICA = 1
    público constante PON_CARACTERÍSTICA = 3
    público constante PON_DIRECCIÓN = 5
    público constante PIDE_DESCRIPTOR = 6
    público constante PON_CONFIGURACIÓN = 9

    tipo Tubo = estructura
        usado: bool
        aparato: nat32
        suyo: nat32                             ; su número para su controladora
    fin

    público variable aparatos: arreglo [MAX_APARATOS] de Aparato
    público variable n_aparatos: nat32
    público variable controladoras: nat32       ; las que se han tomado
    variable tubos: arreglo [MAX_TUBOS] de Tubo
    variable n_tubos: nat32
    variable cerrojo: Cerrojo
    variable página: nat32                      ; para la petición (los 8 primeros octetos) y sus datos (desde 0x400)
    variable direcciones: arreglo [4] de nat32  ; las direcciones USB dadas (EHCI y UHCI): un bit cada una
    ; los aparatos que no se han dejado enumerar: dónde estaban y en qué
    ; paso se quedaron (para decirlo)
    constante MAX_FALLOS = 8
    tipo Fallo = estructura
        hc_clase, puerto_raíz, padre, puerto, velocidad, punto: nat32
        código: nat32                           ; (UEFI) el del xHCI en ese paso (Xhci.último_código)
        leídos: nat32                           ; (UEFI) los octetos que han llegado (o el error)
        datos: arreglo [8] de byte              ; (UEFI) los 8 primeros de lo leído
        luego_bien: bool                        ; (UEFI) al reintentarlo (otro reinicio del puerto), sí
        paquete0, tt: nat32                     ; (UEFI) el paquete del extremo 0 con que se iba; el traductor (dir. y puerto)
    fin
    variable fallos: arreglo [MAX_FALLOS] de Fallo
    público variable n_fallos: nat32
    constante DATOS = 0x400
    constante MAX_DATOS = 1024

    ; -------------------------------------------------------------------------
    ;  Hablar con un aparato, sea de la controladora que sea
    ; -------------------------------------------------------------------------
    ; una transferencia de control con el aparato a, sin tomar el cerrojo
    ; (la petición y los datos, ya en la página)
    función haz_control(ref a: Aparato, pide: nat32, petición: nat32, valor_: nat32, índice: nat32, n: nat32): ent32
        variable p: puntero a byte
        variable r: ent32
        variable intentos: nat32
        p := puntero(página)
        p[0] := pide
        p[1] := petición
        p[2] := valor_
        p[3] := valor_ >> 8
        p[4] := índice
        p[5] := índice >> 8
        p[6] := n
        p[7] := n >> 8
        r := T_FALLO
        intentos := 0
        si n <> 0 y pide yb 0x80 <> 0 entonces llenar(puntero(página + DATOS), 8, 0) fin      ; (UEFI) para ver luego lo que llega (solo si entra: si sale, son los datos)
        mientras r = T_FALLO y intentos < 3 hacer
            si a.hc_clase = HC_XHCI entonces
                r := Xhci.control(a.hc, a, página, página + DATOS, n, pide yb 0x80 <> 0)
            sino si a.hc_clase = HC_EHCI entonces
                r := Ehci.control(a.hc, a, página, página + DATOS, n, pide yb 0x80 <> 0)
            sino
                r := Uhci.control(a.hc, a, página, página + DATOS, n, pide yb 0x80 <> 0)
            fin
            intentos := intentos + 1
        fin
        último_r := r                           ; (UEFI)
        devolver r
    fin

    ; una petición de control al aparato número i: «pide» (con el bit 7 si
    ; los datos entran), la petición, su valor y su índice, y n octetos de
    ; datos (hasta 1024) en «datos». Da los octetos que han ido, T_PARADA o
    ; T_FALLO.
    público función control(i: nat32, pide: nat32, petición: nat32, valor_: nat32, índice: nat32, datos: puntero a byte, n: nat32): ent32
        variable r: ent32
        si i >= MAX_APARATOS o n > MAX_DATOS entonces devolver T_FALLO fin
        si no aparatos[i].usado o aparatos[i].ido entonces devolver T_FALLO fin
        tomar(cerrojo)
        si n <> 0 y pide yb 0x80 = 0 entonces copiar_memoria(puntero(página + DATOS), datos, n) fin
        r := haz_control(aparatos[i], pide, petición, valor_, índice, n)
        si r > 0 y pide yb 0x80 <> 0 entonces copiar_memoria(datos, puntero(página + DATOS), nat32(r)) fin
        soltar(cerrojo)
        devolver r
    fin

    ; una transferencia a granel con el extremo número e del aparato número
    ; i: n octetos (hasta una página) en «datos», que tiene que ser una
    ; dirección física (una página del núcleo). Espera hasta «cs»
    ; centésimas. Da los que han ido, T_PARADA o T_FALLO.
    público función granel(i: nat32, e: nat32, datos: nat32, n: nat32, cs: nat32): ent32
        variable r: ent32
        si i >= MAX_APARATOS entonces devolver T_FALLO fin
        si no aparatos[i].usado o aparatos[i].ido o e >= aparatos[i].n_extremos entonces devolver T_FALLO fin
        tomar(cerrojo)
        si aparatos[i].hc_clase = HC_XHCI entonces
            r := Xhci.granel(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e], datos, n, cs)
        sino si aparatos[i].hc_clase = HC_EHCI entonces
            r := Ehci.granel(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e], datos, n, cs)
        sino
            r := Uhci.granel(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e], datos, n, cs)
        fin
        soltar(cerrojo)
        devolver r
    fin

    ; el extremo e del aparato i se ha parado (STALL): se le quita la parada
    ; (y la alternancia vuelve a empezar)
    público función quita_parada(i: nat32, e: nat32)
        si i >= MAX_APARATOS entonces devolver fin
        si no aparatos[i].usado o aparatos[i].ido o e >= aparatos[i].n_extremos entonces devolver fin
        tomar(cerrojo)
        haz_control(aparatos[i], 0x02, QUITA_CARACTERÍSTICA, 0, aparatos[i].extremos[e].número, 0)
        aparatos[i].extremos[e].alterna := 0
        soltar(cerrojo)
    fin

    ; abre una tubería de interrupción para el extremo e del aparato i. Da
    ; su número, o NINGUNO.
    público función tubo_abre(i: nat32, e: nat32): nat32
        variable t, s: nat32
        si i >= MAX_APARATOS entonces devolver NINGUNO fin
        si no aparatos[i].usado o aparatos[i].ido o e >= aparatos[i].n_extremos entonces devolver NINGUNO fin
        tomar(cerrojo)
        si aparatos[i].hc_clase = HC_XHCI entonces
            s := Xhci.tubo_abre(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e])
        sino si aparatos[i].hc_clase = HC_EHCI entonces
            s := Ehci.tubo_abre(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e])
        sino
            s := Uhci.tubo_abre(aparatos[i].hc, aparatos[i], aparatos[i].extremos[e])
        fin
        t := 0
        mientras t < n_tubos y tubos[t].usado hacer t := t + 1 fin
        si t >= MAX_TUBOS entonces t := NINGUNO fin
        si s <> 0xFFFFFFFF y t <> NINGUNO entonces
            tubos[t].usado := cierto
            tubos[t].aparato := i
            tubos[t].suyo := s
            si t = n_tubos entonces n_tubos := t + 1 fin
        sino si s <> 0xFFFFFFFF entonces
            cierra_suyo(i, s)
            t := NINGUNO
        fin
        soltar(cerrojo)
        devolver t
    fin

    ; pide n octetos (hasta 64) por la tubería t
    público función tubo_pide(t: nat32, n: nat32)
        variable i: nat32
        si t >= n_tubos entonces devolver fin
        si no tubos[t].usado entonces devolver fin
        i := tubos[t].aparato
        si aparatos[i].ido entonces devolver fin
        tomar(cerrojo)
        si aparatos[i].hc_clase = HC_XHCI entonces
            Xhci.tubo_pide(aparatos[i].hc, tubos[t].suyo, n)
        sino si aparatos[i].hc_clase = HC_EHCI entonces
            Ehci.tubo_pide(aparatos[i].hc, tubos[t].suyo, n)
        sino
            Uhci.tubo_pide(aparatos[i].hc, tubos[t].suyo, n)
        fin
        soltar(cerrojo)
    fin

    ; ¿ha llegado lo pedido por la tubería t? Da los octetos (de los n
    ; pedidos), T_ESPERA si aún no, o T_FALLO
    público función tubo_mira(t: nat32, n: nat32): ent32
        variable i: nat32
        variable r: ent32
        si t >= n_tubos entonces devolver T_FALLO fin
        si no tubos[t].usado entonces devolver T_FALLO fin
        i := tubos[t].aparato
        si aparatos[i].ido entonces devolver T_FALLO fin
        tomar(cerrojo)
        si aparatos[i].hc_clase = HC_XHCI entonces
            r := Xhci.tubo_mira(aparatos[i].hc, tubos[t].suyo, n)
        sino si aparatos[i].hc_clase = HC_EHCI entonces
            r := Ehci.tubo_mira(aparatos[i].hc, tubos[t].suyo, n)
        sino
            r := Uhci.tubo_mira(aparatos[i].hc, tubos[t].suyo, n)
        fin
        soltar(cerrojo)
        devolver r
    fin

    ; dónde quedan los octetos que llegan por la tubería t
    público función tubo_datos(t: nat32): puntero a byte
        variable i: nat32
        si t >= n_tubos entonces devolver nulo fin
        i := tubos[t].aparato
        si aparatos[i].hc_clase = HC_XHCI entonces devolver Xhci.tubo_datos(aparatos[i].hc, tubos[t].suyo) fin
        si aparatos[i].hc_clase = HC_EHCI entonces devolver Ehci.tubo_datos(aparatos[i].hc, tubos[t].suyo) fin
        devolver Uhci.tubo_datos(aparatos[i].hc, tubos[t].suyo)
    fin

    ; cierra la tubería número s de la controladora del aparato i
    función cierra_suyo(i: nat32, s: nat32)
        si aparatos[i].hc_clase = HC_XHCI entonces
            Xhci.tubo_cierra(aparatos[i].hc, s)
        sino si aparatos[i].hc_clase = HC_EHCI entonces
            Ehci.tubo_cierra(aparatos[i].hc, s)
        sino
            Uhci.tubo_cierra(aparatos[i].hc, s)
        fin
    fin

    ; una dirección USB libre (de 1 a 127), o 0 si no queda ninguna
    función toma_dir(): nat32
        variable d: nat32
        para d desde 1 hasta 127 hacer
            si direcciones[d >> 5] yb (nat32(1) << (d yb 31)) = 0 entonces
                direcciones[d >> 5] := direcciones[d >> 5] ob (nat32(1) << (d yb 31))
                devolver d
            fin
        fin
        devolver 0
    fin

    función suelta_dir(d: nat32)
        si d <> 0 y d < 128 entonces direcciones[d >> 5] := direcciones[d >> 5] yb nob (nat32(1) << (d yb 31)) fin
    fin

    ; -------------------------------------------------------------------------
    ;  Enumerar
    ; -------------------------------------------------------------------------
    función dato16(p: puntero a byte): nat32
        devolver p[0] ob (nat32(p[1]) << 8)
    fin

    ; lee la configuración del aparato (ya en la página, «largo» octetos) y
    ; apunta sus interfaces y sus extremos a granel y de interrupción
    función lee_configuración(ref a: Aparato, largo: nat32)
        variable p: puntero a byte
        variable d, n, clase, interfaz: nat32
        variable vale: bool
        p := puntero(página + DATOS)
        a.configuración := p[5]
        a.n_interfaces := 0
        a.n_extremos := 0
        d := 0
        interfaz := 0
        vale := falso
        mientras d + 2 <= largo y p[d] >= 2 y d + p[d] <= largo hacer
            si p[d + 1] = 4 y p[d] >= 9 entonces
                ; una interfaz (solo su primera variante)
                vale := p[d + 3] = 0 y a.n_interfaces < MAX_INTERFACES
                si vale entonces
                    n := a.n_interfaces
                    a.interfaces[n].número := p[d + 2]
                    a.interfaces[n].clase := p[d + 5]
                    a.interfaces[n].subclase := p[d + 6]
                    a.interfaces[n].protocolo := p[d + 7]
                    interfaz := n
                    a.n_interfaces := n + 1
                fin
            sino si p[d + 1] = 5 y p[d] >= 7 y vale y a.n_extremos < MAX_EXTREMOS entonces
                clase := p[d + 3] yb 3
                si clase = 2 o clase = 3 entonces
                    n := a.n_extremos
                    a.extremos[n].número := p[d + 2]
                    a.extremos[n].clase := clase
                    a.extremos[n].paquete := dato16(dirección(p[d + 4])) yb 0x7FF
                    a.extremos[n].intervalo := p[d + 6]
                    a.extremos[n].interfaz := interfaz
                    a.extremos[n].alterna := 0
                    a.extremos[n].anillo.base := 0
                    a.n_extremos := n + 1
                fin
            fin
            d := d + p[d]
        fin
    fin

    ; el aparato de la ficha i no se deja enumerar: se apunta en qué paso
    ; (1: la dirección; 2 y 3: su descriptor; 4 y 5: su configuración; 6:
    ; los extremos; 7: ponerle la configuración). Da NINGUNO.
    variable último_r: ent32                    ; (UEFI) lo que dio la última petición de enumera (para el registro)

    función no_se_deja(i: nat32, punto: nat32): nat32
        variable k: nat32
        variable p: puntero a byte
        ; (lo que se le haya dado, se suelta: la ranura del xHCI, la dirección)
        si aparatos[i].hc_clase = HC_XHCI entonces
            Xhci.quita_aparato(aparatos[i].hc, aparatos[i])
        sino
            suelta_dir(aparatos[i].dir)
        fin
        aparatos[i].dir := 0
        si n_fallos < MAX_FALLOS entonces
            fallos[n_fallos].hc_clase := aparatos[i].hc_clase
            fallos[n_fallos].puerto_raíz := aparatos[i].puerto_raíz
            fallos[n_fallos].padre := aparatos[i].padre
            fallos[n_fallos].puerto := aparatos[i].puerto
            fallos[n_fallos].velocidad := aparatos[i].velocidad
            fallos[n_fallos].punto := punto
            ; (UEFI) cómo ha acabado (el código del xHCI), cuánto ha llegado y lo primero
            fallos[n_fallos].código := 0
            si aparatos[i].hc_clase = HC_XHCI entonces fallos[n_fallos].código := Xhci.último_código fin
            fallos[n_fallos].leídos := nat32(último_r)
            p := puntero(página + DATOS)
            para k desde 0 hasta 7 hacer fallos[n_fallos].datos[k] := p[k] fin
            fallos[n_fallos].luego_bien := falso
            fallos[n_fallos].paquete0 := aparatos[i].paquete0
            fallos[n_fallos].tt := (aparatos[i].tt_dir << 8) ob aparatos[i].tt_puerto
            si aparatos[i].hc_clase = HC_XHCI entonces fallos[n_fallos].tt := (aparatos[i].tt_ranura << 8) ob aparatos[i].tt_puerto fin
            n_fallos := n_fallos + 1
        fin
        devolver NINGUNO
    fin

    ; una ficha libre para un aparato nuevo (NINGUNO: no quedan)
    función ficha_libre(): nat32
        variable i: nat32
        para i desde 0 hasta MAX_APARATOS - 1 hacer
            si no aparatos[i].usado entonces devolver i fin
        fin
        devolver NINGUNO
    fin

    ; hay un aparato recién reiniciado en un puerto (de la controladora, o
    ; del concentrador «padre»): darle dirección, leer quién es y ponerle su
    ; configuración. Si es un concentrador, se sigue por sus puertos. Da su
    ; número, o NINGUNO si no se deja.
    función enumera(hc_clase: nat32, hc: nat32, puerto_raíz: nat32, padre: nat32, puerto: nat32, velocidad: nat32): nat32
        variable i, largo: nat32
        variable p: puntero a byte
        variable r: ent32
        i := ficha_libre()
        si i = NINGUNO entonces devolver NINGUNO fin
        llenar(puntero(nat32(dirección(aparatos[i]))), tamaño(Aparato), 0)
        aparatos[i].hc_clase := hc_clase
        aparatos[i].hc := hc
        aparatos[i].velocidad := velocidad
        aparatos[i].puerto_raíz := puerto_raíz
        aparatos[i].padre := padre
        aparatos[i].puerto := puerto
        según velocidad
            caso V_ALTA: aparatos[i].paquete0 := 64
            caso V_SÚPER: aparatos[i].paquete0 := 512
            si no: aparatos[i].paquete0 := 8
        fin
        ; (UEFI) en el xHCI, uno de velocidad plena empieza con 64 (como Linux):
        ; se leen 8 octetos (un paquete corto si su extremo 0 es de 8) y luego
        ; se le dice lo que diga él (Evaluate Context)
        si hc_clase = HC_XHCI y velocidad = V_PLENA entonces aparatos[i].paquete0 := 64 fin
        si padre <> SIN_APARATO entonces
            aparatos[i].nivel := aparatos[padre].nivel + 1
            largo := puerto
            si largo > 15 entonces largo := 15 fin
            aparatos[i].ruta := aparatos[padre].ruta ob (largo << (4 * aparatos[padre].nivel))
            ; el traductor, si es de USB 1.x: el concentrador de alta
            ; velocidad más cercano por arriba, y su puerto
            si velocidad < V_ALTA entonces
                si aparatos[padre].velocidad = V_ALTA entonces
                    aparatos[i].tt_dir := aparatos[padre].dir
                    aparatos[i].tt_ranura := aparatos[padre].ranura
                    aparatos[i].tt_puerto := puerto
                sino
                    aparatos[i].tt_dir := aparatos[padre].tt_dir
                    aparatos[i].tt_ranura := aparatos[padre].tt_ranura
                    aparatos[i].tt_puerto := aparatos[padre].tt_puerto
                fin
            fin
        fin
        p := puntero(página + DATOS)
        ; la dirección
        si hc_clase = HC_XHCI entonces
            si no Xhci.nuevo_aparato(hc, aparatos[i]) entonces devolver no_se_deja(i, 1) fin
            ; (UEFI) el rato que necesita el aparato después de su dirección (la
            ; norma da 2 ms; con el EHCI ya se esperaban 10, con el xHCI nada,
            ; y hay ratones y teclados de velocidad plena que no contestaban)
            espera_ms(10)
        sino
            largo := toma_dir()
            si largo = 0 entonces devolver NINGUNO fin
            r := haz_control(aparatos[i], 0x00, PON_DIRECCIÓN, largo, 0, 0)
            si r < 0 entonces
                suelta_dir(largo)
                devolver no_se_deja(i, 1)
            fin
            aparatos[i].dir := largo
            espera_ms(10)
        fin
        ; lo primero de su descriptor: el paquete máximo de su extremo 0
        r := haz_control(aparatos[i], 0x80, PIDE_DESCRIPTOR, 0x0100, 0, 8)
        si r < 8 entonces devolver no_se_deja(i, 2) fin
        si velocidad < V_SÚPER y p[7] <> aparatos[i].paquete0 y (p[7] = 8 o p[7] = 16 o p[7] = 32 o p[7] = 64) entonces
            aparatos[i].paquete0 := p[7]
            si hc_clase = HC_XHCI entonces
                si no Xhci.pon_paquete0(hc, aparatos[i]) entonces devolver no_se_deja(i, 2) fin
            fin
        fin
        r := haz_control(aparatos[i], 0x80, PIDE_DESCRIPTOR, 0x0100, 0, 18)
        si r < 18 entonces devolver no_se_deja(i, 3) fin
        aparatos[i].clase := p[4]
        aparatos[i].fabricante := dato16(dirección(p[8]))
        aparatos[i].producto := dato16(dirección(p[10]))
        ; su configuración (la primera): cuánto mide, y entera
        r := haz_control(aparatos[i], 0x80, PIDE_DESCRIPTOR, 0x0200, 0, 9)
        si r < 9 entonces devolver no_se_deja(i, 4) fin
        largo := dato16(dirección(p[2]))
        si largo > MAX_DATOS entonces largo := MAX_DATOS fin
        r := haz_control(aparatos[i], 0x80, PIDE_DESCRIPTOR, 0x0200, 0, largo)
        si r < 9 entonces devolver no_se_deja(i, 5) fin
        lee_configuración(aparatos[i], nat32(r))
        si hc_clase = HC_XHCI entonces
            si no Xhci.configura(hc, aparatos[i]) entonces devolver no_se_deja(i, 6) fin
        fin
        r := haz_control(aparatos[i], 0x00, PON_CONFIGURACIÓN, aparatos[i].configuración, 0, 0)
        si r < 0 entonces devolver no_se_deja(i, 7) fin
        aparatos[i].usado := cierto
        n_aparatos := n_aparatos + 1
        si aparatos[i].clase = 9 o (aparatos[i].n_interfaces > 0 y aparatos[i].interfaces[0].clase = 9) entonces
            concentrador(i)
        fin
        devolver i
    fin

    ; el aparato i es un concentrador: se enciende, y se enumera lo que haya
    ; en cada uno de sus puertos
    función concentrador(i: nat32)
        variable p: puntero a byte
        variable r: ent32
        variable puerto, clase, espera: nat32
        p := puntero(página + DATOS)
        clase := 0x2900
        si aparatos[i].velocidad = V_SÚPER entonces clase := 0x2A00 fin
        r := haz_control(aparatos[i], 0xA0, PIDE_DESCRIPTOR, clase, 0, 8)
        si r < 7 entonces devolver fin
        aparatos[i].es_concentrador := cierto
        aparatos[i].puertos := p[2]
        aparatos[i].tiempo_tt := (p[3] >> 5) yb 3
        espera := nat32(p[5]) * 2
        si aparatos[i].puertos > 15 entonces aparatos[i].puertos := 15 fin
        si aparatos[i].nivel >= MAX_NIVEL entonces devolver fin
        si aparatos[i].hc_clase = HC_XHCI entonces
            si no Xhci.configura(aparatos[i].hc, aparatos[i]) entonces devolver fin
        fin
        si aparatos[i].velocidad = V_SÚPER entonces
            haz_control(aparatos[i], 0x20, 12, aparatos[i].nivel, 0, 0)       ; (USB 3: a qué profundidad está)
        fin
        ; corriente a sus puertos, y un rato para que se asiente
        para puerto desde 1 hasta aparatos[i].puertos hacer
            haz_control(aparatos[i], 0x23, PON_CARACTERÍSTICA, 8, puerto, 0)
        fin
        si espera < 100 entonces espera := 100 fin
        espera_ms(espera + 50)
        para puerto desde 1 hasta aparatos[i].puertos hacer
            r := haz_control(aparatos[i], 0xA3, PIDE_ESTADO, 0, puerto, 4)
            si r >= 4 y p[0] yb 1 <> 0 entonces puerto_de_concentrador(i, puerto) fin
        fin
    fin

    ; hay algo en ese puerto del concentrador i: reiniciar el puerto, esperar
    ; a que acabe y enumerarlo. Da su número, o NINGUNO.
    ; (UEFI) como enumera_o_reintenta, para el puerto de un concentrador: si
    ; lo que hay no se deja (los aparatos del Bluetooth de los Mac, detrás de
    ; su concentrador, tardan en estar listos), otro reinicio del puerto y otra vez
    función puerto_de_concentrador(i: nat32, puerto: nat32): nat32
        variable r, n0: nat32
        n0 := n_fallos
        r := puerto_de_concentrador_una(i, puerto)
        si r <> NINGUNO o n_fallos = n0 entonces devolver r fin
        espera_ms(100)
        r := puerto_de_concentrador_una(i, puerto)
        si r <> NINGUNO entonces fallos[n0].luego_bien := cierto fin
        si r = NINGUNO y n_fallos > n0 + 1 entonces n_fallos := n0 + 1 fin
        devolver r
    fin

    función puerto_de_concentrador_una(i: nat32, puerto: nat32): nat32
        variable p: puntero a byte
        variable r: ent32
        variable estado, v, vueltas: nat32
        p := puntero(página + DATOS)
        haz_control(aparatos[i], 0x23, QUITA_CARACTERÍSTICA, 16, puerto, 0)
        haz_control(aparatos[i], 0x23, PON_CARACTERÍSTICA, 4, puerto, 0)
        estado := 0
        vueltas := 0
        mientras vueltas < 20 hacer
            espera_ms(20)
            r := haz_control(aparatos[i], 0xA3, PIDE_ESTADO, 0, puerto, 4)
            si r >= 4 entonces
                estado := dato16(p)
                si p[2] yb 0x10 <> 0 entonces vueltas := 100 fin
            fin
            vueltas := vueltas + 1
        fin
        haz_control(aparatos[i], 0x23, QUITA_CARACTERÍSTICA, 20, puerto, 0)
        espera_ms(20)
        si vueltas < 100 o estado yb 2 = 0 entonces devolver NINGUNO fin
        v := V_PLENA
        si aparatos[i].velocidad = V_SÚPER entonces
            v := V_SÚPER
        sino si estado yb 0x200 <> 0 entonces
            v := V_BAJA
        sino si estado yb 0x400 <> 0 entonces
            v := V_ALTA
        fin
        devolver enumera(aparatos[i].hc_clase, aparatos[i].hc, aparatos[i].puerto_raíz, i, puerto, v)
    fin

    ; enumera lo que hay en los puertos de una controladora
    función mira_puertos(hc_clase: nat32, hc: nat32, puertos: nat32)
        variable p, v, e: nat32
        para p desde 1 hasta puertos hacer
            según hc_clase
                caso HC_XHCI: e := Xhci.puerto_estado(hc, p)
                caso HC_EHCI: e := Ehci.puerto_estado(hc, p)
                si no: e := Uhci.puerto_estado(hc, p)
            fin
            si e yb 1 <> 0 entonces
                según hc_clase
                    caso HC_XHCI: v := Xhci.puerto_reinicia(hc, p)
                    caso HC_EHCI: v := Ehci.puerto_reinicia(hc, p)
                    si no: v := Uhci.puerto_reinicia(hc, p)
                fin
                si v <> 0 entonces enumera_o_reintenta(hc_clase, hc, p, v) fin       ; (UEFI)
            fin
        fin
    fin

    ; (UEFI) enumera lo del puerto p de la controladora; si no se deja, otro
    ; reinicio del puerto, un rato, y otra vez (como Windows y Linux: hay
    ; aparatos que la primera vez no contestan bien). En el registro queda el
    ; primer fallo, con «luego sí» si a la segunda ha ido.
    función enumera_o_reintenta(hc_clase: nat32, hc: nat32, p: nat32, v: nat32): nat32
        variable r, n0: nat32
        n0 := n_fallos
        r := enumera(hc_clase, hc, p, SIN_APARATO, 0, v)
        si r <> NINGUNO o n_fallos = n0 entonces devolver r fin
        espera_ms(100)
        según hc_clase
            caso HC_XHCI: v := Xhci.puerto_reinicia(hc, p)
            caso HC_EHCI: v := Ehci.puerto_reinicia(hc, p)
            si no: v := Uhci.puerto_reinicia(hc, p)
        fin
        si v = 0 entonces devolver NINGUNO fin
        espera_ms(50)
        r := enumera(hc_clase, hc, p, SIN_APARATO, 0, v)
        si r <> NINGUNO y n_fallos > n0 entonces fallos[n0].luego_bien := cierto fin
        si r = NINGUNO y n_fallos > n0 + 1 entonces n_fallos := n0 + 1 fin    ; (el mismo, una vez)
        devolver r
    fin

    ; busca las controladoras USB, las toma y enumera lo que haya
    ; enchufado. Da cuántos aparatos ha encontrado.
    público función prepara(): nat32
        variable a, c: nat32
        si página = 0 entonces página := reservar_marco() fin
        si página = 0 entonces devolver 0 fin
        tomar(cerrojo)
        ; primero las xHCI, luego las EHCI y, al final, sus compañeras (UHCI)
        a := pci_busca(0x0C0330, 0xFFFFFF, NO_HAY_PCI)
        mientras a <> NO_HAY_PCI hacer
            si Xhci.prepara(a) <> 0xFFFFFFFF entonces controladoras := controladoras + 1 fin
            a := pci_busca(0x0C0330, 0xFFFFFF, a)
        fin
        a := pci_busca(0x0C0320, 0xFFFFFF, NO_HAY_PCI)
        mientras a <> NO_HAY_PCI hacer
            si Ehci.prepara(a) <> 0xFFFFFFFF entonces controladoras := controladoras + 1 fin
            a := pci_busca(0x0C0320, 0xFFFFFF, a)
        fin
        a := pci_busca(0x0C0300, 0xFFFFFF, NO_HAY_PCI)
        mientras a <> NO_HAY_PCI hacer
            si Uhci.prepara(a) <> 0xFFFFFFFF entonces controladoras := controladoras + 1 fin
            a := pci_busca(0x0C0300, 0xFFFFFF, a)
        fin
        si controladoras <> 0 entonces
            ; un rato para que los puertos vean lo que tienen enchufado
            espera_ms(300)
            c := 0
            mientras c < Xhci.cuántas hacer
                mira_puertos(HC_XHCI, c, xhcis[c].puertos)
                c := c + 1
            fin
            c := 0
            mientras c < Ehci.cuántas hacer
                mira_puertos(HC_EHCI, c, ehcis[c].puertos)
                c := c + 1
            fin
            ; (lo que los EHCI han cedido aparece ahora en los puertos de las compañeras)
            si Uhci.cuántas <> 0 entonces espera_ms(150) fin
            c := 0
            mientras c < Uhci.cuántas hacer
                mira_puertos(HC_UHCI, c, uhcis[c].puertos)
                c := c + 1
            fin
        fin
        soltar(cerrojo)
        devolver n_aparatos
    fin

    ; -------------------------------------------------------------------------
    ;  Enchufar y desenchufar en marcha (lo pide usbcal.cas)
    ; -------------------------------------------------------------------------
    ; lo que hay en el puerto p de una controladora (bit 0: algo enchufado),
    ; sin el cerrojo: solo se miran sus registros
    público función estado_raíz(hc_clase: nat32, hc: nat32, p: nat32): nat32
        según hc_clase
            caso HC_XHCI: devolver Xhci.puerto_estado(hc, p)
            caso HC_EHCI: devolver Ehci.puerto_estado(hc, p)
        fin
        devolver Uhci.puerto_estado(hc, p)
    fin

    ; ¿se ha enchufado o desenchufado algo en ese puerto desde la última
    ; vez? (el aviso queda borrado)
    público función cambio_raíz(hc_clase: nat32, hc: nat32, p: nat32): bool
        según hc_clase
            caso HC_XHCI: devolver Xhci.puerto_cambio(hc, p)
            caso HC_EHCI: devolver Ehci.puerto_cambio(hc, p)
        fin
        devolver Uhci.puerto_cambio(hc, p)
    fin

    ; el aparato que cuelga de ese puerto de la controladora (NINGUNO: ninguno)
    público función en_raíz(hc_clase: nat32, hc: nat32, p: nat32): nat32
        variable i: nat32
        para i desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[i].usado y aparatos[i].padre = SIN_APARATO y aparatos[i].hc_clase = hc_clase y aparatos[i].hc = hc y aparatos[i].puerto_raíz = p entonces devolver i fin
        fin
        devolver NINGUNO
    fin

    ; el que cuelga de ese puerto del concentrador c (NINGUNO: ninguno)
    público función en_concentrador(c: nat32, p: nat32): nat32
        variable i: nat32
        para i desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[i].usado y aparatos[i].padre = c y aparatos[i].puerto = p entonces devolver i fin
        fin
        devolver NINGUNO
    fin

    ; se ha enchufado algo en el puerto p de una controladora: se reinicia
    ; el puerto y se enumera. Da su número, o NINGUNO (también si un EHCI lo
    ; cede a su compañera: allí se verá).
    público función enchufa_raíz(hc_clase: nat32, hc: nat32, p: nat32): nat32
        variable v, r: nat32
        si página = 0 entonces devolver NINGUNO fin
        tomar(cerrojo)
        según hc_clase
            caso HC_XHCI: v := Xhci.puerto_reinicia(hc, p)
            caso HC_EHCI: v := Ehci.puerto_reinicia(hc, p)
            si no: v := Uhci.puerto_reinicia(hc, p)
        fin
        r := NINGUNO
        si v <> 0 entonces r := enumera_o_reintenta(hc_clase, hc, p, v) fin        ; (UEFI)
        soltar(cerrojo)
        devolver r
    fin

    ; cómo está el puerto p del concentrador c: bit 0, algo enchufado; y en
    ; «cambio», si se ha enchufado o desenchufado algo desde la última vez
    ; (los avisos de cambio quedan borrados). 0 si no contesta.
    público función estado_concentrador(c: nat32, p: nat32, ref cambio: bool): nat32
        variable d: puntero a byte
        variable r: ent32
        variable e: nat32
        cambio := falso
        si c >= MAX_APARATOS entonces devolver 0 fin
        si no aparatos[c].usado o aparatos[c].ido o no aparatos[c].es_concentrador entonces devolver 0 fin
        tomar(cerrojo)
        d := puntero(página + DATOS)
        e := 0
        r := haz_control(aparatos[c], 0xA3, PIDE_ESTADO, 0, p, 4)
        si r >= 4 entonces
            e := dato16(d)
            cambio := d[2] yb 1 <> 0
            ; los avisos: el de enchufar (16), habilitar (17), suspender (18), el de corriente de más (19) y el de reinicio (20)
            si d[2] yb 1 <> 0 entonces haz_control(aparatos[c], 0x23, QUITA_CARACTERÍSTICA, 16, p, 0) fin
            si d[2] yb 2 <> 0 entonces haz_control(aparatos[c], 0x23, QUITA_CARACTERÍSTICA, 17, p, 0) fin
            si d[2] yb 8 <> 0 entonces haz_control(aparatos[c], 0x23, QUITA_CARACTERÍSTICA, 19, p, 0) fin
        fin
        soltar(cerrojo)
        devolver e
    fin

    ; se ha enchufado algo en el puerto p del concentrador c: se enumera. Da
    ; su número, o NINGUNO.
    público función enchufa_concentrador(c: nat32, p: nat32): nat32
        variable r: nat32
        si c >= MAX_APARATOS entonces devolver NINGUNO fin
        si no aparatos[c].usado o aparatos[c].ido entonces devolver NINGUNO fin
        tomar(cerrojo)
        r := puerto_de_concentrador(c, p)
        soltar(cerrojo)
        devolver r
    fin

    ; ¿es j el aparato i, o cuelga de él (de un concentrador suyo)?
    público función cuelga_de(j: nat32, i: nat32): bool
        variable n: nat32
        n := 0
        mientras j < MAX_APARATOS y n <= MAX_NIVEL hacer
            si j = i entonces devolver cierto fin
            j := aparatos[j].padre
            n := n + 1
        fin
        devolver falso
    fin

    ; el aparato i (y lo que cuelgue de él) se ha desenchufado: queda
    ; marcado, y lo que se le esté pidiendo falla en el acto. (Sin el
    ; cerrojo: puede tenerlo una transferencia que se ha quedado esperando.)
    público función marca_ido(i: nat32)
        variable j: nat32
        para j desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[j].usado y cuelga_de(j, i) entonces aparatos[j].ido := cierto fin
        fin
    fin

    ; quita el aparato i (ya marcado: marca_ido) y lo que cuelgue de él: sus
    ; tuberías se cierran, la controladora lo olvida (en el xHCI, su ranura
    ; y sus páginas) y su dirección y su ficha quedan libres
    público función quita(i: nat32)
        variable j: nat32
        si i >= MAX_APARATOS entonces devolver fin
        si no aparatos[i].usado entonces devolver fin
        tomar(cerrojo)
        para j desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[j].usado y j <> i y cuelga_de(j, i) entonces quita_uno(j) fin
        fin
        quita_uno(i)
        soltar(cerrojo)
    fin

    función quita_uno(i: nat32)
        variable t: nat32
        para t desde 1 hasta n_tubos hacer
            si tubos[t - 1].usado y tubos[t - 1].aparato = i entonces
                cierra_suyo(i, tubos[t - 1].suyo)
                tubos[t - 1].usado := falso
            fin
        fin
        si aparatos[i].hc_clase = HC_XHCI entonces
            Xhci.quita_aparato(aparatos[i].hc, aparatos[i])
        sino
            suelta_dir(aparatos[i].dir)
        fin
        aparatos[i].usado := falso
        aparatos[i].ido := falso
        si n_aparatos > 0 entonces n_aparatos := n_aparatos - 1 fin
    fin

    ; deja paradas las controladoras (antes de apagar o reiniciar)
    público función para_todo()
        variable c: nat32
        para c desde 0 hasta MAX_XHCI - 1 hacer Xhci.para_(c) fin
        para c desde 0 hasta MAX_EHCI - 1 hacer Ehci.para_(c) fin
        para c desde 0 hasta MAX_UHCI - 1 hacer Uhci.para_(c) fin
    fin

    función nombre_hc(clase: nat32): puntero a byte
        según clase
            caso HC_XHCI: devolver "xHCI"
            caso HC_EHCI: devolver "EHCI"
        fin
        devolver "UHCI"
    fin

    función nombre_velocidad(v: nat32): puntero a byte
        según v
            caso V_BAJA: devolver "baja"
            caso V_PLENA: devolver "plena"
            caso V_ALTA: devolver "alta"
        fin
        devolver "súper"
    fin

    ; dice quién es el aparato i, en una línea que empieza por «usb: », «que» y su número
    público función enseña_aparato(i: nat32, que: puntero a byte)
        variable k: nat32
        variable d: arreglo [4] de nat32
        d[0] := nat32(que)
        d[1] := i
        d[2] := aparatos[i].fabricante
        d[3] := aparatos[i].producto
        apunta("usb: %s %u, %04X:%04X", d)
        apunta1(", velocidad %s", nat32(nombre_velocidad(aparatos[i].velocidad)))
        si aparatos[i].padre <> SIN_APARATO entonces
            apunta2(", en el puerto %u del concentrador %u", aparatos[i].puerto, aparatos[i].padre)
        sino
            apunta2(", en el puerto %u (%s)", aparatos[i].puerto_raíz, nat32(nombre_hc(aparatos[i].hc_clase)))
        fin
        si aparatos[i].es_concentrador entonces apunta1(": concentrador de %u puertos", aparatos[i].puertos) fin
        para k desde 1 hasta aparatos[i].n_interfaces hacer
            d[0] := aparatos[i].interfaces[k - 1].clase
            d[1] := aparatos[i].interfaces[k - 1].subclase
            d[2] := aparatos[i].interfaces[k - 1].protocolo
            si d[0] = 3 y d[2] = 1 entonces
                apunta0("; teclado")
            sino si d[0] = 3 y d[2] = 2 entonces
                apunta0("; ratón")
            sino si d[0] = 8 entonces
                apunta0("; almacenamiento")
            sino si d[0] <> 9 entonces
                apunta("; interfaz %02X/%02X/%02X", d)
            fin
        fin
        apunta0("\n")
    fin

    ; dice las controladoras y los aparatos que hay, uno por línea
    ; (UEFI) qué quiere decir el código con que acaba algo en el xHCI
    función nombre_código(c: nat32): puntero a byte
        según c
            caso 0: devolver "no es del xHCI"
            caso 1: devolver "bien"
            caso 3: devolver "babble: más datos de los esperados"
            caso 4: devolver "error de la transacción"
            caso 5: devolver "error del TRB"
            caso 6: devolver "STALL: el aparato dice que no"
            caso 13: devolver "corto"
            caso 0xFF: devolver "se pasó el tiempo"
        fin
        devolver "otro"
    fin

    público función enseña()
        variable c, i, k: nat32
        variable d: arreglo [4] de nat32
        c := 0
        mientras c < Xhci.cuántas hacer
            d[0] := pci_leer(xhcis[c].pci, 0) yb 0xFFFF
            d[1] := pci_leer(xhcis[c].pci, 0) >> 16
            d[2] := xhcis[c].puertos
            apunta("usb: controladora xHCI %04X:%04X, %u puertos", d)
            si Xhci.traspaso[c] = 2 entonces apunta0(" (la BIOS no la soltaba: se le ha quitado)") fin
            apunta0("\n")
            c := c + 1
        fin
        ; (USB) las zonas de 64 bits que estaban por encima de los 4 GB
        si movidas <> 0 entonces
            d[0] := (movida_aparato >> 16) yb 0xFF
            d[1] := (movida_aparato >> 11) yb 0x1F
            d[2] := (movida_aparato >> 8) yb 7
            d[3] := movida_alta
            apunta("pci: la zona de memoria del %02X:%02X.%u estaba por encima de los 4 GB (%X", d)
            d[0] := movida_baja
            d[1] := movida_a
            d[2] := movida_tam >> 10
            d[3] := movidas
            apunta("%08Xh): movida a %08Xh (%u K); movidas, %u\n", d)
            ; (lo ocupado por encima de la RAM, para ver en un equipo de
            ; verdad por qué ha ido ahí)
            apunta0("pci: ocupado:")
            i := 0
            k := 0
            mientras i < n_ocu y k < 24 hacer
                si ocu_fin[i] > 0x10000000 entonces
                    d[0] := ocu_base[i]
                    d[1] := ocu_fin[i] - 1
                    apunta(" %08X-%08X", d)
                    k := k + 1
                fin
                i := i + 1
            fin
            apunta0("\n")
        fin
        si sin_mover <> 0 entonces
            d[0] := (sin_mover_aparato >> 16) yb 0xFF
            d[1] := (sin_mover_aparato >> 11) yb 0x1F
            d[2] := (sin_mover_aparato >> 8) yb 7
            d[3] := sin_mover_alta
            apunta("pci: la zona del %02X:%02X.%u está por encima de los 4 GB (%Xh...) y no se ha podido mover debajo", d)
            según sin_mover_por
                caso 1: apunta0(": no es del bus 0")
                caso 2: apunta0(": demasiado grande")
                caso 3: apunta0(": no hay hueco libre")
                caso 4: apunta0(": no se deja")
            fin
            apunta0("\n")
        fin
        ; (I2CHID) las zonas sin poner (a 0) a las que se ha dado dirección
        si asignadas <> 0 entonces
            d[0] := (asignada_aparato >> 16) yb 0xFF
            d[1] := (asignada_aparato >> 11) yb 0x1F
            d[2] := (asignada_aparato >> 8) yb 7
            d[3] := asignada_reg
            apunta("pci: la zona del %02X:%02X.%u (registro %02Xh", d)
            d[0] := asignada_cruda
            d[1] := asignada_alta
            d[2] := asignada_a
            d[3] := asignada_tam >> 10
            apunta(": %08Xh, alta %Xh) estaba sin poner: puesta en %08Xh (%u K)", d)
            apunta1("; puestas, %u\n", asignadas)
        fin
        si sin_asignar <> 0 entonces
            d[0] := (sin_asignar_aparato >> 16) yb 0xFF
            d[1] := (sin_asignar_aparato >> 11) yb 0x1F
            d[2] := (sin_asignar_aparato >> 8) yb 7
            apunta("pci: la zona del %02X:%02X.%u está sin poner y no se le ha podido dar dirección", d)
            según sin_asignar_por
                caso 1: apunta0(": no es del bus 0")
                caso 2: apunta0(": demasiado grande")
                caso 3: apunta0(": no hay hueco libre")
                caso 4: apunta0(": no se deja")
            fin
            apunta0("\n")
        fin
        ; (USB) las xHCI que no se han podido poner en marcha, y en qué paso
        c := 0
        mientras c < Xhci.fallidas y c < Xhci.MAX_FALLIDAS hacer
            d[0] := pci_leer(Xhci.fallida_pci[c], 0) yb 0xFFFF
            d[1] := pci_leer(Xhci.fallida_pci[c], 0) >> 16
            d[2] := nat32(Xhci.fallida_paso[c])
            d[3] := Xhci.fallida_dato[c]
            apunta("usb: controladora xHCI %04X:%04X NO se ha podido poner en marcha: %s (%08Xh)\n", d)
            c := c + 1
        fin
        c := 0
        mientras c < Ehci.cuántas hacer
            d[0] := pci_leer(ehcis[c].pci, 0) yb 0xFFFF
            d[1] := pci_leer(ehcis[c].pci, 0) >> 16
            d[2] := ehcis[c].puertos
            apunta("usb: controladora EHCI %04X:%04X, %u puertos", d)
            si ehcis[c].cedidos <> 0 entonces apunta1(" (%u cedidos a las compañeras: aparatos de USB 1.x)", ehcis[c].cedidos) fin
            apunta0("\n")
            c := c + 1
        fin
        c := 0
        mientras c < Uhci.cuántas hacer
            d[0] := pci_leer(uhcis[c].pci, 0) yb 0xFFFF
            d[1] := pci_leer(uhcis[c].pci, 0) >> 16
            d[2] := uhcis[c].puertos
            apunta("usb: controladora UHCI %04X:%04X, %u puertos\n", d)
            c := c + 1
        fin
        para i desde 0 hasta MAX_APARATOS - 1 hacer
            si aparatos[i].usado entonces enseña_aparato(i, "aparato") fin
        fin
        para i desde 1 hasta n_fallos hacer
            d[0] := fallos[i - 1].puerto_raíz
            d[1] := nat32(nombre_velocidad(fallos[i - 1].velocidad))
            d[2] := fallos[i - 1].punto
            apunta("usb: lo que hay en el puerto %u (velocidad %s) no se deja enumerar (paso %u)", d)
            si fallos[i - 1].padre <> SIN_APARATO entonces
                apunta2(": puerto %u del concentrador %u", fallos[i - 1].puerto, fallos[i - 1].padre)
            fin
            ; (UEFI) cómo ha acabado y lo que ha llegado, para saber qué pasa
            si fallos[i - 1].hc_clase = HC_XHCI entonces
                d[0] := fallos[i - 1].código
                d[1] := nat32(nombre_código(fallos[i - 1].código))
                apunta("; código xHCI %u (%s)", d)
            fin
            d[0] := fallos[i - 1].leídos
            d[1] := fallos[i - 1].paquete0
            d[2] := fallos[i - 1].tt >> 8
            d[3] := fallos[i - 1].tt yb 0xFF
            apunta("; dio %d; extremo 0 de %u; traductor %u, puerto %u", d)
            para k desde 0 hasta 7 hacer
                d[0] := fallos[i - 1].datos[k]
                si k = 0 entonces apunta("; lo leído: %02X", d) sino apunta(" %02X", d) fin
            fin
            si fallos[i - 1].luego_bien entonces apunta0("; al reintentarlo, sí") fin
            apunta0("\n")
        fin
    fin

fin Usb.