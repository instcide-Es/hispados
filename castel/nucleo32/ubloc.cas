; =============================================================================
;  ubloc.cas - el «Bloc de notas» del escritorio de Hispa-Pentium (BLOC.BIN en
;  el disco): un programa del anillo 3 con su ventana, para escribir un texto
;  con el teclado español y guardarlo en el disco.
;
;    BLOC [ARCHIVO]      abre ese archivo de texto (NOTAS.TXT si no se dice)
;
;  Se escribe como en cualquier editor: las letras entran donde está el
;  cursor; Intro, Retroceso y Supr; las flechas, Inicio y Fin; un clic pone
;  el cursor. Las líneas largas siguen en la de debajo. Arriba, «Nuevo» y
;  «Guardar» (también F2 y Ctrl+S). El archivo se guarda con los finales de
;  línea del DOS, en la página 437. Si se cierra con cambios sin guardar,
;  avisa (cerrar otra vez sale sin guardar).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo UBloc

    modelo usuario

    importar Llamadas, Textos32, Formato

    constante MÁXIMO = 30000                    ; las letras que caben
    constante BARRA = 34                        ; lo que mide la franja de los botones
    constante PIE = 22                          ; y la de abajo
    constante MARGEN = 6
    constante TECLA_F2 = 0x13C
    constante PAPEL = 0xFFFFFF
    constante TINTA = 0x14294A
    constante SUAVE = 0x5A7396

    variable v: nat32
    variable ancho, alto: ent32                 ; lo de dentro de la ventana
    variable columnas, filas: ent32             ; las letras que caben a lo ancho y a lo alto
    variable letras: arreglo [MÁXIMO + 4] de byte
    variable largo, cursor: nat32
    variable primera: ent32                     ; la primera línea que se ve
    variable nombre: arreglo [64] de byte
    variable rótulo: arreglo [96] de byte
    variable aviso: arreglo [96] de byte
    variable cambiado, cerrando: bool
    variable trozo: arreglo [512] de byte

    ; -------------------------------------------------------------------------
    ;  Dónde cae cada letra (las líneas largas se parten al ancho de la ventana)
    ; -------------------------------------------------------------------------
    ; la línea y la columna (de la pantalla) de la letra número «pos»
    función sitio(pos: nat32, ref lin: ent32, ref col: ent32)
        variable i: nat32
        lin := 0
        col := 0
        i := 0
        mientras i < pos hacer
            si letras[i] = '\n' entonces
                lin := lin + 1
                col := 0
            sino
                col := col + 1
                si col = columnas entonces
                    lin := lin + 1
                    col := 0
                fin
            fin
            i := i + 1
        fin
    fin

    ; la letra que está en esa línea y esa columna (o la última de la línea)
    función letra_en(lin: ent32, col: ent32): nat32
        variable i: nat32
        variable l, c: ent32
        si lin < 0 entonces devolver 0 fin
        l := 0
        c := 0
        i := 0
        mientras i < largo hacer
            si l = lin y c >= col entonces devolver i fin
            si letras[i] = '\n' entonces
                si l = lin entonces devolver i fin
                l := l + 1
                c := 0
            sino
                c := c + 1
                si c = columnas entonces
                    si l = lin entonces devolver i fin
                    l := l + 1
                    c := 0
                fin
            fin
            i := i + 1
        fin
        devolver largo
    fin

    ; -------------------------------------------------------------------------
    ;  Pintar
    ; -------------------------------------------------------------------------
    función botón(x: ent32, t: puntero a byte, arriba: nat32, abajo: nat32)
        redondeado(v, x, 5, 84, 24, 5, arriba, abajo)
        texto_negrita(v, x + (84 - ent32(longitud(t)) * ANCHO_LETRA) div 2, 9, t, PAPEL)
    fin

    función pinta_barra()
        degradado(v, 0, 0, ancho, BARRA, 0xF4F8FE, 0xD3E3F8)
        rectángulo(v, 0, BARRA - 1, ancho, 1, 0x9DBBE4)
        botón(8, "Nuevo", 0x5AA6F4, 0x2468C8)
        botón(98, "Guardar", 0x5CC45E, 0x2A8A3C)
        texto(v, 196, 9, "F2 guarda", SUAVE)
    fin

    función pinta_pie()
        variable lin, col: ent32
        variable d: arreglo [3] de nat32
        degradado(v, 0, alto - PIE, ancho, PIE, 0xE6EFFB, 0xCADDF6)
        rectángulo(v, 0, alto - PIE, ancho, 1, 0x9DBBE4)
        si aviso[0] <> 0 entonces
            texto(v, MARGEN, alto - PIE + 4, aviso, 0xB8441A)
            devolver
        fin
        sitio(cursor, lin, col)
        d[0] := nat32(dirección(nombre[0]))
        d[1] := nat32(lin) + 1
        d[2] := nat32(col) + 1
        si cambiado entonces
            formatear(rótulo, 96, "%s   Lín %u, Col %u   (sin guardar)", d)
        sino
            formatear(rótulo, 96, "%s   Lín %u, Col %u", d)
        fin
        texto(v, MARGEN, alto - PIE + 4, rótulo, TINTA)
    fin

    ; el texto: las líneas que se ven, y el cursor
    función pinta_texto()
        variable i, inicio: nat32
        variable lin, col, clin, ccol: ent32
        ; que el cursor se vea
        sitio(cursor, clin, ccol)
        si clin < primera entonces primera := clin fin
        si clin >= primera + filas entonces primera := clin - filas + 1 fin
        rectángulo(v, 0, BARRA, ancho, alto - BARRA - PIE, PAPEL)
        lin := 0
        col := 0
        inicio := 0
        i := 0
        mientras i <= largo y lin < primera + filas hacer
            si i = largo o letras[i] = '\n' o col = columnas entonces
                ; se acaba una línea de la pantalla: de «inicio» a «i»
                si lin >= primera y i > inicio entonces
                    texto_n(v, MARGEN, BARRA + 4 + (lin - primera) * ALTO_LETRA, dirección(letras[inicio]), i - inicio, TINTA)
                fin
                si i = largo entonces romper fin
                lin := lin + 1
                col := 0
                si letras[i] = '\n' entonces
                    inicio := i + 1
                    i := i + 1
                    seguir
                fin
                inicio := i
            fin
            col := col + 1
            i := i + 1
        fin
        rectángulo(v, MARGEN + ccol * ANCHO_LETRA, BARRA + 4 + (clin - primera) * ALTO_LETRA, 2, ALTO_LETRA, 0x2468C8)
    fin

    función pinta_todo()
        columnas := (ancho - 2 * MARGEN) div ANCHO_LETRA
        filas := (alto - BARRA - PIE - 8) div ALTO_LETRA
        si columnas < 8 entonces columnas := 8 fin
        si filas < 1 entonces filas := 1 fin
        pinta_barra()
        pinta_texto()
        pinta_pie()
    fin

    función pon_título()
        variable d: arreglo [1] de nat32
        d[0] := nat32(dirección(nombre[0]))
        formatear(rótulo, 96, "%s - Bloc de notas", d)
        título(v, rótulo)
    fin

    ; -------------------------------------------------------------------------
    ;  El archivo
    ; -------------------------------------------------------------------------
    función lee()
        variable m, n, i: nat32
        largo := 0
        cursor := 0
        primera := 0
        cambiado := falso
        m := abrir(nombre)
        si es_error(m) entonces devolver fin        ; no está: se empieza en blanco
        n := leer(m, trozo, 512)
        mientras n > 0 y no es_error(n) hacer
            para i desde 0 hasta n - 1 hacer
                si trozo[i] <> '\r' y trozo[i] <> 26 y largo < MÁXIMO entonces
                    letras[largo] := trozo[i]
                    largo := largo + 1
                fin
            fin
            n := leer(m, trozo, 512)
        fin
        cerrar(m)
    fin

    función guarda()
        variable m, i, k, r, total: nat32
        variable d: arreglo [2] de nat32
        m := crear(nombre)
        si es_error(m) entonces
            d[0] := nat32(texto_error(m))
            formatear(aviso, 96, "No se puede guardar: %s.", d)
            escribir("bloc: no puedo guardar ", nombre, ": ", texto_error(m), "\n")
            devolver
        fin
        k := 0
        total := 0
        r := 0
        i := 0
        mientras i <= largo y no es_error(r) hacer
            si i < largo entonces
                si letras[i] = '\n' entonces
                    trozo[k] := '\r'
                    k := k + 1
                fin
                trozo[k] := letras[i]
                k := k + 1
            fin
            si k >= 500 o (i = largo y k > 0) entonces
                r := escribir_archivo(m, trozo, k)
                si no es_error(r) entonces
                    si r < k entonces r := DISCO_LLENO sino total := total + r fin
                fin
                k := 0
            fin
            i := i + 1
        fin
        cerrar(m)
        si es_error(r) entonces
            d[0] := nat32(texto_error(r))
            formatear(aviso, 96, "No se ha guardado entero: %s.", d)
            devolver
        fin
        cambiado := falso
        cerrando := falso
        d[0] := nat32(dirección(nombre[0]))
        d[1] := total
        formatear(aviso, 96, "Guardado en %s (%u octetos).", d)
        escribir("bloc: guardado ", nombre, ", ", total, " octetos\n")
    fin

    ; -------------------------------------------------------------------------
    ;  Escribir
    ; -------------------------------------------------------------------------
    función mete(c: byte)
        variable i: nat32
        si largo >= MÁXIMO entonces devolver fin
        i := largo
        mientras i > cursor hacer
            letras[i] := letras[i - 1]
            i := i - 1
        fin
        letras[cursor] := c
        largo := largo + 1
        cursor := cursor + 1
        cambiado := cierto
    fin

    función quita(pos: nat32)
        variable i: nat32
        si pos >= largo entonces devolver fin
        para i desde pos + 1 hasta largo - 1 hacer letras[i - 1] := letras[i] fin
        largo := largo - 1
        cambiado := cierto
    fin

    función tecla_pulsada(c: nat32)
        variable lin, col: ent32
        aviso[0] := 0
        cerrando := falso
        si c = TECLA_F2 o c = 19 entonces
            guarda()
        sino si c = '\n' o (c >= ' ' y c < TECLA_ESPECIAL) entonces
            mete(c)
        sino si c = '\t' entonces
            mete(' ')
            mete(' ')
            mete(' ')
            mete(' ')
        sino si c = 8 entonces
            si cursor > 0 entonces
                cursor := cursor - 1
                quita(cursor)
            fin
        sino si c = TECLA_SUPR entonces
            quita(cursor)
        sino si c = TECLA_IZQUIERDA entonces
            si cursor > 0 entonces cursor := cursor - 1 fin
        sino si c = TECLA_DERECHA entonces
            si cursor < largo entonces cursor := cursor + 1 fin
        sino si c = TECLA_ARRIBA entonces
            sitio(cursor, lin, col)
            si lin > 0 entonces cursor := letra_en(lin - 1, col) fin
        sino si c = TECLA_ABAJO entonces
            sitio(cursor, lin, col)
            cursor := letra_en(lin + 1, col)
        sino si c = TECLA_INICIO entonces
            sitio(cursor, lin, col)
            cursor := letra_en(lin, 0)
        sino si c = TECLA_FIN entonces
            sitio(cursor, lin, col)
            cursor := letra_en(lin, columnas)
        fin
        pinta_texto()
        pinta_pie()
    fin

    función clic(x: ent32, yy: ent32)
        aviso[0] := 0
        si yy < BARRA entonces
            si x >= 8 y x < 92 entonces
                ; «Nuevo»: en blanco (el archivo no se toca hasta guardar)
                largo := 0
                cursor := 0
                primera := 0
                cambiado := cierto
            sino si x >= 98 y x < 182 entonces
                guarda()
            fin
        sino si yy < alto - PIE entonces
            cursor := letra_en(primera + (yy - BARRA - 4) div ALTO_LETRA, (x - MARGEN + 3) div ANCHO_LETRA)
        fin
        pinta_texto()
        pinta_pie()
    fin

    función principal(): byte
        variable s: Suceso
        variable n: nat32
        argumentos(nombre, 64)
        n := longitud(nombre)
        mientras n > 0 y es_espacio(nombre[n - 1]) hacer
            n := n - 1
            nombre[n] := 0
        fin
        si n = 0 entonces Textos32.copiar(nombre, "NOTAS.TXT") fin
        a_mayúsculas(nombre)
        ancho := 500
        alto := 340
        v := ventana("Bloc de notas", nat32(ancho), nat32(alto))
        si es_error(v) entonces
            escribir("bloc: no hay escritorio (o no hay memoria para la ventana)\n")
            devolver 1
        fin
        pon_título()
        columnas := (ancho - 2 * MARGEN) div ANCHO_LETRA
        lee()
        pinta_todo()
        mientras suceso(v, s, cierto) hacer
            si s.clase = EV_TECLA entonces
                tecla_pulsada(s.a)
            sino si s.clase = EV_RATÓN_BAJA y s.c yb BOTÓN_IZQUIERDO <> 0 entonces
                clic(ent32(s.a), ent32(s.b))
            sino si s.clase = EV_TAMAÑO entonces
                ancho := ent32(s.a)
                alto := ent32(s.b)
                pinta_todo()
            sino si s.clase = EV_CERRAR entonces
                si no cambiado o cerrando entonces devolver 0 fin
                cerrando := cierto
                Textos32.copiar(aviso, "Hay cambios sin guardar: F2 guarda; cerrar otra vez, sale.")
                pinta_pie()
            fin
        fin
        devolver 0
    fin

fin UBloc.
