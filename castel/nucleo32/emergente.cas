; =============================================================================
;  emergente.cas - los menús emergentes de Hispa-Pentium: el que sale con el
;  botón secundario del ratón (en el tapiz, en el título de una ventana, en
;  su botón de la barra de tareas, dentro de un programa) y el que cuelga de
;  la barra de menús de una ventana (Archivo, Edición, Ayuda).
;
;  Solo hay uno abierto a la vez. Es una ventana del núcleo, sin marco y por
;  delante de todo, con una opción por renglón: la que está bajo el ratón se
;  resalta; un clic la elige; las flechas, Intro y Esc también valen; un clic
;  fuera lo cierra. Las opciones se dan en un texto, separadas por «|»; una
;  que sea «-» es una raya; «inactivas» dice (un bit por opción, contando las
;  rayas) las que salen en gris y no se pueden elegir.
;
;  Lo pide el escritorio (para él: «destino» 0; el resultado queda en
;  hay_resultado, resultado y resultado_etiqueta) o un programa, por la
;  llamada al sistema 39 (para una ventana suya: al cerrarse el menú le llega
;  el suceso EV_MENÚ, con la opción elegida, o SIN_ELEGIR, y la etiqueta que
;  dio). Pedir otra vez el mismo menú que está abierto lo cierra.
;
;  Quien atiende sus sucesos es la tarea del escritorio (atiende_emergente,
;  cada pulso); todo va con un cerrojo, porque los programas lo abren a la vez.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Emergente

    importar Tareas, Grafico, Letra, Video, Ventanas, Consola

    público constante MAX_OPCIONES = 12
    constante MAX_TEXTO = 256
    constante ALTO_OPCIÓN = 24
    constante ALTO_RAYA = 9
    constante ARRIBA_LIBRE = 5                  ; lo que queda por encima de la primera
    constante ABAJO_LIBRE = 4
    constante TINTA = 0x14294A
    constante TINTA_GRIS = 0x9AAAC0
    constante BLANCO = 0xFFFFFF

    público variable abierto: bool
    público variable hay_resultado: bool        ; (para el escritorio) se ha cerrado un menú suyo
    público variable resultado: nat32           ; la opción elegida (desde 0), o SIN_ELEGIR
    público variable resultado_etiqueta: nat32

    variable v: nat32                           ; su ventana
    variable destino, etiqueta: nat32
    variable textos: arreglo [MAX_TEXTO] de byte
    variable inicio, largo: arreglo [MAX_OPCIONES] de nat32
    variable arriba: arreglo [MAX_OPCIONES] de ent32    ; dónde empieza cada una, de arriba abajo
    variable n: nat32
    variable inactivas: nat32
    variable elegida: ent32 = -1
    variable ancho, alto: ent32
    variable cerrojo: Cerrojo

    función es_raya(i: nat32): bool
        devolver largo[i] = 1 y textos[inicio[i]] = '-'
    fin

    función se_puede(i: ent32): bool
        si i < 0 o i >= ent32(n) entonces devolver falso fin
        devolver no es_raya(nat32(i)) y (inactivas >> nat32(i)) yb 1 = 0
    fin

    función alto_de(i: nat32): ent32
        si es_raya(i) entonces devolver ALTO_RAYA fin
        devolver ALTO_OPCIÓN
    fin

    función pinta()
        variable l: puntero a Lienzo
        variable i: nat32
        variable c: nat32
        l := lienzo_de(v)
        si l = nulo entonces devolver fin
        redondeado(valor(l), 0, 0, ancho, alto, 8, 0x1A56AC, 0x1A56AC, ARRIBA)
        redondeado(valor(l), 1, 1, ancho - 2, alto - 2, 7, BLANCO, 0xF1F6FD, ARRIBA)
        i := 0
        mientras i < n hacer
            si es_raya(i) entonces
                rectángulo(valor(l), 8, arriba[i] + 4, ancho - 16, 1, 0xB9CDE8)
            sino
                c := TINTA
                si no se_puede(ent32(i)) entonces
                    c := TINTA_GRIS
                sino si ent32(i) = elegida entonces
                    redondeado(valor(l), 3, arriba[i] + 1, ancho - 6, ALTO_OPCIÓN - 2, 4, 0x3F86E0, 0x2F74D0, TODAS)
                    c := BLANCO
                fin
                texto_n(valor(l), 14, arriba[i] + 4, dirección(textos[inicio[i]]), largo[i], c)
            fin
            i := i + 1
        fin
        repintada(v, 0, 0, ancho, alto)
    fin

    ; la opción que está a esa altura; -1 si no hay (o es una raya)
    función opción_en(x: ent32, yy: ent32): ent32
        variable i: nat32
        si x < 0 o x >= ancho entonces devolver -1 fin
        i := 0
        mientras i < n hacer
            si yy >= arriba[i] y yy < arriba[i] + alto_de(i) entonces
                si es_raya(i) entonces devolver -1 fin
                devolver ent32(i)
            fin
            i := i + 1
        fin
        devolver -1
    fin

    ; cierra el menú y dice a quien lo pidió lo que se ha elegido
    función cierra(opción: nat32)
        si no abierto entonces devolver fin
        abierto := falso
        si emergente = v entonces emergente := 0 fin
        si teclas_a = v entonces teclas_a := 0 fin
        cerrar_ventana(v, 0)
        v := 0
        si destino = 0 entonces
            resultado := opción
            resultado_etiqueta := etiqueta
            hay_resultado := cierto
        sino
            avisar(destino, EV_MENÚ, opción, etiqueta, 0)
        fin
    fin

    ; cierra el menú que haya abierto, sin elegir nada
    público función cerrar_emergente()
        tomar(cerrojo)
        cierra(SIN_ELEGIR)
        soltar(cerrojo)
    fin

    ; abre un menú con esas opciones, con su esquina en ese punto de la
    ; pantalla (si no cabe, se corre hacia dentro; por abajo, sale hacia
    ; arriba). Falso si no se puede (no hay opciones, no quedan ventanas).
    público función abrir_emergente(x: ent32, yy: ent32, opciones: puntero a byte, grises: nat32, para_quién: nat32, marca: nat32): bool
        variable i, k: nat32
        variable más_larga: nat32
        tomar(cerrojo)
        si abierto entonces
            ; el mismo otra vez (el rótulo de una barra de menús): se cierra
            si para_quién <> 0 y para_quién = destino y marca = etiqueta entonces
                cierra(SIN_ELEGIR)
                soltar(cerrojo)
                devolver cierto
            fin
            cierra(SIN_ELEGIR)
        fin
        ; las opciones: se copian, y se apunta dónde empieza cada una
        n := 0
        i := 0
        k := 0
        más_larga := 0
        inicio[0] := 0
        mientras i < MAX_TEXTO - 1 y n < MAX_OPCIONES hacer
            si opciones[i] = '|' o opciones[i] = 0 entonces
                largo[n] := k - inicio[n]
                si largo[n] > más_larga entonces más_larga := largo[n] fin
                si largo[n] > 0 entonces n := n + 1 fin
                si opciones[i] = 0 entonces romper fin
                si n < MAX_OPCIONES entonces inicio[n] := k fin
            sino
                textos[k] := opciones[i]
                k := k + 1
            fin
            i := i + 1
        fin
        si n = 0 o no hay_pantalla entonces
            soltar(cerrojo)
            devolver falso
        fin
        ancho := ent32(más_larga) * ANCHO_LETRA + 34
        si ancho < 130 entonces ancho := 130 fin
        alto := ARRIBA_LIBRE
        i := 0
        mientras i < n hacer
            arriba[i] := alto
            alto := alto + alto_de(i)
            i := i + 1
        fin
        alto := alto + ABAJO_LIBRE
        si x + ancho + 6 > pantalla.ancho entonces x := pantalla.ancho - ancho - 6 fin
        si yy + alto + 6 > pantalla.alto entonces yy := yy - alto fin
        si x < 0 entonces x := 0 fin
        si yy < 0 entonces yy := 0 fin
        v := crear_ventana("emergente", x, yy, ancho, alto, SIN_MARCO ob ENCIMA ob REDONDA, 0)
        si v = 0 entonces
            soltar(cerrojo)
            devolver falso
        fin
        inactivas := grises
        destino := para_quién
        etiqueta := marca
        elegida := -1
        abierto := cierto
        pinta()
        emergente := v
        teclas_a := v
        soltar(cerrojo)
        devolver cierto
    fin

    ; la opción siguiente (o la de antes) que se puede elegir
    función anda(salto: ent32)
        variable i, vueltas: ent32
        i := elegida
        vueltas := 0
        mientras vueltas < ent32(n) hacer
            i := i + salto
            si i < 0 entonces i := ent32(n) - 1 fin
            si i >= ent32(n) entonces i := 0 fin
            si se_puede(i) entonces
                elegida := i
                pinta()
                devolver
            fin
            vueltas := vueltas + 1
        fin
    fin

    ; los sucesos del menú abierto: lo llama la tarea del escritorio, cada pulso
    público función atiende_emergente()
        variable e: Evento
        variable k: ent32
        si no abierto entonces devolver fin
        tomar(cerrojo)
        ; si la ventana que lo pidió ya no está, sobra
        si abierto y destino <> 0 y marcas_de(destino) = 0xFFFFFFFF entonces cierra(SIN_ELEGIR) fin
        mientras abierto y saca_evento(v, 0, e) hacer
            según e.clase
                caso EV_FUERA:
                    cierra(SIN_ELEGIR)
                caso EV_SALE:
                    si elegida >= 0 entonces
                        elegida := -1
                        pinta()
                    fin
                caso EV_RATÓN_MUEVE:
                    k := opción_en(ent32(e.a), ent32(e.b))
                    si k >= 0 y no se_puede(k) entonces k := -1 fin
                    si k <> elegida entonces
                        elegida := k
                        pinta()
                    fin
                caso EV_RATÓN_BAJA:
                    k := opción_en(ent32(e.a), ent32(e.b))
                    si se_puede(k) entonces cierra(nat32(k)) fin
                caso EV_TECLA:
                    si e.a = 27 entonces
                        cierra(SIN_ELEGIR)
                    sino si e.a = TECLA_ABAJO entonces
                        anda(1)
                    sino si e.a = TECLA_ARRIBA entonces
                        si elegida < 0 entonces elegida := 0 fin
                        anda(-1)
                    sino si e.a = '\n' y se_puede(elegida) entonces
                        cierra(nat32(elegida))
                    fin
            fin
        fin
        soltar(cerrojo)
    fin

fin Emergente.
