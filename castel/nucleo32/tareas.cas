; =============================================================================
;  tareas.cas - las tareas del núcleo de Hispa-Pentium: varias a la vez, con
;  el reloj repartiendo el procesador (multitarea apropiativa: a cada tic, si
;  hay otra lista, le toca a ella).
;
;  Cada tarea tiene su ficha y su pila del núcleo. Lo que hay en la pila de
;  una tarea que no corre es lo que dejó la interrupción que la paró: lo que
;  apila el procesador (EIP, CS, EFLAGS y, si venía del anillo 3, ESP y SS) y
;  lo que guarda «pushad». La ficha guarda dónde empieza eso (el «marco»).
;  Cambiar de tarea es, entonces, cambiar de marco: las dos funciones de
;  interrupción que cambian (el reloj y la 0x30, la que llama ceder()) ponen
;  en EBP el marco de la siguiente, y su salida (popad e iretd) la reanuda.
;  Una tarea nueva lleva su marco hecho a mano, como si la hubieran parado
;  justo al empezar.
;
;  Las listas (la cola de las listas para correr, las dormidas) van con un
;  puntero «sig» en la ficha. Si no hay nadie listo, corre la tarea ociosa
;  (un «hlt» detrás de otro).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Tareas

    importar Cpu, Monton, Paginas, Formato, Pozo

    público constante MAX_TAREAS = 32           ; (JUEGOS) 32: los hilos de los programas de Windows también son tareas
    público constante PILA = 8192               ; la pila del núcleo de cada tarea

    ; los estados de una tarea
    público constante LIBRE = 0                 ; la ficha no se usa
    público constante LISTA = 1                 ; en la cola, esperando su turno
    público constante CORRIENDO = 2
    público constante DORMIDA = 3               ; hasta un tic
    público constante ESPERANDO = 4             ; hasta que alguien la despierte
    público constante ACABADA = 5               ; ha terminado; falta recogerla
    público constante EN_CERROJO = 6            ; en la cola de un cerrojo, hasta que se lo den

    público constante MAX_CARPETA = 80          ; lo que cabe de la carpeta de trabajo de una tarea
    público constante SIN_SALIDA = 0xFFFFFFFF   ; la tarea escribe en la pantalla
    público constante CORTADA = 254             ; el código de una tarea acabada con Ctrl+C

    público tipo Tarea = estructura
        marco: nat32                            ; dónde quedó su marco (en su pila)
        estado: nat32
        id: nat32
        nombre: puntero a byte
        pila: puntero a byte                    ; su pila del núcleo (del montón)
        pila_tope: nat32
        cr3: nat32                              ; su directorio de páginas
        despertar: nat32                        ; el tic en que despierta (si duerme)
        sig: puntero a Tarea                    ; la siguiente de su lista
        esperador: puntero a Tarea              ; quien espera a que acabe
        código: nat32                           ; con lo que ha acabado
        turnos: nat32                           ; las veces que ha entrado a correr
        tics_usados: nat32                      ; los tics que la han pillado corriendo
        usuario: bool                           ; si es del anillo 3
        padre: nat32                            ; el número de la tarea que la hizo (0: huérfana)
        args: puntero a byte                    ; sus argumentos (del montón), o nulo
        quiebre_inicio, quiebre: nat32          ; del anillo 3: dónde acaba su memoria (sbrk)
        esp_usuario: nat32                      ; por dónde iba su pila al entrar en la llamada al sistema
        nombre_propio: arreglo [16] de byte     ; donde se guarda su nombre
        carpeta: arreglo [MAX_CARPETA] de byte  ; su carpeta de trabajo («»: la raíz; si no, «\UNA\OTRA»)
        unidad: nat32                           ; y en qué unidad (0: la del sistema; si no, su número más uno: unidades.cas)
        salida, salida_serie: nat32             ; el archivo al que va lo que escribe (SIN_SALIDA: a la pantalla)
        salida_cr: bool                         ; lo último que escribió ahí fue un retorno de carro
        aguanta: bool                           ; atiende ella Ctrl+C (un intérprete de órdenes): no se la acaba
        matar: bool                             ; hay que acabarla (Ctrl+C) en cuanto vuelva al anillo 3
        corte: bool                             ; se ha pulsado Ctrl+C (para las que lo atienden)
        terminal: nat32                         ; el terminal por el que escribe y lee (terminal.cas), o 0: la consola
        x87: arreglo [108] de byte              ; (NAVEGADOR) su coma flotante, guardada (fnsave) mientras corre otra (sin FXSAVE; con él, en fx_zona)
        x87_usado: bool                         ; (NAVEGADOR) la ha usado alguna vez
        ; (PROTEGE) quién es, para lo que puede tocar del sistema (permisos.cas):
        ; lo pone el núcleo al cargarla, por la ruta de la que la carga (la
        ; carpeta del sistema), nunca por su nombre
        sello: nat32                            ; el programa del sistema que es (Permisos.SELLO_...; 0: uno normal)
        servicio: bool                          ; es uno de los servicios (RED.BIN, TLS.BIN, ACPI.BIN...)
        admin: bool                             ; el modo administrador (la orden ADMIN, confirmado en la pantalla)
        ; (USUARIOS) de quién es (cuentas.cas): el número del usuario (0: del
        ; sistema, lo que pone en marcha el núcleo al arrancar y sus
        ; servicios); la hereda de quien la lanza, y el escritorio da la del
        ; que ha entrado. Lo dice qué carpeta de \USUARIOS puede tocar y si
        ; puede instalar, poner la hora o pedir el modo administrador
        uid: nat32
        uid_hijo: nat32                         ; (SSHD) el que tendrá el próximo programa que lance (0: el suyo)
        remota: bool                            ; (SSHD) de una sesión de SSH (y lo que lance): no la acaba cerrar la sesión de la pantalla
        ; (JUEGOS) los hilos de los programas de Windows (win32.cas): un hilo
        ; es una tarea más del mismo espacio de direcciones, con el mismo
        ; número (id) que su proceso, para que sus archivos, sus ventanas, su
        ; sonido y su red sean los del proceso; su número de hilo, aparte
        líder: puntero a Tarea                  ; la tarea del proceso del que es hilo (nulo: no es un hilo)
        hilo_id: nat32                          ; su número de hilo (el de la tarea, si no es un hilo)
        teb: nat32                              ; dónde está su TEB, de verdad (FS, 0x43); 0: no se toca
        despachador: nat32                      ; (SEH) adónde se le mandan sus excepciones (del programa); 0: se acaba
        espera_dir: nat32                       ; la dirección a la que espera (la 184), mientras espera
        salir_pedido: bool                      ; uno de sus hilos ha pedido acabar el proceso...
        salir_con: nat32                        ; ...con este código
    fin

    público tipo Cola = estructura
        primera, última: puntero a Tarea
    fin

    ; un cerrojo: lo tiene una sola tarea a la vez; las demás que lo piden
    ; esperan en su cola (sin tapar las interrupciones mientras tanto), y
    ; quien lo suelta se lo da a la primera. La misma tarea lo puede tomar
    ; varias veces (y lo suelta otras tantas).
    público tipo Cerrojo = estructura
        dueño: puntero a Tarea
        veces: nat32
        cola: Cola
    fin

    público variable tareas: arreglo [MAX_TAREAS] de Tarea
    público variable actual: puntero a Tarea
    variable ociosa: puntero a Tarea
    variable listas: Cola
    variable dormidas: Cola
    variable siguiente_id: nat32
    público variable tics: nat32
    ; (UEFI) si el tic lo da el temporizador del APIC local (relojhpet.cas: sin
    ; 8254 ni HPET), también a él hay que decirle «fin de interrupción»: 1, por
    ; su registro MSR (x2APIC); si no es 0, la dirección de su registro EOI
    público variable eoi_apic: nat32
    público variable cambios: nat32             ; las veces que ha cambiado de tarea
    ; (NAVEGADOR, 21/11) la coma flotante (el x87): la de quién está ahora en
    ; el procesador. Cada programa tiene la suya (el Navegador y QuickJS
    ; cuentan con doble precisión, HVPRUN con lo suyo) y lo que no usa coma
    ; flotante (casi todo, y el núcleo) no paga nada. (Hasta la 0.8.10, al
    ; cambiar de tarea no se guardaba: CR0.TS y la excepción 7 lo hacían
    ; cuando otra la usaba. Desde la 0.8.12, abajo: se guarda al salir.)
    público variable dueño_x87: puntero a Tarea
    ; (TERMO-FUERTE, 0.8.12) el SSE (de Pentium III en adelante; SSE2, de
    ; Pentium 4): si el procesador tiene FXSAVE (CPUID 1, EDX bit 24), se
    ; encienden CR4.OSFXSR y, con SSE, CR4.OSXMMEXCPT, y la coma flotante de
    ; cada tarea es lo que guarda FXSAVE (512 octetos, alineados a 16: el x87,
    ; el MMX, los 8 XMM y el MXCSR); sin FXSAVE (el Pentium y el Pentium MMX),
    ; lo de siempre, fnsave y frstor (108 octetos, en «x87»). Ya NO se deja en
    ; el procesador la de una tarea mientras corre otra (lo de la 0.8.3 era
    ; «perezoso»: hasta que otra la usaba): al cambiar de tarea, la de la que
    ; sale se guarda y, si la que entra tiene la suya, se pone; si no, se
    ; pone una limpia (o se queda como la deja fnsave, que la reinicia) y
    ; CR0.TS avisa (la excepción 7) cuando la use por primera vez. Así un
    ; programa nunca puede leer los registros de otro, ni de verdad ni por
    ; ejecución especulativa (LazyFP, CVE-2018-3665), y lo que no usa coma
    ; flotante (el núcleo, casi todos los servicios) sigue sin pagar nada.
    ; AVX no: necesita XSAVE (CR4.OSXSAVE, XCR0) y más estado (YMM): para
    ; después (docs/PENTIUM.md)
    público variable sse: nat32                 ; 1: FXSAVE; 2: SSE encendido; 4: SSE2; 0: solo x87 (fnsave)
    público constante SSE_FXSR = 1
    público constante SSE_SSE = 2
    público constante SSE_SSE2 = 4
    variable fx_zona: arreglo [(MAX_TAREAS + 1) * 512 + 16] de byte   ; la de cada tarea y, al final, la limpia
    variable fx_base: nat32                     ; fx_zona, alineada a 16
    variable teb_puesta: nat32                  ; (JUEGOS) la TEB del descriptor 0x43 (cpu.cas, pon_teb)
    variable pantalla: puntero a nat16 = puntero(0xB8000)
    público variable sin_segundos: bool         ; no se enseñan los segundos (la pantalla es de un programa: INSTALAR)
    ; la función (sin argumentos) que acaba la tarea que corre cuando se la
    ; ha cortado con Ctrl+C: la pone usuario.cas (cierra sus archivos y la
    ; termina); se la llama por su dirección
    público variable al_cortar: nat32

    ; -------------------------------------------------------------------------
    ;  Las colas
    ; -------------------------------------------------------------------------
    función meter(ref c: Cola, t: puntero a Tarea)
        t.sig := nulo
        si c.última = nulo entonces
            c.primera := t
        sino
            c.última.sig := t
        fin
        c.última := t
    fin

    función sacar(ref c: Cola): puntero a Tarea
        variable t: puntero a Tarea
        t := c.primera
        si t <> nulo entonces
            c.primera := t.sig
            si c.primera = nulo entonces c.última := nulo fin
            t.sig := nulo
        fin
        devolver t
    fin

    función quitar(ref c: Cola, t: puntero a Tarea)
        variable p, antes: puntero a Tarea
        antes := nulo
        p := c.primera
        mientras p <> nulo y p <> t hacer
            antes := p
            p := p.sig
        fin
        si p = nulo entonces devolver fin
        si antes = nulo entonces c.primera := t.sig sino antes.sig := t.sig fin
        si c.última = t entonces c.última := antes fin
        t.sig := nulo
    fin

    ; -------------------------------------------------------------------------
    ;  Los cerrojos
    ; -------------------------------------------------------------------------
    ; toma el cerrojo; si lo tiene otra tarea, espera a que se lo den. (Antes
    ; de que haya tareas no hace nada: no hay con quién pelearse.)
    público función tomar(ref c: Cerrojo)
        variable b: nat32
        si actual = nulo entonces devolver fin
        b := sin_interrupciones()
        si c.dueño = nulo entonces
            c.dueño := actual
            c.veces := 1
        sino si c.dueño = actual entonces
            c.veces := c.veces + 1
        sino
            actual.estado := EN_CERROJO
            meter(c.cola, actual)
            ceder()                             ; al volver, quien lo soltó ya me lo ha dado
        fin
        reponer(b)
    fin

    ; suelta el cerrojo: si hay quien lo espera, pasa a ser suyo y entra en
    ; la cola de las listas
    público función soltar(ref c: Cerrojo)
        variable b: nat32
        variable t: puntero a Tarea
        si actual = nulo o c.dueño <> actual entonces devolver fin
        b := sin_interrupciones()
        c.veces := c.veces - 1
        si c.veces = 0 entonces
            t := sacar(c.cola)
            c.dueño := t
            si t <> nulo entonces
                c.veces := 1
                t.estado := LISTA
                meter(listas, t)
            fin
        fin
        reponer(b)
    fin

    ; -------------------------------------------------------------------------
    ;  El cambio de tarea
    ; -------------------------------------------------------------------------
    ; guarda el marco de la que corre, la deja en la cola si sigue lista, y
    ; elige la siguiente: su pila del anillo 0 (para el TSS), su directorio y
    ; su marco, que es lo que devuelve. (Con las interrupciones tapadas.)
    función cambiar(marco: nat32): nat32
        variable t: puntero a Tarea
        actual.marco := marco
        si actual.estado = CORRIENDO entonces
            actual.estado := LISTA
            si actual <> ociosa entonces meter(listas, actual) fin
        fin
        t := sacar(listas)
        si t = nulo entonces t := ociosa fin
        t.estado := CORRIENDO
        t.turnos := t.turnos + 1
        ; ([WIN32] el coprocesador de cada programa, también los de Windows: el
        ; x87 de cada tarea de la 0.8.3, con CR0.TS, más abajo)
        si t <> actual entonces cambios := cambios + 1 fin
        actual := t
        ; (NAVEGADOR) el x87 (TERMO-FUERTE: y el SSE): el de la que sale, guardado; el de la que entra, puesto
        cambia_coma(t)
        pon_pila_núcleo(t.pila_tope)
        si leer_cr3() <> t.cr3 entonces poner_cr3(t.cr3) fin
        ; (JUEGOS) la TEB de cada hilo de Windows (FS): su descriptor, si cambia
        si t.teb <> 0 y t.teb <> teb_puesta entonces
            pon_teb(t.teb)
            teb_puesta := t.teb
        fin
        devolver t.marco
    fin

    ; (NAVEGADOR) CR0.TS: con ella encendida, la primera instrucción de coma
    ; flotante da la excepción 7; clts la apaga
    función pon_ts()
        ensamblador
            mov eax, cr0
            or eax, 8
            mov cr0, eax
        fin
    fin

    función quita_ts()
        ensamblador
            db 0x0F, 0x06                       ; clts
        fin
    fin

    ; (TERMO-FUERTE) dónde guarda FXSAVE la coma flotante de t (512 octetos,
    ; alineados a 16: los de su ficha en fx_zona); con t nulo, la limpia
    función zona_fx(t: puntero a Tarea): nat32
        si t = nulo entonces devolver fx_base + MAX_TAREAS * 512 fin
        devolver fx_base + ((nat32(t) - nat32(dirección(tareas[0]))) div tamaño(Tarea)) * 512
    fin

    ; (TERMO-FUERTE) la coma flotante del procesador, a la ficha de t (con
    ; CR0.TS apagada): fxsave o, sin él, fnsave (que además la reinicia)
    función guarda_coma(t: puntero a Tarea)
        variable p: nat32
        si sse yb SSE_FXSR <> 0 entonces
            p := zona_fx(t)
            ensamblador
                mov eax, {p}
                db 0x0F, 0xAE, 0x00             ; fxsave [eax]
            fin
        sino
            p := nat32(dirección(t.x87[0]))
            ensamblador
                mov eax, {p}
                db 0xDD, 0x30                   ; fnsave [eax]
            fin
        fin
    fin

    ; (TERMO-FUERTE) la de t, al procesador (t nulo: la limpia; sin FXSAVE, fninit)
    función repone_coma(t: puntero a Tarea)
        variable p: nat32
        si sse yb SSE_FXSR <> 0 entonces
            p := zona_fx(t)
            ensamblador
                mov eax, {p}
                db 0x0F, 0xAE, 0x08             ; fxrstor [eax]
            fin
        sino si t = nulo entonces
            ensamblador
                db 0xDB, 0xE3                   ; fninit
            fin
        sino
            p := nat32(dirección(t.x87[0]))
            ensamblador
                mov eax, {p}
                db 0xDD, 0x20                   ; frstor [eax]
            fin
        fin
    fin

    ; (TERMO-FUERTE) al cambiar a t (con las interrupciones tapadas): la de
    ; la que estaba en el procesador se guarda en su ficha; si t ya ha usado
    ; la coma flotante, se pone la suya; si no, se deja una limpia (que no
    ; quede nada de la otra) y CR0.TS, para que la excepción 7 se la dé
    ; cuando la use
    función cambia_coma(t: puntero a Tarea)
        si t <> dueño_x87 entonces
            si dueño_x87 <> nulo entonces
                quita_ts()
                guarda_coma(dueño_x87)
                dueño_x87 := nulo
                si no t.x87_usado y sse yb SSE_FXSR <> 0 entonces repone_coma(nulo) fin
            fin
            si t.x87_usado entonces
                quita_ts()
                repone_coma(t)
                dueño_x87 := t
            fin
        fin
        si t = dueño_x87 entonces quita_ts() sino pon_ts() fin
    fin

    ; (NAVEGADOR) la excepción 7: la tarea que corre usa la coma flotante por
    ; primera vez (TERMO-FUERTE: al cambiar de tarea ya se pone la suya, si la
    ; tiene; esto queda por si acaso): si la del procesador es de otra, se
    ; guarda; se pone la suya o, la primera vez, una a estrenar (la limpia:
    ; el x87 como tras fninit, los XMM a 0 y MXCSR = 1F80h). Con las
    ; interrupciones tapadas (puerta del núcleo)
    interrupción función sin_x87()
        quita_ts()
        si dueño_x87 = actual entonces devolver fin
        si dueño_x87 <> nulo entonces guarda_coma(dueño_x87) fin
        si actual.x87_usado entonces
            repone_coma(actual)
        sino
            repone_coma(nulo)
            actual.x87_usado := cierto
        fin
        dueño_x87 := actual
    fin

    ; (TERMO-FUERTE) al arrancar (con CR0.TS apagada): ¿hay CPUID, FXSAVE,
    ; SSE y SSE2? Con FXSAVE, CR4.OSFXSR (y CR4.OSXMMEXCPT con SSE) y la
    ; plantilla limpia (fninit, fxsave, MXCSR = 1F80h y los registros a 0)
    función prepara_sse()
        variable ed, c4, p, i: nat32
        variable f: puntero a nat32
        sse := 0
        fx_base := (nat32(dirección(fx_zona[0])) + 15) yb 0xFFFFFFF0
        ed := 0
        ensamblador
            pushfd
            pop eax
            mov ecx, eax
            xor eax, 0x200000
            push eax
            popfd
            pushfd
            pop eax
            push ecx
            popfd
            xor eax, ecx
            and eax, 0x200000
            jz .sin_cpuid
            push ebx
            xor eax, eax
            xor ecx, ecx
            db 0x0F, 0xA2                       ; cpuid
            pop ebx
            cmp eax, 1
            jb .sin_cpuid
            push ebx
            mov eax, 1
            xor ecx, ecx
            db 0x0F, 0xA2                       ; cpuid
            pop ebx
            mov {ed}, edx
        .sin_cpuid:
        fin
        si ed yb 0x1000000 = 0 entonces devolver fin       ; sin FXSAVE: fnsave
        sse := SSE_FXSR
        c4 := 0x200                                         ; OSFXSR
        si ed yb 0x2000000 <> 0 entonces
            sse := sse ob SSE_SSE
            c4 := 0x600                                     ; y OSXMMEXCPT
            si ed yb 0x4000000 <> 0 entonces sse := sse ob SSE_SSE2 fin
        fin
        p := zona_fx(nulo)
        ensamblador
            mov ecx, {c4}
            db 0x0F, 0x20, 0xE0                 ; mov eax, cr4
            or eax, ecx
            db 0x0F, 0x22, 0xE0                 ; mov cr4, eax
            db 0xDB, 0xE3                       ; fninit
            mov eax, {p}
            db 0x0F, 0xAE, 0x00                 ; fxsave [eax]
        fin
        ; lo de después de FIP/FDP (los registros ST/MM y XMM y lo reservado), a 0
        f := puntero(p)
        para i desde 8 hasta 127 hacer f[i] := 0 fin
        si sse yb SSE_SSE <> 0 entonces f[6] := 0x1F80 fin  ; MXCSR: todo enmascarado, redondeo al más cercano
        repone_coma(nulo)
    fin

    ; el reloj: cuenta el tic, despierta a las dormidas a las que les toca,
    ; enseña los segundos arriba a la derecha y cambia de tarea
    interrupción función reloj()
        variable marco, s, i: nat32
        variable t, sig: puntero a Tarea
        variable ep: puntero a nat32            ; (UEFI)
        tics := tics + 1
        ruido(R_RELOJ, tics)                    ; (USUARIOS) el pozo del azar: el momento exacto
        si tics mod HZ = 0 y no sin_segundos entonces
            s := tics div HZ
            para i desde 0 hasta 5 hacer
                pantalla[79 - i] := 0x1F00 ob (s mod 10 + '0')
                s := s div 10
            fin
        fin
        sacar_puerto(PIC1, FIN_INT)
        si eoi_apic = 1 entonces                ; (UEFI)
            ensamblador
                mov ecx, 0x80B
                xor eax, eax
                xor edx, edx
                db 0x0F, 0x30                   ; wrmsr
            fin
        sino si eoi_apic <> 0 entonces
            ep := puntero(eoi_apic)
            valor(ep) := 0
        fin
        si actual = nulo entonces devolver fin
        actual.tics_usados := actual.tics_usados + 1
        ; una tarea cortada con Ctrl+C a la que el reloj pilla en el anillo 3
        ; (no está a medias de nada del núcleo): se acaba aquí. No vuelve.
        si actual.matar y al_cortar <> 0 entonces
            ensamblador
                mov eax, [ebp+36]
                mov {s}, eax
            fin
            si s yb 3 = 3 entonces
                ensamblador
                    mov eax, {al_cortar}
                    call eax
                fin
            fin
        fin
        t := dormidas.primera
        mientras t <> nulo hacer
            sig := t.sig
            si t.despertar <= tics entonces
                quitar(dormidas, t)
                t.estado := LISTA
                meter(listas, t)
            fin
            t := sig
        fin
        si listas.primera = nulo entonces devolver fin
        ensamblador
            mov {marco}, ebp
        fin
        marco := cambiar(marco)
        ensamblador
            mov ebp, {marco}
        fin
    fin

    ; la interrupción 0x30: ceder el procesador ya (la usan ceder(), dormir,
    ; esperar y acabar)
    interrupción función cambio()
        variable marco: nat32
        ensamblador
            mov {marco}, ebp
        fin
        marco := cambiar(marco)
        ensamblador
            mov ebp, {marco}
        fin
    fin

    público función ceder()
        ensamblador
            int 0x30
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Hacer tareas
    ; -------------------------------------------------------------------------
    función ficha_libre(): puntero a Tarea
        variable i: nat32
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            si tareas[i].estado = LIBRE entonces devolver dirección(tareas[i]) fin
        fin
        devolver nulo
    fin

    ; una ficha con su pila; sin meterla en ninguna cola
    función nueva(nombre: puntero a byte): puntero a Tarea
        variable t: puntero a Tarea
        variable p: puntero a byte
        variable i: nat32
        recoger_huérfanas()
        t := ficha_libre()
        si t = nulo entonces devolver nulo fin
        p := reservar(PILA)
        si p = nulo entonces devolver nulo fin
        siguiente_id := siguiente_id + 1
        t.id := siguiente_id
        ; el nombre se copia: el de un programa del disco no dura más que su carga
        i := 0
        mientras i < 15 y nombre[i] <> 0 hacer
            t.nombre_propio[i] := nombre[i]
            i := i + 1
        fin
        t.nombre_propio[i] := 0
        t.nombre := dirección(t.nombre_propio[0])
        si actual <> nulo entonces t.padre := actual.id sino t.padre := 0 fin
        t.args := nulo
        t.quiebre_inicio := 0
        t.quiebre := 0
        t.pila := p
        t.pila_tope := nat32(p) + PILA
        t.cr3 := directorio_núcleo
        t.estado := LISTA
        t.sig := nulo
        t.esperador := nulo
        t.código := 0
        t.x87_usado := falso                    ; (NAVEGADOR)
        si dueño_x87 = t entonces dueño_x87 := nulo fin
        t.turnos := 0
        t.tics_usados := 0
        t.usuario := falso
        ; la carpeta de trabajo y adónde va lo que escribe, los de quien la hace
        t.carpeta[0] := 0
        t.unidad := 0
        t.salida := SIN_SALIDA
        t.salida_serie := 0
        si actual <> nulo entonces
            i := 0
            mientras i < MAX_CARPETA - 1 y actual.carpeta[i] <> 0 hacer
                t.carpeta[i] := actual.carpeta[i]
                i := i + 1
            fin
            t.carpeta[i] := 0
            t.unidad := actual.unidad
            t.salida := actual.salida
            t.salida_serie := actual.salida_serie
        fin
        t.terminal := 0
        si actual <> nulo entonces t.terminal := actual.terminal fin
        t.salida_cr := falso
        t.aguanta := falso
        t.matar := falso
        t.corte := falso
        t.sello := 0                            ; (PROTEGE) lo pone quien la carga (usuario.cas)
        t.servicio := falso
        t.admin := falso
        t.uid := 0                              ; (USUARIOS) lo pone quien la carga (usuario.cas)
        t.uid_hijo := 0
        t.remota := falso
        t.líder := nulo                         ; (JUEGOS)
        t.hilo_id := t.id
        t.teb := 0
        t.despachador := 0
        t.espera_dir := 0
        t.salir_pedido := falso
        t.salir_con := 0
        devolver t
    fin

    ; adonde vuelve la función de una tarea del núcleo cuando acaba
    función fin_de_tarea()
        terminar(0)
    fin

    función bucle_ocioso(n: nat32)
        mientras cierto hacer
            reposar()                           ; (MWAIT) «hlt», o «mwait» si se puede (cpu.cas)
        fin
    fin

    ; una tarea del núcleo que corre la función que está en «rutina» (una
    ; «función f(n: nat32)», dada con nat32(dirección(f))) con el argumento
    ; «arg». Entra en la cola de las listas. Da su ficha, o nulo.
    público función crear_tarea(nombre: puntero a byte, rutina: nat32, arg: nat32): puntero a Tarea
        variable t: puntero a Tarea
        variable p: puntero a nat32
        variable b, i: nat32
        b := sin_interrupciones()
        t := nueva(nombre)
        si t = nulo entonces
            reponer(b)
            devolver nulo
        fin
        ; el marco: pushad (8 palabras), EIP, CS, EFLAGS; y, encima, lo que
        ; ve la función: adónde vuelve y su argumento
        p := puntero(t.pila_tope)
        p := p - 13
        para i desde 0 hasta 7 hacer p[i] := 0 fin
        p[8] := rutina
        p[9] := CÓDIGO_NÚCLEO
        p[10] := 0x202                          ; con las interrupciones abiertas
        p[11] := nat32(dirección(fin_de_tarea))
        p[12] := arg
        t.marco := nat32(p)
        meter(listas, t)
        reponer(b)
        devolver t
    fin

    ; una tarea del anillo 3: empieza en «entrada» con la pila en «pila», en
    ; el espacio de direcciones «directorio» (que pasa a ser suyo: se suelta
    ; al recogerla); su memoria acaba en «quiebre»
    público función crear_tarea_usuario(nombre: puntero a byte, directorio: nat32, entrada: nat32, pila: nat32, quiebre: nat32): puntero a Tarea
        variable t: puntero a Tarea
        variable p: puntero a nat32
        variable b, i: nat32
        b := sin_interrupciones()
        t := nueva(nombre)
        si t = nulo entonces
            reponer(b)
            devolver nulo
        fin
        ; el marco: pushad, y lo que apila el procesador al venir del anillo 3
        p := puntero(t.pila_tope)
        p := p - 13
        para i desde 0 hasta 7 hacer p[i] := 0 fin
        p[8] := entrada
        p[9] := CÓDIGO_USUARIO
        p[10] := 0x202
        p[11] := pila
        p[12] := DATOS_USUARIO
        t.marco := nat32(p)
        t.cr3 := directorio
        t.usuario := cierto
        t.x87_usado := falso                    ; (NAVEGADOR, [WIN32]) su coprocesador, nuevo
        t.quiebre_inicio := quiebre
        t.quiebre := quiebre
        t.esp_usuario := pila
        meter(listas, t)
        reponer(b)
        devolver t
    fin

    ; las fichas de la consola (la que corre ahora, con la pila del arranque) y
    ; de la ociosa, y las dos interrupciones que cambian de tarea
    público función prepara_tareas()
        variable t: puntero a Tarea
        t := dirección(tareas[0])
        siguiente_id := 1
        t.id := 1
        t.nombre := "consola"
        t.padre := 0
        t.args := nulo
        t.pila := nulo
        t.pila_tope := 0
        t.cr3 := leer_cr3()
        t.estado := CORRIENDO
        t.turnos := 1
        t.salida := SIN_SALIDA
        actual := t
        ociosa := nueva("ociosa")
        ociosa.padre := 1
        crear_marco_ocioso()
        pon_puerta(0x20, nat32(dirección(reloj)), PUERTA_NÚCLEO)
        pon_puerta(0x30, nat32(dirección(cambio)), PUERTA_NÚCLEO)
        ; (NAVEGADOR) la coma flotante: el x87 de verdad (CR0.EM apagada, MP
        ; encendida), de nadie aún, y la excepción 7 para repartirlo
        ; (TERMO-FUERTE) y el SSE si lo tiene (prepara_sse; con CR0.TS
        ; apagada mientras tanto)
        dueño_x87 := nulo
        ensamblador
            mov eax, cr0
            and eax, 0xFFFFFFF3
            or eax, 0x00000002
            mov cr0, eax
        fin
        prepara_sse()
        pon_ts()
        pon_puerta(7, nat32(dirección(sin_x87)), PUERTA_NÚCLEO)
    fin

    función crear_marco_ocioso()
        variable p: puntero a nat32
        variable i: nat32
        p := puntero(ociosa.pila_tope)
        p := p - 13
        para i desde 0 hasta 7 hacer p[i] := 0 fin
        p[8] := nat32(dirección(bucle_ocioso))
        p[9] := CÓDIGO_NÚCLEO
        p[10] := 0x202
        p[11] := nat32(dirección(fin_de_tarea))
        p[12] := 0
        ociosa.marco := nat32(p)
    fin

    ; -------------------------------------------------------------------------
    ;  Dormir, esperar, acabar
    ; -------------------------------------------------------------------------
    ; la tarea que corre se duerme n tics
    público función dormir(n: nat32)
        variable b: nat32
        b := sin_interrupciones()
        actual.despertar := tics + n
        actual.estado := DORMIDA
        meter(dormidas, actual)
        ceder()
        reponer(b)
    fin

    ; la tarea que corre se queda esperando hasta que la despierten (hay que
    ; llamarla con las interrupciones tapadas, y mirar luego si lo que se
    ; esperaba ha llegado)
    público función bloquear()
        actual.estado := ESPERANDO
        ceder()
    fin

    público función despertar_tarea(t: puntero a Tarea)
        variable b: nat32
        b := sin_interrupciones()
        si t.estado = ESPERANDO entonces
            t.estado := LISTA
            meter(listas, t)
        fin
        reponer(b)
    fin

    ; si la tarea t duerme, se despierta ya (sin esperar a su tic)
    público función despertar_dormida(t: puntero a Tarea)
        variable b: nat32
        b := sin_interrupciones()
        si t.estado = DORMIDA entonces
            quitar(dormidas, t)
            t.estado := LISTA
            meter(listas, t)
        fin
        reponer(b)
    fin

    ; la tarea que corre acaba, con ese código. No vuelve.
    público función terminar(código: nat32)
        variable b, i: nat32
        b := sin_interrupciones()
        ; las tareas que hizo y no ha recogido se quedan huérfanas: las
        ; recogerá el núcleo cuando acaben ((JUEGOS) si acaba un hilo, no: las
        ; del proceso siguen siendo de él)
        si actual.líder = nulo entonces
            para i desde 0 hasta MAX_TAREAS - 1 hacer
                si tareas[i].estado <> LIBRE y tareas[i].padre = actual.id y tareas[i].líder = nulo entonces tareas[i].padre := 0 fin
            fin
        fin
        actual.código := código
        actual.estado := ACABADA
        si actual.esperador <> nulo entonces despertar_tarea(actual.esperador) fin
        ceder()
    fin

    ; espera a que acabe la tarea t, la recoge (su pila y, si es del usuario,
    ; su espacio de direcciones vuelven a estar libres) y da su código
    público función esperar(t: puntero a Tarea): nat32
        variable b, c: nat32
        b := sin_interrupciones()
        mientras t.estado <> ACABADA hacer
            ; si a la que espera la están acabando (Ctrl+C), no espera más:
            ; la otra se queda huérfana y la recogerá el núcleo
            si actual.matar entonces
                t.esperador := nulo
                reponer(b)
                devolver CORTADA
            fin
            t.esperador := actual
            bloquear()
        fin
        c := t.código
        liberar(t.pila)
        si t.args <> nulo entonces
            liberar(t.args)
            t.args := nulo
        fin
        ; (JUEGOS) el espacio de un hilo es el de su proceso: no se suelta
        si t.usuario y t.líder = nulo entonces soltar_espacio(t.cr3) fin
        si dueño_x87 = t entonces dueño_x87 := nulo fin     ; (NAVEGADOR)
        t.estado := LIBRE
        reponer(b)
        devolver c
    fin

    ; marca una tarea para acabar (en cuanto vuelva al anillo 3) y, si
    ; dormía o esperaba, la despierta para que llegue
    público función acabar_tarea(t: puntero a Tarea)
        variable b: nat32
        b := sin_interrupciones()
        t.matar := cierto
        si t.estado = DORMIDA entonces
            quitar(dormidas, t)
            t.estado := LISTA
            meter(listas, t)
        sino si t.estado = ESPERANDO entonces
            t.estado := LISTA
            meter(listas, t)
        fin
        reponer(b)
    fin

    ; Ctrl+C: los programas del anillo 3 que no han dicho que lo atienden
    ; ellos quedan marcados para acabar (en cuanto vuelvan al anillo 3: al
    ; salir de una llamada al sistema, o cuando el reloj los pille allí), y
    ; los que dormían o esperaban, despiertos para que lleguen. A los que lo
    ; atienden se les apunta. Da cuántos se van a acabar. (La llama el
    ; teclado, con las interrupciones tapadas.)
    público función cortar_programas(): nat32
        variable i, n: nat32
        variable t: puntero a Tarea
        n := 0
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            t := dirección(tareas[i])
            si t.estado <> LIBRE y t.estado <> ACABADA y t.usuario entonces
                si t.aguanta entonces
                    t.corte := cierto
                sino
                    acabar_tarea(t)
                    n := n + 1
                fin
            fin
        fin
        devolver n
    fin

    ; recoge las tareas acabadas a las que ya nadie va a esperar (las que
    ; hizo un programa que acabó antes que ellas)
    público función recoger_huérfanas()
        variable i, b: nat32
        variable t: puntero a Tarea
        si actual = nulo entonces devolver fin
        b := sin_interrupciones()
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            t := dirección(tareas[i])
            si t.estado = ACABADA y t.padre = 0 y t.esperador = nulo y t <> actual entonces esperar(t) fin
        fin
        reponer(b)
    fin

    ; la tarea que tiene ese número (nulo si no hay ninguna)
    público función tarea_de(id: nat32): puntero a Tarea
        variable i: nat32
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            ; ((JUEGOS) la del proceso, no uno de sus hilos, que llevan su número)
            si tareas[i].estado <> LIBRE y tareas[i].id = id y tareas[i].líder = nulo entonces devolver dirección(tareas[i]) fin
        fin
        devolver nulo
    fin

    ; -------------------------------------------------------------------------
    ;  (JUEGOS) Los hilos de los programas de Windows
    ; -------------------------------------------------------------------------
    ; un hilo nuevo del proceso de la tarea que corre: empieza en «entrada»
    ; con la pila en «pila» (con los segmentos «cs» y «ss»: los de Win32) y su
    ; TEB en «teb» (de verdad). Comparte el espacio de direcciones, el número
    ; de tarea y lo demás del proceso; entra en la cola. Da su ficha, o nulo.
    público función crear_hilo(entrada: nat32, pila: nat32, cs_: nat32, ss_: nat32, teb: nat32): puntero a Tarea
        variable t, l: puntero a Tarea
        variable p: puntero a nat32
        variable b, i: nat32
        l := actual
        si l.líder <> nulo entonces l := l.líder fin
        b := sin_interrupciones()
        t := nueva(l.nombre)
        si t = nulo entonces
            reponer(b)
            devolver nulo
        fin
        p := puntero(t.pila_tope)
        p := p - 13
        para i desde 0 hasta 7 hacer p[i] := 0 fin
        p[8] := entrada
        p[9] := cs_
        p[10] := 0x202
        p[11] := pila
        p[12] := ss_
        t.marco := nat32(p)
        t.cr3 := l.cr3
        t.usuario := cierto
        t.x87_usado := falso
        t.quiebre_inicio := l.quiebre_inicio
        t.quiebre := l.quiebre
        t.esp_usuario := pila
        t.líder := l
        t.hilo_id := t.id                       ; (el número nuevo, el suyo de hilo)
        t.id := l.id                            ; y el del proceso, para todo lo demás
        t.padre := 0                            ; (lo recoge el núcleo cuando acabe)
        t.teb := teb
        t.despachador := l.despachador
        t.sello := l.sello                      ; (PROTEGE) lo que es el proceso
        t.servicio := l.servicio
        t.admin := l.admin
        t.uid := l.uid                          ; (USUARIOS) de quién es: el usuario del proceso (si no, un hilo
        t.uid_hijo := l.uid_hijo                ; sería «del sistema»); y cerrar la sesión acaba también sus hilos
        t.remota := l.remota
        t.terminal := l.terminal
        t.salida := l.salida
        t.salida_serie := l.salida_serie
        meter(listas, t)
        reponer(b)
        devolver t
    fin

    ; acaba los otros hilos del proceso de la tarea que corre (no a ella ni
    ; al principal) y espera a que acaben: ExitProcess, antes de soltar lo
    ; de las DLL
    público función acaba_hermanos()
        variable i, b, vueltas: nat32
        variable t, l: puntero a Tarea
        variable quedan: bool
        l := actual
        si l.líder <> nulo entonces l := l.líder fin
        vueltas := 0
        mientras vueltas < 300 hacer
            quedan := falso
            b := sin_interrupciones()
            para i desde 0 hasta MAX_TAREAS - 1 hacer
                t := dirección(tareas[i])
                si t.estado <> LIBRE y t.estado <> ACABADA y t.líder = l y t <> actual entonces
                    si no t.matar entonces acabar_tarea(t) fin
                    quedan := cierto
                fin
            fin
            reponer(b)
            si no quedan entonces devolver fin
            dormir(1)
            vueltas := vueltas + 1
        fin
    fin

    ; la TEB de la tarea que corre (de verdad): se apunta y se pone ya
    público función pon_mi_teb(lin: nat32)
        variable b: nat32
        b := sin_interrupciones()
        actual.teb := lin
        pon_teb(lin)
        teb_puesta := lin
        reponer(b)
    fin

    ; el hilo de la tarea que corre (o de su proceso) con ese número de hilo
    público función hilo_de(hid: nat32): puntero a Tarea
        variable i: nat32
        variable l: puntero a Tarea
        l := actual
        si l.líder <> nulo entonces l := l.líder fin
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            si tareas[i].estado <> LIBRE y tareas[i].hilo_id = hid y (dirección(tareas[i]) = l o tareas[i].líder = l) entonces devolver dirección(tareas[i]) fin
        fin
        devolver nulo
    fin

    ; acaba (y recoge) los hilos de la tarea que corre, si es un proceso que
    ; los tiene: se les marca para acabar y se espera a que acaben (antes de
    ; soltar lo del proceso, que usan). La llaman las salidas de usuario.cas.
    público función acaba_hilos()
        variable i, b: nat32
        variable t: puntero a Tarea
        variable quedan: bool
        si actual = nulo o actual.líder <> nulo entonces devolver fin
        mientras cierto hacer
            quedan := falso
            b := sin_interrupciones()
            para i desde 0 hasta MAX_TAREAS - 1 hacer
                t := dirección(tareas[i])
                si t.estado <> LIBRE y t.líder = actual entonces
                    si t.estado = ACABADA entonces
                        liberar(t.pila)
                        si dueño_x87 = t entonces dueño_x87 := nulo fin
                        t.líder := nulo
                        t.estado := LIBRE
                    sino
                        si no t.matar entonces acabar_tarea(t) fin
                        quedan := cierto
                    fin
                fin
            fin
            reponer(b)
            si no quedan entonces devolver fin
            dormir(1)
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Para la consola
    ; -------------------------------------------------------------------------
    función nombre_estado(e: nat32): puntero a byte
        según e
            caso LISTA: devolver "lista"
            caso CORRIENDO: devolver "corriendo"
            caso DORMIDA: devolver "dormida"
            caso ESPERANDO: devolver "esperando"
            caso ACABADA: devolver "acabada"
            caso EN_CERROJO: devolver "en cerrojo"
        fin
        devolver "libre"
    fin

    ; (TERMO) los tics que ha corrido la ociosa (el Termómetro: lo ocupado
    ; que está el procesador)
    público función tics_de_la_ociosa(): nat32
        si ociosa = nulo entonces devolver 0 fin
        devolver ociosa.tics_usados
    fin

    público función enseña_tareas()
        variable i: nat32
        variable t: puntero a Tarea
        variable d: arreglo [6] de nat32
        escribir("  id  nombre        estado     anillo  turnos   tics\n")
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            t := dirección(tareas[i])
            si t.estado <> LIBRE entonces
                d[0] := t.id
                d[1] := nat32(t.nombre)
                d[2] := nat32(nombre_estado(t.estado))
                si t.usuario entonces d[3] := 3 sino d[3] := 0 fin
                d[4] := t.turnos
                d[5] := t.tics_usados
                imprimir("%4u  %-12s  %-9s  %6u  %6u  %5u\n", d)
            fin
        fin
        imprimir2("%u cambios de tarea en %u tics\n", cambios, tics)
    fin

    público función cuántas_tareas(): nat32
        variable i, n: nat32
        n := 0
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            si tareas[i].estado <> LIBRE entonces n := n + 1 fin
        fin
        devolver n
    fin

fin Tareas.
