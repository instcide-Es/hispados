; =============================================================================
;  ured.cas - RED.BIN, el servicio de red de Hispa-Pentium: un programa del
;  anillo 3 que lleva la tarjeta de red (rtarjeta.cas, ryukon.cas) y la pila
;  TCP/IP (rpila.cas: Ethernet, ARP, IPv4, ICMP, UDP, DHCP y DNS; rtcp.cas:
;  TCP), y atiende lo que le piden los programas por medio del núcleo
;  (red.cas: la llamada 90; los programas usan redes.cas).
;  Lo pone en marcha el núcleo: al arrancar el escritorio, si hay una tarjeta
;  de red; con «conred» en la línea del cargador; o la primera vez que un
;  programa pide algo a la red. No escribe nada en la pantalla: lo que pasa
;  lo apunta (IPCONFIG /TODO lo enseña) y lo manda por el puerto serie.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Ured

    modelo usuario

    importar Llamadas, Rbase, Rtarjeta, Rwifi, Rmovil, Rpila, Rtcp, Mem32, Textos32, Rcorta

    ; lo que dice el icono (red.cas)
    constante RED_SIN_TARJETA = 1
    constante RED_SIN_CABLE = 2
    constante RED_BUSCANDO = 3
    constante RED_CONECTADA = 4

    variable pedido: arreglo [64 + MAX_DATOS] de byte
    variable trama: arreglo [1536] de byte
    variable salida_wifi: arreglo [MAX_DATOS] de byte   ; (WIFI) lo que sale por el Wi-Fi, para WIFI.BIN
    variable nombre: arreglo [256] de byte
    variable info: Info_red
    variable enlace: bool
    variable estado_dicho, ip_dicha, túnel_dicho: nat32

    ; lo que falta para usar la red (0: nada)
    función falta(): nat32
        si tarjeta = T_NINGUNA entonces devolver SIN_TARJETA fin
        si no enlace entonces devolver SIN_CABLE fin
        si mi_ip = 0 entonces devolver SIN_IP fin
        devolver 0
    fin

    función cómo_está(): nat32
        si tarjeta = T_NINGUNA entonces devolver RED_SIN_TARJETA fin
        si no enlace entonces devolver RED_SIN_CABLE fin
        si mi_ip = 0 entonces devolver RED_BUSCANDO fin
        devolver RED_CONECTADA
    fin

    función dilo()
        variable e, a: nat32
        e := cómo_está()
        ; (WIFI) el bit 9: por el Wi-Fi; los 12 y 13: lo que se prefiere (RED.INI)
        si tarjeta = T_WIFI entonces e := e ob 0x200 fin
        si tarjeta = T_MOVIL entonces e := e ob 0x400 fin         ; (MÓVIL) el bit 10: por el móvil por USB
        si tarjeta = T_MOVIL y Rmovil.es_adaptador() entonces e := e ob 0x800 fin     ; (RTL8153) el 11: un adaptador de red USB
        e := e ob (preferir << 12)
        si e <> estado_dicho o mi_ip <> ip_dicha o túnel_ip <> túnel_dicho entonces
            ; (el aparato que hace DMA para RED.BIN: el del cable; el Wi-Fi lo dice WIFI.BIN)
            a := pci_cable
            si túnel_ip <> 0 entonces decir_estado(e ob 0x100, mi_ip, a) sino decir_estado(e, mi_ip, a) fin    ; (TAILSCALE) con el túnel
            estado_dicho := e
            túnel_dicho := túnel_ip
            ip_dicha := mi_ip
        fin
    fin

    función mira_enlace()
        variable e: bool
        si tarjeta = T_NINGUNA entonces devolver fin
        e := hay_enlace()
        si e = enlace entonces devolver fin
        enlace := e
        si e entonces
            apunta4("enlace: sí (%u Mbit/s)", velocidad(), 0, 0, 0)
            dhcp_empezar()
        sino
            si tarjeta = T_WIFI entonces
                apunta("enlace: no (el Wi-Fi no está conectado)")                 ; (WIFI)
            sino si tarjeta = T_MOVIL y Rmovil.es_adaptador() entonces
                apunta("enlace: no (el adaptador de red USB: ¿el cable?)")        ; (RTL8153)
            sino si tarjeta = T_MOVIL entonces
                apunta("enlace: no (el móvil por USB)")                           ; (MÓVIL)
            sino
                apunta("enlace: no (¿el cable?)")
            fin
            dhcp_parar()
            pila_sin_cable()
            tcp_sin_red(SIN_CABLE)
        fin
    fin

    ; (WIFI) quitar lo que había de la red (como al quitar el cable): para cambiar de tarjeta
    función corta()
        si enlace entonces
            enlace := falso
            dhcp_parar()
            pila_sin_cable()
            tcp_sin_red(SIN_CABLE)
        fin
    fin

    ; (WIFI) ¿por el cable o por el Wi-Fi? (Rwifi.conviene, con lo que dice RED.INI)
    ; (MÓVIL) y el móvil por USB: el cable de verdad (con enlace) antes que el
    ; móvil, y el móvil antes que el Wi-Fi (salvo con «Preferir=WIFI»)
    ; (RTL8153) un adaptador de red USB de cable, como el móvil, pero solo
    ; con enlace (si no, se va por el Wi-Fi o la tarjeta de dentro; y, si no
    ; hay nada más, por él: así IPCONFIG dice que no tiene cable)
    variable adaptador_antes: bool              ; (RTL8153) se iba por el adaptador de red USB

    función elige_tarjeta()
        variable cable_ok, w: bool
        variable quiero, antes: nat32
        Rwifi.cambió := falso
        adaptador_antes := tarjeta = T_MOVIL y (Rmovil.es_adaptador() o Rmovil.fue_adaptador)
        Rmovil.mirar()
        Rmovil.cambió := falso
        cable_ok := tarjeta_cable <> T_NINGUNA y enlace_de(tarjeta_cable)
        w := conviene(cable_ok)
        quiero := tarjeta_cable
        si w y preferir = PREFIERE_WIFI entonces
            quiero := T_WIFI
        sino si no cable_ok y Rmovil.listo y (Rmovil.enlace_movil o (no w y tarjeta_cable = T_NINGUNA)) entonces
            quiero := T_MOVIL
        sino si w entonces
            quiero := T_WIFI
        fin
        si quiero <> tarjeta entonces
            antes := tarjeta
            corta()
            usar(quiero)
            si tarjeta = T_WIFI entonces
                apunta("la red va por el Wi-Fi")
            sino si tarjeta = T_MOVIL y Rmovil.es_adaptador() entonces
                apunta("la red va por el adaptador de red USB")                   ; (RTL8153)
            sino si tarjeta = T_MOVIL entonces
                apunta("la red va por el móvil por USB")
            sino si tarjeta = T_NINGUNA y antes = T_MOVIL y adaptador_antes entonces
                apunta("la red ya no va por el adaptador de red USB")            ; (RTL8153)
            sino si tarjeta = T_NINGUNA y antes = T_MOVIL entonces
                apunta("la red ya no va por el móvil por USB (no hay cable)")
            sino si tarjeta = T_NINGUNA entonces
                apunta("la red ya no va por el Wi-Fi (no hay cable)")
            sino
                apunta("la red va por el cable")
            fin
        fin
        mira_enlace()
    fin

    ; (WIFI) O_WIFI_CAMBIO: las tramas que han llegado por el Wi-Fi, a la
    ; pila (si la red va por él); y las que hay que enviar, de vuelta
    función cambio_wifi(p: puntero a Pedido_red, datos: puntero a byte)
        variable i, n, r: nat32
        estado_de(p)
        i := 0
        mientras i + 2 <= p.largo hacer
            n := nat32(datos[i]) ob (nat32(datos[i + 1]) << 8)
            si n < 14 o i + 2 + n > p.largo entonces romper fin
            si tarjeta = T_WIFI entonces
                recibidas := recibidas + 1
                entradas := entradas + 1
                si Rpila.entrada(datos + i + 2, n) = ENTRA_TCP entonces tcp_entra(ent_ip, ent_datos, ent_largo) fin
            fin
            i := i + 2 + n
        fin
        si Rwifi.cambió entonces elige_tarjeta() fin
        n := lote(dirección(salida_wifi[0]))
        r := 0
        si que_pare() entonces r := 1 fin
        contestar(p.hueco, p.serie, 0, r, 0, dirección(salida_wifi[0]), n)
    fin

    función llena_info()
        llenar(puntero(dirección(info)), tamaño(Info_red), 0)
        info.estado := cómo_está()
        copiar_memoria(dirección(info.mac[0]), mac, 6)
        info.ip := mi_ip
        info.máscara := máscara
        info.puerta := puerta
        info.dns := dns
        info.servidor := servidor
        info.concesión := concesión
        si mi_ip <> 0 entonces info.hace := (ahora() - dada_en) div 100 fin
        si enlace entonces info.velocidad := velocidad() fin
        info.recibidas := recibidas
        info.enviadas := enviadas
        info.errores := errores
        copiar_hasta(dirección(info.tarjeta[0]), nombre_tarjeta, 48)
        info.pci := pci_tarjeta
        info.id_pci := id_tarjeta
        info.irq := irq_tarjeta
    fin

    ; (PROTEGE) lo que el núcleo dice de la tarea que pide (la llamada 158):
    ; su sello (los de permisos.cas) y si es un servicio
    constante SELLO_WG = 10
    constante SELLO_TAILSCAL = 11
    constante ES_SERVICIO = 0x80000000

    función es_servicio_tarea(t: nat32): bool
        variable r: nat32
        r := sello_de_tarea(t)
        devolver r <> NO_VALE y r yb ES_SERVICIO <> 0
    fin

    función es_del_túnel(t: nat32): bool
        variable r: nat32
        r := sello_de_tarea(t)
        si r = NO_VALE o r yb ES_SERVICIO = 0 entonces devolver falso fin
        r := r yb 0xFF
        devolver r = SELLO_WG o r = SELLO_TAILSCAL
    fin

    función atiende(p: puntero a Pedido_red, datos: puntero a byte)
        variable h, s, orden, f, n, r: nat32
        h := p.hueco
        s := p.serie
        orden := p.cab[0]
        si orden = AVISO_ACABÓ entonces
            tcp_acabó(p.tarea)
            udp_acabó(p.tarea)
            túnel_acabó(p.tarea)                            ; (TÚNEL)
            Rwifi.quitar(p.tarea)                    ; (WIFI) si era WIFI.BIN
            si Rwifi.cambió entonces elige_tarjeta() fin
            devolver
        fin
        si orden = AVISO_PREFERIR entonces
            ; (WIFI) lo elegido en Configuración: Automático, Cable o Wi-Fi
            Rwifi.elegir(p.cab[1])
            elige_tarjeta()
            devolver
        fin
        f := falta()
        según nat16(orden)
            caso O_ESTADO:
                llena_info()
                contestar(h, s, 0, 0, 0, puntero(dirección(info)), tamaño(Info_red))
            caso O_REGISTRO:
                n := registro_largo
                si n > p.cabe entonces n := p.cabe fin
                contestar(h, s, n, 0, 0, dirección(registro[registro_largo - n]), n)
            caso O_RENOVAR:
                si tarjeta = T_NINGUNA entonces
                    contestar(h, s, SIN_TARJETA, 0, 0, nulo, 0)
                sino si no enlace entonces
                    contestar(h, s, SIN_CABLE, 0, 0, nulo, 0)
                sino
                    dhcp_empezar()
                    contestar(h, s, 0, 0, 0, nulo, 0)
                fin
            caso O_RESOLVER:
                si f <> 0 entonces
                    contestar(h, s, f, 0, 0, nulo, 0)
                sino
                    n := p.largo
                    si n > 255 entonces n := 255 fin
                    copiar_memoria(dirección(nombre[0]), datos, n)
                    nombre[n] := 0
                    r := p.cab[2]
                    si r = 0 entonces r := 500 fin
                    resolver(h, s, dirección(nombre[0]), r)
                fin
            caso O_PING:
                si f <> 0 entonces contestar(h, s, f, 0, 0, nulo, 0) sino hacer_ping(h, s, p.cab[1], p.cab[2], p.cab[3], p.cab[4]) fin
            caso O_CONECTAR:
                si f <> 0 entonces contestar(h, s, f, 0, 0, nulo, 0) sino conectar(p.tarea, h, s, p.cab[1], p.cab[2], p.cab[3]) fin
            caso O_ENVIAR:
                si es_tcp(p.cab[1]) entonces
                    Rtcp.enviar(p.cab[1], p.tarea, h, s, datos, p.largo)
                sino
                    contestar(h, s, NO_CONEXIÓN, 0, 0, nulo, 0)
                fin
            caso O_RECIBIR:
                si es_tcp(p.cab[1]) entonces
                    Rtcp.recibir(p.cab[1], p.tarea, h, s, p.cab[2], p.cabe)
                sino
                    udp_recibir(p.cab[1], p.tarea, h, s, p.cab[2], p.cabe)
                fin
            caso O_CERRAR:
                si es_tcp(p.cab[1]) entonces
                    r := Rtcp.cerrar(p.cab[1], p.tarea)
                sino si es_escucha(p.cab[1]) entonces
                    r := no_escuchar(p.cab[1], p.tarea)          ; (SSH)
                sino
                    r := udp_cerrar(p.cab[1], p.tarea)
                fin
                contestar(h, s, r, 0, 0, nulo, 0)
            caso O_ESCUCHAR:
                ; (SSH) un puerto TCP en escucha (el servidor SSH); (PROTEGE)
                ; los de debajo del 1024, solo los servicios (que nadie se
                ; ponga en el 22 antes que SSHD a recoger contraseñas)
                si p.cab[1] < 1024 y no es_servicio_tarea(p.tarea) entonces
                    contestar(h, s, NO_VALE_RED, 0, 0, nulo, 0)
                sino si tarjeta = T_NINGUNA entonces contestar(h, s, SIN_TARJETA, 0, 0, nulo, 0) sino contestar(h, s, escuchar(p.tarea, p.cab[1]), 0, 0, nulo, 0) fin
            caso O_ACEPTAR:
                aceptar(p.cab[1], p.tarea, h, s, p.cab[2])
            ; ---- (CORTAFUEGOS) el cortafuegos (Escudo) ----
            caso O_CORTAFUEGOS:
                si p.cab[1] = 0 entonces
                    carga_reglas()
                    contestar(h, s, 0, 0, 0, nulo, 0)
                sino si p.cab[1] = 1 entonces
                    informe(dirección(pedido[64]), MAX_DATOS)
                    lista_escuchas(dirección(pedido[64]), MAX_DATOS)
                    lista_udp(dirección(pedido[64]), MAX_DATOS)
                    n := longitud(dirección(pedido[64]))
                    si n > p.cabe entonces n := p.cabe fin
                    contestar(h, s, n, 0, 0, dirección(pedido[64]), n)
                sino
                    olvida_pendiente(p.cab[2])
                    contestar(h, s, 0, 0, 0, nulo, 0)
                fin
            ; ---- (TÚNEL) la interfaz del túnel (WireGuard, Tailscale) ----
            caso O_TUNEL:
                ; (PROTEGE) la interfaz del túnel (que se lleva lo que va a sus
                ; redes): solo WG.BIN y TAILSCAL.BIN de la carpeta del sistema
                si no es_del_túnel(p.tarea) entonces
                    contestar(h, s, NO_VALE_RED, 0, 0, nulo, 0)
                sino
                    contestar(h, s, poner_túnel(p.tarea, p.cab[1], puntero(datos), p.largo div 8), 0, 0, nulo, 0)
                fin
            caso O_TUNEL_QUITAR:
                contestar(h, s, quitar_túnel(p.tarea), 0, 0, nulo, 0)
            caso O_TUNEL_LEER:
                leer_túnel(p.tarea, h, s, p.cab[1], p.cabe)
            caso O_TUNEL_ENTRA:
                si túnel_ip = 0 o túnel_dueño <> p.tarea entonces
                    contestar(h, s, NO_VALE_RED, 0, 0, nulo, 0)
                sino
                    si entrada_ip(datos, p.largo, cierto) = ENTRA_TCP entonces tcp_entra(ent_ip, ent_datos, ent_largo) fin
                    contestar(h, s, 0, 0, 0, nulo, 0)
                fin
            caso O_TUNEL_DNS:
                contestar(h, s, nombres_del_túnel(p.tarea, datos, p.largo), 0, 0, nulo, 0)
            caso O_TUNEL_ESTADO:
                contestar(h, s, túnel_ip, túnel_salidos, túnel_entrados, nulo, 0)
            ; ---- (WIFI) el servicio Wi-Fi (WIFI.BIN) y lo que se prefiere ----
            caso O_WIFI_PONER:
                contestar(h, s, poner(p.tarea, p, datos), 0, 0, nulo, 0)
                elige_tarjeta()
            caso O_WIFI_CAMBIO:
                si p.tarea <> Rwifi.dueño entonces contestar(h, s, NO_VALE_RED, 0, 0, nulo, 0) sino cambio_wifi(p, datos) fin
            caso O_WIFI_QUITAR:
                Rwifi.quitar(p.tarea)
                contestar(h, s, 0, 0, 0, nulo, 0)
                elige_tarjeta()
            caso O_WIFI_PREFERIR:
                ; (en cab[1], 1 si la red va por el Wi-Fi)
                si p.cab[1] <= PREFIERE_WIFI entonces
                    Rwifi.elegir(p.cab[1])
                    elige_tarjeta()
                fin
                r := 0
                si tarjeta = T_WIFI entonces r := 1 fin
                si tarjeta = T_MOVIL y no Rmovil.es_adaptador() entonces r := 2 fin      ; (MÓVIL) ((RTL8153) el adaptador es un cable)
                contestar(h, s, preferir, r, 0, nulo, 0)
            caso O_UDP:
                si tarjeta = T_NINGUNA entonces
                    contestar(h, s, SIN_TARJETA, 0, 0, nulo, 0)
                sino
                    contestar(h, s, udp_abrir(p.tarea, p.cab[1]), 0, 0, nulo, 0)
                fin
            caso O_UDP_ENVIAR:
                si tarjeta = T_NINGUNA o no enlace entonces
                    contestar(h, s, f, 0, 0, nulo, 0)
                sino
                    contestar(h, s, udp_mandar(p.cab[1], p.tarea, p.cab[2], p.cab[3], datos, p.largo), 0, 0, nulo, 0)
                fin
            si no:
                contestar(h, s, NO_VALE_RED, 0, 0, nulo, 0)
        fin
    fin

    variable registro_vueltas: nat32

    función principal()
        variable p: puntero a Pedido_red
        variable n, k, espera, tic_visto, enlace_visto: nat32
        atender_corte(cierto)
        si apuntarse() <> 0 entonces salir(1) fin
        apunta("Hispa-Pentium 0.8: el servicio de red (RED.BIN)")
        apunta("(red 0.8.12: también el móvil por USB, el anclaje de USB de Android: RNDIS y CDC-NCM)")
        apunta("(red 0.8.13: y los adaptadores de red USB de cable, CDC-ECM: el Realtek RTL8153)")
        ; (WIFI) RED.INI y, si hay tarjeta Wi-Fi, WIFI.BIN (antes que la del
        ; cable: así enciende su radio mientras tanto)
        Rwifi.arrancar()
        si no buscar_tarjeta() entonces
            apunta("no hay ninguna tarjeta de red que se sepa llevar")
        fin
        carga_reglas()                          ; (CORTAFUEGOS)
        enlace := falso
        estado_dicho := 0xFFFFFFFF
        elige_tarjeta()                         ; ((MÓVIL) y si hay un móvil por USB) y mira_enlace()
        dilo()
        p := puntero(dirección(pedido[0]))
        espera := 1
        tic_visto := ahora()
        enlace_visto := ahora()
        mientras cierto hacer
            vaciar_cable(dirección(trama[0]))                ; (WIFI) la del cable, mientras se va por el Wi-Fi
            si Rmovil.cambió entonces elige_tarjeta() fin    ; (MÓVIL) se ha ido el móvil
            si tarjeta <> T_NINGUNA entonces
                atender_tarjeta()
                k := 0
                mientras k < 64 hacer
                    n := recibir_trama(dirección(trama[0]))
                    si n = 0 entonces romper fin
                    si Rpila.entrada(dirección(trama[0]), n) = ENTRA_TCP entonces tcp_entra(ent_ip, ent_datos, ent_largo) fin
                    k := k + 1
                fin
            fin
            si ahora() <> tic_visto entonces
                tic_visto := ahora()
                pila_tic()
                ; (CORTES) DHCP ha dado otra IP u otra puerta: lo de antes, cortado
                si Rpila.red_cambió entonces
                    Rpila.red_cambió := falso
                    tcp_red_cambió(RED_CAMBIADA)
                fin
                tcp_tic()
                si ahora() - enlace_visto >= 25 entonces
                    enlace_visto := ahora()
                    elige_tarjeta()                         ; (WIFI) y, dentro, mira_enlace()
                    registro_vueltas := registro_vueltas + 1
                    si registro_vueltas >= 8 entonces       ; (RTL8168) cada 2 s, RED.LOG si RED.INI lo pide
                        registro_vueltas := 0
                        Rwifi.guarda_registro()
                    fin
                fin
                dilo()
            fin
            ; sin tarjeta, se espera mucho (no hay nada que mirar)
            espera := 1
            si tarjeta = T_NINGUNA entonces espera := 100 fin
            si siguiente_pedido(dirección(pedido[0]), espera) entonces atiende(p, dirección(pedido[64])) fin
        fin
    fin

fin Ured.
