; =============================================================================
;  ventanas.cas - el gestor de ventanas de Hispa-Pentium.
;
;  Cada ventana tiene su propio lienzo (grafico.cas) con todo lo suyo: el
;  marco (la barra de título redondeada por arriba, con sus tres botones) y
;  lo de dentro, donde dibuja su dueño: un programa del anillo 3, por las
;  llamadas al sistema, o el propio núcleo (la barra de tareas, el menú
;  Inicio y los cuadros del escritorio son ventanas sin marco del núcleo:
;  escritorio.cas). Componer la pantalla es copiar: el tapiz y, encima, las
;  ventanas de la de más atrás a la de más adelante, a un doble búfer; y de
;  ahí a la pantalla. Solo se recompone lo que ha cambiado («lo sucio»: una
;  lista corta de rectángulos). La flecha del ratón se pinta al final,
;  directamente en la pantalla.
;
;  (PUNTEROS) El puntero tiene formas (cursores.cas): la flecha, la de
;  cambiar el tamaño en los bordes (la pone el gestor solo), la espera, el
;  texto, la mano... Un programa pide la de su ventana o la de unas zonas
;  de ella (la llamada 177, apuntero.cas). Lo que se ve encima de la
;  pantalla (el puntero y, si se quieren, su rastro y los anillos de
;  localizarlo con Control) son «piezas»: cada vez que cambian, o que se
;  recompone algo debajo, se pinta en una baldosa (de 128 x 128) lo del
;  doble búfer con las piezas encima, y de ahí a la pantalla. Cada punto de
;  la pantalla se escribe una sola vez y ya con lo que tiene que tener: no
;  parpadea ni deja restos (tampoco al cambiar de forma o de tamaño, ni con
;  el puntero enorme).
;
;  El ratón y el teclado: pulso() (lo llama la tarea del escritorio cien
;  veces por segundo) recoge lo que ha pasado y lo reparte: mover una ventana
;  por su título, cambiarla de tamaño por su borde o su esquina (la flecha
;  cambia de forma encima de ellos), traerla delante, minimizarla,
;  maximizarla (también con dos clics en el título) o cerrarla lo hace aquí;
;  lo demás va a la cola de sucesos de la ventana que toca (un clic dentro,
;  con los botones, las teclas de cambio y si es el primero, el segundo o el
;  tercero seguido; las teclas a la que está activa), y su dueño los recoge.
;  Lo que cae fuera de todas (el tapiz), y el botón secundario en un título,
;  van a la ventana «del fondo»: la del escritorio, que pone sus menús.
;
;  Todo lo de las ventanas va con un cerrojo: los programas dibujan a la vez
;  que el escritorio compone.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Ventanas

    importar Cpu, Tareas, Monton, Grafico, Letra, Video, Raton, Consola, Cursores

    público constante MAX_VENTANAS = 24              ; (MENÚ) eran 20: el menú Inicio abre dos más (sus submenús)
    público constante MAX_TÍTULO = 64

    ; ---- las banderas de una ventana ----
    público constante SIN_MARCO = 1             ; sin título ni borde (la barra de tareas, un menú)
    público constante ENCIMA = 2                ; siempre por delante de las normales
    público constante OCULTA = 4                ; no se ve (ni cuenta para nada)
    público constante MINIMIZADA = 8            ; recogida en su botón de la barra de tareas
    público constante MAXIMIZADA = 16
    público constante FIJA = 32                 ; no se maximiza (un cuadro de diálogo)
    público constante REDONDA = 64              ; sin marco, pero con las esquinas de arriba redondas y sombra (un menú)
    público constante TRASLÚCIDA = 128          ; (dock) sus puntos con algo en el octeto de arriba (TRANSPARENTE) no se ven ni se pulsan
    público constante TRANSPARENTE = 0xFF000000 ; (dock) el punto que no se ve, en una TRASLÚCIDA
    público constante COMPLETA = 256            ; [WIN32] sin marco, pero puede ser la activa (las teclas): la pantalla completa de un juego (win32.cas; era 128, la de TRASLÚCIDA)

    ; ---- las medidas del marco ----
    público constante BORDE = 4
    público constante ALTO_TÍTULO = 28
    constante RADIO = 8                         ; el de las esquinas de arriba
    constante SOMBRA = 5                        ; lo que asoma la sombra por la derecha y por abajo
    constante BOTÓN_ANCHO = 22
    constante BOTÓN_ALTO = 20
    constante BOTÓN_Y = 4

    ; ---- los sucesos que llegan a una ventana ----
    público constante EV_TECLA = 1              ; a: la tecla (como las da el teclado)
    público constante EV_RATÓN_BAJA = 2         ; a, b: dónde (dentro de la ventana); c: los botones
    público constante EV_RATÓN_SUBE = 3
    público constante EV_RATÓN_MUEVE = 4
    público constante EV_CERRAR = 5             ; se ha pulsado el botón de cerrar
    público constante EV_TAMAÑO = 6             ; a, b: el ancho y el alto nuevos de lo de dentro (hay que volver a pintar)
    público constante EV_FOCO = 7               ; a: 1 si pasa a ser la activa, 0 si deja de serlo
    público constante EV_FUERA = 8              ; (a un menú) se ha pulsado fuera de él
    público constante EV_SALE = 9               ; el ratón ya no está encima
    público constante EV_MENÚ = 10              ; se ha cerrado el menú que pidió: a, la opción elegida (desde 0; SIN_ELEGIR si ninguna); b, su etiqueta
    público constante EV_MENÚ_VENTANA = 11      ; (a la del fondo) el botón secundario en el título de la ventana a, en el punto (b, c) de la pantalla
    público constante EV_UNIDADES = 12          ; (a todas) ha aparecido o desaparecido una unidad (una memoria USB)
    público constante EV_RUEDA = 13             ; (NAVEGADOR) la rueda del ratón: a, b, dónde; c, los pasos (con signo, en el octeto bajo: arriba, positivos) y las teclas de cambio
    público constante EV_SOLTADO = 14           ; (BLOC, REPRODUCTOR) se ha soltado en ella algo arrastrado desde Mi equipo: a, b, dónde (la ruta, con la llamada 173)
    público constante EV_BANDEJA = 15           ; (REPRODUCTOR) su icono de la bandeja (la 135): a, lo elegido de su menú (0xFFFFFFFF: un clic)
    público constante SIN_ELEGIR = 0xFFFFFFFF
    ; en «c» de los sucesos del ratón: abajo, los botones; luego las teclas de
    ; cambio (c >> 8: 1, Mayús; 2, Control) y las veces seguidas (c >> 16: 1, 2 o 3)
    público constante DESPLAZA_CAMBIO = 8
    público constante RUEDA_LADOS = 0x8000      ; (TOUCHPAD) en «c» de EV_RUEDA: es a los lados (va con Mayús)
    público constante DESPLAZA_VECES = 16

    ; ---- lo que se le puede pedir a una ventana: orden_ventana() ----
    público constante PIDE_RESTAURAR = 1
    público constante PIDE_MOVER = 2
    público constante PIDE_MINIMIZAR = 3
    público constante PIDE_MAXIMIZAR = 4
    público constante PIDE_CERRAR = 5
    público constante PIDE_TAMAÑO = 6           ; (MENÚ) cambiarla de tamaño con las flechas (Alt+Espacio, «Tamaño»)

    ; ---- lo que se puede dibujar desde un programa (la llamada «dibujar») ----
    público constante OP_RECTÁNGULO = 1
    público constante OP_DEGRADADO = 2          ; de color (arriba) a color2 (abajo)
    público constante OP_MARCO = 3
    público constante OP_LÍNEA = 4              ; de (x, ye) a (ancho, alto)
    público constante OP_TEXTO = 5              ; n letras desde «datos»
    público constante OP_TEXTO_FONDO = 6        ; lo mismo, sobre un fondo de color2
    público constante OP_MAPA = 7               ; ancho x alto puntos de 32 bits desde «datos»
    público constante OP_DESPLAZAR = 8          ; el rectángulo, n puntos hacia arriba (hacia abajo si es negativo)
    público constante OP_REDONDEADO = 9         ; con las esquinas de radio n, de color a color2
    público constante OP_NEGRITA = 10           ; texto en negrita
    público constante OP_DISQUETE = 11          ; el logo, de «ancho» puntos de lado

    público tipo Orden = estructura             ; lo que se pide dibujar
        op: nat32
        x, ye, ancho, alto: ent32
        tinta, tinta2: nat32
        datos: puntero a byte
        n: ent32
    fin

    público tipo Evento = estructura
        clase, a, b, c: nat32
    fin

    constante COLA_EV = 32
    ; (PUNTEROS) una zona de lo de dentro de una ventana con su forma del puntero
    público constante MAX_ZONAS = 16
    público tipo Zona = estructura
        x, ye, ancho, alto: ent32
        forma: nat32
    fin
    constante LEJOS = 8192                      ; ninguna medida de un dibujo pasa de aquí
    constante DEL_NÚCLEO = 14                   ; (MENÚ: eran 10) las ventanas que se guardan para el núcleo (la barra, el menú, el fondo, los cuadros, un menú emergente, el globo de los avisos)

    público tipo Ventana = estructura
        usada: bool
        id: nat32                               ; su número (no se repite)
        dueño: nat32                            ; la tarea que la hizo (0: el núcleo)
        banderas: nat32
        px, py, ancho, alto: ent32              ; dónde está en la pantalla, y lo que mide entera
        gx, gy, gancho, galto: ent32            ; lo que medía antes de maximizarla
        título: arreglo [MAX_TÍTULO] de byte
        memoria: puntero a byte                 ; sus puntos (del montón)
        todo: Lienzo                            ; la ventana entera
        dentro: Lienzo                          ; lo de dentro del marco
        cola: arreglo [COLA_EV] de Evento
        ent, sal: nat32
        forma: nat32                            ; (PUNTEROS) la del puntero encima de lo de dentro (la llamada 177)
        n_zonas: nat32                          ; (PUNTEROS) y la de unas zonas de dentro (la última que pide, la que vale)
        zonas: arreglo [MAX_ZONAS] de Zona
    fin

    ; ---- los colores del marco (los propios de Hispa-Pentium) ----
    constante AZUL_ARRIBA = 0x3F8DEA
    constante AZUL_ABAJO = 0x1A5AB6
    constante GRIS_ARRIBA = 0x9DB7D9
    constante GRIS_ABAJO = 0x7391BD
    constante CIERRE_ARRIBA = 0xF08A4C          ; el botón de cerrar, del naranja del disquete
    constante CIERRE_ABAJO = 0xCC531C
    público constante CARA = 0xF1F5FB           ; el fondo de una ventana recién hecha
    constante BLANCO = 0xFFFFFF

    público variable ventanas: arreglo [MAX_VENTANAS] de Ventana
    público variable orden: arreglo [MAX_VENTANAS] de nat32     ; de la de más atrás a la de más adelante
    público variable cuántas: nat32
    público variable activa: ent32 = -1         ; la ventana activa (su sitio en «ventanas»), o -1
    público variable cambios: nat32             ; sube cada vez que cambia algo que se ve en la barra de tareas
    público variable tapiz: Lienzo              ; el fondo del escritorio (lo pinta escritorio.cas)
    público variable emergente: nat32           ; el menú abierto: si se pulsa fuera, se le dice (EV_FUERA)
    público variable teclas_a: nat32            ; la ventana que se lleva las teclas (0: la activa)
    público variable ventana_inicio: nat32      ; la que recibe la tecla del logo
    público variable ventana_fondo: nat32       ; la que recibe lo que cae en el tapiz y el botón secundario en los títulos
    público variable alto_barra: ent32          ; lo que ocupa abajo la barra de tareas (no lo tapa una maximizada)
    público variable alto_dock: ent32           ; (dock) lo que ocupa el dock encima de ella (DATO_ALTO_LIBRE)
    público variable composiciones: nat32       ; las veces que se ha recompuesto un trozo
    público variable en_tapiz: bool             ; (MENÚ) lo último que se ha pulsado es el tapiz (Alt+F4: «Apagar el equipo»)
    ; (USUARIOS) la pantalla de entrada (entrada.cas): mientras está, va por
    ; delante de todas (también de las que se hagan luego) y se lleva todas
    ; las teclas (ni el logo ni Alt+Tab ni Ctrl+Alt+Supr la saltan)
    público variable cortina: nat32
    variable tam_teclas: ent32 = -1             ; (MENÚ) la ventana que cambia de tamaño con las flechas

    variable trasero: Lienzo                    ; el doble búfer
    variable siguiente_id: nat32
    variable cerrojo: Cerrojo
    ; lo sucio
    constante MAX_SUCIOS = 8
    variable sx, sy, sa, sl: arreglo [MAX_SUCIOS] de ent32
    variable sucios: nat32
    ; el ratón
    variable flecha_x, flecha_y: ent32          ; dónde está pintada la flecha
    público variable flecha_escondida: nat32    ; (JUEGOS) la tarea que la esconde mientras su ventana es la activa (0: nadie)
    variable botones_antes: nat32
    variable arrastrada: ent32 = -1             ; la ventana que se está moviendo
    variable arr_dx, arr_dy: ent32
    variable mov_suelto: bool                   ; se mueve sin botón pulsado (desde su menú): hasta el clic siguiente
    ; cambiar el tamaño: la ventana que se estira, de qué lados, y cómo estaba
    constante LADO_IZQUIERDO = 1
    constante LADO_DERECHO = 2
    constante LADO_ARRIBA = 4
    constante LADO_ABAJO = 8
    constante AGARRE = 3                        ; lo que se puede agarrar por fuera del borde
    constante ESQUINA = 14                      ; lo que mide una esquina, a lo largo del borde
    constante ANCHO_MÍNIMO = 200
    constante ALTO_MÍNIMO = 140
    variable estirada: ent32 = -1
    variable est_lados: nat32
    variable est_x, est_y, est_px, est_py, est_an, est_al: ent32
    ; los clics seguidos (el doble y el triple)
    público variable tics_doble: nat32 = 45     ; (PANEL) lo que puede tardar el segundo clic (Panel de control > Ratón)
    público variable pasos_por_paso: ent32 = 1  ; (PANEL) los pasos de la rueda por cada uno del ratón (los renglones del Panel, de tres en tres)
    ; (PANEL) el color del título de la ventana activa (Panel de control > Personalización: el tema)
    público variable título_arriba: nat32 = AZUL_ARRIBA
    público variable título_abajo: nat32 = AZUL_ABAJO
    público variable título_tinta: nat32 = BLANCO
    variable clic_ventana, clic_botones, clic_tic, clic_veces: nat32
    variable clic_x, clic_y: ent32
    variable capturada: ent32 = -1              ; la que recibió el clic (hasta que se suelte)
    variable debajo: ent32 = -1                 ; la última sobre la que estaba el ratón
    variable último_clic, última_clicada: nat32
    ; (PUNTEROS) el puntero: las formas (cursores.cas), los ajustes (los
    ; pone apuntero.cas: el Panel de control > Ratón > Puntero) y las piezas
    ; que se ven encima de la pantalla
    público variable p_juego, p_tamaño, p_color: nat32
    público variable p_rastro, p_localizar, p_espejo: bool
    público variable ocupado_hasta: nat32       ; hasta entonces (en tics), la flecha con la espera (se está abriendo un programa)
    público variable forma_vista: nat32         ; la forma que se ve ahora (la dice el escritorio por el puerto serie)
    público variable formas_vistas: nat32       ; sube cada vez que cambia
    público variable localizados: nat32         ; las veces que se ha localizado con Control (también lo dice el escritorio)
    público variable rastros_vistos: nat32      ; las veces que ha salido el rastro (al empezar a moverlo; lo dice el escritorio)
    público variable copias_rastro: nat32       ; y con cuántas copias
    variable copias_antes: nat32
    constante MAX_PIEZAS_V = 12
    constante BALDOSA = 128
    constante PZ_IMAGEN = 1
    constante PZ_ANILLOS = 2
    tipo Pieza = estructura
        clase: nat32
        x, ye, ancho, alto: ent32               ; lo que tapa en la pantalla
        px, py: ent32                           ; el punto activo (o el centro de los anillos)
        imagen: puntero a Imagen
        clave, color, alfa: nat32
        radio, grueso: ent32
    fin
    variable nuevas, viejas: arreglo [MAX_PIEZAS_V] de Pieza
    variable n_nuevas, n_viejas: nat32
    variable bx0, by0, bx1, by1: ent32          ; lo que tapan las nuevas, todas juntas
    variable baldosa: Lienzo
    variable hay_baldosa: bool
    ; el rastro: las últimas posiciones y cuándo
    constante MAX_RASTRO = 8
    constante VIDA_RASTRO = 14
    variable ras_x, ras_y: arreglo [MAX_RASTRO] de ent32
    variable ras_t: arreglo [MAX_RASTRO] de nat32
    variable ras_i: nat32
    ; localizar el puntero: Control pulsado y suelto, solo
    constante VIDA_ANILLOS = 100                ; un segundo
    variable loc_desde: nat32
    variable loc_activo, ctrl_antes, ctrl_solo: bool

    ; -------------------------------------------------------------------------
    ;  Lo sucio y componer
    ; -------------------------------------------------------------------------
    función menor(a: ent32, b: ent32): ent32
        si a < b entonces devolver a fin
        devolver b
    fin

    función mayor(a: ent32, b: ent32): ent32
        si a > b entonces devolver a fin
        devolver b
    fin

    ; apunta un rectángulo de la pantalla para recomponerlo
    función ensuciar(x: ent32, yy: ent32, an: ent32, al: ent32)
        variable i: nat32
        variable x2, y2: ent32
        x2 := menor(x + an, pantalla.ancho)
        y2 := menor(yy + al, pantalla.alto)
        x := mayor(x, 0)
        yy := mayor(yy, 0)
        si x2 <= x o y2 <= yy entonces devolver fin
        ; si toca a uno que ya había, se junta con él
        i := 0
        mientras i < sucios hacer
            si x <= sx[i] + sa[i] y x2 >= sx[i] y yy <= sy[i] + sl[i] y y2 >= sy[i] entonces
                x2 := mayor(x2, sx[i] + sa[i])
                y2 := mayor(y2, sy[i] + sl[i])
                sx[i] := menor(x, sx[i])
                sy[i] := menor(yy, sy[i])
                sa[i] := x2 - sx[i]
                sl[i] := y2 - sy[i]
                devolver
            fin
            i := i + 1
        fin
        si sucios < MAX_SUCIOS entonces
            sx[sucios] := x
            sy[sucios] := yy
            sa[sucios] := x2 - x
            sl[sucios] := y2 - yy
            sucios := sucios + 1
            devolver
        fin
        ; no caben más: todos en uno
        para i desde 0 hasta sucios - 1 hacer
            x2 := mayor(x2, sx[i] + sa[i])
            y2 := mayor(y2, sy[i] + sl[i])
            x := menor(x, sx[i])
            yy := menor(yy, sy[i])
        fin
        sx[0] := x
        sy[0] := yy
        sa[0] := x2 - x
        sl[0] := y2 - yy
        sucios := 1
    fin

    función con_marco(ref v: Ventana): bool
        devolver v.banderas yb SIN_MARCO = 0
    fin

    función se_ve(ref v: Ventana): bool
        devolver v.usada y v.banderas yb (OCULTA ob MINIMIZADA) = 0
    fin

    ; ¿lleva las esquinas redondas y la sombra? (una con marco, sin maximizar)
    función suelta(ref v: Ventana): bool
        devolver v.banderas yb (SIN_MARCO ob MAXIMIZADA) = 0 o v.banderas yb REDONDA <> 0
    fin

    ; apunta la ventana entera (con su sombra) para recomponerla
    función ensuciar_ventana(ref v: Ventana)
        ensuciar(v.px, v.py, v.ancho + SOMBRA, v.alto + SOMBRA)
    fin

    ; oscurece en el doble búfer lo que cae de ese rectángulo dentro del
    ; trozo que se está componiendo
    función sombra(x: ent32, yy: ent32, an: ent32, al: ent32, k: nat32, rx: ent32, ry: ent32, ran: ent32, ral: ent32)
        variable x2, y2: ent32
        x2 := menor(x + an, rx + ran)
        y2 := menor(yy + al, ry + ral)
        x := mayor(x, rx)
        yy := mayor(yy, ry)
        si x2 > x y y2 > yy entonces oscurecer(trasero, x, yy, x2 - x, y2 - yy, k) fin
    fin

    ; lo que cae de una ventana en el trozo (rx, ry, ran, ral), al doble búfer
    función pinta_ventana(ref v: Ventana, rx: ent32, ry: ent32, ran: ent32, ral: ent32)
        variable x1, y1, x2, y2, j, f, s, a, b: ent32
        si suelta(v) entonces
            ; su sombra, antes: a la derecha y por debajo
            sombra(v.px + v.ancho, v.py + SOMBRA + 3, SOMBRA - 2, v.alto - 3, 176, rx, ry, ran, ral)
            sombra(v.px + v.ancho + SOMBRA - 2, v.py + SOMBRA + 5, 2, v.alto - 5, 222, rx, ry, ran, ral)
            sombra(v.px + SOMBRA + 3, v.py + v.alto, v.ancho - SOMBRA - 3, SOMBRA - 2, 176, rx, ry, ran, ral)
            sombra(v.px + SOMBRA + 5, v.py + v.alto + SOMBRA - 2, v.ancho - SOMBRA - 3, 2, 222, rx, ry, ran, ral)
        fin
        x1 := mayor(rx, v.px)
        y1 := mayor(ry, v.py)
        x2 := menor(rx + ran, v.px + v.ancho)
        y2 := menor(ry + ral, v.py + v.alto)
        si x2 <= x1 o y2 <= y1 entonces devolver fin
        si suelta(v) entonces
            ; las filas de las esquinas redondas, una a una y más cortas
            j := y1
            mientras j < y2 y j - v.py < RADIO hacer
                f := j - v.py
                s := sangría(RADIO, f)
                a := mayor(x1, v.px + s)
                b := menor(x2, v.px + v.ancho - s)
                si b > a entonces copiar_lienzo(trasero, a, j, v.todo, a - v.px, f, b - a, 1) fin
                j := j + 1
            fin
            y1 := j
        fin
        si y2 <= y1 entonces devolver fin
        si v.banderas yb TRASLÚCIDA <> 0 entonces
            ; (dock) punto a punto: lo transparente deja ver lo de debajo
            mientras y1 < y2 hacer
                f := x1
                mientras f < x2 hacer
                    s := ent32(v.todo.puntos[(y1 - v.py) * ent32(v.todo.salto) + f - v.px])
                    si nat32(s) yb TRANSPARENTE = 0 entonces trasero.puntos[y1 * ent32(trasero.salto) + f] := nat32(s) fin
                    f := f + 1
                fin
                y1 := y1 + 1
            fin
            devolver
        fin
        copiar_lienzo(trasero, x1, y1, v.todo, x1 - v.px, y1 - v.py, x2 - x1, y2 - y1)
    fin

    ; -------------------------------------------------------------------------
    ;  (PUNTEROS) El puntero: las piezas encima de la pantalla
    ; -------------------------------------------------------------------------
    ; la forma del puntero en (x, yy) de la ventana i (lo de dentro)
    función forma_en(i: ent32, x: ent32, yy: ent32): nat32
        variable k: ent32
        k := ent32(ventanas[i].n_zonas) - 1
        mientras k >= 0 hacer
            si x >= ventanas[i].zonas[k].x y yy >= ventanas[i].zonas[k].ye y x < ventanas[i].zonas[k].x + ventanas[i].zonas[k].ancho y yy < ventanas[i].zonas[k].ye + ventanas[i].zonas[k].alto entonces
                devolver ventanas[i].zonas[k].forma
            fin
            k := k - 1
        fin
        devolver ventanas[i].forma
    fin

    ; la forma que toca ahora donde está la flecha
    función forma_ahora(): nat32
        variable i: ent32
        variable lados, f: nat32
        si estirada >= 0 entonces devolver forma_de(est_lados) fin
        si mov_suelto entonces devolver P_MOVER fin
        si arrastrada >= 0 entonces devolver P_FLECHA fin
        i := capturada
        lados := 0
        si i < 0 entonces
            i := ventana_o_borde(flecha_x, flecha_y, lados)
            si i >= 0 y lados <> 0 entonces devolver forma_de(lados) fin
        fin
        f := P_FLECHA
        si i >= 0 y ventanas[i].usada y está_dentro(i, flecha_x, flecha_y) entonces f := forma_en(i, dentro_x(i, flecha_x), dentro_y(i, flecha_y)) fin
        si f >= N_FORMAS entonces f := P_FLECHA fin
        si f = P_FLECHA y ocupado_hasta <> 0 entonces
            si tics < ocupado_hasta entonces f := P_FLECHA_ESPERA sino ocupado_hasta := 0 fin
        fin
        devolver f
    fin

    función medios_de(t: nat32): ent32
        según nat16(t)
            caso 1: devolver 3
            caso 2: devolver 4
            caso 3: devolver 6
        fin
        devolver 2
    fin

    función pieza_imagen(im: puntero a Imagen, x: ent32, yy: ent32, alfa: nat32)
        variable k: nat32
        si im = nulo o n_nuevas >= MAX_PIEZAS_V entonces devolver fin
        k := n_nuevas
        nuevas[k].clase := PZ_IMAGEN
        nuevas[k].px := x
        nuevas[k].py := yy
        nuevas[k].x := x - im.ox
        nuevas[k].ye := yy - im.oy
        nuevas[k].ancho := im.an
        nuevas[k].alto := im.al
        nuevas[k].imagen := im
        nuevas[k].clave := im.clave
        nuevas[k].color := p_color
        nuevas[k].alfa := alfa
        nuevas[k].radio := 0
        nuevas[k].grueso := 0
        n_nuevas := n_nuevas + 1
    fin

    ; las piezas que tocan ahora: el rastro, los anillos y el puntero
    función construye_piezas()
        variable f, k, edad, alfa: nat32
        variable i: ent32
        variable im: puntero a Imagen
        variable r, g, m: ent32
        n_nuevas := 0
        ; (JUEGOS) un juego que la ha escondido (ShowCursor), con su ventana delante
        si flecha_escondida <> 0 y activa >= 0 y ventanas[activa].usada y ventanas[activa].dueño = flecha_escondida entonces devolver fin
        f := forma_ahora()
        si f <> forma_vista entonces
            forma_vista := f
            formas_vistas := formas_vistas + 1
        fin
        k := 0
        si animada(f) entonces k := (tics div 12) mod 8 fin
        im := imagen_de(f, p_juego, p_tamaño, p_espejo, k)
        si im = nulo entonces im := imagen_de(P_FLECHA, J_CLÁSICA, 0, falso, 0) fin
        m := medios_de(p_tamaño)
        ; los anillos que se cierran (localizar el puntero)
        si loc_activo entonces
            edad := tics - loc_desde
            si edad >= VIDA_ANILLOS entonces
                loc_activo := falso
            sino
                r := 4 * m + ent32(VIDA_ANILLOS - edad) * (m + 4) div 6
                g := 1 + m div 2
                k := n_nuevas
                nuevas[k].clase := PZ_ANILLOS
                nuevas[k].px := flecha_x
                nuevas[k].py := flecha_y
                nuevas[k].x := flecha_x - r - g - 3
                nuevas[k].ye := flecha_y - r - g - 3
                nuevas[k].ancho := 2 * (r + g + 3) + 1
                nuevas[k].alto := 2 * (r + g + 3) + 1
                nuevas[k].imagen := nulo
                nuevas[k].clave := 0
                nuevas[k].color := 0
                nuevas[k].alfa := 256
                nuevas[k].radio := r
                nuevas[k].grueso := g
                n_nuevas := n_nuevas + 1
            fin
        fin
        ; el rastro: donde estuvo hace poco (lo más viejo, más transparente)
        r := ent32(n_nuevas)
        si p_rastro entonces
            para i desde 1 hasta MAX_RASTRO - 1 hacer
                k := (ras_i + nat32(i)) mod MAX_RASTRO
                edad := tics - ras_t[k]
                si ras_t[k] <> 0 y edad < VIDA_RASTRO y (ras_x[k] <> flecha_x o ras_y[k] <> flecha_y) entonces
                    alfa := 40 + 150 * (VIDA_RASTRO - edad) div VIDA_RASTRO
                    pieza_imagen(im, ras_x[k], ras_y[k], alfa)
                fin
            fin
        fin
        ; (cuántas copias: si sale ahora, se apunta)
        k := n_nuevas - nat32(r)
        si k > 0 y copias_antes = 0 entonces
            rastros_vistos := rastros_vistos + 1
            copias_rastro := k
        fin
        copias_antes := k
        pieza_imagen(im, flecha_x, flecha_y, 256)
        ; lo que tapan todas juntas
        bx0 := 1000000
        by0 := 1000000
        bx1 := -1000000
        by1 := -1000000
        k := 0
        mientras k < n_nuevas hacer
            bx0 := menor(bx0, nuevas[k].x)
            by0 := menor(by0, nuevas[k].ye)
            bx1 := mayor(bx1, nuevas[k].x + nuevas[k].ancho)
            by1 := mayor(by1, nuevas[k].ye + nuevas[k].alto)
            k := k + 1
        fin
    fin

    función piezas_cambiadas(): bool
        variable k: nat32
        si n_nuevas <> n_viejas entonces devolver cierto fin
        k := 0
        mientras k < n_nuevas hacer
            si nuevas[k].clase <> viejas[k].clase o nuevas[k].x <> viejas[k].x o nuevas[k].ye <> viejas[k].ye o nuevas[k].ancho <> viejas[k].ancho o nuevas[k].alto <> viejas[k].alto entonces devolver cierto fin
            si nuevas[k].clave <> viejas[k].clave o nuevas[k].color <> viejas[k].color o nuevas[k].alfa <> viejas[k].alfa o nuevas[k].radio <> viejas[k].radio entonces devolver cierto fin
            k := k + 1
        fin
        devolver falso
    fin

    función guarda_piezas()
        variable k: nat32
        k := 0
        mientras k < n_nuevas hacer
            viejas[k].clase := nuevas[k].clase
            viejas[k].x := nuevas[k].x
            viejas[k].ye := nuevas[k].ye
            viejas[k].ancho := nuevas[k].ancho
            viejas[k].alto := nuevas[k].alto
            viejas[k].clave := nuevas[k].clave
            viejas[k].color := nuevas[k].color
            viejas[k].alfa := nuevas[k].alfa
            viejas[k].radio := nuevas[k].radio
            k := k + 1
        fin
        n_viejas := n_nuevas
    fin

    ; pone en la pantalla el rectángulo (x, yy, an, al): lo del doble búfer
    ; con las piezas encima, de baldosa en baldosa
    función con_piezas(x: ent32, yy: ent32, an: ent32, al: ent32)
        variable x2, y2, tx, ty, ta, tl: ent32
        variable k: nat32
        x2 := menor(x + an, pantalla.ancho)
        y2 := menor(yy + al, pantalla.alto)
        x := mayor(x, 0)
        yy := mayor(yy, 0)
        si x2 <= x o y2 <= yy entonces devolver fin
        si no hay_baldosa entonces
            ; (sin memoria para la baldosa: como antes, encima de la pantalla)
            copiar_lienzo(pantalla, x, yy, trasero, x, yy, x2 - x, y2 - yy)
            k := 0
            mientras k < n_nuevas hacer
                si nuevas[k].clase = PZ_IMAGEN entonces pinta_imagen(pantalla, nuevas[k].px, nuevas[k].py, nuevas[k].imagen, nuevas[k].color, nuevas[k].alfa) fin
                k := k + 1
            fin
            volcar(x, yy, x2 - x, y2 - yy)
            devolver
        fin
        ty := yy
        mientras ty < y2 hacer
            tl := menor(BALDOSA, y2 - ty)
            tx := x
            mientras tx < x2 hacer
                ta := menor(BALDOSA, x2 - tx)
                copiar_lienzo(baldosa, 0, 0, trasero, tx, ty, ta, tl)
                k := 0
                mientras k < n_nuevas hacer
                    si nuevas[k].x < tx + ta y nuevas[k].x + nuevas[k].ancho > tx y nuevas[k].ye < ty + tl y nuevas[k].ye + nuevas[k].alto > ty entonces
                        si nuevas[k].clase = PZ_IMAGEN entonces
                            pinta_imagen(baldosa, nuevas[k].px - tx, nuevas[k].py - ty, nuevas[k].imagen, nuevas[k].color, nuevas[k].alfa)
                        sino
                            pinta_anillos(baldosa, nuevas[k].px - tx, nuevas[k].py - ty, nuevas[k].radio, nuevas[k].grueso)
                        fin
                    fin
                    k := k + 1
                fin
                copiar_lienzo(pantalla, tx, ty, baldosa, 0, 0, ta, tl)
                volcar(tx, ty, ta, tl)
                tx := tx + ta
            fin
            ty := ty + tl
        fin
    fin

    ; un trozo recompuesto, a la pantalla: lo que no tapan las piezas, tal
    ; cual; lo que sí, con ellas
    función trozo_a_pantalla(x: ent32, yy: ent32, an: ent32, al: ent32)
        variable ix0, iy0, ix1, iy1: ent32
        ix0 := mayor(x, bx0)
        iy0 := mayor(yy, by0)
        ix1 := menor(x + an, bx1)
        iy1 := menor(yy + al, by1)
        si n_nuevas = 0 o ix1 <= ix0 o iy1 <= iy0 entonces
            copiar_lienzo(pantalla, x, yy, trasero, x, yy, an, al)
            volcar(x, yy, an, al)
            devolver
        fin
        ; arriba y abajo, enteros; a los lados, en las filas de las piezas
        si iy0 > yy entonces
            copiar_lienzo(pantalla, x, yy, trasero, x, yy, an, iy0 - yy)
            volcar(x, yy, an, iy0 - yy)
        fin
        si yy + al > iy1 entonces
            copiar_lienzo(pantalla, x, iy1, trasero, x, iy1, an, yy + al - iy1)
            volcar(x, iy1, an, yy + al - iy1)
        fin
        si ix0 > x entonces
            copiar_lienzo(pantalla, x, iy0, trasero, x, iy0, ix0 - x, iy1 - iy0)
            volcar(x, iy0, ix0 - x, iy1 - iy0)
        fin
        si x + an > ix1 entonces
            copiar_lienzo(pantalla, ix1, iy0, trasero, ix1, iy0, x + an - ix1, iy1 - iy0)
            volcar(ix1, iy0, x + an - ix1, iy1 - iy0)
        fin
        con_piezas(ix0, iy0, ix1 - ix0, iy1 - iy0)
    fin

    ; las piezas han cambiado: donde estaban y donde están, otra vez (los
    ; rectángulos que se tocan, juntos)
    función repone_piezas()
        variable rx0, ry0, rx1, ry1: arreglo [24] de ent32
        variable n, i, j: nat32
        variable junta: bool
        n := 0
        i := 0
        mientras i < n_viejas hacer
            rx0[n] := viejas[i].x
            ry0[n] := viejas[i].ye
            rx1[n] := viejas[i].x + viejas[i].ancho
            ry1[n] := viejas[i].ye + viejas[i].alto
            n := n + 1
            i := i + 1
        fin
        i := 0
        mientras i < n_nuevas hacer
            rx0[n] := nuevas[i].x
            ry0[n] := nuevas[i].ye
            rx1[n] := nuevas[i].x + nuevas[i].ancho
            ry1[n] := nuevas[i].ye + nuevas[i].alto
            n := n + 1
            i := i + 1
        fin
        ; juntar los que se tocan, hasta que no quede ninguno
        junta := cierto
        mientras junta hacer
            junta := falso
            i := 0
            mientras i < n hacer
                j := i + 1
                mientras j < n hacer
                    si rx0[i] <= rx1[j] y rx0[j] <= rx1[i] y ry0[i] <= ry1[j] y ry0[j] <= ry1[i] entonces
                        rx0[i] := menor(rx0[i], rx0[j])
                        ry0[i] := menor(ry0[i], ry0[j])
                        rx1[i] := mayor(rx1[i], rx1[j])
                        ry1[i] := mayor(ry1[i], ry1[j])
                        n := n - 1
                        rx0[j] := rx0[n]
                        ry0[j] := ry0[n]
                        rx1[j] := rx1[n]
                        ry1[j] := ry1[n]
                        junta := cierto
                    sino
                        j := j + 1
                    fin
                fin
                i := i + 1
            fin
        fin
        i := 0
        mientras i < n hacer
            con_piezas(rx0[i], ry0[i], rx1[i] - rx0[i], ry1[i] - ry0[i])
            i := i + 1
        fin
    fin

    ; (PUNTEROS) Control pulsado y suelto sin nada más: los anillos
    función mira_control(hubo_algo: bool)
        variable c: bool
        c := modificadores() yb MOD_CONTROL <> 0
        si hubo_algo entonces ctrl_solo := falso fin
        si c y no ctrl_antes entonces ctrl_solo := modificadores() = MOD_CONTROL fin
        si no c y ctrl_antes y ctrl_solo y p_localizar entonces
            loc_activo := cierto
            loc_desde := tics
            localizados := localizados + 1
        fin
        si no c entonces ctrl_solo := falso fin
        ctrl_antes := c
    fin

    ; recompone lo sucio: al doble búfer y, de ahí, a la pantalla
    función componer()
        variable i, k: nat32
        variable x, yy, an, al: ent32
        variable cambió: bool
        construye_piezas()                      ; (PUNTEROS)
        cambió := piezas_cambiadas()
        si sucios = 0 y no cambió entonces devolver fin
        si sucios = 0 entonces
            repone_piezas()
            guarda_piezas()
            devolver
        fin
        para i desde 0 hasta sucios - 1 hacer
            x := sx[i]
            yy := sy[i]
            an := sa[i]
            al := sl[i]
            copiar_lienzo(trasero, x, yy, tapiz, x, yy, an, al)
            k := 0
            mientras k < cuántas hacer
                si se_ve(ventanas[orden[k]]) entonces pinta_ventana(ventanas[orden[k]], x, yy, an, al) fin
                k := k + 1
            fin
            trozo_a_pantalla(x, yy, an, al)      ; (PUNTEROS) con las piezas encima, sin parpadear
            composiciones := composiciones + 1
        fin
        sucios := 0
        si cambió entonces repone_piezas() fin
        guarda_piezas()
    fin

    ; -------------------------------------------------------------------------
    ;  El marco de una ventana
    ; -------------------------------------------------------------------------
    ; dónde empieza (a lo ancho) el botón número n del título: 0, cerrar; 1,
    ; maximizar; 2, minimizar
    función botón_x(ref v: Ventana, n: ent32): ent32
        devolver v.ancho - 7 - (n + 1) * BOTÓN_ANCHO - n * 2
    fin

    función pinta_botón(ref v: Ventana, n: ent32, es_activa: bool)
        variable x, cx, cy, i: ent32
        variable arriba, abajo: nat32
        x := botón_x(v, n)
        si n = 0 entonces
            arriba := CIERRE_ARRIBA
            abajo := CIERRE_ABAJO
        sino si es_activa entonces
            arriba := 0x5FA6F5
            abajo := 0x2468C8
        sino
            arriba := 0xAEC4E2
            abajo := 0x86A2CB
        fin
        redondeado(v.todo, x, BOTÓN_Y, BOTÓN_ANCHO, BOTÓN_ALTO, 4, BLANCO, BLANCO, TODAS)
        redondeado(v.todo, x + 1, BOTÓN_Y + 1, BOTÓN_ANCHO - 2, BOTÓN_ALTO - 2, 3, arriba, abajo, TODAS)
        cx := x + BOTÓN_ANCHO div 2
        cy := BOTÓN_Y + BOTÓN_ALTO div 2
        si n = 0 entonces
            ; un aspa
            para i desde 0 hasta 1 hacer
                línea(v.todo, cx - 4 + i, cy - 4, cx + 3 + i, cy + 3, BLANCO)
                línea(v.todo, cx + 3 + i, cy - 4, cx - 4 + i, cy + 3, BLANCO)
            fin
        sino si n = 1 entonces
            si v.banderas yb MAXIMIZADA <> 0 entonces
                ; dos cuadros: volver al tamaño de antes
                marco(v.todo, cx - 2, cy - 5, 8, 7, BLANCO)
                rectángulo(v.todo, cx - 2, cy - 5, 8, 2, BLANCO)
                rectángulo(v.todo, cx - 5, cy - 1, 8, 6, abajo)
                marco(v.todo, cx - 5, cy - 2, 8, 7, BLANCO)
                rectángulo(v.todo, cx - 5, cy - 2, 8, 2, BLANCO)
            sino
                marco(v.todo, cx - 5, cy - 5, 10, 10, BLANCO)
                rectángulo(v.todo, cx - 5, cy - 5, 10, 3, BLANCO)
            fin
        sino
            rectángulo(v.todo, cx - 5, cy + 2, 9, 3, BLANCO)
        fin
    fin

    ; pinta el marco: el título (con su degradado, el disquete, el nombre y
    ; los botones) y el borde. Lo de dentro no se toca.
    función pinta_marco(ref v: Ventana, es_activa: bool)
        variable arriba, abajo, oscuro: nat32
        variable caben, n: ent32
        si no con_marco(v) entonces devolver fin
        si es_activa entonces
            arriba := título_arriba             ; (PANEL) el tema
            abajo := título_abajo
        sino
            arriba := GRIS_ARRIBA
            abajo := GRIS_ABAJO
        fin
        oscuro := mezcla(abajo, 0, 70)
        si suelta(v) entonces
            ; (lo de fuera de las esquinas redondas no se copia nunca a la pantalla)
            redondeado(v.todo, 0, 0, v.ancho, ALTO_TÍTULO, RADIO, oscuro, oscuro, ARRIBA)
            redondeado(v.todo, 1, 1, v.ancho - 2, ALTO_TÍTULO - 1, RADIO - 1, arriba, abajo, ARRIBA)
            rectángulo(v.todo, RADIO, 1, v.ancho - 2 * RADIO, 1, mezcla(arriba, BLANCO, 110))
        sino
            degradado(v.todo, 0, 0, v.ancho, ALTO_TÍTULO, arriba, abajo)
        fin
        ; el borde: a los lados y abajo, con un filo oscuro por fuera
        rectángulo(v.todo, 0, ALTO_TÍTULO, BORDE, v.alto - ALTO_TÍTULO, abajo)
        rectángulo(v.todo, v.ancho - BORDE, ALTO_TÍTULO, BORDE, v.alto - ALTO_TÍTULO, abajo)
        rectángulo(v.todo, 0, v.alto - BORDE, v.ancho, BORDE, abajo)
        rectángulo(v.todo, 0, ALTO_TÍTULO, 1, v.alto - ALTO_TÍTULO, oscuro)
        rectángulo(v.todo, v.ancho - 1, ALTO_TÍTULO, 1, v.alto - ALTO_TÍTULO, oscuro)
        rectángulo(v.todo, 0, v.alto - 1, v.ancho, 1, oscuro)
        disquete(v.todo, 7, 5, 18)
        ; el nombre, en negrita, con su sombra; lo que quepa
        n := 0
        mientras v.título[n] <> 0 hacer n := n + 1 fin
        caben := (botón_x(v, 2) - 34) div ANCHO_LETRA
        si n > caben entonces n := caben fin
        si n > 0 entonces
            texto_n(v.todo, 31, 7, v.título, n, oscuro)
            texto_n(v.todo, 32, 7, v.título, n, oscuro)
            si es_activa entonces
                texto_n(v.todo, 30, 6, v.título, n, título_tinta)      ; (PANEL) el tema
                texto_n(v.todo, 31, 6, v.título, n, título_tinta)
            sino
                texto_n(v.todo, 30, 6, v.título, n, 0xE6EEF8)
                texto_n(v.todo, 31, 6, v.título, n, 0xE6EEF8)
            fin
        fin
        pinta_botón(v, 0, es_activa)
        si v.banderas yb FIJA = 0 entonces
            pinta_botón(v, 1, es_activa)
            pinta_botón(v, 2, es_activa)
        fin
    fin

    ; pone los dos lienzos de la ventana sobre su memoria
    función pon_lienzos(ref v: Ventana)
        pon_lienzo(v.todo, puntero(v.memoria), v.ancho, v.ancho, v.alto)
        si con_marco(v) entonces
            trozo_de(v.dentro, v.todo, BORDE, ALTO_TÍTULO, v.ancho - 2 * BORDE, v.alto - ALTO_TÍTULO - BORDE)
        sino
            trozo_de(v.dentro, v.todo, 0, 0, v.ancho, v.alto)
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Las ventanas: buscarlas, ordenarlas, sus sucesos
    ; -------------------------------------------------------------------------
    ; el sitio en «ventanas» de la que tiene ese número; -1 si no está
    función busca(id: nat32): ent32
        variable i: ent32
        si id = 0 entonces devolver -1 fin
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].id = id entonces devolver i fin
        fin
        devolver -1
    fin

    función pon_evento(i: ent32, clase: nat32, a: nat32, b: nat32, c: nat32)
        variable k: nat32
        si i < 0 o no ventanas[i].usada entonces devolver fin
        ; un movimiento del ratón detrás de otro (o un tamaño nuevo detrás
        ; de otro): vale con el último
        si (clase = EV_RATÓN_MUEVE o clase = EV_TAMAÑO) y ventanas[i].ent <> ventanas[i].sal entonces
            k := (ventanas[i].ent - 1) mod COLA_EV
            si ventanas[i].cola[k].clase = clase entonces
                ventanas[i].cola[k].a := a
                ventanas[i].cola[k].b := b
                ventanas[i].cola[k].c := c
                devolver
            fin
        fin
        si ventanas[i].ent - ventanas[i].sal >= COLA_EV entonces devolver fin
        k := ventanas[i].ent mod COLA_EV
        ventanas[i].cola[k].clase := clase
        ventanas[i].cola[k].a := a
        ventanas[i].cola[k].b := b
        ventanas[i].cola[k].c := c
        ventanas[i].ent := ventanas[i].ent + 1
    fin

    ; la ventana activa es la de más adelante de las normales que se ven: si
    ; ha cambiado, se repintan los dos marcos y se les dice
    función mira_activa()
        variable k, nueva, vieja: ent32
        nueva := -1
        k := ent32(cuántas) - 1
        mientras k >= 0 y nueva < 0 hacer
            si se_ve(ventanas[orden[k]]) y (ventanas[orden[k]].banderas yb (SIN_MARCO ob ENCIMA) = 0 o ventanas[orden[k]].banderas yb COMPLETA <> 0) entonces nueva := orden[k] fin    ; [WIN32] (o COMPLETA)
            k := k - 1
        fin
        si nueva = activa entonces devolver fin
        vieja := activa
        activa := nueva
        si nueva >= 0 entonces en_tapiz := falso fin  ; (MENÚ)
        cambios := cambios + 1
        si vieja >= 0 y ventanas[vieja].usada entonces
            pinta_marco(ventanas[vieja], falso)
            ensuciar_ventana(ventanas[vieja])
            pon_evento(vieja, EV_FOCO, 0, 0, 0)
        fin
        si nueva >= 0 entonces
            pinta_marco(ventanas[nueva], cierto)
            ensuciar_ventana(ventanas[nueva])
            pon_evento(nueva, EV_FOCO, 1, 0, 0)
        fin
    fin

    función quita_del_orden(i: ent32)
        variable k, j: nat32
        k := 0
        mientras k < cuántas hacer
            si orden[k] = i entonces
                para j desde k + 1 hasta cuántas - 1 hacer orden[j - 1] := orden[j] fin
                cuántas := cuántas - 1
                devolver
            fin
            k := k + 1
        fin
    fin

    ; pone la ventana delante de las de su clase (las de «encima» van
    ; siempre por delante de las normales)
    función al_frente(i: ent32)
        variable k, j: nat32
        quita_del_orden(i)
        k := cuántas
        si ventanas[i].banderas yb ENCIMA = 0 entonces
            mientras k > 0 y ventanas[orden[k - 1]].banderas yb ENCIMA <> 0 hacer k := k - 1 fin
        fin
        j := cuántas
        mientras j > k hacer
            orden[j] := orden[j - 1]
            j := j - 1
        fin
        orden[k] := i
        cuántas := cuántas + 1
        ensuciar_ventana(ventanas[i])
        ; (USUARIOS) la pantalla de entrada, siempre la de más adelante
        si cortina <> 0 y ventanas[i].id <> cortina entonces
            k := nat32(busca(cortina))
            si ent32(k) >= 0 entonces
                quita_del_orden(ent32(k))
                orden[cuántas] := k
                cuántas := cuántas + 1
                ensuciar_ventana(ventanas[k])
            fin
        fin
    fin

    ; cambia el tamaño de la ventana entera: memoria nueva, el marco pintado
    ; y, dentro, lo que había (lo que quepa, desde arriba a la izquierda; lo
    ; nuevo, en blanco): su dueño lo vuelve a pintar (EV_TAMAÑO)
    función cambia_tamaño(i: ent32, x: ent32, yy: ent32, an: ent32, al: ent32): bool
        variable m, vieja: puntero a byte
        variable antes_todo, antes: Lienzo
        m := reservar(nat32(an * al * 4))
        si m = nulo entonces devolver falso fin
        ensuciar_ventana(ventanas[i])
        vieja := ventanas[i].memoria
        pon_lienzo(antes_todo, puntero(vieja), ventanas[i].ancho, ventanas[i].ancho, ventanas[i].alto)
        trozo_de(antes, antes_todo, BORDE, ALTO_TÍTULO, ventanas[i].ancho - 2 * BORDE, ventanas[i].alto - ALTO_TÍTULO - BORDE)
        ventanas[i].memoria := m
        ventanas[i].px := x
        ventanas[i].py := yy
        ventanas[i].ancho := an
        ventanas[i].alto := al
        pon_lienzos(ventanas[i])
        rectángulo(ventanas[i].dentro, 0, 0, an, al, CARA)
        copiar_lienzo(ventanas[i].dentro, 0, 0, antes, 0, 0, antes.ancho, antes.alto)
        liberar(vieja)
        pinta_marco(ventanas[i], i = activa)
        ensuciar_ventana(ventanas[i])
        pon_evento(i, EV_TAMAÑO, nat32(ventanas[i].dentro.ancho), nat32(ventanas[i].dentro.alto), 0)
        devolver cierto
    fin

    ; maximiza la ventana, o la vuelve a como estaba
    función cambia_máximo(i: ent32)
        si ventanas[i].banderas yb (SIN_MARCO ob FIJA) <> 0 entonces devolver fin
        si ventanas[i].banderas yb MAXIMIZADA = 0 entonces
            ventanas[i].gx := ventanas[i].px
            ventanas[i].gy := ventanas[i].py
            ventanas[i].gancho := ventanas[i].ancho
            ventanas[i].galto := ventanas[i].alto
            ventanas[i].banderas := ventanas[i].banderas ob MAXIMIZADA
            si no cambia_tamaño(i, 0, 0, pantalla.ancho, pantalla.alto - alto_barra) entonces
                ventanas[i].banderas := ventanas[i].banderas yb nob MAXIMIZADA
            fin
        sino
            ventanas[i].banderas := ventanas[i].banderas yb nob MAXIMIZADA
            si no cambia_tamaño(i, ventanas[i].gx, ventanas[i].gy, ventanas[i].gancho, ventanas[i].galto) entonces
                ventanas[i].banderas := ventanas[i].banderas ob MAXIMIZADA
            fin
        fin
        cambios := cambios + 1
    fin

    función esconde(i: ent32, bandera: nat32)
        si ventanas[i].banderas yb bandera <> 0 entonces devolver fin
        ensuciar_ventana(ventanas[i])
        ventanas[i].banderas := ventanas[i].banderas ob bandera
        si capturada = i entonces capturada := -1 fin
        si arrastrada = i entonces arrastrada := -1 fin
        si estirada = i entonces estirada := -1 fin
        si debajo = i entonces debajo := -1 fin
        cambios := cambios + 1
        mira_activa()
    fin

    función enseña(i: ent32, bandera: nat32)
        ventanas[i].banderas := ventanas[i].banderas yb nob bandera
        al_frente(i)
        cambios := cambios + 1
        mira_activa()
    fin

    función quita_ventana(i: ent32)
        si no ventanas[i].usada entonces devolver fin
        ensuciar_ventana(ventanas[i])
        quita_del_orden(i)
        liberar(ventanas[i].memoria)
        si emergente = ventanas[i].id entonces emergente := 0 fin
        si teclas_a = ventanas[i].id entonces teclas_a := 0 fin
        ventanas[i].usada := falso
        si ventana_fondo = ventanas[i].id entonces ventana_fondo := 0 fin
        si capturada = i entonces capturada := -1 fin
        si arrastrada = i entonces arrastrada := -1 fin
        si estirada = i entonces estirada := -1 fin
        si debajo = i entonces debajo := -1 fin
        si activa = i entonces activa := -1 fin
        cambios := cambios + 1
        mira_activa()
    fin

    ; -------------------------------------------------------------------------
    ;  Lo que se pide desde fuera (cada cosa, con el cerrojo)
    ; -------------------------------------------------------------------------
    ; una ventana nueva, de la tarea «dueño» (0: del núcleo). Con marco, el
    ; ancho y el alto son los de dentro; sin él, los de toda la ventana. Da
    ; su número, o 0 si no hay sitio o memoria.
    público función crear_ventana(nombre: puntero a byte, x: ent32, yy: ent32, an: ent32, al: ent32, marcas: nat32, dueño: nat32): nat32
        variable i, k: ent32
        variable m: puntero a byte
        si no hay_pantalla o an < 1 o al < 1 o an > 4096 o al > 4096 entonces devolver 0 fin
        si marcas yb SIN_MARCO = 0 entonces
            an := an + 2 * BORDE
            al := al + ALTO_TÍTULO + BORDE
            si an < 120 entonces an := 120 fin
        fin
        tomar(cerrojo)
        ; los programas no pueden gastar todas: quedan las del núcleo
        k := 0
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].dueño <> 0 entonces k := k + 1 fin
        fin
        i := 0
        mientras i < MAX_VENTANAS y ventanas[i].usada hacer i := i + 1 fin
        si i = MAX_VENTANAS o (dueño <> 0 y k >= MAX_VENTANAS - DEL_NÚCLEO) entonces
            soltar(cerrojo)
            devolver 0
        fin
        m := reservar(nat32(an * al * 4))
        si m = nulo entonces
            soltar(cerrojo)
            devolver 0
        fin
        siguiente_id := siguiente_id + 1
        ventanas[i].usada := cierto
        ventanas[i].id := siguiente_id
        ventanas[i].dueño := dueño
        ventanas[i].banderas := marcas yb nob (MINIMIZADA ob MAXIMIZADA)
        ventanas[i].px := x
        ventanas[i].py := yy
        ventanas[i].ancho := an
        ventanas[i].alto := al
        ventanas[i].memoria := m
        ventanas[i].ent := 0
        ventanas[i].sal := 0
        ventanas[i].forma := P_FLECHA           ; (PUNTEROS)
        ventanas[i].n_zonas := 0
        si dueño <> 0 entonces ocupado_hasta := 0 fin      ; (PUNTEROS) el programa ya tiene su ventana: sin la espera
        k := 0
        mientras k < MAX_TÍTULO - 1 y nombre[k] <> 0 hacer
            ventanas[i].título[k] := nombre[k]
            k := k + 1
        fin
        ventanas[i].título[k] := 0
        pon_lienzos(ventanas[i])
        rectángulo(ventanas[i].todo, 0, 0, an, al, CARA)
        pinta_marco(ventanas[i], falso)
        al_frente(i)
        cambios := cambios + 1
        mira_activa()
        k := ent32(ventanas[i].id)
        soltar(cerrojo)
        devolver nat32(k)
    fin

    ; cierra la ventana (si «dueño» no es 0, solo si es suya)
    público función cerrar_ventana(id: nat32, dueño: nat32): bool
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            soltar(cerrojo)
            devolver falso
        fin
        quita_ventana(i)
        soltar(cerrojo)
        devolver cierto
    fin

    ; cierra todas las ventanas de una tarea (que acaba)
    público función cerrar_ventanas_de(dueño: nat32)
        variable i: ent32
        si no hay_pantalla o dueño = 0 entonces devolver fin
        tomar(cerrojo)
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].dueño = dueño entonces quita_ventana(i) fin
        fin
        soltar(cerrojo)
    fin

    ; el suceso siguiente de la ventana: cierto si lo había. Si la ventana no
    ; existe (o no es de ese dueño), «clase» queda en 0xFFFFFFFF.
    público función saca_evento(id: nat32, dueño: nat32, ref e: Evento): bool
        variable i: ent32
        variable k: nat32
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            e.clase := 0xFFFFFFFF
            soltar(cerrojo)
            devolver falso
        fin
        si ventanas[i].ent = ventanas[i].sal entonces
            e.clase := 0
            soltar(cerrojo)
            devolver falso
        fin
        k := ventanas[i].sal mod COLA_EV
        e.clase := ventanas[i].cola[k].clase
        e.a := ventanas[i].cola[k].a
        e.b := ventanas[i].cola[k].b
        e.c := ventanas[i].cola[k].c
        ventanas[i].sal := ventanas[i].sal + 1
        soltar(cerrojo)
        devolver cierto
    fin

    ; un suceso para todas las ventanas de los programas (EV_UNIDADES, sin datos)
    público función a_todas(clase: nat32)
        variable i: ent32
        si no hay_pantalla entonces devolver fin
        tomar(cerrojo)
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].dueño <> 0 entonces pon_evento(i, clase, 0, 0, 0) fin
        fin
        soltar(cerrojo)
    fin

    ; cambia el nombre de la ventana (el de su título y el de su botón)
    público función poner_título(id: nat32, dueño: nat32, nombre: puntero a byte): bool
        variable i, k: ent32
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            soltar(cerrojo)
            devolver falso
        fin
        k := 0
        mientras k < MAX_TÍTULO - 1 y nombre[k] <> 0 hacer
            ventanas[i].título[k] := nombre[k]
            k := k + 1
        fin
        ventanas[i].título[k] := 0
        pinta_marco(ventanas[i], i = activa)
        si se_ve(ventanas[i]) entonces ensuciar(ventanas[i].px, ventanas[i].py, ventanas[i].ancho, ALTO_TÍTULO) fin
        cambios := cambios + 1
        soltar(cerrojo)
        devolver cierto
    fin

    ; apunta para recomponer un trozo de lo de dentro de una ventana
    función ensuciar_dentro(i: ent32, x: ent32, yy: ent32, an: ent32, al: ent32)
        variable ox, oy, x2, y2: ent32
        si no se_ve(ventanas[i]) entonces devolver fin
        ox := 0
        oy := 0
        si con_marco(ventanas[i]) entonces
            ox := BORDE
            oy := ALTO_TÍTULO
        fin
        x2 := menor(x + an, ventanas[i].dentro.ancho)
        y2 := menor(yy + al, ventanas[i].dentro.alto)
        x := mayor(x, 0)
        yy := mayor(yy, 0)
        si x2 <= x o y2 <= yy entonces devolver fin
        ensuciar(ventanas[i].px + ox + x, ventanas[i].py + oy + yy, x2 - x, y2 - yy)
    fin

    ; dibuja dentro de la ventana lo que dice la orden (lo piden los
    ; programas: «datos» ya está comprobado). Falso si la ventana no es suya
    ; o la orden no vale.
    público función dibujar(id: nat32, dueño: nat32, ref ord: Orden): bool
        variable i, an, al, x, yy: ent32
        variable otro: Lienzo
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            soltar(cerrojo)
            devolver falso
        fin
        x := ord.x
        yy := ord.ye
        an := ord.ancho
        al := ord.alto
        ; medidas disparatadas, no: el núcleo no se queda dando vueltas por
        ; una línea de mil millones de puntos
        si x < -LEJOS o x > LEJOS o yy < -LEJOS o yy > LEJOS o an < -LEJOS o an > LEJOS o al < -LEJOS o al > LEJOS o ord.n < -LEJOS o ord.n > LEJOS entonces
            soltar(cerrojo)
            devolver falso
        fin
        según ord.op
            caso OP_RECTÁNGULO: rectángulo(ventanas[i].dentro, x, yy, an, al, ord.tinta)
            caso OP_DEGRADADO: degradado(ventanas[i].dentro, x, yy, an, al, ord.tinta, ord.tinta2)
            caso OP_MARCO: marco(ventanas[i].dentro, x, yy, an, al, ord.tinta)
            caso OP_REDONDEADO: redondeado(ventanas[i].dentro, x, yy, an, al, menor(mayor(ord.n, 0), 64), ord.tinta, ord.tinta2, TODAS)
            caso OP_DISQUETE:
                an := menor(mayor(an, 8), 512)
                disquete(ventanas[i].dentro, x, yy, an)
                al := an
            caso OP_LÍNEA:
                línea(ventanas[i].dentro, x, yy, an, al, ord.tinta)
                x := menor(ord.x, ord.ancho)
                yy := menor(ord.ye, ord.alto)
                an := mayor(ord.x, ord.ancho) - x + 1
                al := mayor(ord.ye, ord.alto) - yy + 1
            caso OP_TEXTO, OP_TEXTO_FONDO, OP_NEGRITA:
                an := ord.n * ANCHO_LETRA
                al := ALTO_LETRA
                si ord.op = OP_TEXTO_FONDO entonces rectángulo(ventanas[i].dentro, x, yy, an, al, ord.tinta2) fin
                texto_n(ventanas[i].dentro, x, yy, ord.datos, nat32(ord.n), ord.tinta)
                si ord.op = OP_NEGRITA entonces
                    texto_n(ventanas[i].dentro, x + 1, yy, ord.datos, nat32(ord.n), ord.tinta)
                    an := an + 1
                fin
            caso OP_MAPA:
                pon_lienzo(otro, puntero(ord.datos), nat32(an), an, al)
                copiar_lienzo(ventanas[i].dentro, x, yy, otro, 0, 0, an, al)
            caso OP_DESPLAZAR:
                ; el rectángulo sube n puntos (lo que sale por arriba se pierde)
                trozo_de(otro, ventanas[i].dentro, x, yy, an, al)
                copiar_lienzo(otro, 0, -ord.n, otro, 0, 0, otro.ancho, otro.alto)
            si no:
                soltar(cerrojo)
                devolver falso
        fin
        ensuciar_dentro(i, x, yy, an, al)
        soltar(cerrojo)
        devolver cierto
    fin

    ; ---- para el escritorio (el núcleo): dibuja él mismo en sus ventanas ----
    ; lo de dentro de una ventana del núcleo, para dibujar en ella (luego,
    ; repintada())
    público función lienzo_de(id: nat32): puntero a Lienzo
        variable i: ent32
        i := busca(id)
        si i < 0 entonces devolver nulo fin
        devolver dirección(ventanas[i].dentro)
    fin

    ; se ha dibujado en ese trozo de la ventana: hay que recomponerlo
    público función repintada(id: nat32, x: ent32, yy: ent32, an: ent32, al: ent32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces ensuciar_dentro(i, x, yy, an, al) fin
        soltar(cerrojo)
    fin

    ; enseña o esconde una ventana (un menú); al enseñarla pasa delante
    público función mostrar(id: nat32, visible: bool)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces
            ; (MENÚ) si ya se veía, se queda donde está (el dock, al recolocarse,
            ; no se pone delante de un menú abierto)
            si visible y ventanas[i].banderas yb OCULTA <> 0 entonces enseña(i, OCULTA) fin
            si no visible entonces esconde(i, OCULTA) fin
        fin
        soltar(cerrojo)
    fin

    ; mueve una ventana a otro sitio de la pantalla
    público función mover_ventana(id: nat32, x: ent32, yy: ent32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces
            ensuciar_ventana(ventanas[i])
            ventanas[i].px := x
            ventanas[i].py := yy
            ensuciar_ventana(ventanas[i])
        fin
        soltar(cerrojo)
    fin

    ; la pone en el centro de la pantalla (encima de la barra de tareas)
    público función centrar_ventana(id: nat32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces
            ensuciar_ventana(ventanas[i])
            ventanas[i].px := mayor(0, (pantalla.ancho - ventanas[i].ancho) div 2)
            ventanas[i].py := mayor(0, (pantalla.alto - alto_barra - ventanas[i].alto) div 2)
            ensuciar_ventana(ventanas[i])
        fin
        soltar(cerrojo)
    fin

    ; maximiza la ventana (si no lo estaba ya): la llamada 81 (controles-erp, 21/11)
    público función maximizar_ventana(id: nat32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 y ventanas[i].banderas yb MAXIMIZADA = 0 entonces cambia_máximo(i) fin
        soltar(cerrojo)
    fin

    ; lo que hace el botón de una ventana en la barra de tareas: si está
    ; minimizada, vuelve; si es la activa, se minimiza; si no, pasa delante
    público función botón_de_barra(id: nat32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces
            si ventanas[i].banderas yb MINIMIZADA <> 0 entonces
                enseña(i, MINIMIZADA)
            sino si i = activa entonces
                esconde(i, MINIMIZADA)
            sino
                al_frente(i)
                mira_activa()
            fin
        fin
        soltar(cerrojo)
    fin

    ; le pide a una ventana que se cierre (como si se pulsara su botón)
    público función pedir_cierre(id: nat32)
        tomar(cerrojo)
        pon_evento(busca(id), EV_CERRAR, 0, 0, 0)
        soltar(cerrojo)
    fin

    ; (PANEL) el marco de la ventana activa, otra vez (ha cambiado el tema)
    público función repinta_activa()
        tomar(cerrojo)
        si activa >= 0 y ventanas[activa].usada entonces
            pinta_marco(ventanas[activa], cierto)
            ensuciar_ventana(ventanas[activa])
        fin
        soltar(cerrojo)
    fin

    ; todo el escritorio, a recomponer (ha cambiado el tapiz)
    público función repintar_todo()
        tomar(cerrojo)
        ensuciar(0, 0, pantalla.ancho, pantalla.alto)
        soltar(cerrojo)
    fin

    ; un trozo de la pantalla, a recomponer (se ha dibujado en el tapiz)
    público función repintar_trozo(x: ent32, yy: ent32, an: ent32, al: ent32)
        tomar(cerrojo)
        ensuciar(x, yy, an, al)
        soltar(cerrojo)
    fin

    ; deja un suceso en la cola de una ventana (el resultado de un menú)
    público función avisar(id: nat32, clase: nat32, a: nat32, b: nat32, c: nat32)
        tomar(cerrojo)
        pon_evento(busca(id), clase, a, b, c)
        soltar(cerrojo)
    fin

    ; las banderas de una ventana (MINIMIZADA, MAXIMIZADA, FIJA...);
    ; 0xFFFFFFFF si no está
    público función marcas_de(id: nat32): nat32
        variable i: ent32
        variable r: nat32
        tomar(cerrojo)
        i := busca(id)
        r := 0xFFFFFFFF
        si i >= 0 entonces r := ventanas[i].banderas fin
        soltar(cerrojo)
        devolver r
    fin

    ; (BLOC) lo arrastrado desde el explorador se ha soltado en el punto (x,
    ; yy) de la pantalla, encima de la ventana id: si es de un programa, le
    ; llega EV_SOLTADO (con el punto, visto desde dentro). Da su dueño (0: no)
    público función suelta_en(id: nat32, x: ent32, yy: ent32): nat32
        variable i: ent32
        variable r: nat32
        tomar(cerrojo)
        i := busca(id)
        r := 0
        si i >= 0 y ventanas[i].dueño <> 0 entonces
            r := ventanas[i].dueño
            pon_evento(i, EV_SOLTADO, nat32(dentro_x(i, x)), nat32(dentro_y(i, yy)), 0)
        fin
        soltar(cerrojo)
        devolver r
    fin

    ; ¿es de esa tarea la ventana? (0: del núcleo)
    público función es_de(id: nat32, dueño: nat32): bool
        variable i: ent32
        variable r: bool
        tomar(cerrojo)
        i := busca(id)
        r := i >= 0 y ventanas[i].dueño = dueño
        soltar(cerrojo)
        devolver r
    fin

    ; dónde cae en la pantalla el punto (x, yy) de dentro de la ventana
    público función a_pantalla(id: nat32, ref x: ent32, ref yy: ent32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 entonces
            x := x + ventanas[i].px
            yy := yy + ventanas[i].py
            si con_marco(ventanas[i]) entonces
                x := x + BORDE
                yy := yy + ALTO_TÍTULO
            fin
        fin
        soltar(cerrojo)
    fin

    ; lo que se le pide a una ventana desde su menú (el del título o el de
    ; su botón de la barra): restaurarla, moverla, minimizarla, maximizarla o
    ; cerrarla
    público función orden_ventana(id: nat32, qué: nat32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 y con_marco(ventanas[i]) entonces
            según qué
                caso PIDE_RESTAURAR:
                    si ventanas[i].banderas yb MINIMIZADA <> 0 entonces
                        enseña(i, MINIMIZADA)
                    sino si ventanas[i].banderas yb MAXIMIZADA <> 0 entonces
                        cambia_máximo(i)
                    fin
                caso PIDE_MINIMIZAR:
                    si ventanas[i].banderas yb FIJA = 0 entonces esconde(i, MINIMIZADA) fin
                caso PIDE_MAXIMIZAR:
                    si ventanas[i].banderas yb MINIMIZADA <> 0 entonces enseña(i, MINIMIZADA) fin
                    si ventanas[i].banderas yb MAXIMIZADA = 0 entonces cambia_máximo(i) fin
                caso PIDE_CERRAR:
                    pon_evento(i, EV_CERRAR, 0, 0, 0)
                caso PIDE_TAMAÑO:
                    ; (MENÚ) con las flechas, hasta Intro o Esc (o un clic)
                    si elástica(ventanas[i]) y ventanas[i].banderas yb OCULTA = 0 entonces
                        al_frente(i)
                        mira_activa()
                        tam_teclas := i
                    fin
                caso PIDE_MOVER:
                    ; la flecha va a su título y la ventana la sigue, sin
                    ; botón pulsado, hasta el clic siguiente (o Intro, o Esc)
                    si ventanas[i].banderas yb (MINIMIZADA ob MAXIMIZADA ob OCULTA) = 0 entonces
                        al_frente(i)
                        mira_activa()
                        arr_dx := ventanas[i].ancho div 2
                        arr_dy := ALTO_TÍTULO div 2
                        pon_ratón(ventanas[i].px + arr_dx, ventanas[i].py + arr_dy)
                        arrastrada := i
                        mov_suelto := cierto
                    fin
            fin
        fin
        soltar(cerrojo)
    fin

    ; -------------------------------------------------------------------------
    ;  El ratón
    ; -------------------------------------------------------------------------
    ; el punto de la pantalla, visto desde dentro de la ventana
    función dentro_x(i: ent32, x: ent32): ent32
        si con_marco(ventanas[i]) entonces devolver x - ventanas[i].px - BORDE fin
        devolver x - ventanas[i].px
    fin

    función dentro_y(i: ent32, yy: ent32): ent32
        si con_marco(ventanas[i]) entonces devolver yy - ventanas[i].py - ALTO_TÍTULO fin
        devolver yy - ventanas[i].py
    fin

    función está_dentro(i: ent32, x: ent32, yy: ent32): bool
        variable lx, ly: ent32
        lx := dentro_x(i, x)
        ly := dentro_y(i, yy)
        devolver lx >= 0 y ly >= 0 y lx < ventanas[i].dentro.ancho y ly < ventanas[i].dentro.alto
    fin

    ; ¿se puede cambiar de tamaño? (con marco, que no sea un cuadro, ni maximizada)
    función elástica(ref v: Ventana): bool
        devolver v.banderas yb (SIN_MARCO ob FIJA ob MAXIMIZADA) = 0
    fin

    ; los lados por los que se agarra la ventana desde ese punto (que está
    ; en su borde, o un poco por fuera): 0 si no es del borde
    función lados_en(ref v: Ventana, x: ent32, yy: ent32): nat32
        variable lx, ly: ent32
        variable l: nat32
        lx := x - v.px
        ly := yy - v.py
        l := 0
        si lx < BORDE entonces l := l ob LADO_IZQUIERDO fin
        si lx >= v.ancho - BORDE entonces l := l ob LADO_DERECHO fin
        si ly < AGARRE entonces l := l ob LADO_ARRIBA fin
        si ly >= v.alto - BORDE entonces l := l ob LADO_ABAJO fin
        si l = 0 entonces devolver 0 fin
        ; cerca de una esquina, los dos lados
        si l yb (LADO_ARRIBA ob LADO_ABAJO) <> 0 entonces
            si lx < ESQUINA entonces l := l ob LADO_IZQUIERDO fin
            si lx >= v.ancho - ESQUINA entonces l := l ob LADO_DERECHO fin
        fin
        si l yb (LADO_IZQUIERDO ob LADO_DERECHO) <> 0 entonces
            si ly < ESQUINA entonces l := l ob LADO_ARRIBA fin
            si ly >= v.alto - ESQUINA entonces l := l ob LADO_ABAJO fin
        fin
        devolver l
    fin

    ; (dock) ¿es transparente ese punto de la pantalla en la ventana i?
    función transparente_en(i: ent32, x: ent32, yy: ent32): bool
        si ventanas[i].banderas yb TRASLÚCIDA = 0 entonces devolver falso fin
        devolver ventanas[i].todo.puntos[(yy - ventanas[i].py) * ent32(ventanas[i].todo.salto) + x - ventanas[i].px] yb TRANSPARENTE <> 0
    fin

    ; (explorador) la ventana que se ve en ese punto de la pantalla (su
    ; número), o 0 si es el tapiz
    público función ventana_en_punto(x: ent32, yy: ent32): nat32
        variable l: nat32
        variable i: ent32
        tomar(cerrojo)
        i := ventana_o_borde(x, yy, l)
        soltar(cerrojo)
        si i < 0 entonces devolver 0 fin
        si l <> 0 o ventanas[i].banderas yb OCULTA <> 0 entonces devolver 0 fin
        devolver ventanas[i].id
    fin

    ; (dock) ¿tapa alguna ventana con marco (que se vea) ese rectángulo de la pantalla?
    público función tapado(x: ent32, yy: ent32, an: ent32, al: ent32): bool
        variable i: ent32
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si se_ve(ventanas[i]) y ventanas[i].banderas yb SIN_MARCO = 0 entonces
                si ventanas[i].px < x + an y ventanas[i].px + ventanas[i].ancho > x y ventanas[i].py < yy + al y ventanas[i].py + ventanas[i].alto > yy entonces devolver cierto fin
            fin
        fin
        devolver falso
    fin

    ; la ventana de más adelante que está en ese punto, o que se agarra desde
    ; él por su borde («lados»: por cuáles; 0 si no es para cambiar el tamaño)
    función ventana_o_borde(x: ent32, yy: ent32, ref lados: nat32): ent32
        variable k, i: ent32
        lados := 0
        k := ent32(cuántas) - 1
        mientras k >= 0 hacer
            i := orden[k]
            si se_ve(ventanas[i]) entonces
                si x >= ventanas[i].px y yy >= ventanas[i].py y x < ventanas[i].px + ventanas[i].ancho y yy < ventanas[i].py + ventanas[i].alto y no transparente_en(i, x, yy) entonces
                    si elástica(ventanas[i]) entonces lados := lados_en(ventanas[i], x, yy) fin
                    devolver i
                fin
                si elástica(ventanas[i]) y x >= ventanas[i].px - AGARRE y yy >= ventanas[i].py - AGARRE y x < ventanas[i].px + ventanas[i].ancho + AGARRE y yy < ventanas[i].py + ventanas[i].alto + AGARRE entonces
                    lados := lados_en(ventanas[i], x, yy)
                    devolver i
                fin
            fin
            k := k - 1
        fin
        devolver -1
    fin

    ; la forma de la flecha para esos lados
    función forma_de(lados: nat32): nat32
        si lados = 0 entonces devolver P_FLECHA fin
        si lados = LADO_IZQUIERDO o lados = LADO_DERECHO entonces devolver P_TAMAÑO_H fin
        si lados = LADO_ARRIBA o lados = LADO_ABAJO entonces devolver P_TAMAÑO_V fin
        si lados = (LADO_IZQUIERDO ob LADO_ARRIBA) o lados = (LADO_DERECHO ob LADO_ABAJO) entonces devolver P_TAMAÑO_D1 fin
        devolver P_TAMAÑO_D2
    fin

    ; las veces seguidas que se ha pulsado ahí (1, 2 o 3): mismo sitio, mismos
    ; botones y menos de medio segundo
    función cuenta_clic(id: nat32, x: ent32, yy: ent32, nuevos: nat32): nat32
        si id = clic_ventana y nuevos = clic_botones y tics - clic_tic < tics_doble y x - clic_x < 5 y clic_x - x < 5 y yy - clic_y < 5 y clic_y - yy < 5 y clic_veces < 3 entonces
            clic_veces := clic_veces + 1
        sino
            clic_veces := 1
        fin
        clic_ventana := id
        clic_botones := nuevos
        clic_tic := tics
        clic_x := x
        clic_y := yy
        devolver clic_veces
    fin

    ; se ha pulsado un botón del ratón en (x, yy); «b», los que quedan pulsados
    función pulsado(x: ent32, yy: ent32, b: nat32, nuevos: nat32)
        variable i, lx, ly, n: ent32
        variable lados, c: nat32
        ; una ventana que se movía suelta: este clic la deja donde está
        si mov_suelto entonces
            mov_suelto := falso
            arrastrada := -1
            devolver
        fin
        i := ventana_o_borde(x, yy, lados)
        si emergente <> 0 y i <> busca(emergente) entonces pon_evento(busca(emergente), EV_FUERA, 0, 0, 0) fin
        c := b ob (modificadores() << DESPLAZA_CAMBIO)
        tam_teclas := -1                        ; (MENÚ) un clic acaba lo de cambiar el tamaño con las flechas
        si i < 0 entonces en_tapiz := cierto fin    ; (MENÚ)
        si i >= 0 y ventanas[i].banderas yb SIN_MARCO = 0 entonces en_tapiz := falso fin
        si i < 0 entonces
            ; en el tapiz: a la ventana del fondo (la del escritorio), con el
            ; punto de la pantalla
            i := busca(ventana_fondo)
            si i >= 0 entonces
                capturada := i
                pon_evento(i, EV_RATÓN_BAJA, nat32(x), nat32(yy), c ob (cuenta_clic(ventana_fondo, x, yy, nuevos) << DESPLAZA_VECES))
            fin
            devolver
        fin
        si (ventanas[i].banderas yb (SIN_MARCO ob ENCIMA) = 0 o ventanas[i].banderas yb COMPLETA <> 0) y (cuántas = 0 o i <> activa) entonces    ; [WIN32] (o COMPLETA)
            al_frente(i)
            mira_activa()
        fin
        si lados <> 0 entonces
            ; en el borde: con el botón principal, se estira
            si nuevos yb BOTÓN_IZQUIERDO <> 0 entonces
                estirada := i
                est_lados := lados
                est_x := x
                est_y := yy
                est_px := ventanas[i].px
                est_py := ventanas[i].py
                est_an := ventanas[i].ancho
                est_al := ventanas[i].alto
            fin
            devolver
        fin
        si está_dentro(i, x, yy) entonces
            capturada := i
            pon_evento(i, EV_RATÓN_BAJA, nat32(dentro_x(i, x)), nat32(dentro_y(i, yy)), c ob (cuenta_clic(ventanas[i].id, x, yy, nuevos) << DESPLAZA_VECES))
            devolver
        fin
        si no con_marco(ventanas[i]) entonces devolver fin
        lx := x - ventanas[i].px
        ly := yy - ventanas[i].py
        si nuevos yb BOTÓN_IZQUIERDO = 0 entonces
            ; el botón secundario en el título: su menú (lo pone el escritorio)
            si nuevos yb BOTÓN_DERECHO <> 0 y ly < ALTO_TÍTULO entonces pon_evento(busca(ventana_fondo), EV_MENÚ_VENTANA, ventanas[i].id, nat32(x), nat32(yy)) fin
            devolver
        fin
        si ly >= ALTO_TÍTULO entonces devolver fin      ; el borde de un cuadro: nada
        ; ¿en uno de los botones del título?
        si ly >= BOTÓN_Y y ly < BOTÓN_Y + BOTÓN_ALTO entonces
            para n desde 0 hasta 2 hacer
                si lx >= botón_x(ventanas[i], n) y lx < botón_x(ventanas[i], n) + BOTÓN_ANCHO entonces
                    si n = 0 entonces
                        pon_evento(i, EV_CERRAR, 0, 0, 0)
                    sino si ventanas[i].banderas yb FIJA = 0 entonces
                        si n = 1 entonces cambia_máximo(i) sino esconde(i, MINIMIZADA) fin
                    fin
                    devolver
                fin
            fin
        fin
        ; en el título: dos clics seguidos la maximizan; uno, y se arrastra
        si última_clicada = ventanas[i].id y tics - último_clic < 40 entonces
            última_clicada := 0
            cambia_máximo(i)
            devolver
        fin
        última_clicada := ventanas[i].id
        último_clic := tics
        si ventanas[i].banderas yb MAXIMIZADA = 0 entonces
            arrastrada := i
            arr_dx := lx
            arr_dy := ly
        fin
    fin

    función soltado(x: ent32, yy: ent32, b: nat32)
        si b yb BOTÓN_IZQUIERDO = 0 entonces
            si no mov_suelto entonces arrastrada := -1 fin
            estirada := -1
        fin
        si capturada >= 0 entonces
            pon_evento(capturada, EV_RATÓN_SUBE, nat32(dentro_x(capturada, x)), nat32(dentro_y(capturada, yy)), b)
            si b = 0 entonces capturada := -1 fin
        fin
    fin

    ; la ventana que se estira, a la medida que dice el ratón
    función estira(x: ent32, yy: ent32)
        variable nx, ny, an, al, d: ent32
        nx := est_px
        ny := est_py
        an := est_an
        al := est_al
        d := x - est_x
        si est_lados yb LADO_DERECHO <> 0 entonces
            an := est_an + d
            si an < ANCHO_MÍNIMO entonces an := ANCHO_MÍNIMO fin
        sino si est_lados yb LADO_IZQUIERDO <> 0 entonces
            an := est_an - d
            si an < ANCHO_MÍNIMO entonces an := ANCHO_MÍNIMO fin
            nx := est_px + est_an - an
        fin
        d := yy - est_y
        si est_lados yb LADO_ABAJO <> 0 entonces
            al := est_al + d
            si al < ALTO_MÍNIMO entonces al := ALTO_MÍNIMO fin
        sino si est_lados yb LADO_ARRIBA <> 0 entonces
            al := est_al - d
            si al < ALTO_MÍNIMO entonces al := ALTO_MÍNIMO fin
            si est_py + est_al - al < 0 entonces al := est_py + est_al fin
            ny := est_py + est_al - al
        fin
        si an > pantalla.ancho entonces
            an := pantalla.ancho
            si est_lados yb LADO_IZQUIERDO <> 0 entonces nx := est_px + est_an - an fin
        fin
        si al > pantalla.alto entonces
            al := pantalla.alto
            si est_lados yb LADO_ARRIBA <> 0 entonces ny := est_py + est_al - al fin
        fin
        si nx <> ventanas[estirada].px o ny <> ventanas[estirada].py o an <> ventanas[estirada].ancho o al <> ventanas[estirada].alto entonces
            si an = ventanas[estirada].ancho y al = ventanas[estirada].alto entonces
                ensuciar_ventana(ventanas[estirada])
                ventanas[estirada].px := nx
                ventanas[estirada].py := ny
                ensuciar_ventana(ventanas[estirada])
            sino
                cambia_tamaño(estirada, nx, ny, an, al)
            fin
        fin
    fin

    función movido(x: ent32, yy: ent32)
        variable i, nx, ny: ent32
        variable lados: nat32
        si estirada >= 0 entonces
            estira(x, yy)
            devolver
        fin
        si arrastrada >= 0 entonces
            nx := x - arr_dx
            ny := yy - arr_dy
            ; que no se pierda: el título, siempre a mano
            si ny < 0 entonces ny := 0 fin
            si ny > pantalla.alto - alto_barra - ALTO_TÍTULO entonces ny := pantalla.alto - alto_barra - ALTO_TÍTULO fin
            si nx > pantalla.ancho - 60 entonces nx := pantalla.ancho - 60 fin
            si nx < 60 - ventanas[arrastrada].ancho entonces nx := 60 - ventanas[arrastrada].ancho fin
            si nx <> ventanas[arrastrada].px o ny <> ventanas[arrastrada].py entonces
                ensuciar_ventana(ventanas[arrastrada])
                ventanas[arrastrada].px := nx
                ventanas[arrastrada].py := ny
                ensuciar_ventana(ventanas[arrastrada])
            fin
            devolver
        fin
        i := capturada
        lados := 0
        si i < 0 entonces
            i := ventana_o_borde(x, yy, lados)
            si i >= 0 y (lados <> 0 o no está_dentro(i, x, yy)) entonces i := -1 fin
        fin
        si i <> debajo entonces
            pon_evento(debajo, EV_SALE, 0, 0, 0)
            debajo := i
        fin
        si i >= 0 entonces pon_evento(i, EV_RATÓN_MUEVE, nat32(dentro_x(i, x)), nat32(dentro_y(i, yy)), botones_antes) fin
    fin

    ; -------------------------------------------------------------------------
    ;  El pulso: lo llama la tarea del escritorio, cien veces por segundo
    ; -------------------------------------------------------------------------
    público función pulso()
        variable c: Clic
        variable x, yy, vr, nr: ent32
        variable k, i, m, lr: nat32
        tomar(cerrojo)
        ; los botones del ratón, cada cambio donde fue
        mientras saca_clic(c) hacer
            ctrl_solo := falso                  ; (PUNTEROS) Control con un clic: no es localizar
            si c.botones yb nob botones_antes <> 0 entonces pulsado(c.x, c.ye, c.botones, c.botones yb nob botones_antes) fin
            si botones_antes yb nob c.botones <> 0 entonces soltado(c.x, c.ye, c.botones) fin
            botones_antes := c.botones
        fin
        ; y dónde está ahora
        k := sin_interrupciones()
        x := ratón_x
        yy := ratón_y
        reponer(k)
        si x <> flecha_x o yy <> flecha_y entonces
            movido(x, yy)
            flecha_x := x                       ; (PUNTEROS) se pinta al componer (con las piezas)
            flecha_y := yy
            ras_i := (ras_i + 1) mod MAX_RASTRO
            ras_x[ras_i] := x
            ras_y[ras_i] := yy
            ras_t[ras_i] := tics ob 1
        fin
        tp_pulso()                              ; (TOUCHPAD) el botón del toque, y si el touchpad se descoloca
        ; (NAVEGADOR) la rueda: a la ventana de debajo de la flecha
        nr := saca_rueda()
        ; (PANEL) los renglones por paso (Panel de control > Ratón): los
        ; programas desplazan tres por paso; con 6, 9, 12 o 15, más pasos
        si pasos_por_paso > 1 y nr <> 0 entonces
            nr := nr * pasos_por_paso
            si nr > 120 entonces nr := 120 fin
            si nr < -120 entonces nr := -120 fin
        fin
        si nr <> 0 entonces
            si nr > 127 entonces nr := 127 fin
            si nr < -127 entonces nr := -127 fin
            lr := 0
            vr := ventana_o_borde(x, yy, lr)
            si vr >= 0 y lr = 0 y está_dentro(vr, x, yy) entonces
                pon_evento(vr, EV_RUEDA, nat32(dentro_x(vr, x)), nat32(dentro_y(vr, yy)), (nat32(nr) yb 0xFF) ob (modificadores() << DESPLAZA_CAMBIO))
            fin
        fin
        ; (TOUCHPAD) a los lados (el borde de abajo del touchpad, dos dedos):
        ; no hay suceso propio; va como la rueda con Mayús (lo que entiende el
        ; Navegador: hacia arriba, a la izquierda) y RUEDA_LADOS
        nr := saca_rueda_h()
        si nr <> 0 entonces
            si pasos_por_paso > 1 entonces nr := nr * pasos_por_paso fin
            si nr > 120 entonces nr := 120 fin
            si nr < -120 entonces nr := -120 fin
            lr := 0
            vr := ventana_o_borde(x, yy, lr)
            si vr >= 0 y lr = 0 y está_dentro(vr, x, yy) entonces
                pon_evento(vr, EV_RUEDA, nat32(dentro_x(vr, x)), nat32(dentro_y(vr, yy)), (nat32(-nr) yb 0xFF) ob ((modificadores() ob MOD_MAYÚS) << DESPLAZA_CAMBIO) ob RUEDA_LADOS)
            fin
        fin
        ; las teclas: la del logo, a la barra de tareas; las demás, al menú
        ; que esté abierto o a la ventana activa (en «b», si venía con Mayús)
        k := saca_tecla()
        mira_control(k <> 0 o nr <> 0)          ; (PUNTEROS)
        mientras k <> 0 hacer
            m := 0
            si k >= TECLA_CON_MAYÚS entonces
                m := MOD_MAYÚS
                k := k - TECLA_CON_MAYÚS
            fin
            si cortina <> 0 y busca(cortina) >= 0 entonces
                pon_evento(busca(cortina), EV_TECLA, k, m, 0)       ; (USUARIOS) todas, a la pantalla de entrada
            sino si tam_teclas >= 0 y (no ventanas[tam_teclas].usada o k = 27 o k = '\n') entonces
                tam_teclas := -1                ; (MENÚ) acaba lo de cambiar el tamaño con las flechas
            sino si tam_teclas >= 0 y (k = TECLA_IZQUIERDA o k = TECLA_DERECHA o k = TECLA_ARRIBA o k = TECLA_ABAJO) entonces
                tamaño_con_flecha(tam_teclas, k)
            sino si tam_teclas >= 0 entonces
                ; (lo demás no hace nada mientras)
            sino si mov_suelto y (k = TECLA_IZQUIERDA o k = TECLA_DERECHA o k = TECLA_ARRIBA o k = TECLA_ABAJO) entonces
                ; (MENÚ) «Mover» con las flechas: la flecha del ratón lleva la ventana
                según k
                    caso TECLA_IZQUIERDA: pon_ratón(x - PASO_TECLAS, yy)
                    caso TECLA_DERECHA: pon_ratón(x + PASO_TECLAS, yy)
                    caso TECLA_ARRIBA: pon_ratón(x, yy - PASO_TECLAS)
                    caso TECLA_ABAJO: pon_ratón(x, yy + PASO_TECLAS)
                fin
            sino si mov_suelto y (k = 27 o k = '\n') entonces
                mov_suelto := falso
                arrastrada := -1
            sino si k = TECLA_LOGO o (k >= TECLA_ALT_F4 y k <= TECLA_ALT_IMPR) o (k >= TECLA_LOGO_LETRA y k < TECLA_LOGO_LETRA + 26) entonces
                ; (MENÚ) los atajos de todo el sistema: los atiende el escritorio
                pon_evento(busca(ventana_inicio), EV_TECLA, k, 0, 0)
            sino si k = TECLA_F1_ y (activa < 0 o en_tapiz) y teclas_a = 0 entonces
                pon_evento(busca(ventana_inicio), EV_TECLA, k, 0, 0)     ; (MENÚ) F1 en el tapiz: la Ayuda
            sino si teclas_a = 0 y busca(ventana_fondo) >= 0 y (activa < 0 o (en_tapiz y ventanas[activa].banderas yb SIN_MARCO = 0)) entonces
                pon_evento(busca(ventana_fondo), EV_TECLA, k, m, modificadores())    ; (ICONOS) en el tapiz: los iconos, con el teclado
            sino si teclas_a <> 0 entonces
                pon_evento(busca(teclas_a), EV_TECLA, k, m, modificadores())     ; (BLOC) en «c», las teclas de cambio
            sino
                pon_evento(activa, EV_TECLA, k, m, modificadores())
            fin
            k := saca_tecla()
        fin
        componer()
        soltar(cerrojo)
    fin

    ; cambia de sitio y de medida una ventana (con marco, la medida es la de
    ; toda la ventana): la barra de tareas, al cambiar la pantalla. Su dueño
    ; recibe EV_TAMAÑO y la vuelve a pintar. Falso si no hay memoria.
    ; (MENÚ) la fila yy de la pantalla compuesta (el doble búfer, sin la
    ; flecha del ratón): para las capturas (Impr Pant)
    público función fila_de_pantalla(yy: ent32): puntero a nat32
        devolver trasero.puntos + yy * ent32(trasero.salto)
    fin

    ; (MENÚ) Alt+Espacio, «Tamaño»: una flecha estira o encoge la ventana
    ; (por la derecha y por abajo)
    constante PASO_TECLAS = 16
    constante TECLA_F1_ = 0x13B
    función tamaño_con_flecha(i: ent32, k: nat32)
        variable an, al: ent32
        an := ventanas[i].ancho
        al := ventanas[i].alto
        según k
            caso TECLA_IZQUIERDA: an := an - PASO_TECLAS
            caso TECLA_DERECHA: an := an + PASO_TECLAS
            caso TECLA_ARRIBA: al := al - PASO_TECLAS
            caso TECLA_ABAJO: al := al + PASO_TECLAS
        fin
        si an < 160 entonces an := 160 fin
        si al < ALTO_TÍTULO + 60 entonces al := ALTO_TÍTULO + 60 fin
        si ventanas[i].px + an > pantalla.ancho entonces an := pantalla.ancho - ventanas[i].px fin
        si ventanas[i].py + al > pantalla.alto - alto_barra entonces al := pantalla.alto - alto_barra - ventanas[i].py fin
        si an <> ventanas[i].ancho o al <> ventanas[i].alto entonces cambia_tamaño(i, ventanas[i].px, ventanas[i].py, an, al) fin
    fin

    público función recolocar_ventana(id: nat32, x: ent32, yy: ent32, an: ent32, al: ent32): bool
        variable i: ent32
        variable r: bool
        r := falso
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 y an >= 1 y al >= 1 y an <= 4096 y al <= 4096 entonces r := cambia_tamaño(i, x, yy, an, al) fin
        soltar(cerrojo)
        devolver r
    fin

    ; la pantalla cambia de medida en marcha (Configuración): el modo nuevo
    ; (Video.cambia_modo), un doble búfer y un tapiz nuevos (el tapiz, en
    ; blanco: lo vuelve a pintar el escritorio), y las ventanas dentro: las
    ; maximizadas, a la medida nueva (su dueño recibe EV_TAMAÑO); las demás,
    ; donde estaban si caben, y si no, más arriba o más a la izquierda. Falso
    ; si no se puede (no hay memoria, o la tarjeta no da ese modo): todo
    ; queda como estaba.
    público función cambia_pantalla(an: ent32, al: ent32): bool
        variable m1, m2: puntero a byte
        variable n: nat32
        variable i: ent32
        si no hay_pantalla entonces devolver falso fin
        n := nat32(an * al * 4)
        m1 := reservar(n)
        si m1 = nulo entonces devolver falso fin
        m2 := reservar(n)
        si m2 = nulo entonces
            liberar(m1)
            devolver falso
        fin
        tomar(cerrojo)
        si no cambia_modo(nat32(an), nat32(al)) entonces
            soltar(cerrojo)
            liberar(m1)
            liberar(m2)
            devolver falso
        fin
        liberar(puntero(trasero.puntos))
        liberar(puntero(tapiz.puntos))
        pon_lienzo(trasero, puntero(m1), nat32(an), an, al)
        pon_lienzo(tapiz, puntero(m2), nat32(an), an, al)
        rectángulo(tapiz, 0, 0, an, al, 0x154C9C)
        sucios := 0
        n_viejas := 0                           ; (PUNTEROS) la pantalla es otra: no queda nada pintado encima
        pon_medida_ratón(an, al)
        si flecha_x >= an entonces flecha_x := an - 1 fin
        si flecha_y >= al entonces flecha_y := al - 1 fin
        arrastrada := -1
        estirada := -1
        mov_suelto := falso
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].banderas yb SIN_MARCO = 0 entonces
                si ventanas[i].banderas yb MAXIMIZADA <> 0 entonces
                    si no cambia_tamaño(i, 0, 0, an, al - alto_barra) entonces
                        ; (sin memoria para la medida nueva: deja de estar maximizada)
                        ventanas[i].banderas := ventanas[i].banderas yb nob MAXIMIZADA
                    fin
                fin
                ; lo que medía antes de maximizarla, dentro también
                si ventanas[i].gx > an - 60 entonces ventanas[i].gx := mayor(0, an - ventanas[i].gancho) fin
                si ventanas[i].gy > al - alto_barra - ALTO_TÍTULO entonces ventanas[i].gy := mayor(0, al - alto_barra - ventanas[i].galto) fin
                si ventanas[i].banderas yb MAXIMIZADA = 0 entonces
                    si ventanas[i].px + ventanas[i].ancho > an entonces ventanas[i].px := mayor(0, an - ventanas[i].ancho) fin
                    si ventanas[i].py + ventanas[i].alto > al - alto_barra entonces ventanas[i].py := mayor(0, al - alto_barra - ventanas[i].alto) fin
                fin
            fin
        fin
        ensuciar(0, 0, an, al)
        cambios := cambios + 1
        soltar(cerrojo)
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  [WIN32] Lo que piden los programas de Windows (win32.cas)
    ; -------------------------------------------------------------------------
    ; coloca una ventana suya con lo de dentro en (x, yy) de la pantalla y de
    ; an x al (con marco, el marco va por fuera). Falso si no es suya o no
    ; hay memoria; si cambia la medida, le llega EV_TAMAÑO.
    público función colocar_dentro(id: nat32, dueño: nat32, x: ent32, yy: ent32, an: ent32, al: ent32): bool
        variable i: ent32
        variable r: bool
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o ventanas[i].dueño <> dueño o an < 1 o al < 1 o an > 4096 o al > 4096 entonces
            soltar(cerrojo)
            devolver falso
        fin
        si con_marco(ventanas[i]) entonces
            x := x - BORDE
            yy := yy - ALTO_TÍTULO
            an := an + 2 * BORDE
            al := al + ALTO_TÍTULO + BORDE
            si an < 120 entonces an := 120 fin
        fin
        r := cierto
        si an = ventanas[i].ancho y al = ventanas[i].alto entonces
            ensuciar_ventana(ventanas[i])
            ventanas[i].px := x
            ventanas[i].py := yy
            ensuciar_ventana(ventanas[i])
        sino
            ventanas[i].banderas := ventanas[i].banderas yb nob MAXIMIZADA
            r := cambia_tamaño(i, x, yy, an, al)
        fin
        cambios := cambios + 1
        soltar(cerrojo)
        devolver r
    fin

    ; la trae delante (y la saca si estaba minimizada): pasa a ser la activa
    público función traer_ventana(id: nat32, dueño: nat32)
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i >= 0 y ventanas[i].dueño = dueño entonces
            ventanas[i].banderas := ventanas[i].banderas yb nob MINIMIZADA
            al_frente(i)
            cambios := cambios + 1
            mira_activa()
        fin
        soltar(cerrojo)
    fin

    ; dónde está lo de dentro de una ventana suya: d[0], d[1] en la pantalla;
    ; d[2], d[3] lo que mide; d[4] sus banderas; d[5] 1 si es la activa.
    ; Falso si no es suya.
    público función dónde_está(id: nat32, dueño: nat32, d: puntero a ent32): bool
        variable i: ent32
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o ventanas[i].dueño <> dueño entonces
            soltar(cerrojo)
            devolver falso
        fin
        d[0] := ventanas[i].px
        d[1] := ventanas[i].py
        si con_marco(ventanas[i]) entonces
            d[0] := d[0] + BORDE
            d[1] := d[1] + ALTO_TÍTULO
        fin
        d[2] := ventanas[i].dentro.ancho
        d[3] := ventanas[i].dentro.alto
        d[4] := ent32(ventanas[i].banderas)
        d[5] := 0
        si i = activa entonces d[5] := 1 fin
        soltar(cerrojo)
        devolver cierto
    fin

    ; de quién es la ventana activa (0: de nadie, o del núcleo)
    público función dueño_de_activa(): nat32
        variable r: nat32
        r := 0
        tomar(cerrojo)
        si activa >= 0 y ventanas[activa].usada entonces r := ventanas[activa].dueño fin
        soltar(cerrojo)
        devolver r
    fin

    ; (PUNTEROS) la forma del puntero sobre lo de dentro de una ventana suya
    ; (P_...); falso si no es suya o la forma no vale
    público función pon_forma(id: nat32, dueño: nat32, f: nat32): bool
        variable i: ent32
        si f >= N_FORMAS entonces devolver falso fin
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            soltar(cerrojo)
            devolver falso
        fin
        ventanas[i].forma := f
        soltar(cerrojo)
        devolver cierto
    fin

    ; (PUNTEROS) una zona de lo de dentro con su forma (la última, la que
    ; vale); con ancho 0, se quitan todas. Falso si no es suya, la forma no
    ; vale o ya tiene MAX_ZONAS
    público función pon_zona_puntero(id: nat32, dueño: nat32, ref z: Zona): bool
        variable i: ent32
        variable k: nat32
        si z.ancho <> 0 y (z.forma >= N_FORMAS o z.ancho < 0 o z.alto < 0 o z.ancho > LEJOS o z.alto > LEJOS) entonces devolver falso fin
        tomar(cerrojo)
        i := busca(id)
        si i < 0 o (dueño <> 0 y ventanas[i].dueño <> dueño) entonces
            soltar(cerrojo)
            devolver falso
        fin
        si z.ancho = 0 entonces
            ventanas[i].n_zonas := 0
            soltar(cerrojo)
            devolver cierto
        fin
        ; la misma zona otra vez: se cambia su forma
        k := 0
        mientras k < ventanas[i].n_zonas hacer
            si ventanas[i].zonas[k].x = z.x y ventanas[i].zonas[k].ye = z.ye y ventanas[i].zonas[k].ancho = z.ancho y ventanas[i].zonas[k].alto = z.alto entonces
                ventanas[i].zonas[k].forma := z.forma
                soltar(cerrojo)
                devolver cierto
            fin
            k := k + 1
        fin
        si ventanas[i].n_zonas >= MAX_ZONAS entonces
            soltar(cerrojo)
            devolver falso
        fin
        k := ventanas[i].n_zonas
        ventanas[i].zonas[k].x := z.x
        ventanas[i].zonas[k].ye := z.ye
        ventanas[i].zonas[k].ancho := z.ancho
        ventanas[i].zonas[k].alto := z.alto
        ventanas[i].zonas[k].forma := z.forma
        ventanas[i].n_zonas := k + 1
        soltar(cerrojo)
        devolver cierto
    fin

    ; (PUNTEROS) pinta un puntero en un lienzo (la vista previa del Panel: la
    ; llamada 177), con el cerrojo (la caché de las formas es una para todos).
    ; Da el ancho y el alto de lo pintado (el alto, arriba), o 0 si no hay
    ; memoria
    público función pinta_puntero_en(ref l: Lienzo, x: ent32, yy: ent32, f: nat32, j: nat32, t: nat32, esp: bool, k: nat32, color: nat32): nat32
        variable im: puntero a Imagen
        variable r: nat32
        r := 0
        tomar(cerrojo)
        im := imagen_de(f, j, t, esp, k)
        si im <> nulo entonces
            pinta_imagen(l, x, yy, im, color, 256)
            r := nat32(im.an) ob (nat32(im.al) << 16)
        fin
        soltar(cerrojo)
        devolver r
    fin

    ; (PUNTEROS) se está abriendo un programa: la flecha con la espera, hasta
    ; que haga su ventana (o unos segundos)
    público función pon_ocupado(centésimas: nat32)
        ocupado_hasta := (tics + centésimas) ob 1
    fin

    ; los botones del ratón que el gestor ha visto pulsados
    público función botones_vistos(): nat32
        devolver botones_antes
    fin

    ; prepara el gestor: el doble búfer y el tapiz (con la pantalla ya en modo
    ; gráfico). Falso si no hay memoria.
    público función prepara_ventanas(): bool
        variable m: puntero a byte
        variable n: nat32
        si no hay_pantalla entonces devolver falso fin
        n := nat32(pantalla.ancho * pantalla.alto * 4)
        m := reservar(n)
        si m = nulo entonces devolver falso fin
        pon_lienzo(trasero, puntero(m), nat32(pantalla.ancho), pantalla.ancho, pantalla.alto)
        m := reservar(n)
        si m = nulo entonces devolver falso fin
        pon_lienzo(tapiz, puntero(m), nat32(pantalla.ancho), pantalla.ancho, pantalla.alto)
        cuántas := 0
        sucios := 0
        flecha_x := ratón_x
        flecha_y := ratón_y
        ; (PUNTEROS) la baldosa para pintar el puntero sin parpadeo
        prepara_cursores()
        m := reservar(BALDOSA * BALDOSA * 4)
        hay_baldosa := m <> nulo
        si hay_baldosa entonces pon_lienzo(baldosa, puntero(m), BALDOSA, BALDOSA, BALDOSA) fin
        devolver cierto
    fin

fin Ventanas.
