; =============================================================================
;  festivos.cas - (AGENDA) el calendario y los festivos, una sola tabla para
;  el Reloj (RELOJ.BIN, ureloj.cas) y la Agenda (AGENDA.BIN, uagenda.cas):
;
;    - las fechas: bisiesto, los días del mes, el número del día (desde el
;      1 de enero de 1970, un jueves) y al revés, el día de la semana (0 el
;      lunes ... 6 el domingo), la Pascua (Meeus/Butcher) y la fecha larga
;      en español («Domingo, 22 de noviembre de 2026»);
;    - los festivos: los nacionales de España, los de cada comunidad
;      autónoma (la que se elija; de serie, Cataluña) y los locales (los de
;      un municipio de la tabla —de serie, Albinyana— y los que se apunten
;      en FESTIVOS.TXT, en la carpeta de la Agenda). Las reglas: fecha fija
;      («dd/mm»), de un año («dd/mm/aaaa»), contada desde la Pascua («P-3»
;      es el Jueves Santo, «P+1» el Lunes de Pascua) o quitar uno de un año
;      («-dd/mm/aaaa»: cuando la comunidad lo pasa a otro día);
;    - la carpeta de la Agenda (una sola función: carpeta_agenda) y sus
;      ajustes de los festivos (AGENDA.INI: comunidad= y municipio=).
;
;  Antes (ACCESORIOS, 21/11) el Reloj llevaba sus festivos nacionales
;  dentro; desde la Agenda (22/11) los dos usan esta tabla.
;  Las fuentes de la tabla, en docs/PENTIUM.md (14 vicies, «Los festivos»).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Festivos

    modelo usuario

    importar Llamadas, Textos32, Formato, Controles

    público constante DÍAS = "lunes|martes|mi\x82rcoles|jueves|viernes|s\xA0bado|domingo"
    público constante DÍAS_CORTOS = "lu|ma|mi|ju|vi|s\xA0|do"
    público constante MESES = "enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre"

    ; las clases de festivo (lo que dice la Agenda debajo de su nombre)
    público constante F_NACIONAL = 1
    público constante F_COMUNIDAD = 2
    público constante F_LOCAL = 3

    ; =========================================================================
    ;  Las fechas
    ; =========================================================================
    público función bisiesto(a: nat32): bool
        devolver (a mod 4 = 0 y a mod 100 <> 0) o a mod 400 = 0
    fin

    público función días_del_mes(m: nat32, a: nat32): nat32
        si m = 2 entonces
            si bisiesto(a) entonces devolver 29 fin
            devolver 28
        fin
        si m = 4 o m = 6 o m = 9 o m = 11 entonces devolver 30 fin
        devolver 31
    fin

    ; los días desde el 1 de enero de 1970 (el día 0, un jueves); de 1970 en
    ; adelante (la cuenta de H. Hinnant, sin bucles)
    público función número_de_día(d: nat32, m: nat32, a: nat32): nat32
        variable aa, era, yoe, doy, doe, mm: nat32
        aa := a
        si m <= 2 entonces aa := aa - 1 fin
        era := aa div 400
        yoe := aa - era * 400
        si m > 2 entonces mm := m - 3 sino mm := m + 9 fin
        doy := (153 * mm + 2) div 5 + d - 1
        doe := yoe * 365 + yoe div 4 - yoe div 100 + doy
        devolver era * 146097 + doe - 719468
    fin

    público función de_número(n: nat32, ref d: nat32, ref m: nat32, ref a: nat32)
        variable z, era, doe, yoe, doy, mp: nat32
        z := n + 719468
        era := z div 146097
        doe := z - era * 146097
        yoe := (doe - doe div 1460 + doe div 36524 - doe div 146096) div 365
        a := yoe + era * 400
        doy := doe - (365 * yoe + yoe div 4 - yoe div 100)
        mp := (5 * doy + 2) div 153
        d := doy - (153 * mp + 2) div 5 + 1
        si mp < 10 entonces m := mp + 3 sino m := mp - 9 fin
        si m <= 2 entonces a := a + 1 fin
    fin

    ; 0 el lunes ... 6 el domingo
    público función día_semana(d: nat32, m: nat32, a: nat32): nat32
        devolver (número_de_día(d, m, a) + 3) mod 7
    fin

    público función dsem_de(n: nat32): nat32
        devolver (n + 3) mod 7
    fin

    ; el Domingo de Resurrección (el algoritmo de Meeus, el de Butcher)
    público función pascua(a: nat32, ref d: nat32, ref m: nat32)
        variable aa, b, c, dd, e, f, gg, h, i, k, l, x: nat32
        aa := a mod 19
        b := a div 100
        c := a mod 100
        dd := b div 4
        e := b mod 4
        f := (b + 8) div 25
        gg := (b - f + 1) div 3
        h := (19 * aa + b - dd - gg + 15) mod 30
        i := c div 4
        k := c mod 4
        l := (32 + 2 * e + 2 * i - h - k) mod 7
        x := (aa + 11 * h + 22 * l) div 451
        m := (h + l - 7 * x + 114) div 31
        d := (h + l - 7 * x + 114) mod 31 + 1
    fin

    ; el número de día de la Pascua de ese año
    público función día_de_pascua(a: nat32): nat32
        variable d, m: nat32
        pascua(a, d, m)
        devolver número_de_día(d, m, a)
    fin

    ; «Sábado, 21 de noviembre de 2026»
    público función fecha_larga(d: nat32, m: nat32, a: nat32, t: puntero a byte)
        variable nd: arreglo [16] de byte
        variable nm: arreglo [16] de byte
        variable x: arreglo [4] de nat32
        opción_de(DÍAS, día_semana(d, m, a), nd, 16)
        opción_de(MESES, m - 1, nm, 16)
        nd[0] := mayúscula(nd[0])
        x[0] := nat32(dirección(nd[0]))
        x[1] := d
        x[2] := nat32(dirección(nm[0]))
        x[3] := a
        formatear(t, 80, "%s, %u de %s de %u", x)
    fin

    ; =========================================================================
    ;  La carpeta de la Agenda (la única función que sabe dónde está)
    ; =========================================================================
    ; Con usuarios (la rama «usuarios», la 0.8.7): \USUARIOS\<CARPETA>\AGENDA
    ; (la llamada 200, 4: «su carpeta»; con un núcleo sin usuarios, o un
    ; sistema sin instalar, no da nada); si no, \DOCUMENT\AGENDA de la unidad
    ; del sistema. Las pruebas la fuerzan (carpeta_forzada: «/CARPETA=»).
    ; El escritorio (escritorio.cas, «(AGENDA)», ruta_próxima) sigue la
    ; misma regla para leer PROXIMA.TXT: si cambia aquí, cambia allí.
    público variable carpeta_forzada: arreglo [96] de byte

    función mi_carpeta_de_usuario(destino: puntero a byte, cabe: nat32): nat32
        variable r: nat32
        ensamblador
            mov eax, 200
            mov ebx, 4
            mov ecx, {destino}
            mov edx, {cabe}
            int 0x80
            mov {r}, eax
        fin
        devolver r
    fin

    público función carpeta_agenda(destino: puntero a byte)
        variable r: nat32
        si carpeta_forzada[0] <> 0 entonces
            copiar(destino, carpeta_forzada)
            devolver
        fin
        r := mi_carpeta_de_usuario(destino, 80)
        si r > 0 y r < 80 y destino[0] = '\\' entonces
            destino[r] := 0
            concatenar(destino, "\\AGENDA")
            devolver
        fin
        copiar(destino, "\\DOCUMENT\\AGENDA")
    fin

    ; la ruta de uno de sus archivos («AGENDA.ICS»)
    público función ruta_agenda(nombre: puntero a byte, destino: puntero a byte)
        carpeta_agenda(destino)
        concatenar(destino, "\\")
        concatenar(destino, nombre)
    fin

    ; que exista la carpeta (y su madre, \DOCUMENT): cierto si está
    público función asegura_carpeta(): bool
        variable r: arreglo [100] de byte
        variable i: nat32
        variable m: nat32
        carpeta_agenda(r)
        m := abrir(r)
        si m < PRIMER_ERROR entonces
            cerrar(m)
            devolver cierto
        fin
        ; cada trozo, de arriba abajo
        i := 1
        mientras r[i] <> 0 hacer
            si r[i] = '\\' entonces
                r[i] := 0
                crear_carpeta(r)
                r[i] := '\\'
            fin
            i := i + 1
        fin
        m := crear_carpeta(r)
        devolver m < PRIMER_ERROR o m = YA_EXISTE
    fin

    ; =========================================================================
    ;  La tabla de los festivos
    ; =========================================================================
    ; «ámbito|regla|nombre». Ámbito: ES (toda España), el código de la
    ; comunidad (los de COMUNIDADES) o L:MUNICIPIO. Las reglas, arriba.
    ; Los nacionales «no sustituibles» y los que todas las comunidades
    ; dejan en su día; lo demás, por comunidad, con los cambios de cada año
    ; (los traslados al lunes) de las resoluciones del BOE y del DOGC.
    público constante COMUNIDADES = "Solo los nacionales|Andaluc\xA1a|Arag\xA2n|Asturias|Illes Balears|Canarias|Cantabria|Castilla-La Mancha|Castilla y Le\xA2n|Catalu\xA4a|Comunitat Valenciana|Extremadura|Galicia|Comunidad de Madrid|Regi\xA2n de Murcia|Navarra|Pa\xA1s Vasco|La Rioja|Ceuta|Melilla"
    constante CÓDIGOS = "ES|AN|AR|AS|IB|CN|CB|CM|CL|CT|VC|EX|GA|MD|MC|NC|PV|RI|CE|ML"
    constante N_COMUNIDADES = 20
    público constante MUNICIPIOS = "Ninguno|Albinyana (Baix Pened\x8As)"
    constante CÓDIGOS_MUNI = "-|ALBINYANA"
    constante N_MUNICIPIOS = 2

