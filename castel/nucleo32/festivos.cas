    variable n_reglas: nat32

    ; ---- los ajustes (AGENDA.INI) ----
    variable ajustes_leídos: bool
    público variable comunidad: nat32 = 9       ; la de COMUNIDADES (de serie, Cataluña)
    público variable municipio: nat32 = 1       ; el de MUNICIPIOS (de serie, Albinyana)

    ; ---- los locales del usuario (FESTIVOS.TXT) ----
    constante MAX_PROPIOS = 4096
    variable propios: arreglo [MAX_PROPIOS] de byte
    variable n_propios: nat32

    ; ---- lo calculado de un año (para no mirar la tabla en cada día) ----
    constante MAX_AÑO = 64
    tipo Año_hecho = estructura
        año: nat32
        n: nat32
        día: arreglo [MAX_AÑO] de nat32
        clase: arreglo [MAX_AÑO] de byte
        nombre: arreglo [MAX_AÑO] de puntero a byte
    fin
    variable hechos: arreglo [3] de Año_hecho
    variable turno: nat32

    ; lee los ajustes (comunidad= y municipio=, con su código) y FESTIVOS.TXT
    público función lee_ajustes()
        variable r: arreglo [120] de byte
        variable t: arreglo [1024] de byte
        variable v: arreglo [24] de byte
        variable m, n, i: nat32
        ajustes_leídos := cierto
        hechos[0].año := 0
        hechos[1].año := 0
        hechos[2].año := 0
        ruta_agenda("AGENDA.INI", r)
        m := abrir(r)
        si m < PRIMER_ERROR entonces
            n := leer(m, t, 1023)
            cerrar(m)
            si n > 1023 entonces n := 0 fin
            t[n] := 0
            si valor_ini(t, "comunidad", v, 24) entonces
                para i desde 0 hasta N_COMUNIDADES - 1 hacer
                    si es_código(CÓDIGOS, i, v) entonces comunidad := i fin
                fin
            fin
            si valor_ini(t, "municipio", v, 24) entonces
                para i desde 0 hasta N_MUNICIPIOS - 1 hacer
                    si es_código(CÓDIGOS_MUNI, i, v) entonces municipio := i fin
                fin
            fin
        fin
        n_propios := 0
        ruta_agenda("FESTIVOS.TXT", r)
        m := abrir(r)
        si m < PRIMER_ERROR entonces
            n := leer(m, propios, MAX_PROPIOS - 1)
            cerrar(m)
            si n > MAX_PROPIOS - 1 entonces n := 0 fin
            n_propios := n
        fin
        propios[n_propios] := 0
    fin

    ; el código de la comunidad elegida («CT»)
    público función código_comunidad(destino: puntero a byte)
        si no ajustes_leídos entonces lee_ajustes() fin
        opción_de(CÓDIGOS, comunidad, destino, 4)
    fin

    público función código_municipio(destino: puntero a byte)
        si no ajustes_leídos entonces lee_ajustes() fin
        opción_de(CÓDIGOS_MUNI, municipio, destino, 24)
    fin

    ; las otras: cambiarlas (las guarda la Agenda en AGENDA.INI)
    público función elige(c: nat32, mu: nat32)
        si c < N_COMUNIDADES entonces comunidad := c fin
        si mu < N_MUNICIPIOS entonces municipio := mu fin
        ajustes_leídos := cierto
        hechos[0].año := 0
        hechos[1].año := 0
        hechos[2].año := 0
    fin

    ; ¿es «código» la opción i de la lista?
    función es_código(lista: puntero a byte, i: nat32, código: puntero a byte): bool
        variable op: arreglo [24] de byte
        opción_de(lista, i, op, 24)
        devolver iguales_sin_caja(op, código)
    fin

    ; el valor de «clave=» en un .INI (texto con CR LF)
    público función valor_ini(t: puntero a byte, clave: puntero a byte, destino: puntero a byte, cabe: nat32): bool
        variable p: puntero a byte
        variable n, k: nat32
        p := t
        n := longitud(clave)
        mientras valor(p) <> 0 hacer
            si comparar_n(p, clave, n) y p[n] = '=' entonces
                p := p + n + 1
                k := 0
                mientras valor(p) <> 0 y valor(p) <> 13 y valor(p) <> 10 y k + 1 < cabe hacer
                    destino[k] := valor(p)
                    k := k + 1
                    p := p + 1
                fin
                destino[k] := 0
                devolver cierto
            fin
            mientras valor(p) <> 0 y valor(p) <> 10 hacer p := p + 1 fin
            si valor(p) = 10 entonces p := p + 1 fin
        fin
        devolver falso
    fin

    ; ¿empiezan igual (n letras, sin mirar mayúsculas)?
    función comparar_n(a: puntero a byte, b: puntero a byte, n: nat32): bool
        variable i: nat32
        para i desde 1 hasta n hacer
            si mayúscula(a[i - 1]) <> mayúscula(b[i - 1]) entonces devolver falso fin
        fin
        devolver cierto
    fin

    ; dos cifras (o una) a un número; avanza p
    función número_en(ref p: puntero a byte): nat32
        variable n: nat32
        n := 0
        mientras valor(p) >= '0' y valor(p) <= '9' hacer
            n := n * 10 + valor(p) - '0'
            p := p + 1
        fin
        devolver n
    fin

    ; una regla («dd/mm», «dd/mm/aaaa», «-dd/mm/aaaa», «P+n», «P-n») para el
    ; año a: su día (cierto si cae ese año); «quita», si es para quitar
    función día_de_regla(r: puntero a byte, a: nat32, ref n: nat32, ref quita: bool): bool
        variable d, m, aa: nat32
        variable k: ent32
        variable menos: bool
        quita := falso
        si valor(r) = '-' y r[1] <> '-' entonces
            quita := cierto
            r := r + 1
        fin
        si valor(r) = 'P' o valor(r) = 'p' entonces
            r := r + 1
            menos := valor(r) = '-'
            si valor(r) = '-' o valor(r) = '+' entonces r := r + 1 fin
            k := ent32(número_en(r))
            si menos entonces k := -k fin
            n := nat32(ent32(día_de_pascua(a)) + k)
            devolver cierto
        fin
        si valor(r) < '0' o valor(r) > '9' entonces devolver falso fin
        d := número_en(r)
        si valor(r) <> '/' entonces devolver falso fin
        r := r + 1
        m := número_en(r)
        si m < 1 o m > 12 o d < 1 o d > días_del_mes(m, a) entonces devolver falso fin
        si valor(r) = '/' entonces
            r := r + 1
            aa := número_en(r)
            si aa <> a entonces devolver falso fin
        fin
        n := número_de_día(d, m, a)
        devolver cierto
    fin

    ; apunta (o quita) un festivo en lo hecho del año
    función apunta(ref h: Año_hecho, n: nat32, clase: nat32, nombre: puntero a byte, quita: bool)
        variable i, j: nat32
        i := 0
        mientras i < h.n hacer
            si h.día[i] = n entonces
                si quita entonces
                    ; fuera (los que van detrás, uno arriba)
                    j := i
                    mientras j + 1 < h.n hacer
                        h.día[j] := h.día[j + 1]
                        h.clase[j] := h.clase[j + 1]
                        h.nombre[j] := h.nombre[j + 1]
                        j := j + 1
                    fin
                    h.n := h.n - 1
                fin
                devolver                         ; (el primero que se apuntó, manda)
            fin
            i := i + 1
        fin
        si quita o h.n >= MAX_AÑO entonces devolver fin
        h.día[h.n] := n
        h.clase[h.n] := byte(clase)
        h.nombre[h.n] := nombre
        h.n := h.n + 1
    fin

    ; una línea «ámbito|regla|nombre» (o «regla|nombre» de FESTIVOS.TXT, que
    ; son locales); «nombre» apunta a la línea, que acaba en «\n», «\r» o 0
    función mira_línea(ref h: Año_hecho, l: puntero a byte, propio: bool)
        variable ámb: arreglo [16] de byte
        variable cc: arreglo [24] de byte
        variable p, regla, nombre: puntero a byte
        variable clase, n, k: nat32
        variable quita: bool
        p := l
        si valor(p) = ';' o valor(p) = '#' entonces devolver fin
        clase := F_LOCAL
        si no propio entonces
            k := 0
            mientras valor(p) <> '|' y valor(p) <> 0 y k < 15 hacer
                ámb[k] := valor(p)
                k := k + 1
                p := p + 1
            fin
            ámb[k] := 0
            si valor(p) <> '|' entonces devolver fin
            p := p + 1
            si iguales(ámb, "ES") entonces
                clase := F_NACIONAL
            sino si empieza_por(ámb, "L:") entonces
                código_municipio(cc)
                si no iguales_sin_caja(dirección(ámb[2]), cc) entonces devolver fin
                clase := F_LOCAL
            sino
                código_comunidad(cc)
                si no iguales(ámb, cc) entonces devolver fin
                clase := F_COMUNIDAD
            fin
        fin
        ; «~»: la de siempre, solo si ese año no tiene su lista (la del BOE o el DOGC)
        si valor(p) = '~' entonces
            si no propio y tiene_lista(ámb, h.año) entonces devolver fin
            p := p + 1
        fin
        regla := p
        mientras valor(p) <> '|' y valor(p) <> 0 y valor(p) <> 10 hacer p := p + 1 fin
        si valor(p) <> '|' entonces devolver fin
        nombre := p + 1
        si no día_de_regla(regla, h.año, n, quita) entonces devolver fin
        apunta(h, n, clase, nombre, quita)
    fin

    ; ¿tiene ese ámbito su lista del año a («ÁMBITO|dd/mm/aaaa|...»)?
    función tiene_lista(ámb: puntero a byte, a: nat32): bool
        variable i, n, k: nat32
        variable p: puntero a byte
        variable año: arreglo [8] de byte
        n := longitud(ámb)
        natural_a_texto(a, año)
        para i desde 0 hasta N_REGLAS - 1 hacer
            p := reglas[i]
            si comparar_n(p, ámb, n) y p[n] = '|' y p[n + 1] <> '~' entonces
                p := p + n + 1
                k := 0
                mientras p[k] <> '|' y p[k] <> 0 hacer k := k + 1 fin
                si k = 10 y p[5] = '/' y p[6] = año[0] y p[7] = año[1] y p[8] = año[2] y p[9] = año[3] entonces devolver cierto fin
            fin
        fin
        devolver falso
    fin

    ; los festivos del año a (de lo hecho, o se hacen)
    función del_año(a: nat32): puntero a Año_hecho
        variable i: nat32
        variable p: puntero a byte
        variable h: puntero a Año_hecho
        si no ajustes_leídos entonces lee_ajustes() fin
        para i desde 0 hasta 2 hacer
            si hechos[i].año = a entonces devolver dirección(hechos[i]) fin
        fin
        h := dirección(hechos[turno])
        turno := (turno + 1) mod 3
        h.año := a
        h.n := 0
        ; los nacionales, los de la comunidad y los del municipio
        i := 0
        mientras i < N_REGLAS hacer
            mira_línea(valor(h), reglas[i], falso)
            i := i + 1
        fin
        ; los del usuario (FESTIVOS.TXT): «dd/mm|nombre», «dd/mm/aaaa|nombre»,
        ; «P+n|nombre» o «-dd/mm/aaaa|» (quitar uno)
        p := dirección(propios[0])
        mientras valor(p) <> 0 hacer
            mira_línea(valor(h), p, cierto)
            mientras valor(p) <> 0 y valor(p) <> 10 hacer p := p + 1 fin
            si valor(p) = 10 entonces p := p + 1 fin
        fin
        devolver h
    fin

    ; el festivo de ese día (nulo si no lo es); su nombre acaba en «\r»,
    ; «\n» o 0: nombre_festivo lo copia limpio
    público función festivo_de(d: nat32, m: nat32, a: nat32, ref clase: nat32): puntero a byte
        variable h: puntero a Año_hecho
        variable n, i: nat32
        h := del_año(a)
        n := número_de_día(d, m, a)
        i := 0
        mientras i < h.n hacer
            si h.día[i] = n entonces
                clase := h.clase[i]
                devolver h.nombre[i]
            fin
            i := i + 1
        fin
        clase := 0
        devolver nulo
    fin

    variable nombre_: arreglo [64] de byte

    ; el nombre del festivo de ese día, limpio (nulo si no lo es): lo que
    ; usaba el Reloj
    público función festivo(d: nat32, m: nat32, a: nat32): puntero a byte
        variable c: nat32
        variable p: puntero a byte
        p := festivo_de(d, m, a, c)
        si p = nulo entonces devolver nulo fin
        nombre_festivo(p, nombre_, 64)
        devolver dirección(nombre_[0])
    fin

    público función nombre_festivo(p: puntero a byte, destino: puntero a byte, cabe: nat32)
        variable k: nat32
        k := 0
        mientras valor(p) <> 0 y valor(p) <> 13 y valor(p) <> 10 y k + 1 < cabe hacer
            destino[k] := valor(p)
            k := k + 1
            p := p + 1
        fin
        destino[k] := 0
        si k = 0 entonces copiar_hasta(destino, "Festivo local", cabe) fin
    fin

fin Festivos.
