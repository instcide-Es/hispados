módulo UCli

    modelo usuario

    función principal(): byte
        escribir("voy a tapar las interrupciones desde el anillo 3...\n")
        ensamblador
            cli
        fin
        escribir("las he tapado (esto no tenía que salir)\n")
        devolver 0
    fin

fin UCli.
