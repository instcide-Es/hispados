        db 255,255,255,255,255,255,112,239,255,255,255,255,255,255,112,239,255,255,255,255,255,255,112,222,238,238,238,238,238,238,96
    fin

    ; la cara n (0 a 5): sus 4 palabras
    público función cara_mono(n: nat32): puntero a nat32
        si n >= CARAS_MONO entonces n := 0 fin
        ensamblador
            mov eax, {n}
            shl eax, 4
            add eax, LM_caras
        fin
    fin

fin LetraMono.
