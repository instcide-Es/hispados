; =============================================================================
;  video.cas - la pantalla gráfica de Hispa-Pentium: un modo de 32 bits por
;  punto con la memoria de la pantalla seguida («framebuffer lineal»), que se
;  ve como un lienzo (grafico.cas).
;
;  El modo sale de uno de dos sitios:
;   1. del cargador, si ya lo ha dejado puesto (multiboot: GRUB con un modo
;      gráfico) y es de 32 bits por punto;
;   2. de la tarjeta «VBE de Bochs» (la VGA de QEMU, Bochs y VirtualBox): se
;      le pide por sus dos puertos (0x1CE, el índice; 0x1CF, el dato) y la
;      memoria de la pantalla está en su primera zona PCI (1234:1111).
;  En un PC de verdad sin esa tarjeta el modo lo tiene que poner el cargador
;  (PENTIUM.md lo cuenta).
;
;  Se dibuja siempre con 32 bits por punto. Si el modo que hay es de 24 o de
;  16 (hay tarjetas que no dan otro), «pantalla» es un lienzo de 32 bits en
;  la memoria del núcleo, y volcar() pasa a la pantalla de verdad lo que se
;  ha tocado, punto a punto. Con 32 bits, «pantalla» es la de verdad y
;  volcar() no hace nada.
;
;  La memoria de la pantalla está muy por encima de la RAM: se pone en la
;  zona de los gráficos del núcleo (paginas.cas, GRÁFICOS_INICIO), cuyas
;  tablas ven todos los espacios de direcciones.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Video

    importar Cpu, Multiboot, Paginas, Monton, Grafico

    constante VBE_ÍNDICE = 0x1CE
    constante VBE_DATO = 0x1CF
    constante VBE_ID = 0
    constante VBE_ANCHO = 1
    constante VBE_ALTO = 2
    constante VBE_BITS = 3
    constante VBE_ACTIVAR = 4
    constante VBE_ENCENDIDO = 0x41              ; encendido, con la memoria seguida

    público variable hay_pantalla: bool         ; ya hay un modo gráfico puesto
    público variable pantalla: Lienzo           ; la pantalla de verdad
    público variable pantalla_física: nat32     ; dónde está su memoria (dirección física)
    público variable por_bochs: bool            ; el modo lo ha puesto la VBE de Bochs (no el cargador)
    público variable bits_pantalla: nat32       ; los bits por punto del modo (32, 24 o 16)
    variable real: nat32                        ; la pantalla de verdad (si no es de 32 bits)
    variable octetos_fila: nat32                ; de una fila a la siguiente, en ella

    función vbe_pon(índice: nat32, dato: nat32)
        ensamblador
            mov edx, {VBE_ÍNDICE}
            mov eax, {índice}
            out dx, ax
            mov edx, {VBE_DATO}
            mov eax, {dato}
            out dx, ax
        fin
    fin

    función vbe_lee(índice: nat32): nat32
        ensamblador
            mov edx, {VBE_ÍNDICE}
            mov eax, {índice}
            out dx, ax
            mov edx, {VBE_DATO}
            xor eax, eax
            in ax, dx
        fin
    fin

    ; ¿está la tarjeta de Bochs/QEMU? (o sea: ¿es una máquina de mentira?)
    público función hay_bochs(): bool
        variable id: nat32
        id := vbe_lee(VBE_ID)
        devolver id >= 0xB0C0 y id <= 0xB0CF
    fin

    ; una palabra de 32 bits de la configuración PCI de un dispositivo
    función pci_lee(bus: nat32, dispositivo: nat32, registro: nat32): nat32
        variable dir: nat32
        dir := 0x80000000 ob (bus << 16) ob (dispositivo << 11) ob (registro yb 0xFC)
        ensamblador
            mov edx, 0xCF8
            mov eax, {dir}
            out dx, eax
            mov edx, 0xCFC
            in eax, dx
        fin
    fin

    ; la memoria de la pantalla de la VGA de Bochs/QEMU (PCI 1234:1111, su
    ; primera zona); si no aparece en el PCI, donde la ponía la de ISA
    función memoria_bochs(): nat32
        variable bus, d, id: nat32
        para bus desde 0 hasta 3 hacer
            para d desde 0 hasta 31 hacer
                id := pci_lee(bus, d, 0)
                si id = 0x11111234 o id = 0xBEEF80EE entonces     ; (la segunda, la de VirtualBox)
                    devolver pci_lee(bus, d, 0x10) yb 0xFFFFFFF0
                fin
            fin
        fin
        devolver 0xE0000000
    fin

    ; pone la memoria física de la pantalla en la zona de los gráficos
    función a_la_vista(física: nat32, octetos: nat32): bool
        variable v: nat32
        si octetos > GRÁFICOS_TABLAS * 0x400000 entonces devolver falso fin
        v := 0
        mientras v < octetos + (física yb 0xFFF) hacer
            si no mapear(directorio_núcleo, GRÁFICOS_INICIO + v, (física yb 0xFFFFF000) + v, ESCRIBIR) entonces devolver falso fin
            v := v + PÁGINA
        fin
        poner_cr3(leer_cr3())
        devolver cierto
    fin

    ; n puntos de 32 bits, a 24 (tres octetos cada uno)
    función fila_a_24(destino: nat32, origen: puntero a nat32, n: nat32)
        ensamblador
            mov edi, {destino}
            mov esi, {origen}
            mov ecx, {n}
        .otro:
            mov eax, [esi]
            mov [edi], ax
            shr eax, 16
            mov [edi+2], al
            add esi, 4
            add edi, 3
            dec ecx
            jnz .otro
        fin
    fin

    ; n puntos de 32 bits, a 16 (5 de rojo, 6 de verde, 5 de azul)
    función fila_a_16(destino: nat32, origen: puntero a nat32, n: nat32)
        ensamblador
            mov edi, {destino}
            mov esi, {origen}
            mov ecx, {n}
        .otro:
            mov eax, [esi]
            mov edx, eax
            mov ebx, eax
            shr eax, 8
            and eax, 0xF800
            shr edx, 5
            and edx, 0x07E0
            shr ebx, 3
            and ebx, 0x001F
            or eax, edx
            or eax, ebx
            mov [edi], ax
            add esi, 4
            add edi, 2
            dec ecx
            jnz .otro
        fin
    fin

    ; lo que se ha dibujado en ese rectángulo de «pantalla», a la pantalla de
    ; verdad (con 32 bits por punto ya está en ella: nada)
    público función volcar(x: ent32, yy: ent32, an: ent32, al: ent32)
        variable j: ent32
        si bits_pantalla = 32 o no hay_pantalla entonces devolver fin
        si x < 0 entonces
            an := an + x
            x := 0
        fin
        si yy < 0 entonces
            al := al + yy
            yy := 0
        fin
        si x + an > pantalla.ancho entonces an := pantalla.ancho - x fin
        si yy + al > pantalla.alto entonces al := pantalla.alto - yy fin
        si an <= 0 o al <= 0 entonces devolver fin
        para j desde yy hasta yy + al - 1 hacer
            si bits_pantalla = 24 entonces
                fila_a_24(real + nat32(j) * octetos_fila + nat32(x) * 3, pantalla.puntos + (j * pantalla.ancho + x), nat32(an))
            sino
                fila_a_16(real + nat32(j) * octetos_fila + nat32(x) * 2, pantalla.puntos + (j * pantalla.ancho + x), nat32(an))
            fin
        fin
    fin

    ; pone un modo gráfico (de 32 bits por punto si se puede elegir), de ese
    ; ancho y ese alto. «bits_pedidos», para probar: 24 o 16 con la VBE de
    ; Bochs (0: lo normal). Falso si no hay manera (y dice por qué).
    público función pon_modo(ancho: nat32, alto: nat32, bits_pedidos: nat32): bool
        variable base, fila, an, al, bits, id: nat32
        variable m: puntero a byte
        si hay_pantalla entonces devolver cierto fin
        si bits_pedidos <> 24 y bits_pedidos <> 16 entonces bits_pedidos := 32 fin
        si pantalla_del_cargador(base, fila, an, al, bits) entonces
            si bits <> 32 y bits <> 24 y bits <> 16 entonces
                escribir("pantalla: el cargador ha puesto un modo de ", bits, " bits por punto, y tiene que ser de 32, 24 o 16\n")
                devolver falso
            fin
        sino
            si no hay_bochs() entonces
                escribir("pantalla: no hay modo gráfico (ni lo ha puesto el cargador ni hay VBE de Bochs/QEMU)\n")
                devolver falso
            fin
            vbe_pon(VBE_ACTIVAR, 0)
            vbe_pon(VBE_ANCHO, ancho)
            vbe_pon(VBE_ALTO, alto)
            vbe_pon(VBE_BITS, bits_pedidos)
            vbe_pon(VBE_ACTIVAR, VBE_ENCENDIDO)
            si vbe_lee(VBE_ANCHO) <> ancho o vbe_lee(VBE_ALTO) <> alto o vbe_lee(VBE_BITS) <> bits_pedidos entonces
                vbe_pon(VBE_ACTIVAR, 0)
                escribir("pantalla: la tarjeta no da ", ancho, "x", alto, " con ", bits_pedidos, " bits por punto\n")
                devolver falso
            fin
            base := memoria_bochs()
            an := ancho
            al := alto
            bits := bits_pedidos
            fila := ancho * (bits div 8)
            por_bochs := cierto
        fin
        si no a_la_vista(base, fila * al) entonces
            escribir("pantalla: no se puede poner a la vista la memoria de la pantalla\n")
            devolver falso
        fin
        pantalla_física := base
        bits_pantalla := bits
        si bits = 32 y fila yb 3 = 0 entonces
            pon_lienzo(pantalla, puntero(GRÁFICOS_INICIO + (base yb 0xFFF)), fila div 4, an, al)
        sino
            ; no es de 32 bits: se dibuja en un lienzo aparte, y volcar() lo pasa
            si bits = 32 entonces bits_pantalla := 24 fin     ; (no pasa: una fila de 32 bits siempre es múltiplo de 4)
            m := reservar(an * al * 4)
            si m = nulo entonces
                escribir("pantalla: no hay memoria para el lienzo de la pantalla\n")
                devolver falso
            fin
            real := GRÁFICOS_INICIO + (base yb 0xFFF)
            octetos_fila := fila
            pon_lienzo(pantalla, puntero(m), an, an, al)
        fin
        hay_pantalla := cierto
        devolver cierto
    fin

fin Video.
