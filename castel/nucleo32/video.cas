; =============================================================================
;  video.cas - la pantalla gráfica de Hispa-Pentium: un modo de 32 bits por
;  punto con la memoria de la pantalla seguida («framebuffer lineal»), que se
;  ve como un lienzo (grafico.cas).
;
;  El modo sale de uno de dos sitios:
;   1. del cargador, si ya lo ha dejado puesto (multiboot: GRUB con un modo
;      gráfico) y es de 32 bits por punto;
;   2. de la tarjeta «VBE de Bochs» (la VGA de QEMU, Bochs y VirtualBox): se
;      le pide por sus dos puertos (0x1CE, el índice; 0x1CF, el dato) y la
;      memoria de la pantalla está en su primera zona PCI (1234:1111).
;  En un PC de verdad sin esa tarjeta el modo lo tiene que poner el cargador
;  (PENTIUM.md lo cuenta).
;
;  Con esa tarjeta (aunque el modo lo haya puesto el cargador: su VBE habla
;  con ella), el modo se puede cambiar en marcha: cambia_modo(). Lo que da
;  (el máximo, su memoria) lo cuentan máximo_tarjeta() y memoria_tarjeta(),
;  para la lista de modos de Configuración; lo que dice la pantalla (su
;  EDID), edid.cas.
;
;  Se dibuja siempre con 32 bits por punto. Si el modo que hay es de 24 o de
;  16 (hay tarjetas que no dan otro), «pantalla» es un lienzo de 32 bits en
;  la memoria del núcleo, y volcar() pasa a la pantalla de verdad lo que se
;  ha tocado, punto a punto. Con 32 bits, «pantalla» es la de verdad y
;  volcar() no hace nada.
;
;  La memoria de la pantalla está muy por encima de la RAM: se pone en la
;  zona de los gráficos del núcleo (paginas.cas, GRÁFICOS_INICIO), cuyas
;  tablas ven todos los espacios de direcciones.
;
;  (UEFI) Arrancado por UEFI (GRUB EFI, multiboot2), el modo es el que deja
;  el firmware (su GOP), o el que GRUB le pide antes de arrancar (gfxpayload).
;  Sin BIOS no se puede cambiar en marcha (ni aunque esté la VBE de Bochs de
;  QEMU: en un PC de verdad no la hay, y así QEMU se porta como uno de
;  verdad): Configuración lo guarda para el próximo arranque. Si el GOP es de
;  colores «al revés» (RGB), se dibuja en un lienzo aparte y volcar() lo pasa
;  dándole la vuelta a cada punto.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Video

    importar Cpu, Multiboot, Paginas, Monton, Grafico

    constante VBE_ÍNDICE = 0x1CE
    constante VBE_DATO = 0x1CF
    constante VBE_ID = 0
    constante VBE_ANCHO = 1
    constante VBE_ALTO = 2
    constante VBE_BITS = 3
    constante VBE_ACTIVAR = 4
    constante VBE_ANCHO_VIRTUAL = 6
    constante VBE_DESPLAZA_X = 8
    constante VBE_DESPLAZA_Y = 9
    constante VBE_MEMORIA = 0xA                 ; QEMU/Bochs: su memoria, en trozos de 64 K; VirtualBox: en octetos (leída de 32 bits)
    constante VBE_ENCENDIDO = 0x41              ; encendido, con la memoria seguida
    constante VBE_LO_QUE_DA = 2                 ; con él en VBE_ACTIVAR, el ancho, el alto y los bits que se leen son los máximos
    público constante VENTANA_PANTALLA = 0x1000000  ; lo más que se pone a la vista de la memoria de la pantalla (GRÁFICOS_TABLAS)

    público variable hay_pantalla: bool         ; ya hay un modo gráfico puesto
    público variable pantalla: Lienzo           ; la pantalla de verdad
    público variable pantalla_física: nat32     ; dónde está su memoria (dirección física)
    público variable por_bochs: bool            ; el modo lo ha puesto la VBE de Bochs (no el cargador)
    público variable bits_pantalla: nat32       ; los bits por punto del modo (32, 24 o 16)
    variable real: nat32                        ; la pantalla de verdad (si no es de 32 bits)
    variable octetos_fila: nat32                ; de una fila a la siguiente, en ella
    variable lienzo_aparte: puntero a byte      ; el lienzo de 32 bits (si el modo no lo es), para soltarlo al cambiar
    variable al_revés: bool                     ; (UEFI) la pantalla es RGB (el rojo abajo): volcar() da la vuelta a los puntos

    función vbe_pon(índice: nat32, dato: nat32)
        ensamblador
            mov edx, {VBE_ÍNDICE}
            mov eax, {índice}
            out dx, ax
            mov edx, {VBE_DATO}
            mov eax, {dato}
            out dx, ax
        fin
    fin

    función vbe_lee(índice: nat32): nat32
        ensamblador
            mov edx, {VBE_ÍNDICE}
            mov eax, {índice}
            out dx, ax
            mov edx, {VBE_DATO}
            xor eax, eax
            in ax, dx
        fin
    fin

    ; ¿está la tarjeta de Bochs/QEMU? (o sea: ¿es una máquina de mentira?)
    público función hay_bochs(): bool
        variable id: nat32
        id := vbe_lee(VBE_ID)
        devolver id >= 0xB0C0 y id <= 0xB0CF
    fin

    ; una palabra de 32 bits de la configuración PCI de un dispositivo
    función pci_lee(bus: nat32, dispositivo: nat32, registro: nat32): nat32
        variable dir: nat32
        dir := 0x80000000 ob (bus << 16) ob (dispositivo << 11) ob (registro yb 0xFC)
        ensamblador
            mov edx, 0xCF8
            mov eax, {dir}
            out dx, eax
            mov edx, 0xCFC
            in eax, dx
        fin
    fin

    ; la tarjeta con la VBE de Bochs en el PCI: la de QEMU y Bochs (1234:1111),
    ; la VBoxVGA de VirtualBox (80EE:BEEF) o la VMSVGA (15AD:0405, la de
    ; VMware que imitan VirtualBox y QEMU: su memoria, en la segunda zona).
    ; Da su identificador (0 si no está) y dónde está (bus y dispositivo)
    función tarjeta_bochs(ref bus_: nat32, ref d_: nat32): nat32
        variable bus, d, id: nat32
        para bus desde 0 hasta 3 hacer
            para d desde 0 hasta 31 hacer
                id := pci_lee(bus, d, 0)
                si id = 0x11111234 o id = 0xBEEF80EE o id = 0x040515AD entonces
                    bus_ := bus
                    d_ := d
                    devolver id
                fin
            fin
        fin
        devolver 0
    fin

    ; la memoria de la pantalla de la VGA de Bochs/QEMU (su primera zona PCI;
    ; la segunda en la VMSVGA); si no aparece en el PCI, donde la ponía la de ISA
    función memoria_bochs(): nat32
        variable bus, d, id: nat32
        id := tarjeta_bochs(bus, d)
        si id = 0x040515AD entonces devolver pci_lee(bus, d, 0x14) yb 0xFFFFFFF0 fin
        si id <> 0 entonces devolver pci_lee(bus, d, 0x10) yb 0xFFFFFFF0 fin
        devolver 0xE0000000
    fin

    ; ¿se puede cambiar el modo en marcha? (hay escritorio y la VBE de Bochs)
    ; (UEFI: nunca; el modo lo pone el firmware al arrancar)
    público función se_cambia_en_marcha(): bool
        devolver hay_pantalla y hay_bochs() y no arrancado_por_uefi()
    fin

    ; lo más que da la tarjeta (su ancho y su alto), preguntado a la VBE de
    ; Bochs (VirtualBox dice 16384 x 16384: lo que cabe lo dice su memoria)
    público función máximo_tarjeta(ref an: nat32, ref al: nat32)
        variable antes: nat32
        an := 0
        al := 0
        si no hay_bochs() entonces devolver fin
        antes := vbe_lee(VBE_ACTIVAR)
        vbe_pon(VBE_ACTIVAR, antes ob VBE_LO_QUE_DA)
        an := vbe_lee(VBE_ANCHO)
        al := vbe_lee(VBE_ALTO)
        vbe_pon(VBE_ACTIVAR, antes)
    fin

    ; de cuánto en cuánto va el ancho: la VBE de QEMU y Bochs lo redondea a
    ; múltiplos de 8 (1366 se queda en 1360); la de VirtualBox (80EE:BEEF), no
    público función paso_ancho(): nat32
        variable bus, d: nat32
        si tarjeta_bochs(bus, d) = 0xBEEF80EE entonces devolver 1 fin
        devolver 8
    fin

    ; la memoria de la tarjeta, en octetos (0 si no se sabe): la de QEMU y
    ; Bochs, en trozos de 64 K; la de VirtualBox, en octetos, leída de 32 bits
    público función memoria_tarjeta(): nat32
        variable bus, d, id, n: nat32
        si no hay_bochs() entonces devolver 0 fin
        id := tarjeta_bochs(bus, d)
        si id = 0x11111234 entonces
            n := vbe_lee(VBE_MEMORIA)
            si n >= 16 y n <= 0x4000 entonces devolver n * 0x10000 fin
        sino si id = 0xBEEF80EE entonces
            ensamblador
                mov edx, {VBE_ÍNDICE}
                mov eax, {VBE_MEMORIA}
                out dx, ax
                mov edx, {VBE_DATO}
                in eax, dx
                mov {n}, eax
            fin
            si n >= 0x100000 y n <= 0x40000000 entonces devolver n fin
        fin
        devolver 0
    fin

    ; pone en la VBE de Bochs ese modo (32 bits por punto si no se dice otra
    ; cosa); da los octetos de una fila a la siguiente, o 0 si la tarjeta no
    ; lo da (y la deja apagada)
    función vbe_modo(ancho: nat32, alto: nat32, bits: nat32): nat32
        variable virt: nat32
        vbe_pon(VBE_ACTIVAR, 0)
        vbe_pon(VBE_ANCHO, ancho)
        vbe_pon(VBE_ALTO, alto)
        vbe_pon(VBE_BITS, bits)
        vbe_pon(VBE_ACTIVAR, VBE_ENCENDIDO)
        vbe_pon(VBE_ANCHO_VIRTUAL, ancho)
        vbe_pon(VBE_DESPLAZA_X, 0)
        vbe_pon(VBE_DESPLAZA_Y, 0)
        ; (VirtualBox no la enciende si no le cabe en su memoria, y lo dice
        ; con el bit de encendido: hay que mirarlo también)
        si vbe_lee(VBE_ANCHO) <> ancho o vbe_lee(VBE_ALTO) <> alto o vbe_lee(VBE_BITS) <> bits o vbe_lee(VBE_ACTIVAR) yb 1 = 0 entonces
            vbe_pon(VBE_ACTIVAR, 0)
            devolver 0
        fin
        virt := vbe_lee(VBE_ANCHO_VIRTUAL)
        si virt < ancho entonces virt := ancho fin
        devolver virt * (bits div 8)
    fin

    ; pone la memoria física de la pantalla en la zona de los gráficos
    público función a_la_vista(física: nat32, octetos: nat32): bool     ; (UEFI) público: también textouefi.cas
        variable v: nat32
        si octetos > GRÁFICOS_TABLAS * 0x400000 entonces devolver falso fin
        v := 0
        mientras v < octetos + (física yb 0xFFF) hacer
            si no mapear(directorio_núcleo, GRÁFICOS_INICIO + v, (física yb 0xFFFFF000) + v, ESCRIBIR) entonces devolver falso fin
            v := v + PÁGINA
        fin
        poner_cr3(leer_cr3())
        devolver cierto
    fin

    ; n puntos de 32 bits, a 24 (tres octetos cada uno)
    función fila_a_24(destino: nat32, origen: puntero a nat32, n: nat32)
        ensamblador
            mov edi, {destino}
            mov esi, {origen}
            mov ecx, {n}
        .otro:
            mov eax, [esi]
            mov [edi], ax
            shr eax, 16
            mov [edi+2], al
            add esi, 4
            add edi, 3
            dec ecx
            jnz .otro
        fin
    fin

    ; (UEFI) n puntos de 32 bits, con el rojo y el azul cambiados (RGB)
    función fila_al_revés(destino: nat32, origen: puntero a nat32, n: nat32)
        ensamblador
            mov edi, {destino}
            mov esi, {origen}
            mov ecx, {n}
        .otro:
            mov eax, [esi]
            mov edx, eax
            and edx, 0x0000FF00
            mov ebx, eax
            shr ebx, 16
            and ebx, 0xFF
            shl eax, 16
            and eax, 0x00FF0000
            or eax, edx
            or eax, ebx
            mov [edi], eax
            add esi, 4
            add edi, 4
            dec ecx
            jnz .otro
        fin
    fin

    ; n puntos de 32 bits, a 16 (5 de rojo, 6 de verde, 5 de azul)
    función fila_a_16(destino: nat32, origen: puntero a nat32, n: nat32)
        ensamblador
            mov edi, {destino}
            mov esi, {origen}
            mov ecx, {n}
        .otro:
            mov eax, [esi]
            mov edx, eax
            mov ebx, eax
            shr eax, 8
            and eax, 0xF800
            shr edx, 5
            and edx, 0x07E0
            shr ebx, 3
            and ebx, 0x001F
            or eax, edx
            or eax, ebx
            mov [edi], ax
            add esi, 4
            add edi, 2
            dec ecx
            jnz .otro
        fin
    fin

    ; lo que se ha dibujado en ese rectángulo de «pantalla», a la pantalla de
    ; verdad (con 32 bits por punto ya está en ella: nada)
    público función volcar(x: ent32, yy: ent32, an: ent32, al: ent32)
        variable j: ent32
        si (bits_pantalla = 32 y no al_revés) o no hay_pantalla entonces devolver fin
        si x < 0 entonces
            an := an + x
            x := 0
        fin
        si yy < 0 entonces
            al := al + yy
            yy := 0
        fin
        si x + an > pantalla.ancho entonces an := pantalla.ancho - x fin
        si yy + al > pantalla.alto entonces al := pantalla.alto - yy fin
        si an <= 0 o al <= 0 entonces devolver fin
        para j desde yy hasta yy + al - 1 hacer
            si al_revés entonces                ; (UEFI)
                fila_al_revés(real + nat32(j) * octetos_fila + nat32(x) * 4, pantalla.puntos + (j * pantalla.ancho + x), nat32(an))
            sino si bits_pantalla = 24 entonces
                fila_a_24(real + nat32(j) * octetos_fila + nat32(x) * 3, pantalla.puntos + (j * pantalla.ancho + x), nat32(an))
            sino
                fila_a_16(real + nat32(j) * octetos_fila + nat32(x) * 2, pantalla.puntos + (j * pantalla.ancho + x), nat32(an))
            fin
        fin
    fin

    ; pone un modo gráfico (de 32 bits por punto si se puede elegir), de ese
    ; ancho y ese alto. «bits_pedidos», para probar: 24 o 16 con la VBE de
    ; Bochs (0: lo normal). Falso si no hay manera (y dice por qué).
    público función pon_modo(ancho: nat32, alto: nat32, bits_pedidos: nat32): bool
        variable base, fila, an, al, bits, id: nat32
        variable m: puntero a byte
        si hay_pantalla entonces devolver cierto fin
        si bits_pedidos <> 24 y bits_pedidos <> 16 entonces bits_pedidos := 32 fin
        si pantalla_del_cargador(base, fila, an, al, bits) entonces
            si bits <> 32 y bits <> 24 y bits <> 16 entonces
                escribir("pantalla: el cargador ha puesto un modo de ", bits, " bits por punto, y tiene que ser de 32, 24 o 16\n")
                devolver falso
            fin
        sino
            si no hay_bochs() entonces
                escribir("pantalla: no hay modo gráfico (ni lo ha puesto el cargador ni hay VBE de Bochs/QEMU)\n")
                devolver falso
            fin
            fila := vbe_modo(ancho, alto, bits_pedidos)
            si fila = 0 entonces
                escribir("pantalla: la tarjeta no da ", ancho, "x", alto, " con ", bits_pedidos, " bits por punto\n")
                devolver falso
            fin
            base := memoria_bochs()
            an := ancho
            al := alto
            bits := bits_pedidos
            por_bochs := cierto
        fin
        si no a_la_vista(base, fila * al) entonces
            escribir("pantalla: no se puede poner a la vista la memoria de la pantalla\n")
            devolver falso
        fin
        pantalla_física := base
        bits_pantalla := bits
        al_revés := bits = 32 y pantalla_al_revés()          ; (UEFI)
        si bits = 32 y fila yb 3 = 0 y no al_revés entonces
            pon_lienzo(pantalla, puntero(GRÁFICOS_INICIO + (base yb 0xFFF)), fila div 4, an, al)
        sino
            ; no es de 32 bits: se dibuja en un lienzo aparte, y volcar() lo pasa
            si bits = 32 y no al_revés entonces bits_pantalla := 24 fin     ; (no pasa: una fila de 32 bits siempre es múltiplo de 4)
            m := reservar(an * al * 4)
            si m = nulo entonces
                escribir("pantalla: no hay memoria para el lienzo de la pantalla\n")
                devolver falso
            fin
            real := GRÁFICOS_INICIO + (base yb 0xFFF)
            octetos_fila := fila
            lienzo_aparte := m
            pon_lienzo(pantalla, puntero(m), an, an, al)
        fin
        hay_pantalla := cierto
        devolver cierto
    fin

    ; cambia el modo en marcha, por la VBE de Bochs (QEMU, Bochs, VirtualBox),
    ; a ese ancho y ese alto con 32 bits por punto. La memoria de la pantalla
    ; es la misma (la tarjeta no la mueve): se pone a la vista lo que mida
    ; ahora y «pantalla» pasa a ser la de la medida nueva (lo que tenga
    ; dentro, a pintar otra vez). Falso si no se puede: entonces se queda el
    ; modo de antes, tal cual.
    público función cambia_modo(ancho: nat32, alto: nat32): bool
        variable fila, an0, al0, bits0: nat32
        si no hay_pantalla o no hay_bochs() o arrancado_por_uefi() entonces devolver falso fin     ; (UEFI)
        si ancho < 640 o alto < 480 o ancho * alto * 4 > VENTANA_PANTALLA entonces devolver falso fin
        an0 := nat32(pantalla.ancho)
        al0 := nat32(pantalla.alto)
        bits0 := bits_pantalla
        fila := vbe_modo(ancho, alto, 32)
        si fila = 0 o fila * alto > VENTANA_PANTALLA o no a_la_vista(pantalla_física, fila * alto) entonces
            escribir("pantalla: la tarjeta no da ", ancho, "x", alto, " con 32 bits por punto: se vuelve a ", an0, "x", al0, "\n")
            si vbe_modo(an0, al0, bits0) = 0 entonces vbe_modo(an0, al0, 32) fin
            devolver falso
        fin
        si lienzo_aparte <> nulo entonces
            liberar(lienzo_aparte)
            lienzo_aparte := nulo
        fin
        bits_pantalla := 32
        por_bochs := cierto
        pon_lienzo(pantalla, puntero(GRÁFICOS_INICIO + (pantalla_física yb 0xFFF)), fila div 4, ent32(ancho), ent32(alto))
        escribir("pantalla: ", ancho, "x", alto, " con 32 bits por punto (cambiado en marcha, por la VBE de Bochs)\n")
        devolver cierto
    fin

fin Video.
