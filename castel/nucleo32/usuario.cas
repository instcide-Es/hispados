; =============================================================================
;  usuario.cas - los programas del anillo 3 en el núcleo de Hispa-Pentium: se
;  cargan del disco (fat.cas) o de los módulos de multiboot (en QEMU, -initrd
;  "uno.bin,otro.bin"), cada uno en su espacio de direcciones (su directorio
;  de páginas), y hablan con el núcleo por la interrupción 0x80, la llamada al
;  sistema. Lo que se pide va en EAX, y sus datos en EBX, ECX y EDX; lo que
;  se devuelve, en EAX:
;
;    1  escribir ECX octetos desde EBX               -> los escritos
;    2  acabar, con el código de EBX                 (no vuelve)
;    3  dormir EBX tics
;    4  los tics desde que arrancó el núcleo
;    5  el número de la tarea
;    6  leer una tecla (EBX = 0: la espera; 1: solo si la hay) -> la letra, o 0
;    7  abrir el archivo o la carpeta de nombre EBX, del modo ECX (0: leer;
;       1: leer y escribir; 2: crearlo, o dejarlo vacío; 3: escribir al
;       final, creándolo si no está)                 -> su manejador
;    8  leer del archivo EBX, a ECX, hasta EDX octetos -> los leídos (0: el final)
;    9  cerrar el archivo EBX
;   10  lanzar el programa de nombre EBX, con los argumentos ECX (un texto, o 0)
;                                                    -> el número de su tarea
;   11  esperar a que acabe la tarea EBX (una que se ha lanzado) -> su código
;   12  la entrada siguiente de la carpeta EBX, a ECX (32 octetos) -> 1, o 0 si no hay más
;   13  lo que mide el archivo EBX
;   14  los argumentos del programa, a EBX (donde caben ECX octetos) -> su largo
;   15  un dato del sistema, el número EBX (los de DATO_... de aquí abajo)
;   16  borrar la pantalla
;   17  mover el final de la memoria del programa EBX octetos (con signo)
;                                                    -> el final de antes
;   18  escribir en el archivo EBX, desde ECX, EDX octetos -> los escritos
;   19  mover la posición del archivo EBX a ECX octetos (con signo) del
;       principio (EDX = 0), de donde está (1) o del final (2) -> la posición
;   20  dejar el archivo EBX con el tamaño de su posición (cortarlo ahí)
;   21  borrar el archivo de nombre EBX
;   22  cambiar el nombre EBX por el nombre ECX (un archivo, también a otra carpeta)
;   23  hacer la carpeta de nombre EBX
;   24  borrar la carpeta de nombre EBX (vacía)
;   25  la carpeta de trabajo pasa a ser la de nombre EBX
;   26  la carpeta de trabajo, a EBX (donde caben ECX octetos) -> su largo
;   27  lo que escriba el programa (y los que lance), al archivo EBX, abierto
;       para escribir (0xFFFFFFFF: otra vez a la pantalla)
;   28  la entrada siguiente de la carpeta EBX, a ECX (32 octetos), y su
;       nombre largo, a EDX (256 octetos)            -> 1, o 0 si no hay más
;   29  Ctrl+C: lo atiende el programa (EBX = 1) o lo acaba (0)
;   30  ¿se ha pulsado Ctrl+C desde la última vez que se preguntó? -> 1 o 0
;   31  el teclado: el español (EBX = 1) o el de EE. UU. (0); con otra cosa,
;       solo dice cuál hay                           -> 1 o 0
;   (32 a 43: las ventanas, el portapapeles, los terminales y las unidades)
;   (90 a 98: la red, con el servicio de red, RED.BIN: los cuenta red.cas;
;   y la 99, las conexiones cifradas, con el servicio TLS, TLS.BIN; (WIFI)
;   y la 100, el Wi-Fi, con el servicio Wi-Fi, WIFI.BIN)
;   Para instalar el sistema en el disco (el programa INSTALAR) y para el
;   asistente del primer arranque (ASISTE.BIN), desde la 0.7:
;   60  texto en la pantalla de texto: EDX letras de ECX en la columna (bits
;       0-7 de EBX) y la fila (8-15), con el color de los bits 16-23; con el
;       bit 31, EDX veces la letra ECX
;   61  ECX octetos de EBX, solo al puerto serie (para ver lo que pasa)
;   62  el cursor de la pantalla de texto, a la columna y la fila de EBX
;       (como en la 60; una fila de 25 para arriba: no se ve)
;   63  lo que se sabe del disco número EBX, a ECX (Info_disco) -> 1, o 0
;   64  leer sectores del disco EBX como dice ECX (el primer sector,
;       cuántos —hasta 128— y adónde)                -> 0
;   65  escribirlos (solo con «instalar» en la línea del cargador, en un
;       disco de dentro que no lleve la unidad del sistema: nunca en una
;       memoria USB); sus unidades dejan de estar montadas -> 0
;   66  reiniciar el equipo
;   67  poner en hora el reloj del PC: la fecha (EBX) y la hora (ECX), como
;       las guarda la FAT
;   68  los ajustes (HISPA.INI): EBX = 0, leerlos otra vez; 1, el nombre
;       del usuario a ECX (caben EDX); 2, ¿está el sistema instalado en el
;       disco?; 3, el nombre del equipo a ECX
;   El USB en caliente (desde la 0.8; usbcal.cas):
;  130  quitar con seguridad la memoria USB de la unidad de letra EBX: lo
;       pendiente se escribe y la memoria se para -> 0, ya se puede quitar;
;       1, no hay tal unidad; 2, no es una memoria USB; 3, el sistema corre
;       desde ella (no se quita)
;  131  las veces que han aparecido o desaparecido unidades (para saber si
;       hay que mirarlas otra vez; a las ventanas les llega EV_UNIDADES)
;   (CD) Los CD, los DVD y las imágenes de disco (cdcal.cas):
;  132  expulsar la unidad de letra EBX: la de un lector de CD o DVD (aunque
;       no tenga disco) abre la bandeja; la de una imagen, la desmonta -> 0;
;       1, no hay tal unidad; 2, no es un CD ni una imagen
;  133  montar la imagen de disco (.ISO, .CUE/.BIN, .IMG) del archivo EBX
;       -> la letra de su unidad; 1, no está; 2, no es una imagen que se
;       pueda leer; 3, está en demasiados trozos; 4, no caben más; 5, está
;       en la unidad en memoria (M:)
;   (REPRODUCTOR) El Reproductor (y los programas de Windows, por MCI):
;  134  el CD de música del lector de la letra EBX: ECX = 0, la tabla de las
;       pistas (una Toc_cd de cdrom.cas, 808 octetos) a EDX; 1, leer
;       sectores de sonido (EDX: una Pide_sonido, el lba, cuántos —hasta 64—
;       y adónde; 2352 octetos cada uno); 2, igual pero en crudo (sin mirar
;       la clase del sector) -> 0; NO_HAY, no es un lector; MAL, no se lee
;  135  el icono de la ventana EBX (suya) en la bandeja: ECX, 16 x 16 puntos,
;       la ayuda (48) y las opciones de su menú (160, con «|»); 0, quitarlo.
;       Un clic llega a la ventana como EV_BANDEJA (a = SIN_ELEGIR), y lo
;       elegido del menú del botón secundario, con su número
;       (lo soltado desde Mi equipo en una ventana, tras EV_SOLTADO: la 173)
;   150 a 154: apagar de verdad, reiniciar y la batería (energia.cas): las
;       150 a 153 solo para el servicio de ACPI (ACPI.BIN); la 154, la
;       batería, para todos
;  155  (dispositivos) la lista de los dispositivos y qué los lleva, a EBX
;       (hasta ECX fichas de 320 octetos: Dispositivo, dispositivos.cas)
;       -> cuántos hay. Solo lee
;  156  (dispositivos; solo los servicios: ACPI.BIN, RED.BIN) apuntar la
;       ficha de EBX (ECX = 0), u olvidar las suyas (ECX = 1)
;   (PROTEGE) La zona protegida y el modo administrador (permisos.cas):
;  157  el modo administrador: EBX = 0, pedirlo (el núcleo pregunta en la
;       pantalla: con el escritorio, una ventanita suya; sin él, en la
;       consola de texto, «S» o «N») -> 1, concedido; 0, no (DENEGADO si no
;       se puede preguntar: una sesión de SSH sin escritorio); 1, dejarlo
;       -> 0; 2, preguntar si se tiene -> 1 o 0
;  158  (solo los servicios) el sello de la tarea EBX (Permisos.SELLO_...)
;       -> su sello, o NO_VALE; con el bit 31 de lo devuelto, es un servicio
;  Lo que se escribe, se borra o se cambia de nombre en la zona protegida
;  (\HISPA de la unidad del sistema y lo que dice la tabla), y lo que se lee
;  de un secreto, solo lo puede quien tiene permiso: si no, DENEGADO.
;   (USUARIOS) Los usuarios (cuentas.cas) y el azar (pozo.cas):
;  200  lo de los usuarios: EBX = 0, cuántos hay (0: sin usuarios, el sistema
;       sin instalar); 1, la ficha número ECX (Ficha_usuario, 64 octetos) a
;       EDX -> 1, o 0 si no hay tantos; 2, el número del usuario de la tarea
;       (0: el sistema); 3, ¿es administrador? -> 1 o 0; 4, su carpeta
;       («\USUARIOS\CARLOS») a ECX (caben EDX) -> su largo (0: no tiene);
;       5, el que ha entrado en la pantalla (0: nadie)
;  201  (solo USUARIOS.BIN, Configuración › Usuarios) crear, quitar y
;       cambiar usuarios y contraseñas: EBX, un Pedido_usuario. Los demás,
;       solo un administrador; la contraseña propia, cada uno (con la de antes)
;  202  (solo SSHD.BIN) EBX = 0: ¿es esa la contraseña (UTF-8) de ese
;       usuario? (ECX, un Pedido_usuario) -> su número, y el programa que
;       lance luego será suyo; o DENEGADO; 1, lo mismo con una llave ya comprobada
;  209  (solo ARGON2.BIN, el que pone el núcleo) EBX = 0: el pedido, a ECX
;       (caben EDX); 1: el resumen (32 octetos de ECX)
;  210  ECX octetos de azar (hasta 256) del pozo del núcleo, a EBX -> ECX
;  (TERMO) 220 a 225: las temperaturas del procesador y de las zonas
;       térmicas de ACPI, para el Termómetro (TERMO.BIN): solo leer, de una
;       lista cerrada de registros (termo.cas)
;  (TERMO) 238: los discos de dentro, para el Termómetro: quiénes son, su
;       SMART (o el registro de salud de NVMe) y medir lecturas; solo leer, y
;       lo leído no sale del núcleo (tdisco.cas)
;  (SONIDO) 190 a 199: el sonido, con el servicio de sonido (SONIDO.BIN):
;       los canales de los programas, el volumen, los sonidos del sistema y
;       tocar un .WAV (la 194); los cuenta sonido.cas
;
;  Los nombres de archivo que no empiezan por una barra se entienden desde la
;  carpeta de trabajo de la tarea (la hereda de quien la lanza); «.» y «..»
;  valen. Lo que se escribe en un archivo (27) lleva sus finales de línea
;  como los del DOS (retorno de carro y avance).
;
;  Lo que no puede ser da un número de 0xFFFFFFF0 para arriba (los de fat.cas
;  y los de aquí: NO_PROGRAMA, SIN_MEMORIA, NO_VALE). Lo que el programa da
;  como dirección se comprueba antes de tocarlo: tiene que ser suyo.
;  Mientras se atiende una llamada las interrupciones siguen abiertas (el
;  reloj sigue repartiendo el procesador); lo que es de todos va con su
;  cerrojo (la pantalla, el teclado, el disco) o tapándolas un momento.
;
;  Un programa de usuario se escribe en Castel con «modelo usuario»
;  (CASTEL32.md): escribir y salir ya van por aquí, y lo demás lo da el módulo
;  Llamadas (llamadas.cas). Su archivo empieza con una cabecera: la magia
;  «HPU3», dónde va (0x40000000), hasta dónde llega lo que hay en el archivo,
;  hasta dónde lo que empieza a cero, y por dónde empieza.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Usuario

    importar Tareas, Paginas, Marcos, Multiboot, Cpu, Monton, Consola, Discos, Fat, Unidades, Fecha, Mem32, Formato, Terminal, Ventanas, Video, Grafico, Emergente, Ajustes, Textos32, Usbcal, Cdcal, Red, Energia, Dispositivos, Win32, Permisos, Sonido, Cuentas, Pozo, Preferencias, Cdrom, I2chid, Termo, Termoram, Apuntero, Sdacpi, Tdisco

    constante MAGIA = 0x33555048                ; «HPU3»
    público constante MATADA = 255              ; el código de una tarea que el núcleo ha tenido que acabar
    público constante VERSIÓN = 0x0008          ; la 0.8
    ; la versión de verdad, la del paquete «base» (tools/hpq.py, SISTEMA): la
    ; que dicen el menú Inicio, Configuración y «Acerca de» (la primera parte
    ; de las pruebas mira que sea la misma que la de hpq.py)
    ; (PANEL) la 0.8.7: el Panel de control y la hora por Internet
    ; (TOUCHPAD) la 0.8.9 (antes, 0.8.8)
    público constante VERSIÓN_TEXTO = "0.8.12"
    público constante SIGUE = 0xFFFFFF00        ; (esperar sin quedarse) la tarea no ha acabado todavía

    ; ---- más errores (los de los archivos, en fat.cas) ----
    público constante NO_PROGRAMA = 0xFFFFFFFB  ; el archivo no es un programa de Hispa-Pentium
    público constante SIN_MEMORIA = 0xFFFFFFFA  ; no hay memoria (o no quedan tareas)
    público constante NO_VALE = 0xFFFFFFF9      ; lo que se pide no tiene sentido

    ; ---- los datos del sistema (la llamada 15) ----
    público constante DATO_MARCOS_LIBRES = 0
    público constante DATO_MARCOS = 1
    público constante DATO_MIS_PÁGINAS = 2      ; las páginas del programa que pregunta
    público constante DATO_VERSIÓN = 3
    público constante DATO_TAREAS = 4
    público constante DATO_FAT = 5              ; 12, 16 o 32 (0 si no hay disco)
    público constante DATO_CLUSTER = 6          ; los octetos de un cluster del disco
    público constante DATO_CLUSTERS_LIBRES = 7  ; (0xFFFFFFFF si no se sabe)
    público constante DATO_CLUSTERS = 8
    público constante DATO_HZ = 9               ; los tics por segundo
    público constante DATO_FECHA = 10           ; la fecha (arriba) y la hora (abajo), como las guarda la FAT
    público constante DATO_ANCHO_PANTALLA = 11  ; el ancho de la pantalla gráfica (0 si no hay)
    público constante DATO_ALTO_PANTALLA = 12
    público constante DATO_ESCRITORIO = 13      ; 1 si el escritorio está en marcha
    público constante DATO_ALTO_LIBRE = 14      ; (explorador) lo alto de la pantalla sin la barra de tareas ni el dock
    público constante DATO_TERMINAL = 15        ; (REPRODUCTOR) 1 si la tarea escribe en un terminal (la Consola, SSH)
    público constante DATO_MIS_TICS = 16        ; (REPRODUCTOR) los tics en que el reloj ha pillado corriendo a la tarea (lo que gasta)
    público constante DATO_ARREGLO = 17         ; (0.8.7) el tercer número de la versión de verdad (VERSIÓN_TEXTO: el 7 de la 0.8.7)

    ; la función (sin argumentos; da 1 o 0) que pone en marcha el escritorio:
    ; la pone escritorio.cas, y se la llama por su dirección
    público variable al_escritorio: nat32
    público variable escritorio_en_marcha: bool

    ; (explorador) lo que un programa ha soltado fuera de su ventana (la
    ; llamada 171): la ruta y el punto de la pantalla. Lo recoge el
    ; escritorio (un acceso en el tapiz, o fijarlo en el dock)
    público variable suelta_pedida: bool
    público variable suelta_x, suelta_y: ent32
    público variable suelta_ruta: arreglo [128] de byte
    ; (BLOC, REPRODUCTOR) lo soltado encima de la ventana de un programa
    ; (EV_SOLTADO): la ruta y la ventana; el programa la pide con la llamada
    ; 173 (una sola manera para el Bloc de notas, el Reproductor y los demás)
    público variable soltado_ruta: arreglo [128] de byte
    público variable soltado_para: nat32
    tipo Suelta = estructura
        x, ye: ent32
        ruta: nat32
    fin

    ; (MIRADOR) el tapiz con una imagen (la llamada 172): la guarda el
    ; núcleo en FONDO.HPM (al lado de DOCK.INI) y la pinta el escritorio.
    ; 0: nada que hacer; 1: volver al de siempre; 2: poner la de FONDO.HPM
    público variable tapiz_pedido: nat32
    tipo Imagen_tapiz = estructura
        ancho, alto: nat32
        puntos: nat32                           ; 0x00RRGGBB, fila a fila
    fin

    constante MAX_PROGRAMA = 0x800000           ; lo más que mide un programa en el disco (8 MB desde la 0.8.3: el Navegador)
    constante MAX_RUTA = 128
    constante MAX_ARGS = 128

    ; lo que se da de una unidad (la llamada 43; es la misma de llamadas.cas)
    público tipo Info_unidad = estructura
        letra: byte                             ; 0: un disco sin ningún volumen que se pueda leer
        clase: byte                             ; 12, 16 o 32 (FAT); 1: en memoria; 0: nada
        medio: byte                             ; 0: memoria; 1: IDE; 2: SATA; 3: USB
        solo_lectura: byte
        total_k, libre_k: nat32                 ; en K (libre_k = 0xFFFFFFFF: no se sabe)
        del_sistema: nat32                      ; 1: es la unidad del sistema
        nombre: arreglo [41] de byte            ; el modelo del disco
        etiqueta: arreglo [12] de byte          ; el nombre del volumen
        quitable: byte                          ; 1: una memoria USB que se puede quitar con seguridad (130); 2: (CD) se puede expulsar (132)
        relleno: arreglo [2] de byte            ; (CD) [0]: lo que hay en el lector (0: nada; 1: datos; 2: música; 3: no se lee)
    fin

    ; lo que se da de un disco (la llamada 63; es la misma de llamadas.cas)
    público tipo Info_disco = estructura
        clase: nat32                            ; 1: IDE; 2: SATA; 3: USB
        sectores: nat32
        se_puede: nat32                         ; 1: el programa INSTALAR puede escribir en él
        del_sistema: nat32                      ; 1: lleva la unidad del sistema
        modelo: arreglo [44] de byte
    fin
    tipo Pedido_disco = estructura              ; (las llamadas 64 y 65)
        lba, n, datos: nat32
    fin
    ; con «instalar» en la línea del cargador: se deja escribir en los discos
    ; de dentro sector a sector (lo dice semilla.cas)
    público variable instalando: bool

    tipo Cabecera = estructura
        salto: nat32
        magia, inicio, datos_fin, vacío_fin, entrada: nat32
    fin

    ; -------------------------------------------------------------------------
    ;  La llamada al sistema
    ; -------------------------------------------------------------------------
    ; copia un texto del programa (acabado en 0) a la memoria del núcleo,
    ; mirando que cada octeto sea suyo. Falso si no lo es o si no cabe.
    función texto_de_usuario(dir: nat32, destino: puntero a byte, cabe: nat32): bool
        variable i: nat32
        variable p: puntero a byte
        p := puntero(dir)
        i := 0
        mientras i < cabe hacer
            si (i = 0 o (dir + i) yb (PÁGINA - 1) = 0) y no usuario_puede(actual.cr3, dir + i, 1, falso) entonces
                devolver falso
            fin
            destino[i] := p[i]
            si p[i] = 0 entonces devolver cierto fin
            i := i + 1
        fin
        devolver falso
    fin

    función es_barra(c: byte): bool
        devolver c = '\\' o c = '/'
    fin

    función mayús(c: byte): byte
        si c >= 'a' y c <= 'z' entonces devolver c - 32 fin
        devolver c
    fin

    ; la unidad de trabajo de una tarea: su número (NINGUNA si no hay ninguna)
    función unidad_de(t: puntero a Tarea): nat32
        si t.unidad = 0 entonces devolver del_sistema fin
        devolver t.unidad - 1
    fin

    ; la ruta entera de un nombre, desde la raíz de su unidad. Si empieza
    ; por una letra y dos puntos («X:»), es de esa unidad; si no, de la de
    ; trabajo de la tarea. Si no empieza por una barra, va detrás de la
    ; carpeta de trabajo (si es de la unidad de trabajo); «.» y «..» se
    ; resuelven. Queda en «destino» (donde caben «cabe» octetos) como
    ; «\UNA\OTRA» (la raíz, «\»), y en «u», la unidad (NINGUNA si no hay
    ; tal unidad). Falso si no cabe.
    función ruta_entera(dada: puntero a byte, destino: puntero a byte, cabe: nat32, ref u: nat32): bool
        variable p: puntero a byte
        variable n, k, i: nat32
        p := dada
        u := unidad_de(actual)
        si p[0] <> 0 y p[1] = ':' entonces
            u := por_letra(p[0])
            p := p + 2
        fin
        n := 0
        si no es_barra(p[0]) y u = unidad_de(actual) entonces
            mientras actual.carpeta[n] <> 0 y n + 1 < cabe hacer
                destino[n] := actual.carpeta[n]
                n := n + 1
            fin
        fin
        mientras cierto hacer
            mientras es_barra(valor(p)) hacer p := p + 1 fin
            si valor(p) = 0 entonces romper fin
            k := 0
            mientras p[k] <> 0 y no es_barra(p[k]) hacer k := k + 1 fin
            si k = 1 y p[0] = '.' entonces
                ; aquí mismo
            sino si k = 2 y p[0] = '.' y p[1] = '.' entonces
                mientras n > 0 y destino[n - 1] <> '\\' hacer n := n - 1 fin
                si n > 0 entonces n := n - 1 fin
            sino
                si n + k + 2 > cabe entonces devolver falso fin
                destino[n] := '\\'
                n := n + 1
                para i desde 0 hasta k - 1 hacer destino[n + i] := p[i] fin
                n := n + k
            fin
            p := p + k
        fin
        si n = 0 entonces
            destino[0] := '\\'
            n := 1
        fin
        destino[n] := 0
        devolver cierto
    fin

    ; el nombre de archivo que da el programa, copiado al núcleo y con su
    ; ruta entera; en «u», su unidad. Falso si no es suyo o no cabe.
    función ruta_de_usuario(dir: nat32, destino: puntero a byte, ref u: nat32): bool
        variable dada: arreglo [MAX_RUTA] de byte
        si no texto_de_usuario(dir, dada, MAX_RUTA) entonces devolver falso fin
        devolver ruta_entera(dada, destino, MAX_RUTA, u)
    fin

    ; ¿es esa carpeta (su ruta entera, en la unidad u) la de trabajo de
    ; alguna tarea, o está por encima de ella?
    función es_carpeta_de_alguien(u: nat32, ruta: puntero a byte): bool
        variable i, k: nat32
        para i desde 0 hasta MAX_TAREAS - 1 hacer
            si tareas[i].estado <> Tareas.LIBRE y unidad_de(dirección(tareas[i])) = u entonces
                k := 0
                mientras ruta[k] <> 0 y mayús(ruta[k]) = mayús(tareas[i].carpeta[k]) hacer k := k + 1 fin
                si ruta[k] = 0 y (tareas[i].carpeta[k] = 0 o tareas[i].carpeta[k] = '\\') entonces devolver cierto fin
            fin
        fin
        devolver falso
    fin

    ; ¿es la unidad u la que está en memoria (los módulos del cargador)?
    función en_memoria(u: nat32): bool
        si u >= MAX_UNIDADES entonces devolver falso fin
        devolver unidades[u].hay y unidades[u].clase = U_MEMORIA
    fin

    ; la unidad y la carpeta de trabajo de la tarea pasan a ser esas (la
    ; ruta entera de la carpeta, en la unidad u)
    función cambiar_carpeta(u: nat32, ruta: puntero a byte): nat32
        variable m, n: nat32
        si u >= MAX_UNIDADES entonces devolver SIN_DISCO fin
        si en_memoria(u) entonces
            ; (en la unidad en memoria no hay más carpeta que la raíz)
            si busca_módulo(ruta) <> MOD_RAÍZ entonces devolver NO_CARPETA fin
            actual.carpeta[0] := 0
            actual.unidad := u + 1
            devolver 0
        fin
        m := abrir_archivo(u, ruta, PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver m fin
        si no es_carpeta(m) entonces
            cerrar_archivo(m)
            devolver NO_CARPETA
        fin
        cerrar_archivo(m)
        n := 0
        mientras ruta[n] <> 0 hacer n := n + 1 fin
        si n >= MAX_CARPETA entonces devolver NO_VALE fin
        si n = 1 entonces n := 0 fin                    ; la raíz se guarda como «»
        actual.carpeta[n] := 0
        mientras n > 0 hacer
            n := n - 1
            actual.carpeta[n] := mayús(ruta[n])
        fin
        actual.unidad := u + 1
        devolver 0
    fin

    ; -------------------------------------------------------------------------
    ;  La unidad en memoria: los módulos del cargador hacen de M:
    ; -------------------------------------------------------------------------
    ; Los programas y archivos que el cargador ha traído como módulos (un
    ; PC arrancado de una memoria USB con GRUB) se ven como los archivos de
    ; la raíz de una unidad de solo lectura, M: (unidades.cas): se abren, se
    ; leen, salen en DIR y se lanzan por su nombre. Si no hay disco con FAT
    ; ni memoria USB que se pueda leer, es la unidad del sistema.
    constante MOD_BASE = 0x4D00                 ; sus manejadores: de aquí en adelante
    constante MOD_ABIERTOS = 8
    constante MOD_RAÍZ = 0xFFFFFF00             ; «el módulo» que es la carpeta raíz
    tipo Abierto_mod = estructura
        usado: bool
        dueño, cuál, pos: nat32
    fin
    variable mod_abiertos: arreglo [MOD_ABIERTOS] de Abierto_mod
    variable ficha_sd: Ficha_sdhci              ; (SDHCI) la de la llamada 160

    ; ¿es la unidad del sistema la que está en memoria?
    público función unidad_en_memoria(): bool
        devolver en_memoria(del_sistema)
    fin

    ; el nombre de archivo del módulo i (hasta el primer espacio, en
    ; mayúsculas), a «destino» (13 octetos)
    función nombre_de_módulo(i: nat32, destino: puntero a byte)
        variable t: puntero a byte
        variable n: nat32
        t := módulo_nombre(i)
        n := 0
        mientras n < 12 y t[n] <> 0 y t[n] <> ' ' hacer
            destino[n] := mayús(t[n])
            n := n + 1
        fin
        destino[n] := 0
    fin

    ; el módulo que se llama como dice la ruta («\NOMBRE.EXT», o sin barra):
    ; su número, MOD_RAÍZ si es la raíz, o NO_HAY
    función busca_módulo(ruta: puntero a byte): nat32
        variable p: puntero a byte
        variable nombre: arreglo [13] de byte
        variable i, k: nat32
        p := ruta
        mientras es_barra(valor(p)) hacer p := p + 1 fin
        si valor(p) = 0 entonces devolver MOD_RAÍZ fin
        i := 0
        mientras i < módulos() hacer
            nombre_de_módulo(i, nombre)
            k := 0
            mientras p[k] <> 0 y mayús(p[k]) = nombre[k] hacer k := k + 1 fin
            si p[k] = 0 y nombre[k] = 0 entonces devolver i fin
            i := i + 1
        fin
        devolver NO_HAY
    fin

    función abrir_módulo(ruta: puntero a byte, modo: nat32): nat32
        variable c, i: nat32
        si modo <> PARA_LEER entonces devolver PROTEGIDO fin
        c := busca_módulo(ruta)
        si c = NO_HAY entonces devolver NO_HAY fin
        i := 0
        mientras i < MOD_ABIERTOS y mod_abiertos[i].usado hacer i := i + 1 fin
        si i = MOD_ABIERTOS entonces devolver LLENO fin
        mod_abiertos[i].usado := cierto
        mod_abiertos[i].dueño := actual.id
        mod_abiertos[i].cuál := c
        mod_abiertos[i].pos := 0
        devolver MOD_BASE + i
    fin

    ; ¿es el manejador de un módulo abierto por la tarea que corre?
    función es_de_módulo(m: nat32): bool
        si m < MOD_BASE o m >= MOD_BASE + MOD_ABIERTOS entonces devolver falso fin
        devolver mod_abiertos[m - MOD_BASE].usado y mod_abiertos[m - MOD_BASE].dueño = actual.id
    fin

    función tamaño_módulo(m: nat32): nat32
        variable c: nat32
        c := mod_abiertos[m - MOD_BASE].cuál
        si c = MOD_RAÍZ entonces devolver 0 fin
        devolver módulo_final(c) - módulo_inicio(c)
    fin

    función leer_módulo(m: nat32, destino: puntero a byte, n: nat32): nat32
        variable c, pos, queda: nat32
        c := mod_abiertos[m - MOD_BASE].cuál
        si c = MOD_RAÍZ entonces devolver MAL fin
        pos := mod_abiertos[m - MOD_BASE].pos
        queda := tamaño_módulo(m) - pos
        si n > queda entonces n := queda fin
        si n > 0 entonces copiar_memoria(destino, puntero(módulo_inicio(c) + pos), n) fin
        mod_abiertos[m - MOD_BASE].pos := pos + n
        devolver n
    fin

    función mover_módulo(m: nat32, cuánto: nat32, origen: nat32): nat32
        variable pos: nat32
        según origen
            caso 0: pos := cuánto
            caso 1: pos := mod_abiertos[m - MOD_BASE].pos + cuánto
            caso 2: pos := tamaño_módulo(m) + cuánto
            si no: devolver NO_VALE
        fin
        si pos > tamaño_módulo(m) entonces pos := tamaño_módulo(m) fin
        mod_abiertos[m - MOD_BASE].pos := pos
        devolver pos
    fin

    ; la entrada siguiente de la raíz de la unidad en memoria: 1, o 0 si no
    ; hay más («largo», si no es nulo: su nombre largo, que es el mismo)
    función entrada_módulo(m: nat32, e: puntero a Entrada, largo: puntero a byte): nat32
        variable i, k, f, h: nat32
        si mod_abiertos[m - MOD_BASE].cuál <> MOD_RAÍZ entonces devolver 0 fin
        i := mod_abiertos[m - MOD_BASE].pos
        si i >= módulos() entonces devolver 0 fin
        nombre_de_módulo(i, e.nombre)
        e.atributos := 1                        ; de solo lectura
        e.reservado := 0
        e.tamaño := módulo_final(i) - módulo_inicio(i)
        ahora(f, h)
        e.fecha := f
        e.hora := h
        e.cluster := 0
        e.libre := 0
        si largo <> nulo entonces
            k := 0
            mientras e.nombre[k] <> 0 hacer
                largo[k] := e.nombre[k]
                k := k + 1
            fin
            largo[k] := 0
        fin
        mod_abiertos[m - MOD_BASE].pos := i + 1
        devolver 1
    fin

    función cerrar_módulos_de(dueño: nat32)
        variable i: nat32
        para i desde 0 hasta MOD_ABIERTOS - 1 hacer
            si mod_abiertos[i].usado y mod_abiertos[i].dueño = dueño entonces mod_abiertos[i].usado := falso fin
        fin
    fin

    ; lo que escribe un programa cuya salida va a un archivo: cada final de
    ; línea, como los del DOS (retorno de carro y avance). Da los octetos
    ; tomados; si el archivo ya no está, la salida vuelve a la pantalla.
    función a_la_salida(p: puntero a byte, n: nat32): nat32
        variable trozo: arreglo [256] de byte
        variable i, k, r: nat32
        variable c: byte
        i := 0
        k := 0
        r := 0
        mientras i < n y r < PRIMER_ERROR hacer
            c := p[i]
            si c = '\n' y no actual.salida_cr entonces
                trozo[k] := '\r'
                k := k + 1
            fin
            trozo[k] := c
            k := k + 1
            actual.salida_cr := c = '\r'
            i := i + 1
            si k >= 254 o i = n entonces
                r := escribir_salida(actual.salida, actual.salida_serie, trozo, k)
                k := 0
            fin
        fin
        si r = MAL entonces
            actual.salida := SIN_SALIDA
            escribir_trozo(p, n)
        fin
        si r >= PRIMER_ERROR entonces devolver r fin
        devolver n
    fin

    ; ¿puede el programa leer (o escribir) ahí? Como usuario_puede, pero si
    ; el trozo cae en su pila, donde aún no ha llegado a tocar (un arreglo
    ; local recién hecho), antes se le ponen esas páginas
    función puede(inicio: nat32, n: nat32, para_escribir: bool): bool
        variable p: nat32
        si n > 0 y inicio >= PILA_INICIO y inicio < PILA_FINAL y inicio + n > inicio y inicio + n <= PILA_FINAL entonces
            p := inicio yb 0xFFFFF000
            mientras p < inicio + n hacer
                si banderas_de(actual.cr3, p) = 0 y no atender_pila(actual.cr3, p, actual.esp_usuario) entonces devolver falso fin
                p := p + PÁGINA
            fin
        fin
        devolver usuario_puede(actual.cr3, inicio, n, para_escribir)
    fin

    ; mueve el final de la memoria del programa (su «quiebre»): hacia arriba
    ; le pone páginas nuevas (a cero); hacia abajo, las devuelve. Da el final
    ; de antes, o SIN_MEMORIA / NO_VALE.
    función mover_quiebre(cuánto: nat32): nat32
        variable antes, nuevo, v, m: nat32
        antes := actual.quiebre
        nuevo := antes + cuánto
        si cuánto = 0 entonces devolver antes fin
        si cuánto < 0x80000000 entonces
            si nuevo < antes o nuevo > PILA_INICIO entonces devolver SIN_MEMORIA fin
            v := redondear(antes, PÁGINA)
            mientras v < nuevo hacer
                m := reservar_marco()
                si m = 0 o no mapear(actual.cr3, v, m, ESCRIBIR ob USUARIO) entonces
                    si m <> 0 entonces soltar_marco(m) fin
                    ; lo que se había puesto, fuera
                    mientras v > redondear(antes, PÁGINA) hacer
                        v := v - PÁGINA
                        soltar_marco(desmapear(actual.cr3, v))
                    fin
                    devolver SIN_MEMORIA
                fin
                v := v + PÁGINA
            fin
        sino
            si nuevo > antes o nuevo < actual.quiebre_inicio entonces devolver NO_VALE fin
            v := redondear(nuevo, PÁGINA)
            mientras v < redondear(antes, PÁGINA) hacer
                soltar_marco(desmapear(actual.cr3, v))
                v := v + PÁGINA
            fin
        fin
        actual.quiebre := nuevo
        devolver antes
    fin

    ; (0.8.7) el tercer número de VERSIÓN_TEXTO («0.8.7»: 7; sin él, 0): la
    ; orden VER dice así la versión entera, de la misma constante que el menú
    ; Inicio, Configuración y «Acerca de»
    función arreglo_de_la_versión(): nat32
        variable i, puntos, n: nat32
        variable t: puntero a byte
        t := VERSIÓN_TEXTO
        i := 0
        puntos := 0
        n := 0
        mientras t[i] <> 0 hacer
            si t[i] = '.' entonces
                puntos := puntos + 1
            sino si puntos = 2 y t[i] >= '0' y t[i] <= '9' entonces
                n := n * 10 + nat32(t[i] - '0')
            fin
            i := i + 1
        fin
        devolver n
    fin

    función dato(cuál: nat32): nat32
        variable tablas, f, h, u: nat32
        u := unidad_de(actual)
        si u >= MAX_UNIDADES o en_memoria(u) entonces u := NINGUNA fin
        según cuál
            caso DATO_MARCOS_LIBRES: devolver marcos_libres()
            caso DATO_MARCOS: devolver marcos_totales()
            caso DATO_MIS_PÁGINAS:
                devolver cuenta_páginas(actual.cr3, USUARIO_INICIO >> 22, (USUARIO_FINAL >> 22) - 1, tablas)
            caso DATO_VERSIÓN: devolver VERSIÓN
            caso DATO_ARREGLO: devolver arreglo_de_la_versión()
            caso DATO_TAREAS: devolver cuántas_tareas()
            caso DATO_FAT:
                si u <> NINGUNA entonces devolver volúmenes[u].clase fin
                devolver 0
            caso DATO_CLUSTER:
                si u <> NINGUNA entonces devolver volúmenes[u].sectores_cluster * 512 fin
                devolver 0
            caso DATO_CLUSTERS_LIBRES: devolver clusters_libres(u)
            caso DATO_CLUSTERS:
                si u <> NINGUNA entonces devolver volúmenes[u].clusters fin
                devolver 0
            caso DATO_HZ: devolver HZ
            caso DATO_FECHA:
                ahora(f, h)
                devolver (f << 16) ob h
            caso DATO_ANCHO_PANTALLA:
                si hay_pantalla entonces devolver nat32(pantalla.ancho) fin
                devolver 0
            caso DATO_ALTO_PANTALLA:
                si hay_pantalla entonces devolver nat32(pantalla.alto) fin
                devolver 0
            caso DATO_ESCRITORIO:
                si escritorio_en_marcha entonces devolver 1 fin
                devolver 0
            caso DATO_ALTO_LIBRE:
                ; (explorador) lo que queda a lo alto sin la barra de tareas ni el dock
                si hay_pantalla y escritorio_en_marcha entonces devolver nat32(pantalla.alto - alto_barra - alto_dock) fin
                si hay_pantalla entonces devolver nat32(pantalla.alto) fin
                devolver 0
            caso DATO_TERMINAL:
                si actual.terminal <> 0 entonces devolver 1 fin      ; (REPRODUCTOR)
                devolver 0
            caso DATO_MIS_TICS:
                devolver actual.tics_usados                         ; (REPRODUCTOR)
        fin
        devolver NO_VALE
    fin

    ; (PUNTEROS) la llamada 177: se mira la memoria del programa y lo que
    ; lleva punteros se copia antes (que no lo cambie otro hilo a medias)
    función atender_177(a: nat32, b: nat32, c: nat32): nat32
        variable pp: Pinta_puntero
        variable z: Zona
        variable aj: Ajustes_puntero
        si a = 1 entonces
            si no puede(c, tamaño(Zona), falso) entonces devolver NO_VALE fin
            copiar_memoria(puntero(dirección(z)), puntero(c), tamaño(Zona))
            devolver atender_puntero(1, b, nat32(dirección(z)))
        fin
        si a = 2 entonces
            si no puede(b, tamaño(Ajustes_puntero), cierto) entonces devolver NO_VALE fin
            devolver atender_puntero(2, b, 0)
        fin
        si a = 3 entonces
            si no puede(b, tamaño(Ajustes_puntero), falso) entonces devolver NO_VALE fin
            copiar_memoria(puntero(dirección(aj)), puntero(b), tamaño(Ajustes_puntero))
            devolver atender_puntero(3, nat32(dirección(aj)), 0)
        fin
        si a = 4 entonces
            si no puede(c, tamaño(Pinta_puntero), falso) entonces devolver NO_VALE fin
            copiar_memoria(puntero(dirección(pp)), puntero(c), tamaño(Pinta_puntero))
            si pp.ancho < 1 o pp.alto < 1 o pp.ancho > 4096 o pp.alto > 4096 o pp.salto > 4096 o nat32(pp.ancho) > pp.salto entonces devolver NO_VALE fin
            si no puede(nat32(pp.puntos), pp.salto * nat32(pp.alto) * 4, cierto) entonces devolver NO_VALE fin
            devolver atender_puntero(4, 0, nat32(dirección(pp)))
        fin
        devolver atender_puntero(a, b, c)
    fin

    función atender(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable t: puntero a Tarea
        variable ruta, ruta2: arreglo [MAX_RUTA] de byte
        variable args: arreglo [MAX_ARGS] de byte
        variable r, u: nat32
        variable p: puntero a byte
        según n
            caso 1:
                si no puede(a, b, falso) entonces devolver 0xFFFFFFFF fin
                si actual.salida <> SIN_SALIDA entonces devolver a_la_salida(puntero(a), b) fin
                si actual.terminal <> 0 entonces devolver escribir_terminal(actual.terminal, puntero(a), b) fin
                escribir_trozo(puntero(a), b)
                devolver b
            caso 2:
                ; (JUEGOS) un hilo de un programa de Windows acaba el proceso:
                ; se le dice al proceso (con el código) y el hilo acaba; el
                ; proceso, antes de soltar lo suyo, acaba sus hilos
                si actual.líder <> nulo entonces
                    actual.líder.salir_con := a
                    actual.líder.salir_pedido := cierto
                    acabar_tarea(actual.líder)
                    terminar(a)
                fin
                acaba_hilos()
                recoge_lo_suyo()
                terminar(a)
            caso 3:
                dormir(a)
                devolver 0
            caso 4:
                devolver tics
            caso 5:
                devolver actual.id
            caso 6:
                si actual.terminal <> 0 entonces
                    si a = 0 o hay_tecla_terminal(actual.terminal) entonces devolver tecla_terminal(actual.terminal) fin
                    devolver 0
                fin
                si a = 0 o hay_tecla() entonces devolver leer_tecla() fin
                devolver 0
            caso 7:
                si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
                si en_memoria(u) entonces devolver abrir_módulo(ruta, b) fin
                ; (PROTEGE) la zona protegida y los secretos
                si b = PARA_LEER y no puede_leer(u, ruta) entonces devolver DENEGADO fin
                si b <> PARA_LEER y no puede_escribir(u, ruta) entonces devolver DENEGADO fin
                devolver abrir_archivo(u, ruta, b)
            caso 8:
                si no puede(b, c, cierto) entonces devolver NO_VALE fin
                si es_de_módulo(a) entonces devolver leer_módulo(a, puntero(b), c) fin
                devolver leer_archivo(a, puntero(b), c)
            caso 9:
                si es_de_módulo(a) entonces
                    mod_abiertos[a - MOD_BASE].usado := falso
                    devolver 0
                fin
                devolver cerrar_archivo(a)
            caso 10:
                si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
                args[0] := 0
                si b <> 0 y no texto_de_usuario(b, args, MAX_ARGS) entonces devolver NO_VALE fin
                si no puede_lanzar(u, ruta) entonces devolver DENEGADO fin     ; (USUARIOS) de la carpeta de otro, no
                t := carga_de(u, ruta, args, r)
                si t = nulo entonces devolver r fin
                devolver t.id
            caso 11:
                t := tarea_de(a)
                si t = nulo o t.padre <> actual.id entonces devolver NO_VALE fin
                si b = 1 y t.estado <> ACABADA entonces devolver SIGUE fin     ; sin quedarse esperando
                si b = 2 entonces
                    ; (CORTES) acabar un programa que ha lanzado este (y los que
                    ; ha lanzado él): «Cancelar», o un programa que no responde.
                    ; Luego se recoge con acabada() o esperar()
                    acaba_con_hijos(t, 0)
                    devolver 0
                fin
                devolver esperar(t)
            caso 12:
                si no puede(b, tamaño(Entrada), cierto) entonces devolver NO_VALE fin
                si es_de_módulo(a) entonces devolver entrada_módulo(a, puntero(b), nulo) fin
                devolver leer_entrada(a, puntero(b))
            caso 28:
                si no puede(b, tamaño(Entrada), cierto) o no puede(c, MAX_LARGO, cierto) entonces devolver NO_VALE fin
                si es_de_módulo(a) entonces devolver entrada_módulo(a, puntero(b), puntero(c)) fin
                devolver leer_entrada_larga(a, puntero(b), puntero(c), MAX_LARGO)
            caso 13:
                si es_de_módulo(a) entonces devolver tamaño_módulo(a) fin
                devolver tamaño_archivo(a)
            caso 14:
                r := 0
                si actual.args <> nulo entonces
                    mientras actual.args[r] <> 0 hacer r := r + 1 fin
                fin
                si b = 0 o no puede(a, b, cierto) entonces devolver NO_VALE fin
                si r >= b entonces r := b - 1 fin
                si r > 0 entonces copiar_memoria(puntero(a), actual.args, r) fin
                p := puntero(a + r)
                valor(p) := 0
                devolver r
            caso 15:
                devolver dato(a)
            caso 16:
                si actual.terminal <> 0 entonces
                    escribir_terminal(actual.terminal, "\x0C", 1)       ; (el salto de página: lo entiende la Consola)
                    devolver 0
                fin
                borrar_pantalla()
                devolver 0
            caso 17:
                devolver mover_quiebre(a)
            caso 18:
                si no puede(b, c, falso) entonces devolver NO_VALE fin
                devolver escribir_archivo(a, puntero(b), c)
            caso 19:
                si es_de_módulo(a) entonces devolver mover_módulo(a, b, c) fin
                devolver mover_archivo(a, b, c)
            caso 20:
                devolver cortar_archivo(a)
            caso 21..24:
                devolver atender_carpetas(n, a, b)
            caso 170, 171:
                devolver atender_explorador(n, a, b)
            caso 172:
                devolver atender_tapiz(a, b)             ; (MIRADOR) una imagen como tapiz
            caso 174:
                devolver atender_ajuste(a, b)           ; (PANEL) los ajustes del Panel de control (preferencias.cas)
            caso 175:
                devolver atender_hora(a, b)             ; (PANEL, NTP) la hora exacta del reloj del PC
            caso 177:
                devolver atender_177(a, b, c)           ; (PUNTEROS) el puntero del ratón (apuntero.cas)
            caso 173:
                devolver lo_soltado(a, b)       ; (BLOC)
            caso 25:
                si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
                devolver cambiar_carpeta(u, ruta)
            caso 26:
                si b = 0 o no puede(a, b, cierto) entonces devolver NO_VALE fin
                p := puntero(a)
                r := 0
                si actual.carpeta[0] = 0 entonces
                    si b > 1 entonces
                        p[0] := '\\'
                        r := 1
                    fin
                sino
                    mientras r + 1 < b y actual.carpeta[r] <> 0 hacer
                        p[r] := actual.carpeta[r]
                        r := r + 1
                    fin
                fin
                p[r] := 0
                devolver r
            caso 27:
                si a = SIN_SALIDA entonces
                    actual.salida := SIN_SALIDA
                    devolver 0
                fin
                r := serie_de(a)
                si r = 0 entonces devolver NO_VALE fin
                actual.salida := a
                actual.salida_serie := r
                actual.salida_cr := falso
                devolver 0
            caso 29:
                actual.aguanta := a <> 0
                devolver 0
            caso 30:
                r := 0
                si actual.corte entonces r := 1 fin
                actual.corte := falso
                devolver r
            caso 31:
                si a <= 1 entonces pon_teclado(a = 1) fin
                si teclado_español() entonces devolver 1 fin
                devolver 0
            caso 32..41:
                devolver atender_ventanas(n, a, b, c)
            caso 80, 81:
                devolver atender_ventanas(n, a, b, c)
            caso 42:
                ; la unidad de trabajo: cambiarla (a: su letra; 0: solo
                ; preguntar). Da la letra de la que queda.
                si a <> 0 entonces
                    u := por_letra(a)
                    si u = NINGUNA entonces devolver NO_HAY fin
                    si u <> unidad_de(actual) entonces
                        actual.unidad := u + 1
                        actual.carpeta[0] := 0
                    fin
                fin
                u := unidad_de(actual)
                si u >= MAX_UNIDADES entonces devolver 0 fin
                devolver unidades[u].letra
            caso 43:
                si no puede(b, tamaño(Info_unidad), cierto) entonces devolver NO_VALE fin
                devolver info_unidad(a, puntero(b))
            caso 60..68:
                devolver atender_instalar(n, a, b, c)
            caso 130:
                devolver Usbcal.quitar(a)
            caso 131:
                devolver Unidades.cambios
            caso 132:
                devolver Cdcal.expulsar(a)                     ; (CD)
            caso 133:
                ; (CD) montar una imagen de disco
                si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
                si no puede_leer(u, ruta) entonces devolver DENEGADO fin       ; (PROTEGE)
                devolver montar_imagen(u, ruta)
            caso 134, 135:
                devolver atender_reproductor(n, a, b, c)        ; (REPRODUCTOR) el CD de música y la bandeja
            caso 90..100:                               ; (WIFI) la 100, el servicio Wi-Fi
                r := atender_red(n, a, b, c)
                ; si no hay servicio de red, se pone en marcha (una vez) y se
                ; vuelve a pedir
                si r = SIN_RED y n = 90 y lanza_red() entonces r := atender_red(n, a, b, c) fin
                ; (TLS) lo mismo con el servicio TLS
                si r = SIN_TLS y n = 99 y lanza_tls() entonces r := atender_red(n, a, b, c) fin
                devolver r
            caso 150..154:
                si n <= 152 y no actual.servicio entonces devolver NO_VALE fin  ; (PROTEGE) solo los servicios
                devolver atender_energía(n, a, b, c)
            caso 155, 156:
                ; (dispositivos) la lista de los dispositivos, y lo que apuntan los servicios
                si n = 156 y no actual.servicio entonces devolver NO_VALE fin  ; (PROTEGE)
                devolver atender_dispositivos(n, a, b, c)
            caso 157:
                devolver pide_admin(a)                  ; (PROTEGE) el modo administrador
            caso 159:
                ; (I2CHID) el servicio de ACPI da un touchpad HID sobre I2C (0: ya están todos)
                si no actual.servicio entonces devolver NO_VALE fin
                devolver I2chid.de_acpi(a)
            caso 160:
                ; (SDHCI) el servicio de ACPI da una controladora SD/eMMC de
                ; «modo ACPI» (0: ya están todas): sdacpi.cas
                si no actual.servicio entonces devolver NO_VALE fin
                si a = 0 entonces devolver de_servicio(nulo) fin
                si no puede(a, tamaño(Ficha_sdhci), falso) entonces devolver NO_VALE fin
                copiar_memoria(puntero(nat32(dirección(ficha_sd))), puntero(a), tamaño(Ficha_sdhci))
                devolver de_servicio(dirección(ficha_sd))
            caso 200..202, 209, 210:
                devolver atender_usuarios(n, a, b, c)   ; (USUARIOS) los usuarios y el azar
            caso 158:
                ; (PROTEGE) el sello de una tarea, para los servicios (RED.BIN
                ; mira así quién le pide la interfaz del túnel)
                si no actual.servicio entonces devolver NO_VALE fin
                t := tarea_de(a)
                si t = nulo o no t.usuario entonces devolver NO_VALE fin
                si t.servicio entonces devolver t.sello ob 0x80000000 fin
                devolver t.sello
            caso 220..225:
                ; (0.8.10, seguridad) leer, cualquiera; lo que escribe (220 con
                ; EDX = 1: borrar las marcas de los motivos de freno; 225 con
                ; el bit 1 de EDX: encender la gráfica o su memoria), solo el
                ; Termómetro arrancado como tal o el modo administrador
                si ((n = 220 y c = 1) o (n = 225 y c yb 2 <> 0)) y no termo_o_admin() entonces devolver NO_VALE fin
                devolver atender_termo(n, a, b, c)     ; (TERMO) las temperaturas, solo leer (termo.cas)
            caso 238:
                ; (0.8.10, seguridad) los discos de dentro, aunque sea solo leer: como la 226
                si no termo_o_admin() entonces devolver NO_VALE fin
                devolver atender_tdisco(a, b, c)       ; (TERMO) los discos de dentro: salud y prueba de lectura, solo leer (tdisco.cas)
            caso 226:
                ; (0.8.10, seguridad) la ventana sobre la RAM alta deja leer lo
                ; que haya quedado en la memoria: solo con «termo» en la línea
                ; del cargador (la memoria del Termómetro) o en el modo administrador
                si no termo_o_admin() entonces devolver NO_VALE fin
                devolver atender_ram(a, b, c)          ; (RAM) la prueba de la memoria RAM del Termómetro (termoram.cas)
            caso 180..189:
                devolver atender_win32(n, a, b, c)     ; [WIN32] los programas de Windows (win32.cas)
            caso 190..199:
                ; (SONIDO) el sonido (sonido.cas); si no hay servicio de sonido,
                ; se pone en marcha (una vez) al abrir un canal o tocar un .WAV
                si (n = 190 o n = 194) y no hay_tarjeta() y lanza_sonido(nulo) entonces fin
                si n = 194 entonces
                    ; tocar un .WAV: la ruta, entera y con su letra, para el servicio
                    si no ruta_de_usuario(a, ruta, u) o u >= MAX_UNIDADES entonces devolver NO_VALE fin
                    ruta2[0] := unidades[u].letra
                    ruta2[1] := ':'
                    copiar_hasta(dirección(ruta2[2]), ruta, 108)
                    devolver tocar_archivo(ruta2)
                fin
                devolver atender_sonido(n, a, b, c)
        fin
        devolver NO_VALE
    fin

    ; pone en marcha el servicio de red (RED.BIN, de la unidad del sistema o
    ; de su \HISPA) y espera a que se apunte (hasta 3 s). Falso si no puede
    ; ser: con «sinred», si ya dijo que no hay tarjeta o si no está.
    público función lanza_red(): bool
        variable t: puntero a Tarea
        variable e, k, id: nat32
        si apagada o sin_tarjeta entonces devolver falso fin
        si hay_servicio() entonces devolver cierto fin
        t := cargar_servicio("RED.BIN", nulo, e)          ; (PROTEGE) de la carpeta del sistema, y nada más
        si t = nulo entonces
            sin_tarjeta := cierto                  ; (no está: no se vuelve a intentar)
            devolver falso
        fin
        ; no es de nadie, no escribe en ningún terminal ni archivo, y en la raíz
        t.padre := 0
        t.terminal := 0
        t.salida := SIN_SALIDA
        t.carpeta[0] := 0
        t.unidad := 0
        id := t.id
        k := 0
        mientras no hay_servicio() y k < 300 hacer
            dormir(1)
            k := k + 1
            t := tarea_de(id)
            si t = nulo o t.estado = ACABADA entonces romper fin
        fin
        devolver hay_servicio()
    fin

    ; (SONIDO) pone en marcha el servicio de sonido (SONIDO.BIN, de la unidad
    ; del sistema o de su \HISPA) y espera a que se apunte (hasta 3 s); con
    ; «/ARRANQUE» (desde el escritorio), toca el sonido de inicio. Falso si
    ; no puede ser: con «sinsonido», si ya dijo que no hay tarjeta o si no está
    público función lanza_sonido(args: puntero a byte): bool
        variable t: puntero a Tarea
        variable e, k, id: nat32
        si Sonido.sin_sonido o Sonido.sin_tarjeta_sonido entonces devolver falso fin
        si hay_servicio_sonido() entonces devolver cierto fin
        si args = nulo entonces args := "/SERVICIO" fin
        t := cargar_archivo("\\SONIDO.BIN", args, e)
        si t = nulo entonces
            Sonido.sin_tarjeta_sonido := cierto
            devolver falso
        fin
        t.uid := 0                              ; (USUARIOS) un servicio que pone el núcleo
        t.padre := 0
        t.terminal := 0
        t.salida := SIN_SALIDA
        t.carpeta[0] := 0
        t.unidad := 0
        id := t.id
        k := 0
        ; (que se apunte y diga qué tarjeta tiene)
        mientras no (hay_servicio_sonido() y sonido_listo) y k < 400 hacer
            dormir(1)
            k := k + 1
            t := tarea_de(id)
            si t = nulo o t.estado = ACABADA entonces romper fin
        fin
        devolver hay_servicio_sonido()
    fin

    ; (SONIDO) el servicio de sonido al arrancar el escritorio, sin esperarlo
    ; (con «/ARRANQUE»: suena el de inicio). Si no hay tarjeta, acaba solo
    público función arranca_sonido()
        variable t: puntero a Tarea
        variable e: nat32
        si Sonido.sin_sonido o Sonido.sin_tarjeta_sonido o hay_servicio_sonido() entonces devolver fin
        t := cargar_servicio("SONIDO.BIN", "/ARRANQUE", e)    ; (PROTEGE) de la carpeta del sistema, con su sello
        si t = nulo entonces
            Sonido.sin_tarjeta_sonido := cierto
            devolver
        fin
        t.padre := 0
        t.terminal := 0
        t.salida := SIN_SALIDA
        t.carpeta[0] := 0
        t.unidad := 0
    fin

    ; (TLS) pone en marcha el servicio TLS (TLS.BIN, nucleo32/tls/), como
    ; lanza_red. Falso si no está (y no se vuelve a intentar)
    función lanza_tls(): bool
        variable t: puntero a Tarea
        variable e, k, id: nat32
        si apagada o sin_tls entonces devolver falso fin
        si hay_tls() entonces devolver cierto fin
        t := cargar_servicio("TLS.BIN", nulo, e)          ; (PROTEGE)
        si t = nulo entonces
            sin_tls := cierto
            devolver falso
        fin
        t.padre := 0
        t.terminal := 0
        t.salida := SIN_SALIDA
        t.carpeta[0] := 0
        t.unidad := 0
        id := t.id
        k := 0
        mientras no hay_tls() y k < 300 hacer
            dormir(1)
            k := k + 1
            t := tarea_de(id)
            si t = nulo o t.estado = ACABADA entonces romper fin
        fin
        devolver hay_tls()
    fin

    ; (PROTEGE) pone en marcha un servicio del sistema («RED.BIN») de su ruta
    ; fija: la carpeta \HISPA de la unidad del sistema (o su raíz, en la
    ; memoria de arranque; o la unidad en memoria). Nunca de otra carpeta: un
    ; RED.BIN puesto en la raíz de un sistema instalado no es el servicio.
    público función cargar_servicio(nombre: puntero a byte, args: puntero a byte, ref error: nat32): puntero a Tarea
        variable r: arreglo [40] de byte
        variable t: puntero a Tarea
        si del_sistema >= MAX_UNIDADES entonces
            error := SIN_DISCO
            devolver nulo
        fin
        si en_memoria(del_sistema) entonces
            copiar_hasta(r, "\\", 40)
            concatenar(r, nombre)
        sino
            ruta_del_sistema(nombre, r, 40)
        fin
        t := carga_de(del_sistema, r, args, error)
        si t <> nulo entonces t.uid := 0 fin           ; (USUARIOS) los pone el núcleo: del sistema
        devolver t
    fin

    ; (PROTEGE) el modo administrador (la llamada 157): a = 0, pedirlo; 1,
    ; dejarlo; 2, ¿se tiene? Lo pregunta el núcleo, en la pantalla, al que
    ; está delante: el programa no puede contestar por él
    variable cerrojo_admin: Cerrojo

    función pregunta_en_consola(): bool
        variable c: nat32
        tomar_consola()
        imprimir1("\nEl núcleo pregunta: %s", nat32(actual.nombre))
        escribir(" pide el MODO ADMINISTRADOR: podrá cambiar y borrar los archivos del sistema (\\HISPA) y leer sus secretos.\n")
        escribir("    ¿Se lo da? Pulse S para sí; cualquier otra tecla, no: ")
        soltar_consola()
        c := leer_tecla()
        tomar_consola()
        si c = 's' o c = 'S' entonces escribir("sí\n") sino escribir("no\n") fin
        soltar_consola()
        devolver c = 's' o c = 'S'
    fin

    función pregunta_en_pantalla(): bool
        variable opciones: arreglo [200] de byte
        variable k: nat32
        variable x, yy: ent32
        copiar_hasta(opciones, actual.nombre, 200)
        concatenar(opciones, " pide el modo administrador|(cambiar y borrar los archivos del sistema)|-|Sí, dárselo|No")
        x := ent32(pantalla.ancho div 2) - 180
        yy := ent32(pantalla.alto div 2) - 70
        hay_respuesta := falso
        ; (los dos primeros renglones son el título: en gris, no se eligen)
        si no abrir_emergente(x, yy, opciones, 3, PARA_EL_NÚCLEO, 0) entonces devolver falso fin
        k := 0
        mientras no hay_respuesta y k < 60 * HZ y no actual.matar hacer
            dormir(5)
            k := k + 5
        fin
        si no hay_respuesta entonces
            cerrar_emergente()
            devolver falso
        fin
        devolver respuesta = 3
    fin

    ; (0.8.10, seguridad) lo del Termómetro que mira la memoria o los discos
    ; o escribe en el equipo: con «termo» en la línea del cargador (la memoria
    ; USB del Termómetro, en la que no hay nada de nadie) o en el modo
    ; administrador
    función termo_o_admin(): bool
        si actual.admin entonces devolver cierto fin
        devolver buscar(línea_del_cargador(), "termo") <> nulo
    fin

    función pide_admin(a: nat32): nat32
        variable sí, con_clave: bool
        variable c: puntero a Cuenta
        según a
            caso 1:
                actual.admin := falso
                devolver 0
            caso 2:
                si actual.admin entonces devolver 1 fin
                devolver 0
            caso 0:
                si actual.admin entonces devolver 1 fin
                ; (USUARIOS) solo un administrador, y con SU contraseña si la tiene
                si hay_cuentas y no es_admin_uid(actual.uid) entonces
                    imprimir2("permisos: el modo administrador es solo para un administrador (%s, la tarea %u)\n", nat32(actual.nombre), actual.id)
                    devolver DENEGADO
                fin
                c := de_id(actual.uid)
                con_clave := hay_cuentas y c <> nulo y c.clave[0] <> 0
                tomar(cerrojo_admin)
                si escritorio_en_marcha y hay_pantalla y (no hay_cuentas o actual.uid = sesión o actual.uid = 0) entonces
                    ; (el que está delante de la pantalla es el que lo pide)
                    si con_clave entonces sí := pide_clave_en_pantalla(c) sino sí := pregunta_en_pantalla() fin
                sino si actual.terminal = 0 entonces
                    si con_clave entonces sí := pide_clave_en_texto(c, 0) sino sí := pregunta_en_consola() fin
                sino si con_clave entonces
                    ; (USUARIOS) un terminal sin nadie delante (una sesión de SSH):
                    ; la contraseña del administrador, por el terminal
                    sí := pide_clave_en_texto(c, actual.terminal)
                sino
                    ; (un terminal sin escritorio y sin contraseña: no hay nadie
                    ; delante a quien preguntar)
                    soltar(cerrojo_admin)
                    devolver DENEGADO
                fin
                soltar(cerrojo_admin)
                si sí entonces
                    actual.admin := cierto
                    imprimir2("permisos: modo administrador para %s (la tarea %u)\n", nat32(actual.nombre), actual.id)
                    devolver 1
                fin
                devolver 0
        fin
        devolver NO_VALE
    fin

    ; =========================================================================
    ;  (USUARIOS) Las contraseñas, las llamadas de los usuarios (200 a 202),
    ;  la de ARGON2.BIN (209) y la del azar (210)
    ; =========================================================================
    ; lo que el núcleo le pasa a ARGON2.BIN (hispac/argon2.c: la misma forma)
    tipo Pedido_argon = estructura
        magia, kib, pasadas, utf8, n: nat32
        sal: arreglo [16] de byte
        clave: arreglo [256] de byte
    fin
    constante MAGIA_ARGON = 0x4E4F4741          ; «AGON»

    ; lo que se sabe de un usuario (la llamada 200, 1): 64 octetos
    tipo Ficha_usuario = estructura
        id: nat32
        admin, entra_solo, con_clave, es_yo: byte
        imagen: nat32
        nombre: arreglo [24] de byte
        carpeta: arreglo [12] de byte
        en_sesión: byte
        reservado: arreglo [15] de byte
    fin

    ; lo que se pide (las llamadas 201 y 202)
    tipo Pedido_usuario = estructura
        orden, id, admin, entra_solo, imagen, n_clave, n_vieja: nat32
        nombre: arreglo [24] de byte
        clave: arreglo [128] de byte
        vieja: arreglo [128] de byte
    fin
    constante PU_CREA = 1
    constante PU_QUITA = 2
    constante PU_CAMBIA = 3
    constante PU_CLAVE = 4

    variable cerrojo_argon: Cerrojo
    variable cerrojo_cuentas: Cerrojo
    variable pedido_argon: Pedido_argon
    variable respuesta_argon: arreglo [32] de byte
    variable hay_respuesta_argon: bool
    variable tarea_argon: nat32
    público variable falta_argon: bool          ; no está ARGON2.BIN (sin él, las contraseñas no se comprueban)
    variable pu: Pedido_usuario                 ; (el de la 201 o la 202, copiado aquí: con cerrojo_cuentas)

    ; n octetos de azar del pozo del núcleo (pozo.cas)
    público función azar(destino: puntero a byte, n: nat32)
        variable f, h: nat32
        ahora(f, h)
        sacar(destino, n, tics, (f << 16) xob h)
    fin

    ; el resumen Argon2id (32 octetos, a «salida») de los n octetos de la
    ; clave (en UTF-8, o en la página 437: ARGON2.BIN la pasa a UTF-8) con la
    ; sal de 16 octetos. Lo hace ARGON2.BIN (C con Monocypher), puesto en
    ; marcha de \HISPA para eso: solo él recoge el pedido (por su número de
    ; tarea y su sello) y nadie más ve la clave. Falso si no se ha podido
    público función argon2(clave: puntero a byte, n: nat32, utf8: bool, sal: puntero a byte, kib: nat32, pasadas: nat32, salida: puntero a byte): bool
        variable t: puntero a Tarea
        variable e, t0: nat32
        variable bien: bool
        si n > 255 o kib < 8 o kib > 65536 o pasadas < 1 o pasadas > 10 entonces devolver falso fin
        tomar(cerrojo_argon)
        llenar(puntero(nat32(dirección(pedido_argon))), tamaño(Pedido_argon), 0)
        pedido_argon.magia := MAGIA_ARGON
        pedido_argon.kib := kib
        pedido_argon.pasadas := pasadas
        si utf8 entonces pedido_argon.utf8 := 1 fin
        pedido_argon.n := n
        copiar_memoria(dirección(pedido_argon.sal[0]), sal, 16)
        si n > 0 entonces copiar_memoria(dirección(pedido_argon.clave[0]), clave, n) fin
        hay_respuesta_argon := falso
        bien := falso
        t0 := tics
        t := cargar_servicio("ARGON2.BIN", nulo, e)
        si t = nulo entonces
            falta_argon := cierto
            imprimir1("cuentas: no se puede poner en marcha ARGON2.BIN (%s): sin él no se comprueban las contraseñas\n", nat32(texto_error(e)))
        sino si t.sello <> SELLO_ARGON2 entonces
            t.padre := 0
            acabar_tarea(t)
        sino
            t.padre := actual.id
            t.terminal := 0
            t.salida := SIN_SALIDA
            t.uid := 0
            tarea_argon := t.id
            esperar(t)
            tarea_argon := 0
            bien := hay_respuesta_argon
            si bien entonces copiar_memoria(salida, dirección(respuesta_argon[0]), 32) fin
            imprimir2("cuentas: Argon2id (%u KB, %u pasadas)", kib, pasadas)
            imprimir1(" en %u tics\n", tics - t0)
        fin
        llenar(puntero(nat32(dirección(pedido_argon))), tamaño(Pedido_argon), 0)
        llenar(dirección(respuesta_argon[0]), 32, 0)
        hay_respuesta_argon := falso
        soltar(cerrojo_argon)
        devolver bien
    fin

    ; ¿es «clave» (n octetos) la contraseña del usuario c? (falso si no tiene)
    público función comprueba_clave(c: puntero a Cuenta, clave: puntero a byte, n: nat32, utf8: bool): bool
        variable kib, pas, i, d: nat32
        variable sal: arreglo [16] de byte
        variable bueno: arreglo [32] de byte
        variable h: arreglo [32] de byte
        si c = nulo o c.clave[0] = 0 entonces devolver falso fin
        si no lee_resumen(dirección(c.clave[0]), kib, pas, sal, bueno) entonces devolver falso fin
        si no argon2(clave, n, utf8, sal, kib, pas, h) entonces devolver falso fin
        d := 0
        para i desde 0 hasta 31 hacer d := d ob (nat32(h[i]) xob nat32(bueno[i])) fin
        llenar(h, 32, 0)
        devolver d = 0
    fin

    ; pone la contraseña del usuario c (n = 0: se la quita): sal nueva del
    ; pozo y Argon2id. Falso si no se ha podido (no está ARGON2.BIN)
    público función pon_clave(c: puntero a Cuenta, clave: puntero a byte, n: nat32, utf8: bool): bool
        variable sal: arreglo [16] de byte
        variable h: arreglo [32] de byte
        variable w: arreglo [16] de byte
        variable hx: arreglo [72] de byte
        si c = nulo entonces devolver falso fin
        si n = 0 entonces
            llenar(dirección(c.clave[0]), MAX_CLAVE_C, 0)
            devolver cierto
        fin
        azar(sal, 16)
        si no argon2(clave, n, utf8, sal, ARGON_KIB, ARGON_PASADAS, h) entonces devolver falso fin
        copiar_hasta(dirección(c.clave[0]), "argon2id$", MAX_CLAVE_C)
        natural_a_texto(ARGON_KIB, w)
        concatenar(dirección(c.clave[0]), w)
        concatenar(dirección(c.clave[0]), "$")
        natural_a_texto(ARGON_PASADAS, w)
        concatenar(dirección(c.clave[0]), w)
        concatenar(dirección(c.clave[0]), "$")
        a_hex(sal, 16, hx)
        concatenar(dirección(c.clave[0]), hx)
        concatenar(dirección(c.clave[0]), "$")
        a_hex(h, 32, hx)
        concatenar(dirección(c.clave[0]), hx)
        llenar(h, 32, 0)
        c.entra_solo := falso                   ; (con contraseña no se entra solo)
        devolver cierto
    fin

    ; la contraseña, tecleada en la consola de texto (con asteriscos) o en
    ; un terminal (term <> 0: el de SSH). Da cuántas letras (falso si Esc o Ctrl+C)
    público función lee_clave_texto(term: nat32, destino: puntero a byte, cabe: nat32, ref n: nat32): bool
        variable c: nat32
        n := 0
        mientras cierto hacer
            si term <> 0 entonces c := tecla_terminal(term) sino c := leer_tecla() fin
            si c = '\n' o c = '\r' entonces
                si term <> 0 entonces escribir_terminal(term, "\r\n", 2) sino escribir("\n") fin
                devolver cierto
            fin
            si c = 27 o c = 3 o (term = 0 y actual.matar) entonces
                llenar(destino, cabe, 0)
                n := 0
                si term <> 0 entonces escribir_terminal(term, "\r\n", 2) sino escribir("\n") fin
                devolver falso
            fin
            si c = 8 entonces
                si n > 0 entonces
                    n := n - 1
                    destino[n] := 0
                    si term <> 0 entonces escribir_terminal(term, "\x08 \x08", 3) sino escribir("\x08 \x08") fin
                fin
            sino si c >= ' ' y c < 0x100 y n + 1 < cabe entonces
                destino[n] := byte(c)
                n := n + 1
                si term <> 0 entonces escribir_terminal(term, "*", 1) sino escribir("*") fin
            fin
        fin
        devolver falso
    fin

    ; ---- la contraseña del modo administrador, en una ventanita del núcleo ----
    constante CL_AN = 440
    constante CL_AL = 200
    variable cl_clave: arreglo [128] de byte
    variable cl_n: nat32
    variable cl_v: nat32

    función pinta_cl(c: puntero a Cuenta, quién: puntero a byte, aviso: puntero a byte)
        variable l: puntero a Lienzo
        variable i: nat32
        variable r: arreglo [96] de byte
        l := lienzo_de(cl_v)
        si l = nulo entonces devolver fin
        degradado(valor(l), 0, 0, CL_AN, CL_AL, 0xF4F8FE, 0xD6E6FA)
        disquete(valor(l), 16, 14, 40)
        copiar_hasta(r, quién, 60)
        concatenar(r, " pide el modo administrador")
        texto_negrita(valor(l), 70, 14, r, 0x14294A)
        texto(valor(l), 70, 34, "(cambiar y borrar los archivos del sistema)", 0x5A7396)
        copiar_hasta(r, "Contraseña de ", 96)
        concatenar(r, dirección(c.nombre[0]))
        concatenar(r, ":")
        texto(valor(l), 70, 62, r, 0x14294A)
        rectángulo(valor(l), 70, 82, 350, 28, 0x1D4ED8)
        rectángulo(valor(l), 72, 84, 346, 24, 0xFFFFFF)
        para i desde 1 hasta cl_n hacer
            si i <= 40 entonces círculo(valor(l), 80 + ent32(i - 1) * 8, 96, 3, 0x14294A) fin
        fin
        rectángulo(valor(l), 78 + ent32(cl_n) * 8, 88, 2, 16, 0x14294A)
        si aviso <> nulo entonces texto_negrita(valor(l), 70, 116, aviso, 0x991B1B) fin
        ; los botones, con su borde y su nombre (no solo el color)
        rectángulo(valor(l), 200, 146, 104, 36, 0x14294A)
        redondeado(valor(l), 202, 148, 100, 32, 5, 0x5CC45E, 0x2A8A3C, TODAS)
        texto_negrita(valor(l), 252 - ancho_texto("Aceptar") div 2, 156, "Aceptar", 0xFFFFFF)
        rectángulo(valor(l), 316, 146, 104, 36, 0x14294A)
        redondeado(valor(l), 318, 148, 100, 32, 5, 0x8FA6C4, 0x5F7699, TODAS)
        texto_negrita(valor(l), 368 - ancho_texto("Cancelar") div 2, 156, "Cancelar", 0xFFFFFF)
        repintada(cl_v, 0, 0, CL_AN, CL_AL)
    fin

    ; pide en la pantalla la contraseña del usuario c para dárselo a la
    ; tarea que corre: cierto si la ha escrito bien (tres intentos, dos
    ; minutos). Solo responden el teclado y el ratón de verdad
    función pide_clave_en_pantalla(c: puntero a Cuenta): bool
        variable e: Evento
        variable k, intentos, antes_teclas: nat32
        variable x, yy: ent32
        variable aviso: puntero a byte
        variable sí, fuera: bool
        x := ent32(pantalla.ancho div 2) - CL_AN div 2
        yy := ent32(pantalla.alto div 2) - CL_AL div 2
        cl_v := crear_ventana("Modo administrador", x, yy, CL_AN, CL_AL, FIJA ob ENCIMA, 0)
        si cl_v = 0 entonces devolver falso fin
        antes_teclas := teclas_a
        teclas_a := cl_v
        cl_n := 0
        aviso := nulo
        pinta_cl(c, actual.nombre, aviso)
        k := 0
        intentos := 0
        sí := falso
        fuera := falso
        mientras no fuera y k < 120 * HZ y no actual.matar hacer
            mientras saca_evento(cl_v, 0, e) hacer
                si e.clase = EV_CERRAR o (e.clase = EV_TECLA y e.a = 27) entonces
                    fuera := cierto
                sino si (e.clase = EV_TECLA y e.a = '\n') o (e.clase = EV_RATÓN_BAJA y ent32(e.a) >= 200 y ent32(e.a) < 304 y ent32(e.b) >= 146 y ent32(e.b) < 182) entonces
                    si espera_por_fallos() > 0 entonces
                        aviso := "Demasiados intentos: espere un poco."
                    sino
                        texto_negrita(valor(lienzo_de(cl_v)), 70, 116, "Comprobando la contraseña...", 0x14294A)
                        repintada(cl_v, 0, 0, CL_AN, CL_AL)
                        si comprueba_clave(c, cl_clave, cl_n, falso) entonces
                            apunta_acierto()
                            sí := cierto
                            fuera := cierto
                        sino
                            apunta_fallo()
                            intentos := intentos + 1
                            aviso := "La contraseña no es esa."
                            si intentos >= 3 entonces fuera := cierto fin
                        fin
                    fin
                    llenar(cl_clave, 128, 0)
                    cl_n := 0
                sino si e.clase = EV_RATÓN_BAJA y ent32(e.a) >= 316 y ent32(e.a) < 420 y ent32(e.b) >= 146 y ent32(e.b) < 182 entonces
                    fuera := cierto
                sino si e.clase = EV_TECLA y e.a = 8 entonces
                    si cl_n > 0 entonces
                        cl_n := cl_n - 1
                        cl_clave[cl_n] := 0
                    fin
                sino si e.clase = EV_TECLA y e.a >= ' ' y e.a < 0x100 y cl_n < 127 entonces
                    cl_clave[cl_n] := byte(e.a)
                    cl_n := cl_n + 1
                fin
                si no fuera entonces pinta_cl(c, actual.nombre, aviso) fin
            fin
            dormir(2)
            k := k + 2
        fin
        llenar(cl_clave, 128, 0)
        cl_n := 0
        si teclas_a = cl_v entonces teclas_a := antes_teclas fin
        cerrar_ventana(cl_v, 0)
        cl_v := 0
        devolver sí
    fin

    ; en la consola de texto o en un terminal (el de SSH): la contraseña del usuario c
    función pide_clave_en_texto(c: puntero a Cuenta, term: nat32): bool
        variable n, intentos: nat32
        variable sí: bool
        variable r: arreglo [160] de byte
        intentos := 0
        sí := falso
        mientras no sí y intentos < 3 hacer
            copiar_hasta(r, "\r\nEl núcleo pregunta: ", 160)
            concatenar(r, actual.nombre)
            concatenar(r, " pide el MODO ADMINISTRADOR.\r\nContraseña de ")
            concatenar(r, dirección(c.nombre[0]))
            concatenar(r, " (Esc: no): ")
            si term <> 0 entonces
                escribir_terminal(term, r, longitud(r))
            sino
                tomar_consola()
                escribir(r)
                soltar_consola()
            fin
            si espera_por_fallos() > 0 entonces dormir(espera_por_fallos()) fin
            si no lee_clave_texto(term, cl_clave, 128, n) entonces
                llenar(cl_clave, 128, 0)
                devolver falso
            fin
            si comprueba_clave(c, cl_clave, n, falso) entonces
                apunta_acierto()
                sí := cierto
            sino
                apunta_fallo()
                intentos := intentos + 1
                si term <> 0 entonces escribir_terminal(term, "No es esa.\r\n", 12) sino escribir("No es esa.\n") fin
            fin
            llenar(cl_clave, 128, 0)
        fin
        devolver sí
    fin

    ; ---- las llamadas ----
    función ficha_de(i: nat32, f: puntero a Ficha_usuario): nat32
        variable k, j: nat32
        llenar(puntero(nat32(f)), tamaño(Ficha_usuario), 0)
        k := 0
        para j desde 0 hasta MAX_CUENTAS - 1 hacer
            si cuentas[j].usada entonces
                si k = i entonces
                    f.id := cuentas[j].id
                    si cuentas[j].admin entonces f.admin := 1 fin
                    si cuentas[j].entra_solo entonces f.entra_solo := 1 fin
                    si cuentas[j].clave[0] <> 0 entonces f.con_clave := 1 fin
                    si cuentas[j].id = actual.uid entonces f.es_yo := 1 fin
                    si cuentas[j].id = sesión entonces f.en_sesión := 1 fin
                    f.imagen := cuentas[j].imagen
                    copiar_hasta(dirección(f.nombre[0]), dirección(cuentas[j].nombre[0]), 24)
                    copiar_hasta(dirección(f.carpeta[0]), dirección(cuentas[j].carpeta[0]), 12)
                    devolver 1
                fin
                k := k + 1
            fin
        fin
        devolver 0
    fin

    función atender_usuarios_200(a: nat32, b: nat32, c: nat32): nat32
        variable p: puntero a byte
        según nat16(a)
            caso 0:
                si hay_cuentas entonces devolver n_cuentas() fin
                devolver 0
            caso 1:
                si no puede(c, tamaño(Ficha_usuario), cierto) entonces devolver NO_VALE fin
                devolver ficha_de(b, puntero(c))
            caso 2:
                devolver actual.uid
            caso 3:
                si es_admin_uid(actual.uid) entonces devolver 1 fin
                devolver 0
            caso 4:
                ; su carpeta («\USUARIOS\CARLOS»), a b (caben c)
                si c < 2 o no puede(b, c, cierto) entonces devolver NO_VALE fin
                p := puntero(b)
                p[0] := 0
                si carpeta_de(actual.uid)[0] = 0 entonces devolver 0 fin
                copiar_hasta(p, "\\USUARIOS\\", c)
                si longitud(p) + longitud(carpeta_de(actual.uid)) < c entonces concatenar(p, carpeta_de(actual.uid)) fin
                devolver longitud(p)
            caso 5:
                devolver sesión
            caso 6:
                ; (0.8.11, SIN-ADMIN) PAQUETES (su sello, nadie más) de un
                ; usuario normal va a poner al día lo instalado con lo del
                ; catálogo firmado: desde ahora escribe en la zona del sistema
                ; (permisos.cas). Lo comprueba él (la firma, la serie, que
                ; solo es ACTUALIZA, sin /FORZAR ni archivos sueltos)
                si actual.sello <> SELLO_PAQUETES entonces devolver DENEGADO fin
                si no actual.firmada entonces
                    actual.firmada := cierto
                    imprimir2("permisos: PAQUETES de %s pone al día lo del catálogo firmado (la tarea %u)\n", nat32(nombre_de_uid(actual.uid)), actual.id)
                fin
                devolver 0
        fin
        devolver NO_VALE
    fin

    función nombre_de_uid(uid: nat32): puntero a byte
        variable c: puntero a Cuenta
        c := de_id(uid)
        si c = nulo entonces devolver "el sistema" fin
        devolver dirección(c.nombre[0])
    fin

    ; (queda_admin_sin: en cuentas.cas, 0.8.11: solo cuentan los administradores con los que se puede entrar)

    ; la 201: Configuración › Usuarios (USUARIOS.BIN). Crear, quitar y cambiar
    ; los demás, solo un administrador; la contraseña propia, cada uno (con la
    ; de antes, si la tenía)
    función atender_usuarios_201(): nat32
        variable c: puntero a Cuenta
        variable id, r: nat32
        variable soy_admin: bool
        si actual.sello <> SELLO_USUARIOS entonces devolver NO_VALE fin
        si no hay_cuentas entonces devolver NO_VALE fin        ; (sin sistema instalado no hay usuarios)
        pu.nombre[23] := 0
        si pu.n_clave > 127 o pu.n_vieja > 127 entonces devolver NO_VALE fin
        soy_admin := es_admin_uid(actual.uid)
        según nat16(pu.orden)
            caso PU_CREA:
                si no soy_admin entonces devolver DENEGADO fin
                si no nombre_vale(dirección(pu.nombre[0]), 0) entonces devolver YA_EXISTE fin
                id := Cuentas.nueva(dirección(pu.nombre[0]), pu.admin <> 0, pu.imagen, pu.entra_solo <> 0)
                si id = 0 entonces devolver LLENO fin
                c := de_id(id)
                si pu.n_clave > 0 y no pon_clave(c, dirección(pu.clave[0]), pu.n_clave, falso) entonces
                    Cuentas.quita(id)
                    devolver MAL
                fin
                ; (que entre solo uno)
                si c.entra_solo entonces
                    para r desde 0 hasta MAX_CUENTAS - 1 hacer
                        si cuentas[r].usada y cuentas[r].id <> id entonces cuentas[r].entra_solo := falso fin
                    fin
                fin
                si no guarda_cuentas() entonces
                    carga_cuentas()
                    devolver PROTEGIDO
                fin
                imprimir2("cuentas: %s da de alta a %s\n", nat32(actual.nombre), nat32(dirección(c.nombre[0])))
                devolver id
            caso PU_QUITA:
                si no soy_admin entonces devolver DENEGADO fin
                c := de_id(pu.id)
                si c = nulo entonces devolver NO_HAY fin
                si pu.id = actual.uid o pu.id = sesión entonces devolver EN_USO fin
                si c.admin y no queda_admin_sin(pu.id) entonces devolver EN_USO fin
                Cuentas.quita(pu.id)
                si no guarda_cuentas() entonces
                    carga_cuentas()
                    devolver PROTEGIDO
                fin
                devolver 0
            caso PU_CAMBIA:
                c := de_id(pu.id)
                si c = nulo entonces devolver NO_HAY fin
                si no soy_admin entonces
                    ; (uno normal, solo su imagen)
                    si pu.id <> actual.uid entonces devolver DENEGADO fin
                    si pu.imagen > MAX_IMAGEN entonces devolver NO_VALE fin
                    c.imagen := pu.imagen
                sino
                    si pu.nombre[0] <> 0 y no nombre_vale(dirección(pu.nombre[0]), pu.id) entonces devolver YA_EXISTE fin
                    si pu.admin = 0 y c.admin y no queda_admin_sin(pu.id) entonces devolver EN_USO fin
                    si pu.nombre[0] <> 0 entonces copiar_hasta(dirección(c.nombre[0]), dirección(pu.nombre[0]), MAX_NOMBRE_C) fin
                    c.admin := pu.admin <> 0
                    si pu.imagen <= MAX_IMAGEN entonces c.imagen := pu.imagen fin
                    c.entra_solo := pu.entra_solo <> 0 y c.clave[0] = 0
                    ; (que entre solo uno)
                    si c.entra_solo entonces
                        para r desde 0 hasta MAX_CUENTAS - 1 hacer
                            si cuentas[r].usada y cuentas[r].id <> c.id entonces cuentas[r].entra_solo := falso fin
                        fin
                    fin
                fin
                si no guarda_cuentas() entonces
                    carga_cuentas()
                    devolver PROTEGIDO
                fin
                devolver 0
            caso PU_CLAVE:
                c := de_id(pu.id)
                si c = nulo entonces devolver NO_HAY fin
                si pu.id = actual.uid entonces
                    ; la suya: con la de antes, si la tenía
                    si c.clave[0] <> 0 entonces
                        si espera_por_fallos() > 0 entonces devolver EN_USO fin
                        si no comprueba_clave(c, dirección(pu.vieja[0]), pu.n_vieja, falso) entonces
                            apunta_fallo()
                            devolver MAL
                        fin
                        apunta_acierto()
                    fin
                sino si no soy_admin entonces
                    devolver DENEGADO
                fin
                si pu.n_clave > 0 y pu.n_clave < 4 entonces devolver NOMBRE_MALO fin     ; (demasiado corta)
                si no pon_clave(c, dirección(pu.clave[0]), pu.n_clave, falso) entonces devolver MAL fin
                si no guarda_cuentas() entonces
                    carga_cuentas()
                    devolver PROTEGIDO
                fin
                imprimir2("cuentas: contraseña de %s cambiada (por %s)\n", nat32(dirección(c.nombre[0])), nat32(actual.nombre))
                devolver 0
        fin
        devolver NO_VALE
    fin

    ; =========================================================================
    ;  (0.8.11, SIN-ADMIN) Un equipo sin ningún administrador (el HP Mini de
    ;  la asociación: solo «Biblio2», normal): nadie podría cambiar \HISPA,
    ;  dar de alta a nadie ni encender SSHD. Lo arregla quien está delante de
    ;  la pantalla de verdad (entrada.cas: la pantalla de entrada o la
    ;  entrada en texto; NUNCA por SSH ni por la red: no hay llamada al
    ;  sistema para esto), y solo mientras no haya ninguno:
    ;   - crear uno nuevo, con nombre y contraseña (dos veces; al menos 4
    ;     letras): el que entra solo sigue entrando solo, normal;
    ;   - o hacer administrador a un usuario QUE TIENE contraseña,
    ;     escribiéndola (la prueba de que es él). A uno sin contraseña no:
    ;     sería dar el sistema entero a cualquiera que encienda el equipo
    ;     (la biblioteca); para eso, crear uno.
    ;  Queda en el registro del núcleo y en \HISPA\USUARIOS.LOG (lo lee
    ;  cualquiera; solo lo escribe el núcleo).
    ; =========================================================================
    público constante RA_HECHO = 0
    público constante RA_NO_HACE_FALTA = 1      ; ya hay un administrador
    público constante RA_NOMBRE = 2             ; el nombre no vale o ya lo tiene otro
    público constante RA_CORTA = 3              ; la contraseña, demasiado corta (al menos 4)
    público constante RA_DISTINTAS = 4          ; las dos no son iguales
    público constante RA_LLENO = 5
    público constante RA_ARGON = 6              ; sin ARGON2.BIN
    público constante RA_DISCO = 7              ; no se puede guardar
    público constante RA_SIN_CLAVE = 8          ; (hacer administrador) ese no tiene contraseña
    público constante RA_CLAVE_MALA = 9
    público constante RA_ESPERA = 10            ; demasiados intentos
    variable dd_ra: arreglo [8] de nat32

    ; una línea a \HISPA\USUARIOS.LOG (con la fecha y la hora), y al registro
    función apunta_usuarios_log(t: puntero a byte)
        variable m, f, h: nat32
        variable l: arreglo [200] de byte
        ahora(f, h)
        dd_ra[0] := (f >> 9) + 1980
        dd_ra[1] := (f >> 5) yb 15
        dd_ra[2] := f yb 31
        dd_ra[3] := h >> 11
        dd_ra[4] := (h >> 5) yb 63
        dd_ra[5] := nat32(t)
        formatear(l, 200, "%04u-%02u-%02u %02u:%02u %s\r\n", dirección(dd_ra[0]))
        imprimir1("cuentas: %s\n", nat32(t))
        si del_sistema = NINGUNA entonces devolver fin
        m := abrir_archivo(del_sistema, "\\HISPA\\USUARIOS.LOG", PARA_AÑADIR)
        si m >= PRIMER_ERROR entonces devolver fin
        escribir_archivo(m, l, longitud(l))
        cerrar_archivo(m)
    fin

    ; crea el administrador «nombre» con la contraseña (n letras, en la
    ; página 437: la de la pantalla), si no hay ninguno. «dónde»: «en la
    ; pantalla de entrada» o «en la consola». Da RA_...
    público función recupera_admin_nuevo(nombre: puntero a byte, clave: puntero a byte, n: nat32, dónde: puntero a byte): nat32
        variable id: nat32
        variable c: puntero a Cuenta
        variable t: arreglo [160] de byte
        si no sin_administrador() entonces devolver RA_NO_HACE_FALTA fin
        si n < 4 entonces devolver RA_CORTA fin
        tomar(cerrojo_cuentas)
        si no nombre_vale(nombre, 0) entonces
            soltar(cerrojo_cuentas)
            devolver RA_NOMBRE
        fin
        id := Cuentas.nueva(nombre, cierto, 0, falso)
        si id = 0 entonces
            soltar(cerrojo_cuentas)
            devolver RA_LLENO
        fin
        c := de_id(id)
        si no pon_clave(c, clave, n, falso) entonces
            Cuentas.quita(id)
            soltar(cerrojo_cuentas)
            devolver RA_ARGON
        fin
        si no guarda_cuentas() entonces
            carga_cuentas()
            soltar(cerrojo_cuentas)
            devolver RA_DISCO
        fin
        soltar(cerrojo_cuentas)
        dd_ra[0] := nat32(dirección(c.nombre[0]))
        dd_ra[1] := nat32(dónde)
        formatear(t, 160, "no había ningún administrador: se crea «%s» (administrador, con contraseña) %s", dirección(dd_ra[0]))
        apunta_usuarios_log(t)
        devolver RA_HECHO
    fin

    ; hace administrador al usuario id, que tiene contraseña: hay que
    ; escribirla (n letras, en la página 437). Da RA_...
    público función recupera_admin_de(id: nat32, clave: puntero a byte, n: nat32, dónde: puntero a byte): nat32
        variable c: puntero a Cuenta
        variable t: arreglo [160] de byte
        si no sin_administrador() entonces devolver RA_NO_HACE_FALTA fin
        c := de_id(id)
        si c = nulo entonces devolver RA_NOMBRE fin
        si c.clave[0] = 0 entonces devolver RA_SIN_CLAVE fin
        si espera_por_fallos() > 0 entonces devolver RA_ESPERA fin
        si no comprueba_clave(c, clave, n, falso) entonces
            apunta_fallo()
            si falta_argon entonces devolver RA_ARGON fin
            devolver RA_CLAVE_MALA
        fin
        apunta_acierto()
        tomar(cerrojo_cuentas)
        c.admin := cierto
        si no guarda_cuentas() entonces
            carga_cuentas()
            soltar(cerrojo_cuentas)
            devolver RA_DISCO
        fin
        soltar(cerrojo_cuentas)
        dd_ra[0] := nat32(dirección(c.nombre[0]))
        dd_ra[1] := nat32(dónde)
        formatear(t, 160, "no había ningún administrador: «%s» pasa a serlo (con su contraseña) %s", dirección(dd_ra[0]))
        apunta_usuarios_log(t)
        devolver RA_HECHO
    fin

    ; lo que ha pasado, en palabras (para la pantalla y la consola)
    público función texto_ra(r: nat32): puntero a byte
        según r
            caso RA_HECHO: devolver "Hecho."
            caso RA_NO_HACE_FALTA: devolver "Ya hay un administrador."
            caso RA_NOMBRE: devolver "Ese nombre no vale o ya lo tiene otro (de 1 a 20 letras, sin «|»)."
            caso RA_CORTA: devolver "La contraseña es demasiado corta (al menos 4 letras)."
            caso RA_DISTINTAS: devolver "Las dos contraseñas no son iguales."
            caso RA_LLENO: devolver "No caben más usuarios (16)."
            caso RA_ARGON: devolver "No se puede resumir la contraseña: falta ARGON2.BIN."
            caso RA_DISCO: devolver "No se puede guardar en el disco (¿arrancado sin escritura?)."
            caso RA_SIN_CLAVE: devolver "Ese usuario no tiene contraseña: cree un administrador nuevo."
            caso RA_CLAVE_MALA: devolver "La contraseña no es esa."
            caso RA_ESPERA: devolver "Demasiados intentos: espere un poco."
        fin
        devolver "No se ha podido."
    fin

    ; la 202: el servidor SSH (SSHD.BIN, su sello) pregunta. 0: ¿es esa la
    ; contraseña (UTF-8) de ese usuario? -> su número, y el programa que lance
    ; después (el intérprete de órdenes) será suyo; o DENEGADO (sin
    ; contraseña no se entra por SSH). 1: el usuario de una llave que SSHD ya
    ; ha comprobado (la de su AJUSTES\AUTORIZA.TXT): lo mismo, sin contraseña
    función atender_usuarios_202(a: nat32): nat32
        variable c: puntero a Cuenta
        si actual.sello <> SELLO_SSHD entonces devolver NO_VALE fin
        si no hay_cuentas entonces devolver NO_VALE fin
        pu.nombre[23] := 0
        si pu.n_clave > 127 entonces devolver NO_VALE fin
        c := por_nombre(dirección(pu.nombre[0]))
        si a = 1 entonces
            si c = nulo entonces devolver DENEGADO fin
            actual.uid_hijo := c.id
            imprimir1("cuentas: SSH: entra %s (con su llave)\n", nat32(dirección(c.nombre[0])))
            devolver c.id
        fin
        si a <> 0 entonces devolver NO_VALE fin
        si espera_por_fallos() > 0 entonces dormir(espera_por_fallos()) fin
        si c = nulo o c.clave[0] = 0 o no comprueba_clave(c, dirección(pu.clave[0]), pu.n_clave, cierto) entonces
            apunta_fallo()
            actual.uid_hijo := 0
            devolver DENEGADO
        fin
        apunta_acierto()
        actual.uid_hijo := c.id
        imprimir1("cuentas: SSH: entra %s (con su contraseña)\n", nat32(dirección(c.nombre[0])))
        devolver c.id
    fin

    ; (CORTES) acaba la tarea t y las que ha lanzado ella (hasta 4 niveles)
    función acaba_con_hijos(t: puntero a Tarea, nivel: nat32)
        variable i: nat32
        variable h: puntero a Tarea
        si t.estado = Tareas.LIBRE o t.estado = ACABADA entonces devolver fin
        si nivel < 4 entonces
            para i desde 0 hasta MAX_TAREAS - 1 hacer
                h := dirección(tareas[i])
                si h.estado <> Tareas.LIBRE y h.estado <> ACABADA y h.padre = t.id y h <> t entonces acaba_con_hijos(h, nivel + 1) fin
            fin
        fin
        si t.usuario y no t.servicio entonces acabar_tarea(t) fin
    fin

    función atender_usuarios(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable r: nat32
        variable p: puntero a Pedido_argon
        según nat16(n)
            caso 200:
                devolver atender_usuarios_200(a, b, c)
            caso 201, 202:
                si no puede(b, tamaño(Pedido_usuario), falso) entonces devolver NO_VALE fin
                tomar(cerrojo_cuentas)
                copiar_memoria(puntero(nat32(dirección(pu))), puntero(b), tamaño(Pedido_usuario))
                si n = 201 entonces r := atender_usuarios_201() sino r := atender_usuarios_202(a) fin
                llenar(puntero(nat32(dirección(pu))), tamaño(Pedido_usuario), 0)
                soltar(cerrojo_cuentas)
                devolver r
            caso 209:
                ; ARGON2.BIN: el pedido (a = 0) y la respuesta (a = 1); solo el
                ; que ha puesto en marcha el núcleo para eso. (0.8.9) Si el
                ; reloj le da la vez antes de que «argon2» apunte su número
                ; (cargar_servicio ya lo ha dejado listo), espera a que lo
                ; apunte: con el equipo cargado el pedido salía en 1 tic sin
                ; respuesta y la contraseña buena «no valía»
                r := 0
                mientras tarea_argon = 0 y pedido_argon.magia = MAGIA_ARGON y actual.sello = SELLO_ARGON2 y r < 100 hacer
                    dormir(1)
                    r := r + 1
                fin
                si tarea_argon = 0 o actual.id <> tarea_argon o actual.sello <> SELLO_ARGON2 entonces devolver NO_VALE fin
                si a = 0 entonces
                    si c < tamaño(Pedido_argon) o no puede(b, tamaño(Pedido_argon), cierto) entonces devolver NO_VALE fin
                    copiar_memoria(puntero(b), puntero(nat32(dirección(pedido_argon))), tamaño(Pedido_argon))
                    devolver tamaño(Pedido_argon)
                fin
                si a = 1 entonces
                    si no puede(b, 32, falso) entonces devolver NO_VALE fin
                    copiar_memoria(dirección(respuesta_argon[0]), puntero(b), 32)
                    hay_respuesta_argon := cierto
                    devolver 0
                fin
            caso 210:
                ; el azar del pozo del núcleo: b octetos (hasta 256) a a
                si b = 0 o b > 256 o no puede(a, b, cierto) entonces devolver NO_VALE fin
                azar(puntero(a), b)
                devolver b
        fin
        devolver NO_VALE
    fin

    ; (USUARIOS) al arrancar, con los discos ya vistos (semilla.cas): los
    ; usuarios del sistema instalado y la semilla del azar de la vez de antes
    ; (AZAR.SEM; si no la hay, se hace. Se cambia al apagar: el disco no se
    ; toca en cada arranque. Dos arranques con la misma semilla no dan el
    ; mismo azar: lleva también el momento de cada interrupción y RDRAND)
    público función arranca_cuentas()
        carga_cuentas()
        guarda_semilla(cierto)
    fin

    ; (USUARIOS) la semilla del pozo: con «leer» (al arrancar), se echa al
    ; pozo la que hay y, si no la hay, se hace; sin «leer» (al apagar), se
    ; escribe otra (si se puede escribir en el disco)
    público función guarda_semilla(leer: bool)
        variable r: arreglo [40] de byte
        variable sem: arreglo [32] de byte
        variable m, n, f, h: nat32
        si del_sistema >= MAX_UNIDADES o en_memoria(del_sistema) entonces devolver fin
        si unidades[del_sistema].clase <> U_FAT entonces devolver fin
        ruta_del_sistema("AZAR.SEM", r, 40)
        ahora(f, h)
        si leer entonces
            m := abrir_archivo(del_sistema, r, PARA_LEER)
            si m < PRIMER_ERROR entonces
                n := leer_archivo(m, sem, 32)
                cerrar_archivo(m)
                si n > 0 y n <= 32 entonces
                    echar(sem, n, tics, (f << 16) xob h)
                    con_semilla := cierto
                    llenar(sem, 32, 0)
                    devolver
                fin
            fin
        fin
        si no escribible(del_sistema) entonces devolver fin
        azar(sem, 32)
        m := abrir_archivo(del_sistema, r, PARA_CREAR)
        si m < PRIMER_ERROR entonces
            escribir_archivo(m, sem, 32)
            cerrar_archivo(m)
        fin
        llenar(sem, 32, 0)
    fin

    ; ¿puede el programa INSTALAR escribir sector a sector en el disco d?
    ; Solo con «instalar» en la línea del cargador, en un disco de dentro
    ; (nunca una memoria USB) que no lleve la unidad del sistema ni sea un
    ; medio de arranque (uno con el sistema en su raíz, como la memoria USB:
    ; por si se ha grabado su imagen en un disco de dentro).
    función se_puede_instalar(d: nat32): bool
        variable u, m: nat32
        si no instalando o d >= MAX_DISCOS entonces devolver falso fin
        si no discos[d].hay o discos[d].clase = DE_USB o no se_puede_escribir(d) entonces devolver falso fin
        para u desde 0 hasta MAX_UNIDADES - 2 hacer
            si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces
                si u = del_sistema entonces devolver falso fin
                m := abrir_archivo(u, "\\ORDENES.BIN", PARA_LEER)
                si m < PRIMER_ERROR entonces
                    cerrar_archivo(m)
                    devolver falso
                fin
            fin
        fin
        devolver cierto
    fin

    ; un octeto, solo al puerto serie
    función al_serie(c: nat32)
        variable i: nat32
        i := 0
        mientras i < 100000 y meter_puerto(0x3FD) yb 0x20 = 0 hacer i := i + 1 fin
        sacar_puerto(0x3F8, c)
    fin

    ; lo del programa INSTALAR y el asistente del primer arranque (60 a 68)
    función atender_instalar(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable pd: puntero a Pedido_disco
        variable i: puntero a Info_disco
        variable p: puntero a byte
        variable vga: puntero a nat16
        variable pos, k, color: nat32
        según n
            caso 60:
                si escritorio_en_marcha o actual.terminal <> 0 entonces devolver NO_VALE fin
                pos := ((a >> 8) yb 0xFF) * 80 + (a yb 0xFF)
                color := ((a >> 16) yb 0xFF) << 8
                si pos >= 2000 o c > 2000 - pos entonces devolver NO_VALE fin
                vga := puntero(0xB8000)
                si a yb 0x80000000 = 0 y no puede(b, c, falso) entonces devolver NO_VALE fin
                ; (con la pantalla tomada: lo que esté diciendo el núcleo acaba antes)
                tomar_consola()
                si a yb 0x80000000 <> 0 entonces
                    para k desde 1 hasta c hacer vga[pos + k - 1] := color ob (b yb 0xFF) fin
                sino
                    p := puntero(b)
                    para k desde 1 hasta c hacer vga[pos + k - 1] := color ob p[k - 1] fin
                fin
                soltar_consola()
                devolver c
            caso 61:
                si b > 512 o no puede(a, b, falso) entonces devolver NO_VALE fin
                p := puntero(a)
                tomar_consola()
                para k desde 1 hasta b hacer al_serie(p[k - 1]) fin
                soltar_consola()
                devolver b
            caso 62:
                si escritorio_en_marcha o actual.terminal <> 0 entonces devolver NO_VALE fin
                pos := ((a >> 8) yb 0xFF) * 80 + (a yb 0xFF)
                k := pos
                si k > 1920 entonces k := 1920 fin
                tomar_consola()
                ensamblador
                    mov eax, {k}
                    mov [C_cursor], eax
                    mov ebx, {pos}
                    mov edx, 0x3D4
                    mov al, 0x0F
                    out dx, al
                    inc edx
                    mov al, bl
                    out dx, al
                    dec edx
                    mov al, 0x0E
                    out dx, al
                    inc edx
                    mov al, bh
                    out dx, al
                fin
                soltar_consola()
                devolver 0
            caso 63:
                si no puede(b, tamaño(Info_disco), cierto) entonces devolver NO_VALE fin
                si a >= MAX_DISCOS entonces devolver 0 fin
                si no discos[a].hay entonces devolver 0 fin
                si discos[a].bloque <> SECTOR entonces devolver 0 fin      ; (CD) los CD y sus imágenes no son para instalar
                i := puntero(b)
                llenar(puntero(b), tamaño(Info_disco), 0)
                i.clase := discos[a].clase
                i.sectores := discos[a].sectores
                si se_puede_instalar(a) entonces i.se_puede := 1 fin
                si del_sistema < MAX_UNIDADES entonces
                    si unidades[del_sistema].clase = U_FAT y unidades[del_sistema].disco = a entonces i.del_sistema := 1 fin
                fin
                copiar_memoria(dirección(i.modelo[0]), dirección(discos[a].modelo[0]), 40)
                devolver 1
            caso 64, 65:
                ; (PROTEGE) los sectores en crudo (se saltan la zona protegida y
                ; los secretos): solo INSTALAR, o en modo administrador
                si (actual.sello <> SELLO_INSTALAR o no persona_admin(actual)) y no actual.admin entonces devolver DENEGADO fin     ; ((USUARIOS) INSTALAR, si lo lanza un administrador)
                si no puede(b, tamaño(Pedido_disco), falso) entonces devolver NO_VALE fin
                pd := puntero(b)
                si pd.n = 0 o pd.n > 128 o no puede(pd.datos, pd.n * SECTOR, n = 64) entonces devolver NO_VALE fin
                si discos[a].bloque <> SECTOR entonces devolver NO_VALE fin   ; (CD)
                si n = 64 entonces
                    si no leer_sectores(a, pd.lba, pd.n, puntero(pd.datos)) entonces devolver MAL fin
                    devolver 0
                fin
                si no se_puede_instalar(a) entonces devolver PROTEGIDO fin
                si unidades_de(a) <> 0 entonces desmonta_disco(a) fin
                si no escribir_sectores(a, pd.lba, pd.n, puntero(pd.datos)) entonces devolver MAL fin
                devolver 0
            caso 66:
                vaciar_discos()
                tomar_consola()
                escribir("reiniciar\n")
                soltar_consola()
                reiniciar_equipo()
            caso 67:
                ; (PROTEGE, 0.8.5) poner el reloj del sistema: atrasarlo haría
                ; pasar por buenos los certificados caducados (TLS). Solo los
                ; servicios, el asistente, INSTALAR y el modo administrador
                ; (el Reloj lo pide con la 157); Configuración es del núcleo
                ; ((USUARIOS) y el servicio, si no lo ha lanzado un usuario normal)
                si (no persona_admin(actual) o (no actual.servicio y actual.sello <> SELLO_ASISTE y actual.sello <> SELLO_INSTALAR)) y no actual.admin entonces
                    imprimir2("permisos: acceso denegado a poner el reloj del sistema (%s, la tarea %u)\n", nat32(actual.nombre), actual.id)
                    devolver DENEGADO
                fin
                pon_reloj(a, b)
                devolver 0
            caso 68:
                si a = 0 entonces
                    si lee_ajustes() entonces
                        si no hay_cuentas entonces carga_cuentas() fin      ; (USUARIOS) el del asistente
                        devolver 1
                    fin
                    devolver 0
                sino si a = 2 entonces
                    si instalado() entonces devolver 1 fin
                    devolver 0
                fin
                si c = 0 o no puede(b, c, cierto) entonces devolver NO_VALE fin
                ; (USUARIOS) el usuario: el de la tarea (si no, el que ha entrado; si no, el de HISPA.INI)
                si a = 1 y de_id(actual.uid) <> nulo entonces
                    copiar_hasta(puntero(b), dirección(de_id(actual.uid).nombre[0]), c)
                sino si a = 1 entonces
                    copiar_hasta(puntero(b), nombre_de_sesión(), c)
                sino
                    copiar_hasta(puntero(b), Ajustes.equipo, c)
                fin
                devolver 0
        fin
        devolver NO_VALE
    fin

    ; (CD) lo que hay en el lector del disco d (sin unidad): 0, nada; 2, un CD
    ; de música; 3, un disco que no se puede leer
    función estado_cd(d: nat32): byte
        variable e: nat32
        e := estado_de_lector(d)
        si e = 2 o e = 3 entonces devolver e fin
        devolver 0
    fin

    ; lo que se sabe de la unidad (o del disco sin unidad) número «cuál»,
    ; para Mi equipo: primero van las unidades, por su letra; detrás, los
    ; discos en los que no se ha encontrado ningún volumen que se pueda
    ; leer (con la letra a 0). Da 1, o 0 si no hay tantos.
    función info_unidad(cuál: nat32, i: puntero a Info_unidad): nat32
        variable u, d, n, letra, k: nat32
        llenar(puntero(nat32(i)), tamaño(Info_unidad), 0)
        n := 0
        para letra desde 'A' hasta 'Z' hacer
            u := por_letra(letra)
            si u <> NINGUNA entonces
                si n = cuál entonces
                    i.letra := letra
                    i.del_sistema := 0
                    si u = del_sistema entonces i.del_sistema := 1 fin
                    i.solo_lectura := 1
                    si en_memoria(u) entonces
                        i.clase := 1
                        i.medio := 0
                        k := 0
                        para d desde 1 hasta módulos() hacer k := k + módulo_final(d - 1) - módulo_inicio(d - 1) fin
                        i.total_k := (k + 1023) div 1024
                        copiar_memoria(dirección(i.nombre[0]), "en memoria", 11)
                    sino
                        d := unidades[u].disco
                        i.clase := volúmenes[u].clase
                        si volúmenes[u].iso entonces
                            i.clase := 9                        ; (CD) ISO 9660
                            i.quitable := 2
                            i.relleno[0] := 1
                        fin
                        i.medio := discos[d].clase
                        si discos[d].clase = DE_IMAGEN entonces i.quitable := 2 fin      ; (CD) se desmonta con «Expulsar»
                        si escribible(u) entonces i.solo_lectura := 0 fin
                        si quitable(u) entonces i.quitable := 1 fin
                        i.total_k := volúmenes[u].clusters * volúmenes[u].sectores_cluster div 2
                        k := clusters_libres_pronto(u)
                        si k = 0xFFFFFFFF entonces i.libre_k := k sino i.libre_k := k * volúmenes[u].sectores_cluster div 2 fin
                        copiar_memoria(dirección(i.nombre[0]), dirección(discos[d].modelo[0]), 40)
                        copiar_memoria(dirección(i.etiqueta[0]), dirección(volúmenes[u].etiqueta[0]), 12)
                    fin
                    devolver 1
                fin
                n := n + 1
            fin
        fin
        para d desde 0 hasta MAX_DISCOS - 1 hacer
            si discos[d].hay y unidades_de(d) = 0 entonces
                si n = cuál entonces
                    i.medio := discos[d].clase
                    i.solo_lectura := 1
                    i.total_k := discos[d].sectores div 2
                    si discos[d].clase = DE_CD entonces
                        ; (CD) un lector sin disco que se pueda leer: con su letra
                        i.letra := letra_de_cd(d)
                        i.quitable := 2
                        i.total_k := 0
                        i.relleno[0] := estado_cd(d)
                    fin
                    copiar_memoria(dirección(i.nombre[0]), dirección(discos[d].modelo[0]), 40)
                    devolver 1
                fin
                n := n + 1
            fin
        fin
        devolver 0
    fin

    ; borrar, cambiar de nombre y las carpetas (21 a 24)
    función atender_carpetas(n: nat32, a: nat32, b: nat32): nat32
        variable ruta, ruta2: arreglo [MAX_RUTA] de byte
        variable u, u2: nat32
        si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
        si u >= MAX_UNIDADES entonces devolver SIN_DISCO fin
        ; (en la unidad en memoria no se borra ni se crea nada)
        si en_memoria(u) entonces devolver PROTEGIDO fin
        ; (PROTEGE) en la zona protegida, solo quien tiene permiso
        si no puede_escribir(u, ruta) entonces devolver DENEGADO fin
        según n
            caso 21: devolver borrar_archivo(u, ruta)
            caso 22:
                si no ruta_de_usuario(b, ruta2, u2) entonces devolver NO_VALE fin
                si u2 <> u entonces devolver NO_VALE fin       ; (de una unidad a otra no se cambia de nombre: se copia)
                si no puede_escribir(u2, ruta2) entonces devolver DENEGADO fin     ; (PROTEGE) y adonde va
                devolver renombrar(u, ruta, ruta2)
            caso 23: devolver crear_carpeta(u, ruta)
        fin
        si es_carpeta_de_alguien(u, ruta) entonces devolver EN_USO fin
        devolver borrar_carpeta(u, ruta)
    fin

    ; (explorador) 170: los atributos del archivo a (b = 0xFFFFFFFF: solo
    ; leerlos); 171: lo soltado fuera de la ventana a (suya), como dice b
    ; (una Suelta: el punto, dentro de la ventana, y la ruta)
    función atender_explorador(n: nat32, a: nat32, b: nat32): nat32
        variable ruta: arreglo [MAX_RUTA] de byte
        variable u: nat32
        variable x, yy: ent32
        variable s: puntero a Suelta
        si n = 170 entonces
            si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
            si u >= MAX_UNIDADES entonces devolver SIN_DISCO fin
            si en_memoria(u) entonces
                si b <> 0xFFFFFFFF entonces devolver PROTEGIDO fin
                devolver SOLO_LECTURA
            fin
            si b <> 0xFFFFFFFF y no puede_escribir(u, ruta) entonces devolver DENEGADO fin     ; (PROTEGE)
            devolver poner_atributos(u, ruta, b)
        fin
        si no escritorio_en_marcha o no es_de(a, actual.id) o no puede(b, tamaño(Suelta), falso) entonces devolver NO_VALE fin
        s := puntero(b)
        x := s.x
        yy := s.ye
        si x < -4096 o x > 4096 o yy < -4096 o yy > 4096 entonces devolver NO_VALE fin
        si suelta_pedida entonces devolver EN_USO fin
        si no texto_de_usuario(s.ruta, ruta, MAX_RUTA) entonces devolver NO_VALE fin
        a_pantalla(a, x, yy)
        copiar(suelta_ruta, ruta)
        suelta_x := x
        suelta_y := yy
        suelta_pedida := cierto
        devolver 0
    fin

    ; (MIRADOR) 172: el tapiz del escritorio. a = 1: una imagen del programa
    ; (b, una Imagen_tapiz: su ancho, su alto y sus puntos, ya a la medida
    ; de la pantalla), que se guarda en FONDO.HPM, en la unidad del sistema
    ; (\HISPA\FONDO.HPM instalado; si no, en la raíz: como DOCK.INI), con la
    ; cabecera de las miniaturas («HPMI», ancho y alto), y se pone; a = 0: se
    ; quita y vuelve el de siempre. Da 0 o el error
    ; (PANEL, NTP) la llamada 175: la hora del reloj del PC en segundos desde
    ; el 1/1/2000 a las 0:00 (a = 0), o ponerla (a = 1, b los segundos). Poner
    ; la hora es lo de la 67 (los servicios, el asistente, INSTALAR y el modo
    ; administrador) y, además, HORARED.BIN (la hora por Internet: su sello),
    ; que no la puede atrasar más de dos horas sin el modo administrador
    ; (una hora, el cambio del horario de verano al de invierno): quien
    ; engañe a NTP no lleva el reloj días atrás para colar un certificado
    ; caducado (docs/PENTIUM.md, «La hora por Internet»)
    función atender_hora(a: nat32, b: nat32): nat32
        variable ya: nat32
        si a = 0 entonces devolver segundos_ahora() fin
        si a <> 1 entonces devolver NO_VALE fin
        si b < 86400 * 365 o b >= 86400 * 36524 entonces devolver NO_VALE fin       ; del 2001 al 2099
        si no actual.servicio y actual.sello <> SELLO_ASISTE y actual.sello <> SELLO_INSTALAR y actual.sello <> SELLO_HORA y no actual.admin entonces
            imprimir2("permisos: acceso denegado a poner el reloj del sistema (%s, la tarea %u)\n", nat32(actual.nombre), actual.id)
            devolver DENEGADO
        fin
        ya := segundos_ahora()
        si actual.sello = SELLO_HORA y no actual.admin y b + 7200 < ya entonces
            imprimir2("permisos: HORARED.BIN no puede atrasar el reloj %u segundos sin el modo administrador (la tarea %u)\n", ya - b, actual.id)
            devolver DENEGADO
        fin
        pon_segundos(b)
        devolver 0
    fin

    función atender_tapiz(a: nat32, b: nat32): nat32
        variable s: puntero a Imagen_tapiz
        variable ruta: arreglo [24] de byte
        variable cab: arreglo [3] de nat32
        variable m, n, an, al, pts: nat32
        si no escritorio_en_marcha entonces devolver NO_VALE fin
        si del_sistema >= MAX_UNIDADES o en_memoria(del_sistema) o no escribible(del_sistema) entonces devolver PROTEGIDO fin
        ruta_del_tapiz(ruta)
        si a = 0 entonces
            borrar_archivo(del_sistema, ruta)
            tapiz_pedido := 1
            devolver 0
        fin
        si a <> 1 o no puede(b, tamaño(Imagen_tapiz), falso) entonces devolver NO_VALE fin
        s := puntero(b)
        an := s.ancho
        al := s.alto
        pts := s.puntos
        si an < 1 o al < 1 o an > 4096 o al > 4096 o no puede(pts, an * al * 4, falso) entonces devolver NO_VALE fin
        m := abrir_archivo(del_sistema, ruta, PARA_CREAR)
        si m >= PRIMER_ERROR entonces devolver m fin
        cab[0] := 0x494D5048                    ; «HPMI»
        cab[1] := an
        cab[2] := al
        n := escribir_archivo(m, puntero(nat32(dirección(cab[0]))), 12)
        si n = 12 entonces n := escribir_archivo(m, puntero(pts), an * al * 4) fin
        cerrar_archivo(m)
        si n <> an * al * 4 entonces
            borrar_archivo(del_sistema, ruta)
            devolver DISCO_LLENO
        fin
        tapiz_pedido := 2
        devolver 0
    fin

    ; (MIRADOR) dónde va el tapiz con imagen: «\HISPA\FONDO.HPM» o «\FONDO.HPM»
    público función ruta_del_tapiz(ruta: puntero a byte)
        si instalado() entonces copiar(ruta, "\\HISPA\\FONDO.HPM") sino copiar(ruta, "\\FONDO.HPM") fin
    fin

    ; (BLOC, REPRODUCTOR) 173: la ruta de lo último que se ha soltado en una
    ; ventana del programa (EV_SOLTADO), a «a» (caben b octetos, con su 0):
    ; da su largo (NO_HAY: nada para él; se da una vez)
    función lo_soltado(a: nat32, b: nat32): nat32
        variable n: nat32
        si soltado_para = 0 o no es_de(soltado_para, actual.id) entonces devolver NO_HAY fin
        n := longitud(soltado_ruta)
        si b = 0 o no puede(a, b, cierto) entonces devolver NO_VALE fin
        si n + 1 > b entonces devolver NO_VALE fin
        copiar_memoria(puntero(a), dirección(soltado_ruta[0]), n + 1)
        soltado_para := 0
        devolver n
    fin

    ; el portapapeles del sistema: un texto (en la página 437, con sus
    ; líneas acabadas en «\n»), el último que se ha copiado o cortado en
    ; cualquier programa
    constante MAX_PORTAPAPELES = 65536
    variable portapapeles: puntero a byte
    variable en_portapapeles: nat32
    variable cerrojo_portapapeles: Cerrojo

    ; a = 0: guarda los c octetos de b; a = 1: copia lo que hay a b (hasta
    ; c octetos) y dice cuántos; a = 2: cuántos hay
    función atender_portapapeles(a: nat32, b: nat32, c: nat32): nat32
        variable m: puntero a byte
        variable r: nat32
        según a
            caso 0:
                si c > MAX_PORTAPAPELES o no puede(b, c, falso) entonces devolver NO_VALE fin
                m := nulo
                si c > 0 entonces
                    m := reservar(c)
                    si m = nulo entonces devolver SIN_MEMORIA fin
                    copiar_memoria(m, puntero(b), c)
                fin
                tomar(cerrojo_portapapeles)
                si portapapeles <> nulo entonces liberar(portapapeles) fin
                portapapeles := m
                en_portapapeles := c
                soltar(cerrojo_portapapeles)
                devolver c
            caso 1:
                si no puede(b, c, cierto) entonces devolver NO_VALE fin
                tomar(cerrojo_portapapeles)
                r := en_portapapeles
                si r > c entonces r := c fin
                si r > 0 entonces copiar_memoria(puntero(b), portapapeles, r) fin
                soltar(cerrojo_portapapeles)
                devolver r
            caso 2:
                devolver en_portapapeles
        fin
        devolver NO_VALE
    fin

    ; lo que pide un programa para abrir un menú emergente (la llamada 39)
    tipo PideMenú = estructura
        x, ye: ent32                            ; dónde, dentro de su ventana
        opciones: puntero a byte                ; separadas por «|»
        inactivas: nat32
        etiqueta: nat32
    fin

    ; las llamadas del entorno gráfico (32 a 41)
    función atender_ventanas(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable nombre: arreglo [MAX_TÍTULO] de byte
        variable opciones: arreglo [768] de byte       ; (MENÚ) eran 256: menús más largos
        variable ruta: arreglo [MAX_RUTA] de byte
        variable t: puntero a Tarea
        variable ord: puntero a Orden
        variable pm: puntero a PideMenú
        variable e: Evento
        variable p: puntero a nat32
        variable r, u: nat32
        variable x, yy: ent32
        según n
            caso 32:
                ; una ventana nueva: el nombre en a, lo que mide por dentro en b y c
                si no escritorio_en_marcha entonces devolver NO_VALE fin
                si no texto_de_usuario(a, nombre, MAX_TÍTULO) entonces devolver NO_VALE fin
                si b > 2048 o c > 2048 entonces devolver NO_VALE fin
                siguiente_sitio := (siguiente_sitio + 1) mod 6
                r := crear_ventana(nombre, 60 + ent32(siguiente_sitio) * 28, 36 + ent32(siguiente_sitio) * 26, ent32(b), ent32(c), 0, actual.id)
                si r = 0 entonces devolver SIN_MEMORIA fin
                devolver r
            caso 33:
                si cerrar_ventana(a, actual.id) entonces devolver 0 fin
                devolver NO_VALE
            caso 34:
                ; dibujar en la ventana a lo que dice la orden de b
                si no puede(b, tamaño(Orden), falso) entonces devolver NO_VALE fin
                ord := puntero(b)
                según ord.op
                    caso OP_TEXTO, OP_TEXTO_FONDO, OP_NEGRITA:
                        si ord.n < 0 o ord.n > 4096 o no puede(nat32(ord.datos), nat32(ord.n), falso) entonces devolver NO_VALE fin
                    caso OP_MAPA:
                        si ord.ancho < 1 o ord.alto < 1 o ord.ancho > 2048 o ord.alto > 2048 entonces devolver NO_VALE fin
                        si no puede(nat32(ord.datos), nat32(ord.ancho * ord.alto * 4), falso) entonces devolver NO_VALE fin
                fin
                si dibujar(a, actual.id, valor(ord)) entonces devolver 0 fin
                devolver NO_VALE
            caso 35:
                ; el suceso siguiente de la ventana a, a b; con c = 1, lo espera
                si no puede(b, tamaño(Evento), cierto) entonces devolver NO_VALE fin
                mientras cierto hacer
                    si saca_evento(a, actual.id, e) entonces
                        p := puntero(b)
                        p[0] := e.clase
                        p[1] := e.a
                        p[2] := e.b
                        p[3] := e.c
                        devolver 1
                    fin
                    si e.clase = 0xFFFFFFFF entonces devolver NO_VALE fin
                    si c <> 1 o actual.matar entonces devolver 0 fin
                    dormir(1)
                fin
            caso 36:
                si no texto_de_usuario(b, nombre, MAX_TÍTULO) entonces devolver NO_VALE fin
                si poner_título(a, actual.id, nombre) entonces devolver 0 fin
                devolver NO_VALE
            caso 37:
                ; los terminales: a dice qué (0 hacer uno; 1 leer lo que han
                ; escrito los de dentro, a b, hasta c octetos; 2 la tecla b
                ; para ellos; 3 Ctrl+C)
                según a
                    caso 0:
                        si actual.terminal <> 0 entonces devolver NO_VALE fin
                        r := crear_terminal()
                        si r = 0 entonces devolver SIN_MEMORIA fin
                        devolver r
                    caso 1:
                        si no puede(b, c, cierto) entonces devolver NO_VALE fin
                        devolver leer_salida(actual.terminal, puntero(b), c)
                    caso 2:
                        ; (1 si no ha cabido: el tubo de las teclas está lleno)
                        si teclear(actual.terminal, b) entonces devolver 0 fin
                        devolver 1
                    caso 3:
                        cortar_terminal(actual.terminal)
                        devolver 0
                fin
            caso 38:
                ; poner en marcha el escritorio (si no lo está ya)
                si escritorio_en_marcha entonces devolver 1 fin
                si al_escritorio = 0 entonces devolver 0 fin
                ensamblador
                    mov eax, {al_escritorio}
                    call eax
                    mov {r}, eax
                fin
                devolver r
            caso 39:
                ; un menú emergente para la ventana a (suya), como dice lo de b
                si no puede(b, tamaño(PideMenú), falso) entonces devolver NO_VALE fin
                pm := puntero(b)
                si no es_de(a, actual.id) o no texto_de_usuario(nat32(pm.opciones), opciones, 768) entonces devolver NO_VALE fin
                x := pm.x
                yy := pm.ye
                si x < -4096 o x > 4096 o yy < -4096 o yy > 4096 entonces devolver NO_VALE fin
                a_pantalla(a, x, yy)
                si abrir_emergente(x, yy, opciones, pm.inactivas, a, pm.etiqueta) entonces devolver 0 fin
                devolver SIN_MEMORIA
            caso 40:
                devolver atender_portapapeles(a, b, c)
            caso 41:
                ; lanzar un programa y soltarlo: no es hijo de nadie (al
                ; acabar lo recoge el núcleo), ni hereda el terminal
                si no ruta_de_usuario(a, ruta, u) entonces devolver NO_VALE fin
                opciones[0] := 0
                si b <> 0 y no texto_de_usuario(b, opciones, MAX_ARGS) entonces devolver NO_VALE fin
                t := carga_de(u, ruta, opciones, r)
                si t = nulo entonces devolver r fin
                t.padre := 0
                devolver t.id
            caso 80:
                ; colocar la ventana a (suya) con su esquina en (b, c) de la
                ; pantalla; con b = 0xFFFFFFFF, en el centro
                si no es_de(a, actual.id) entonces devolver NO_VALE fin
                si b = 0xFFFFFFFF entonces
                    centrar_ventana(a)
                    devolver 0
                fin
                x := ent32(b)
                yy := ent32(c)
                si x < -4096 o x > 4096 o yy < -4096 o yy > 4096 entonces devolver NO_VALE fin
                mover_ventana(a, x, yy)
                devolver 0
            caso 81:
                ; maximizar la ventana a (suya): le llega EV_TAMAÑO con lo que mide
                si no es_de(a, actual.id) entonces devolver NO_VALE fin
                maximizar_ventana(a)
                devolver 0
        fin
        devolver NO_VALE
    fin

    variable siguiente_sitio: nat32             ; para que las ventanas nuevas no nazcan una encima de otra

    ; =========================================================================
    ;  (REPRODUCTOR) El CD de música (134), el icono de un programa en la
    ;  bandeja (135); lo que se suelta desde Mi equipo en su ventana es la 173
    ; =========================================================================
    ; (134, b = 1 o 2) lo que se pide leer: el sector, cuántos (hasta 64) y adónde
    tipo Pide_sonido = estructura
        lba, n: nat32
        destino: nat32
    fin
    público constante MAX_ICONOS_PROGRAMA = 2
    público tipo Icono_programa = estructura
        ventana, dueño: nat32                   ; (ventana 0: libre)
        puntos: arreglo [256] de nat32          ; 16 x 16, 0xAARRGGBB (de A = 0x80 para arriba se pinta)
        ayuda: arreglo [48] de byte
        opciones: arreglo [160] de byte         ; las del menú del botón secundario, separadas por «|»
    fin
    público variable iconos_programa: arreglo [MAX_ICONOS_PROGRAMA] de Icono_programa
    público variable cambios_iconos: nat32      ; sube con cada cambio (el escritorio pinta otra vez la barra)
    variable toc: Toc_cd

    función atender_reproductor(n: nat32, a: nat32, b: nat32, c: nat32): nat32
        variable d, l, i, k: nat32
        variable p: puntero a Pide_sonido
        variable q: puntero a byte
        según n
            caso 134:
                ; el CD de música del lector de la letra a: b = 0, la tabla de
                ; las pistas (una Toc_cd) a c; b = 1, leer sectores de sonido
                ; (una Pide_sonido en c: 2352 octetos cada uno); b = 2, igual
                ; pero sin mirar la clase del sector (en crudo). Con a = 0,
                ; el primer lector que haya (el CD de sonido de los juegos:
                ; WINMM.DLL, por HispaCDAudio de WIN32.BIN; una sola llamada
                ; del CD de música para el Reproductor y para WIN32)
                si a = 0 entonces
                    l := MAX_LECTORES
                    para i desde 0 hasta MAX_LECTORES - 1 hacer
                        si l = MAX_LECTORES y lectores[i].hay entonces l := i fin
                    fin
                    si l = MAX_LECTORES entonces devolver NO_HAY fin
                sino
                    d := lector_de_letra(a)
                    si d = 0xFFFFFFFF entonces devolver NO_HAY fin
                    l := discos[d].cuál
                fin
                si b = 0 entonces
                    si no puede(c, tamaño(Toc_cd), cierto) entonces devolver NO_VALE fin
                    si no leer_toc(l, dirección(toc)) entonces devolver MAL fin
                    copiar_memoria(puntero(c), puntero(nat32(dirección(toc))), tamaño(Toc_cd))
                    devolver 0
                fin
                si b = 1 o b = 2 entonces
                    si no puede(c, tamaño(Pide_sonido), falso) entonces devolver NO_VALE fin
                    p := puntero(c)
                    si p.n = 0 o p.n > 64 entonces devolver NO_VALE fin
                    si no puede(p.destino, p.n * SECTOR_SONIDO, cierto) entonces devolver NO_VALE fin
                    si no leer_sonido(l, p.lba, p.n, puntero(p.destino), b = 2) entonces devolver MAL fin
                    devolver 0
                fin
                devolver NO_VALE
            caso 135:
                ; el icono de la ventana a (suya) en la bandeja: b, un
                ; Icono_programa sin «ventana» ni «dueño» (los puntos, la
                ; ayuda y las opciones); b = 0, quitarlo. Los clics llegan a
                ; la ventana como EV_BANDEJA
                si no es_de(a, actual.id) entonces devolver NO_VALE fin
                k := MAX_ICONOS_PROGRAMA
                para i desde 0 hasta MAX_ICONOS_PROGRAMA - 1 hacer
                    si iconos_programa[i].ventana = a entonces k := i fin
                fin
                si b = 0 entonces
                    si k < MAX_ICONOS_PROGRAMA entonces
                        iconos_programa[k].ventana := 0
                        cambios_iconos := cambios_iconos + 1
                    fin
                    devolver 0
                fin
                si no puede(b, tamaño(Icono_programa) - 8, falso) entonces devolver NO_VALE fin
                si k = MAX_ICONOS_PROGRAMA entonces
                    para i desde 0 hasta MAX_ICONOS_PROGRAMA - 1 hacer
                        si iconos_programa[i].ventana = 0 y k = MAX_ICONOS_PROGRAMA entonces k := i fin
                    fin
                fin
                si k = MAX_ICONOS_PROGRAMA entonces devolver EN_USO fin
                copiar_memoria(puntero(nat32(dirección(iconos_programa[k].puntos[0]))), puntero(b), tamaño(Icono_programa) - 8)
                iconos_programa[k].ayuda[47] := 0
                iconos_programa[k].opciones[159] := 0
                iconos_programa[k].dueño := actual.id
                iconos_programa[k].ventana := a
                cambios_iconos := cambios_iconos + 1
                devolver 0
        fin
        devolver NO_VALE
    fin

    ; (REPRODUCTOR) quita los iconos de la bandeja de esa tarea (al acabar)
    función quita_iconos_de(t: nat32)
        variable i: nat32
        para i desde 0 hasta MAX_ICONOS_PROGRAMA - 1 hacer
            si iconos_programa[i].ventana <> 0 y iconos_programa[i].dueño = t entonces
                iconos_programa[i].ventana := 0
                cambios_iconos := cambios_iconos + 1
            fin
        fin
    fin

    ; lo que deja una tarea al acabar: sus archivos, sus ventanas y su terminal
    función recoge_lo_suyo()
        cerrar_todos(actual.id)
        cerrar_módulos_de(actual.id)
        cerrar_ventanas_de(actual.id)
        soltar_terminales_de(actual.id)
        acabó(actual)
        acabó_sonido(actual)                    ; (SONIDO)
        quita_iconos_de(actual.id)              ; (REPRODUCTOR) su icono de la bandeja
    fin

    ; la interrupción 0x80: lo que se pide va en los registros que guardó
    ; «pushad» (EAX en [ebp+28], EBX en [ebp+16], ECX en [ebp+24], EDX en
    ; [ebp+20]), y lo que se devuelve se deja donde estaba EAX, que «popad»
    ; repone al volver. Se atiende con las interrupciones abiertas. Se apunta
    ; por dónde iba la pila del programa ([ebp+44], lo que apiló el procesador).
    interrupción función llamada_al_sistema()
        variable n, a, b, c, r, esp_u: nat32
        ensamblador
            mov eax, [ebp+44]
            mov {esp_u}, eax
            mov eax, [ebp+28]
            mov {n}, eax
            mov eax, [ebp+16]
            mov {a}, eax
            mov eax, [ebp+24]
            mov {b}, eax
            mov eax, [ebp+20]
            mov {c}, eax
            sti
        fin
        ; [WIN32] un programa de Windows lleva la pila con base 0x40000000
        ; (su SS): por dónde va, de verdad
        ensamblador
            mov eax, [ebp+40]
            mov {r}, eax
        fin
        si r yb 0xFFFF = CÓDIGO_WIN32 entonces esp_u := esp_u + BASE_WIN32 fin
        actual.esp_usuario := esp_u
        ; si a la tarea la han cortado con Ctrl+C, se acaba aquí (antes de
        ; hacer nada, o al volver: no está a medias de nada del núcleo)
        si actual.matar entonces cortar_actual() fin
        r := atender(n, a, b, c)
        si actual.matar entonces cortar_actual() fin
        ensamblador
            cli
            mov eax, {r}
            mov [ebp+28], eax
        fin
    fin

    ; la tarea del anillo 3 que corre, cortada con Ctrl+C: se acaba con el
    ; código CORTADA. No vuelve. (La llaman la llamada al sistema y, por su
    ; dirección, el reloj: tareas.cas.)
    función cortar_actual()
        ; (JUEGOS) un hilo de un programa de Windows: solo él (lo del proceso
        ; lo suelta el proceso); y un proceso que acaba porque uno de sus
        ; hilos lo ha pedido (ExitProcess), con su código y sin «^C»
        si actual.líder <> nulo entonces terminar(CORTADA) fin
        acaba_hilos()
        si actual.salir_pedido entonces
            recoge_lo_suyo()
            terminar(actual.salir_con)
        fin
        si actual.terminal <> 0 entonces escribir_terminal(actual.terminal, "^C\n", 3) sino escribir_trozo("^C\n", 3) fin
        recoge_lo_suyo()
        terminar(CORTADA)
    fin

    público función prepara_usuario()
        variable f, h: nat32
        ahora(f, h)
        prepara_pozo((f << 16) xob h)           ; (USUARIOS) el pozo del azar: el procesador (TSC, RDRAND) y la fecha
        prepara_permisos()                      ; (PROTEGE) la tabla de quién escribe qué
        prepara_preferencias()                  ; (PANEL) los ajustes del Panel de control, los de siempre
        pon_puerta(0x80, nat32(dirección(llamada_al_sistema)), PUERTA_USUARIO)
        al_cortar := nat32(dirección(cortar_actual))
    fin

    ; -------------------------------------------------------------------------
    ;  Cargar un programa
    ; -------------------------------------------------------------------------
    ; ¿es lo que hay en «ini» (de «largo» octetos) un programa de usuario que
    ; se puede cargar? Da 0, o NO_PROGRAMA
    función mira_imagen(ini: nat32, largo: nat32): nat32
        variable c: puntero a Cabecera
        variable bien: bool
        c := puntero(ini)
        si largo < tamaño(Cabecera) entonces devolver NO_PROGRAMA fin
        si c.magia <> MAGIA entonces devolver NO_PROGRAMA fin
        bien := c.inicio = USUARIO_INICIO y c.datos_fin >= c.inicio y c.datos_fin - c.inicio <= largo
        bien := bien y c.vacío_fin >= c.datos_fin y c.vacío_fin <= PILA_INICIO
        bien := bien y c.entrada >= c.inicio y c.entrada < c.datos_fin
        si no bien entonces devolver NO_VALE fin
        devolver 0
    fin

    ; ¿es el módulo i un programa de usuario que se puede cargar?
    público función es_programa(i: nat32): bool
        devolver mira_imagen(módulo_inicio(i), módulo_final(i) - módulo_inicio(i)) = 0
    fin

    ; por qué no se ha podido (para decirlo)
    público función texto_error(e: nat32): puntero a byte
        según e
            caso NO_HAY: devolver "no existe"
            caso SIN_DISCO: devolver "no hay disco (o no es FAT)"
            caso LLENO: devolver "hay demasiados archivos abiertos"
            caso MAL: devolver "el disco falla"
            caso NO_PROGRAMA: devolver "no es un programa de Hispa-Pentium (le falta la cabecera «HPU3»)"
            caso SIN_MEMORIA: devolver "no hay memoria, o no quedan tareas libres"
            caso NO_VALE: devolver "la cabecera del programa no tiene sentido"
            caso DISCO_LLENO: devolver "no queda sitio en el disco"
            caso YA_EXISTE: devolver "ya existe"
            caso EN_USO: devolver "está en uso"
            caso PROTEGIDO: devolver "es de solo lectura"
            caso NO_VACÍA: devolver "la carpeta no está vacía"
            caso NOMBRE_MALO: devolver "el nombre no vale"
            caso ES_CARPETA: devolver "es una carpeta"
            caso NO_CARPETA: devolver "no es una carpeta"
            caso DENEGADO: devolver "acceso denegado: es del sistema, o un secreto de un servicio (para cambiarlo a mano: ADMIN)"
        fin
        devolver "no se puede"
    fin

    ; carga el programa que está en la memoria, en «ini», en un espacio de
    ; direcciones nuevo y hace su tarea (que entra en la cola), con ese nombre
    ; y esos argumentos (o nulo). Da la tarea; o nulo, y en «error» por qué.
    ; (PROTEGE) «sello» y «servicio»: lo que es (Permisos.sello_de_carga):
    ; se pone en su ficha antes de que pueda correr
    función cargar_imagen(nombre: puntero a byte, ini: nat32, largo: nat32, args: puntero a byte, ref error: nat32, sello: nat32, servicio: bool, teb: nat32): puntero a Tarea
        variable c: puntero a Cabecera
        variable d, v, m, origen, cuánto, n, b: nat32
        variable t: puntero a Tarea
        variable copia: puntero a byte
        error := mira_imagen(ini, largo)
        si error <> 0 entonces devolver nulo fin
        error := SIN_MEMORIA
        c := puntero(ini)
        d := nuevo_espacio()
        si d = 0 entonces devolver nulo fin
        ; una página detrás de otra: un marco nuevo (a cero) y, encima, lo que
        ; toque del archivo (el marco se ve por la identidad)
        v := c.inicio
        mientras v < c.vacío_fin hacer
            m := reservar_marco()
            si m = 0 o no mapear(d, v, m, ESCRIBIR ob USUARIO) entonces
                si m <> 0 entonces soltar_marco(m) fin
                soltar_espacio(d)
                devolver nulo
            fin
            si v < c.datos_fin entonces
                origen := ini + (v - c.inicio)
                cuánto := c.datos_fin - v
                si cuánto > PÁGINA entonces cuánto := PÁGINA fin
                copiar_memoria(puntero(m), puntero(origen), cuánto)
            fin
            v := v + PÁGINA
        fin
        ; su pila: la última página de su zona; las de debajo las pondrá el
        ; fallo de página según baje
        m := reservar_marco()
        si m = 0 o no mapear(d, PILA_FINAL - PÁGINA, m, ESCRIBIR ob USUARIO) entonces
            si m <> 0 entonces soltar_marco(m) fin
            soltar_espacio(d)
            devolver nulo
        fin
        copia := nulo
        si args <> nulo y args[0] <> 0 entonces
            n := 0
            mientras args[n] <> 0 hacer n := n + 1 fin
            copia := reservar(n + 1)
            si copia = nulo entonces
                soltar_espacio(d)
                devolver nulo
            fin
            copiar_memoria(copia, args, n + 1)
        fin
        ; la tarea y sus argumentos, de una vez (que no empiece sin ellos)
        b := sin_interrupciones()
        t := crear_tarea_usuario(nombre, d, c.entrada, PILA_FINAL - 16, v)
        si t <> nulo entonces
            t.args := copia
            ; (JUEGOS, 0.8.9) la TEB de su hilo principal, si es WIN32.BIN: aquí
            ; y no al volver, porque lo primero que hace es la 183, 9 (quitar
            ; las primeras 64 K), que sin TEB no vale; si el reloj le daba la
            ; vez antes, el puntero nulo no fallaba (SEH, a veces)
            t.teb := teb
            ; (PROTEGE) su sello, y el modo administrador de quien la lanza
            ; (si es un programa que lo tiene; el núcleo no lo da)
            t.sello := sello
            t.servicio := servicio
            t.admin := actual <> nulo y actual.usuario y actual.admin
            ; (USUARIOS) de quién es: de quien lo lanza (SSHD da el del que ha
            ; entrado por SSH: uid_hijo); lo que lanza el núcleo, del que está
            ; delante (en la pantalla de entrada, nadie: el sistema)
            si actual <> nulo y actual.usuario entonces
                t.uid := actual.uid
                ; (0.8.11, SIN-ADMIN) lo que lanza un programa «del sistema»
                ; (uid 0) que no es un servicio, con alguien dentro, es del que
                ; está dentro: ACTUALIZ /BANDEJA lo pone el núcleo al arrancar
                ; y su «Verlas» abría «Programas y actualizaciones» como el
                ; sistema (instalar y quitar sin ser administrador)
                si actual.uid = 0 y no actual.servicio y hay_cuentas y sesión <> 0 y actual.uid_hijo = 0 entonces t.uid := sesión fin
                t.remota := actual.remota o actual.uid_hijo <> 0
                si actual.uid_hijo <> 0 entonces
                    t.uid := actual.uid_hijo
                    actual.uid_hijo := 0
                fin
            sino
                t.uid := sesión
            fin
        fin
        reponer(b)
        si t = nulo entonces
            si copia <> nulo entonces liberar(copia) fin
            soltar_espacio(d)
            devolver nulo
        fin
        error := 0
        devolver t
    fin

    ; carga el módulo i de multiboot. Da la tarea, o nulo (y dice por qué).
    público función cargar(i: nat32): puntero a Tarea
        variable t: puntero a Tarea
        variable e: nat32
        t := cargar_imagen(módulo_nombre(i), módulo_inicio(i), módulo_final(i) - módulo_inicio(i), nulo, e, 0, falso, 0)
        si t = nulo entonces imprimir1("%s\n", nat32(texto_error(e))) fin
        devolver t
    fin

    ; carga un programa por su ruta, como la escribe el núcleo: con la
    ; letra de su unidad delante («X:\BLOC.BIN») o, sin ella, de la unidad
    ; del sistema. Da la tarea; o nulo, y en «error» por qué.
    público función cargar_archivo(ruta: puntero a byte, args: puntero a byte, ref error: nat32): puntero a Tarea
        variable u: nat32
        u := del_sistema
        si ruta[0] <> 0 y ruta[1] = ':' entonces
            u := por_letra(ruta[0])
            ruta := ruta + 2
        fin
        devolver carga_de(u, ruta, args, error)
    fin

    ; carga un programa de la unidad u: lo lee entero a la memoria del núcleo
    ; y, de ahí, a su espacio de direcciones. Da la tarea; o nulo, y en
    ; «error» por qué.
    función carga_de(u: nat32, ruta: puntero a byte, args: puntero a byte, ref error: nat32): puntero a Tarea
        devolver carga_de_con(u, ruta, args, error, 0)
    fin

    ; lo mismo, con la TEB del hilo principal (teb <> 0: WIN32.BIN, que la
    ; tiene desde que empieza)
    función carga_de_con(u: nat32, ruta: puntero a byte, args: puntero a byte, ref error: nat32, teb: nat32): puntero a Tarea
        variable m, largo, leídos: nat32
        variable imagen, nombre, p: puntero a byte
        variable t: puntero a Tarea
        variable en_hispa: arreglo [24] de byte
        variable de_dónde: puntero a byte
        variable sello: nat32
        variable servicio: bool
        si u >= MAX_UNIDADES entonces
            error := SIN_DISCO
            devolver nulo
        fin
        ; de los módulos del cargador (la unidad en memoria)
        si en_memoria(u) entonces
            m := busca_módulo(ruta)
            si m >= MOD_RAÍZ entonces
                error := NO_HAY
                devolver nulo
            fin
            sello := sello_de_carga(u, ruta, servicio)      ; (PROTEGE)
            devolver cargar_imagen(módulo_nombre(m), módulo_inicio(m), módulo_final(m) - módulo_inicio(m), args, error, sello, servicio, teb)
        fin
        m := abrir_archivo(u, ruta, PARA_LEER)
        de_dónde := ruta                        ; (PROTEGE) de dónde se carga de verdad
        si m = NO_HAY y del_sistema < MAX_UNIDADES y no en_memoria(del_sistema) entonces
            ; los programas de un sistema instalado en el disco están en su
            ; carpeta \HISPA: lo que no está donde se pide se busca allí
            nombre := ruta
            p := ruta
            mientras valor(p) <> 0 hacer
                si valor(p) = '\\' o valor(p) = '/' o valor(p) = ':' entonces nombre := p + 1 fin
                p := p + 1
            fin
            copiar_hasta(en_hispa, "\\HISPA\\", 24)
            copiar_hasta(dirección(en_hispa[7]), nombre, 13)
            u := del_sistema
            m := abrir_archivo(u, en_hispa, PARA_LEER)
            de_dónde := dirección(en_hispa[0])
        fin
        si m >= PRIMER_ERROR entonces
            error := m
            devolver nulo
        fin
        ; (PROTEGE) lo que es, por la ruta de la que se carga, no por su
        ; nombre (antes de que en_hispa sirva para otra cosa)
        sello := sello_de_carga(u, de_dónde, servicio)
        ; [WIN32] un programa de Windows (empieza por «MZ»): lo corre
        ; WIN32.BIN, con su ruta entera delante de sus argumentos
        si no es_carpeta(m) y tamaño_archivo(m) > 64 entonces
            si leer_archivo(m, dirección(en_hispa[0]), 2) = 2 y en_hispa[0] = 'M' y en_hispa[1] = 'Z' entonces
                cerrar_archivo(m)
                devolver carga_win32(u, ruta, args, error)
            fin
            mover_archivo(m, 0, 0)
        fin
        largo := tamaño_archivo(m)
        si es_carpeta(m) o largo < tamaño(Cabecera) o largo > MAX_PROGRAMA entonces
            cerrar_archivo(m)
            error := NO_PROGRAMA
            devolver nulo
        fin
        imagen := reservar(largo)
        si imagen = nulo entonces
            cerrar_archivo(m)
            error := SIN_MEMORIA
            devolver nulo
        fin
        leídos := leer_archivo(m, imagen, largo)
        cerrar_archivo(m)
        si leídos <> largo entonces
            liberar(imagen)
            error := MAL
            devolver nulo
        fin
        ; su nombre: lo de detrás de la última barra
        nombre := ruta
        p := ruta
        mientras valor(p) <> 0 hacer
            si valor(p) = '\\' o valor(p) = '/' o valor(p) = ':' entonces nombre := p + 1 fin
            p := p + 1
        fin
        t := cargar_imagen(nombre, nat32(imagen), largo, args, error, sello, servicio, teb)
        liberar(imagen)
        devolver t
    fin

    ; [WIN32] carga WIN32.BIN (de la unidad del sistema, o de su \HISPA) para
    ; que corra el programa de Windows «ruta» de la unidad u: sus argumentos,
    ; «U:\RUTA\PROG.EXE» y los que traía. La tarea lleva el nombre del .EXE.
    función carga_win32(u: nat32, ruta: puntero a byte, args: puntero a byte, ref error: nat32): puntero a Tarea
        variable todo: puntero a byte
        variable n, k: nat32
        variable t: puntero a Tarea
        variable nombre, p: puntero a byte
        n := 0
        mientras ruta[n] <> 0 hacer n := n + 1 fin
        k := 0
        si args <> nulo entonces
            mientras args[k] <> 0 hacer k := k + 1 fin
        fin
        todo := reservar(n + k + 8)
        si todo = nulo entonces
            error := SIN_MEMORIA
            devolver nulo
        fin
        todo[0] := unidades[u].letra
        todo[1] := ':'
        copiar_memoria(todo + 2, ruta, n)
        todo[n + 2] := ' '
        si k > 0 entonces copiar_memoria(todo + n + 3, args, k) fin
        todo[n + 3 + k] := 0
        t := carga_de_con(del_sistema, "\\WIN32.BIN", todo, error, TEB_PRINCIPAL)
        liberar(todo)
        si t <> nulo entonces
            ; su nombre: el del .EXE
            nombre := ruta
            p := ruta
            mientras valor(p) <> 0 hacer
                si valor(p) = '\\' o valor(p) = '/' o valor(p) = ':' entonces nombre := p + 1 fin
                p := p + 1
            fin
            copiar_hasta(dirección(t.nombre_propio[0]), nombre, 16)
            t.nombre := dirección(t.nombre_propio[0])
        fin
        devolver t
    fin

    ; la tarea del anillo 3 que corre ha hecho algo que no puede (lo dice
    ; quien llama): se acaba con el código MATADA. No vuelve.
    público función matar_actual()
        imprimir2("*** se acaba la tarea %u (%s)\n", actual.id, nat32(actual.nombre))
        ; (JUEGOS) si es un hilo de un programa de Windows, se acaba el proceso entero
        si actual.líder <> nulo entonces
            actual.líder.salir_con := MATADA
            actual.líder.salir_pedido := cierto
            acabar_tarea(actual.líder)
            terminar(MATADA)
        fin
        acaba_hilos()
        recoge_lo_suyo()
        terminar(MATADA)
    fin

    público función enseña_programas()
        variable i: nat32
        si módulos() = 0 entonces
            escribir("el cargador no ha traído ningún programa\n")
            devolver
        fin
        para i desde 0 hasta módulos() - 1 hacer
            imprimir3("%3u  %-14s  %6u octetos", i, nat32(módulo_nombre(i)), módulo_final(i) - módulo_inicio(i))
            si es_programa(i) entonces escribir("  programa de usuario\n") sino escribir("  (no es un programa)\n") fin
        fin
    fin

fin Usuario.
