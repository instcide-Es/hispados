; =============================================================================
;  textouefi.cas - (UEFI) la consola de texto cuando no hay modo de texto.
;  Arrancado por UEFI (GRUB EFI, multiboot2) no hay pantalla de texto de la
;  VGA en 0xB8000: el firmware deja un modo gráfico (su GOP) y nada más. Todo
;  lo de modo texto del núcleo (su consola, el intérprete de órdenes del
;  arranque en modo texto, INSTALAR con su pantalla azul, la llamada 60)
;  sigue escribiendo letras y colores en 0xB8000, como siempre; aquí esa
;  página pasa a ser un marco de RAM y una tarea del núcleo (texto-uefi) la
;  pinta en la pantalla gráfica, 80 x 25 letras de 8 x 16 (la página 437
;  entera: letra437.cas), con los 16 colores de la VGA y el cursor, más
;  grandes si la pantalla da para el doble (o el triple...) y en el centro.
;  Solo pinta lo que cambia, cada 4 tics. Cuando el escritorio pone su modo
;  (Video.hay_pantalla), la pantalla es suya y esto se calla.
;  Con la BIOS no hace nada (hay modo de texto de verdad).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Textouefi

    importar Cpu, Multiboot, Paginas, Marcos, Tareas, Video, Letra437, Formato

    constante COLUMNAS = 80
    constante CELDAS = 2000
    constante TEXTO = 0xB8000                   ; donde se escribe el texto (su página, a un marco de RAM)

    público variable texto_en_marcha: bool      ; la consola se pinta en la pantalla del firmware
    público variable marco_texto: nat32         ; (para las pruebas) el marco físico con las letras
    variable t_base, t_fila, t_an, t_al, t_bits: nat32
    variable lienzo_t: nat32                    ; dónde se ve la pantalla (virtual)
    variable escala, x0, y0: nat32
    variable visto: arreglo [CELDAS] de nat16   ; lo que ya está pintado
    variable cursor_visto: nat32
    variable cursor_encendido: bool
    variable rgb: bool                          ; la pantalla es «al revés» (RGB)
    variable paleta: arreglo [16] de nat32
    variable era_gráfico: bool

    función cursor_texto(): nat32
        ensamblador
            mov eax, [C_cursor]
        fin
    fin

    función color_vga(i: nat32): nat32
        variable c: nat32
        c := paleta[i yb 15]
        si rgb entonces
            c := ((c yb 0xFF) << 16) ob (c yb 0xFF00) ob ((c >> 16) yb 0xFF)
        fin
        devolver c
    fin

    ; la celda i con su letra y sus colores (v: como en 0xB8000), y el cursor
    ; (las dos filas de abajo) si se dice
    función pinta_celda(i: nat32, v: nat32, con_cursor: bool)
        variable g: puntero a byte
        variable p: puntero a nat32
        variable fg, bg, fx, fy, j, k, b, alto, ancho: nat32
        g := dibujo_437(v yb 0xFF)
        fg := color_vga((v >> 8) yb 15)
        bg := color_vga((v >> 12) yb 7)
        fx := x0 + (i mod COLUMNAS) * 8 * escala
        fy := y0 + (i div COLUMNAS) * 16 * escala
        alto := 16 * escala
        ancho := 8 * escala
        para j desde 0 hasta alto - 1 hacer
            b := g[j div escala]
            si con_cursor y j div escala >= 14 entonces b := 0xFF fin
            p := puntero(lienzo_t + (fy + j) * t_fila + fx * 4)
            para k desde 0 hasta ancho - 1 hacer
                si b yb (nat32(0x80) >> (k div escala)) <> 0 entonces p[k] := fg sino p[k] := bg fin
            fin
        fin
    fin

    función vigila(n: nat32)
        variable t: puntero a nat16
        variable i, c: nat32
        variable enc, todo: bool
        t := puntero(TEXTO)
        todo := falso
        mientras cierto hacer
            dormir(4)
            si hay_pantalla entonces
                era_gráfico := cierto
            sino
                si era_gráfico entonces
                    ; el escritorio ha dejado la pantalla: todo otra vez
                    todo := cierto
                    era_gráfico := falso
                fin
                c := cursor_texto()
                enc := (tics div 25) yb 1 = 0
                para i desde 0 hasta CELDAS - 1 hacer
                    si t[i] <> visto[i] o todo entonces
                        visto[i] := t[i]
                        pinta_celda(i, t[i], enc y i = c)
                    fin
                fin
                todo := falso
                si c <> cursor_visto o enc <> cursor_encendido entonces
                    si cursor_visto < CELDAS entonces pinta_celda(cursor_visto, visto[cursor_visto], falso) fin
                    si c < CELDAS entonces pinta_celda(c, visto[c], enc) fin
                    cursor_visto := c
                    cursor_encendido := enc
                fin
            fin
        fin
    fin

    ; con UEFI (y una pantalla de 32 bits por punto que haya dejado el
    ; cargador), la página del texto a un marco de RAM y la tarea que la pinta.
    ; Después de la paginación y de las tareas.
    público función prepara_texto_uefi()
        variable p: puntero a nat32
        variable q: puntero a nat16
        variable e2, j, k: nat32
        si no arrancado_por_uefi() entonces devolver fin
        si no pantalla_del_cargador(t_base, t_fila, t_an, t_al, t_bits) entonces
            escribir("uefi: el cargador no ha dejado pantalla: la consola de texto solo sale por el puerto serie\n")
            devolver
        fin
        si t_bits <> 32 o t_an < 640 o t_al < 400 entonces
            escribir("uefi: la pantalla del firmware es de ", t_an, "x", t_al, " con ", t_bits, " bits por punto: la consola de texto solo sale por el puerto serie\n")
            devolver
        fin
        si no a_la_vista(t_base, t_fila * t_al) entonces
            escribir("uefi: no se puede poner a la vista la pantalla del firmware\n")
            devolver
        fin
        marco_texto := reservar_marco()
        si marco_texto = 0 entonces devolver fin
        rgb := pantalla_al_revés()
        lienzo_t := GRÁFICOS_INICIO + (t_base yb 0xFFF)
        escala := t_an div 640
        e2 := t_al div 400
        si e2 < escala entonces escala := e2 fin
        x0 := (t_an - 640 * escala) div 2
        y0 := (t_al - 400 * escala) div 2
        ; los 16 colores de la VGA
        paleta[0] := 0x000000
        paleta[1] := 0x0000AA
        paleta[2] := 0x00AA00
        paleta[3] := 0x00AAAA
        paleta[4] := 0xAA0000
        paleta[5] := 0xAA00AA
        paleta[6] := 0xAA5500
        paleta[7] := 0xAAAAAA
        paleta[8] := 0x555555
        paleta[9] := 0x5555FF
        paleta[10] := 0x55FF55
        paleta[11] := 0x55FFFF
        paleta[12] := 0xFF5555
        paleta[13] := 0xFF55FF
        paleta[14] := 0xFFFF55
        paleta[15] := 0xFFFFFF
        ; la pantalla, en negro
        para j desde 0 hasta t_al - 1 hacer
            p := puntero(lienzo_t + j * t_fila)
            para k desde 0 hasta t_an - 1 hacer p[k] := 0 fin
        fin
        ; el texto, en un marco de RAM (lo de antes, que fue a la nada, en blanco)
        si no mapear(directorio_núcleo, TEXTO, marco_texto, ESCRIBIR) entonces devolver fin
        poner_cr3(leer_cr3())
        q := puntero(TEXTO)
        para k desde 0 hasta CELDAS - 1 hacer
            q[k] := 0x0720
            visto[k] := 0
        fin
        ensamblador
            mov dword [C_cursor], 0
        fin
        cursor_visto := CELDAS
        si crear_tarea("texto-uefi", nat32(dirección(vigila)), 0) = nulo entonces devolver fin
        texto_en_marcha := cierto
        escribir("uefi: sin modo de texto: la consola se pinta en la pantalla del firmware (", t_an, "x", t_al, ", las letras por ", escala, ")\n")
        imprimir1("uefi: el texto, en el marco 0x%08X\n", marco_texto)
    fin

fin Textouefi.
