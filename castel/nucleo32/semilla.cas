; =============================================================================
;  semilla.cas - la semilla de Hispa-Pentium: un núcleo de 32 bits escrito en
;  Castel («modelo núcleo»). Lo arranca un cargador multiboot (QEMU con
;  -kernel, o GRUB) en modo protegido con la memoria plana; el arranque que
;  pone el compilador (CASTEL32.md) le da su pila y la pantalla en blanco, y
;  llama a principal(). Desde ahí, todo es Castel, repartido en módulos:
;   - cpu.cas: la GDT (anillos 0 y 3) y el TSS, la IDT, el 8259 y el reloj;
;   - multiboot.cas: lo que cuenta el cargador (el mapa de memoria, los
;     módulos que trae);
;   - marcos.cas: los marcos físicos de 4 K, con un mapa de bits;
;   - paginas.cas: la paginación (la identidad para el núcleo, el montón, la
;     zona a la demanda y un espacio de direcciones por programa);
;   - monton.cas: el montón del núcleo (reservar y liberar, con comprobación
;     de que nadie lo estropea);
;   - tareas.cas: las tareas, con el reloj repartiendo el procesador,
;     dormir, esperar y acabar, y los cerrojos;
;   - consola.cas: el teclado (el español, con sus acentos) y la pantalla,
;     cada uno con su cerrojo;
;   - pci.cas: el bus PCI (buscar las controladoras);
;   - ata.cas, ahci.cas: los discos duros IDE (PIO) y SATA (AHCI, por DMA);
;   - discos.cas: todos los discos, sean de la clase que sean;
;   - fat.cas: el sistema de archivos FAT12/16/32: leer y escribir;
;   - unidades.cas: las particiones y las letras de las unidades (C:, X:, M:);
;   - usb.cas, con xhci.cas y ehci.cas (las controladoras), usbhid.cas (los
;     teclados y los ratones) y usbalm.cas (las memorias): el USB;
;   - fecha.cas: la fecha y la hora (el reloj de la CMOS);
;   - usuario.cas: los programas del anillo 3 (del disco, o de los módulos
;     de multiboot) y su llamada al sistema, la int 0x80;
;  y aquí, las excepciones (con el fallo de página, que se atiende) y la
;  consola del núcleo con sus órdenes. Lo que escribe va a la pantalla y al
;  puerto serie (COM1). El intérprete de órdenes de verdad es un programa del
;  anillo 3 (uordenes.cas, ORDENES.BIN en el disco): la orden «ordenes» lo
;  lanza, y si el cargador le dice «ordenes» al núcleo (QEMU: -append
;  ordenes), se lanza él solo al arrancar.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Semilla

    modelo núcleo

    importar Cpu, Multiboot, Marcos, Paginas, Monton, Tareas, Consola, Discos, Fat, Unidades, Sdacpi, Usb, Usbhid, I2c, I2chid, Usbalm, Usbcal, Cdcal, Cdrom, Registro, Usuario, Termo, Ajustes, Escritorio, Textos32, Mem32, Formato, Red, Pci, Energia, Sonido, Cuentas, Entrada, Win32, Textouefi, Relojhpet, Video     ; (UEFI) Textouefi, Relojhpet, Video

    ; ---- la consola ----
    variable línea: arreglo [80] de byte
    variable largo: nat32
    variable palabra1: arreglo [40] de byte

    ; ---- para las pruebas de la consola ----
    variable semilla_azar: nat32 = 12345
    variable vivos: arreglo [64] de puntero a byte
    variable largos: arreglo [64] de nat32
    variable cuentas: arreglo [2] de nat32
    variable alternancias, última, hasta_tic: nat32
    variable toques: nat32

    ; -------------------------------------------------------------------------
    ;  Las excepciones
    ; -------------------------------------------------------------------------
    ; lo que pasa cuando el procesador no puede seguir: si estaba en el anillo
    ; 3 (cs), se acaba esa tarea y el núcleo sigue; si estaba en el núcleo, se
    ; para con el código «n»
    función no_sigue(cs_: nat32, eip: nat32, n: byte)
        imprimir1(" en 0x%08X", eip)
        si cs_ yb 3 = 3 entonces
            escribir(", en el anillo 3\n")
            sonar(SS_ERROR)                     ; (SONIDO) el sonido de error (con el escritorio)
            matar_actual()
        fin
        escribir(". El núcleo se para.\n")
        salir(n)
    fin

    interrupción función división_por_cero()
        variable cs_, eip, m: nat32
        ensamblador
            mov eax, [ebp+32]
            mov {eip}, eax
            mov eax, [ebp+36]
            mov {cs_}, eax
            mov {m}, ebp
        fin
        si a_su_despachador(m, 0, 0, 0, falso) entonces devolver fin   ; (JUEGOS, SEH) al programa de Windows
        escribir("\n*** excepción 0: división por cero")
        no_sigue(cs_, eip, 9)
    fin

    interrupción función instrucción_mala()
        variable cs_, eip, m: nat32
        ensamblador
            mov eax, [ebp+32]
            mov {eip}, eax
            mov eax, [ebp+36]
            mov {cs_}, eax
            mov {m}, ebp
        fin
        si a_su_despachador(m, 6, 0, 0, falso) entonces devolver fin   ; (JUEGOS, SEH)
        escribir("\n*** excepción 6: instrucción que no existe")
        no_sigue(cs_, eip, 10)
    fin

    interrupción función excepción()
        variable cs_, eip, m: nat32
        ensamblador
            mov eax, [ebp+32]
            mov {eip}, eax
            mov eax, [ebp+36]
            mov {cs_}, eax
            mov {m}, ebp
        fin
        si a_su_despachador(m, 255, 0, 0, falso) entonces devolver fin   ; (JUEGOS, SEH)
        escribir("\n*** excepción del procesador")
        no_sigue(cs_, eip, 10)
    fin

    interrupción función excepción_con_código(código: nat32)
        variable cs_, eip, m: nat32
        ensamblador
            mov eax, [ebp+36]
            mov {eip}, eax
            mov eax, [ebp+40]
            mov {cs_}, eax
            mov {m}, ebp
        fin
        si a_su_despachador(m, 254, código, 0, cierto) entonces devolver fin   ; (JUEGOS, SEH)
        imprimir1("\n*** excepción del procesador (código %u)", código)
        no_sigue(cs_, eip, 11)
    fin

    interrupción función protección_general(código: nat32)
        variable cs_, eip, m: nat32
        ensamblador
            mov eax, [ebp+36]
            mov {eip}, eax
            mov eax, [ebp+40]
            mov {cs_}, eax
            mov {m}, ebp
        fin
        ; (TERMO) el rdmsr «seguro» de termo.cas: el registro no está; se sigue detrás
        si cs_ yb 3 = 0 y recupera(eip) <> 0 entonces
            eip := recupera(eip)
            ensamblador
                mov eax, {eip}
                mov [ebp+36], eax
            fin
            devolver
        fin
        si a_su_despachador(m, 13, código, 0, cierto) entonces devolver fin   ; (JUEGOS, SEH)
        imprimir1("\n*** excepción 13: protección general (código %u)", código)
        no_sigue(cs_, eip, 13)
    fin

    ; el fallo de página: si es en la zona a la demanda (o en la pila de un
    ; programa, que crece), se le pone un marco y se vuelve a la instrucción,
    ; que ahora sí llega. Si no, se dice dónde ha
    ; sido y por qué (lo dice el código: bit 0, la página estaba pero no deja;
    ; bit 1, escribía; bit 2, desde el anillo 3)
    interrupción función fallo_de_página(código: nat32)
        variable cs_, eip, dir, esp_u: nat32
        variable d: arreglo [4] de nat32
        dir := leer_cr2()
        ensamblador
            mov eax, [ebp+36]
            mov {eip}, eax
            mov eax, [ebp+40]
            mov {cs_}, eax
            mov eax, [ebp+48]
            mov {esp_u}, eax
        fin
        si cs_ yb 0xFFFF = CÓDIGO_WIN32 entonces esp_u := esp_u + BASE_WIN32 fin   ; [WIN32] su pila, con base (win32.cas)
        si código yb 4 = 0 y atender_demanda(dir) entonces devolver fin
        ; un programa cuya pila baja a una página que aún no tiene: se le pone
        si código yb 5 = 4 y atender_pila(actual.cr3, dir, esp_u) entonces devolver fin
        ; (JUEGOS, SEH) un programa de Windows: a su despachador
        ensamblador
            mov {esp_u}, ebp
        fin
        si código yb 4 <> 0 y a_su_despachador(esp_u, 14, código, dir, cierto) entonces devolver fin
        d[0] := dir
        si código yb 2 <> 0 entonces d[1] := nat32("escritura") sino d[1] := nat32("lectura") fin
        si código yb 4 <> 0 entonces d[2] := nat32("anillo 3") sino d[2] := nat32("núcleo") fin
        si código yb 1 <> 0 entonces d[3] := nat32("protección") sino d[3] := nat32("no presente") fin
        imprimir("\n*** excepción 14: fallo de página en 0x%08X (%s, %s, %s)", d)
        no_sigue(cs_, eip, 14)
    fin

    interrupción función irq_perdida()
        sacar_puerto(PIC2, FIN_INT)
        sacar_puerto(PIC1, FIN_INT)
    fin

    función prepara_excepciones()
        variable i: nat32
        para i desde 0 hasta 31 hacer
            según i
                caso 8, 10..14, 17: pon_puerta(i, nat32(dirección(excepción_con_código)), PUERTA_NÚCLEO)
                si no: pon_puerta(i, nat32(dirección(excepción)), PUERTA_NÚCLEO)
            fin
        fin
        pon_puerta(0, nat32(dirección(división_por_cero)), PUERTA_NÚCLEO)
        pon_puerta(6, nat32(dirección(instrucción_mala)), PUERTA_NÚCLEO)
        pon_puerta(13, nat32(dirección(protección_general)), PUERTA_NÚCLEO)
        pon_puerta(14, nat32(dirección(fallo_de_página)), PUERTA_NÚCLEO)
        para i desde 32 hasta 47 hacer
            pon_puerta(i, nat32(dirección(irq_perdida)), PUERTA_NÚCLEO)
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  La línea de órdenes (el teclado está en consola.cas)
    ; -------------------------------------------------------------------------
    función lee_línea()
        variable c: nat32
        largo := 0
        mientras cierto hacer
            c := leer_tecla()
            si c = '\n' entonces
                escribir("\n")
                línea[largo] := 0
                devolver
            sino si c = 8 entonces
                si largo > 0 entonces
                    largo := largo - 1
                    retroceder()
                    escribir(" ")
                    retroceder()
                fin
            sino si c >= ' ' y c < TECLA_ESPECIAL y largo < 79 entonces
                línea[largo] := c
                largo := largo + 1
                escribir_car(c)
            fin
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Las órdenes
    ; -------------------------------------------------------------------------
    función orden_memoria()
        revisar()
        imprimir4("marcos: %u libres de %u (%u K libres de %u K)\n", marcos_libres(), marcos_totales(),
                  marcos_libres() * 4, marcos_totales() * 4)
        imprimir4("montón: %u bloques ocupados con %u octetos, %u huecos; %u páginas debajo\n", ocupados, octetos,
                  huecos, páginas_montón())
        imprimir3("montón: %u reservas, %u liberaciones, %u fallos vistos\n", reservas, liberaciones, errores)
    fin

    función orden_mapa()
        variable i, n: nat32
        variable r: puntero a Región
        variable d: arreglo [4] de nat32
        n := regiones()
        si n = 0 entonces
            imprimir1("el cargador no da el mapa de memoria; dice %u K por encima del primer mega\n", memoria_alta())
            devolver
        fin
        para i desde 0 hasta n - 1 hacer
            r := región(i)
            d[0] := r.base
            d[1] := r.base + r.largo - 1
            d[2] := r.largo div 1024
            si r.clase = 1 entonces d[3] := nat32("libre") sino d[3] := nat32("reservada") fin
            imprimir("0x%08X-0x%08X  %7u K  %s\n", d)
        fin
    fin

    función orden_páginas()
        variable tablas, n, cr0, mt, md: nat32
        variable t2: nat32
        cr0 := leer_cr0()
        si cr0 yb 0x80000000 <> 0 entonces escribir("paginación: activa") sino escribir("paginación: apagada") fin
        imprimir2(" (CR0 = 0x%08X), directorio en 0x%08X\n", cr0, leer_cr3())
        n := cuenta_páginas(directorio_núcleo, 0, (límite - 1) >> 22, tablas)
        imprimir3("  identidad: de 0 a 0x%08X, %u páginas en %u tablas (solo el anillo 0)\n", límite - 1, n, tablas)
        mt := cuenta_páginas(directorio_núcleo, MONTÓN_INICIO >> 22, (MONTÓN_INICIO >> 22) + MONTÓN_TABLAS - 1, t2)
        md := cuenta_páginas(directorio_núcleo, DEMANDA_INICIO >> 22, DEMANDA_INICIO >> 22, t2)
        imprimir3("  montón: %u páginas; a la demanda: %u páginas y %u fallos atendidos\n", mt, md, atendidos)
    fin

    función azar(): nat32
        semilla_azar := semilla_azar * 1103515245 + 12345
        devolver semilla_azar >> 8
    fin

    ; reserva y libera a lo loco, con lo de dentro comprobado, y al final
    ; mira que todo vuelve a estar como antes
    función orden_montón()
        variable k, i, n, malos, marcos0, tam0, ocup0: nat32
        variable p: puntero a byte
        variable d: arreglo [4] de nat32
        revisar()
        marcos0 := marcos_libres()
        tam0 := tamaño_montón()
        ocup0 := ocupados
        malos := 0
        para i desde 0 hasta 63 hacer vivos[i] := nulo fin
        para k desde 1 hasta 3000 hacer
            i := azar() mod 64
            si vivos[i] = nulo entonces
                n := azar() mod 5000 + 1
                p := reservar(n)
                si p = nulo entonces
                    malos := malos + 1
                sino
                    llenar(p, n, byte(i))
                    vivos[i] := p
                    largos[i] := n
                fin
            sino
                si no todo_igual(vivos[i], largos[i], byte(i)) entonces malos := malos + 1 fin
                si no liberar(vivos[i]) entonces malos := malos + 1 fin
                vivos[i] := nulo
            fin
            si k mod 500 = 0 y revisar() <> 0 entonces malos := malos + 1 fin
        fin
        d[0] := 0
        para i desde 0 hasta 63 hacer
            si vivos[i] <> nulo entonces
                d[0] := d[0] + 1
                si no liberar(vivos[i]) entonces malos := malos + 1 fin
                vivos[i] := nulo
            fin
        fin
        si revisar() <> 0 entonces malos := malos + 1 fin
        imprimir2("montón: 3000 vueltas de reservar y liberar (y %u al final), %u fallos\n", d[0], malos)
        d[0] := ocupados - ocup0
        d[1] := tamaño_montón()
        d[2] := tam0
        d[3] := marcos_libres()
        imprimir("montón: quedan %u bloques de más; mide %u octetos (antes %u); %u marcos libres", d)
        imprimir1(" (antes %u)\n", marcos0)
        si malos = 0 y ocupados = ocup0 y tamaño_montón() = tam0 y marcos_libres() = marcos0 entonces
            escribir("montón sin fugas\n")
        sino
            escribir("*** el montón pierde o se estropea\n")
        fin
    fin

    ; estropea el montón a propósito: escribe un octeto más allá de lo pedido,
    ; suelta dos veces y suelta lo que no es de un bloque
    función orden_estropear()
        variable p, q: puntero a byte
        variable e: nat32
        e := errores
        p := reservar(10)
        q := reservar(100)
        p[10] := 'x'
        escribir("escribo un octeto de más y suelto: ", liberar(p), "\n")
        p[10] := 0xCD
        escribir("lo arreglo y suelto: ", liberar(p), "\n")
        escribir("lo suelto otra vez: ", liberar(p), "\n")
        escribir("suelto lo que no es de un bloque: ", liberar(q + 1), "\n")
        escribir("suelto el otro: ", liberar(q), "\n")
        imprimir2("el montón ha visto %u fallos; revisado, %u\n", errores - e, revisar())
    fin

    ; dos tareas que cuentan sin parar (no ceden nunca): si se alternan es
    ; que el reloj les quita el procesador
    función contadora(n: nat32)
        mientras tics < hasta_tic hacer
            cuentas[n] := cuentas[n] + 1
            si última <> n entonces
                alternancias := alternancias + 1
                última := n
            fin
        fin
    fin

    función orden_turnos()
        variable a, b: puntero a Tarea
        variable t0: nat32
        cuentas[0] := 0
        cuentas[1] := 0
        alternancias := 0
        última := 9
        t0 := tics
        hasta_tic := tics + HZ
        a := crear_tarea("contadora-A", nat32(dirección(contadora)), 0)
        b := crear_tarea("contadora-B", nat32(dirección(contadora)), 1)
        si a = nulo o b = nulo entonces
            escribir("no se pueden hacer las tareas\n")
            devolver
        fin
        esperar(a)
        esperar(b)
        imprimir4("turnos: A ha contado %u veces y B %u; se han alternado %u veces en %u tics\n",
                  cuentas[0], cuentas[1], alternancias, tics - t0)
    fin

    función dormilona(n: nat32)
        variable t0: nat32
        t0 := tics
        dormir(n * 20)
        tomar_consola()                         ; la línea entera, sin que se cuele otra tarea
        imprimir3("la dormilona %u se despierta: ha dormido %u tics (pidió %u)\n", n, tics - t0, n * 20)
        soltar_consola()
    fin

    función orden_dormir()
        variable t: arreglo [3] de puntero a Tarea
        variable i: nat32
        ; se hacen en otro orden del que despiertan
        t[0] := crear_tarea("dormilona-3", nat32(dirección(dormilona)), 3)
        t[1] := crear_tarea("dormilona-1", nat32(dirección(dormilona)), 1)
        t[2] := crear_tarea("dormilona-2", nat32(dirección(dormilona)), 2)
        para i desde 0 hasta 2 hacer
            si t[i] <> nulo entonces esperar(t[i]) fin
        fin
        escribir("las tres han acabado\n")
    fin

    ; escribe en la zona a la demanda, donde no hay nada: el fallo de página
    ; le pone un marco, y la escritura llega
    función orden_toca()
        variable v, antes: nat32
        variable p: puntero a nat32
        v := DEMANDA_INICIO + (toques mod 1024) * PÁGINA + 0x123
        toques := toques + 1
        antes := atendidos
        p := puntero(v)
        valor(p) := 0xCAFE0000 + toques
        imprimir3("escribo en 0x%08X (fallos de página atendidos: %u) y leo 0x%08X\n", v, atendidos - antes, valor(p))
        antes := atendidos
        valor(p) := valor(p) + 1
        imprimir2("otra vez (fallos de página atendidos: %u) y leo 0x%08X\n", atendidos - antes, valor(p))
    fin

    función orden_ejecutar()
        variable n, c, antes: nat32
        variable t: puntero a Tarea
        variable nombre: puntero a byte
        si no palabra(línea, 1, palabra1, 40) o no texto_a_natural(palabra1, n) entonces
            escribir("¿qué programa? (ejecutar N; los hay con «programas»)\n")
            devolver
        fin
        si n >= módulos() entonces
            imprimir1("no hay programa %u\n", n)
            devolver
        fin
        antes := marcos_libres()
        tomar_consola()
        t := cargar(n)
        si t = nulo entonces
            soltar_consola()
            devolver
        fin
        nombre := t.nombre
        imprimir2("ejecuto %s (la tarea %u, en el anillo 3)\n", nat32(nombre), t.id)
        soltar_consola()
        c := esperar(t)
        imprimir4("%s ha acabado con el código %u; marcos libres: %u antes y %u después\n", nat32(nombre), c,
                  antes, marcos_libres())
    fin

    ; lanza un programa del disco (con lo que quede de la línea como sus
    ; argumentos) y espera a que acabe
    función lanza(ruta: puntero a byte, args: puntero a byte)
        variable c, e, antes: nat32
        variable t: puntero a Tarea
        variable nombre: arreglo [16] de byte
        antes := marcos_libres()
        ; con la pantalla tomada desde antes de hacer la tarea: lo primero que
        ; escriba el programa espera a que esté dicho que se le lanza
        tomar_consola()
        t := cargar_archivo(ruta, args, e)
        si t = nulo entonces
            soltar_consola()
            imprimir2("no puedo lanzar %s: %s\n", nat32(ruta), nat32(texto_error(e)))
            devolver
        fin
        copiar_hasta(nombre, t.nombre, 16)
        imprimir2("lanzo %s del disco (la tarea %u, en el anillo 3)\n", nat32(dirección(nombre[0])), t.id)
        soltar_consola()
        c := esperar(t)
        recoger_huérfanas()
        tomar_consola()                         ; (puede quedar algún programa escribiendo)
        imprimir4("%s ha acabado con el código %u; marcos libres: %u antes y %u después\n", nat32(dirección(nombre[0])), c,
                  antes, marcos_libres())
        soltar_consola()
    fin

    función orden_lanzar()
        variable args: puntero a byte
        si no palabra(línea, 1, palabra1, 40) entonces
            escribir("¿qué programa? (lanzar NOMBRE.BIN [argumentos]; los hay con «dir»)\n")
            devolver
        fin
        ; los argumentos: lo que va detrás de la segunda palabra
        args := saltar_espacios(línea)
        mientras valor(args) <> 0 y no es_espacio(valor(args)) hacer args := args + 1 fin
        args := saltar_espacios(args)
        mientras valor(args) <> 0 y no es_espacio(valor(args)) hacer args := args + 1 fin
        args := saltar_espacios(args)
        lanza(palabra1, args)
    fin

    ; «quitar W»: quitar con seguridad la memoria USB de la unidad W:
    función orden_quitar()
        si no palabra(línea, 1, palabra1, 40) entonces
            escribir("¿qué unidad? (quitar W: quitar con seguridad la memoria USB de la unidad W:)\n")
            devolver
        fin
        Usbcal.quitar(palabra1[0])
    fin

    ; lo que se dice de cada unidad: su letra, de dónde es y su FAT
    función enseña_unidades()
        variable u, letra: nat32
        variable d: arreglo [4] de nat32
        apunta0("unidades:")
        para letra desde 'A' hasta 'Z' hacer
            u := por_letra(letra)
            si u <> NINGUNA entonces
                d[0] := letra
                si unidades[u].clase = U_MEMORIA entonces
                    apunta(" %c: (en memoria)", d)
                sino si volúmenes[u].iso entonces
                    d[1] := unidades[u].disco
                    d[2] := nat32(nombre_de_clase(discos[unidades[u].disco].clase))
                    apunta(" %c: (disco %u, %s, ISO 9660)", d)          ; (CD)
                sino
                    d[1] := unidades[u].disco
                    d[2] := nat32(nombre_de_clase(discos[unidades[u].disco].clase))
                    d[3] := volúmenes[u].clase
                    apunta(" %c: (disco %u, %s, FAT%u)", d)
                fin
            fin
        fin
        si del_sistema = NINGUNA entonces
            apunta0(" ninguna\n")
        sino
            apunta1("; la del sistema, %c:\n", unidades[del_sistema].letra)
        fin
    fin

    función orden_disco()
        variable u, libres: nat32
        variable d: arreglo [4] de nat32
        para u desde 0 hasta MAX_DISCOS - 1 hacer
            si discos[u].hay y discos[u].clase = DE_CD entonces
                ; (CD) un lector: lo que mide el disco que tiene
                d[0] := u
                d[1] := nat32(dirección(discos[u].modelo[0]))
                d[2] := nat32(nombre_de_vía(discos[u].cuál))
                d[3] := discos[u].sectores
                si d[3] = 0 entonces
                    imprimir("disco %u: %s, lector de CD o DVD (%s), sin disco\n", d)
                sino
                    imprimir("disco %u: %s, lector de CD o DVD (%s), con un disco de %u sectores de 2048\n", d)
                fin
            sino si discos[u].hay entonces
                d[0] := u
                d[1] := nat32(dirección(discos[u].modelo[0]))
                d[2] := discos[u].sectores
                d[3] := discos[u].sectores div 2048
                imprimir("disco %u: %s, %u sectores (%u MB), LBA", d)
                imprimir1(", %s\n", nat32(nombre_de_clase(discos[u].clase)))
            sino si u < 2 entonces
                imprimir1("disco %u: no hay\n", u)
            fin
        fin
        escribir(informe_ahci())
        escribir(informe_sdhci())                       ; (SDHCI)
        u := del_sistema
        si u = NINGUNA o unidades[u].clase <> U_FAT entonces
            escribir("sistema de archivos: no hay (la unidad del sistema no es un disco con FAT)\n")
        sino
            d[0] := volúmenes[u].clase
            d[1] := volúmenes[u].base
            d[2] := volúmenes[u].clusters
            d[3] := volúmenes[u].sectores_cluster * SECTOR
            imprimir("sistema de archivos: FAT%u, desde el sector %u, %u clusters de %u octetos", d)
            libres := clusters_libres(u)
            si libres <> 0xFFFFFFFF entonces imprimir1(", %u libres", libres) fin
            imprimir3("\nsectores leídos: %u, escritos: %u; archivos abiertos: %u\n", Discos.sectores_leídos(), Discos.sectores_escritos(), cuántos_abiertos())
        fin
        enseña_unidades()
    fin

    ; las entradas de una carpeta del disco (la raíz, si no se dice otra)
    función orden_dir()
        variable m, r, n: nat32
        variable e: Entrada
        palabra(línea, 1, palabra1, 40)
        m := abrir_archivo(del_sistema, palabra1, PARA_LEER)
        si m >= PRIMER_ERROR entonces
            imprimir2("no puedo abrir «%s»: %s\n", nat32(dirección(palabra1[0])), nat32(texto_error(m)))
            devolver
        fin
        si no es_carpeta(m) entonces
            imprimir2("%s es un archivo de %u octetos\n", nat32(dirección(palabra1[0])), tamaño_archivo(m))
            cerrar_archivo(m)
            devolver
        fin
        n := 0
        r := leer_entrada(m, dirección(e))
        mientras r = 1 hacer
            si e.atributos yb CARPETA <> 0 entonces
                imprimir1("%-12s  <carpeta>\n", nat32(dirección(e.nombre[0])))
            sino
                imprimir2("%-12s  %9u\n", nat32(dirección(e.nombre[0])), e.tamaño)
            fin
            n := n + 1
            r := leer_entrada(m, dirección(e))
        fin
        cerrar_archivo(m)
        si r <> 0 entonces escribir("*** el disco falla\n") fin
        imprimir1("%u entradas\n", n)
    fin

    función es(t: puntero a byte): bool
        devolver iguales(línea, t)
    fin

    ; lo que va detrás de «nombre» en la línea del cargador (su primera
    ; letra), o 0 si no está: «unidad=X» da 'X'
    función opción(nombre: puntero a byte): nat32
        variable p: puntero a byte
        p := buscar(línea_del_cargador(), nombre)
        si p = nulo entonces devolver 0 fin
        devolver p[longitud(nombre)]
    fin

    ; lo apuntado en el registro del arranque, a ARRANQUE.TXT, en la unidad
    ; del sistema
    función guarda_registro()
        variable m: nat32
        m := abrir_archivo(del_sistema, "\\ARRANQUE.TXT", PARA_CREAR)
        si m < PRIMER_ERROR entonces
            escribir_archivo(m, registro, registro_largo)
            cerrar_archivo(m)
        fin
    fin

    ; una tarea que, al medio minuto de arrancar, apunta cómo van los
    ; teclados y los ratones USB (si llegan sus informes) y lo guarda
    ; (TERMO) y, los dos primeros minutos, cada segundo que haya algo nuevo:
    ; si el equipo se queda congelado (el Acer One 10), la última línea de
    ; ARRANQUE.TXT dice hasta dónde llegó
    función registro_luego(nada: nat32)
        variable s, visto: nat32
        visto := registro_largo
        s := 0
        mientras s < 120 hacer
            dormir(HZ)
            s := s + 1
            si s = 30 y teclados + ratones + I2c.cuántas <> 0 entonces
                Usbhid.enseña_estado()
                I2chid.enseña_estado()          ; (I2CHID)
            fin
            si registro_largo <> visto entonces
                visto := registro_largo
                guarda_registro()
            fin
        fin
    fin

    ; los discos y las unidades: los de dentro (IDE y SATA), las memorias
    ; USB y lo que haya traído el cargador. Dice lo que encuentra.
    función busca_discos()
        variable d, u, n, pedida: nat32
        variable dd: arreglo [6] de nat32
        ; en los discos solo se escribe si el cargador lo dice: «escritura»
        ; (en todos) o «escritura=usb» (solo en las memorias USB). En un PC
        ; de verdad, el disco es el del dueño.
        ; («instalar»: para instalar el sistema en el disco de dentro, al
        ; revés: solo en los de dentro, y la memoria USB de arranque no se toca)
        si buscar(línea_del_cargador(), "instalar") <> nulo entonces
            permiso(PERMISO_INTERNOS)
            instalando := cierto
            sin_segundos := cierto
        sino si buscar(línea_del_cargador(), "escritura=usb") <> nulo entonces
            permiso(PERMISO_USB)
        sino si buscar(línea_del_cargador(), "escritura") <> nulo entonces
            permiso(PERMISO_TODOS)
        fin
        ; con «sindisco», ni se miran los discos de dentro del PC
        si buscar(línea_del_cargador(), "sindisco") = nulo entonces busca_internos() fin
        ; el USB: las controladoras, lo que hay enchufado, los teclados y
        ; ratones y las memorias (con «sinusb», se queda como lo dejó la BIOS)
        si buscar(línea_del_cargador(), "sinusb") = nulo entonces
            Usb.prepara()
            si controladoras <> 0 entonces
                Usb.enseña()
                Usbhid.prepara()
                enseña_descriptor()
                si Usbalm.prepara() <> 0 entonces busca_usb() fin
                ; («1 ratón», «2 ratones»: en singular o en plural)
                dd[0] := teclados
                si teclados = 1 entonces dd[1] := nat32("teclado") sino dd[1] := nat32("teclados") fin
                dd[2] := ratones
                si ratones = 1 entonces dd[3] := nat32("ratón") sino dd[3] := nat32("ratones") fin
                dd[4] := Usbalm.cuántas
                si Usbalm.cuántas = 1 entonces dd[5] := nat32("memoria") sino dd[5] := nat32("memorias") fin
                apunta("usb: %u %s, %u %s, %u %s.\n", dd)
                ; y lo que se enchufe y se desenchufe a partir de ahora
                Usbcal.prepara()
            fin
        fin
        ; (I2CHID) las controladoras I2C (Intel LPSS): de ellas cuelgan los
        ; touchpads HID sobre I2C, que dice luego ACPI.BIN (i2chid.cas); con
        ; «sini2c», no se tocan
        I2c.prepara()
        ; (CD) los lectores de CD y DVD (detrás de los discos y las memorias)
        si buscar(línea_del_cargador(), "sindisco") = nulo entonces busca_cd() fin
        n := 0
        para d desde 0 hasta MAX_DISCOS - 1 hacer
            si discos[d].hay y discos[d].clase = DE_CD entonces
                ; (CD) un lector de CD o DVD: su letra (y su disco, luego)
                monta_disco(d)
                dd[0] := d
                dd[1] := nat32(dirección(discos[d].modelo[0]))
                dd[2] := nat32(nombre_de_vía(discos[d].cuál))
                apunta("disco %u: %s, lector de CD o DVD (%s).\n", dd)
            sino si discos[d].hay entonces
                monta_disco(d)
                dd[0] := d
                dd[1] := nat32(dirección(discos[d].modelo[0]))
                dd[2] := discos[d].sectores div 2048
                apunta("disco %u: %s, %u MB", dd)
                si unidades_de(d) = 0 entonces apunta0(", sin FAT") fin
                para u desde 0 hasta MAX_UNIDADES - 1 hacer
                    si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces
                        apunta1(", FAT%u", volúmenes[u].clase)
                        si no escribible(u) entonces n := n + 1 fin
                    fin
                fin
                si discos[d].clase <> DE_ATA entonces apunta1(" (%s)", nat32(nombre_de_clase(discos[d].clase))) fin
                apunta0(".\n")
            fin
        fin
        si n <> 0 entonces
            si permiso_dado() = PERMISO_USB entonces
                escribir("los discos de dentro son de solo lectura (para escribir en ellos: «escritura» en la línea del cargador).\n")
            sino
                escribir("el disco es de solo lectura (para escribir en él: «escritura» en la línea del cargador).\n")
            fin
        fin
        prepara_cd()                                    ; (CD) los discos de los lectores, y la tarea que los mira
        arranque_a_x()
        monta_memoria()
        pedida := 0
        si buscar(línea_del_cargador(), "unidad=") <> nulo entonces pedida := opción("unidad=") fin
        elige_sistema(pedida)
        ; (SDHCI) las controladoras SD/eMMC de «modo ACPI» que ACPI.BIN dijo en
        ; otro arranque en este equipo (\SDHCI.TXT): sdacpi.cas
        si buscar(línea_del_cargador(), "sindisco") = nulo entonces Sdacpi.recuerda() fin
        si unidad_en_memoria() entonces
            imprimir1("sin disco: los %u archivos que ha traído el cargador hacen de unidad M: (en memoria, de solo lectura).\n", módulos())
        fin
        ; (0.8.10, el Acer One 10 instalado en el eMMC) arrancado de un disco
        ; que luego no se ve: lo más fácil es un eMMC o una SD de «modo ACPI»
        si unidad_en_memoria() y arrancado_por_uefi() y buscar(línea_del_cargador(), "sindisco") = nulo entonces
            escribir("arranque: no se ve ningún disco. Si el sistema está en el eMMC o en una tarjeta SD de una tableta (Bay Trail), el núcleo solo los ve por ACPI: arranque una vez con ACPI, o desde la memoria USB con \\SDHCI.TXT, o ponga «sdhci=...» en la línea del cargador (la dice \\SDHCI.TXT).\n")
        fin
        n := 0
        para u desde 0 hasta MAX_UNIDADES - 1 hacer
            si unidades[u].hay entonces n := n + 1 fin
        fin
        si n > 1 entonces enseña_unidades() fin
        ; con «registro», lo dicho hasta aquí queda en ARRANQUE.TXT, en la
        ; unidad del sistema (si se puede escribir en ella)
        si buscar(línea_del_cargador(), "registro") <> nulo y del_sistema <> NINGUNA entonces
            si escribible(del_sistema) y tiene_sistema(del_sistema) entonces
                guarda_registro()
                ; y, al medio minuto, otra vez, con cómo van el teclado y el ratón
                crear_tarea("registro", nat32(dirección(registro_luego)), 0)
            fin
        fin
    fin

    ; el servicio de ACPI (ACPI.BIN, energia.cas): apagar de verdad y la
    ; batería. Si no está en la unidad del sistema, no pasa nada: se apaga
    ; como antes. Se le da la línea del cargador: con «registro», el suyo va
    ; a \ACPI.TXT; «acpicada=N», una lectura cada N segundos (10 si no).
    ; (0.8.10, el Acer One 10) Bloq Num empieza apagado, como en Windows: el
    ; firmware lo deja encendido y los teclados sin teclado numérico aparte
    ; (el del dock, USB 06CB:2968) dan 4 5 6 1 2 3 0 en U I O J K L M. Lo
    ; que dejó la BIOS (el bit 5 de 0x417) se recuerda para «como lo dejó el
    ; firmware» del Panel de control (Teclado); por UEFI no se sabe. Al 8042,
    ; la orden EDh (salvo «sin8042»); los USB, al ponerse en marcha
    ; (usbhid.cas: SET_REPORT de las luces)
    función bloq_num_al_arrancar()
        variable p: puntero a byte
        Consola.sin_8042 := buscar(línea_del_cargador(), "sin8042") <> nulo
        si no arrancado_por_uefi() entonces
            p := puntero(0x417)
            Consola.num_firmware := p[0] yb 0x20 <> 0
            si Consola.num_firmware entonces
                apunta0("teclado: la BIOS deja Bloq Num encendido: se apaga (Panel de control > Teclado)\n")
            sino
                apunta0("teclado: la BIOS deja Bloq Num apagado\n")
            fin
        sino
            apunta0("teclado: por UEFI no se sabe cómo deja el firmware Bloq Num: se apaga (Panel de control > Teclado)\n")
        fin
        pon_bloq_num(falso)
    fin

    ; (UEFI) la primera línea del registro del arranque: por dónde ha
    ; arrancado (UEFI de 64 o 32 bits, o la BIOS/CSM), con qué pantalla, y la
    ; línea del cargador (que dice qué entrada del menú de GRUB se eligió)
    función apunta_arranque()
        variable base, fila, an, al, bits: nat32
        variable de64, hay: bool
        variable d: arreglo [4] de nat32
        hay := pantalla_del_cargador(base, fila, an, al, bits)
        d[1] := an
        d[2] := al
        si arrancado_por_uefi() entonces
            tabla_efi(de64)
            d[0] := 32
            si de64 entonces d[0] := 64 fin
            ; (la del GOP aunque esté por encima de 4 GB: aquí aún no se ha
            ; puesto a la vista, y pantalla_del_cargador no la daría)
            si no hay y medida_del_cargador(an, al, bits) entonces
                hay := cierto
                d[1] := an
                d[2] := al
            fin
            si hay entonces formatear(modo_arranque, 64, "por UEFI (%u bits, GOP %u x %u)", d) sino formatear(modo_arranque, 64, "por UEFI (%u bits, sin pantalla)", d) fin
        sino si mb2() entonces
            Textos32.copiar(modo_arranque, "por multiboot2 (sin UEFI)")
        sino si hay entonces
            d[0] := an
            d[1] := al
            formatear(modo_arranque, 64, "por la BIOS/CSM (VBE %u x %u)", d)
        sino
            Textos32.copiar(modo_arranque, "por la BIOS/CSM (modo texto)")
        fin
        d[0] := nat32(dirección(modo_arranque[0]))
        d[1] := nat32(línea_del_cargador())
        apunta("arranque: %s; la línea del cargador: %s\n", d)
        ; (TERMO) el paso de línea de la pantalla (el Acer One 10: las frases
        ; salían unas encima de otras): lo que da el cargador
        si hay entonces
            d[0] := fila
            d[1] := an
            d[2] := al
            d[3] := bits
            apunta("arranque: la pantalla del cargador: %u octetos por línea, %u x %u, %u bits\n", d)
        fin
    fin

    ; (MWAIT, 0.8.9) ¿«mwait» en el reposo, con la pista más honda? Solo si
    ; no hay nada que lo haga peligroso:
    ;  - Intel (en AMD, «mwait» es C1, lo mismo que «hlt»);
    ;  - no un Atom (Bay Trail se cuelga con C6: el Acer One 10, el Medion;
    ;    los N455 del HP Mini y el Toshiba, por si acaso tampoco);
    ;  - MONITOR/MWAIT (cpuid 1, ECX 3) y sus pistas (cpuid 5, ECX 0);
    ;  - ARAT (cpuid 6, EAX 2: el temporizador del APIC local no se para en
    ;    C3 y más hondo; el tic puede ser suyo, relojhpet.cas) y el TSC
    ;    invariante (80000007h, EDX 8: lo usan el Termómetro y los tiempos);
    ;  - no en una máquina virtual (el bit 31 de cpuid 1, ECX: VirtualBox
    ;    puede tratar «mwait» como «nop» y gastar el procesador de verdad).
    ; La pista: el C más hondo con subestados en cpuid 5, EDX (de 4 en 4
    ; bits: C0, C1, C2...): ((C - 1) << 4) + (subestados - 1). Si el
    ; firmware no deja tanto, el procesador lo rebaja solo.
    ; «ocioso=hlt» en la línea del cargador: siempre «hlt»; «ocioso=mwait»
    ; (las pruebas, en QEMU): «mwait» aunque no se cumpla lo de arriba
    ; (con la pista de cpuid 5 si la hay; si no, 0, C1).
    variable rc: arreglo [4] de nat32
    función cpuid_s(hoja: nat32, sub: nat32)
        ensamblador
            push ebx
            mov eax, {hoja}
            mov ecx, {sub}
            db 0x0F, 0xA2               ; cpuid
            mov {rc}, eax
            mov {rc+4}, ebx
            mov {rc+8}, ecx
            mov {rc+12}, edx
            pop ebx
        fin
    fin

    ; los Atom (Bonnell, Saltwell, Silvermont, Airmont, Goldmont, Tremont...)
    función es_atom(m: nat32): bool
        variable lista: arreglo [20] de nat32
        variable i: nat32
        lista[0] := 0x1C
        lista[1] := 0x26
        lista[2] := 0x27
        lista[3] := 0x35
        lista[4] := 0x36
        lista[5] := 0x37
        lista[6] := 0x4A
        lista[7] := 0x4C
        lista[8] := 0x4D
        lista[9] := 0x5A
        lista[10] := 0x5D
        lista[11] := 0x5C
        lista[12] := 0x5F
        lista[13] := 0x7A
        lista[14] := 0x86
        lista[15] := 0x96
        lista[16] := 0x9C
        lista[17] := 0xBE
        lista[18] := 0xAF
        lista[19] := 0xB6
        para i desde 0 hasta 19 hacer
            si lista[i] = m entonces devolver cierto fin
        fin
        devolver falso
    fin

    función mira_reposo()
        variable máx, fam, modelo, ecx1, edx5, ecx5, c, n, sub, pista: nat32
        variable intel, atom, arat, tsc_inv, virtual, forzado: bool
        variable por: puntero a byte
        si buscar(línea_del_cargador(), "ocioso=hlt") <> nulo entonces
            apunta0("reposo: hlt (lo dice la línea del cargador: ocioso=hlt)\n")
            devolver
        fin
        forzado := buscar(línea_del_cargador(), "ocioso=mwait") <> nulo
        cpuid_s(0, 0)
        máx := rc[0]
        intel := rc[1] = 0x756E6547 y rc[3] = 0x49656E69 y rc[2] = 0x6C65746E
        cpuid_s(1, 0)
        ecx1 := rc[2]
        fam := (rc[0] >> 8) yb 0xF
        modelo := (rc[0] >> 4) yb 0xF
        si fam = 6 o fam = 15 entonces modelo := modelo + (((rc[0] >> 16) yb 0xF) << 4) fin
        atom := fam = 6 y es_atom(modelo)
        virtual := (ecx1 >> 31) = 1
        arat := falso
        si máx >= 6 entonces
            cpuid_s(6, 0)
            arat := (rc[0] yb 4) <> 0
        fin
        cpuid_s(0x80000000, 0)
        tsc_inv := falso
        si rc[0] >= 0x80000007 entonces
            cpuid_s(0x80000007, 0)
            tsc_inv := (rc[3] yb 0x100) <> 0
        fin
        pista := 0
        edx5 := 0
        ecx5 := 0
        si máx >= 5 y (ecx1 yb 8) <> 0 entonces
            cpuid_s(5, 0)
            ecx5 := rc[2]
            edx5 := rc[3]
            si (ecx5 yb 1) <> 0 entonces
                c := 7
                mientras c >= 1 hacer
                    sub := (edx5 >> (c * 4)) yb 0xF
                    si sub <> 0 entonces
                        pista := ((c - 1) << 4) + (sub - 1)
                        c := 0
                    sino
                        c := c - 1
                    fin
                fin
            fin
        fin
        por := nulo
        si (ecx1 yb 8) = 0 entonces por := "sin MONITOR/MWAIT"
        sino si no intel entonces por := "no es Intel"
        sino si atom entonces por := "un Atom"
        sino si virtual entonces por := "una máquina virtual"
        sino si máx < 5 o (ecx5 yb 1) = 0 entonces por := "sin las pistas de cpuid 5"
        sino si no arat entonces por := "sin ARAT (el APIC local se pararía)"
        sino si no tsc_inv entonces por := "sin TSC invariante"
        sino si pista < 0x10 entonces por := "solo C1 (lo mismo que hlt)"
        fin
        si por <> nulo y no (forzado y (ecx1 yb 8) <> 0) entonces
            apunta3("reposo: hlt (%s; familia %u, modelo %02Xh)\n", nat32(por), fam, modelo)
            devolver
        fin
        pon_mwait(pista)
        si por <> nulo entonces
            apunta2("reposo: mwait con la pista %02Xh (C%u), FORZADO (ocioso=mwait)\n", pista, (pista >> 4) + 1)
        sino
            apunta3("reposo: mwait con la pista %02Xh (C%u; cpuid 5, EDX = %08Xh)\n", pista, (pista >> 4) + 1, edx5)
        fin
    fin

    ; (PSTATE, 0.8.9) el estado P del procesador: Hispa-Pentium no lo ponía
    ; nunca, y se quedaba el que dejara el firmware; en la Medion S2217 (Atom
    ; Z3735F, Bay Trail, por UEFI de 32 bits) eran 499 MHz todo el rato, en
    ; reposo y con carga (la nominal es 1,33 GHz). Al arrancar se pide la
    ; nominal máxima (sin turbo: con la nominal pedida el turbo lo da el
    ; procesador solo si puede), como Linux (intel_pstate), solo donde se sabe
    ; hacer bien:
    ;  - Intel con SpeedStep (cpuid 1, ECX 7) encendido por el firmware
    ;    (IA32_MISC_ENABLE, 1A0h, bit 16) y sin HWP puesto (IA32_PM_ENABLE,
    ;    770h, bit 0: entonces manda el procesador y PERF_CTL no vale);
    ;  - Core de Nehalem en adelante (modelo 1Ah o más, no Atom): la nominal
    ;    de MSR_PLATFORM_INFO (CEh, bits 15:8), a IA32_PERF_CTL (199h) bits
    ;    15:8 (core_get_val de intel_pstate);
    ;  - Silvermont (Bay Trail, 37h) y Airmont (Cherry Trail/Braswell, 4Ch):
    ;    la máxima de 66Ah (bits 22:16) con su voltaje, el más alto de 66Bh
    ;    (bits 22:16), en PERF_CTL bits 15:8 y 6:0 (atom_get_val de
    ;    intel_pstate con la máxima: el voltaje es justo el «máximo»);
    ;  - los demás (Atom viejos como el N455, AMD, máquinas virtuales sin
    ;    SpeedStep), nada: lo dice y se queda la del firmware.
    ; Cada lectura y escritura, con wrmsr_seguro/rdmsr_seguro (termo.cas): un
    ; #GP no para el núcleo. Con valores raros (ratio < 4 o > 60, voltaje 0 o
    ; al revés), nada. «sinpstate» en la línea del cargador lo quita. Solo el
    ; procesador del sistema (el BSP): en estos Intel los núcleos van a la
    ; misma frecuencia y manda la petición más alta; los AP que despierta el
    ; Termómetro no piden nada (pendiente: que pidan lo mismo).
    ; El registro dice «procesador: frecuencia puesta a X MHz (de Y)».
    función bus_silvermont(): nat32             ; MHz x 10 (MSR_FSB_FREQ, CDh)
        si no Termo.rdmsr_seguro(0xCD) entonces devolver 833 fin
        según Termo.msr_lo yb 7
            caso 0: devolver 833
            caso 1: devolver 1000
            caso 2: devolver 1333
            caso 3: devolver 1167
            caso 4: devolver 800
        fin
        devolver 833
    fin

    función mira_pstate()
        variable fam, modelo, ecx1, antes, nueva, vid, bus, lo, hi: nat32
        variable silver: bool
        si buscar(línea_del_cargador(), "sinpstate") <> nulo entonces
            apunta0("procesador: el estado P, el del firmware (lo dice la línea del cargador: sinpstate)\n")
            devolver
        fin
        cpuid_s(0, 0)
        si no (rc[1] = 0x756E6547 y rc[3] = 0x49656E69 y rc[2] = 0x6C65746E) y buscar(línea_del_cargador(), "pstate=prueba") = nulo entonces
            apunta0("procesador: no es Intel; la frecuencia, la del firmware\n")
            devolver
        fin
        cpuid_s(1, 0)
        ecx1 := rc[2]
        fam := (rc[0] >> 8) yb 0xF
        modelo := ((rc[0] >> 4) yb 0xF) + (((rc[0] >> 16) yb 0xF) << 4)
        ; «pstate=prueba» (solo QEMU, las pruebas): como si fuera un Core con
        ; SpeedStep, para pasar por las lecturas y escrituras (y sus #GP)
        si buscar(línea_del_cargador(), "pstate=prueba") <> nulo entonces
            fam := 6
            modelo := 0x3A
            ecx1 := ecx1 ob 0x80
        fin
        si fam <> 6 o (ecx1 yb 0x80) = 0 entonces
            apunta2("procesador: sin SpeedStep (familia %u, modelo %02Xh); la frecuencia, la del firmware\n", fam, modelo)
            devolver
        fin
        silver := modelo = 0x37 o modelo = 0x4C
        si no silver y (modelo < 0x1A o es_atom(modelo)) entonces
            apunta1("procesador: modelo %02Xh: no sé ponerle el estado P; la frecuencia, la del firmware\n", modelo)
            devolver
        fin
        si (no Termo.rdmsr_seguro(0x1A0) o (Termo.msr_lo yb 0x10000) = 0) y buscar(línea_del_cargador(), "pstate=prueba") = nulo entonces
            apunta0("procesador: el firmware tiene apagado SpeedStep (1A0h, bit 16); la frecuencia, la suya\n")
            devolver
        fin
        si Termo.rdmsr_seguro(0x770) y (Termo.msr_lo yb 1) <> 0 entonces
            apunta0("procesador: con HWP encendido (770h): la frecuencia la lleva el procesador\n")
            devolver
        fin
        si silver entonces bus := bus_silvermont() sino bus := 1000 fin
        si modelo = 0x1A o modelo = 0x1E o modelo = 0x1F o modelo = 0x25 o modelo = 0x2C o modelo = 0x2E o modelo = 0x2F entonces bus := 1333 fin
        antes := 0
        si Termo.rdmsr_seguro(0x198) entonces antes := (Termo.msr_lo >> 8) yb 0xFF fin
        vid := 0
        si silver entonces
            si no Termo.rdmsr_seguro(0x66A) entonces
                apunta0("procesador: no se deja leer 66Ah; la frecuencia, la del firmware\n")
                devolver
            fin
            nueva := (Termo.msr_lo >> 16) yb 0x7F
            si no Termo.rdmsr_seguro(0x66B) entonces
                apunta0("procesador: no se deja leer 66Bh; la frecuencia, la del firmware\n")
                devolver
            fin
            vid := (Termo.msr_lo >> 16) yb 0x7F
            si vid = 0 o vid < ((Termo.msr_lo >> 8) yb 0x7F) entonces
                apunta1("procesador: el voltaje de 66Bh no es creíble (%08Xh); la frecuencia, la del firmware\n", Termo.msr_lo)
                devolver
            fin
        sino
            si no Termo.rdmsr_seguro(0xCE) entonces
                apunta0("procesador: no se deja leer CEh; la frecuencia, la del firmware\n")
                devolver
            fin
            nueva := (Termo.msr_lo >> 8) yb 0xFF
        fin
        si nueva = 0 y buscar(línea_del_cargador(), "pstate=prueba") <> nulo entonces nueva := 16 fin   ; (QEMU da 0)
        si nueva < 4 o nueva > 60 entonces
            apunta1("procesador: la nominal leída no es creíble (%u); la frecuencia, la del firmware\n", nueva)
            devolver
        fin
        si no Termo.rdmsr_seguro(0x199) entonces
            apunta0("procesador: no se deja leer 199h; la frecuencia, la del firmware\n")
            devolver
        fin
        lo := (Termo.msr_lo yb 0xFFFF0000) ob (nueva << 8)
        si silver entonces lo := (lo yb 0xFFFFFF80) ob vid fin
        hi := Termo.msr_hi yb 0xFFFFFFFE           ; el bit 32 (sin turbo), apagado: el turbo, si puede
        si no Termo.wrmsr_seguro(0x199, lo, hi) entonces
            apunta0("procesador: no se deja escribir 199h; la frecuencia, la del firmware\n")
            devolver
        fin
        apunta3("procesador: frecuencia puesta a %u MHz (de %u; ratio %u)\n", (nueva * bus + 5) div 10, (antes * bus + 5) div 10, nueva)
    fin

    ; (UEFI) el SMBIOS (lo que dice el equipo de sí mismo: el fabricante, el
    ; modelo, la placa, la BIOS) no está en F0000h-FFFFFh sin BIOS: está en la
    ; tabla de configuración de la tabla del sistema de EFI, con su GUID (el
    ; de SMBIOS 3, F2FD1544-..., o el de SMBIOS 2, EB9D2D31-...). Da la
    ; dirección física de su punto de entrada («_SM3_» o «_SM_»), o 0.
    función smbios_uefi(): nat32
        variable st, n, ct, salto, i, d3, d2: nat32
        variable de64: bool
        variable v, g: puntero a nat32
        st := tabla_efi(de64)
        si st = 0 entonces devolver 0 fin
        v := puntero(mapear_aparato(st, 128))
        si v = nulo entonces devolver 0 fin
        si de64 entonces
            n := v[26]
            si v[27] <> 0 o v[29] <> 0 entonces devolver 0 fin
            ct := v[28]
            salto := 24
        sino
            n := v[16]
            ct := v[17]
            salto := 20
        fin
        si n = 0 o n > 64 o ct = 0 entonces devolver 0 fin
        g := puntero(mapear_aparato(ct, n * salto))
        si g = nulo entonces devolver 0 fin
        d3 := 0
        d2 := 0
        para i desde 0 hasta n - 1 hacer
            v := puntero(nat32(g) + i * salto)
            si no de64 o v[5] = 0 entonces              ; (no por encima de 4 GB)
                si v[0] = 0xF2FD1544 y v[1] = 0x4A2C9794 y v[2] = 0xBBE52E99 y v[3] = 0x94E320CF entonces d3 := v[4] fin
                si v[0] = 0xEB9D2D31 y v[1] = 0x11D32D88 y v[2] = 0x9000169A y v[3] = 0x4DC13F27 entonces d2 := v[4] fin
            fin
        fin
        ; (TERMO) si la tabla del SMBIOS 3 está por encima de 4 GB (su punto
        ; de entrada «_SM3_» da 64 bits: +10h la dirección, +14h la parte
        ; alta), ACPI.BIN no la alcanza: entonces, la del SMBIOS 2 si la hay
        si d3 <> 0 y d2 <> 0 entonces
            v := puntero(mapear_aparato(d3, 32))
            si v <> nulo y v[5] <> 0 entonces devolver d2 fin
        fin
        si d3 <> 0 entonces devolver d3 fin
        devolver d2
    fin

    función arranca_acpi()
        variable t: puntero a Tarea
        variable e, sm: nat32
        variable línea: arreglo [600] de byte
        variable d: arreglo [3] de nat32
        ; (UEFI) sin BIOS, la RSDP no está en su zona: la que ha copiado GRUB
        ; (su dirección física), detrás de lo que dice el cargador; y el
        ; SMBIOS, el de la tabla del sistema de EFI
        si rsdp() <> 0 entonces
            sm := smbios_uefi()
            d[0] := nat32(línea_del_cargador())
            d[1] := rsdp()
            d[2] := sm
            si sm <> 0 entonces
                formatear(línea, 600, "%s rsdp=%08X smbios=%08X", d)
                imprimir1("uefi: el SMBIOS, en 0x%08X (de la tabla del sistema de EFI)\n", sm)
            sino
                formatear(línea, 600, "%s rsdp=%08X", d)
                escribir("uefi: la tabla del sistema de EFI no dice dónde está el SMBIOS\n")
            fin
            t := cargar_servicio("ACPI.BIN", línea, e)
        sino
            t := cargar_servicio("ACPI.BIN", línea_del_cargador(), e)      ; (PROTEGE) de la carpeta del sistema
        fin
        si t = nulo entonces devolver fin
        pon_servicio_acpi(t)
        imprimir1("acpi: el servicio de ACPI (ACPI.BIN) en marcha, la tarea %u\n", t.id)
    fin

    función principal(): byte
        variable malo: puntero a nat32
        variable pse: puntero a nat32           ; (UEFI) pruebapse36
        prepara_gdt()
        prepara_excepciones()
        prepara_pic()
        prepara_reloj()
        carga_idt()
        escribir("Hispa-Pentium (semilla), un núcleo de 32 bits escrito en Castel\n")
        apunta_arranque()                       ; (UEFI) la primera línea del registro: por dónde ha arrancado
        prepara_marcos(nat32(fin_programa()))
        si límite = 0 entonces
            escribir("*** el cargador no dice cuánta memoria hay. El núcleo se para.\n")
            devolver 12
        fin
        si no prepara_paginación(límite) entonces
            escribir("*** no se puede encender la paginación. El núcleo se para.\n")
            devolver 12
        fin
        prepara_tareas()
        prepara_texto_uefi()                    ; (UEFI) sin modo de texto: la consola, en la pantalla del firmware
        prepara_consola()
        prepara_usuario()
        prepara_escritorio()
        permitir_interrupciones()
        bloq_num_al_arrancar()                  ; (0.8.10) Bloq Num, apagado
        pinta_ahora()                           ; (UEFI) lo dicho hasta aquí, ya en la pantalla
        mira_reloj()                            ; (UEFI) ¿cuenta el 8254? Si no, el HPET (relojhpet.cas)
        mira_reposo()                           ; (MWAIT) «hlt» o «mwait» en la tarea ociosa
        mira_pstate()                           ; (PSTATE) la frecuencia nominal del procesador
        pinta_ahora()
        imprimir3("memoria: %u MB, %u marcos libres; paginación activa; %u programas de usuario.\n",
                  (límite + 0xFFFFF) div 0x100000, marcos_libres(), módulos())
        busca_discos()
        pinta_ahora()                           ; (UEFI)
        ; (UEFI, para las pruebas) «pruebapse36»: lo de poner a la vista la
        ; pantalla de por encima de 4 GB, con la RAM de 4 GB (QEMU -m 5G):
        ; se escribe CAFEBABE en 0x100001234 y la prueba lo mira desde fuera
        si buscar(línea_del_cargador(), "pruebapse36") <> nulo y no arrancado_por_uefi() entonces
            mapea_alta(1, 0)
            pse := puntero(GRÁFICOS_INICIO + 0x1234)
            valor(pse) := 0xCAFEBABE
            imprimir1("pse36: escrito 0x%08X en 0x100001234 (por una página de 4 MB)\n", valor(pse))
        fin
        ; si el cargador lo pide («ordenes» en su línea), el intérprete de
        ; órdenes del anillo 3, ya
        ; un sistema instalado en el disco: sus ajustes (\\HISPA\\HISPA.INI: el
        ; teclado, el nombre del usuario); lo que diga el cargador manda
        lee_ajustes()
        arranca_cuentas()                       ; (USUARIOS) los usuarios y la semilla del azar
        si buscar(línea_del_cargador(), "teclado=us") <> nulo entonces pon_teclado(falso) fin
        si buscar(línea_del_cargador(), "sinacpi") = nulo y buscar(línea_del_cargador(), "instalar") = nulo entonces
            apunta0("arranque: paso: el servicio de ACPI (ACPI.BIN; su registro, en \\ACPI.TXT y lo que escribe en el equipo, en \\ACPIESC.TXT)\n")     ; (TERMO)
            arranca_acpi()
        fin
        ; o el escritorio (el entorno gráfico): esta consola se queda esperando
        ; (las teclas son de las ventanas; lo que diga el núcleo sale por el
        ; puerto serie)
        ; la red (el servicio de red, RED.BIN: red.cas): con «sinred», nunca;
        ; con «conred», ya; con el escritorio, ya si hay una tarjeta de red
        ; (por el icono de la bandeja); si no, cuando un programa la pida
        ; (SONIDO) con «sinsonido», el servicio de sonido no se pone nunca
        si buscar(línea_del_cargador(), "sinsonido") <> nulo entonces sin_sonido := cierto fin
        si buscar(línea_del_cargador(), "sinred") <> nulo entonces
            apagada := cierto
        sino si buscar(línea_del_cargador(), "conred") <> nulo entonces
            lanza_red()
        sino si buscar(línea_del_cargador(), "escritorio") <> nulo y buscar(línea_del_cargador(), "instalar") = nulo y pci_busca(0x020000, 0xFF0000, NO_HAY_PCI) <> NO_HAY_PCI entonces
            lanza_red()
        fin
        si buscar(línea_del_cargador(), "instalar") <> nulo entonces
            ; el programa que instala el sistema en el disco duro (la
            ; pantalla es suya: esta consola espera a que acabe)
            lanza("INSTALAR.BIN", nulo)
        sino si buscar(línea_del_cargador(), "escritorio") <> nulo entonces
            apunta0("arranque: paso: el escritorio\n")      ; (TERMO)
            arranca()
        sino si buscar(línea_del_cargador(), "ordenes") <> nulo entonces
            ordenes_de_usuario(cierto)          ; (USUARIOS) del que entre
        fin
        escribir("Escriba «ayuda».\n")
        mientras cierto hacer
            recoger_huérfanas()
            ; (USUARIOS) con usuarios, esta consola es para un administrador
            ; (y la del escritorio no se alcanza: las teclas son de las ventanas)
            si hay_cuentas y no escritorio_en_marcha y (sesión = 0 o no es_admin_uid(sesión)) entonces
                si sesión = 0 entonces entra_en_texto(falso) fin
                si sesión <> 0 y no es_admin_uid(sesión) entonces
                    escribir("(La consola del núcleo es para un administrador: el intérprete de órdenes.)\n")
                    ordenes_de_usuario(falso)
                    seguir
                fin
            fin
            escribir("> ")
            lee_línea()
            palabra(línea, 0, palabra1, 40)
            si es("") entonces
                ; nada
            sino si es("ayuda") entonces
                escribir("órdenes: ayuda hora memoria mapa paginas monton tareas programas ejecutar N\n")
                escribir("         toca turnos dormir estropear teclas fallo cero apagar\n")
                escribir("         disco sdhci dir [CARPETA] lanzar PROGRAMA.BIN [ARGUMENTOS] ordenes\n")
                escribir("         teclado es, teclado us, escritorio, usb, quitar UNIDAD\n")
            sino si es("hora") entonces
                escribir("llevo ", tics div HZ, " segundos y ", tics mod HZ, " centésimas encendido\n")
            sino si es("memoria") entonces
                orden_memoria()
            sino si es("mapa") entonces
                orden_mapa()
            sino si es("paginas") entonces
                orden_páginas()
            sino si es("monton") entonces
                orden_montón()
            sino si es("estropear") entonces
                orden_estropear()
            sino si es("tareas") entonces
                enseña_tareas()
            sino si es("turnos") entonces
                orden_turnos()
            sino si es("dormir") entonces
                orden_dormir()
            sino si es("programas") entonces
                enseña_programas()
            sino si iguales(palabra1, "ejecutar") entonces
                orden_ejecutar()
            sino si es("disco") entonces
                orden_disco()
            sino si es("sdhci") entonces
                escribir(informe_sdhci())               ; (SDHCI) lo que ha visto sdhci.cas
            sino si iguales(palabra1, "dir") entonces
                orden_dir()
            sino si iguales(palabra1, "lanzar") entonces
                orden_lanzar()
            sino si es("ordenes") entonces
                ordenes_de_usuario(falso)          ; (USUARIOS)
            sino si es("toca") entonces
                orden_toca()
            sino si es("teclas") entonces
                escribir(teclas, " teclas pulsadas\n")
            sino si es("teclado us") entonces
                pon_teclado(falso)
                escribir("teclado: el de EE. UU.\n")
            sino si es("teclado es") entonces
                pon_teclado(cierto)
                escribir("teclado: el español\n")
            sino si es("usb") entonces
                Usb.enseña()
                Usbhid.enseña_estado()
                I2chid.enseña_estado()
            sino si iguales(palabra1, "quitar") entonces
                orden_quitar()
            sino si es("escritorio") entonces
                si arranca() = 0 entonces escribir("no se puede poner en marcha el escritorio\n") fin
            sino si es("fallo") entonces
                escribir("leo 0xDEAD0000, donde no hay nada...\n")
                malo := puntero(0xDEAD0000)
                escribir(valor(malo), "\n")
            sino si es("cero") entonces
                escribir(divide(1, 0), "\n")
            sino si es("apagar") entonces
                escribir("adiós\n")
                devolver 5
            sino
                escribir("no conozco «", línea, "»\n")
            fin
        fin
    fin

    ; (USUARIOS) el intérprete de órdenes de la pantalla de texto, del que
    ; entre (con «entra_solo», el que entra solo, sin preguntar); al acabar
    ; (SALIR), sale (salvo si ha puesto en marcha el escritorio)
    función ordenes_de_usuario(entra_solo: bool)
        si hay_cuentas y sesión = 0 entonces entra_en_texto(entra_solo) fin
        lanza("ORDENES.BIN", nulo)
        si hay_cuentas y no escritorio_en_marcha entonces cierra_sesión_de_cuentas() fin
    fin

    función divide(a: nat32, b: nat32): nat32
        devolver a div b
    fin

fin Semilla.
