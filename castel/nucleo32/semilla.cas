; =============================================================================
;  semilla.cas - la semilla de Hispa-Pentium: un núcleo de 32 bits escrito en
;  Castel («modelo núcleo»). Lo arranca un cargador multiboot (QEMU con
;  -kernel, o GRUB) en modo protegido con la memoria plana; el arranque que
;  pone el compilador (CASTEL32.md) le da su tabla de descriptores, su pila y
;  la pantalla en blanco, y llama a principal(). Desde ahí, todo es Castel:
;   - la tabla de interrupciones (IDT): las 32 excepciones del procesador y
;     las 16 líneas del controlador (PIC 8259), ya movidas a 0x20-0x2F;
;   - el reloj (PIT 8253 a 100 Hz): cuenta los tics y enseña los segundos
;     en la esquina de la pantalla;
;   - el teclado (8042): cada tecla, de su código a su letra, a una cola que
;     lee el bucle principal;
;   - una consola mínima con unas órdenes: ayuda, hora, memoria, teclas,
;     cero (una división por cero, para ver la excepción) y apagar.
;  Lo que escribe va a la pantalla y al puerto serie (COM1).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Semilla

    modelo núcleo

    ; ---- los puertos ----
    constante PIC1 = 0x20                       ; el controlador principal (y 0x21, sus datos)
    constante PIC2 = 0xA0                       ; el secundario (y 0xA1)
    constante FIN_INT = 0x20                    ; «fin de interrupción»
    constante PIT_CANAL0 = 0x40
    constante PIT_ORDEN = 0x43
    constante TECLADO = 0x60
    constante PIT_HZ = 1193182
    constante HZ = 100

    ; ---- la tabla de interrupciones ----
    tipo Puerta = estructura                    ; una entrada de la IDT (8 octetos)
        desp_bajo: nat16
        selector: nat16
        cero: byte
        clase: byte                             ; 0x8E: puerta de interrupción de 32 bits, presente
        desp_alto: nat16
    fin
    tipo Registro_tabla = estructura            ; lo que carga «lidt»
        límite: nat16
        base: nat32
    fin
    variable idt: arreglo [256] de Puerta
    variable idtr: Registro_tabla

    ; ---- el reloj y el teclado ----
    variable tics: nat32
    variable teclas: nat32
    constante COLA = 64
    variable cola: arreglo [COLA] de byte
    variable cola_ent, cola_sal: nat32
    variable mayúsculas: bool
    variable minúsculas_tabla: arreglo [59] de byte = "\0\e1234567890-=\x08\tqwertyuiop[]\n\0asdfghjkl;'`\0\\zxcvbnm,./\0*\0 "
    variable mayúsculas_tabla: arreglo [59] de byte = "\0\e!@#$%^&*()_+\x08\tQWERTYUIOP{}\n\0ASDFGHJKL:\"~\0|ZXCVBNM<>?\0*\0 "
    variable pantalla: puntero a nat16 = puntero(0xB8000)

    ; ---- la consola ----
    variable línea: arreglo [80] de byte
    variable largo: nat32

    ; -------------------------------------------------------------------------
    ;  La IDT
    ; -------------------------------------------------------------------------
    función pon_puerta(n: nat32, rutina: nat32)
        idt[n].desp_bajo := rutina
        idt[n].selector := 0x08
        idt[n].cero := 0
        idt[n].clase := 0x8E
        idt[n].desp_alto := rutina >> 16
    fin

    ; los dos 8259, a 0x20-0x27 y 0x28-0x2F (la BIOS los deja encima de las
    ; excepciones); todas las líneas tapadas menos el reloj (0) y el teclado (1)
    función prepara_pic()
        sacar_puerto(PIC1, 0x11)
        sacar_puerto(PIC2, 0x11)
        sacar_puerto(PIC1 + 1, 0x20)
        sacar_puerto(PIC2 + 1, 0x28)
        sacar_puerto(PIC1 + 1, 4)
        sacar_puerto(PIC2 + 1, 2)
        sacar_puerto(PIC1 + 1, 1)
        sacar_puerto(PIC2 + 1, 1)
        sacar_puerto(PIC1 + 1, 0xFC)
        sacar_puerto(PIC2 + 1, 0xFF)
    fin

    función prepara_reloj()
        variable divisor: nat32
        divisor := PIT_HZ div HZ
        sacar_puerto(PIT_ORDEN, 0x36)           ; canal 0, las dos mitades, onda cuadrada
        sacar_puerto(PIT_CANAL0, divisor)
        sacar_puerto(PIT_CANAL0, divisor >> 8)
    fin

    función prepara_idt()
        variable i: nat32
        para i desde 0 hasta 31 hacer
            según i
                caso 8, 10..14, 17: pon_puerta(i, nat32(dirección(excepción_con_código)))
                si no: pon_puerta(i, nat32(dirección(excepción)))
            fin
        fin
        pon_puerta(0, nat32(dirección(división_por_cero)))
        para i desde 32 hasta 47 hacer
            pon_puerta(i, nat32(dirección(irq_perdida)))
        fin
        pon_puerta(32, nat32(dirección(reloj)))
        pon_puerta(33, nat32(dirección(teclado)))
        idtr.límite := tamaño(idt) - 1
        idtr.base := nat32(dirección(idt))
        ensamblador
            lidt {idtr}
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Lo que atiende las interrupciones
    ; -------------------------------------------------------------------------
    interrupción función división_por_cero()
        escribir("\n*** excepción 0: división por cero. El núcleo se para.\n")
        salir(9)
    fin

    interrupción función excepción()
        escribir("\n*** excepción del procesador. El núcleo se para.\n")
        salir(10)
    fin

    interrupción función excepción_con_código(código: nat32)
        escribir("\n*** excepción del procesador (código ", código, "). El núcleo se para.\n")
        salir(11)
    fin

    interrupción función irq_perdida()
        sacar_puerto(PIC2, FIN_INT)
        sacar_puerto(PIC1, FIN_INT)
    fin

    ; los segundos desde que se arrancó, arriba a la derecha (sin mover el cursor)
    interrupción función reloj()
        variable s: nat32
        variable i: nat32
        tics := tics + 1
        si tics mod HZ = 0 entonces
            s := tics div HZ
            para i desde 0 hasta 5 hacer
                pantalla[79 - i] := 0x1F00 ob (s mod 10 + '0')
                s := s div 10
            fin
        fin
        sacar_puerto(PIC1, FIN_INT)
    fin

    interrupción función teclado()
        variable código: byte
        variable c: byte
        código := meter_puerto(TECLADO)
        si código = 0x2A o código = 0x36 entonces
            mayúsculas := cierto
        sino si código = 0xAA o código = 0xB6 entonces
            mayúsculas := falso
        sino si código <= 0x39 entonces
                si mayúsculas entonces c := mayúsculas_tabla[código] sino c := minúsculas_tabla[código] fin
                si c <> 0 y cola_ent - cola_sal < COLA entonces
                    cola[cola_ent mod COLA] := c
                    cola_ent := cola_ent + 1
                    teclas := teclas + 1
                fin
        fin
        sacar_puerto(PIC1, FIN_INT)
    fin

    ; -------------------------------------------------------------------------
    ;  La consola
    ; -------------------------------------------------------------------------
    ; espera una tecla de la cola (con «hlt»: el procesador duerme hasta la
    ; interrupción siguiente)
    función leer_tecla(): byte
        variable c: byte
        mientras cierto hacer
            ensamblador
                cli
            fin
            si cola_sal <> cola_ent entonces
                c := cola[cola_sal mod COLA]
                cola_sal := cola_sal + 1
                ensamblador
                    sti
                fin
                devolver c
            fin
            ensamblador
                sti
                hlt
            fin
        fin
    fin

    función lee_línea()
        variable c: byte
        largo := 0
        mientras cierto hacer
            c := leer_tecla()
            si c = '\n' entonces
                escribir("\n")
                línea[largo] := 0
                devolver
            sino si c = 8 entonces
                si largo > 0 entonces
                    largo := largo - 1
                    escribir("\x08 \x08")
                fin
            sino si c >= ' ' y largo < 79 entonces
                línea[largo] := c
                largo := largo + 1
                escribir_car(c)
            fin
        fin
    fin

    función es(t: puntero a byte): bool
        variable i: nat32
        i := 0
        mientras t[i] <> 0 hacer
            si línea[i] <> t[i] entonces devolver falso fin
            i := i + 1
        fin
        devolver línea[i] = 0
    fin

    ; la memoria que dice el cargador (multiboot): la de encima del primer mega, en K
    función memoria_alta(): nat32
        ensamblador
            xor eax, eax
            mov ebx, [C_mb_info]
            cmp dword [C_mb_magia], 0x2BADB002
            jne .no
            test byte [ebx], 1
            jz .no
            mov eax, [ebx+8]
        .no:
        fin
    fin

    función divide(a: nat32, b: nat32): nat32
        devolver a div b
    fin

    función principal(): byte
        prepara_idt()
        prepara_pic()
        prepara_reloj()
        ensamblador
            sti
        fin
        escribir("Hispa-Pentium (semilla), un núcleo de 32 bits escrito en Castel\n")
        escribir("memoria: ", memoria_alta() div 1024 + 1, " MB. Escriba «ayuda».\n")
        mientras cierto hacer
            escribir("> ")
            lee_línea()
            si es("") entonces
                ; nada
            sino si es("ayuda") entonces
                escribir("órdenes: ayuda hora memoria teclas cero apagar\n")
            sino si es("hora") entonces
                escribir("llevo ", tics div HZ, " segundos y ", tics mod HZ, " centésimas encendido\n")
            sino si es("memoria") entonces
                escribir(memoria_alta(), " K por encima del primer mega\n")
            sino si es("teclas") entonces
                escribir(teclas, " teclas pulsadas\n")
            sino si es("cero") entonces
                escribir(divide(1, 0), "\n")
            sino si es("apagar") entonces
                escribir("adiós\n")
                devolver 5
            sino
                escribir("no conozco «", línea, "»\n")
            fin
        fin
    fin

fin Semilla.
