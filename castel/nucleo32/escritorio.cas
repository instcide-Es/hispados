; =============================================================================
;  escritorio.cas - el escritorio de Hispa-Pentium: el primer entorno gráfico
;  del núcleo, con la comodidad de los escritorios de principios de los 2000
;  y diseño propio (azules y verdes, esquinas redondas, y el disquete de la
;  casa de logo).
;
;   - el tapiz (tres a elegir: «Olas», «Azul» y «Verde»), con el disquete;
;   - la barra de tareas, abajo: el botón «Inicio» (verde, redondeado), un
;     botón por cada ventana abierta (pulsarlo la trae delante, la minimiza o
;     la recupera) y, a la derecha, la bandeja con el reloj (el de la CMOS)
;     y, en los portátiles, la batería (energia.cas, con el servicio de
;     ACPI): la pila con lo que queda y, con el puntero quieto encima medio
;     segundo, su recuadro de ayuda (lo que queda, el cable, la salud);
;   - el menú Inicio, de dos columnas: a la izquierda (en blanco) los
;     programas; a la derecha (en azul muy claro) los documentos del disco
;     (los .TXT de la raíz: se abren con el Bloc de notas) y la
;     configuración; y abajo, «Apagar el equipo»;
;   - los cuadros «Apagar el equipo» (apagar, reiniciar), «Configuración»
;     (el teclado, el tapiz, lo que hay), «Acerca de» y los avisos;
;   - los iconos del tapiz (Mi equipo, Bloc de notas, Consola): un clic lo
;     elige, dos lo abren, y se llevan a otro sitio arrastrándolos;
;   - los menús del botón secundario (emergente.cas): el del tapiz, el de
;     una ventana (en su título o en su botón de la barra de tareas:
;     Restaurar, Mover, Minimizar, Maximizar, Cerrar) y «Abrir» en un icono
;     o en una opción del menú Inicio;
;   - el USB en caliente (desde la 0.8, usbcal.cas): con una memoria USB
;     enchufada, su icono en la bandeja (un clic: «Quitar con seguridad»
;     cada una), y los avisos de lo que se enchufa y se quita, en un globo
;     encima de la bandeja que se va solo a los pocos segundos.
;
;  Todo son ventanas del gestor (ventanas.cas): la barra y el menú, sin
;  marco y por delante de las demás; los cuadros, con él. Una tarea del
;  núcleo, «escritorio», da el pulso al gestor cien veces por segundo y
;  atiende los sucesos de estas ventanas. Los programas (BLOC.BIN,
;  CONSOLA.BIN) son del anillo 3 y se cargan del disco.
;
;  Se pone en marcha con arranca(): lo llama el núcleo si el cargador dice
;  «escritorio» (QEMU: -append escritorio), su orden «escritorio», o un
;  programa por la llamada al sistema 38 (la orden ESCRITORIO del intérprete).
;  Con «modo=1024x768» en la línea del cargador, ese modo (si no, 800x600).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Escritorio

    importar Cpu, Tareas, Multiboot, Marcos, Monton, Grafico, Letra, Video, Raton, Ventanas, Emergente, Consola, Fat, Unidades, Fecha, Usuario, Ajustes, Textos32, Formato, Usbcal, Red, Energia, Mem32, Accesos, Dock, Iconos

    público constante ALTO_BARRA = 34
    constante INICIO_ANCHO = 100
    constante BANDEJA_ANCHO = 68                ; la bandeja con el reloj (con una memoria USB, más ancha: su icono)
    constante ICONO_USB = 26
    constante GLOBO_AL = 58
    constante BOTONES_X = 108
    constante BOTÓN_MÁXIMO = 160
    constante MENÚ_ANCHO = 330
    constante MENÚ_ALTO = 380                   ; sin accesos de paquetes (con ellos, más: menú_alto)
    constante MENÚ_CABEZA = 54
    constante MENÚ_PIE = 42
    constante MENÚ_COLUMNA = 172                ; donde empieza la columna de la derecha
    constante ALTO_OPCIÓN = 34
    constante ALTO_OFICINA = 28                 ; las de la oficina, más bajas (caben debajo de los programas)

    ; ---- los colores (los propios de Hispa-Pentium) ----
    constante BLANCO = 0xFFFFFF
    constante BARRA_ARRIBA = 0x4C97EC
    constante BARRA_ABAJO = 0x1D5DBA
    constante VERDE_ARRIBA = 0x5CC45E
    constante VERDE_ABAJO = 0x2A8A3C
    constante BANDEJA_ARRIBA = 0x6FBDF7
    constante BANDEJA_ABAJO = 0x3393E0
    constante AZUL_CLARO = 0xDCEAFB             ; la columna derecha del menú
    constante AZUL_ELEGIDO = 0x2F74D0
    constante TINTA = 0x14294A
    constante TINTA_SUAVE = 0x5A7396
    constante NARANJA = 0xFF7A33                ; el del disquete

    ; ---- lo que hace cada pulsador y cada opción del menú ----
    constante AC_APAGAR = 1
    constante AC_REINICIAR = 2
    constante AC_CANCELAR = 3
    constante AC_TECLADO_ES = 4
    constante AC_TECLADO_US = 5
    constante AC_FONDO = 6                      ; 6, 7 y 8: los tres tapices
    constante AC_CERRAR_CONFIG = 9
    constante AC_CERRAR_AVISO = 10
    constante AM_BLOC = 20
    constante AM_CONSOLA = 21
    constante AM_DOCUMENTO = 22
    constante AM_CONFIG = 23
    constante AM_APAGAR = 24
    constante AM_EQUIPO = 25
    constante AM_OFICINA = 26                   ; un programa de la oficina (dato: cuál)
    constante AM_PROGRAMAS = 27                 ; «Programas y actualizaciones» (ACTUALIZ.BIN)
    constante AM_ACCESO = 28                    ; un programa de un paquete (accesos.cas; dato: cuál)
    constante AM_ATAJO = 29                     ; (dock) un acceso del tapiz que se ha soltado desde el explorador (dato: cuál)
    constante AC_DOCK_SÍ = 38                   ; (dock) verlo o no (Configuración)
    constante AC_DOCK_NO = 39
    constante N_OFICINA = 4                     ; los que hay: Facturas, Pluma, Cuentas y Mirador
    constante AC_CERRAR_ACERCA = 11
    constante AC_ACERCA = 12
    constante AC_TAPIZ_SIGUIENTE = 13
    constante AC_ORGANIZAR = 14
    ; ---- la medida de la pantalla (Configuración > Cambiar...) ----
    constante AC_PANTALLA = 30
    constante AC_CERRAR_PANTALLA = 31
    constante AC_PROBAR = 32
    constante AC_GUARDAR_MODO = 33
    constante AC_MANTENER = 34
    constante AC_VOLVER = 35
    constante AC_REINICIAR_YA = 36
    constante AC_MÁS_TARDE = 37
    constante AC_MODO = 40                      ; 40 y los siguientes: los modos de la lista

    ; ---- los menús del botón secundario (la etiqueta de cada uno) ----
    constante ME_FONDO = 1                      ; el del tapiz
    constante ME_VENTANA = 2                    ; el de una ventana (menú_dato: cuál)
    constante ME_INICIO = 3                     ; «Abrir» en una opción del menú Inicio
    constante ME_ICONO = 4                      ; «Abrir» en un icono del tapiz
    constante ME_USB = 5                        ; el del icono de las memorias USB de la bandeja
    constante ME_ATAJO = 6                      ; (dock) el de un acceso del tapiz: Abrir, Quitar del escritorio

    tipo Opción = estructura                    ; una opción del menú Inicio
        x, ye, an, al: ent32
        acción, dato: nat32
    fin
    tipo Pulsador = estructura                  ; un botón de un cuadro
        ventana: nat32
        x, ye, an, al: ent32
        acción: nat32
    fin

    constante MAX_OPCIONES = 16
    constante MAX_DOCUMENTOS = 5
    constante MAX_PULSADORES = 48
    constante MAX_BOTONES = 12

    ; ---- los iconos del tapiz ----
    constante MAX_ICONOS = 4 + MAX_ACCESOS + MAX_ATAJOS   ; (dock) con los accesos soltados en el tapiz
    constante CELDA_AN = 112                    ; lo que ocupa uno, con su rótulo
    constante CELDA_AL = 62
    tipo Icono = estructura
        x, ye: ent32
        acción: nat32
        dato: nat32                             ; (de un acceso: cuál)
        nombre: puntero a byte
        debajo: puntero a nat32                 ; lo que tapa del tapiz (para quitarlo de ahí)
    fin
    variable iconos: arreglo [MAX_ICONOS] de Icono
    variable n_iconos: nat32
    variable icono_elegido: ent32 = -1
    variable icono_cogido: ent32 = -1           ; el que se está arrastrando
    variable cog_dx, cog_dy, cog_x, cog_y: ent32
    variable cog_movido: bool
    variable menú_dato, menú_acción: nat32      ; de qué va el menú emergente abierto

    variable menú_alto: ent32 = MENÚ_ALTO        ; lo que mide el menú Inicio (crece con los accesos de los paquetes)
    variable v_barra, v_menú, v_apagar, v_config, v_aviso, v_fondo, v_acerca: nat32
    ; ---- la medida de la pantalla ----
    constante MAX_MODOS = 15
    constante N_CANDIDATOS = 13
    constante PRUEBA_SEGUNDOS = 15
    constante PANTALLA_AN = 520
    constante PANTALLA_AL = 360
    variable v_pantalla, v_probar, v_reiniciar: nat32
    variable modos_an, modos_al: arreglo [MAX_MODOS] de nat32  ; (0 x 0: «a la medida de la pantalla», al arrancar)
    variable n_modos: nat32
    variable modo_elegido: ent32
    variable en_marcha: bool                    ; la tarjeta deja cambiarlo en marcha (la VBE de Bochs)
    variable monitor_an, monitor_al: nat32      ; la que prefiere la pantalla (su EDID), si se sabe
    variable prueba_arranque: bool              ; lo que se prueba lo ha puesto GRUB al arrancar
    variable prueba_hasta, prueba_vista: nat32
    variable antes_an, antes_al: nat32          ; la medida de antes de probar
    variable texto_pantalla: arreglo [96] de byte   ; lo último que ha pasado (debajo de la lista)
    variable texto_reiniciar: arreglo [96] de byte
    ; \HISPA\PANTALLA.ENV (un bloque de variables de GRUB, como GRUBENV)
    variable env_pantalla, env_antes: arreglo [16] de byte
    variable env_prueba: byte
    variable texto_env: arreglo [1100] de byte
    variable texto_grub: arreglo [8200] de byte
    variable menú_abierto: bool
    variable menú_cerrado_en: nat32             ; el tic en que se cerró (por un clic fuera)
    variable opciones: arreglo [MAX_OPCIONES] de Opción
    variable n_opciones: nat32
    variable elegida: ent32 = -1
    variable documentos: arreglo [MAX_DOCUMENTOS] de arreglo [13] de byte
    variable n_documentos: nat32
    variable pulsadores: arreglo [MAX_PULSADORES] de Pulsador
    variable n_pulsadores: nat32
    variable botones: arreglo [MAX_BOTONES] de nat32    ; la ventana de cada botón de la barra
    variable n_botones: nat32
    variable ancho_botón: ent32
    variable cambios_vistos: nat32
    variable red_vista: nat32                   ; (los cambios de la red que ya pinta el icono)
    constante ICONO_RED = 24                    ; lo que se ensancha la bandeja con el icono de la red
    variable minuto_visto: nat32 = 0xFFFFFFFF
    variable segundo_visto: nat32
    variable fondo: nat32                       ; el tapiz: 0, 1 o 2
    variable texto_aviso: arreglo [128] de byte
    variable saludo: arreglo [40] de byte       ; «Hola, » y el nombre del usuario (el menú Inicio)
    variable renglón: arreglo [96] de byte
    público variable lanzados: nat32            ; los programas que ha lanzado el escritorio
    ; ---- el USB: el icono de la bandeja y el globo de los avisos ----
    variable bandeja: ent32 = 68                ; lo que mide ahora la bandeja
    variable usb_letras: arreglo [8] de byte    ; las unidades de las memorias USB
    variable n_usb: nat32
    variable unidades_vistas: nat32
    variable v_globo: nat32
    variable globo_hasta: nat32
    variable texto_globo: arreglo [80] de byte
    ; el recuadro de ayuda de la pila de la bandeja
    variable v_ayuda: nat32
    variable ayuda_quieto: nat32                ; los tics que lleva el puntero quieto encima
    variable ayuda_x, ayuda_y: ent32            ; dónde estaba el puntero
    variable ayuda_tapada: bool                 ; se ha pulsado un botón: no vuelve hasta salir y entrar
    variable ayuda_vista, energía_vista: nat32  ; (cambios_energía de lo que se ve)
    variable apagar_otra_vez: bool              ; la última vez no se cerró un programa: ahora se le cierra

    ; -------------------------------------------------------------------------
    ;  El tapiz
    ; -------------------------------------------------------------------------
    ; la altura de una ola en la columna x: sube y baja cada «largo» puntos
    ; (un arco detrás de otro, sin senos)
    función ola(x: ent32, largo: ent32, alza: ent32): ent32
        variable u: ent32
        u := x mod largo
        devolver alza * 4 * u * (largo - u) div (largo * largo)
    fin

    ; tiñe del color «tinte» lo que queda por debajo de una ola
    función pinta_ola(línea_base: ent32, largo: ent32, fase: ent32, alza: ent32, tinte: nat32, cuánto: nat32)
        variable x, yy, desde_y: ent32
        variable p: puntero a nat32
        para x desde 0 hasta tapiz.ancho - 1 hacer
            ; (la cresta, en pico hacia arriba: olas, no lomas)
            desde_y := línea_base - alza + ola(x + fase, largo, alza)
            si desde_y < 0 entonces desde_y := 0 fin
            p := tapiz.puntos + (desde_y * ent32(tapiz.salto) + x)
            yy := desde_y
            mientras yy < tapiz.alto hacer
                valor(p) := mezcla(valor(p), tinte, cuánto)
                p := p + tapiz.salto
                yy := yy + 1
            fin
        fin
    fin

    función pinta_tapiz()
        variable an, al: ent32
        an := tapiz.ancho
        al := tapiz.alto
        según fondo
            caso 1: degradado(tapiz, 0, 0, an, al, 0x16468E, 0x4E9FE6)
            caso 2: degradado(tapiz, 0, 0, an, al, 0x1E6A52, 0x7CC878)
            si no:
                ; «Olas»: del azul de arriba al verde de abajo, en cuatro olas
                degradado(tapiz, 0, 0, an, al, 0x154C9C, 0x2F8FD2)
                pinta_ola(al * 50 div 100, an * 46 div 100, an * 20 div 100, al * 7 div 100, 0x2A9FD4, 80)
                pinta_ola(al * 64 div 100, an * 38 div 100, an * 9 div 100, al * 7 div 100, 0x2CB3C6, 100)
                pinta_ola(al * 79 div 100, an * 54 div 100, an * 31 div 100, al * 8 div 100, 0x36C0AE, 115)
                pinta_ola(al * 93 div 100, an * 42 div 100, an * 2 div 100, al * 7 div 100, 0x58D09A, 130)
        fin
        ; la firma: el disquete y el nombre, abajo a la derecha
        disquete(tapiz, an - 226, al - ALTO_BARRA - 74, 56)
        texto_negrita(tapiz, an - 163, al - ALTO_BARRA - 59, "Hispa-Pentium", 0x0E3A66)
        texto_negrita(tapiz, an - 164, al - ALTO_BARRA - 60, "Hispa-Pentium", BLANCO)
        texto(tapiz, an - 164, al - ALTO_BARRA - 40, "hecho en Castel", 0xE2F2FF)
        ; y los iconos, encima (el tapiz es nuevo: lo que tapan se guarda otra vez)
        pon_iconos()
    fin

    ; -------------------------------------------------------------------------
    ;  Dibujos pequeños: los iconos y los pulsadores
    ; -------------------------------------------------------------------------
    ; una hoja de papel con renglones (22 x 26)
    función icono_hoja(ref l: Lienzo, x: ent32, yy: ent32, cabecera: nat32)
        variable i: ent32
        rectángulo(l, x, yy, 22, 26, 0x6F87A8)
        rectángulo(l, x + 1, yy + 1, 20, 24, BLANCO)
        rectángulo(l, x + 1, yy + 1, 20, 5, cabecera)
        para i desde 0 hasta 3 hacer
            rectángulo(l, x + 4, yy + 9 + i * 4, 14 - (i mod 2) * 4, 1, 0x7D93B2)
        fin
    fin

    ; una pantalla oscura con su «>_» (24 x 22)
    función icono_consola(ref l: Lienzo, x: ent32, yy: ent32)
        redondeado(l, x, yy, 24, 22, 3, 0x6F87A8, 0x6F87A8, TODAS)
        redondeado(l, x + 1, yy + 1, 22, 20, 2, 0x1B2B44, 0x0D1626, TODAS)
        línea(l, x + 5, yy + 6, x + 9, yy + 10, 0x7CE88A)
        línea(l, x + 9, yy + 10, x + 5, yy + 14, 0x7CE88A)
        rectángulo(l, x + 12, yy + 14, 6, 2, 0x7CE88A)
    fin

    ; una rueda dentada (24 x 24)
    función icono_rueda(ref l: Lienzo, x: ent32, yy: ent32, fondo_: nat32)
        rectángulo(l, x + 10, yy, 4, 24, 0x5C7FB0)
        rectángulo(l, x, yy + 10, 24, 4, 0x5C7FB0)
        línea(l, x + 4, yy + 4, x + 19, yy + 19, 0x5C7FB0)
        línea(l, x + 5, yy + 4, x + 20, yy + 19, 0x5C7FB0)
        línea(l, x + 19, yy + 4, x + 4, yy + 19, 0x5C7FB0)
        línea(l, x + 20, yy + 4, x + 5, yy + 19, 0x5C7FB0)
        círculo(l, x + 12, yy + 12, 8, 0x5C7FB0)
        círculo(l, x + 12, yy + 12, 6, 0x8FB2E0)
        círculo(l, x + 12, yy + 12, 3, fondo_)
    fin

    ; el botón de apagar: un redondel naranja con su raya (22 x 22)
    función icono_apagar(ref l: Lienzo, x: ent32, yy: ent32)
        círculo(l, x + 11, yy + 11, 11, BLANCO)
        círculo(l, x + 11, yy + 11, 10, NARANJA)
        círculo(l, x + 11, yy + 12, 6, BLANCO)
        círculo(l, x + 11, yy + 12, 4, NARANJA)
        rectángulo(l, x + 8, yy + 3, 7, 7, NARANJA)
        rectángulo(l, x + 10, yy + 4, 2, 8, BLANCO)
    fin

    ; un pulsador redondeado, con su texto en blanco centrado
    función pinta_pulsador(ref l: Lienzo, x: ent32, yy: ent32, an: ent32, al: ent32, t: puntero a byte, arriba: nat32, abajo: nat32)
        variable tx: ent32
        redondeado(l, x, yy, an, al, 6, mezcla(abajo, 0, 80), mezcla(abajo, 0, 80), TODAS)
        redondeado(l, x + 1, yy + 1, an - 2, al - 2, 5, arriba, abajo, TODAS)
        rectángulo(l, x + 6, yy + 2, an - 12, 1, mezcla(arriba, BLANCO, 120))
        tx := x + (an - ancho_texto(t)) div 2
        texto_negrita(l, tx + 1, yy + (al - ALTO_LETRA) div 2 + 1, t, mezcla(abajo, 0, 110))
        texto_negrita(l, tx, yy + (al - ALTO_LETRA) div 2, t, BLANCO)
    fin

    ; un equipo: la pantalla, con el disquete dentro, y su pie (32 x 32)
    función icono_equipo(ref l: Lienzo, x: ent32, yy: ent32)
        redondeado(l, x + 1, yy, 30, 23, 3, 0x4F6890, 0x4F6890, TODAS)
        redondeado(l, x + 2, yy + 1, 28, 21, 2, 0xE4ECF7, 0xB7C7DE, TODAS)
        degradado(l, x + 4, yy + 3, 24, 16, 0x7FC2FA, 0x2A7AD6)
        disquete(l, x + 10, yy + 5, 12)
        rectángulo(l, x + 13, yy + 23, 6, 3, 0x7F95B6)
        redondeado(l, x + 5, yy + 26, 22, 6, 2, 0x4F6890, 0x4F6890, TODAS)
        redondeado(l, x + 6, yy + 27, 20, 4, 1, 0xDCE6F3, 0xA9BBD6, TODAS)
    fin

    ; una hoja grande, con su esquina doblada (26 x 32)
    función icono_hoja_grande(ref l: Lienzo, x: ent32, yy: ent32)
        variable i: ent32
        rectángulo(l, x, yy, 26, 32, 0x4F6890)
        rectángulo(l, x + 1, yy + 1, 24, 30, BLANCO)
        rectángulo(l, x + 1, yy + 1, 24, 6, 0x4C97EC)
        rectángulo(l, x + 1, yy + 7, 24, 1, 0x2A6BC8)
        para i desde 0 hasta 4 hacer
            rectángulo(l, x + 4, yy + 11 + i * 4, 18 - (i mod 2) * 5, 1, 0x6F87A8)
        fin
    fin

    ; el icono de un acceso (el de su .ICP, de 32 x 32; o uno de programa si
    ; no tiene), tomando uno de cada «salto» puntos (1: 32 x 32; 2: 16 x 16)
    función icono_acceso(ref l: Lienzo, x: ent32, yy: ent32, i: nat32, salto: ent32)
        variable p: puntero a nat32
        variable f, c, lado: ent32
        variable px: nat32
        lado := LADO_ICONO div salto
        p := nulo
        si i < n_accesos entonces p := icono_de(i) fin
        si p = nulo entonces
            ; sin icono: una ventanita
            redondeado(l, x, yy + lado div 8, lado, lado - lado div 4, 2, 0x4C97EC, 0x1D5DBA, TODAS)
            rectángulo(l, x + 2, yy + lado div 8 + lado div 5, lado - 4, lado - lado div 4 - lado div 5 - 2, BLANCO)
            devolver
        fin
        para f desde 0 hasta lado - 1 hacer
            para c desde 0 hasta lado - 1 hacer
                px := p[nat32(f * salto) * LADO_ICONO + nat32(c * salto)]
                si px >> 24 >= 0x80 entonces punto(l, x + c, yy + f, px yb 0xFFFFFF) fin
            fin
        fin
    fin

    ; una pantalla oscura grande con su «>_» (32 x 28)
    función icono_consola_grande(ref l: Lienzo, x: ent32, yy: ent32)
        redondeado(l, x, yy, 32, 28, 4, 0x4F6890, 0x4F6890, TODAS)
        redondeado(l, x + 1, yy + 1, 30, 26, 3, 0xDCE6F3, 0xA9BBD6, TODAS)
        redondeado(l, x + 3, yy + 3, 26, 22, 2, 0x1B2B44, 0x0D1626, TODAS)
        línea(l, x + 7, yy + 8, x + 12, yy + 13, 0x7CE88A)
        línea(l, x + 7, yy + 9, x + 12, yy + 14, 0x7CE88A)
        línea(l, x + 12, yy + 13, x + 7, yy + 18, 0x7CE88A)
        línea(l, x + 12, yy + 14, x + 7, yy + 19, 0x7CE88A)
        rectángulo(l, x + 15, yy + 18, 8, 2, 0x7CE88A)
    fin

    ; -------------------------------------------------------------------------
    ;  Los iconos del tapiz. Se pintan en el propio tapiz: de cada uno se
    ;  guarda lo que tapa, para quitarlo de ahí al moverlo o al elegirlo.
    ; -------------------------------------------------------------------------
    ; quita todos del tapiz (del último al primero: pueden estar unos sobre otros)
    función quita_iconos()
        variable i: ent32
        variable l: Lienzo
        i := ent32(n_iconos) - 1
        mientras i >= 0 hacer
            pon_lienzo(l, iconos[i].debajo, CELDA_AN, CELDA_AN, CELDA_AL)
            copiar_lienzo(tapiz, iconos[i].x, iconos[i].ye, l, 0, 0, CELDA_AN, CELDA_AL)
            repintar_trozo(iconos[i].x, iconos[i].ye, CELDA_AN, CELDA_AL)
            i := i - 1
        fin
    fin

    ; y los pinta todos, cada uno donde está, guardando antes lo que tapa
    función pon_iconos()
        variable i: nat32
        variable x, yy, tx, n: ent32
        variable l: Lienzo
        i := 0
        mientras i < n_iconos hacer
            x := iconos[i].x
            yy := iconos[i].ye
            pon_lienzo(l, iconos[i].debajo, CELDA_AN, CELDA_AN, CELDA_AL)
            copiar_lienzo(l, 0, 0, tapiz, x, yy, CELDA_AN, CELDA_AL)
            según iconos[i].acción
                caso AM_EQUIPO: icono_equipo(tapiz, x + (CELDA_AN - 32) div 2, yy + 3)
                caso AM_BLOC: icono_hoja_grande(tapiz, x + (CELDA_AN - 26) div 2, yy + 3)
                caso AM_ACCESO: icono_acceso(tapiz, x + (CELDA_AN - LADO_ICONO) div 2, yy + 3, iconos[i].dato, 1)
                caso AM_ATAJO:
                    ; (dock) el icono de su clase, con la flechita de los accesos
                    icono(tapiz, x + (CELDA_AN - 32) div 2, yy + 3, 32, atajos[iconos[i].dato].clase, 0, 0)
                    marca_acceso(tapiz, x + (CELDA_AN - 32) div 2, yy + 3, 32)
                si no: icono_consola_grande(tapiz, x + (CELDA_AN - 32) div 2, yy + 5)
            fin
            ; el rótulo, con letra normal: blanco con su sombra; el del elegido, sobre azul
            n := ancho_texto(iconos[i].nombre)
            tx := x + (CELDA_AN - n) div 2
            si ent32(i) = icono_elegido entonces
                redondeado(tapiz, tx - 4, yy + 40, n + 8, ALTO_LETRA + 4, 4, 0x3F86E0, AZUL_ELEGIDO, TODAS)
            sino
                texto(tapiz, tx + 1, yy + 43, iconos[i].nombre, 0x0B2A52)
            fin
            texto(tapiz, tx, yy + 42, iconos[i].nombre, BLANCO)
            repintar_trozo(x, yy, CELDA_AN, CELDA_AL)
            i := i + 1
        fin
    fin

    ; cada uno a su sitio de siempre: en columna, arriba a la izquierda
    función organiza_iconos()
        variable i: nat32
        i := 0
        mientras i < n_iconos hacer
            iconos[i].x := 8
            iconos[i].ye := 12 + ent32(i) * 76
            i := i + 1
        fin
    fin

    función nuevo_icono(nombre: puntero a byte, acción: nat32)
        nuevo_icono_de(nombre, acción, 0)
    fin

    función nuevo_icono_de(nombre: puntero a byte, acción: nat32, dato: nat32)
        variable m: puntero a byte
        si n_iconos >= MAX_ICONOS entonces devolver fin
        m := reservar(CELDA_AN * CELDA_AL * 4)
        si m = nulo entonces devolver fin
        iconos[n_iconos].debajo := puntero(m)
        iconos[n_iconos].nombre := nombre
        iconos[n_iconos].acción := acción
        iconos[n_iconos].dato := dato
        n_iconos := n_iconos + 1
    fin

    ; el icono que está en ese punto de la pantalla (el de más arriba); -1 si no hay
    función icono_en(x: ent32, yy: ent32): ent32
        variable i: ent32
        i := ent32(n_iconos) - 1
        mientras i >= 0 hacer
            si x >= iconos[i].x + 8 y x < iconos[i].x + CELDA_AN - 8 y yy >= iconos[i].ye y yy < iconos[i].ye + CELDA_AL entonces devolver i fin
            i := i - 1
        fin
        devolver -1
    fin

    función elige_icono(k: ent32)
        si k = icono_elegido entonces devolver fin
        quita_iconos()
        icono_elegido := k
        pon_iconos()
    fin

    ; lleva un icono a otro sitio (sin salirse de la pantalla ni meterse bajo la barra)
    función mueve_icono(k: ent32, x: ent32, yy: ent32)
        si x > tapiz.ancho - CELDA_AN entonces x := tapiz.ancho - CELDA_AN fin
        si yy > tapiz.alto - ALTO_BARRA - CELDA_AL entonces yy := tapiz.alto - ALTO_BARRA - CELDA_AL fin
        si x < 0 entonces x := 0 fin
        si yy < 0 entonces yy := 0 fin
        si x = iconos[k].x y yy = iconos[k].ye entonces devolver fin
        quita_iconos()
        iconos[k].x := x
        iconos[k].ye := yy
        pon_iconos()
    fin

    ; -------------------------------------------------------------------------
    ;  Los pulsadores de los cuadros
    ; -------------------------------------------------------------------------
    función quita_pulsadores(ventana: nat32)
        variable i, k: nat32
        k := 0
        i := 0
        mientras i < n_pulsadores hacer
            si pulsadores[i].ventana <> ventana entonces
                si k <> i entonces
                    pulsadores[k].ventana := pulsadores[i].ventana
                    pulsadores[k].x := pulsadores[i].x
                    pulsadores[k].ye := pulsadores[i].ye
                    pulsadores[k].an := pulsadores[i].an
                    pulsadores[k].al := pulsadores[i].al
                    pulsadores[k].acción := pulsadores[i].acción
                fin
                k := k + 1
            fin
            i := i + 1
        fin
        n_pulsadores := k
    fin

    ; pinta un pulsador en la ventana y lo apunta para cuando se pulse
    función pulsador(ventana: nat32, x: ent32, yy: ent32, an: ent32, al: ent32, t: puntero a byte, arriba: nat32, abajo: nat32, acción: nat32)
        variable l: puntero a Lienzo
        l := lienzo_de(ventana)
        si l = nulo o n_pulsadores >= MAX_PULSADORES entonces devolver fin
        pinta_pulsador(valor(l), x, yy, an, al, t, arriba, abajo)
        pulsadores[n_pulsadores].ventana := ventana
        pulsadores[n_pulsadores].x := x
        pulsadores[n_pulsadores].ye := yy
        pulsadores[n_pulsadores].an := an
        pulsadores[n_pulsadores].al := al
        pulsadores[n_pulsadores].acción := acción
        n_pulsadores := n_pulsadores + 1
    fin

    ; lo que hace el pulsador de esa ventana que está en ese punto (0: ninguno)
    función pulsador_en(ventana: nat32, x: ent32, yy: ent32): nat32
        variable i: nat32
        i := 0
        mientras i < n_pulsadores hacer
            si pulsadores[i].ventana = ventana y x >= pulsadores[i].x y yy >= pulsadores[i].ye y x < pulsadores[i].x + pulsadores[i].an y yy < pulsadores[i].ye + pulsadores[i].al entonces
                devolver pulsadores[i].acción
            fin
            i := i + 1
        fin
        devolver 0
    fin

    ; una memoria USB (14 x 22): el conector arriba y el cuerpo azul
    función icono_memoria(ref l: Lienzo, x: ent32, yy: ent32)
        rectángulo(l, x + 3, yy, 8, 7, 0x6F87A8)
        rectángulo(l, x + 4, yy + 1, 6, 6, 0xE4ECF7)
        rectángulo(l, x + 5, yy + 2, 1, 2, 0x6F87A8)
        rectángulo(l, x + 8, yy + 2, 1, 2, 0x6F87A8)
        redondeado(l, x, yy + 6, 14, 16, 3, 0x14408A, 0x14408A, TODAS)
        redondeado(l, x + 1, yy + 7, 12, 14, 2, 0x5DA8F5, 0x2463C2, TODAS)
        rectángulo(l, x + 4, yy + 11, 6, 1, BLANCO)
        rectángulo(l, x + 4, yy + 14, 6, 1, BLANCO)
    fin

    ; -------------------------------------------------------------------------
    ;  La barra de tareas
    ; -------------------------------------------------------------------------
    ; lo que mide la bandeja: el reloj y, a su izquierda, un hueco por cada
    ; icono que haya (de izquierda a derecha: las memorias USB, si hay alguna
    ; enchufada; la red, si hay servicio de red, y la pila, si hay batería)
    función hueco_usb(): ent32
        si n_usb > 0 entonces devolver ICONO_USB fin
        devolver 0
    fin

    función hueco_red(): ent32
        si estado_red <> RED_NADA entonces devolver ICONO_RED fin
        devolver 0
    fin

    función hueco_pila(): ent32
        si hay_pila() entonces devolver ANCHO_PILA fin
        devolver 0
    fin

    función ancho_bandeja(): ent32
        devolver BANDEJA_ANCHO + hueco_usb() + hueco_red() + hueco_pila()
    fin

    ; el icono de la red: una pantalla con su pie y, abajo a la derecha, una
    ; luz (verde: conectada; ámbar: pidiendo la IP; roja: sin cable; gris:
    ; sin tarjeta)
    función pinta_icono_red(ref l: Lienzo, x: ent32, yy: ent32)
        variable luz, pantalla_c: nat32
        luz := 0x9AA8B8
        pantalla_c := 0xB8C4D0
        según nat16(estado_red)
            caso RED_CONECTADA:
                luz := 0x2ECC40
                pantalla_c := 0x8FDCFF
            caso RED_BUSCANDO: luz := 0xFFB000
            caso RED_SIN_CABLE: luz := 0xE53935
        fin
        rectángulo(l, x, yy, 15, 11, 0x14336A)
        rectángulo(l, x + 1, yy + 1, 13, 9, pantalla_c)
        rectángulo(l, x + 2, yy + 2, 5, 2, BLANCO)
        rectángulo(l, x + 6, yy + 11, 3, 2, 0x14336A)
        rectángulo(l, x + 3, yy + 13, 9, 2, 0x14336A)
        círculo(l, x + 14, yy + 12, 4, 0x14336A)
        círculo(l, x + 14, yy + 12, 3, luz)
    fin

    ; con un clic en el icono de la red: cómo está
    función dice_red()
        variable t: arreglo [80] de byte
        variable d: arreglo [4] de nat32
        según nat16(estado_red)
            caso RED_CONECTADA:
                d[0] := ip_red yb 0xFF
                d[1] := (ip_red >> 8) yb 0xFF
                d[2] := (ip_red >> 16) yb 0xFF
                d[3] := ip_red >> 24
                formatear(t, 80, "La red: conectada, con la IP %u.%u.%u.%u.", d)
                aviso(t)
            caso RED_BUSCANDO: aviso("La red: hay cable; pidiendo la IP (DHCP)...")
            caso RED_SIN_CABLE: aviso("La red: la tarjeta no tiene enlace (¿el cable?).")
            si no: aviso("La red: no hay tarjeta de red que se sepa llevar.")
        fin
    fin

    función pinta_barra()
        variable l: puntero a Lienzo
        variable an, x, caben, n: ent32
        variable i: nat32
        variable f, h: nat32
        variable hora: arreglo [8] de byte
        variable d: arreglo [2] de nat32
        l := lienzo_de(v_barra)
        si l = nulo entonces devolver fin
        an := l.ancho
        energía_vista := cambios_energía
        degradado(valor(l), 0, 0, an, ALTO_BARRA, BARRA_ARRIBA, BARRA_ABAJO)
        rectángulo(valor(l), 0, 0, an, 1, 0x8FC4FA)
        rectángulo(valor(l), 0, 1, an, 1, 0x62A8F2)
        ; «Inicio»: verde, redondeado por la derecha (más claro con el menú abierto)
        si menú_abierto entonces
            redondeado(valor(l), -16, 2, INICIO_ANCHO + 16, ALTO_BARRA - 3, 14, 0x3FA24C, 0x1F7532, TODAS)
        sino
            redondeado(valor(l), -16, 2, INICIO_ANCHO + 16, ALTO_BARRA - 3, 14, VERDE_ARRIBA, VERDE_ABAJO, TODAS)
            rectángulo(valor(l), 0, 3, INICIO_ANCHO - 12, 1, 0x9EE69A)
        fin
        disquete(valor(l), 7, 5, 24)
        texto_negrita(valor(l), 39, 10, "Inicio", 0x1B5E2A)
        texto_negrita(valor(l), 38, 9, "Inicio", BLANCO)
        ; la bandeja, con el reloj y, a su izquierda, los iconos que haya (de
        ; izquierda a derecha: las memorias USB, la red y la pila)
        n_usb := letras_usb(usb_letras)
        bandeja := ancho_bandeja()
        degradado(valor(l), an - bandeja, 2, bandeja, ALTO_BARRA - 2, BANDEJA_ARRIBA, BANDEJA_ABAJO)
        rectángulo(valor(l), an - bandeja, 2, 1, ALTO_BARRA - 2, 0x1A56AC)
        rectángulo(valor(l), an - bandeja + 1, 2, 1, ALTO_BARRA - 2, 0x9AD4FF)
        si n_usb > 0 entonces icono_memoria(valor(l), an - bandeja + 8, 6) fin
        si hueco_red() > 0 entonces pinta_icono_red(valor(l), an - bandeja + hueco_usb() + 7, 9) fin
        si hay_pila() entonces pinta_pila(valor(l), an - bandeja + hueco_usb() + hueco_red() + 8, 0) fin
        red_vista := cambios_red
        ahora(f, h)
        d[0] := h >> 11
        d[1] := (h >> 5) yb 63
        minuto_visto := d[1]
        formatear(hora, 8, "%02u:%02u", d)
        texto_negrita(valor(l), an - BANDEJA_ANCHO + 15, 10, hora, 0x1E5CA8)
        texto_negrita(valor(l), an - BANDEJA_ANCHO + 14, 9, hora, BLANCO)
        ; un botón por cada ventana con marco (también las minimizadas)
        n_botones := 0
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].banderas yb (SIN_MARCO ob OCULTA) = 0 y n_botones < MAX_BOTONES entonces
                botones[n_botones] := i
                n_botones := n_botones + 1
            fin
        fin
        si n_botones > 0 entonces
            ancho_botón := (an - BOTONES_X - bandeja - 6) div ent32(n_botones)
            si ancho_botón > BOTÓN_MÁXIMO entonces ancho_botón := BOTÓN_MÁXIMO fin
            i := 0
            mientras i < n_botones hacer
                x := BOTONES_X + ent32(i) * ancho_botón
                si ent32(botones[i]) = activa entonces
                    ; la activa: hundido, más oscuro
                    redondeado(valor(l), x, 4, ancho_botón - 4, ALTO_BARRA - 7, 5, 0x0F3F8A, 0x0F3F8A, TODAS)
                    redondeado(valor(l), x + 1, 5, ancho_botón - 6, ALTO_BARRA - 9, 4, 0x1A52A6, 0x2B6FCC, TODAS)
                sino
                    redondeado(valor(l), x, 4, ancho_botón - 4, ALTO_BARRA - 7, 5, 0x2A6BC8, 0x2A6BC8, TODAS)
                    redondeado(valor(l), x + 1, 5, ancho_botón - 6, ALTO_BARRA - 9, 4, 0x6DB4F8, 0x3E86E2, TODAS)
                fin
                disquete(valor(l), x + 5, 8, 18)
                caben := (ancho_botón - 36) div ANCHO_LETRA
                n := 0
                mientras ventanas[botones[i]].título[n] <> 0 hacer n := n + 1 fin
                si n > caben entonces n := caben fin
                si n > 0 entonces texto_n(valor(l), x + 27, 9, ventanas[botones[i]].título, nat32(n), BLANCO) fin
                botones[i] := ventanas[botones[i]].id
                i := i + 1
            fin
        fin
        cambios_vistos := Ventanas.cambios
        repintada(v_barra, 0, 0, an, ALTO_BARRA)
    fin

    ; -------------------------------------------------------------------------
    ;  El menú Inicio
    ; -------------------------------------------------------------------------
    ; los documentos: los .TXT de la raíz del disco (los cinco primeros)
    función lee_documentos()
        variable m, r, n, i: nat32
        variable e: Entrada
        n_documentos := 0
        si unidad_en_memoria() entonces
            ; sin disco: los .TXT que ha traído el cargador
            i := 0
            mientras i < módulos() y n_documentos < MAX_DOCUMENTOS hacer
                n := 0
                mientras n < 12 y módulo_nombre(i)[n] <> 0 y módulo_nombre(i)[n] <> ' ' hacer
                    documentos[n_documentos][n] := mayúscula(módulo_nombre(i)[n])
                    n := n + 1
                fin
                documentos[n_documentos][n] := 0
                si n > 4 y documentos[n_documentos][n - 4] = '.' y documentos[n_documentos][n - 3] = 'T' y documentos[n_documentos][n - 2] = 'X' y documentos[n_documentos][n - 1] = 'T' entonces
                    n_documentos := n_documentos + 1
                fin
                i := i + 1
            fin
            devolver
        fin
        m := abrir_archivo(del_sistema, "\\", PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver fin
        r := leer_entrada(m, dirección(e))
        mientras r = 1 y n_documentos < MAX_DOCUMENTOS hacer
            n := 0
            mientras e.nombre[n] <> 0 hacer n := n + 1 fin
            si e.atributos yb CARPETA = 0 y n > 4 y e.nombre[n - 4] = '.' y e.nombre[n - 3] = 'T' y e.nombre[n - 2] = 'X' y e.nombre[n - 1] = 'T' entonces
                para i desde 0 hasta n hacer documentos[n_documentos][i] := e.nombre[i] fin
                n_documentos := n_documentos + 1
            fin
            r := leer_entrada(m, dirección(e))
        fin
        cerrar_archivo(m)
    fin

    función nueva_opción(x: ent32, yy: ent32, an: ent32, al: ent32, acción: nat32, dato: nat32): ent32
        si n_opciones >= MAX_OPCIONES entonces devolver -2 fin
        opciones[n_opciones].x := x
        opciones[n_opciones].ye := yy
        opciones[n_opciones].an := an
        opciones[n_opciones].al := al
        opciones[n_opciones].acción := acción
        opciones[n_opciones].dato := dato
        n_opciones := n_opciones + 1
        devolver ent32(n_opciones) - 1
    fin

    ; una opción del menú: su franja (resaltada si es la elegida) y su texto;
    ; da el color con que hay que pintar lo demás (su icono lo pinta quien llama)
    función pinta_opción(ref l: Lienzo, x: ent32, yy: ent32, an: ent32, t: puntero a byte, acción: nat32, dato: nat32, negrita: bool)
        pinta_opción_de(l, x, yy, an, ALTO_OPCIÓN, t, acción, dato, negrita)
    fin

    ; lo mismo, de ese alto
    función pinta_opción_de(ref l: Lienzo, x: ent32, yy: ent32, an: ent32, al: ent32, t: puntero a byte, acción: nat32, dato: nat32, negrita: bool)
        variable n: ent32
        variable c: nat32
        n := nueva_opción(x, yy, an, al, acción, dato)
        c := TINTA
        si n = elegida entonces
            redondeado(l, x + 2, yy + 1, an - 4, al - 2, 4, 0x3F86E0, AZUL_ELEGIDO, TODAS)
            c := BLANCO
        fin
        si negrita entonces
            texto_negrita(l, x + 38, yy + (al - 16) div 2, t, c)
        sino
            texto(l, x + 38, yy + (al - 16) div 2, t, c)
        fin
    fin

    ; los programas de la oficina: su nombre (o, con «ruta», su .HVP)
    función de_oficina(i: nat32, ruta: bool): puntero a byte
        si ruta entonces
            según i
                caso 0: devolver "\\OFICINA\\FACTURAS.HVP"
                caso 1: devolver "\\OFICINA\\PLUMA.HVP"
                caso 2: devolver "\\OFICINA\\CUENTAS.HVP"
            fin
            devolver "\\OFICINA\\MIRADOR.HVP"
        fin
        según i
            caso 0: devolver "Facturas"
            caso 1: devolver "Pluma"
            caso 2: devolver "Cuentas"
        fin
        devolver "Mirador"
    fin

    función color_oficina(i: nat32): nat32
        según i
            caso 0: devolver 0x46C282
            caso 1: devolver 0x4C97EC
            caso 2: devolver 0xF0A030
        fin
        devolver 0xC85A9E
    fin

    función pinta_menú()
        variable l: puntero a Lienzo
        variable yy: ent32
        variable i: nat32
        l := lienzo_de(v_menú)
        si l = nulo entonces devolver fin
        n_opciones := 0
        ; el marco y la cabecera, azul, con el disquete y el nombre
        rectángulo(valor(l), 0, 0, MENÚ_ANCHO, menú_alto, 0x1A56AC)
        redondeado(valor(l), 1, 1, MENÚ_ANCHO - 2, MENÚ_CABEZA, 7, 0x4E99EE, 0x1F62C0, ARRIBA)
        rectángulo(valor(l), 8, 2, MENÚ_ANCHO - 16, 1, 0x9CCBFA)
        disquete(valor(l), 9, 7, 42)
        ; (con el nombre del usuario, si se sabe: el saludo)
        si Ajustes.usuario[0] <> 0 entonces
            copiar_hasta(saludo, "Hola, ", 40)
            concatenar(saludo, Ajustes.usuario)
            texto_negrita(valor(l), 59, 13, saludo, 0x123F85)
            texto_negrita(valor(l), 58, 12, saludo, BLANCO)
            texto(valor(l), 58, 30, "Hispa-Pentium, versión 0.8", 0xD3E7FD)
        sino
            texto_negrita(valor(l), 59, 13, "Hispa-Pentium", 0x123F85)
            texto_negrita(valor(l), 58, 12, "Hispa-Pentium", BLANCO)
            texto(valor(l), 58, 30, "el escritorio, versión 0.8", 0xD3E7FD)
        fin
        rectángulo(valor(l), 1, MENÚ_CABEZA, MENÚ_ANCHO - 2, 2, NARANJA)
        ; las dos columnas
        rectángulo(valor(l), 2, MENÚ_CABEZA + 2, MENÚ_COLUMNA - 2, menú_alto - MENÚ_CABEZA - MENÚ_PIE - 2, BLANCO)
        rectángulo(valor(l), MENÚ_COLUMNA, MENÚ_CABEZA + 2, MENÚ_ANCHO - MENÚ_COLUMNA - 2, menú_alto - MENÚ_CABEZA - MENÚ_PIE - 2, AZUL_CLARO)
        rectángulo(valor(l), MENÚ_COLUMNA, MENÚ_CABEZA + 2, 1, menú_alto - MENÚ_CABEZA - MENÚ_PIE - 2, 0xA9C6EC)
        ; a la izquierda: los programas
        yy := MENÚ_CABEZA + 10
        texto_negrita(valor(l), 12, yy, "Programas", TINTA_SUAVE)
        rectángulo(valor(l), 12, yy + 19, MENÚ_COLUMNA - 26, 1, 0xC9D8EC)
        yy := yy + 26
        pinta_opción(valor(l), 4, yy, MENÚ_COLUMNA - 6, "Bloc de notas", AM_BLOC, 0, cierto)
        icono_hoja(valor(l), 14, yy + 4, 0x4C97EC)
        yy := yy + ALTO_OPCIÓN + 2
        pinta_opción(valor(l), 4, yy, MENÚ_COLUMNA - 6, "Consola", AM_CONSOLA, 0, cierto)
        icono_consola(valor(l), 13, yy + 6)
        yy := yy + ALTO_OPCIÓN + 2
        pinta_opción(valor(l), 4, yy, MENÚ_COLUMNA - 6, "Mi equipo", AM_EQUIPO, 0, cierto)
        redondeado(valor(l), 13, yy + 6, 24, 17, 2, 0x4F6890, 0x4F6890, TODAS)
        degradado(valor(l), 15, yy + 8, 20, 13, 0x7FC2FA, 0x2A7AD6)
        rectángulo(valor(l), 22, yy + 23, 6, 2, 0x7F95B6)
        rectángulo(valor(l), 17, yy + 25, 16, 3, 0x6F87A8)
        ; los programas de los paquetes (accesos.cas: \HISPA\MENU\*.MNU)
        i := 0
        mientras i < n_accesos hacer
            yy := yy + ALTO_OPCIÓN + 2
            pinta_opción(valor(l), 4, yy, MENÚ_COLUMNA - 6, nombre_de(i), AM_ACCESO, i, cierto)
            icono_acceso(valor(l), 13, yy + 5, i, 2)
            i := i + 1
        fin
        ; y la oficina de Hispa-386 (programas de Hispa Ventanas: HVPRUN.BIN)
        yy := yy + ALTO_OPCIÓN + 4
        texto_negrita(valor(l), 12, yy, "Oficina", TINTA_SUAVE)
        rectángulo(valor(l), 12, yy + 19, MENÚ_COLUMNA - 26, 1, 0xC9D8EC)
        yy := yy + 22
        i := 0
        mientras i < N_OFICINA hacer
            pinta_opción_de(valor(l), 4, yy, MENÚ_COLUMNA - 6, ALTO_OFICINA, de_oficina(i, falso), AM_OFICINA, i, cierto)
            icono_hoja(valor(l), 14, yy + 1, color_oficina(i))
            yy := yy + ALTO_OFICINA
            i := i + 1
        fin
        ; a la derecha: los documentos y la configuración
        yy := MENÚ_CABEZA + 10
        texto_negrita(valor(l), MENÚ_COLUMNA + 10, yy, "Documentos", TINTA_SUAVE)
        rectángulo(valor(l), MENÚ_COLUMNA + 10, yy + 19, MENÚ_ANCHO - MENÚ_COLUMNA - 22, 1, 0xA9C6EC)
        yy := yy + 24
        si n_documentos = 0 entonces
            texto(valor(l), MENÚ_COLUMNA + 14, yy + 6, "(no hay ninguno)", TINTA_SUAVE)
            yy := yy + 28
        sino
            i := 0
            mientras i < n_documentos hacer
                pinta_opción(valor(l), MENÚ_COLUMNA + 2, yy, MENÚ_ANCHO - MENÚ_COLUMNA - 4, documentos[i], AM_DOCUMENTO, i, falso)
                icono_hoja(valor(l), MENÚ_COLUMNA + 12, yy + 4, 0x46C282)
                yy := yy + ALTO_OPCIÓN
                i := i + 1
            fin
        fin
        yy := menú_alto - MENÚ_PIE - ALTO_OPCIÓN - 6
        ; (encima de Configuración, «Actualizar»: los programas y las actualizaciones)
        pinta_opción_de(valor(l), MENÚ_COLUMNA + 2, yy - 37, MENÚ_ANCHO - MENÚ_COLUMNA - 4, 30, "Actualizar", AM_PROGRAMAS, 0, cierto)
        redondeado(valor(l), MENÚ_COLUMNA + 13, yy - 31, 18, 17, 2, 0x9A6A1E, 0x9A6A1E, TODAS)
        redondeado(valor(l), MENÚ_COLUMNA + 14, yy - 30, 16, 15, 1, 0xF2C46C, 0xD69A3A, TODAS)
        rectángulo(valor(l), MENÚ_COLUMNA + 21, yy - 30, 2, 15, 0xB9822F)
        rectángulo(valor(l), MENÚ_COLUMNA + 10, yy - 5, MENÚ_ANCHO - MENÚ_COLUMNA - 22, 1, 0xA9C6EC)
        pinta_opción(valor(l), MENÚ_COLUMNA + 2, yy, MENÚ_ANCHO - MENÚ_COLUMNA - 4, "Configuración", AM_CONFIG, 0, cierto)
        si elegida >= 0 y opciones[elegida].acción = AM_CONFIG entonces
            icono_rueda(valor(l), MENÚ_COLUMNA + 11, yy + 5, AZUL_ELEGIDO)
        sino
            icono_rueda(valor(l), MENÚ_COLUMNA + 11, yy + 5, AZUL_CLARO)
        fin
        ; el pie: «Apagar el equipo»
        degradado(valor(l), 1, menú_alto - MENÚ_PIE, MENÚ_ANCHO - 2, MENÚ_PIE - 1, 0x3D86E2, 0x1C5CB8)
        rectángulo(valor(l), 1, menú_alto - MENÚ_PIE, MENÚ_ANCHO - 2, 1, 0x7FB6F4)
        i := nat32(nueva_opción(MENÚ_ANCHO - 190, menú_alto - MENÚ_PIE + 5, 182, MENÚ_PIE - 10, AM_APAGAR, 0))
        si ent32(i) = elegida entonces
            redondeado(valor(l), MENÚ_ANCHO - 190, menú_alto - MENÚ_PIE + 5, 182, MENÚ_PIE - 10, 5, 0x6AAEF6, 0x3A7EDC, TODAS)
        fin
        icono_apagar(valor(l), MENÚ_ANCHO - 184, menú_alto - MENÚ_PIE + 10)
        texto_negrita(valor(l), MENÚ_ANCHO - 153, menú_alto - MENÚ_PIE + 14, "Apagar el equipo", 0x123F85)
        texto_negrita(valor(l), MENÚ_ANCHO - 154, menú_alto - MENÚ_PIE + 13, "Apagar el equipo", BLANCO)
        repintada(v_menú, 0, 0, MENÚ_ANCHO, menú_alto)
    fin

    ; vuelve a leer los accesos de los paquetes (accesos.cas); si han
    ; cambiado, el menú cambia de alto y los iconos del tapiz se rehacen
    ; (al arrancar, los iconos los pone quien arranca)
    variable firma_accesos: arreglo [200] de byte
    función pon_accesos()
        variable i, k: nat32
        variable alto_nuevo: ent32
        variable firma: arreglo [200] de byte
        lee_accesos()
        firma[0] := 0
        i := 0
        mientras i < n_accesos hacer
            copiar_hasta(dirección(firma[longitud(firma)]), nombre_de(i), 200 - longitud(firma))
            si en_escritorio(i) entonces añadir_car(firma, '*') fin
            añadir_car(firma, '|')
            i := i + 1
        fin
        si iguales(firma, firma_accesos) entonces devolver fin
        copiar(firma_accesos, firma)
        ; el menú, más alto (si la pantalla da)
        alto_nuevo := MENÚ_ALTO + ent32(n_accesos) * (ALTO_OPCIÓN + 2)
        si alto_nuevo > pantalla.alto - ALTO_BARRA - 8 entonces alto_nuevo := pantalla.alto - ALTO_BARRA - 8 fin
        si alto_nuevo <> menú_alto y v_menú <> 0 entonces
            menú_alto := alto_nuevo
            cerrar_ventana(v_menú, 0)
            v_menú := crear_ventana("menú", 0, pantalla.alto - ALTO_BARRA - menú_alto, MENÚ_ANCHO, menú_alto, SIN_MARCO ob ENCIMA ob OCULTA ob REDONDA, 0)
        fin
        menú_alto := alto_nuevo
        si v_fondo = 0 entonces devolver fin
        ; los iconos del tapiz: los de siempre y los de los accesos que lo piden
        quita_iconos()
        k := 0
        i := 0
        mientras i < n_iconos hacer
            si iconos[i].acción <> AM_ACCESO entonces
                iconos[k].x := iconos[i].x
                iconos[k].ye := iconos[i].ye
                iconos[k].acción := iconos[i].acción
                iconos[k].dato := iconos[i].dato
                iconos[k].nombre := iconos[i].nombre
                iconos[k].debajo := iconos[i].debajo
                k := k + 1
            sino
                liberar(puntero(iconos[i].debajo))
            fin
            i := i + 1
        fin
        n_iconos := k
        i := 0
        mientras i < n_accesos hacer
            si en_escritorio(i) entonces nuevo_icono_de(nombre_de(i), AM_ACCESO, i) fin
            i := i + 1
        fin
        icono_elegido := -1
        organiza_iconos()
        pon_iconos()
    fin

    función abre_menú()
        lee_documentos()
        pon_accesos()
        elegida := -1
        menú_abierto := cierto
        pinta_menú()
        mostrar(v_menú, cierto)
        emergente := v_menú
        teclas_a := v_menú
        pinta_barra()
    fin

    función cierra_menú()
        si no menú_abierto entonces devolver fin
        menú_abierto := falso
        si emergente = v_menú entonces emergente := 0 fin
        si teclas_a = v_menú entonces teclas_a := 0 fin
        mostrar(v_menú, falso)
        pinta_barra()
    fin

    ; la opción del menú que está en ese punto; -1 si no hay
    función opción_en(x: ent32, yy: ent32): ent32
        variable i: nat32
        i := 0
        mientras i < n_opciones hacer
            si x >= opciones[i].x y yy >= opciones[i].ye y x < opciones[i].x + opciones[i].an y yy < opciones[i].ye + opciones[i].al entonces
                devolver ent32(i)
            fin
            i := i + 1
        fin
        devolver -1
    fin

    ; -------------------------------------------------------------------------
    ;  Los cuadros: avisos, apagar, configuración
    ; -------------------------------------------------------------------------
    ; un cuadro nuevo (una ventana con marco que no se maximiza), centrado
    función cuadro(nombre: puntero a byte, an: ent32, al: ent32): nat32
        devolver crear_ventana(nombre, (pantalla.ancho - an) div 2, (pantalla.alto - ALTO_BARRA - al) div 2 - 20, an, al, FIJA, 0)
    fin

    función cierra_cuadro(ref v: nat32)
        si v = 0 entonces devolver fin
        quita_pulsadores(v)
        cerrar_ventana(v, 0)
        v := 0
    fin

    ; un aviso con su botón «Aceptar»
    función aviso(t: puntero a byte)
        variable l: puntero a Lienzo
        cierra_cuadro(v_aviso)
        v_aviso := cuadro("Hispa-Pentium", 440, 118)
        l := lienzo_de(v_aviso)
        si l = nulo entonces
            v_aviso := 0
            devolver
        fin
        círculo(valor(l), 34, 38, 16, NARANJA)
        rectángulo(valor(l), 32, 28, 4, 13, BLANCO)
        rectángulo(valor(l), 32, 44, 4, 4, BLANCO)
        texto(valor(l), 64, 30, t, TINTA)
        pulsador(v_aviso, 170, 76, 100, 30, "Aceptar", 0x5AA6F4, 0x2468C8, AC_CERRAR_AVISO)
        repintada(v_aviso, 0, 0, 440, 118)
        escribir("escritorio: aviso: ", t, "\n")
    fin

    ; el globo de los avisos del USB, encima de la bandeja: se va solo a los
    ; pocos segundos (o con un clic)
    función cierra_globo()
        si v_globo = 0 entonces devolver fin
        cerrar_ventana(v_globo, 0)
        v_globo := 0
    fin

    variable globo_título: puntero a byte       ; (dock) el título del globo que viene (nulo: «USB»)
    función globo(t: puntero a byte)
        variable l: puntero a Lienzo
        variable an: ent32
        cierra_globo()
        an := ancho_texto(t) + 60
        si an < 220 entonces an := 220 fin
        si an > pantalla.ancho - 8 entonces an := pantalla.ancho - 8 fin
        v_globo := crear_ventana("aviso", pantalla.ancho - an - 4, pantalla.alto - ALTO_BARRA - GLOBO_AL - 4, an, GLOBO_AL, SIN_MARCO ob ENCIMA, 0)
        l := lienzo_de(v_globo)
        si l = nulo entonces
            v_globo := 0
            devolver
        fin
        rectángulo(valor(l), 0, 0, an, GLOBO_AL, 0x1A56AC)
        redondeado(valor(l), 1, 1, an - 2, GLOBO_AL - 2, 6, 0xFFFDF2, 0xF1EACB, TODAS)
        ; (dock) el globo de lo que se suelta desde el explorador lleva otro título
        si globo_título = nulo entonces
            icono_memoria(valor(l), 15, 17)
            texto_negrita(valor(l), 44, 9, "USB", TINTA)
        sino
            disquete(valor(l), 10, 14, 24)
            texto_negrita(valor(l), 44, 9, globo_título, TINTA)
            globo_título := nulo
        fin
        texto(valor(l), 44, 30, t, TINTA)
        repintada(v_globo, 0, 0, an, GLOBO_AL)
        globo_hasta := tics + 6 * HZ
        escribir("escritorio: globo: ", t, "\n")
    fin

    ; el icono de las memorias USB de la bandeja: un menú con «Quitar con
    ; seguridad» para cada una (en gris, la del sistema)
    función menú_usb(x: ent32)
        variable i, grises: nat32
        variable d: arreglo [1] de nat32
        renglón[0] := 0
        grises := 0
        i := 0
        mientras i < n_usb y i < 3 hacer
            si i > 0 entonces concatenar(renglón, "|") fin
            d[0] := usb_letras[i]
            formatear(dirección(renglón[longitud(renglón)]), 30, "Quitar con seguridad %c:", d)
            si no quitable(Unidades.por_letra(usb_letras[i])) entonces grises := grises ob (nat32(1) << i) fin
            i := i + 1
        fin
        si i > 0 entonces abrir_emergente(x, pantalla.alto - ALTO_BARRA, renglón, grises, 0, ME_USB) fin
    fin

    función atiende_globo()
        variable e: Evento
        mientras v_globo <> 0 y saca_evento(v_globo, 0, e) hacer
            si e.clase = EV_RATÓN_BAJA entonces cierra_globo() fin
        fin
        si v_globo <> 0 y tics >= globo_hasta entonces cierra_globo() fin
        si saca_aviso(texto_globo, 80) entonces globo(texto_globo) fin
        si Unidades.cambios <> unidades_vistas entonces
            unidades_vistas := Unidades.cambios
            pinta_barra()
        fin
    fin

    función abre_apagar()
        variable l: puntero a Lienzo
        si v_apagar <> 0 entonces
            cierra_cuadro(v_apagar)
        fin
        v_apagar := cuadro("Apagar el equipo", 420, 150)
        l := lienzo_de(v_apagar)
        si l = nulo entonces
            v_apagar := 0
            devolver
        fin
        degradado(valor(l), 0, 0, 420, 150, 0xEAF3FE, 0xC4DCF8)
        disquete(valor(l), 14, 10, 44)
        texto_negrita(valor(l), 70, 16, "¿Qué quiere hacer con el equipo?", TINTA)
        texto(valor(l), 70, 38, "Guarde antes lo que tenga a medias.", TINTA_SUAVE)
        pulsador(v_apagar, 22, 92, 118, 38, "Apagar", 0xF59A5E, 0xD2571E, AC_APAGAR)
        pulsador(v_apagar, 151, 92, 118, 38, "Reiniciar", VERDE_ARRIBA, VERDE_ABAJO, AC_REINICIAR)
        pulsador(v_apagar, 280, 92, 118, 38, "Cancelar", 0x5AA6F4, 0x2468C8, AC_CANCELAR)
        repintada(v_apagar, 0, 0, 420, 150)
    fin

    ; «Acerca de Hispa-Pentium»
    función abre_acerca()
        variable l: puntero a Lienzo
        si v_acerca <> 0 entonces cierra_cuadro(v_acerca) fin
        v_acerca := cuadro("Acerca de Hispa-Pentium", 440, 214)
        l := lienzo_de(v_acerca)
        si l = nulo entonces
            v_acerca := 0
            devolver
        fin
        degradado(valor(l), 0, 0, 440, 214, 0xF4F8FE, 0xD6E6FA)
        disquete(valor(l), 16, 14, 64)
        texto_negrita(valor(l), 96, 16, "Hispa-Pentium 0.8", TINTA)
        texto(valor(l), 96, 38, "Un núcleo de 32 bits, sin DOS debajo,", TINTA)
        texto(valor(l), 96, 56, "escrito en Castel, con su escritorio.", TINTA)
        texto(valor(l), 96, 74, "De la familia de Hispa-DOS.", TINTA_SUAVE)
        rectángulo(valor(l), 16, 104, 408, 1, 0xA9C6EC)
        texto(valor(l), 16, 114, "Copyright (C) 2026 Carlos Sanz y contribuidores.", TINTA)
        texto(valor(l), 16, 134, "Software libre: GPL-2.0 o posterior.", TINTA_SUAVE)
        pulsador(v_acerca, 324, 168, 100, 32, "Aceptar", 0x5AA6F4, 0x2468C8, AC_CERRAR_ACERCA)
        repintada(v_acerca, 0, 0, 440, 214)
    fin

    función pinta_config()
        variable l: puntero a Lienzo
        variable d: arreglo [4] de nat32
        l := lienzo_de(v_config)
        si l = nulo entonces devolver fin
        quita_pulsadores(v_config)
        degradado(valor(l), 0, 0, 460, 280, 0xF4F8FE, 0xD6E6FA)
        disquete(valor(l), 14, 10, 48)
        texto_negrita(valor(l), 74, 14, "Hispa-Pentium 0.8", TINTA)
        texto(valor(l), 74, 34, "un núcleo de 32 bits escrito en Castel", TINTA_SUAVE)
        rectángulo(valor(l), 14, 66, 432, 1, 0xA9C6EC)
        d[0] := nat32(pantalla.ancho)
        d[1] := nat32(pantalla.alto)
        d[2] := bits_pantalla
        formatear(renglón, 96, "Pantalla:  %u x %u, %u bits por punto", d)
        texto(valor(l), 20, 78, renglón, TINTA)
        pulsador(v_config, 358, 72, 88, 26, "Cambiar...", 0x5AA6F4, 0x2468C8, AC_PANTALLA)
        d[0] := (límite + 0xFFFFF) div 0x100000
        d[1] := marcos_libres() * 4 div 1024
        d[2] := cuántas_tareas()
        formatear(renglón, 96, "Memoria:   %u MB (%u MB libres); %u tareas", d)
        texto(valor(l), 20, 100, renglón, TINTA)
        texto(valor(l), 20, 136, "Teclado:", TINTA)
        si teclado_español() entonces
            pulsador(v_config, 110, 128, 110, 30, "Español", VERDE_ARRIBA, VERDE_ABAJO, AC_TECLADO_ES)
            pulsador(v_config, 228, 128, 110, 30, "EE. UU.", 0xA9BDD8, 0x7C95B8, AC_TECLADO_US)
        sino
            pulsador(v_config, 110, 128, 110, 30, "Español", 0xA9BDD8, 0x7C95B8, AC_TECLADO_ES)
            pulsador(v_config, 228, 128, 110, 30, "EE. UU.", VERDE_ARRIBA, VERDE_ABAJO, AC_TECLADO_US)
        fin
        texto(valor(l), 20, 182, "Tapiz:", TINTA)
        si fondo = 0 entonces
            pulsador(v_config, 110, 174, 100, 30, "Olas", VERDE_ARRIBA, VERDE_ABAJO, AC_FONDO)
        sino
            pulsador(v_config, 110, 174, 100, 30, "Olas", 0xA9BDD8, 0x7C95B8, AC_FONDO)
        fin
        si fondo = 1 entonces
            pulsador(v_config, 218, 174, 100, 30, "Azul", VERDE_ARRIBA, VERDE_ABAJO, AC_FONDO + 1)
        sino
            pulsador(v_config, 218, 174, 100, 30, "Azul", 0xA9BDD8, 0x7C95B8, AC_FONDO + 1)
        fin
        si fondo = 2 entonces
            pulsador(v_config, 326, 174, 100, 30, "Verde", VERDE_ARRIBA, VERDE_ABAJO, AC_FONDO + 2)
        sino
            pulsador(v_config, 326, 174, 100, 30, "Verde", 0xA9BDD8, 0x7C95B8, AC_FONDO + 2)
        fin
        ; (dock) verlo o no
        texto(valor(l), 20, 236, "Dock:", TINTA)
        si Dock.visible entonces
            pulsador(v_config, 110, 228, 100, 30, "Visible", VERDE_ARRIBA, VERDE_ABAJO, AC_DOCK_SÍ)
            pulsador(v_config, 218, 228, 100, 30, "Oculto", 0xA9BDD8, 0x7C95B8, AC_DOCK_NO)
        sino
            pulsador(v_config, 110, 228, 100, 30, "Visible", 0xA9BDD8, 0x7C95B8, AC_DOCK_SÍ)
            pulsador(v_config, 218, 228, 100, 30, "Oculto", VERDE_ARRIBA, VERDE_ABAJO, AC_DOCK_NO)
        fin
        pulsador(v_config, 346, 232, 100, 32, "Cerrar", 0x5AA6F4, 0x2468C8, AC_CERRAR_CONFIG)
        repintada(v_config, 0, 0, 460, 280)
    fin

    función abre_config()
        si v_config <> 0 entonces cierra_cuadro(v_config) fin
        v_config := cuadro("Configuración", 460, 280)
        pinta_config()
    fin

    ; -------------------------------------------------------------------------
    ;  La medida de la pantalla (Configuración > Cambiar...)
    ;
    ;  Con la VBE de Bochs (QEMU, Bochs, VirtualBox con VBoxVGA o VMSVGA), se
    ;  cambia en el momento: «Probar...» la pone, y si no se dice «Mantener»
    ;  en 15 s, vuelve sola la de antes. En un PC sin ella, el modo lo pone
    ;  GRUB al arrancar: en un sistema instalado se guarda en
    ;  \HISPA\PANTALLA.ENV (que lee GRUB.CFG) y se reinicia; al arrancar con
    ;  ella, lo mismo: 15 s para darla por buena, y si no (o si se reinicia
    ;  antes, con la pantalla a oscuras), GRUB vuelve a la de antes.
    ; -------------------------------------------------------------------------
    ; las medidas que se ofrecen (las que la tarjeta y la pantalla puedan)
    función candidato(i: nat32, ref an: nat32, ref al: nat32)
        según i
            caso 0:
                an := 800
                al := 600
            caso 1:
                an := 1024
                al := 600
            caso 2:
                an := 1024
                al := 768
            caso 3:
                an := 1152
                al := 864
            caso 4:
                an := 1280
                al := 720
            caso 5:
                an := 1280
                al := 800
            caso 6:
                an := 1280
                al := 1024
            caso 7:
                an := 1366
                al := 768
            caso 8:
                an := 1440
                al := 900
            caso 9:
                an := 1600
                al := 900
            caso 10:
                an := 1600
                al := 1200
            caso 11:
                an := 1680
                al := 1050
            si no:
                an := 1920
                al := 1080
        fin
    fin

    ; ¿se puede guardar para el próximo arranque? (instalado, y con permiso)
    función se_guarda(): bool
        devolver instalado() y escribible(del_sistema)
    fin

    ; la lista de modos: los de la lista que caben en la tarjeta (su máximo y
    ; su memoria), en la pantalla (si dice lo que puede) y en la memoria del
    ; núcleo (el doble búfer y el tapiz); el de ahora, siempre
    función prepara_modos()
        variable i, a, l, ma, ml, vram, ea, el, libres, k: nat32
        variable hay_edid, vale, está: bool
        en_marcha := se_cambia_en_marcha()
        ma := 0
        ml := 0
        vram := 0
        hay_edid := falso
        monitor_an := 0
        monitor_al := 0
        si en_marcha entonces
            máximo_tarjeta(ma, ml)
            vram := memoria_tarjeta()
            hay_edid := medida_monitor(monitor_an, monitor_al, ea, el)
            si no hay_edid entonces
                monitor_an := 0
                monitor_al := 0
            fin
        fin
        libres := marcos_libres()
        n_modos := 0
        está := falso
        para i desde 0 hasta N_CANDIDATOS - 1 hacer
            candidato(i, a, l)
            vale := a * l * 4 <= VENTANA_PANTALLA
            si en_marcha entonces
                si ma >= 640 y (a > ma o l > ml) entonces vale := falso fin
                si a mod paso_ancho() <> 0 entonces vale := falso fin
                si vram > 0 y a * l * 4 > vram entonces vale := falso fin
                si hay_edid y (a > ea o l > el) entonces vale := falso fin
                si libres < (a * l * 8 + 0x200000) div 4096 entonces vale := falso fin
            sino
                ; (al arrancar: lo de arranca(), con lo que ahora tienen el doble búfer y el tapiz)
                si libres + nat32(pantalla.ancho * pantalla.alto) * 8 div 4096 < (a * l * 12 + 0x300000) div 4096 entonces vale := falso fin
            fin
            si a = nat32(pantalla.ancho) y l = nat32(pantalla.alto) entonces
                vale := cierto
                está := cierto
            fin
            ; el de ahora, en su sitio, aunque no sea de la lista
            si no está y n_modos < MAX_MODOS - 1 y (a > nat32(pantalla.ancho) o (a = nat32(pantalla.ancho) y l > nat32(pantalla.alto))) entonces
                modos_an[n_modos] := nat32(pantalla.ancho)
                modos_al[n_modos] := nat32(pantalla.alto)
                n_modos := n_modos + 1
                está := cierto
            fin
            si vale y n_modos < MAX_MODOS - 1 entonces
                modos_an[n_modos] := a
                modos_al[n_modos] := l
                n_modos := n_modos + 1
            fin
        fin
        si no está entonces
            modos_an[n_modos] := nat32(pantalla.ancho)
            modos_al[n_modos] := nat32(pantalla.alto)
            n_modos := n_modos + 1
        fin
        ; sin cambio en marcha: también «a la medida de la pantalla» (lo que diga a GRUB)
        si no en_marcha entonces
            modos_an[n_modos] := 0
            modos_al[n_modos] := 0
            n_modos := n_modos + 1
        fin
        ; el elegido: el de ahora
        modo_elegido := 0
        para k desde 0 hasta n_modos - 1 hacer
            si modos_an[k] = nat32(pantalla.ancho) y modos_al[k] = nat32(pantalla.alto) entonces modo_elegido := ent32(k) fin
        fin
    fin

    función pinta_pantalla()
        variable l: puntero a Lienzo
        variable d: arreglo [4] de nat32
        variable i: nat32
        variable x, yy: ent32
        variable arriba, abajo, acción: nat32
        variable guarda: bool
        variable rótulo: arreglo [24] de byte
        l := lienzo_de(v_pantalla)
        si l = nulo entonces devolver fin
        quita_pulsadores(v_pantalla)
        guarda := se_guarda()
        degradado(valor(l), 0, 0, PANTALLA_AN, PANTALLA_AL, 0xF4F8FE, 0xD6E6FA)
        icono_equipo(valor(l), 16, 12)
        texto_negrita(valor(l), 60, 12, "La medida de la pantalla", TINTA)
        d[0] := nat32(pantalla.ancho)
        d[1] := nat32(pantalla.alto)
        d[2] := bits_pantalla
        formatear(renglón, 96, "Ahora: %u x %u, %u bits por punto.", d)
        texto(valor(l), 60, 32, renglón, TINTA_SUAVE)
        si en_marcha entonces
            texto(valor(l), 20, 60, "Elija una y pruébela: se pone en el momento, y si no", TINTA)
            texto(valor(l), 20, 78, "se ve bien, vuelve sola a la de antes en 15 segundos.", TINTA)
        sino si guarda entonces
            texto(valor(l), 20, 60, "Esta tarjeta no deja cambiarla en marcha: se guarda y", TINTA)
            texto(valor(l), 20, 78, "se pone al arrancar otra vez (con 15 s para probarla).", TINTA)
        sino
            texto(valor(l), 20, 60, "Esta tarjeta no deja cambiarla en marcha, y sin instalar", TINTA)
            texto(valor(l), 20, 78, "no se guarda: «a la medida de la pantalla», al arrancar.", TINTA)
        fin
        para i desde 0 hasta n_modos - 1 hacer
            x := 20 + ent32(i mod 3) * 162
            yy := 104 + ent32(i div 3) * 34
            si modos_an[i] = 0 entonces
                Textos32.copiar(rótulo, "A la medida")
            sino
                d[0] := modos_an[i]
                d[1] := modos_al[i]
                formatear(rótulo, 24, "%u x %u", d)
            fin
            si ent32(i) = modo_elegido entonces
                arriba := VERDE_ARRIBA
                abajo := VERDE_ABAJO
            sino si modos_an[i] = nat32(pantalla.ancho) y modos_al[i] = nat32(pantalla.alto) entonces
                arriba := 0x5AA6F4
                abajo := 0x2468C8
            sino
                arriba := 0xA9BDD8
                abajo := 0x7C95B8
            fin
            acción := AC_MODO + i
            si no en_marcha y no guarda entonces acción := 0 fin
            pulsador(v_pantalla, x, yy, 154, 28, rótulo, arriba, abajo, acción)
        fin
        yy := 104 + ent32((n_modos + 2) div 3) * 34 + 2
        si monitor_an > 0 entonces
            d[0] := monitor_an
            d[1] := monitor_al
            formatear(renglón, 96, "La pantalla dice que prefiere %u x %u.", d)
            texto(valor(l), 20, yy, renglón, TINTA_SUAVE)
            yy := yy + 18
        fin
        texto(valor(l), 20, yy, texto_pantalla, TINTA)
        si en_marcha entonces
            pulsador(v_pantalla, 20, PANTALLA_AL - 46, 130, 32, "Probar...", VERDE_ARRIBA, VERDE_ABAJO, AC_PROBAR)
        sino si guarda entonces
            pulsador(v_pantalla, 20, PANTALLA_AL - 46, 220, 32, "Guardar y reiniciar...", VERDE_ARRIBA, VERDE_ABAJO, AC_GUARDAR_MODO)
        fin
        pulsador(v_pantalla, PANTALLA_AN - 120, PANTALLA_AL - 46, 100, 32, "Cerrar", 0x5AA6F4, 0x2468C8, AC_CERRAR_PANTALLA)
        repintada(v_pantalla, 0, 0, PANTALLA_AN, PANTALLA_AL)
    fin

    función abre_pantalla()
        si v_pantalla <> 0 entonces cierra_cuadro(v_pantalla) fin
        prepara_modos()
        v_pantalla := cuadro("Pantalla", PANTALLA_AN, PANTALLA_AL)
        pinta_pantalla()
    fin

    ; ---- \HISPA\PANTALLA.ENV ----
    ; lo que vale «clave=» en el texto del bloque, a destino (vacío si no está)
    función valor_env(clave: puntero a byte, destino: puntero a byte, cabe: nat32)
        variable p: puntero a byte
        variable n: nat32
        destino[0] := 0
        p := buscar(texto_env, clave)
        si p = nulo entonces devolver fin
        p := p + longitud(clave)
        n := 0
        mientras valor(p) > ' ' y valor(p) <> '#' y n + 1 < cabe hacer
            destino[n] := valor(p)
            n := n + 1
            p := p + 1
        fin
        destino[n] := 0
    fin

    ; lee el bloque (si no está: todo vacío y la prueba a 0)
    función lee_env()
        variable m, n: nat32
        variable t: arreglo [4] de byte
        env_pantalla[0] := 0
        env_antes[0] := 0
        env_prueba := '0'
        si no instalado() entonces devolver fin
        m := abrir_archivo(del_sistema, "\\HISPA\\PANTALLA.ENV", PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver fin
        n := leer_archivo(m, texto_env, 1024)
        cerrar_archivo(m)
        si n > 1024 entonces n := 0 fin
        texto_env[n] := 0
        valor_env("\npantalla=", env_pantalla, 16)
        valor_env("\nantes=", env_antes, 16)
        valor_env("\nprueba=", t, 4)
        si t[0] = '1' o t[0] = '2' entonces env_prueba := t[0] fin
    fin

    ; lo escribe (1024 octetos, como los de GRUB: así GRUB puede escribir en
    ; él, en su sitio, con save_env). Falso si no se puede.
    función escribe_env(): bool
        variable m, n: nat32
        variable d: arreglo [3] de nat32
        d[0] := nat32(dirección(env_pantalla[0]))
        d[1] := nat32(dirección(env_antes[0]))
        d[2] := env_prueba
        llenar(texto_env, 1024, '#')
        formatear(texto_env, 200, "# GRUB Environment Block\npantalla=%s\nantes=%s\nprueba=%c\n", d)
        texto_env[longitud(texto_env)] := '#'
        m := abrir_archivo(del_sistema, "\\HISPA\\PANTALLA.ENV", PARA_ESCRIBIR)
        si m >= PRIMER_ERROR entonces m := abrir_archivo(del_sistema, "\\HISPA\\PANTALLA.ENV", PARA_CREAR) fin
        si m >= PRIMER_ERROR entonces devolver falso fin
        n := escribir_archivo(m, texto_env, 1024)
        cerrar_archivo(m)
        si n <> 1024 entonces devolver falso fin
        escribir("escritorio: PANTALLA.ENV: pantalla=", env_pantalla, " antes=", env_antes, " prueba=")
        escribir_car(env_prueba)
        escribir("\n")
        devolver cierto
    fin

    ; que GRUB.CFG lea PANTALLA.ENV: si aún no lo hace (un sistema instalado
    ; con la 0.8), se le añade al final lo que hace falta (va antes de que se
    ; arranque nada: GRUB lee todo el archivo antes de enseñar el menú)
    función grub_lee_env(): bool
        variable m, n, k: nat32
        variable e: puntero a byte
        m := abrir_archivo(del_sistema, "\\HISPA\\GRUB.CFG", PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver falso fin
        n := 0
        mientras n < 8192 hacer
            k := leer_archivo(m, dirección(texto_grub[n]), 8192 - n)
            si k = 0 o k > 8192 entonces romper fin
            n := n + k
        fin
        cerrar_archivo(m)
        texto_grub[n] := 0
        si buscar(texto_grub, "PANTALLA.ENV") <> nulo entonces devolver cierto fin
        m := abrir_archivo(del_sistema, "\\HISPA\\GRUB.CFG", PARA_AÑADIR)
        si m >= PRIMER_ERROR entonces devolver falso fin
        e := "\n# la medida de la pantalla que se elige en Configuracion (\\HISPA\\PANTALLA.ENV,\n# la escribe el escritorio): prueba=1, se va a probar; 2, se esta probando\n# (si se vuelve a arrancar sin darla por buena, vuelve la de antes)\nif [ -f /HISPA/PANTALLA.ENV ]; then\n  load_env -f /HISPA/PANTALLA.ENV pantalla antes prueba\n  if [ \"$prueba\" = 2 ]; then\n    set pantalla=\"$antes\"\n    set antes=\n    set prueba=0\n    save_env -f /HISPA/PANTALLA.ENV pantalla antes prueba\n  elif [ \"$prueba\" = 1 ]; then\n    set prueba=2\n    save_env -f /HISPA/PANTALLA.ENV prueba\n  fi\n  if [ \"$pantalla\" = auto ]; then\n    set modo=auto\n  elif [ -n \"$pantalla\" ]; then\n    set modo=\"${pantalla}x32,${pantalla},${modo}\"\n  fi\nfi\n"
        n := escribir_archivo(m, e, longitud(e))
        cerrar_archivo(m)
        escribir("escritorio: GRUB.CFG lee ahora PANTALLA.ENV\n")
        devolver n = longitud(e)
    fin

    ; la medida «an x al» (o «auto»), como texto
    función medida_texto(an: nat32, al: nat32, destino: puntero a byte)
        variable d: arreglo [2] de nat32
        si an = 0 entonces
            Textos32.copiar(destino, "auto")
            devolver
        fin
        d[0] := an
        d[1] := al
        formatear(destino, 16, "%ux%u", d)
    fin

    ; guarda la medida para los próximos arranques; con «probar», a prueba
    ; (la de antes queda apuntada para volver a ella)
    función guarda_medida(an: nat32, al: nat32, probar: bool): bool
        si no se_guarda() entonces devolver falso fin
        lee_env()
        si probar entonces
            si env_prueba = '0' entonces Textos32.copiar(env_antes, env_pantalla) fin
            env_prueba := '1'
        sino
            env_antes[0] := 0
            env_prueba := '0'
        fin
        medida_texto(an, al, env_pantalla)
        si no grub_lee_env() entonces devolver falso fin
        devolver escribe_env()
    fin

    ; pone la pantalla a otra medida en marcha y le pone al escritorio la
    ; suya: la barra, el menú, el tapiz, los iconos y los cuadros. Falso si
    ; no se puede (y todo sigue como estaba).
    función cambia_medida(an: nat32, al: nat32): bool
        variable i: nat32
        variable d: arreglo [2] de nat32
        cierra_menú()
        cerrar_emergente()
        cierra_globo()
        quita_ayuda()
        si no cambia_pantalla(ent32(an), ent32(al)) entonces devolver falso fin
        recolocar_ventana(v_barra, 0, ent32(al) - ALTO_BARRA, ent32(an), ALTO_BARRA)
        mover_ventana(v_menú, 0, ent32(al) - ALTO_BARRA - MENÚ_ALTO)
        recoloca_dock()                         ; (dock)
        ; los iconos, dentro (sin quitarlos del tapiz: es nuevo)
        para i desde 0 hasta MAX_ICONOS - 1 hacer
            si i < n_iconos entonces
                si iconos[i].x > ent32(an) - CELDA_AN entonces iconos[i].x := ent32(an) - CELDA_AN fin
                si iconos[i].ye > ent32(al) - ALTO_BARRA - CELDA_AL entonces iconos[i].ye := ent32(al) - ALTO_BARRA - CELDA_AL fin
            fin
        fin
        pinta_tapiz()
        si v_config <> 0 entonces centrar_ventana(v_config) fin
        si v_aviso <> 0 entonces centrar_ventana(v_aviso) fin
        si v_apagar <> 0 entonces centrar_ventana(v_apagar) fin
        si v_acerca <> 0 entonces centrar_ventana(v_acerca) fin
        si v_pantalla <> 0 entonces centrar_ventana(v_pantalla) fin
        si v_reiniciar <> 0 entonces centrar_ventana(v_reiniciar) fin
        pinta_barra()
        si v_config <> 0 entonces pinta_config() fin
        repintar_todo()
        d[0] := an
        d[1] := al
        tomar_consola()
        imprimir2("escritorio: la pantalla, a %u x %u (en marcha)\n", an, al)
        soltar_consola()
        devolver cierto
    fin

    ; el cuadro de la prueba: «¿Se ve bien?», con la cuenta atrás
    función pinta_probar()
        variable l: puntero a Lienzo
        variable d: arreglo [3] de nat32
        l := lienzo_de(v_probar)
        si l = nulo entonces devolver fin
        quita_pulsadores(v_probar)
        degradado(valor(l), 0, 0, 480, 160, 0xEAF3FE, 0xC4DCF8)
        icono_equipo(valor(l), 16, 14)
        texto_negrita(valor(l), 62, 14, "¿Se ve bien la pantalla?", TINTA)
        d[0] := nat32(pantalla.ancho)
        d[1] := nat32(pantalla.alto)
        formatear(renglón, 96, "Está a %u x %u.", d)
        texto(valor(l), 62, 36, renglón, TINTA)
        d[0] := prueba_vista
        si prueba_arranque entonces
            formatear(renglón, 96, "Si no la da por buena, vuelve la de antes en %u s.", d)
        sino
            formatear(renglón, 96, "Si no la da por buena, vuelve sola en %u s.", d)
        fin
        texto(valor(l), 62, 56, renglón, TINTA_SUAVE)
        pulsador(v_probar, 90, 106, 130, 34, "Mantener", VERDE_ARRIBA, VERDE_ABAJO, AC_MANTENER)
        pulsador(v_probar, 260, 106, 130, 34, "Volver", 0x5AA6F4, 0x2468C8, AC_VOLVER)
        repintada(v_probar, 0, 0, 480, 160)
    fin

    función abre_probar(de_arranque: bool)
        si v_probar <> 0 entonces cierra_cuadro(v_probar) fin
        prueba_arranque := de_arranque
        prueba_hasta := tics + PRUEBA_SEGUNDOS * HZ
        prueba_vista := PRUEBA_SEGUNDOS
        v_probar := cuadro("Probar la pantalla", 480, 160)
        pinta_probar()
    fin

    ; el aviso de «se pondrá al arrancar»: Reiniciar ahora o más tarde
    función abre_reiniciar(t: puntero a byte)
        variable l: puntero a Lienzo
        si v_reiniciar <> 0 entonces cierra_cuadro(v_reiniciar) fin
        Textos32.copiar(texto_reiniciar, t)
        v_reiniciar := cuadro("Reiniciar", 480, 170)
        l := lienzo_de(v_reiniciar)
        si l = nulo entonces
            v_reiniciar := 0
            devolver
        fin
        degradado(valor(l), 0, 0, 480, 170, 0xEAF3FE, 0xC4DCF8)
        disquete(valor(l), 14, 12, 40)
        texto_negrita(valor(l), 66, 14, texto_reiniciar, TINTA)
        texto(valor(l), 66, 36, "Si al arrancar no se ve, reinicie otra vez:", TINTA_SUAVE)
        texto(valor(l), 66, 54, "vuelve sola la de antes.", TINTA_SUAVE)
        pulsador(v_reiniciar, 70, 112, 160, 36, "Reiniciar ahora", VERDE_ARRIBA, VERDE_ABAJO, AC_REINICIAR_YA)
        pulsador(v_reiniciar, 260, 112, 130, 36, "Más tarde", 0x5AA6F4, 0x2468C8, AC_MÁS_TARDE)
        repintada(v_reiniciar, 0, 0, 480, 170)
    fin

    ; «Probar...»: la elegida, en el momento
    función probar_elegida()
        variable an, al: nat32
        variable d: arreglo [2] de nat32
        si modo_elegido < 0 o modo_elegido >= ent32(n_modos) entonces devolver fin
        an := modos_an[modo_elegido]
        al := modos_al[modo_elegido]
        si an = nat32(pantalla.ancho) y al = nat32(pantalla.alto) entonces
            Textos32.copiar(texto_pantalla, "Ya está a esa medida.")
            pinta_pantalla()
            devolver
        fin
        antes_an := nat32(pantalla.ancho)
        antes_al := nat32(pantalla.alto)
        cierra_cuadro(v_pantalla)
        si no cambia_medida(an, al) entonces
            d[0] := an
            d[1] := al
            formatear(texto_aviso, 128, "No se puede poner %u x %u: sigue la de antes.", d)
            aviso(texto_aviso)
            devolver
        fin
        abre_probar(falso)
    fin

    ; «Mantener»: se queda; instalado, también para los próximos arranques
    función mantener()
        variable d: arreglo [2] de nat32
        cierra_cuadro(v_probar)
        d[0] := nat32(pantalla.ancho)
        d[1] := nat32(pantalla.alto)
        si prueba_arranque entonces
            lee_env()
            env_prueba := '0'
            env_antes[0] := 0
            escribe_env()
            formatear(texto_pantalla, 96, "Se queda a %u x %u.", d)
        sino si se_guarda() y guarda_medida(d[0], d[1], falso) entonces
            formatear(texto_pantalla, 96, "Se queda a %u x %u, también al arrancar.", d)
        sino
            formatear(texto_pantalla, 96, "Se queda a %u x %u (hasta que se apague).", d)
        fin
        escribir("escritorio: ", texto_pantalla, "\n")
        abre_pantalla()
    fin

    ; «Volver», o se han acabado los 15 s: la de antes
    función volver()
        variable an, al: nat32
        variable q: puntero a byte
        cierra_cuadro(v_probar)
        si prueba_arranque entonces
            ; la de antes la pone GRUB: se apunta y se reinicia (o, con la VBE
            ; de Bochs y una medida que se sepa, ya)
            lee_env()
            Textos32.copiar(env_pantalla, env_antes)
            env_antes[0] := 0
            env_prueba := '0'
            escribe_env()
            an := 0
            al := 0
            si env_pantalla[0] >= '1' y env_pantalla[0] <= '9' entonces
                an := número_tras(env_pantalla, q)
                si valor(q) = 'x' entonces al := número_tras(q + 1, q) fin
            fin
            si se_cambia_en_marcha() y an >= 640 y al >= 480 y cambia_medida(an, al) entonces
                Textos32.copiar(texto_pantalla, "Ha vuelto la de antes.")
                escribir("escritorio: ", texto_pantalla, "\n")
            sino
                escribir("escritorio: la de antes, al arrancar otra vez\n")
                abre_reiniciar("Al arrancar otra vez, vuelve la de antes.")
            fin
            devolver
        fin
        si cambia_medida(antes_an, antes_al) entonces
            Textos32.copiar(texto_pantalla, "Ha vuelto la de antes.")
        sino
            Textos32.copiar(texto_pantalla, "No se ha podido volver a la de antes.")
        fin
        escribir("escritorio: ", texto_pantalla, "\n")
        abre_pantalla()
    fin

    ; cada tic, con la prueba en marcha: la cuenta atrás y, al acabar, volver
    función atiende_prueba()
        variable q: nat32
        si v_probar = 0 entonces devolver fin
        si tics >= prueba_hasta entonces
            escribir("escritorio: no se ha dado por buena en 15 s\n")
            volver()
            devolver
        fin
        q := (prueba_hasta - tics + HZ - 1) div HZ
        si q <> prueba_vista entonces
            prueba_vista := q
            pinta_probar()
        fin
    fin

    ; «Guardar y reiniciar...» (sin VBE de Bochs): para el próximo arranque, a prueba
    función guarda_elegida()
        variable d: arreglo [2] de nat32
        si modo_elegido < 0 o modo_elegido >= ent32(n_modos) entonces devolver fin
        si no guarda_medida(modos_an[modo_elegido], modos_al[modo_elegido], cierto) entonces
            Textos32.copiar(texto_pantalla, "No se puede guardar en C:\\HISPA.")
            pinta_pantalla()
            devolver
        fin
        cierra_cuadro(v_pantalla)
        si modos_an[modo_elegido] = 0 entonces
            abre_reiniciar("Al arrancar, a la medida de la pantalla.")
        sino
            d[0] := modos_an[modo_elegido]
            d[1] := modos_al[modo_elegido]
            formatear(renglón, 96, "Al arrancar otra vez, a %u x %u.", d)
            abre_reiniciar(renglón)
        fin
    fin

    ; al arrancar (instalado): lo que dice PANTALLA.ENV. A prueba (GRUB acaba
    ; de poner la nueva): «¿Se ve bien?». Y con la VBE de Bochs, si GRUB no
    ; ha podido poner la medida guardada (su BIOS no la tiene), se pone ya.
    función mira_pantalla_guardada()
        variable an, al: nat32
        variable q: puntero a byte
        si no instalado() entonces devolver fin
        lee_env()
        si env_prueba <> '0' entonces
            escribir("escritorio: la pantalla está a prueba (PANTALLA.ENV)\n")
            abre_probar(cierto)
            devolver
        fin
        si se_cambia_en_marcha() y env_pantalla[0] >= '1' y env_pantalla[0] <= '9' entonces
            an := número_tras(env_pantalla, q)
            al := 0
            si valor(q) = 'x' entonces al := número_tras(q + 1, q) fin
            si an >= 640 y al >= 480 y (an <> nat32(pantalla.ancho) o al <> nat32(pantalla.alto)) entonces cambia_medida(an, al) fin
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Lanzar programas, apagar
    ; -------------------------------------------------------------------------
    ; lanza un programa del disco, con sus argumentos; si no se puede, lo dice
    función lanza(ruta: puntero a byte, args: puntero a byte)
        variable t: puntero a Tarea
        variable e: nat32
        variable d: arreglo [2] de nat32
        t := cargar_archivo(ruta, args, e)
        si t = nulo entonces
            d[0] := nat32(ruta)
            d[1] := nat32(texto_error(e))
            formatear(texto_aviso, 128, "No se puede abrir %s: %s.", d)
            aviso(texto_aviso)
            devolver
        fin
        ; nadie la va a esperar: al acabar, la recoge el núcleo
        t.padre := 0
        lanzados := lanzados + 1
        tomar_consola()
        imprimir2("escritorio: lanzo %s (la tarea %u)\n", nat32(ruta), t.id)
        soltar_consola()
    fin

    ; avisa a los programas (a sus ventanas: «cerrar») y espera, como mucho
    ; dos segundos, a que se cierren, sin dejar de mover el escritorio (por
    ; si alguno dice algo). Falso si alguno no se ha cerrado (el Bloc de
    ; notas con cambios sin guardar avisa y se queda): entonces no se apaga,
    ; y si se vuelve a pedir, se le cierra (como el Bloc al cerrar otra vez).
    función cierra_programas(): bool
        variable i, k: nat32
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].dueño <> 0 entonces pedir_cierre(ventanas[i].id) fin
        fin
        k := 0
        mientras k < 200 y programas_con_ventana() hacer
            pulso()
            dormir(1)
            k := k + 1
        fin
        si programas_con_ventana() y no apagar_otra_vez entonces
            apagar_otra_vez := cierto
            aviso("Hay un programa sin cerrar: ¿algo sin guardar?")
            devolver falso
        fin
        devolver cierto
    fin

    función programas_con_ventana(): bool
        variable i: nat32
        para i desde 0 hasta MAX_VENTANAS - 1 hacer
            si ventanas[i].usada y ventanas[i].dueño <> 0 entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; apagar o reiniciar, por este orden: avisar a los programas (y esperar a
    ; que se cierren), la pantalla del final, acabar los que queden (sus
    ; archivos se cierran: lo escrito queda), vaciar los discos y, ya, ACPI
    ; (energia.cas: el servicio de ACPI entra en S5; reiniciar, por el
    ; registro de la FADT, el teclado o CF9h). Sin ACPI: en QEMU (se sabe por
    ; su tarjeta), su puerto de pruebas, con el código 5; en un PC de verdad,
    ; el aviso de «ya puede apagar», y parado.
    función apaga(reiniciar: bool)
        variable t: puntero a byte
        si no cierra_programas() entonces devolver fin
        quita_ayuda()
        desviado := falso
        degradado(pantalla, 0, 0, pantalla.ancho, pantalla.alto, 0x123E7E, 0x1F6FC4)
        disquete(pantalla, pantalla.ancho div 2 - 48, pantalla.alto div 2 - 120, 96)
        si reiniciar entonces t := "Reiniciando el equipo..." sino t := "Apagando el equipo..." fin
        texto_negrita(pantalla, (pantalla.ancho - ancho_texto(t)) div 2, pantalla.alto div 2, t, BLANCO)
        texto(pantalla, (pantalla.ancho - 13 * 8) div 2, pantalla.alto div 2 + 28, "Hispa-Pentium", 0xBFDCFA)
        volcar(0, 0, pantalla.ancho, pantalla.alto)
        acabar_programas(200)
        recoger_huérfanas()
        vaciar_discos()
        si reiniciar entonces
            escribir("escritorio: reiniciar\n")
            reiniciar_equipo()
        fin
        escribir("escritorio: apagar\n")
        apagar_por_acpi()
        si hay_bochs() entonces
            ensamblador
                cli
                mov edx, 0xF4
                mov al, 5
                out dx, al
                mov edx, 0x604
                mov eax, 0x2000
                out dx, ax
            fin
        fin
        ; no se ha podido: el aviso de siempre
        degradado(pantalla, 0, pantalla.alto div 2 - 4, pantalla.ancho, 24, 0x18519F, 0x1A58A8)
        t := "Ya puede apagar el equipo."
        texto_negrita(pantalla, (pantalla.ancho - ancho_texto(t)) div 2, pantalla.alto div 2, t, BLANCO)
        volcar(0, 0, pantalla.ancho, pantalla.alto)
        ensamblador
            cli
        .parado:
            hlt
            jmp .parado
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  El recuadro de ayuda de la pila (como el de Hispa-486)
    ; -------------------------------------------------------------------------
    función quita_ayuda()
        si v_ayuda <> 0 entonces
            cerrar_ventana(v_ayuda, 0)
            v_ayuda := 0
        fin
    fin

    ; encima de la barra y centrado en el puntero (sin salirse), crema, con
    ; las líneas de ayuda_pila (energia.cas)
    función pon_ayuda()
        variable texto_a: arreglo [256] de byte
        variable línea_a: arreglo [96] de byte
        variable colores: arreglo [6] de nat32
        variable n, i, j, k: nat32
        variable an, al, x, yy, w: ent32
        variable l: puntero a Lienzo
        n := ayuda_pila(texto_a, colores)
        si n = 0 entonces devolver fin
        ; lo ancho de la línea más larga
        an := 0
        i := 0
        para k desde 1 hasta n hacer
            j := 0
            mientras texto_a[i] <> 0 y texto_a[i] <> '\n' hacer
                si j < 95 entonces
                    línea_a[j] := texto_a[i]
                    j := j + 1
                fin
                i := i + 1
            fin
            línea_a[j] := 0
            si texto_a[i] = '\n' entonces i := i + 1 fin
            w := ancho_texto(línea_a)
            si w > an entonces an := w fin
        fin
        an := an + 16
        al := ent32(n) * 18 + 8
        x := ratón_x - an div 2
        si x > pantalla.ancho - an - 2 entonces x := pantalla.ancho - an - 2 fin
        si x < 2 entonces x := 2 fin
        yy := pantalla.alto - ALTO_BARRA - al - 4
        v_ayuda := crear_ventana("ayuda", x, yy, an, al, SIN_MARCO ob ENCIMA, 0)
        l := lienzo_de(v_ayuda)
        si l = nulo entonces
            quita_ayuda()
            devolver
        fin
        rectángulo(valor(l), 0, 0, an, al, 0xFFF8E1)
        marco(valor(l), 0, 0, an, al, 0x9C8452)
        i := 0
        para k desde 1 hasta n hacer
            j := 0
            mientras texto_a[i] <> 0 y texto_a[i] <> '\n' hacer
                si j < 95 entonces
                    línea_a[j] := texto_a[i]
                    j := j + 1
                fin
                i := i + 1
            fin
            línea_a[j] := 0
            si texto_a[i] = '\n' entonces i := i + 1 fin
            texto(valor(l), 8, 5 + ent32(k - 1) * 18, línea_a, colores[k - 1])
        fin
        repintada(v_ayuda, 0, 0, an, al)
        ayuda_vista := cambios_energía
    fin

    ; cada tic: con el puntero quieto medio segundo sobre la pila sale el
    ; recuadro; se va al salir de ella o al pulsar un botón (y no vuelve
    ; hasta salir y entrar otra vez); mientras se ve, se pone al día
    función vigila_ayuda()
        variable x0: ent32
        si no hay_pila() o v_barra = 0 o menú_abierto entonces
            quita_ayuda()
            devolver
        fin
        x0 := pantalla.ancho - ancho_bandeja() + hueco_usb() + hueco_red() + 4
        si ratón_x < x0 o ratón_x >= x0 + ANCHO_PILA o ratón_y < pantalla.alto - ALTO_BARRA entonces
            quita_ayuda()
            ayuda_tapada := falso
            ayuda_quieto := 0
            devolver
        fin
        si ratón_botones <> 0 entonces
            quita_ayuda()
            ayuda_tapada := cierto
            devolver
        fin
        si ayuda_tapada entonces devolver fin
        si v_ayuda = 0 entonces
            si ratón_x <> ayuda_x o ratón_y <> ayuda_y entonces
                ayuda_x := ratón_x
                ayuda_y := ratón_y
                ayuda_quieto := 0
            fin
            ayuda_quieto := ayuda_quieto + 1
            si ayuda_quieto >= 50 entonces pon_ayuda() fin
        sino si ayuda_vista <> cambios_energía entonces
            quita_ayuda()
            pon_ayuda()
        fin
    fin

    función haz(acción: nat32, dato: nat32)
        según acción
            caso AM_BLOC: lanza("\\BLOC.BIN", nulo)
            caso AM_CONSOLA: lanza("\\CONSOLA.BIN", nulo)
            caso AM_DOCUMENTO: lanza("\\BLOC.BIN", documentos[dato])
            caso AM_CONFIG: abre_config()
            caso AM_APAGAR: abre_apagar()
            caso AM_EQUIPO: lanza("\\EQUIPO.BIN", nulo)
            caso AM_PROGRAMAS: lanza("\\ACTUALIZ.BIN", nulo)
            caso AM_ACCESO: si dato < n_accesos entonces lanza(programa_de(dato), argumentos_de(dato)) fin
            caso AM_ATAJO:
                ; (dock) lo abre el explorador, con lo suyo
                si dato < n_atajos entonces
                    copiar(renglón, "/ABRIR ")
                    concatenar(renglón, dirección(atajos[dato].ruta[0]))
                    lanza("\\EQUIPO.BIN", renglón)
                fin
            caso AC_DOCK_SÍ:
                pon_visible(cierto)
                pinta_config()
            caso AC_DOCK_NO:
                pon_visible(falso)
                pinta_config()
            caso AM_OFICINA: lanza("\\HVPRUN.BIN", de_oficina(dato, cierto))
            caso AC_ACERCA: abre_acerca()
            caso AC_CERRAR_ACERCA: cierra_cuadro(v_acerca)
            caso AC_ORGANIZAR:
                quita_iconos()
                organiza_iconos()
                pon_iconos()
            caso AC_TAPIZ_SIGUIENTE:
                fondo := (fondo + 1) mod 3
                pinta_tapiz()
                repintar_todo()
                si v_config <> 0 entonces pinta_config() fin
            caso AC_APAGAR: apaga(falso)
            caso AC_REINICIAR: apaga(cierto)
            caso AC_CANCELAR: cierra_cuadro(v_apagar)
            caso AC_TECLADO_ES:
                pon_teclado(cierto)
                pinta_config()
            caso AC_TECLADO_US:
                pon_teclado(falso)
                pinta_config()
            caso AC_FONDO..AC_FONDO + 2:
                fondo := acción - AC_FONDO
                pinta_tapiz()
                repintar_todo()
                si v_config <> 0 entonces pinta_config() fin
            caso AC_CERRAR_CONFIG: cierra_cuadro(v_config)
            caso AC_PANTALLA:
                texto_pantalla[0] := 0
                abre_pantalla()
            caso AC_CERRAR_PANTALLA: cierra_cuadro(v_pantalla)
            caso AC_PROBAR: probar_elegida()
            caso AC_GUARDAR_MODO: guarda_elegida()
            caso AC_MANTENER: mantener()
            caso AC_VOLVER: volver()
            caso AC_REINICIAR_YA:
                cierra_cuadro(v_reiniciar)
                apaga(cierto)
            caso AC_MÁS_TARDE: cierra_cuadro(v_reiniciar)
            caso AC_MODO..AC_MODO + MAX_MODOS - 1:
                si acción - AC_MODO < n_modos entonces
                    modo_elegido := ent32(acción - AC_MODO)
                    texto_pantalla[0] := 0
                    pinta_pantalla()
                fin
            caso AC_CERRAR_AVISO: cierra_cuadro(v_aviso)
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Los sucesos de las ventanas del escritorio
    ; -------------------------------------------------------------------------
    ; el menú de una ventana (el del botón secundario en su título o en su
    ; botón de la barra de tareas), en ese punto de la pantalla: en gris, lo
    ; que ahora no toca
    función menú_de_ventana(id: nat32, x: ent32, yy: ent32)
        variable m, grises: nat32
        m := marcas_de(id)
        si m = 0xFFFFFFFF o m yb SIN_MARCO <> 0 entonces devolver fin
        grises := 0
        si m yb (MINIMIZADA ob MAXIMIZADA) = 0 entonces grises := grises ob 1 fin
        si m yb (MINIMIZADA ob MAXIMIZADA) <> 0 entonces grises := grises ob 2 fin
        si m yb (MINIMIZADA ob FIJA) <> 0 entonces grises := grises ob 4 fin
        si m yb (MAXIMIZADA ob FIJA) <> 0 entonces grises := grises ob 8 fin
        menú_dato := id
        abrir_emergente(x, yy, "Restaurar|Mover|Minimizar|Maximizar|-|Cerrar", grises, 0, ME_VENTANA)
    fin

    función atiende_menú()
        variable e: Evento
        variable n: ent32
        mientras saca_evento(v_menú, 0, e) hacer
            según e.clase
                caso EV_FUERA:
                    cierra_menú()
                    menú_cerrado_en := tics
                caso EV_RATÓN_MUEVE:
                    n := opción_en(ent32(e.a), ent32(e.b))
                    si n <> elegida y menú_abierto entonces
                        elegida := n
                        pinta_menú()
                    fin
                caso EV_RATÓN_BAJA:
                    n := opción_en(ent32(e.a), ent32(e.b))
                    si n >= 0 y menú_abierto entonces
                        si e.c yb BOTÓN_DERECHO <> 0 entonces
                            ; el botón secundario en un programa o un documento: «Abrir»
                            si opciones[n].acción <> AM_APAGAR entonces
                                menú_acción := opciones[n].acción
                                menú_dato := opciones[n].dato
                                abrir_emergente(ent32(e.a), pantalla.alto - ALTO_BARRA - menú_alto + ent32(e.b), "Abrir", 0, 0, ME_INICIO)
                            fin
                        sino
                            cierra_menú()
                            haz(opciones[n].acción, opciones[n].dato)
                        fin
                    fin
                caso EV_TECLA:
                    si menú_abierto entonces
                        si e.a = 27 entonces
                            cierra_menú()
                        sino si e.a = TECLA_ABAJO entonces
                            elegida := elegida + 1
                            si elegida >= ent32(n_opciones) entonces elegida := 0 fin
                            pinta_menú()
                        sino si e.a = TECLA_ARRIBA entonces
                            elegida := elegida - 1
                            si elegida < 0 entonces elegida := ent32(n_opciones) - 1 fin
                            pinta_menú()
                        sino si e.a = '\n' y elegida >= 0 entonces
                            n := elegida
                            cierra_menú()
                            haz(opciones[n].acción, opciones[n].dato)
                        fin
                    fin
            fin
        fin
    fin

    función atiende_barra()
        variable e: Evento
        variable n: ent32
        mientras saca_evento(v_barra, 0, e) hacer
            si e.clase = EV_TECLA y e.a = TECLA_LOGO entonces
                si menú_abierto entonces cierra_menú() sino abre_menú() fin
            sino si e.clase = EV_RATÓN_BAJA entonces
                si ent32(e.a) < INICIO_ANCHO entonces
                    ; «Inicio»: abre el menú (si no se acaba de cerrar con este mismo clic)
                    si no menú_abierto y tics - menú_cerrado_en > 3 entonces abre_menú() fin
                sino si n_usb > 0 y ent32(e.a) >= pantalla.ancho - bandeja y ent32(e.a) < pantalla.ancho - bandeja + ICONO_USB entonces
                    ; el icono de las memorias USB
                    menú_usb(ent32(e.a))
                sino si hueco_red() > 0 y ent32(e.a) >= pantalla.ancho - bandeja + hueco_usb() y ent32(e.a) < pantalla.ancho - bandeja + hueco_usb() + ICONO_RED entonces
                    ; el icono de la red
                    dice_red()
                sino si ent32(e.a) >= BOTONES_X y ancho_botón > 0 entonces
                    n := (ent32(e.a) - BOTONES_X) div ancho_botón
                    si n < ent32(n_botones) entonces
                        ; el botón secundario: el menú de esa ventana; el principal, la trae o la recoge
                        si e.c yb BOTÓN_DERECHO <> 0 entonces
                            menú_de_ventana(botones[n], ent32(e.a), pantalla.alto - ALTO_BARRA)
                        sino
                            botón_de_barra(botones[n])
                        fin
                    fin
                fin
            fin
        fin
    fin

    ; lo que cae en el tapiz (los iconos, el menú del botón secundario) y el
    ; botón secundario en el título de una ventana
    función atiende_fondo()
        variable e: Evento
        variable k, x, yy: ent32
        mientras saca_evento(v_fondo, 0, e) hacer
            x := ent32(e.a)
            yy := ent32(e.b)
            según e.clase
                caso EV_MENÚ_VENTANA:
                    menú_de_ventana(e.a, ent32(e.b), ent32(e.c))
                caso EV_RATÓN_BAJA:
                    k := icono_en(x, yy)
                    elige_icono(k)
                    si e.c yb BOTÓN_DERECHO <> 0 entonces
                        si k >= 0 y iconos[k].acción = AM_ATAJO entonces
                            ; (dock) un acceso soltado: también se puede quitar
                            menú_dato := nat32(k)
                            abrir_emergente(x, yy, "Abrir|Quitar del escritorio", 0, 0, ME_ATAJO)
                        sino si k >= 0 entonces
                            menú_dato := nat32(k)
                            abrir_emergente(x, yy, "Abrir", 0, 0, ME_ICONO)
                        sino
                            abrir_emergente(x, yy, "Configuración|Cambiar el tapiz|Organizar iconos|-|Acerca de Hispa-Pentium", 0, 0, ME_FONDO)
                        fin
                    sino si k >= 0 entonces
                        si (e.c >> DESPLAZA_VECES) = 2 entonces
                            haz(iconos[k].acción, iconos[k].dato)
                        sino
                            icono_cogido := k
                            cog_dx := x - iconos[k].x
                            cog_dy := yy - iconos[k].ye
                            cog_x := x
                            cog_y := yy
                            cog_movido := falso
                        fin
                    fin
                caso EV_RATÓN_MUEVE:
                    si icono_cogido >= 0 y e.c yb BOTÓN_IZQUIERDO <> 0 entonces
                        si x - cog_x > 4 o cog_x - x > 4 o yy - cog_y > 4 o cog_y - yy > 4 entonces cog_movido := cierto fin
                        si cog_movido entonces mueve_icono(icono_cogido, x - cog_dx, yy - cog_dy) fin
                    fin
                caso EV_RATÓN_SUBE:
                    ; (dock) un acceso soltado que se ha llevado a otro sitio: se guarda dónde
                    si icono_cogido >= 0 y cog_movido y iconos[icono_cogido].acción = AM_ATAJO entonces mueve_atajo(iconos[icono_cogido].dato, iconos[icono_cogido].x, iconos[icono_cogido].ye) fin
                    icono_cogido := -1
            fin
        fin
    fin

    ; lo que se ha elegido en un menú emergente del escritorio
    función elegido_en_menú(cuál: nat32, opción: nat32)
        según cuál
            caso ME_FONDO:
                según opción
                    caso 0: abre_config()
                    caso 1: haz(AC_TAPIZ_SIGUIENTE, 0)
                    caso 2: haz(AC_ORGANIZAR, 0)
                    caso 4: abre_acerca()
                fin
            caso ME_VENTANA:
                según opción
                    caso 0: orden_ventana(menú_dato, PIDE_RESTAURAR)
                    caso 1: orden_ventana(menú_dato, PIDE_MOVER)
                    caso 2: orden_ventana(menú_dato, PIDE_MINIMIZAR)
                    caso 3: orden_ventana(menú_dato, PIDE_MAXIMIZAR)
                    caso 5: orden_ventana(menú_dato, PIDE_CERRAR)
                fin
            caso ME_INICIO:
                cierra_menú()
                si opción = 0 entonces haz(menú_acción, menú_dato) fin
            caso ME_ICONO:
                si opción = 0 y menú_dato < n_iconos entonces haz(iconos[menú_dato].acción, iconos[menú_dato].dato) fin
            caso ME_USB:
                si opción < n_usb y opción < 3 entonces quitar(usb_letras[opción]) fin
            caso ME_ATAJO:
                ; (dock)
                si opción = 0 y menú_dato < n_iconos entonces haz(iconos[menú_dato].acción, iconos[menú_dato].dato) fin
                si opción = 1 y menú_dato < n_iconos entonces quita_atajo_del_tapiz(menú_dato) fin
            caso ME_DOCK: elegido_dock(opción)
        fin
    fin

    ; los sucesos de un cuadro: sus pulsadores y su botón de cerrar
    función atiende_cuadro(ref v: nat32)
        variable e: Evento
        variable a: nat32
        mientras v <> 0 y saca_evento(v, 0, e) hacer
            si e.clase = EV_CERRAR o (e.clase = EV_TECLA y e.a = 27) entonces
                cierra_cuadro(v)
            sino si e.clase = EV_RATÓN_BAJA entonces
                a := pulsador_en(v, ent32(e.a), ent32(e.b))
                si a <> 0 entonces haz(a, 0) fin
            fin
        fin
    fin

    ; los de la prueba de la pantalla: cerrarlo o Esc es «Volver»; Intro, «Mantener»
    función atiende_probar()
        variable e: Evento
        variable a: nat32
        mientras v_probar <> 0 y saca_evento(v_probar, 0, e) hacer
            si e.clase = EV_CERRAR o (e.clase = EV_TECLA y e.a = 27) entonces
                volver()
            sino si e.clase = EV_TECLA y e.a = '\n' entonces
                mantener()
            sino si e.clase = EV_RATÓN_BAJA entonces
                a := pulsador_en(v_probar, ent32(e.a), ent32(e.b))
                si a <> 0 entonces haz(a, 0) fin
            fin
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  (dock) Los accesos que se sueltan en el tapiz desde el explorador
    ; -------------------------------------------------------------------------
    ; cada acceso soltado, donde se dejó (si cabe en la pantalla)
    función pon_atajos()
        variable i: nat32
        i := 0
        mientras i < n_iconos hacer
            si iconos[i].acción = AM_ATAJO y iconos[i].dato < n_atajos entonces
                si atajos[iconos[i].dato].x >= 0 y atajos[iconos[i].dato].ye >= 0 y atajos[iconos[i].dato].x <= tapiz.ancho - CELDA_AN y atajos[iconos[i].dato].ye <= tapiz.alto - ALTO_BARRA - CELDA_AL entonces
                    iconos[i].x := atajos[iconos[i].dato].x
                    iconos[i].ye := atajos[iconos[i].dato].ye
                fin
            fin
            i := i + 1
        fin
    fin

    ; quita el icono k (un acceso soltado) del tapiz y de ATAJOS.INI
    función quita_atajo_del_tapiz(k: nat32)
        variable i, a: nat32
        si k >= n_iconos o iconos[k].acción <> AM_ATAJO entonces devolver fin
        quita_iconos()
        a := iconos[k].dato
        liberar(puntero(iconos[k].debajo))
        i := k
        mientras i + 1 < n_iconos hacer
            iconos[i].x := iconos[i + 1].x
            iconos[i].ye := iconos[i + 1].ye
            iconos[i].acción := iconos[i + 1].acción
            iconos[i].dato := iconos[i + 1].dato
            iconos[i].nombre := iconos[i + 1].nombre
            iconos[i].debajo := iconos[i + 1].debajo
            i := i + 1
        fin
        n_iconos := n_iconos - 1
        quita_atajo(a)
        ; los de detrás, a su sitio nuevo de la lista
        i := 0
        mientras i < n_iconos hacer
            si iconos[i].acción = AM_ATAJO entonces
                si iconos[i].dato > a entonces iconos[i].dato := iconos[i].dato - 1 fin
                iconos[i].nombre := dirección(atajos[iconos[i].dato].nombre[0])
            fin
            i := i + 1
        fin
        icono_elegido := -1
        pon_iconos()
    fin

    ; ¿es una carpeta la ruta (con su letra)?
    función es_carpeta_ruta(r: puntero a byte): bool
        variable u, m: nat32
        variable c: bool
        si r[0] = 0 o r[1] <> ':' entonces devolver falso fin
        si r[2] = 0 o (r[2] = '\\' y r[3] = 0) entonces devolver cierto fin
        u := por_letra(r[0])
        si u = Unidades.NINGUNA entonces devolver falso fin
        m := abrir_archivo(u, dirección(r[2]), PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver falso fin
        c := es_carpeta(m)
        cerrar_archivo(m)
        devolver c
    fin

    ; lo que ha soltado el explorador fuera de su ventana: en el dock, se
    ; fija (o va a la Papelera); en el tapiz, un acceso nuevo
    función atiende_suelta()
        variable id, r: nat32
        variable k: ent32
        variable x, yy: ent32
        suelta_pedida := falso
        id := ventana_en_punto(suelta_x, suelta_y)
        si id <> 0 y id = v_dock entonces
            r := soltado_en_dock(suelta_ruta, suelta_x)
            si r = 2 entonces
                copiar(renglón, "/BORRAR ")
                concatenar(renglón, suelta_ruta)
                lanza("\\EQUIPO.BIN", renglón)
                mira_ya()
            sino si r = 1 entonces
                globo_título := "Dock"
                globo("Fijado en el dock.")
            sino
                globo_título := "Dock"
                globo("En el dock se fijan los programas (.BIN).")
            fin
            devolver
        fin
        si id <> 0 entonces devolver fin
        x := suelta_x - CELDA_AN div 2
        yy := suelta_y - 20
        si x < 0 entonces x := 0 fin
        si yy < 0 entonces yy := 0 fin
        si x > tapiz.ancho - CELDA_AN entonces x := tapiz.ancho - CELDA_AN fin
        si yy > tapiz.alto - ALTO_BARRA - CELDA_AL entonces yy := tapiz.alto - ALTO_BARRA - CELDA_AL fin
        k := nuevo_atajo(suelta_ruta, es_carpeta_ruta(suelta_ruta), x, yy)
        si k < 0 o n_iconos >= MAX_ICONOS entonces
            globo_título := "Escritorio"
            globo("En el tapiz ya no caben m\xA0s accesos.")
            devolver
        fin
        quita_iconos()
        nuevo_icono_de(dirección(atajos[k].nombre[0]), AM_ATAJO, nat32(k))
        iconos[n_iconos - 1].x := x
        iconos[n_iconos - 1].ye := yy
        pon_iconos()
        tomar_consola()
        imprimir1("escritorio: un acceso nuevo en el tapiz: %s\n", nat32(dirección(suelta_ruta[0])))
        soltar_consola()
    fin

    ; la tarea del escritorio: el pulso del gestor y lo suyo, cien veces por segundo
    función tarea_escritorio(n: nat32)
        variable f, h: nat32
        mientras cierto hacer
            pulso()
            atiende_emergente()
            si hay_resultado entonces
                hay_resultado := falso
                elegido_en_menú(resultado_etiqueta, resultado)
            fin
            atiende_menú()
            atiende_barra()
            atiende_fondo()
            atiende_cuadro(v_apagar)
            atiende_cuadro(v_config)
            atiende_cuadro(v_aviso)
            atiende_cuadro(v_acerca)
            atiende_cuadro(v_pantalla)
            atiende_probar()
            atiende_cuadro(v_reiniciar)
            atiende_prueba()
            atiende_globo()
            vigila_ayuda()
            ; (dock) el dock, lo que pide y lo que se suelta desde el explorador
            atiende_dock()
            si pide <> PIDE_NADA entonces
                si pide = PIDE_CONFIG entonces abre_config() fin
                si pide = PIDE_LANZAR entonces
                    si pide_argumentos[0] = 0 entonces lanza(pide_programa, nulo) sino lanza(pide_programa, pide_argumentos) fin
                fin
                pide := PIDE_NADA
            fin
            si suelta_pedida entonces atiende_suelta() fin
            si Ventanas.cambios <> cambios_vistos o cambios_red <> red_vista o cambios_energía <> energía_vista entonces pinta_barra() fin
            ; cada segundo: el reloj (si ha cambiado el minuto) y las tareas acabadas
            si tics div HZ <> segundo_visto entonces
                segundo_visto := tics div HZ
                ahora(f, h)
                si (h >> 5) yb 63 <> minuto_visto entonces pinta_barra() fin
                recoger_huérfanas()
            fin
            dormir(1)
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Ponerlo en marcha
    ; -------------------------------------------------------------------------
    ; el número que hay detrás de «clave» en la línea del cargador (0 si no está)
    función número_tras(t: puntero a byte, ref sigue: puntero a byte): nat32
        variable n: nat32
        n := 0
        mientras valor(t) >= '0' y valor(t) <= '9' hacer
            n := n * 10 + (valor(t) - '0')
            t := t + 1
        fin
        sigue := t
        devolver n
    fin

    ; pone en marcha el escritorio: el modo gráfico, el ratón, el gestor de
    ; ventanas, el tapiz, la barra y el menú, y su tarea. Da 1 si queda en
    ; marcha (o ya lo estaba); 0 si no se puede (y dice por qué).
    público función arranca(): nat32
        variable an, al, bits: nat32
        variable p, q: puntero a byte
        variable t: puntero a Tarea
        variable i: nat32
        variable d: arreglo [5] de nat32
        si escritorio_en_marcha entonces devolver 1 fin
        bits := 0
        p := buscar(línea_del_cargador(), "bits=")
        si p <> nulo entonces bits := número_tras(p + 5, q) fin
        an := 800
        al := 600
        p := buscar(línea_del_cargador(), "modo=")
        si p <> nulo entonces
            an := número_tras(p + 5, q)
            si valor(q) = 'x' entonces al := número_tras(q + 1, q) fin
            si an < 640 o al < 480 o an > 1600 o al > 1200 entonces
                an := 800
                al := 600
            fin
        fin
        ; la memoria que pide: el doble búfer, el tapiz y unas cuantas
        ; ventanas. Si no la hay para ese modo, 800x600; y si ni para ese, no
        ; se entra (mejor decirlo en modo texto que quedarse a oscuras)
        si marcos_libres() < (an * al * 12 + 0x300000) div 4096 entonces
            an := 800
            al := 600
        fin
        si marcos_libres() < (an * al * 12 + 0x300000) div 4096 entonces
            escribir("escritorio: no hay memoria bastante (hacen falta unos 12 MB libres)\n")
            devolver 0
        fin
        p := buscar(línea_del_cargador(), "tapiz=")
        si p <> nulo entonces fondo := número_tras(p + 6, q) mod 3 fin
        si no pon_modo(an, al, bits) entonces devolver 0 fin
        si no prepara_ventanas() entonces
            escribir("escritorio: no hay memoria para la pantalla\n")
            devolver 0
        fin
        si no prepara_ratón(pantalla.ancho, pantalla.alto) entonces escribir("escritorio: no hay ratón PS/2 (se sigue, con el teclado)\n") fin
        alto_barra := ALTO_BARRA
        ; (los avisos del USB de antes de que hubiera escritorio, fuera)
        mientras saca_aviso(texto_globo, 80) hacer fin
        unidades_vistas := Unidades.cambios
        pinta_tapiz()
        v_barra := crear_ventana("barra", 0, pantalla.alto - ALTO_BARRA, pantalla.ancho, ALTO_BARRA, SIN_MARCO ob ENCIMA, 0)
        prepara_dock()                          ; (dock) encima de la barra
        pon_accesos()
        v_menú := crear_ventana("menú", 0, pantalla.alto - ALTO_BARRA - menú_alto, MENÚ_ANCHO, menú_alto, SIN_MARCO ob ENCIMA ob OCULTA ob REDONDA, 0)
        si v_barra = 0 o v_menú = 0 entonces
            escribir("escritorio: no hay memoria para la barra de tareas\n")
            devolver 0
        fin
        ventana_inicio := v_barra
        ; la ventana «del fondo» (no se ve): le llega lo que cae en el tapiz
        v_fondo := crear_ventana("fondo", 0, 0, 1, 1, SIN_MARCO ob OCULTA, 0)
        ventana_fondo := v_fondo
        ; los iconos del tapiz
        nuevo_icono("Mi equipo", AM_EQUIPO)
        nuevo_icono("Bloc de notas", AM_BLOC)
        nuevo_icono("Consola", AM_CONSOLA)
        i := 0
        mientras i < n_accesos hacer
            si en_escritorio(i) entonces nuevo_icono_de(nombre_de(i), AM_ACCESO, i) fin
            i := i + 1
        fin
        ; (dock) los accesos soltados en el tapiz
        lee_atajos()
        i := 0
        mientras i < n_atajos hacer
            nuevo_icono_de(dirección(atajos[i].nombre[0]), AM_ATAJO, i)
            i := i + 1
        fin
        organiza_iconos()
        pon_atajos()
        pon_iconos()
        pinta_barra()
        repintar_todo()
        t := crear_tarea("escritorio", nat32(dirección(tarea_escritorio)), 0)
        si t = nulo entonces
            escribir("escritorio: no quedan tareas\n")
            devolver 0
        fin
        t.terminal := 0
        t.salida := SIN_SALIDA
        t.padre := 1
        desviado := cierto
        escritorio_en_marcha := cierto
        tomar_consola()
        d[0] := nat32(pantalla.ancho)
        d[1] := nat32(pantalla.alto)
        d[2] := bits_pantalla
        si por_bochs entonces d[3] := nat32("lo ha puesto el núcleo, por la VBE de Bochs/QEMU") sino d[3] := nat32("lo ha dejado puesto el cargador") fin
        d[4] := fondo
        imprimir("escritorio: en marcha, %u x %u con %u bits por punto (el modo %s), tapiz %u\n", d)
        soltar_consola()
        ; un sistema instalado en el disco: sus ajustes (HISPA.INI); si aún
        ; no los tiene, es su primer arranque: el asistente. Si no, mirar sin
        ; molestar si hay actualizaciones (ACTUALIZ /BANDEJA; si no está, nada)
        si instalado() entonces
            si no hay_ajustes y no lee_ajustes() entonces
                lanza("\\HISPA\\ASISTE.BIN", nulo)
            sino
                t := cargar_archivo("\\HISPA\\ACTUALIZ.BIN", "/BANDEJA", an)
                si t <> nulo entonces t.padre := 0 fin
            fin
            mira_pantalla_guardada()
        fin
        devolver 1
    fin

    público función prepara_escritorio()
        al_escritorio := nat32(dirección(arranca))
    fin

fin Escritorio.
