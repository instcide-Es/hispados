módulo UEco

    modelo usuario

    importar Llamadas, Textos32

    variable args: arreglo [128] de byte
    variable una: arreglo [40] de byte

    función principal(): byte
        variable n: nat32
        argumentos(args, 128)
        n := 0
        mientras palabra(args, n, una, 40) hacer
            n := n + 1
        fin
        escribir(args, "\n")
        devolver n
    fin

fin UEco.
