; =============================================================================
;  upaquete.cas - PAQUETES.BIN: instalar, actualizar y quitar paquetes en el
;  Hispa-Pentium instalado en el disco. Un programa del anillo 3, en Castel.
;
;    PAQUETES LISTA                    lo instalado
;    PAQUETES CATALOGO                 lo que hay para instalar (y lo que es más nuevo)
;    PAQUETES INSTALA nombre|X.HPQ...  instala (con lo que necesite, en orden)
;    PAQUETES ACTUALIZA [nombre...]    pone al día lo instalado (todo, o eso)
;    PAQUETES QUITA nombre...          lo quita (si nadie lo necesita)
;    PAQUETES MIRA X.HPQ               lo que lleva un paquete, y si está sano
;    PAQUETES COMPRUEBA                si los archivos instalados siguen iguales
;    /DESDE=carpeta o /DESDE=http://...  de dónde se traen los paquetes
;    PAQUETES FIRMA ARCHIVO            si ARCHIVO.FIR es su firma buena
;    (PROGRAMAS, 21/11/2026)
;    PAQUETES LISTA /TIPO              lo instalado, por tipos (y lo suelto)
;    PAQUETES REPARA [nombre...]       comprueba sus sumas y vuelve a poner lo dañado
;    PAQUETES ARCHIVOS nombre          sus archivos, y si están como se instalaron
;    PAQUETES SUELTOS                  los programas sin paquete (.EXE, .BIN, .HVP)
;    PAQUETES FICHAS                   lo instalado con todo, para «Programas instalados»
;    PAQUETES QUITA nombre /DEPENDIENTES   y lo que lo necesite, antes
;    (base, red y paquetes no se quitan nunca: son imprescindibles)
;    /FORZAR                           quitar aunque lo necesite otro; poner
;                                      una versión más vieja o la misma
;
;  (USUARIOS, la serie) El catálogo firmado lleva «serie=N» (tools/hpq.py
;  la sube al firmar): PAQUETES apunta la más alta que ha visto
;  (C:\HISPA\PAQUETES\SERIE.TXT) y NO usa uno de Internet con la serie más
;  baja (o sin ella, si ya ha visto una): que nadie le sirva un catálogo
;  viejo, firmado de verdad, con versiones que tenían fallos ya arreglados.
;  Uno de una carpeta del equipo (el CD, una memoria) más viejo se usa, con
;  un aviso. Y (USUARIOS) instalar, actualizar, quitar y reparar, solo un
;  administrador (el núcleo, además, no le deja escribir en \HISPA a un
;  PAQUETES lanzado por un usuario normal: permisos.cas).
;  La firma: el catálogo (que lleva el SHA-256 de cada paquete, y cada
;  paquete los de sus archivos) va firmado (Ed25519, firma.cas) en
;  CATALOGO.FIR, con la clave privada del proyecto; la pública va dentro
;  (clave.cas). Lo que viene de Internet (por HTTP, sin cifrar) no se usa
;  sin firma buena. De una carpeta, si trae CATALOGO.FIR, también se
;  comprueba; si no la trae, se usa (la ha puesto ahí quien maneja el equipo).
;
;  El núcleo: cuando un paquete cambia \HISPA\NUCLEO.BIN, el de antes queda
;  en \HISPA\NUCLEO.ANT, GRUB.CFG lleva una entrada para él y \HISPA\GRUBENV
;  dice «nuevo=1»: al arrancar, GRUB lo pasa a 2 y arranca el nuevo; si el
;  sistema arranca bien, ACTUALIZ /BANDEJA lo pone a 0; si no (se cuelga, se
;  reinicia a mano), GRUB ve el 2 y arranca solo el de antes (3; y 4 cuando
;  ACTUALIZ ya lo ha dicho), hasta que se instale otro núcleo.
;
;  El avance (para la ventana, con /AVANCE): en C:\HISPA\PAQUETES\AVANCE.TXT,
;  una línea «hecho total texto», que se reescribe (DESCARGA la pone al día
;  mientras trae un paquete: /AVANCE=). La ventana la lee y luego la borra.
;
;  El tipo (PROGRAMAS): «tipo=» en la cabecera (sistema, oficina, internet...:
;  TIPOS); si no lo trae, el del catálogo («tipo=nombre código», una línea
;  aparte) se apunta en el registro al instalarlo; y si no, se deduce del
;  nombre (tipo_por_nombre), o es «otros».
;
;  Un paquete (.HPQ, tools/hpq.py) es una cabecera de texto (nombre, versión,
;  descripción, lo que necesita, con lo que choca y sus archivos, cada uno
;  con su destino, su tamaño y su SHA-256) y, detrás, los archivos. Lo
;  instalado se apunta en C:\HISPA\PAQUETES\NOMBRE.PQI (la cabecera tal cual).
;  Antes de copiar nada se comprueban las sumas de todos los archivos; los
;  archivos nuevos se escriben primero aparte (HPQnnnnn.NUE) y luego se
;  cambian por los de antes, que se guardan (HPQnnnnn.VIE) hasta el final. Lo
;  que se va a hacer se apunta antes en C:\HISPA\PAQUETES\DIARIO.TXT: si se
;  va la luz a mitad, la próxima vez que se usa PAQUETES se deshace y todo
;  queda como estaba. Cuando ya está todo cambiado, el diario pasa a
;  HECHO.TXT (desde ahí ya no se deshace: se acaba de limpiar).
;
;  De dónde salen los paquetes: lo que diga /DESDE=, o la primera línea de
;  C:\HISPA\PAQUETES\ORIGEN.TXT, o la carpeta \PAQUETES de una unidad que
;  tenga CATALOGO.TXT (primero las memorias USB), o, si no, Internet:
;  http://actualiza.hispados.es/pentium/ (por el gancho de la red, más abajo).
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo UPaquetes

    modelo usuario

    importar Llamadas, Textos32, Mem32, Formato, Sha256, Firma, Clave

    constante MAX_PAQ = 64                      ; paquetes instalados, en el catálogo o en un plan
    constante MAX_ARCH = 64                     ; archivos de un paquete
    constante MAX_PASOS = 160                   ; lo que hace una instalación
    constante MAX_CAB = 16384                   ; lo más que mide una cabecera
    constante MAX_CATÁLOGO = 65536
    constante TROZO = 32768
    constante RUTA = 160
    constante NINGUNO = 0xFFFFFFFF
    constante URL_POR_DEFECTO = "http://actualiza.hispados.es/pentium/"
    constante VERSIÓN_PAQUETES = "1.5"                ; (CORTES)

    ; (PROGRAMAS) los tipos: el código y su nombre, en el orden en que salen
    ; (los mismos que TIPOS en tools/hpq.py; docs/PENTIUM.md, sección 13)
    constante N_TIPOS = 11
    constante CÓDIGOS_TIPO = "sistema|oficina|internet|juegos|multimedia|seguridad|windows|herramientas|desarrollo|terceros|otros"
    constante NOMBRES_TIPO = "Sistema|Oficina|Internet y red|Juegos y emuladores|Multimedia|Seguridad|Programas de Windows|Herramientas|Desarrollo|Programas de terceros|Otros"
    constante TIPO_OTROS = 10
    ; el de los paquetes que no lo dicen (los de antes de la 0.8.4): como TIPO_POR_NOMBRE de hpq.py
    constante TIPO_POR_NOMBRE = "\nbase sistema\npaquetes sistema\nequipo sistema\nhvprun sistema\nred internet\ntls internet\nnavega internet\nssh internet\ntailscal internet\nwifi internet\nbloc oficina\noficina oficina\npdf oficina\nconsola herramientas\naccesori herramientas\ncomprim herramientas\nejemplos desarrollo\nwin32 windows\nescudo seguridad\nescbase seguridad\nescmes seguridad\nescdia seguridad\nsonido multimedia\nmirador multimedia\nclicgest terceros\n"
    ; los que no se quitan nunca, y por qué
    constante IMPRESCINDIBLES = "\nbase es el sistema mismo; sin él, el equipo no arranca\nred sin ella no llegan las actualizaciones ni se pueden traer programas\npaquetes es el que instala, repara y quita los programas\n"
    ; dónde se buscan los programas sueltos (sin paquete); con «*», también sus subcarpetas
    constante CARPETAS_SUELTOS = "|\\HISPA|\\HISPA32*|\\PROGRAMS*"
    constante MAX_SUELTOS = 64

    ; ---------------------------------------------------------------------
    ;  EL GANCHO DE LA RED. Para traer los paquetes de Internet, PAQUETES no
    ;  sabe de TCP/IP: se lo pide a otro. Con LLAMADA_DESCARGAR = 0 (lo de
    ;  ahora), lanza el programa DESCARGA.BIN (la orden DESCARGAR: su nombre
    ;  no cabe en 8+3) con dos argumentos, «URL DESTINO», lo espera, y vale
    ;  si acaba con el código 0 y DESTINO está.
    ;  Si el núcleo da la descarga como llamada al sistema, se pone aquí su
    ;  número y se llama con EBX = la URL y ECX = el archivo de destino (dos
    ;  textos acabados en 0); un error es lo de siempre (es_error). Lo
    ;  traído se deja en C:\HISPA\PAQUETES\BAJADAS.
    ; ---------------------------------------------------------------------
    constante LLAMADA_DESCARGAR = 0

    constante P_CARPETA = 1                     ; una carpeta que hay que hacer
    constante P_NUEVO = 2                       ; un archivo que se pone (nuevo, o en lugar del de antes)
    constante P_BORRA = 3                       ; un archivo que se quita

    tipo Archivo = estructura
        destino: arreglo [84] de byte           ; con la letra: «C:\HISPA\BLOC.BIN»
        tamaño: nat32
        sha: arreglo [68] de byte
    fin

    tipo Paso = estructura
        clase: nat32
        existía: nat32                          ; 1 si el destino ya estaba
        origen_: nat32                           ; dónde empiezan sus datos en el paquete (NINGUNO: el registro)
        tamaño: nat32
        sha: arreglo [68] de byte
        destino: arreglo [84] de byte
    fin

    variable args: arreglo [260] de byte
    variable palabra_: arreglo [RUTA] de byte
    variable buf: puntero a byte                ; TROZO octetos
    variable sis: byte                          ; la letra de la unidad del sistema
    variable base: arreglo [40] de byte         ; «C:\HISPA\PAQUETES»
    variable versión_núcleo: arreglo [16] de byte
    variable forzar: bool
    variable corte: nat32                       ; (las pruebas) pararse tras ese cambio, como si se fuera la luz
    variable cambios: nat32

    ; ---- lo instalado ----
    variable ins_n: nat32
    variable ins_nombre: arreglo [MAX_PAQ] de arreglo [12] de byte
    variable ins_versión: arreglo [MAX_PAQ] de arreglo [16] de byte
    variable ins_cab: arreglo [MAX_PAQ] de puntero a byte

    ; ---- de dónde y el catálogo ----
    variable origen: arreglo [RUTA] de byte     ; una carpeta («X:\PAQUETES\») o una URL («http://.../»)
    variable es_red: bool
    variable cat: puntero a byte                ; CATALOGO.TXT entero
    variable cat_n: nat32
    variable cat_mirado, hay_catálogo: bool
    variable cat_nombre: arreglo [MAX_PAQ] de arreglo [12] de byte
    variable cat_versión: arreglo [MAX_PAQ] de arreglo [16] de byte
    variable cat_archivo: arreglo [MAX_PAQ] de arreglo [16] de byte
    variable cat_tamaño: arreglo [MAX_PAQ] de nat32
    variable cat_sha: arreglo [MAX_PAQ] de arreglo [68] de byte
    variable cat_desc: arreglo [MAX_PAQ] de puntero a byte

    ; ---- lo que se va a instalar ----
    variable plan_n, orden_n: nat32
    variable plan_ruta: arreglo [MAX_PAQ] de arreglo [RUTA] de byte
    variable plan_cab: arreglo [MAX_PAQ] de puntero a byte
    variable plan_largo: arreglo [MAX_PAQ] de nat32
    variable plan_cat: arreglo [MAX_PAQ] de nat32
    variable plan_nombre: arreglo [MAX_PAQ] de arreglo [12] de byte
    variable plan_versión: arreglo [MAX_PAQ] de arreglo [16] de byte
    variable orden: arreglo [MAX_PAQ] de nat32  ; en qué orden (lo que se necesita, antes)

    ; ---- una instalación (o una desinstalación) ----
    variable nuevos: arreglo [MAX_ARCH] de Archivo
    variable viejos: arreglo [MAX_ARCH] de Archivo
    variable pasos: arreglo [MAX_PASOS] de Paso
    variable n_pasos: nat32
    variable txn_nombre: arreglo [40] de byte   ; «oficina 1.0»
    variable txn_paquete: arreglo [RUTA] de byte
    variable txn_cab: puntero a byte
    variable txn_largo: nat32
    variable diario: arreglo [48] de byte
    variable hecho: arreglo [48] de byte
    variable avance: arreglo [48] de byte       ; C:\HISPA\PAQUETES\AVANCE.TXT
    variable firmado: bool                      ; el catálogo lleva firma, y es buena
    variable cat_serie: nat32                   ; (USUARIOS) su «serie=» (0: no la trae)
    variable núcleo_nuevo: bool                 ; se ha cambiado \HISPA\NUCLEO.BIN
    variable con_avance: bool                   ; /AVANCE: lo pide la ventana
    ; (RÁPIDO) el avance dentro de un paquete grande (octetos) y «Cancelar»:
    ; si la ventana deja C:\HISPA\PAQUETES\CANCELA.TXT, se para en cuanto se
    ; puede (lo cambiado se deshace con el diario, como si se fuera la luz)
    variable cancela: arreglo [48] de byte
    variable cancelado: bool
    variable av_hecho, av_total, av_próximo: nat32
    variable av_qué, av_de: puntero a byte
    variable plan_bajado: nat32                 ; lo que se va a traer de Internet (para ver si cabe)
    variable cancela_en: nat32                  ; (las pruebas) /CANCELA_EN=K: «Cancelar» a esos K instalando
    variable av_instalando: bool
    ; (PROGRAMAS)
    variable por_tipo: bool                     ; /TIPO
    variable con_dependientes: bool             ; /DEPENDIENTES
    variable reparando: bool                    ; REPARA: solo se vuelve a poner lo dañado
    variable quitando: bool                     ; (el avance, archivo a archivo)
    variable av_h, av_t: nat32
    variable lento: bool                        ; (las pruebas) /LENTO: cada archivo quitado, un poco de espera
    variable con_catálogo: bool                 ; FICHAS /CATALOGO: también lo del catálogo
    variable con_limpia: bool                   ; (0.8.6) ESTADO /LIMPIA: antes, lo viejo de BAJADAS
    variable ins_fecha: arreglo [MAX_PAQ] de nat32  ; la fecha de su registro (la de la FAT): cuándo se instaló
    variable cat_tipos_n: nat32
    variable cat_tipo_nombre: arreglo [MAX_PAQ] de arreglo [12] de byte
    variable cat_tipo: arreglo [MAX_PAQ] de arreglo [16] de byte
    ; (SISTEMA, 0.8.6) los que el catálogo marca del sistema («sistema=nombre»)
    ; y los que se han quitado a propósito (QUITADOS.TXT, uno por línea: ACTUALIZA
    ; no los vuelve a poner; INSTALA los quita de ahí)
    constante MAX_QUITADOS = 1024
    variable cat_sis_n: nat32
    variable cat_sis: arreglo [MAX_PAQ] de arreglo [12] de byte
    variable quitados: arreglo [MAX_QUITADOS] de byte
    variable quitados2: arreglo [MAX_QUITADOS] de byte
    variable quitados_leídos: bool
    variable sueltos_n: nat32
    variable suelto_ruta: arreglo [MAX_SUELTOS] de arreglo [RUTA] de byte
    variable suelto_tamaño: arreglo [MAX_SUELTOS] de nat32
    variable suelto_fecha: arreglo [MAX_SUELTOS] de nat32

    ; -------------------------------------------------------------------------
    ;  Lo de siempre
    ; -------------------------------------------------------------------------
    función pt(t: puntero a byte): nat32
        devolver nat32(t)
    fin

    función une(destino: puntero a byte, a: puntero a byte, b: puntero a byte)
        Textos32.copiar(destino, a)
        concatenar(destino, b)
    fin

    función mal(t: puntero a byte): bool
        escribir("paquetes: ", t, "\n")
        devolver falso
    fin

    función existe(ruta: puntero a byte): bool
        variable m: nat32
        m := abrir(ruta)
        si es_error(m) entonces devolver falso fin
        cerrar(m)
        devolver cierto
    fin

    función acaba_en(t: puntero a byte, fin_: puntero a byte): bool
        variable a, b: nat32
        a := longitud(t)
        b := longitud(fin_)
        si a < b entonces devolver falso fin
        devolver iguales_sin_caja(t + (a - b), fin_)
    fin

    ; escribe t y, detrás, los espacios que falten hasta «ancho»
    función columna(t: puntero a byte, ancho: nat32)
        variable n: nat32
        escribir(t)
        n := longitud(t)
        mientras n < ancho hacer
            escribir(" ")
            n := n + 1
        fin
    fin

    función escribe_todo(m: nat32, p: puntero a byte, n: nat32): bool
        variable r: nat32
        si n = 0 entonces devolver cierto fin
        r := escribir_archivo(m, p, n)
        devolver r = n
    fin

    función lee_todo(m: nat32, p: puntero a byte, n: nat32): bool
        variable k, r: nat32
        k := 0
        mientras k < n hacer
            r := leer(m, p + k, n - k)
            si es_error(r) o r = 0 entonces devolver falso fin
            k := k + r
        fin
        devolver cierto
    fin

    ; la línea que empieza en p (sin su fin de línea), a destino; da dónde
    ; empieza la siguiente
    función línea(p: puntero a byte, destino: puntero a byte, cabe: nat32): puntero a byte
        variable i: nat32
        i := 0
        mientras valor(p) <> 0 y valor(p) <> '\n' hacer
            si valor(p) <> '\r' y i + 1 < cabe entonces
                destino[i] := valor(p)
                i := i + 1
            fin
            p := p + 1
        fin
        destino[i] := 0
        si valor(p) = '\n' entonces p := p + 1 fin
        devolver p
    fin

    ; lo que va detrás de «clave=» en una cabecera (o falso si no está)
    función campo(cab: puntero a byte, clave: puntero a byte, destino: puntero a byte, cabe: nat32): bool
        variable p: puntero a byte
        variable n: nat32
        variable x: arreglo [256] de byte
        n := longitud(clave)
        p := cab
        mientras valor(p) <> 0 hacer
            p := línea(p, x, 256)
            si empieza_por(x, clave) y x[n] = '=' entonces
                copiar_hasta(destino, dirección(x[n + 1]), cabe)
                devolver cierto
            fin
        fin
        destino[0] := 0
        devolver falso
    fin

    ; la carpeta de una ruta, a destino («C:\OFICINA\PLUMA.HVP» da «C:\OFICINA»)
    función carpeta_de(ruta: puntero a byte, destino: puntero a byte)
        variable i, u: nat32
        Textos32.copiar(destino, ruta)
        u := 0
        i := 0
        mientras destino[i] <> 0 hacer
            si destino[i] = '\\' entonces u := i fin
            i := i + 1
        fin
        destino[u] := 0
    fin

    ; el nombre del archivo temporal del paso i: en la carpeta de su destino,
    ; «HPQnnnnn.NUE» (lo nuevo) o «HPQnnnnn.VIE» (lo de antes)
    función temporal(i: nat32, ext: puntero a byte, destino: puntero a byte)
        variable t: arreglo [20] de byte
        variable d: arreglo [2] de nat32
        carpeta_de(pasos[i].destino, destino)
        d[0] := i
        d[1] := pt(ext)
        formatear(t, 20, "\\HPQ%05u.%s", d)
        concatenar(destino, t)
    fin

    ; la ruta de un archivo de la base (C:\HISPA\PAQUETES\...)
    función en_base(nombre: puntero a byte, destino: puntero a byte)
        une(destino, base, "\\")
        concatenar(destino, nombre)
    fin

    ; una ruta entera, con su letra: «A.HPQ» desde la carpeta de trabajo, «\X\A.HPQ»...
    función absoluta(t: puntero a byte, salida: puntero a byte)
        variable aquí: arreglo [RUTA] de byte
        si t[0] <> 0 y t[1] = ':' entonces
            copiar_hasta(salida, t, RUTA)
            salida[0] := mayúscula(salida[0])
            devolver
        fin
        salida[0] := unidad(0)
        salida[1] := ':'
        salida[2] := 0
        si t[0] <> '\\' entonces
            carpeta_actual(aquí, RUTA)
            concatenar(salida, aquí)
            si longitud(aquí) > 1 entonces concatenar(salida, "\\") fin
        fin
        concatenar(salida, t)
    fin

    ; -------------------------------------------------------------------------
    ;  Las versiones y las listas («base >= 0.7, nucleo»)
    ; -------------------------------------------------------------------------
    ; -1, 0 o 1 según a sea más vieja, igual o más nueva que b (0.10 > 0.9)
    función compara(a: puntero a byte, b: puntero a byte): ent32
        variable va, vb: nat32
        mientras valor(a) <> 0 o valor(b) <> 0 hacer
            va := 0
            mientras es_cifra(valor(a)) hacer
                va := va * 10 + valor(a) - '0'
                a := a + 1
            fin
            vb := 0
            mientras es_cifra(valor(b)) hacer
                vb := vb * 10 + valor(b) - '0'
                b := b + 1
            fin
            si va < vb entonces devolver -1 fin
            si va > vb entonces devolver 1 fin
            si valor(a) <> 0 entonces a := a + 1 fin
            si valor(b) <> 0 entonces b := b + 1 fin
        fin
        devolver 0
    fin

    ; los operadores: 0, cualquier versión; 1 >=; 2 <=; 3 =; 4 >; 5 <
    función cumple(v: puntero a byte, op: nat32, w: puntero a byte): bool
        variable c: ent32
        si op = 0 entonces devolver cierto fin
        c := compara(v, w)
        si op = 1 entonces devolver c >= 0 fin
        si op = 2 entonces devolver c <= 0 fin
        si op = 3 entonces devolver c = 0 fin
        si op = 4 entonces devolver c > 0 fin
        devolver c < 0
    fin

    función texto_op(op: nat32): puntero a byte
        si op = 1 entonces devolver " >= " fin
        si op = 2 entonces devolver " <= " fin
        si op = 3 entonces devolver " = " fin
        si op = 4 entonces devolver " > " fin
        si op = 5 entonces devolver " < " fin
        devolver ""
    fin

    función es_de_nombre(c: byte): bool
        devolver (c >= 'a' y c <= 'z') o (c >= 'A' y c <= 'Z') o es_cifra(c) o c = '-' o c = '_'
    fin

    ; el requisito número n de una lista: su nombre, su operador y su versión
    función requisito(t: puntero a byte, n: nat32, nombre: puntero a byte, ref op: nat32, versión: puntero a byte): bool
        variable i: nat32
        mientras n > 0 hacer
            mientras valor(t) <> 0 y valor(t) <> ',' hacer t := t + 1 fin
            si valor(t) = 0 entonces devolver falso fin
            t := t + 1
            n := n - 1
        fin
        t := saltar_espacios(t)
        i := 0
        mientras es_de_nombre(valor(t)) y i < 8 hacer
            nombre[i] := minúscula(valor(t))
            i := i + 1
            t := t + 1
        fin
        nombre[i] := 0
        versión[0] := 0
        op := 0
        si i = 0 entonces devolver falso fin
        t := saltar_espacios(t)
        si valor(t) = '>' y t[1] = '=' entonces
            op := 1
            t := t + 2
        sino si valor(t) = '<' y t[1] = '=' entonces
            op := 2
            t := t + 2
        sino si valor(t) = '=' entonces
            op := 3
            t := t + 1
            si valor(t) = '=' entonces t := t + 1 fin
        sino si valor(t) = '>' entonces
            op := 4
            t := t + 1
        sino si valor(t) = '<' entonces
            op := 5
            t := t + 1
        fin
        t := saltar_espacios(t)
        i := 0
        mientras (es_cifra(valor(t)) o valor(t) = '.') y i < 15 hacer
            versión[i] := valor(t)
            i := i + 1
            t := t + 1
        fin
        versión[i] := 0
        si op <> 0 y i = 0 entonces op := 0 fin
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  (PROGRAMAS) Los tipos de los paquetes
    ; -------------------------------------------------------------------------
    ; el trozo k de una lista «a|b|c», a destino
    función trozo_de(lista: puntero a byte, k: nat32, destino: puntero a byte, cabe: nat32)
        variable i: nat32
        mientras k > 0 y valor(lista) <> 0 hacer
            si valor(lista) = '|' entonces k := k - 1 fin
            lista := lista + 1
        fin
        i := 0
        mientras valor(lista) <> 0 y valor(lista) <> '|' y i + 1 < cabe hacer
            destino[i] := valor(lista)
            i := i + 1
            lista := lista + 1
        fin
        destino[i] := 0
    fin

    ; lo que va tras «\nclave » en una tabla («\nbase sistema\n...»), a destino
    función en_tabla(tabla: puntero a byte, clave: puntero a byte, destino: puntero a byte, cabe: nat32): bool
        variable patrón: arreglo [24] de byte
        variable p: puntero a byte
        variable i: nat32
        une(patrón, "\n", clave)
        concatenar(patrón, " ")
        p := buscar(tabla, patrón)
        destino[0] := 0
        si p = nulo entonces devolver falso fin
        p := p + longitud(patrón)
        i := 0
        mientras valor(p) <> '\n' y valor(p) <> 0 y i + 1 < cabe hacer
            destino[i] := valor(p)
            i := i + 1
            p := p + 1
        fin
        destino[i] := 0
        devolver cierto
    fin

    ; el número de un tipo (su código, o su nombre: «Internet y red»); TIPO_OTROS si no es ninguno
    función número_tipo(t: puntero a byte): nat32
        variable k: nat32
        variable x: arreglo [32] de byte
        para k desde 0 hasta N_TIPOS - 1 hacer
            trozo_de(CÓDIGOS_TIPO, k, x, 32)
            si iguales_sin_caja(t, x) entonces devolver k fin
            trozo_de(NOMBRES_TIPO, k, x, 32)
            si iguales_sin_caja(t, x) entonces devolver k fin
        fin
        devolver TIPO_OTROS
    fin

    ; el tipo que dice el catálogo de ese paquete (las líneas «tipo=nombre código»)
    función tipo_del_catálogo(nombre: puntero a byte, destino: puntero a byte): bool
        variable i: nat32
        para i desde 1 hasta cat_tipos_n hacer
            si iguales(cat_tipo_nombre[i - 1], nombre) entonces
                Textos32.copiar(destino, cat_tipo[i - 1])
                devolver cierto
            fin
        fin
        destino[0] := 0
        devolver falso
    fin

    ; el tipo de un paquete (su número): el de su cabecera; si no lo trae, el
    ; del catálogo (si está cargado) y, si no, el de su nombre; si no, «otros»
    función tipo_de(cab: puntero a byte, nombre: puntero a byte): nat32
        variable x: arreglo [32] de byte
        si cab <> nulo y campo(cab, "tipo", x, 32) y x[0] <> 0 entonces devolver número_tipo(x) fin
        si tipo_del_catálogo(nombre, x) entonces devolver número_tipo(x) fin
        si en_tabla(TIPO_POR_NOMBRE, nombre, x, 32) entonces devolver número_tipo(x) fin
        devolver TIPO_OTROS
    fin

    función código_tipo(k: nat32, destino: puntero a byte)
        trozo_de(CÓDIGOS_TIPO, k, destino, 16)
    fin

    función nombre_tipo(k: nat32, destino: puntero a byte)
        trozo_de(NOMBRES_TIPO, k, destino, 32)
    fin

    ; ¿es imprescindible? (base, red, paquetes, o «imprescindible=si» en su
    ; cabecera): por qué, a destino
    función imprescindible(i: nat32, destino: puntero a byte): bool
        variable x: arreglo [8] de byte
        si en_tabla(IMPRESCINDIBLES, ins_nombre[i], destino, 100) entonces devolver cierto fin
        si campo(ins_cab[i], "imprescindible", x, 8) y (x[0] = 's' o x[0] = 'S') entonces
            Textos32.copiar(destino, "lo dice su paquete")
            devolver cierto
        fin
        destino[0] := 0
        devolver falso
    fin

    ; una fecha de la FAT, «dd/mm/aaaa»
    función fecha_texto(f: nat32, destino: puntero a byte)
        variable d: arreglo [3] de nat32
        d[0] := f yb 31
        d[1] := (f >> 5) yb 15
        d[2] := ((f >> 9) yb 127) + 1980
        si f = 0 entonces
            destino[0] := 0
            devolver
        fin
        formatear(destino, 12, "%02u/%02u/%u", d)
    fin

    ; lo que ocupan los archivos de una cabecera
    función ocupa(cab: puntero a byte): nat32
        variable n, a, t: nat32
        n := lee_archivos(cab, viejos)
        t := 0
        para a desde 1 hasta n hacer t := t + viejos[a - 1].tamaño fin
        devolver t
    fin

    ; ¿está ese archivo como se instaló? 0 bien, 1 falta, 2 cambiado
    función estado_archivo(ruta: puntero a byte, mide: nat32, sha: puntero a byte): nat32
        variable m: nat32
        variable s: arreglo [68] de byte
        variable bien: bool
        m := abrir(ruta)
        si es_error(m) entonces devolver 1 fin
        bien := largo_de(m) = mide y resume(m, mide, s) y iguales(s, sha)
        cerrar(m)
        si bien entonces devolver 0 fin
        devolver 2
    fin

    ; -------------------------------------------------------------------------
    ;  Las cabeceras
    ; -------------------------------------------------------------------------
    ; lee la cabecera de un paquete (o de un registro .PQI): da una copia,
    ; acabada en 0, y en «largo» dónde empiezan los datos; nulo si no lo es
    función lee_cabecera(ruta: puntero a byte, ref largo: nat32): puntero a byte
        variable m, n, k, i: nat32
        variable p: puntero a byte
        m := abrir(ruta)
        si es_error(m) entonces devolver nulo fin
        n := 0
        mientras n < MAX_CAB hacer
            k := leer(m, buf + n, MAX_CAB - n)
            si es_error(k) o k = 0 entonces romper fin
            n := n + k
        fin
        cerrar(m)
        si n < 8 o comparar_memoria(buf, "HPQ 1", 5) <> 0 o (buf[5] <> '\r' y buf[5] <> '\n') entonces devolver nulo fin
        largo := 0
        i := 5
        mientras i + 4 < n y largo = 0 hacer
            si buf[i] = '\n' y buf[i + 1] = 'f' y buf[i + 2] = 'i' y buf[i + 3] = 'n' entonces
                si buf[i + 4] = '\n' entonces
                    largo := i + 5
                sino si i + 5 < n y buf[i + 4] = '\r' y buf[i + 5] = '\n' entonces
                    largo := i + 6
                fin
            fin
            i := i + 1
        fin
        si largo = 0 entonces devolver nulo fin
        p := más_memoria(largo + 1)
        si p = nulo entonces devolver nulo fin
        copiar_memoria(p, buf, largo)
        p[largo] := 0
        devolver p
    fin

    ; los archivos de una cabecera, a «lista» (con la letra del sistema delante)
    función lee_archivos(cab: puntero a byte, lista: puntero a Archivo): nat32
        variable p: puntero a byte
        variable n, t: nat32
        variable x: arreglo [256] de byte
        variable w: arreglo [84] de byte
        n := 0
        p := cab
        mientras valor(p) <> 0 y n < MAX_ARCH hacer
            p := línea(p, x, 256)
            si empieza_por(x, "archivo=") entonces
                palabra(dirección(x[8]), 0, w, 80)
                lista[n].destino[0] := sis
                lista[n].destino[1] := ':'
                Textos32.copiar(dirección(lista[n].destino[2]), w)
                palabra(dirección(x[8]), 1, w, 84)
                si no texto_a_natural(w, t) entonces t := NINGUNO fin
                lista[n].tamaño := t
                palabra(dirección(x[8]), 2, dirección(lista[n].sha[0]), 68)
                n := n + 1
            fin
        fin
        devolver n
    fin

    ; ¿es buena la cabecera? (su nombre, su versión y sus archivos)
    función valida(cab: puntero a byte, ruta: puntero a byte): bool
        variable n, i, j: nat32
        variable x: arreglo [64] de byte
        variable bien: bool
        bien := campo(cab, "nombre", x, 64) y x[0] <> 0 y longitud(x) <= 8
        i := 0
        mientras bien y x[i] <> 0 hacer
            si no es_de_nombre(x[i]) entonces bien := falso fin
            i := i + 1
        fin
        bien := bien y campo(cab, "version", x, 64) y es_cifra(x[0])
        si no bien entonces
            imprimir1("paquetes: %s no es un paquete que valga (su nombre o su versión)\n", pt(ruta))
            devolver falso
        fin
        n := lee_archivos(cab, nuevos)
        para i desde 1 hasta n hacer
            bien := nuevos[i - 1].destino[2] = '\\' y nuevos[i - 1].tamaño <> NINGUNO y longitud(nuevos[i - 1].sha) = 64
            bien := bien y no empieza_por(dirección(nuevos[i - 1].destino[2]), "\\HISPA\\PAQUETES\\")
            Textos32.copiar(x, dirección(nuevos[i - 1].destino[2]))
            a_mayúsculas(x)
            bien := bien y no empieza_por(x, "\\HISPA\\PAQUETES\\") y buscar(x, "..") = nulo
            ; (seguridad) el núcleo toma «/» por «\» y junta las barras seguidas y los «\.\»:
            ; con ellas se llegaba a \HISPA\PAQUETES sin que se notara
            bien := bien y buscar_car(x, '/') = nulo y buscar(x, "\\\\") = nulo y buscar(x, "\\.\\") = nulo
            si no bien entonces
                imprimir2("paquetes: %s: el archivo %s no vale\n", pt(ruta), pt(nuevos[i - 1].destino))
                devolver falso
            fin
            para j desde 1 hasta i - 1 hacer
                si iguales_sin_caja(nuevos[i - 1].destino, nuevos[j - 1].destino) entonces
                    imprimir2("paquetes: %s: el archivo %s sale dos veces\n", pt(ruta), pt(nuevos[i - 1].destino))
                    devolver falso
                fin
            fin
        fin
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  Lo instalado (C:\HISPA\PAQUETES\*.PQI)
    ; -------------------------------------------------------------------------
    función carga_instalados()
        variable m, largo: nat32
        variable e: Entrada
        variable r: arreglo [RUTA] de byte
        variable cab: puntero a byte
        ins_n := 0
        m := abrir(base)
        si es_error(m) entonces devolver fin
        mientras ins_n < MAX_PAQ y entrada(m, e) hacer
            si e.atributos yb CARPETA = 0 y acaba_en(e.nombre, ".PQI") entonces
                en_base(e.nombre, r)
                cab := lee_cabecera(r, largo)
                si cab <> nulo y campo(cab, "nombre", ins_nombre[ins_n], 12) entonces
                    campo(cab, "version", ins_versión[ins_n], 16)
                    ins_cab[ins_n] := cab
                    ins_fecha[ins_n] := nat32(e.fecha)
                    ins_n := ins_n + 1
                sino
                    imprimir1("paquetes: el registro %s no se puede leer (no cuenta)\n", pt(r))
                fin
            fin
        fin
        cerrar(m)
    fin

    función instalado(nombre: puntero a byte): nat32
        variable i: nat32
        para i desde 1 hasta ins_n hacer
            si iguales(ins_nombre[i - 1], nombre) entonces devolver i - 1 fin
        fin
        devolver NINGUNO
    fin

    ; la versión instalada de ese paquete (el «nucleo», si no es un paquete, es el que está en marcha)
    función versión_instalada(nombre: puntero a byte, destino: puntero a byte): bool
        variable i: nat32
        i := instalado(nombre)
        si i <> NINGUNO entonces
            Textos32.copiar(destino, ins_versión[i])
            devolver cierto
        fin
        si iguales(nombre, "nucleo") entonces
            Textos32.copiar(destino, versión_núcleo)
            devolver cierto
        fin
        destino[0] := 0
        devolver falso
    fin

    ; apunta (o cambia) en la lista de lo instalado lo que se acaba de instalar
    función apunta_instalado(nombre: puntero a byte, versión: puntero a byte, cab: puntero a byte)
        variable i: nat32
        i := instalado(nombre)
        si i = NINGUNO entonces
            si ins_n >= MAX_PAQ entonces devolver fin
            i := ins_n
            ins_n := ins_n + 1
        fin
        Textos32.copiar(ins_nombre[i], nombre)
        Textos32.copiar(ins_versión[i], versión)
        ins_cab[i] := cab
        ins_fecha[i] := dato(DATO_FECHA) >> 16
    fin

    función olvida_instalado(nombre: puntero a byte)
        variable i, j: nat32
        i := instalado(nombre)
        si i = NINGUNO entonces devolver fin
        para j desde i + 1 hasta ins_n - 1 hacer
            Textos32.copiar(ins_nombre[j - 1], ins_nombre[j])
            Textos32.copiar(ins_versión[j - 1], ins_versión[j])
            ins_cab[j - 1] := ins_cab[j]
            ins_fecha[j - 1] := ins_fecha[j]
        fin
        ins_n := ins_n - 1
    fin

    ; -------------------------------------------------------------------------
    ;  De dónde: una carpeta, o Internet (por el gancho de la red)
    ; -------------------------------------------------------------------------
    función pon_origen(t: puntero a byte)
        variable n: nat32
        copiar_hasta(origen, t, RUTA - 2)
        es_red := empieza_por(origen, "http://") o empieza_por(origen, "HTTP://") o empieza_por(origen, "https://")
        n := longitud(origen)
        si es_red entonces
            si n > 0 y origen[n - 1] <> '/' entonces concatenar(origen, "/") fin
        sino
            si n > 0 y origen[n - 1] <> '\\' entonces concatenar(origen, "\\") fin
        fin
    fin

    función busca_origen()
        variable vuelta, i, n, m: nat32
        variable u: Info_unidad
        variable r: arreglo [RUTA] de byte
        variable x: arreglo [RUTA] de byte
        si origen[0] <> 0 entonces devolver fin
        ; lo que diga ORIGEN.TXT
        en_base("ORIGEN.TXT", r)
        m := abrir(r)
        si no es_error(m) entonces
            n := leer(m, buf, RUTA - 1)
            cerrar(m)
            si no es_error(n) entonces
                buf[n] := 0
                línea(buf, x, RUTA)
                si x[0] <> 0 entonces
                    pon_origen(saltar_espacios(x))
                    devolver
                fin
            fin
        fin
        ; la carpeta \PAQUETES de una unidad, con su catálogo: primero las memorias USB
        para vuelta desde 0 hasta 1 hacer
            i := 0
            mientras info_unidad(i, u) hacer
                si u.letra <> 0 y ((vuelta = 0 y u.medio = MEDIO_USB) o (vuelta = 1 y u.medio <> MEDIO_USB)) entonces
                    r[0] := u.letra
                    r[1] := 0
                    concatenar(r, ":\\PAQUETES\\CATALOGO.TXT")
                    si existe(r) entonces
                        r[12] := 0
                        pon_origen(r)
                        devolver
                    fin
                fin
                i := i + 1
            fin
        fin
        pon_origen(URL_POR_DEFECTO)
    fin

    función llamada_red(n: nat32, url: puntero a byte, destino: puntero a byte): nat32
        ensamblador
            mov eax, {n}
            mov ebx, {url}
            mov ecx, {destino}
            int 0x80
        fin
    fin

    ; trae de Internet la URL al archivo «destino» (el gancho de la red)
    función descarga(url: puntero a byte, destino: puntero a byte): bool
        variable r, t: nat32
        variable a: arreglo [RUTA * 2 + 4] de byte
        imprimir1("Trayendo %s...\n", pt(url))
        borrar(destino)
        si LLAMADA_DESCARGAR <> 0 entonces
            r := llamada_red(LLAMADA_DESCARGAR, url, destino)
            si es_error(r) o no existe(destino) entonces
                imprimir2("paquetes: no se ha podido traer %s (%s)\n", pt(url), pt(texto_error(r)))
                devolver falso
            fin
            devolver cierto
        fin
        une(a, url, " ")
        concatenar(a, destino)
        si avance[0] <> 0 entonces
            concatenar(a, " /AVANCE=")
            concatenar(a, avance)
        fin
        ; (RÁPIDO) DESCARGA para si aparece CANCELA.TXT junto a AVANCE.TXT (sin
        ; más argumentos: no pasan de 128 letras)
        t := lanzar("DESCARGA.BIN", a)
        si es_error(t) entonces
            imprimir1("paquetes: para traer %s de Internet hace falta la red (el programa DESCARGA),\n", pt(url))
            escribir("  y este sistema aún no la tiene. Use una carpeta o una memoria USB con los paquetes:\n")
            escribir("  PAQUETES ... /DESDE=X:\\PAQUETES (o ponga la carpeta en C:\\HISPA\\PAQUETES\\ORIGEN.TXT).\n")
            devolver falso
        fin
        r := espera_descarga(t)
        si r = 3 o cancelado entonces
            ; (CORTES) cancelado: lo traído a medias, fuera
            borrar(destino)
            escribir("paquetes: cancelado: lo traído a medias se ha borrado y todo queda como estaba.\n")
            cancelado := cierto
            devolver falso
        fin
        si r = 4 entonces
            ; (el servidor dice que no lo tiene: 404)
            si acaba_en(url, "CATALOGO.TXT") entonces
                escribir("Todavía no hay actualizaciones publicadas en el servidor.\n")
            sino
                imprimir1("paquetes: el servidor no tiene %s (¿se está publicando una versión nueva? Pruebe más tarde)\n", pt(url))
            fin
            devolver falso
        fin
        si r <> 0 o no existe(destino) entonces
            imprimir2("paquetes: no se ha podido traer %s (DESCARGA acaba con el código %u)\n", pt(url), r)
            devolver falso
        fin
        devolver cierto
    fin

    ; (CORTES) espera a DESCARGA sin quedarse parado: si se pide cancelar
    ; (CANCELA.TXT) y en 1,5 s no ha parado él solo (está esperando a la
    ; red, a un servidor que no contesta...), se le acaba. Da su código (3:
    ; cancelado)
    función espera_descarga(t: nat32): nat32
        variable r, k, visto: nat32
        k := 0
        visto := 0
        mientras cierto hacer
            r := acabada(t)
            si r <> SIGUE entonces devolver r fin
            k := k + 1
            si visto > 0 entonces
                visto := visto + 1
                si visto > 15 entonces
                    escribir("paquetes: DESCARGA no para: se le acaba.\n")
                    acabar_hija(t)
                    esperar(t)
                    devolver 3
                fin
            sino si k mod 3 = 0 y se_cancela() entonces
                visto := 1
            fin
            dormir(10)
        fin
        devolver 1
    fin

    ; el archivo «nombre» del origen: da en «destino» dónde está (en la
    ; carpeta, o traído de Internet a C:\HISPA\PAQUETES\BAJADAS)
    función trae(nombre: puntero a byte, destino: puntero a byte): bool
        variable url: arreglo [RUTA * 2] de byte
        busca_origen()
        si no es_red entonces
            une(destino, origen, nombre)
            si existe(destino) entonces devolver cierto fin
            imprimir2("paquetes: no está %s en %s\n", pt(nombre), pt(origen))
            devolver falso
        fin
        di_avance(0, 0, "Bajando", nombre)
        en_base("BAJADAS", destino)
        crear_carpeta(destino)
        concatenar(destino, "\\")
        concatenar(destino, nombre)
        une(url, origen, nombre)
        devolver descarga(url, destino)
    fin

    ; salta n palabras de t: dónde empieza lo demás
    función tras_palabras(t: puntero a byte, n: nat32): puntero a byte
        t := saltar_espacios(t)
        mientras n > 0 hacer
            mientras valor(t) <> 0 y no es_espacio(valor(t)) hacer t := t + 1 fin
            t := saltar_espacios(t)
            n := n - 1
        fin
        devolver t
    fin

    ; el avance, para la ventana: «hecho total texto» (se pisa cada vez)
    función di_avance(h: nat32, total: nat32, t: puntero a byte, nombre: puntero a byte)
        variable m: nat32
        variable d: arreglo [4] de nat32
        variable x: arreglo [120] de byte
        si avance[0] = 0 entonces devolver fin
        d[0] := h
        d[1] := total
        d[2] := pt(t)
        d[3] := pt(nombre)
        formatear(x, 120, "%u %u %s %s\r\n", d)
        m := crear(avance)
        si es_error(m) entonces devolver fin
        escribir_archivo(m, x, longitud(x))
        cerrar(m)
    fin

    ; (RÁPIDO) empieza a contar octetos de algo largo: «qué» (Comprobando,
    ; Instalando) y «de» (el paquete); el avance va cada 512 K
    función av_empieza(total: nat32, qué: puntero a byte, de: puntero a byte)
        av_hecho := 0
        av_total := total
        av_próximo := 0
        av_qué := qué
        av_de := de
    fin

    ; k octetos más: falso si se ha pedido cancelar
    función av_lleva(k: nat32): bool
        av_hecho := av_hecho + k
        si cancela_en <> 0 y av_instalando y av_hecho div 1024 >= cancela_en y no cancelado entonces
            escribir("paquetes: cancelado (prueba: /CANCELA_EN; lo que se haya cambiado se deshace).\n")
            cancelado := cierto
        fin
        si av_hecho >= av_próximo entonces
            av_próximo := av_hecho + 524288
            si av_total > 0 entonces di_avance(av_hecho div 1024, av_total div 1024, av_qué, av_de) fin
            si cancela[0] <> 0 y existe(cancela) entonces
                si no cancelado entonces escribir("paquetes: cancelado (lo que se haya cambiado se deshace).\n") fin
                cancelado := cierto
            fin
        fin
        devolver no cancelado
    fin

    ; ¿se ha pedido cancelar? (entre paso y paso)
    función se_cancela(): bool
        si cancela[0] <> 0 y no cancelado y existe(cancela) entonces
            escribir("paquetes: cancelado.\n")
            cancelado := cierto
        fin
        devolver cancelado
    fin

    ; (RÁPIDO) ¿cabe lo que se va a traer del paquete c del catálogo (y,
    ; luego, instalado: otro tanto)? Antes de bajar 20 MB a una memoria de 256
    función cabe_bajada(c: nat32): bool
        variable i, k: nat32
        variable u: Info_unidad
        busca_origen()
        si no es_red entonces devolver cierto fin
        plan_bajado := plan_bajado + cat_tamaño[c] div 1024 + 4
        k := plan_bajado * 2 + 1024
        i := 0
        mientras info_unidad(i, u) hacer
            si u.letra = sis entonces
                si u.libre_k <> 0xFFFFFFFF y u.libre_k < k entonces
                    imprimir3("paquetes: no cabe: para traer e instalar %s hacen falta %u MB y en el disco del sistema quedan %u MB.\n", pt(cat_nombre[c]), (k + 1023) div 1024, u.libre_k div 1024)
                    escribir("  Haga sitio (borre lo que no necesite) y vuelva a probar.\n")
                    devolver falso
                fin
                devolver cierto
            fin
            i := i + 1
        fin
        devolver cierto
    fin

    ; ¿empieza t por p? (sin mirar mayúsculas)
    función empieza_con(t: puntero a byte, p: puntero a byte): bool
        mientras valor(p) <> 0 hacer
            si minúscula(valor(t)) <> minúscula(valor(p)) entonces devolver falso fin
            t := t + 1
            p := p + 1
        fin
        devolver cierto
    fin

    ; lo traído de Internet a BAJADAS ya no hace falta (instalado o no):
    ; fuera, que en una memoria pequeña son megas
    función suelta_bajadas()
        variable i: nat32
        variable b: arreglo [RUTA] de byte
        si base[0] = 0 entonces devolver fin
        en_base("BAJADAS\\", b)
        para i desde 1 hasta plan_n hacer
            si empieza_con(plan_ruta[i - 1], b) entonces borrar(plan_ruta[i - 1]) fin
        fin
    fin

    ; (0.8.6) lo que dejaron en BAJADAS los PAQUETES de antes de la 0.8.6 (no
    ; lo borraban: con las firmas de Escudo, unos 50 MB que, además, Escudo
    ; revisaba cada vez): fuera los .HPQ, antes de instalar o actualizar
    variable viejas: arreglo [MAX_PAQ] de arreglo [16] de byte
    función limpia_bajadas()
        variable m, n, i: nat32
        variable e: Entrada
        variable b: arreglo [RUTA] de byte
        variable r: arreglo [RUTA] de byte
        si base[0] = 0 entonces devolver fin
        en_base("BAJADAS", b)
        m := abrir(b)
        si es_error(m) entonces devolver fin
        n := 0
        ; (primero los nombres; se borran luego, con la carpeta cerrada)
        mientras n < MAX_PAQ y entrada(m, e) hacer
            si e.atributos yb CARPETA = 0 y acaba_en(e.nombre, ".HPQ") entonces
                copiar_hasta(viejas[n], e.nombre, 16)
                n := n + 1
            fin
        fin
        cerrar(m)
        para i desde 1 hasta n hacer
            une(r, b, "\\")
            concatenar(r, viejas[i - 1])
            borrar(r)
        fin
    fin

    función cifra_hex(c: byte): nat32
        si c >= '0' y c <= '9' entonces devolver nat32(c - '0') fin
        si c >= 'a' y c <= 'f' entonces devolver nat32(c - 'a') + 10 fin
        si c >= 'A' y c <= 'F' entonces devolver nat32(c - 'A') + 10 fin
        devolver 16
    fin

    ; lee una firma (un archivo «ed25519 <128 cifras>») a f (64 octetos)
    función lee_firma(ruta: puntero a byte, f: puntero a byte): bool
        variable m, n, i, a, b: nat32
        variable x: arreglo [200] de byte
        m := abrir(ruta)
        si es_error(m) entonces devolver falso fin
        n := leer(m, x, 199)
        cerrar(m)
        si es_error(n) o n < 136 o comparar_memoria(x, "ed25519 ", 8) <> 0 entonces devolver falso fin
        para i desde 0 hasta 63 hacer
            a := cifra_hex(x[8 + i * 2])
            b := cifra_hex(x[9 + i * 2])
            si a > 15 o b > 15 entonces devolver falso fin
            f[i] := byte(a * 16 + b)
        fin
        devolver cierto
    fin

    ; ¿lleva el catálogo (los n octetos de cat) su firma buena? Lo de Internet
    ; tiene que llevarla; lo de una carpeta, solo si trae CATALOGO.FIR
    función firma_del_catálogo(n: nat32): bool
        variable r: arreglo [RUTA] de byte
        variable f: arreglo [64] de byte
        variable t0: nat32
        firmado := falso
        si es_red entonces
            si no trae("CATALOGO.FIR", r) entonces
                devolver mal("el catálogo de Internet no trae su firma (CATALOGO.FIR): no se usa")
            fin
        sino
            une(r, origen, "CATALOGO.FIR")
            si no existe(r) entonces devolver cierto fin
        fin
        si no lee_firma(r, f) entonces devolver mal("la firma del catálogo (CATALOGO.FIR) no se entiende: no se usa el catálogo") fin
        di_avance(0, 0, "Comprobando", "la firma del catálogo")
        t0 := tics()
        si no Firma.verifica(f, cat, n, dirección(Clave.pública[0])) entonces
            escribir("paquetes: la firma del catálogo NO es buena: no se usa nada de él\n")
            escribir("  (no lo ha hecho quien tiene la clave de Hispa-Pentium, o lo han cambiado por el camino)\n")
            devolver falso
        fin
        imprimir2("La firma del catálogo es buena (la clave %s; %u tics).\n", pt(Clave.HUELLA), tics() - t0)
        firmado := cierto
        devolver cierto
    fin

    ; CATALOGO.TXT: «paquete=nombre versión ARCHIVO.HPQ octetos sha256 descripción»
    función carga_catálogo(): bool
        variable m, n, k, t: nat32
        variable p, l: puntero a byte
        variable r: arreglo [RUTA] de byte
        variable w: arreglo [24] de byte
        si cat_mirado entonces devolver hay_catálogo fin
        cat_mirado := cierto
        si no trae("CATALOGO.TXT", r) entonces devolver falso fin
        m := abrir(r)
        si es_error(m) entonces devolver falso fin
        n := 0
        mientras n < MAX_CATÁLOGO hacer
            k := leer(m, cat + n, MAX_CATÁLOGO - n)
            si es_error(k) o k = 0 entonces romper fin
            n := n + k
        fin
        cerrar(m)
        cat[n] := 0
        si no empieza_por(cat, "HPQ-CATALOGO 1") entonces
            imprimir1("paquetes: %s no es un catálogo de paquetes\n", pt(r))
            devolver falso
        fin
        si no firma_del_catálogo(n) entonces devolver falso fin
        ; cada línea, un texto aparte (los fines de línea, a 0)
        para k desde 1 hasta n hacer
            si cat[k - 1] = '\r' o cat[k - 1] = '\n' entonces cat[k - 1] := 0 fin
        fin
        cat_n := 0
        cat_tipos_n := 0
        cat_sis_n := 0
        cat_serie := 0
        p := cat
        mientras p < cat + n y cat_n < MAX_PAQ hacer
            l := p
            mientras valor(p) <> 0 hacer p := p + 1 fin
            p := p + 1
            ; (PROGRAMAS) «tipo=nombre código»
            si empieza_por(l, "tipo=") y cat_tipos_n < MAX_PAQ entonces
                palabra(l + 5, 0, cat_tipo_nombre[cat_tipos_n], 12)
                palabra(l + 5, 1, cat_tipo[cat_tipos_n], 16)
                si cat_tipo[cat_tipos_n][0] <> 0 entonces cat_tipos_n := cat_tipos_n + 1 fin
            fin
            ; (USUARIOS) «serie=N»: el número de este catálogo firmado
            si empieza_por(l, "serie=") entonces
                si no texto_a_natural(l + 6, cat_serie) entonces cat_serie := 0 fin
            fin
            ; (SISTEMA) «sistema=nombre»
            si empieza_por(l, "sistema=") y cat_sis_n < MAX_PAQ entonces
                palabra(l + 8, 0, cat_sis[cat_sis_n], 12)
                si cat_sis[cat_sis_n][0] <> 0 entonces cat_sis_n := cat_sis_n + 1 fin
            fin
            si empieza_por(l, "paquete=") entonces
                l := l + 8
                palabra(l, 0, cat_nombre[cat_n], 12)
                palabra(l, 1, cat_versión[cat_n], 16)
                palabra(l, 2, cat_archivo[cat_n], 16)
                palabra(l, 3, w, 24)
                si no texto_a_natural(w, t) entonces t := 0 fin
                cat_tamaño[cat_n] := t
                palabra(l, 4, cat_sha[cat_n], 68)
                cat_desc[cat_n] := tras_palabras(l, 5)
                si cat_nombre[cat_n][0] <> 0 y cat_archivo[cat_n][0] <> 0 entonces cat_n := cat_n + 1 fin
            fin
        fin
        si firmado y no mira_serie() entonces
            cat_n := 0
            devolver falso
        fin
        hay_catálogo := cierto
        devolver cierto
    fin

    ; (USUARIOS) la serie más alta vista (SERIE.TXT; 0 si no hay)
    función serie_vista(): nat32
        variable r: arreglo [RUTA] de byte
        variable t: arreglo [24] de byte
        variable m, n, v: nat32
        en_base("SERIE.TXT", r)
        m := abrir(r)
        si es_error(m) entonces devolver 0 fin
        n := leer(m, t, 23)
        cerrar(m)
        si es_error(n) entonces devolver 0 fin
        t[n] := 0
        mientras n > 0 y (t[n - 1] = '\r' o t[n - 1] = '\n') hacer
            n := n - 1
            t[n] := 0
        fin
        si no texto_a_natural(t, v) entonces devolver 0 fin
        devolver v
    fin

    ; (USUARIOS) ¿se puede usar el catálogo firmado, por su serie? (contra la
    ; vuelta atrás: uno viejo, firmado de verdad, servido otra vez). Si es más
    ; nueva que la vista, se apunta
    función mira_serie(): bool
        variable r: arreglo [RUTA] de byte
        variable t: arreglo [24] de byte
        variable vista, m: nat32
        vista := serie_vista()
        si cat_serie < vista o (cat_serie = 0 y vista > 0) entonces
            si es_red entonces
                imprimir2("paquetes: el catálogo de Internet es más viejo (serie %u) que el último que se ha usado (serie %u): no se usa\n", cat_serie, vista)
                escribir("  (alguien puede estar dando uno de antes, con versiones que tenían fallos ya arreglados)\n")
                devolver falso
            fin
            imprimir2("paquetes: ojo: este catálogo es más viejo (serie %u) que el último visto (serie %u); se usa porque es de una carpeta de este equipo\n", cat_serie, vista)
            devolver cierto
        fin
        si cat_serie > vista entonces
            en_base("SERIE.TXT", r)
            natural_a_texto(cat_serie, t)
            concatenar(t, "\r\n")
            m := crear(r)
            si no es_error(m) entonces
                escribir_archivo(m, t, longitud(t))
                cerrar(m)
            fin
        fin
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  (SISTEMA) Los paquetes nuevos del sistema y los quitados a propósito
    ; -------------------------------------------------------------------------
    función lee_quitados()
        variable r: arreglo [RUTA] de byte
        variable m, n, k: nat32
        si quitados_leídos entonces devolver fin
        quitados_leídos := cierto
        quitados[0] := 0
        en_base("QUITADOS.TXT", r)
        m := abrir(r)
        si es_error(m) entonces devolver fin
        n := 0
        mientras n < MAX_QUITADOS - 1 hacer
            k := leer(m, dirección(quitados[n]), MAX_QUITADOS - 1 - n)
            si es_error(k) o k = 0 entonces romper fin
            n := n + k
        fin
        cerrar(m)
        quitados[n] := 0
    fin

    ; ¿se ha quitado a propósito (PAQUETES QUITA)?
    función quitado(nombre: puntero a byte): bool
        variable p: puntero a byte
        variable x: arreglo [16] de byte
        lee_quitados()
        p := dirección(quitados[0])
        mientras valor(p) <> 0 hacer
            p := línea(p, x, 16)
            si iguales(x, nombre) entonces devolver cierto fin
        fin
        devolver falso
    fin

    función escribe_quitados()
        variable r: arreglo [RUTA] de byte
        variable m: nat32
        en_base("QUITADOS.TXT", r)
        si quitados[0] = 0 entonces
            si existe(r) entonces borrar(r) fin
            devolver
        fin
        m := crear(r)
        si es_error(m) entonces devolver fin
        escribe_todo(m, dirección(quitados[0]), longitud(quitados))
        cerrar(m)
    fin

    ; lo apunta en QUITADOS.TXT (al quitarlo)
    función apunta_quitado(nombre: puntero a byte)
        si quitado(nombre) entonces devolver fin
        si longitud(quitados) + longitud(nombre) + 3 >= MAX_QUITADOS entonces devolver fin
        concatenar(quitados, nombre)
        concatenar(quitados, "\r\n")
        escribe_quitados()
    fin

    ; lo borra de QUITADOS.TXT (al instalarlo otra vez)
    función olvida_quitado(nombre: puntero a byte)
        variable p: puntero a byte
        variable x: arreglo [16] de byte
        si no quitado(nombre) entonces devolver fin
        quitados2[0] := 0
        p := dirección(quitados[0])
        mientras valor(p) <> 0 hacer
            p := línea(p, x, 16)
            si x[0] <> 0 y no iguales(x, nombre) entonces
                concatenar(quitados2, x)
                concatenar(quitados2, "\r\n")
            fin
        fin
        Textos32.copiar(quitados, quitados2)
        escribe_quitados()
    fin

    ; ¿es del sistema (el catálogo lo dice), está en el catálogo, aquí no está
    ; instalado y no se ha quitado a propósito? Lo pone ACTUALIZA
    función sistema_nuevo(nombre: puntero a byte): bool
        variable i: nat32
        si instalado(nombre) <> NINGUNO o mejor_del_catálogo(nombre, 0, "") = NINGUNO o quitado(nombre) entonces devolver falso fin
        para i desde 1 hasta cat_sis_n hacer
            si iguales(cat_sis[i - 1], nombre) entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; la versión más nueva de ese paquete en el catálogo que cumpla (op, versión)
    función mejor_del_catálogo(nombre: puntero a byte, op: nat32, versión: puntero a byte): nat32
        variable i, mejor: nat32
        mejor := NINGUNO
        para i desde 1 hasta cat_n hacer
            si iguales(cat_nombre[i - 1], nombre) y cumple(cat_versión[i - 1], op, versión) entonces
                si mejor = NINGUNO entonces
                    mejor := i - 1
                sino si compara(cat_versión[i - 1], cat_versión[mejor]) > 0 entonces
                    mejor := i - 1
                fin
            fin
        fin
        devolver mejor
    fin

    ; -------------------------------------------------------------------------
    ;  El plan: lo que hay que instalar, con lo que necesita delante
    ; -------------------------------------------------------------------------
    función en_plan(nombre: puntero a byte): nat32
        variable i: nat32
        para i desde 1 hasta plan_n hacer
            si iguales(plan_nombre[i - 1], nombre) entonces devolver i - 1 fin
        fin
        devolver NINGUNO
    fin

    función planea(nombre: puntero a byte, op: nat32, versión: puntero a byte, nivel: nat32): bool
        variable i, c, largo: nat32
        variable v: arreglo [16] de byte
        variable r: arreglo [RUTA] de byte
        variable cab: puntero a byte
        variable d: arreglo [4] de nat32
        si nivel > 16 entonces devolver mal("demasiadas dependencias, una detrás de otra (¿en círculo?)") fin
        d[0] := pt(nombre)
        d[1] := pt(texto_op(op))
        d[2] := pt(versión)
        i := en_plan(nombre)
        si i <> NINGUNO entonces
            si cumple(plan_versión[i], op, versión) entonces devolver cierto fin
            d[3] := pt(plan_versión[i])
            imprimir("paquetes: hace falta %s%s%s, y lo que se va a instalar es la %s\n", dirección(d[0]))
            devolver falso
        fin
        si versión_instalada(nombre, v) y cumple(v, op, versión) entonces devolver cierto fin
        si iguales(nombre, "nucleo") entonces
            d[3] := pt(versión_núcleo)
            imprimir("paquetes: hace falta el núcleo%s%s (el que está en marcha es el %s):\n", dirección(d[1]))
            escribir("  actualice antes el paquete «base» y vuelva a arrancar el equipo.\n")
            devolver falso
        fin
        si no carga_catálogo() entonces
            imprimir("paquetes: hace falta %s%s%s y no hay un catálogo donde buscarlo\n", dirección(d[0]))
            devolver falso
        fin
        c := mejor_del_catálogo(nombre, op, versión)
        si c = NINGUNO entonces
            imprimir("paquetes: hace falta %s%s%s y no está en el catálogo\n", dirección(d[0]))
            devolver falso
        fin
        si no cabe_bajada(c) entonces devolver falso fin       ; (RÁPIDO)
        si se_cancela() o no trae(cat_archivo[c], r) entonces devolver falso fin
        cab := lee_cabecera(r, largo)
        si cab = nulo entonces
            imprimir1("paquetes: %s no es un paquete\n", pt(r))
            devolver falso
        fin
        devolver añade(r, cab, largo, c, nivel)
    fin

    ; mete en el plan el paquete de esa cabecera (y, antes, lo que necesite)
    función añade(r: puntero a byte, cab: puntero a byte, largo: nat32, c: nat32, nivel: nat32): bool
        variable i, k, op: nat32
        variable lista: arreglo [256] de byte
        variable n: arreglo [12] de byte
        variable v: arreglo [16] de byte
        si no valida(cab, r) entonces devolver falso fin
        si plan_n >= MAX_PAQ entonces devolver mal("demasiados paquetes de una vez") fin
        i := plan_n
        plan_n := plan_n + 1
        copiar_hasta(plan_ruta[i], r, RUTA)
        plan_cab[i] := cab
        plan_largo[i] := largo
        plan_cat[i] := c
        campo(cab, "nombre", plan_nombre[i], 12)
        campo(cab, "version", plan_versión[i], 16)
        si c <> NINGUNO entonces
            si no iguales(plan_nombre[i], cat_nombre[c]) o compara(plan_versión[i], cat_versión[c]) <> 0 entonces
                imprimir1("paquetes: %s no es lo que dice el catálogo (otro nombre u otra versión)\n", pt(r))
                devolver falso
            fin
        fin
        campo(cab, "necesita", lista, 256)
        k := 0
        mientras requisito(lista, k, n, op, v) hacer
            si no iguales(n, plan_nombre[i]) entonces
                si no planea(n, op, v, nivel + 1) entonces devolver falso fin
            fin
            k := k + 1
        fin
        orden[orden_n] := i
        orden_n := orden_n + 1
        devolver cierto
    fin

    ; ¿choca algo del plan con lo instalado, o con otra cosa del plan? ¿pisa
    ; un archivo de otro paquete?
    función comprueba_plan(): bool
        variable i, j, k, op, a, b, nn, nv, w: nat32
        variable lista: arreglo [256] de byte
        variable n: arreglo [12] de byte
        variable v: arreglo [16] de byte
        variable vi: arreglo [16] de byte
        variable d: arreglo [4] de nat32
        para i desde 1 hasta plan_n hacer
            ; con lo que choca él
            campo(plan_cab[i - 1], "choca", lista, 256)
            k := 0
            mientras requisito(lista, k, n, op, v) hacer
                w := en_plan(n)
                d[0] := pt(plan_nombre[i - 1])
                d[1] := pt(n)
                d[2] := pt(n)
                si w <> NINGUNO y w <> i - 1 entonces
                    si cumple(plan_versión[w], op, v) entonces
                        imprimir("paquetes: %s no puede estar con %s, y se iban a instalar los dos\n", dirección(d[0]))
                        devolver falso
                    fin
                sino si w = NINGUNO y versión_instalada(n, vi) entonces
                    si cumple(vi, op, v) entonces
                        imprimir("paquetes: %s no puede estar con %s, que está instalado: quítelo antes (PAQUETES QUITA %s)\n", dirección(d[0]))
                        devolver falso
                    fin
                fin
                k := k + 1
            fin
            ; los instalados que chocan con él
            para j desde 1 hasta ins_n hacer
                si en_plan(ins_nombre[j - 1]) = NINGUNO entonces
                    campo(ins_cab[j - 1], "choca", lista, 256)
                    k := 0
                    mientras requisito(lista, k, n, op, v) hacer
                        si iguales(n, plan_nombre[i - 1]) y cumple(plan_versión[i - 1], op, v) entonces
                            d[0] := pt(ins_nombre[j - 1])
                            d[1] := pt(plan_nombre[i - 1])
                            d[2] := pt(ins_nombre[j - 1])
                            imprimir("paquetes: %s (instalado) no puede estar con %s: quite antes %s\n", dirección(d[0]))
                            devolver falso
                        fin
                        k := k + 1
                    fin
                fin
            fin
            ; que no pise los archivos de otro
            nn := lee_archivos(plan_cab[i - 1], nuevos)
            para j desde 1 hasta ins_n + plan_n hacer
                nv := 0
                si j <= ins_n entonces
                    si en_plan(ins_nombre[j - 1]) = NINGUNO entonces
                        nv := lee_archivos(ins_cab[j - 1], viejos)
                        d[2] := pt(ins_nombre[j - 1])
                    fin
                sino si j - ins_n <> i entonces
                    nv := lee_archivos(plan_cab[j - ins_n - 1], viejos)
                    d[2] := pt(plan_nombre[j - ins_n - 1])
                fin
                para a desde 1 hasta nn hacer
                    para b desde 1 hasta nv hacer
                        si iguales_sin_caja(nuevos[a - 1].destino, viejos[b - 1].destino) entonces
                            d[0] := pt(plan_nombre[i - 1])
                            d[1] := pt(nuevos[a - 1].destino)
                            imprimir("paquetes: %s trae %s, que es del paquete %s\n", dirección(d[0]))
                            devolver falso
                        fin
                    fin
                fin
            fin
        fin
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  Las sumas
    ; -------------------------------------------------------------------------
    ; el SHA-256 de los n octetos siguientes del archivo m, a «salida»
    función resume(m: nat32, n: nat32, salida: puntero a byte): bool
        variable k: nat32
        Sha256.empezar()
        mientras n > 0 hacer
            k := n
            si k > TROZO entonces k := TROZO fin
            si no lee_todo(m, buf, k) entonces devolver falso fin
            Sha256.añadir(buf, k)
            n := n - k
            si no av_lleva(k) entonces devolver falso fin
        fin
        Sha256.acabar(salida)
        devolver cierto
    fin

    ; comprueba un paquete del plan: lo que mide, su suma (la del catálogo) y
    ; la de cada uno de sus archivos
    función verifica(i: nat32): bool
        variable m, total, n, a, c: nat32
        variable s: arreglo [68] de byte
        variable bien: bool
        m := abrir(plan_ruta[i])
        si es_error(m) entonces
            imprimir1("paquetes: no se puede leer %s\n", pt(plan_ruta[i]))
            devolver falso
        fin
        total := largo_de(m)
        c := plan_cat[i]
        bien := cierto
        av_empieza(total, "Comprobando", plan_nombre[i])
        av_instalando := falso
        si c <> NINGUNO entonces
            bien := total = cat_tamaño[c] y resume(m, total, s) y iguales(s, cat_sha[c])
            si no bien y no cancelado entonces
                imprimir1("paquetes: %s no es el del catálogo (no mide lo mismo o su suma no es la suya)\n", pt(plan_ruta[i]))
            fin
            mover(m, 0, DESDE_INICIO)
        fin
        n := lee_archivos(plan_cab[i], nuevos)
        a := plan_largo[i]
        para c desde 1 hasta n hacer a := a + nuevos[c - 1].tamaño fin
        si bien y a <> total entonces
            imprimir3("paquetes: %s está cortado o le sobra algo (mide %u y tenía que medir %u)\n", pt(plan_ruta[i]), total, a)
            bien := falso
        fin
        si bien entonces mover(m, plan_largo[i], DESDE_INICIO) fin
        ; (RÁPIDO) con la suma del catálogo buena, el paquete entero es el
        ; firmado: la de cada archivo se mira al copiarlo (escribe_temporal);
        ; aquí sería leerlo otra vez entero (21 MB la base de Escudo)
        si plan_cat[i] <> NINGUNO entonces n := 0 fin
        para c desde 1 hasta n hacer
            si bien entonces
                si no resume(m, nuevos[c - 1].tamaño, s) o no iguales(s, nuevos[c - 1].sha) entonces
                    si cancelado entonces romper fin
                    imprimir2("paquetes: %s: la suma de %s no es la suya: el paquete está estropeado\n", pt(plan_ruta[i]), pt(dirección(nuevos[c - 1].destino[2])))
                    bien := falso
                fin
            fin
        fin
        cerrar(m)
        devolver bien
    fin

    ; -------------------------------------------------------------------------
    ;  Una instalación: los pasos, el diario, cambiar y deshacer
    ; -------------------------------------------------------------------------
    función pon_paso(clase: nat32, destino: puntero a byte): nat32
        variable i: nat32
        si n_pasos >= MAX_PASOS entonces devolver NINGUNO fin
        i := n_pasos
        n_pasos := n_pasos + 1
        pasos[i].clase := clase
        pasos[i].existía := 0
        si existe(destino) entonces pasos[i].existía := 1 fin
        pasos[i].origen_ := NINGUNO
        pasos[i].tamaño := 0
        pasos[i].sha[0] := 0
        copiar_hasta(pasos[i].destino, destino, 84)
        devolver i
    fin

    ; las carpetas que faltan para ese archivo (de fuera adentro)
    función pon_carpetas(destino: puntero a byte)
        variable i, j: nat32
        variable c: arreglo [84] de byte
        variable ya: bool
        i := 3
        mientras destino[i] <> 0 hacer
            si destino[i] = '\\' entonces
                copiar_hasta(c, destino, i + 1)
                si no existe(c) entonces
                    ya := falso
                    para j desde 1 hasta n_pasos hacer
                        si pasos[j - 1].clase = P_CARPETA y iguales_sin_caja(pasos[j - 1].destino, c) entonces ya := cierto fin
                    fin
                    si no ya entonces pon_paso(P_CARPETA, c) fin
                fin
            fin
            i := i + 1
        fin
    fin

    ; lo que hay que hacer para instalar el paquete número i del plan
    función pasos_de_instalar(i: nat32): bool
        variable n, a, b, off, j, nv, k: nat32
        variable r: arreglo [RUTA] de byte
        variable x: arreglo [16] de byte
        variable está: bool
        n_pasos := 0
        n := lee_archivos(plan_cab[i], nuevos)
        para a desde 1 hasta n hacer pon_carpetas(nuevos[a - 1].destino) fin
        off := plan_largo[i]
        para a desde 1 hasta n hacer
            k := pon_paso(P_NUEVO, nuevos[a - 1].destino)
            si k = NINGUNO entonces devolver mal("el paquete tiene demasiados archivos") fin
            pasos[k].origen_ := off
            pasos[k].tamaño := nuevos[a - 1].tamaño
            Textos32.copiar(pasos[k].sha, nuevos[a - 1].sha)
            off := off + nuevos[a - 1].tamaño
        fin
        ; el registro, el último de lo nuevo
        Textos32.copiar(x, plan_nombre[i])
        a_mayúsculas(x)
        concatenar(x, ".PQI")
        en_base(x, r)
        k := pon_paso(P_NUEVO, r)
        si k = NINGUNO entonces devolver mal("el paquete tiene demasiados archivos") fin
        pasos[k].tamaño := plan_largo[i]
        ; lo de la versión de antes que la nueva ya no lleva
        j := instalado(plan_nombre[i])
        si j <> NINGUNO entonces
            nv := lee_archivos(ins_cab[j], viejos)
            para b desde 1 hasta nv hacer
                está := falso
                para a desde 1 hasta n hacer
                    si iguales_sin_caja(nuevos[a - 1].destino, viejos[b - 1].destino) entonces está := cierto fin
                fin
                si no está y existe(viejos[b - 1].destino) entonces
                    si pon_paso(P_BORRA, viejos[b - 1].destino) = NINGUNO entonces devolver mal("el paquete tiene demasiados archivos") fin
                fin
            fin
        fin
        txn_cab := plan_cab[i]
        txn_largo := plan_largo[i]
        con_tipo(i)
        pasos[k].tamaño := txn_largo
        copiar_hasta(txn_paquete, plan_ruta[i], RUTA)
        une(txn_nombre, plan_nombre[i], " ")
        concatenar(txn_nombre, plan_versión[i])
        devolver cierto
    fin

    ; (PROGRAMAS) si la cabecera no dice su tipo y el catálogo sí, el registro
    ; lo lleva: la cabecera, con «tipo=...» antes de su «fin» (txn_cab)
    función con_tipo(i: nat32)
        variable x: arreglo [32] de byte
        variable t: arreglo [48] de byte
        variable p: puntero a byte
        variable k, f: nat32
        si campo(plan_cab[i], "tipo", x, 32) y x[0] <> 0 entonces devolver fin
        si no tipo_del_catálogo(plan_nombre[i], x) entonces devolver fin
        código_tipo(número_tipo(x), x)
        une(t, "tipo=", x)
        concatenar(t, "\r\n")
        k := plan_largo[i]
        ; dónde empieza su «fin»
        f := k - 4
        si k >= 5 y plan_cab[i][k - 2] = '\r' entonces f := k - 5 fin
        p := más_memoria(k + longitud(t) + 1)
        si p = nulo entonces devolver fin
        copiar_memoria(p, plan_cab[i], f)
        copiar_memoria(p + f, t, longitud(t))
        copiar_memoria(p + f + longitud(t), plan_cab[i] + f, k - f)
        txn_largo := k + longitud(t)
        p[txn_largo] := 0
        txn_cab := p
    fin

    ; (PROGRAMAS) al reparar, lo que ya está bien no se toca: fuera de los
    ; pasos los archivos que están como dice su cabecera (el registro sí se
    ; vuelve a escribir: así lleva su tipo)
    función quita_los_sanos()
        variable i, j: nat32
        j := 0
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_NUEVO y pasos[i - 1].origen_ <> NINGUNO y pasos[i - 1].existía = 1 y estado_archivo(pasos[i - 1].destino, pasos[i - 1].tamaño, pasos[i - 1].sha) = 0 entonces
                ; (bien: no se pone otra vez)
            sino
                si j <> i - 1 entonces
                    pasos[j].clase := pasos[i - 1].clase
                    pasos[j].existía := pasos[i - 1].existía
                    pasos[j].origen_ := pasos[i - 1].origen_
                    pasos[j].tamaño := pasos[i - 1].tamaño
                    Textos32.copiar(pasos[j].sha, pasos[i - 1].sha)
                    Textos32.copiar(pasos[j].destino, pasos[i - 1].destino)
                fin
                j := j + 1
            fin
        fin
        n_pasos := j
    fin

    ; lo que hay que hacer para quitar el paquete instalado número j
    función pasos_de_quitar(j: nat32): bool
        variable nv, b: nat32
        variable r: arreglo [RUTA] de byte
        variable x: arreglo [16] de byte
        n_pasos := 0
        nv := lee_archivos(ins_cab[j], viejos)
        para b desde 1 hasta nv hacer
            si existe(viejos[b - 1].destino) entonces pon_paso(P_BORRA, viejos[b - 1].destino) fin
        fin
        Textos32.copiar(x, ins_nombre[j])
        a_mayúsculas(x)
        concatenar(x, ".PQI")
        en_base(x, r)
        pon_paso(P_BORRA, r)
        txn_cab := nulo
        txn_largo := 0
        txn_paquete[0] := 0
        une(txn_nombre, ins_nombre[j], " ")
        concatenar(txn_nombre, ins_versión[j])
        devolver cierto
    fin

    ; ¿cabe? (lo nuevo entero: lo de antes no se suelta hasta el final)
    función hay_sitio(): bool
        variable i, k: nat32
        variable u: Info_unidad
        k := 64
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_NUEVO entonces k := k + pasos[i - 1].tamaño div 1024 + 4 fin
        fin
        i := 0
        mientras info_unidad(i, u) hacer
            si u.letra = sis entonces
                si u.libre_k <> 0xFFFFFFFF y u.libre_k < k entonces
                    imprimir2("paquetes: no cabe en el disco: hacen falta %u K y quedan %u K\n", k, u.libre_k)
                    devolver falso
                fin
                devolver cierto
            fin
            i := i + 1
        fin
        devolver cierto
    fin

    ; el diario: «HPQ-DIARIO 1», el paquete y un paso por línea, en orden
    ; (c=carpeta; n=existía destino; b=destino)
    variable diario_denegado: bool              ; (PROTEGE) el núcleo no deja escribir en C:\HISPA\PAQUETES

    función escribe_diario(): bool
        variable m, i: nat32
        variable bien: bool
        variable x: arreglo [8] de byte
        m := crear(diario)
        si es_error(m) entonces
            diario_denegado := m = DENEGADO       ; (PROTEGE)
            devolver falso
        fin
        bien := escribe_todo(m, "HPQ-DIARIO 1\r\npaquete=", longitud("HPQ-DIARIO 1\r\npaquete=")) y escribe_todo(m, txn_nombre, longitud(txn_nombre)) y escribe_todo(m, "\r\n", 2)
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_CARPETA entonces
                bien := bien y escribe_todo(m, "c=", 2)
            sino si pasos[i - 1].clase = P_NUEVO entonces
                x[0] := 'n'
                x[1] := '='
                x[2] := '0' + pasos[i - 1].existía
                x[3] := ' '
                bien := bien y escribe_todo(m, x, 4)
            sino
                bien := bien y escribe_todo(m, "b=", 2)
            fin
            bien := bien y escribe_todo(m, pasos[i - 1].destino, longitud(pasos[i - 1].destino)) y escribe_todo(m, "\r\n", 2)
        fin
        cerrar(m)
        devolver bien
    fin

    ; lee un diario (DIARIO.TXT o HECHO.TXT) a la lista de pasos
    función lee_diario(ruta: puntero a byte): bool
        variable m, n, k, i: nat32
        variable p: puntero a byte
        variable x: arreglo [128] de byte
        m := abrir(ruta)
        si es_error(m) entonces devolver falso fin
        n := 0
        mientras n < TROZO - 1 hacer
            k := leer(m, buf + n, TROZO - 1 - n)
            si es_error(k) o k = 0 entonces romper fin
            n := n + k
        fin
        cerrar(m)
        buf[n] := 0
        n_pasos := 0
        txn_nombre[0] := 0
        p := buf
        mientras valor(p) <> 0 y n_pasos < MAX_PASOS hacer
            p := línea(p, x, 128)
            si empieza_por(x, "paquete=") entonces
                copiar_hasta(txn_nombre, dirección(x[8]), 40)
            sino si x[1] = '=' y (x[0] = 'c' o x[0] = 'b' o (x[0] = 'n' y x[3] = ' ')) entonces
                i := n_pasos
                n_pasos := n_pasos + 1
                pasos[i].existía := 0
                si x[0] = 'c' entonces
                    pasos[i].clase := P_CARPETA
                    copiar_hasta(pasos[i].destino, dirección(x[2]), 84)
                sino si x[0] = 'b' entonces
                    pasos[i].clase := P_BORRA
                    copiar_hasta(pasos[i].destino, dirección(x[2]), 84)
                sino
                    pasos[i].clase := P_NUEVO
                    si x[2] = '1' entonces pasos[i].existía := 1 fin
                    copiar_hasta(pasos[i].destino, dirección(x[4]), 84)
                fin
            fin
        fin
        devolver cierto
    fin

    ; (las pruebas) «/CORTE=n»: tras el cambio número n, quieto, como si se fuera la luz
    función un_cambio()
        cambios := cambios + 1
        si corte <> 0 y cambios = corte entonces
            escribir("paquetes: corte de prueba (como si se fuera la luz a mitad)\n")
            mientras cierto hacer dormir(100) fin
        fin
    fin

    ; escribe lo nuevo del paso i en su archivo temporal (HPQnnnnn.NUE),
    ; comprobando otra vez su suma
    función escribe_temporal(i: nat32, mp: nat32): bool
        variable s, queda, k: nat32
        variable t: arreglo [RUTA] de byte
        variable h: arreglo [68] de byte
        variable bien: bool
        temporal(i, "NUE", t)
        s := crear(t)
        si es_error(s) entonces devolver falso fin
        si pasos[i].origen_ = NINGUNO entonces
            bien := escribe_todo(s, txn_cab, txn_largo)
        sino
            bien := not_error(mover(mp, ent32(pasos[i].origen_), DESDE_INICIO))
            Sha256.empezar()
            queda := pasos[i].tamaño
            mientras bien y queda > 0 hacer
                k := queda
                si k > TROZO entonces k := TROZO fin
                bien := lee_todo(mp, buf, k)
                si bien entonces
                    Sha256.añadir(buf, k)
                    bien := escribe_todo(s, buf, k) y av_lleva(k)
                fin
                queda := queda - k
            fin
            Sha256.acabar(h)
            bien := bien y iguales(h, pasos[i].sha)
        fin
        cerrar(s)
        devolver bien
    fin

    función not_error(r: nat32): bool
        devolver no es_error(r)
    fin

    ; hace las carpetas, escribe lo nuevo aparte y lo cambia por lo de antes
    función cambia(): bool
        variable i, mp, r: nat32
        variable t: arreglo [RUTA] de byte
        variable v: arreglo [RUTA] de byte
        variable bien: bool
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_CARPETA entonces
                r := crear_carpeta(pasos[i - 1].destino)
                si es_error(r) entonces
                    imprimir2("paquetes: no se puede hacer la carpeta %s (%s)\n", pt(pasos[i - 1].destino), pt(texto_error(r)))
                    devolver falso
                fin
            fin
        fin
        ; (RÁPIDO) el avance: lo que se va a escribir
        r := 0
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_NUEVO entonces r := r + pasos[i - 1].tamaño fin
        fin
        av_empieza(r, "Instalando", txn_nombre)
        av_instalando := cierto
        mp := NINGUNO
        si txn_paquete[0] <> 0 entonces
            mp := abrir(txn_paquete)
            si es_error(mp) entonces
                imprimir1("paquetes: no se puede leer %s\n", pt(txn_paquete))
                devolver falso
            fin
        fin
        bien := cierto
        para i desde 1 hasta n_pasos hacer
            si bien y pasos[i - 1].clase = P_NUEVO entonces
                si no escribe_temporal(i - 1, mp) entonces
                    si no cancelado entonces imprimir1("paquetes: no se puede escribir %s (¿está lleno el disco?)\n", pt(pasos[i - 1].destino)) fin
                    bien := falso
                fin
            fin
        fin
        si mp <> NINGUNO entonces cerrar(mp) fin
        si no bien entonces devolver falso fin
        ; cambiar: lo de antes, a su HPQnnnnn.VIE; lo nuevo, a su sitio
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_NUEVO entonces
                temporal(i - 1, "NUE", t)
                si pasos[i - 1].existía = 1 entonces
                    temporal(i - 1, "VIE", v)
                    borrar(v)
                    r := renombrar(pasos[i - 1].destino, v)
                    si es_error(r) entonces
                        imprimir2("paquetes: no se puede apartar %s (%s)\n", pt(pasos[i - 1].destino), pt(texto_error(r)))
                        devolver falso
                    fin
                    un_cambio()
                fin
                r := renombrar(t, pasos[i - 1].destino)
                si es_error(r) entonces
                    imprimir2("paquetes: no se puede poner %s (%s)\n", pt(pasos[i - 1].destino), pt(texto_error(r)))
                    devolver falso
                fin
                un_cambio()
            fin
        fin
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_BORRA entonces
                ; (PROGRAMAS) el avance, archivo a archivo, al quitar
                si quitando entonces
                    av_h := av_h + 1
                    di_avance(av_h, av_t, "Quitando", txn_nombre)
                    si lento entonces dormir(60) fin
                fin
                temporal(i - 1, "VIE", v)
                borrar(v)
                r := renombrar(pasos[i - 1].destino, v)
                si es_error(r) entonces
                    imprimir2("paquetes: no se puede quitar %s (%s)\n", pt(pasos[i - 1].destino), pt(texto_error(r)))
                    devolver falso
                fin
                un_cambio()
            fin
        fin
        devolver cierto
    fin

    ; deja todo como estaba antes de la instalación (de atrás adelante)
    función deshaz()
        variable i: nat32
        variable t: arreglo [RUTA] de byte
        variable v: arreglo [RUTA] de byte
        para i desde n_pasos hasta 1 paso -1 hacer
            si pasos[i - 1].clase = P_CARPETA entonces
                borrar_carpeta(pasos[i - 1].destino)
            sino
                temporal(i - 1, "NUE", t)
                temporal(i - 1, "VIE", v)
                si existe(v) entonces
                    ; lo de antes estaba apartado: vuelve a su sitio
                    si existe(pasos[i - 1].destino) entonces borrar(pasos[i - 1].destino) fin
                    renombrar(v, pasos[i - 1].destino)
                sino si pasos[i - 1].clase = P_NUEVO y pasos[i - 1].existía = 0 y no existe(t) entonces
                    ; uno nuevo que ya estaba puesto: fuera
                    borrar(pasos[i - 1].destino)
                fin
                si existe(t) entonces borrar(t) fin
            fin
        fin
    fin

    ; quita las carpetas que se hayan quedado vacías al quitar ese archivo
    ; (menos la raíz, \HISPA y la base)
    función quita_carpetas(ruta: puntero a byte)
        variable c: arreglo [RUTA] de byte
        variable r: nat32
        carpeta_de(ruta, c)
        mientras longitud(c) > 2 hacer
            si iguales_sin_caja(dirección(c[2]), "\\HISPA") o iguales_sin_caja(c, base) entonces devolver fin
            r := borrar_carpeta(c)
            si es_error(r) entonces devolver fin
            carpeta_de(c, c)
        fin
    fin

    ; ¿es C:\HISPA\NUCLEO.BIN?
    función es_el_núcleo(ruta: puntero a byte): bool
        devolver iguales_sin_caja(dirección(ruta[2]), "\\HISPA\\NUCLEO.BIN")
    fin

    ; el arranque, tras cambiar el núcleo: GRUBENV con «nuevo=1» y, en
    ; GRUB.CFG, la entrada del de antes y lo que hace que GRUB vuelva solo a
    ; él si el nuevo no llega a arrancar bien (si no la tiene ya)
    función prepara_arranque()
        variable m, n, i: nat32
        variable r: arreglo [RUTA] de byte
        variable e: puntero a byte
        e := buf
        llenar(e, 1024, '#')
        Textos32.copiar(e, "# GRUB Environment Block\nnuevo=1\n")
        e[longitud(e)] := '#'
        une(r, base, "\\..\\GRUBENV")
        m := crear(r)
        si es_error(m) o no escribe_todo(m, e, 1024) entonces
            si no es_error(m) entonces cerrar(m) fin
            escribir("paquetes: no se puede escribir C:\\HISPA\\GRUBENV (el arranque no sabrá volver solo al núcleo de antes)\n")
        sino
            cerrar(m)
        fin
        une(r, base, "\\..\\GRUB.CFG")
        m := abrir(r)
        n := 0
        si no es_error(m) entonces
            n := leer(m, buf, TROZO - 1)
            cerrar(m)
            si es_error(n) entonces n := 0 fin
        fin
        buf[n] := 0
        si n > 0 y buscar(buf, "NUCLEO.ANT") = nulo entonces
            m := abrir_para(r, 3)
            si no es_error(m) entonces
                e := "\n# (lo pone PAQUETES al cambiar el nucleo) el de antes, por si el nuevo no arranca;\n# GRUBENV: nuevo=1, el nuevo no ha arrancado aun; 2, ha empezado a arrancar;\n# 3, no llego a arrancar bien (si arranca, ACTUALIZ lo pone a 0): se vuelve al de antes (4: ya se ha dicho)\nmenuentry \"Hispa-Pentium con el nucleo de antes (si el nuevo no arranca)\" --id anterior {\n  multiboot /HISPA/NUCLEO.ANT escritorio escritura\n  set gfxpayload=$modo\n  boot\n}\nif [ -f /HISPA/GRUBENV ]; then\n  load_env -f /HISPA/GRUBENV nuevo\n  if [ \"$nuevo\" = 1 ]; then\n    set nuevo=2\n    save_env -f /HISPA/GRUBENV nuevo\n  elif [ \"$nuevo\" = 2 ]; then\n    set nuevo=3\n    save_env -f /HISPA/GRUBENV nuevo\n    set default=anterior\n    set timeout=10\n  elif [ \"$nuevo\" = 3 -o \"$nuevo\" = 4 ]; then\n    set default=anterior\n  fi\nfi\n"
                escribe_todo(m, e, longitud(e))
                cerrar(m)
            fin
        fin
        escribir("reiniciar|Reinicie para usar el núcleo nuevo; si no arranca, vuelve el de antes.\n")
    fin

    ; ya está todo cambiado: fuera lo de antes y el diario
    función limpia()
        variable i: nat32
        variable v: arreglo [RUTA] de byte
        variable a: arreglo [RUTA] de byte
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_BORRA o (pasos[i - 1].clase = P_NUEVO y pasos[i - 1].existía = 1) entonces
                temporal(i - 1, "VIE", v)
                si pasos[i - 1].clase = P_NUEVO y es_el_núcleo(pasos[i - 1].destino) y existe(v) entonces
                    ; el núcleo de antes no se borra: queda como NUCLEO.ANT, para volver a él
                    une(a, base, "\\..\\NUCLEO.ANT")
                    borrar(a)
                    renombrar(v, a)
                    núcleo_nuevo := cierto
                sino
                    borrar(v)
                fin
            fin
        fin
        para i desde 1 hasta n_pasos hacer
            si pasos[i - 1].clase = P_BORRA entonces quita_carpetas(pasos[i - 1].destino) fin
        fin
        borrar(hecho)
    fin

    ; hace los pasos, de modo que o se hace todo o no se hace nada
    función ejecuta(): bool
        si no hay_sitio() entonces devolver falso fin
        borrar(hecho)
        si no escribe_diario() entonces
            borrar(diario)
            ; (PROTEGE) solo escribe en el sistema el PAQUETES.BIN del sistema
            si diario_denegado entonces devolver mal("acceso denegado a C:\\HISPA\\PAQUETES: solo instala el PAQUETES del sistema (el de C:\\HISPA), no una copia de otra carpeta") fin
            devolver mal("no se puede escribir en C:\\HISPA\\PAQUETES (¿se ha arrancado con «escritura»?)")
        fin
        si no cambia() entonces
            deshaz()
            borrar(diario)
            imprimir1("paquetes: %s no se ha podido poner: todo queda como estaba\n", pt(txn_nombre))
            devolver falso
        fin
        si es_error(renombrar(diario, hecho)) entonces
            deshaz()
            borrar(diario)
            devolver mal("no se puede acabar (el diario): todo queda como estaba")
        fin
        limpia()
        devolver cierto
    fin

    ; si la última vez se quedó algo a medias (se fue la luz), se deshace (o,
    ; si ya estaba todo cambiado, se acaba de limpiar)
    función recupera()
        si existe(hecho) y lee_diario(hecho) entonces
            limpia()
            imprimir1("paquetes: se ha acabado de limpiar lo de %s, que estaba puesto\n", pt(txn_nombre))
        fin
        si existe(diario) y lee_diario(diario) entonces
            deshaz()
            borrar(diario)
            imprimir1("paquetes: %s se quedó a medias (¿se fue la luz?): se ha deshecho y todo está como antes\n", pt(txn_nombre))
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Las órdenes
    ; -------------------------------------------------------------------------
    función ayuda()
        escribir("PAQUETES ", VERSIÓN_PAQUETES, ": instalar, actualizar, reparar y quitar programas en Hispa-Pentium.\n")
        escribir("  PAQUETES LISTA [/TIPO]        lo que está instalado (/TIPO: por tipos, y lo suelto)\n")
        escribir("  PAQUETES CATALOGO             lo que se puede instalar\n")
        escribir("  PAQUETES INSTALA nombre       instala un paquete (y lo que necesite)\n")
        escribir("  PAQUETES INSTALA X.HPQ        instala ese archivo de paquete\n")
        escribir("  PAQUETES ACTUALIZA [nombre]   pone al día lo instalado\n")
        escribir("  PAQUETES QUITA nombre         lo quita (/DEPENDIENTES: y lo que lo necesite)\n")
        escribir("  PAQUETES REPARA [nombre]      comprueba sus archivos y vuelve a poner lo dañado\n")
        escribir("  PAQUETES ARCHIVOS nombre      sus archivos, y si están como se instalaron\n")
        escribir("  PAQUETES SUELTOS              los programas que no son de ningún paquete\n")
        escribir("  PAQUETES MIRA X.HPQ           lo que lleva un paquete, y si está sano\n")
        escribir("  PAQUETES COMPRUEBA            si lo instalado sigue igual\n")
        escribir("  PAQUETES FIRMA ARCHIVO        si ARCHIVO.FIR es su firma buena (la de Hispa-Pentium)\n")
        escribir("  /DESDE=X:\\PAQUETES            de dónde se traen (también una dirección http://)\n")
        escribir("  /FORZAR                       quitar aunque otro lo necesite; poner una versión igual o más vieja\n")
    fin

    función di_lista()
        variable i, k, h: nat32
        variable d: arreglo [200] de byte
        variable x: arreglo [32] de byte
        si ins_n = 0 entonces
            imprimir1("No hay ningún paquete apuntado en %s.\n", pt(base))
            si no por_tipo entonces devolver fin
        fin
        si no por_tipo entonces
            imprimir1("Paquetes instalados (%s):\n", pt(base))
            para i desde 1 hasta ins_n hacer
                escribir("  ")
                columna(ins_nombre[i - 1], 10)
                columna(ins_versión[i - 1], 8)
                campo(ins_cab[i - 1], "descripcion", d, 200)
                escribir(d, "\n")
            fin
            imprimir1("%u paquetes.\n", ins_n)
            devolver
        fin
        ; (PROGRAMAS) /TIPO: por tipos, en su orden, y al final lo suelto
        si ins_n > 0 entonces imprimir1("Paquetes instalados, por tipos (%s):\n", pt(base)) fin
        para k desde 0 hasta N_TIPOS - 1 hacer
            h := 0
            para i desde 1 hasta ins_n hacer
                si tipo_de(ins_cab[i - 1], ins_nombre[i - 1]) = k entonces
                    si h = 0 entonces
                        nombre_tipo(k, x)
                        escribir(x, ":\n")
                    fin
                    h := h + 1
                    escribir("  ")
                    columna(ins_nombre[i - 1], 10)
                    columna(ins_versión[i - 1], 8)
                    campo(ins_cab[i - 1], "descripcion", d, 200)
                    escribir(d, "\n")
                fin
            fin
        fin
        si ins_n > 0 entonces imprimir1("%u paquetes.\n", ins_n) fin
        busca_sueltos()
        si sueltos_n > 0 entonces
            escribir("Programas de terceros (sin paquete):\n")
            di_sueltos()
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  (PROGRAMAS) Los programas sueltos: los .EXE, .BIN y .HVP que no son de
    ;  ningún paquete, en la raíz, \HISPA, \HISPA32 y \PROGRAMS (y en las
    ;  subcarpetas de estos dos)
    ; -------------------------------------------------------------------------
    ; ¿es de algún paquete instalado?
    función de_paquete(ruta: puntero a byte): bool
        variable i, n, a: nat32
        para i desde 1 hasta ins_n hacer
            n := lee_archivos(ins_cab[i - 1], viejos)
            para a desde 1 hasta n hacer
                si iguales_sin_caja(viejos[a - 1].destino, ruta) entonces devolver cierto fin
            fin
        fin
        devolver falso
    fin

    función es_programa(n: puntero a byte): bool
        devolver acaba_en(n, ".EXE") o acaba_en(n, ".BIN") o acaba_en(n, ".HVP")
    fin

    ; los de una carpeta («C:\HISPA32»; «C:» es la raíz); con «hondo», también los de sus subcarpetas
    función sueltos_de(carpeta: puntero a byte, hondo: bool)
        variable m: nat32
        variable e: Entrada
        variable r: arreglo [RUTA] de byte
        variable c: arreglo [RUTA] de byte
        une(c, carpeta, "\\")
        si longitud(carpeta) > 2 entonces m := abrir(carpeta) sino m := abrir(c) fin
        si es_error(m) entonces devolver fin
        mientras sueltos_n < MAX_SUELTOS y entrada(m, e) hacer
            si e.nombre[0] <> '.' y longitud(carpeta) + longitud(e.nombre) + 2 < RUTA entonces
                une(r, c, e.nombre)
                si e.atributos yb CARPETA <> 0 entonces
                    si hondo entonces sueltos_de(r, falso) fin
                sino si es_programa(e.nombre) y no empieza_por(e.nombre, "HPQ") y no de_paquete(r) entonces
                    Textos32.copiar(suelto_ruta[sueltos_n], r)
                    suelto_tamaño[sueltos_n] := e.tamaño
                    suelto_fecha[sueltos_n] := nat32(e.fecha)
                    sueltos_n := sueltos_n + 1
                fin
            fin
        fin
        cerrar(m)
    fin

    función busca_sueltos()
        variable k, n: nat32
        variable x: arreglo [24] de byte
        variable c: arreglo [40] de byte
        sueltos_n := 0
        para k desde 0 hasta 3 hacer
            trozo_de(CARPETAS_SUELTOS, k, x, 24)
            n := longitud(x)
            c[0] := sis
            c[1] := ':'
            c[2] := 0
            si n > 0 y x[n - 1] = '*' entonces
                x[n - 1] := 0
                concatenar(c, x)
                sueltos_de(c, cierto)
            sino
                concatenar(c, x)
                sueltos_de(c, falso)
            fin
        fin
    fin

    función di_sueltos()
        variable i: nat32
        variable f: arreglo [12] de byte
        para i desde 1 hasta sueltos_n hacer
            escribir("  ")
            columna(suelto_ruta[i - 1], 30)
            escribir(suelto_tamaño[i - 1], " octetos  ")
            fecha_texto(suelto_fecha[i - 1], f)
            escribir(f, "\n")
        fin
    fin

    función sueltos(): bool
        busca_sueltos()
        si sueltos_n = 0 entonces
            escribir("No hay programas sueltos (sin paquete) en \\HISPA, \\HISPA32 ni \\PROGRAMS.\n")
            devolver cierto
        fin
        escribir("Programas de terceros (sin paquete):\n")
        di_sueltos()
        imprimir1("%u programas sueltos.\n", sueltos_n)
        devolver cierto
    fin

    ; -------------------------------------------------------------------------
    ;  (PROGRAMAS) Para la ventana «Programas instalados» (PROGRAMA.BIN): una
    ;  línea por paquete, «f|nombre|versión|tipo|octetos|archivos|fecha|imprescindible
    ;  (por qué, o nada)|necesita|lo necesitan|descripción»; una por programa
    ;  suelto, «s|ruta|octetos|fecha»; y antes, «u|letra|total K|libre K».
    ; -------------------------------------------------------------------------
    función fichas()
        variable i, j, q, op: nat32
        variable u: Info_unidad
        variable d: arreglo [200] de byte
        variable x: arreglo [16] de byte
        variable f: arreglo [12] de byte
        variable r: arreglo [100] de byte
        variable lista: arreglo [256] de byte
        variable n: arreglo [12] de byte
        variable v: arreglo [16] de byte
        variable alguno: bool
        i := 0
        mientras info_unidad(i, u) hacer
            si u.letra = sis entonces
                d[0] := sis
                d[1] := 0
                escribir("u|", d, "|", u.total_k, "|", u.libre_k, "\n")
            fin
            i := i + 1
        fin
        para i desde 1 hasta ins_n hacer
            código_tipo(tipo_de(ins_cab[i - 1], ins_nombre[i - 1]), x)
            fecha_texto(ins_fecha[i - 1], f)
            escribir("f|", ins_nombre[i - 1], "|", ins_versión[i - 1], "|", x, "|", ocupa(ins_cab[i - 1]), "|")
            escribir(lee_archivos(ins_cab[i - 1], viejos), "|", f, "|")
            imprescindible(i - 1, r)
            campo(ins_cab[i - 1], "necesita", lista, 256)
            escribir(r, "|", lista, "|")
            ; lo necesitan
            alguno := falso
            para j desde 1 hasta ins_n hacer
                si j <> i entonces
                    campo(ins_cab[j - 1], "necesita", lista, 256)
                    q := 0
                    mientras requisito(lista, q, n, op, v) hacer
                        si iguales(n, ins_nombre[i - 1]) entonces
                            si alguno entonces escribir(", ") fin
                            escribir(ins_nombre[j - 1])
                            alguno := cierto
                            romper
                        fin
                        q := q + 1
                    fin
                fin
            fin
            campo(ins_cab[i - 1], "descripcion", d, 200)
            escribir("|", d, "\n")
        fin
        busca_sueltos()
        para i desde 1 hasta sueltos_n hacer
            fecha_texto(suelto_fecha[i - 1], f)
            escribir("s|", suelto_ruta[i - 1], "|", suelto_tamaño[i - 1], "|", f, "\n")
        fin
        ; (/CATALOGO) de dónde, y la más nueva de cada uno del catálogo:
        ; «o|de dónde|firmado» y «c|nombre|versión|tipo|octetos del paquete|descripción»
        si con_catálogo y carga_catálogo() entonces
            escribir("o|", origen, "|")
            si firmado entonces escribir("firmado") fin
            escribir("\n")
            para i desde 1 hasta cat_n hacer
                si mejor_del_catálogo(cat_nombre[i - 1], 0, "") = i - 1 entonces
                    código_tipo(tipo_de(nulo, cat_nombre[i - 1]), x)
                    escribir("c|", cat_nombre[i - 1], "|", cat_versión[i - 1], "|", x, "|", cat_tamaño[i - 1], "|", cat_desc[i - 1])
                    si sistema_nuevo(cat_nombre[i - 1]) entonces escribir("|nuevo") fin     ; (SISTEMA)
                    escribir("\n")
                fin
            fin
        fin
    fin

    ; PAQUETES ARCHIVOS nombre: sus archivos, y cómo están
    función archivos(): bool
        variable j, n, a, e, malos: nat32
        variable d: arreglo [3] de nat32
        si no palabra(args, 1, palabra_, RUTA) entonces devolver mal("¿de qué paquete? PAQUETES ARCHIVOS nombre") fin
        a_minúsculas(palabra_)
        j := instalado(palabra_)
        si j = NINGUNO entonces
            imprimir1("paquetes: %s no está instalado\n", pt(palabra_))
            devolver falso
        fin
        n := lee_archivos(ins_cab[j], viejos)
        d[0] := pt(ins_nombre[j])
        d[1] := pt(ins_versión[j])
        d[2] := n
        imprimir("Archivos de %s %s (%u):\n", dirección(d[0]))
        malos := 0
        para a desde 1 hasta n hacer
            e := estado_archivo(viejos[a - 1].destino, viejos[a - 1].tamaño, viejos[a - 1].sha)
            si e = 0 entonces escribir("  bien      ") sino si e = 1 entonces escribir("  FALTA     ") sino escribir("  CAMBIADO  ") fin
            si e <> 0 entonces malos := malos + 1 fin
            d[0] := viejos[a - 1].tamaño
            formatear(palabra_, 16, "%9u  ", dirección(d[0]))
            escribir(palabra_, viejos[a - 1].destino, "\n")
        fin
        si malos = 0 entonces
            escribir("Todos están como se instalaron.\n")
        sino
            imprimir2("%u no están como se instalaron: PAQUETES REPARA %s los vuelve a poner.\n", malos, pt(ins_nombre[j]))
        fin
        devolver cierto
    fin

    ; PAQUETES REPARA [nombre...]: lo dañado (lo que falta o ha cambiado), del
    ; paquete de la misma versión (del catálogo), y solo eso
    función repara(): bool
        variable k, j, n, a, malos, c, largo: nat32
        variable r: arreglo [RUTA] de byte
        variable cab: puntero a byte
        variable alguno, todos: bool
        alguno := falso
        k := 1
        mientras palabra(args, k, palabra_, RUTA) hacer
            k := k + 1
            si palabra_[0] <> '/' entonces alguno := cierto fin
        fin
        todos := no alguno
        reparando := cierto
        para j desde 1 hasta ins_n hacer
            alguno := todos
            si no todos entonces
                k := 1
                mientras palabra(args, k, palabra_, RUTA) hacer
                    k := k + 1
                    a_minúsculas(palabra_)
                    si iguales(palabra_, ins_nombre[j - 1]) entonces alguno := cierto fin
                fin
            fin
            si alguno entonces
                n := lee_archivos(ins_cab[j - 1], viejos)
                malos := 0
                para a desde 1 hasta n hacer
                    si estado_archivo(viejos[a - 1].destino, viejos[a - 1].tamaño, viejos[a - 1].sha) <> 0 entonces
                        si malos = 0 entonces imprimir1("%s:", pt(ins_nombre[j - 1])) fin
                        escribir(" ", dirección(viejos[a - 1].destino[2]))
                        malos := malos + 1
                    fin
                fin
                si malos = 0 entonces
                    imprimir3("%s %s está bien (sus %u archivos, como se instalaron).\n", pt(ins_nombre[j - 1]), pt(ins_versión[j - 1]), n)
                sino
                    escribir(" (dañados)\n")
                    ; el paquete de esa misma versión
                    si no carga_catálogo() entonces
                        imprimir1("paquetes: para reparar %s hace falta su paquete, y no hay catálogo\n", pt(ins_nombre[j - 1]))
                        devolver falso
                    fin
                    c := mejor_del_catálogo(ins_nombre[j - 1], 3, ins_versión[j - 1])
                    si c = NINGUNO entonces
                        imprimir2("paquetes: la %s de %s no está en el catálogo: actualícelo (PAQUETES ACTUALIZA) o\n", pt(ins_versión[j - 1]), pt(ins_nombre[j - 1]))
                        escribir("  instale su paquete a mano (PAQUETES INSTALA X:\\...\\A.HPQ /FORZAR)\n")
                        devolver falso
                    fin
                    si no trae(cat_archivo[c], r) entonces devolver falso fin
                    cab := lee_cabecera(r, largo)
                    si cab = nulo entonces
                        imprimir1("paquetes: %s no es un paquete\n", pt(r))
                        devolver falso
                    fin
                    si no añade(r, cab, largo, c, 0) entonces devolver falso fin
                fin
            fin
        fin
        si orden_n = 0 entonces
            escribir("No hay nada que reparar.\n")
            devolver cierto
        fin
        devolver hace_plan()
    fin

    función di_catálogo()
        variable i, j: nat32
        variable st: arreglo [40] de byte
        variable más: bool
        si no carga_catálogo() entonces devolver fin
        imprimir1("Paquetes que hay en %s:\n", pt(origen))
        para i desde 1 hasta cat_n hacer
            ; (de cada uno, solo el más nuevo)
            más := falso
            para j desde 1 hasta cat_n hacer
                si iguales(cat_nombre[j - 1], cat_nombre[i - 1]) y compara(cat_versión[j - 1], cat_versión[i - 1]) > 0 entonces más := cierto fin
            fin
            si no más entonces
                escribir("  ")
                columna(cat_nombre[i - 1], 10)
                columna(cat_versión[i - 1], 8)
                j := instalado(cat_nombre[i - 1])
                st[0] := 0
                si j <> NINGUNO entonces
                    si compara(cat_versión[i - 1], ins_versión[j]) > 0 entonces
                        une(st, "(nuevo; tiene la ", ins_versión[j])
                        concatenar(st, ")")
                    sino
                        Textos32.copiar(st, "(instalado)")
                    fin
                fin
                columna(st, 25)
                escribir(cat_desc[i - 1], "\n")
            fin
        fin
    fin

    ; para la ventana (ACTUALIZ.BIN): una línea por paquete, fácil de leer,
    ; «p|nombre|instalada|la más nueva del catálogo|descripción» (lo instalado
    ; primero); y antes, «origen|de dónde»
    función di_estado()
        variable i, c: nat32
        variable d: arreglo [200] de byte
        variable x: arreglo [16] de byte
        carga_catálogo()
        escribir("origen|", origen)
        si firmado entonces escribir("|firmado") fin
        escribir("\n")
        para i desde 1 hasta ins_n hacer
            campo(ins_cab[i - 1], "descripcion", d, 200)
            escribir("p|", ins_nombre[i - 1], "|", ins_versión[i - 1], "|")
            c := mejor_del_catálogo(ins_nombre[i - 1], 0, "")
            si c <> NINGUNO entonces escribir(cat_versión[c]) fin
            ; (PROGRAMAS) y detrás, su tipo
            código_tipo(tipo_de(ins_cab[i - 1], ins_nombre[i - 1]), x)
            escribir("|", d, "|", x, "\n")
        fin
        para i desde 1 hasta cat_n hacer
            si instalado(cat_nombre[i - 1]) = NINGUNO y mejor_del_catálogo(cat_nombre[i - 1], 0, "") = i - 1 entonces
                código_tipo(tipo_de(nulo, cat_nombre[i - 1]), x)
                escribir("p|", cat_nombre[i - 1], "||", cat_versión[i - 1], "|", cat_desc[i - 1], "|", x)
                ; (SISTEMA) y si es nuevo del sistema (ACTUALIZA lo pondrá)
                si sistema_nuevo(cat_nombre[i - 1]) entonces escribir("|nuevo") fin
                escribir("\n")
            fin
        fin
    fin

    ; hace el plan: comprueba que todo cabe junto, las sumas de todo, y
    ; luego instala uno a uno (lo que se necesita, antes)
    función hace_plan(): bool
        variable i, k, j: nat32
        si orden_n = 0 entonces
            escribir("No hay nada que instalar.\n")
            devolver cierto
        fin
        si reparando entonces escribir("Se va a reparar (lo dañado, del paquete de la misma versión):") sino escribir("Se va a instalar:") fin
        para i desde 1 hasta orden_n hacer
            k := orden[i - 1]
            escribir(" ", plan_nombre[k], " ", plan_versión[k])
            j := instalado(plan_nombre[k])
            si j <> NINGUNO y no reparando entonces escribir(" (en lugar de la ", ins_versión[j], ")") fin
            si i < orden_n entonces escribir(",") fin
        fin
        escribir("\n")
        si no comprueba_plan() entonces
            escribir("No se instala nada.\n")
            devolver falso
        fin
        para i desde 1 hasta orden_n hacer
            k := orden[i - 1]
            di_avance(i - 1, orden_n, "Comprobando", plan_nombre[k])
            si no verifica(k) entonces
                escribir("No se instala nada: el disco queda como estaba.\n")
                devolver falso
            fin
        fin
        escribir("Las sumas (SHA-256) de todos los archivos están bien.\n")
        para i desde 1 hasta orden_n hacer
            k := orden[i - 1]
            di_avance(i - 1, orden_n, "Instalando", plan_nombre[k])
            si se_cancela() entonces
                si i > 1 entonces escribir("(lo de antes en la lista sí ha quedado instalado)\n") fin
                devolver falso
            fin
            si no pasos_de_instalar(k) entonces devolver falso fin
            si reparando entonces quita_los_sanos() fin
            si no ejecuta() entonces
                si i > 1 entonces escribir("(lo de antes en la lista sí ha quedado instalado)\n") fin
                devolver falso
            fin
            apunta_instalado(plan_nombre[k], plan_versión[k], plan_cab[k])
            si no reparando entonces olvida_quitado(plan_nombre[k]) fin     ; (SISTEMA)
            si reparando entonces
                imprimir2("  reparado %s %s\n", pt(plan_nombre[k]), pt(plan_versión[k]))
            sino
                imprimir2("  instalado %s %s\n", pt(plan_nombre[k]), pt(plan_versión[k]))
            fin
        fin
        di_avance(orden_n, orden_n, "Hecho", "")
        si núcleo_nuevo entonces prepara_arranque() fin
        ; (COMPAT) si ha cambiado win32, el Asistente de compatibilidad vuelve a
        ; comprobar lo de este usuario y avisa de lo que ya va (si no está, nada)
        si no reparando y en_plan("win32") <> NINGUNO entonces lanzar_suelto("\\COMPAT.BIN", "/REVISA") fin
        escribir("Hecho.\n")
        devolver cierto
    fin

    función a_minúsculas(t: puntero a byte)
        mientras valor(t) <> 0 hacer
            valor(t) := minúscula(valor(t))
            t := t + 1
        fin
    fin

    ; ¿es un archivo (X.HPQ, con carpeta o con letra) y no un nombre?
    función es_archivo(t: puntero a byte): bool
        devolver acaba_en(t, ".HPQ") o buscar_car(t, '\\') <> nulo o buscar_car(t, ':') <> nulo
    fin

    función instala(): bool
        variable k, largo, j: nat32
        variable r: arreglo [RUTA] de byte
        variable c: arreglo [RUTA] de byte
        variable v: arreglo [16] de byte
        variable n: arreglo [12] de byte
        variable cab: puntero a byte
        variable alguno: bool
        alguno := falso
        k := 1
        mientras palabra(args, k, palabra_, RUTA) hacer
            k := k + 1
            si palabra_[0] = '/' entonces seguir fin
            alguno := cierto
            si es_archivo(palabra_) entonces
                absoluta(palabra_, r)
                cab := lee_cabecera(r, largo)
                si cab = nulo entonces
                    imprimir1("paquetes: %s no es un paquete (o no está)\n", pt(r))
                    devolver falso
                fin
                ; (lo que necesite, del catálogo de su carpeta si lo tiene)
                si origen[0] = 0 entonces
                    carpeta_de(r, c)
                    concatenar(c, "\\CATALOGO.TXT")
                    si existe(c) entonces
                        carpeta_de(r, c)
                        pon_origen(c)
                    fin
                fin
                campo(cab, "nombre", n, 12)
                campo(cab, "version", v, 16)
                j := instalado(n)
                si j <> NINGUNO y compara(v, ins_versión[j]) <= 0 y no forzar entonces
                    imprimir2("paquetes: %s ya está instalado (la %s): para ponerlo otra vez, /FORZAR\n", pt(n), pt(ins_versión[j]))
                sino si no añade(r, cab, largo, NINGUNO, 0) entonces
                    devolver falso
                fin
            sino
                a_minúsculas(palabra_)
                j := instalado(palabra_)
                si j <> NINGUNO entonces
                    imprimir2("paquetes: %s ya está instalado (la %s); para una más nueva: PAQUETES ACTUALIZA\n", pt(palabra_), pt(ins_versión[j]))
                sino si no planea(palabra_, 0, "", 0) entonces
                    devolver falso
                fin
            fin
        fin
        si no alguno entonces devolver mal("¿qué paquete? PAQUETES INSTALA nombre (o X.HPQ)") fin
        devolver hace_plan()
    fin

    función actualiza(): bool
        variable k, i, c: nat32
        variable alguno: bool
        si no carga_catálogo() entonces devolver falso fin
        alguno := falso
        k := 1
        mientras palabra(args, k, palabra_, RUTA) hacer
            k := k + 1
            si palabra_[0] = '/' entonces seguir fin
            alguno := cierto
            a_minúsculas(palabra_)
            i := instalado(palabra_)
            si i = NINGUNO y sistema_nuevo(palabra_) entonces
                ; (SISTEMA) uno nuevo del sistema: se instala
                si no planea(palabra_, 0, "", 0) entonces devolver falso fin
                seguir
            fin
            si i = NINGUNO entonces
                imprimir1("paquetes: %s no está instalado\n", pt(palabra_))
                devolver falso
            fin
            c := mejor_del_catálogo(palabra_, 0, "")
            si c <> NINGUNO y compara(cat_versión[c], ins_versión[i]) > 0 entonces
                si no planea(palabra_, 1, cat_versión[c], 0) entonces devolver falso fin
            fin
        fin
        si no alguno entonces
            para i desde 1 hasta ins_n hacer
                c := mejor_del_catálogo(ins_nombre[i - 1], 0, "")
                si c <> NINGUNO y compara(cat_versión[c], ins_versión[i - 1]) > 0 entonces
                    si no planea(ins_nombre[i - 1], 1, cat_versión[c], 0) entonces devolver falso fin
                fin
            fin
            ; (SISTEMA) y los del sistema que trae el catálogo y aquí no están
            ; (los de una versión nueva: un sistema que viene de una de antes
            ; no los tiene), salvo los quitados a propósito
            para i desde 1 hasta cat_n hacer
                si mejor_del_catálogo(cat_nombre[i - 1], 0, "") = i - 1 y sistema_nuevo(cat_nombre[i - 1]) entonces
                    imprimir1("Nuevo del sistema: %s\n", pt(cat_nombre[i - 1]))
                    si no planea(cat_nombre[i - 1], 0, "", 0) entonces devolver falso fin
                fin
            fin
        fin
        si orden_n = 0 entonces
            escribir("Todo está al día.\n")
            devolver cierto
        fin
        devolver hace_plan()
    fin

    ; ¿necesita el instalado i al instalado j?
    función necesita_a(i: nat32, j: nat32): bool
        variable q, op: nat32
        variable lista: arreglo [256] de byte
        variable n: arreglo [12] de byte
        variable v: arreglo [16] de byte
        campo(ins_cab[i], "necesita", lista, 256)
        q := 0
        mientras requisito(lista, q, n, op, v) hacer
            si iguales(n, ins_nombre[j]) entonces devolver cierto fin
            q := q + 1
        fin
        devolver falso
    fin

    ; PAQUETES QUITA nombre... [/DEPENDIENTES]: lo que se pide (y, con
    ; /DEPENDIENTES, lo que lo necesite, antes que él), cada uno su todo o nada
    función quita(): bool
        variable k, i, j, w, a: nat32
        variable sale: arreglo [MAX_PAQ] de bool
        variable hecho_: arreglo [MAX_PAQ] de bool
        variable r: arreglo [100] de byte
        variable nombre: arreglo [12] de byte
        variable alguno, más, puede: bool
        para i desde 1 hasta ins_n hacer
            sale[i - 1] := falso
            hecho_[i - 1] := falso
        fin
        alguno := falso
        k := 1
        mientras palabra(args, k, palabra_, RUTA) hacer
            k := k + 1
            si palabra_[0] = '/' entonces seguir fin
            alguno := cierto
            a_minúsculas(palabra_)
            j := instalado(palabra_)
            si j = NINGUNO entonces
                imprimir1("paquetes: %s no está instalado\n", pt(palabra_))
                devolver falso
            fin
            sale[j] := cierto
        fin
        si no alguno entonces devolver mal("¿qué paquete? PAQUETES QUITA nombre") fin
        ; (PROGRAMAS) con /DEPENDIENTES, también lo que necesite lo que sale (hasta que no haya más)
        si con_dependientes entonces
            más := cierto
            mientras más hacer
                más := falso
                para i desde 1 hasta ins_n hacer
                    si no sale[i - 1] entonces
                        para j desde 1 hasta ins_n hacer
                            si sale[j - 1] y no sale[i - 1] y necesita_a(i - 1, j - 1) entonces
                                sale[i - 1] := cierto
                                más := cierto
                            fin
                        fin
                    fin
                fin
            fin
        fin
        ; lo imprescindible no sale nunca; y (sin /FORZAR) nada que necesite otro que se queda
        para j desde 1 hasta ins_n hacer
            si sale[j - 1] y imprescindible(j - 1, r) entonces
                imprimir2("paquetes: %s no se puede quitar: es imprescindible (%s).\n", pt(ins_nombre[j - 1]), pt(r))
                si con_dependientes entonces escribir("  (y para quitar lo otro, lo que lo necesita, hay que dejarlo: no se quita nada)\n") fin
                devolver falso
            fin
            si sale[j - 1] y no forzar entonces
                para i desde 1 hasta ins_n hacer
                    si i <> j y no sale[i - 1] y necesita_a(i - 1, j - 1) entonces
                        imprimir3("paquetes: %s no se quita: lo necesita %s (quite antes %s, o /FORZAR)\n", pt(ins_nombre[j - 1]), pt(ins_nombre[i - 1]), pt(ins_nombre[i - 1]))
                        escribir("  (o con /DEPENDIENTES, que lo quita también)\n")
                        devolver falso
                    fin
                fin
            fin
        fin
        ; lo que se va a quitar, y el avance: los archivos de todos
        av_h := 0
        av_t := 0
        w := 0
        escribir("Se va a quitar:")
        para j desde 1 hasta ins_n hacer
            si sale[j - 1] entonces
                si w > 0 entonces escribir(",") fin
                escribir(" ", ins_nombre[j - 1], " ", ins_versión[j - 1])
                w := w + 1
                av_t := av_t + lee_archivos(ins_cab[j - 1], viejos) + 1
            fin
        fin
        escribir("\n")
        quitando := cierto
        ; de uno en uno: primero el que no necesita ninguno de los que quedan por quitar
        a := 0
        mientras a < w hacer
            puede := falso
            j := 1
            mientras j <= ins_n y no puede hacer
                si sale[j - 1] y no hecho_[j - 1] entonces
                    puede := cierto
                    para i desde 1 hasta ins_n hacer
                        si i <> j y sale[i - 1] y no hecho_[i - 1] y necesita_a(i - 1, j - 1) entonces puede := falso fin
                    fin
                fin
                si no puede entonces j := j + 1 fin
            fin
            si no puede entonces
                ; (en círculo: el primero que quede)
                j := 1
                mientras j <= ins_n y (no sale[j - 1] o hecho_[j - 1]) hacer j := j + 1 fin
            fin
            hecho_[j - 1] := cierto
            Textos32.copiar(nombre, ins_nombre[j - 1])
            si no pasos_de_quitar(j - 1) entonces devolver falso fin
            si no ejecuta() entonces
                si a > 0 entonces escribir("(lo de antes en la lista sí se ha quitado)\n") fin
                devolver falso
            fin
            imprimir1("  quitado %s\n", pt(txn_nombre))
            apunta_quitado(nombre)              ; (SISTEMA) ACTUALIZA no lo vuelve a poner
            a := a + 1
        fin
        ; (la lista de lo instalado, al final: los números de arriba son de antes)
        para j desde ins_n hasta 1 paso -1 hacer
            si sale[j - 1] entonces olvida_instalado(ins_nombre[j - 1]) fin
        fin
        di_avance(av_t, av_t, "Hecho", "")
        escribir("Hecho.\n")
        devolver cierto
    fin

    función mira(): bool
        variable largo, n, a: nat32
        variable r: arreglo [RUTA] de byte
        variable x: arreglo [256] de byte
        variable cab: puntero a byte
        si no palabra(args, 1, palabra_, RUTA) entonces devolver mal("¿qué paquete? PAQUETES MIRA X.HPQ") fin
        absoluta(palabra_, r)
        cab := lee_cabecera(r, largo)
        si cab = nulo entonces
            imprimir1("paquetes: %s no es un paquete (o no está)\n", pt(r))
            devolver falso
        fin
        si no valida(cab, r) entonces devolver falso fin
        campo(cab, "nombre", x, 256)
        escribir(r, ": ", x)
        campo(cab, "version", x, 256)
        escribir(" ", x, "\n")
        campo(cab, "descripcion", x, 256)
        escribir("  ", x, "\n")
        campo(cab, "necesita", x, 256)
        si x[0] = 0 entonces Textos32.copiar(x, "(nada)") fin
        escribir("  necesita: ", x, "\n")
        campo(cab, "choca", x, 256)
        si x[0] <> 0 entonces escribir("  choca con: ", x, "\n") fin
        n := lee_archivos(cab, nuevos)
        para a desde 1 hasta n hacer
            escribir("  ")
            columna(dirección(nuevos[a - 1].destino[2]), 28)
            escribir(nuevos[a - 1].tamaño, " octetos\n")
        fin
        plan_n := 1
        copiar_hasta(plan_ruta[0], r, RUTA)
        plan_cab[0] := cab
        plan_largo[0] := largo
        plan_cat[0] := NINGUNO
        si verifica(0) entonces
            escribir("Está sano: las sumas (SHA-256) de sus archivos están bien.\n")
            devolver cierto
        fin
        devolver falso
    fin

    ; PAQUETES FIRMA ARCHIVO: ¿es ARCHIVO.FIR (el mismo nombre, con .FIR) su firma buena?
    función firma_de_archivo(): bool
        variable m, n, t0, i, p: nat32
        variable r: arreglo [RUTA] de byte
        variable f: arreglo [RUTA] de byte
        variable g: arreglo [64] de byte
        si no palabra(args, 1, palabra_, RUTA) entonces devolver mal("¿qué archivo? PAQUETES FIRMA CATALOGO.TXT") fin
        absoluta(palabra_, r)
        Textos32.copiar(f, r)
        p := longitud(f)
        para i desde 1 hasta longitud(f) hacer
            si f[i - 1] = '.' entonces p := i - 1 fin
            si f[i - 1] = '\\' entonces p := longitud(f) fin
        fin
        f[p] := 0
        concatenar(f, ".FIR")
        m := abrir(r)
        si es_error(m) entonces
            imprimir1("paquetes: no está %s\n", pt(r))
            devolver falso
        fin
        n := leer(m, cat, MAX_CATÁLOGO)
        cerrar(m)
        si es_error(n) entonces n := 0 fin
        si no lee_firma(f, g) entonces
            imprimir1("paquetes: no está su firma (%s), o no se entiende\n", pt(f))
            devolver falso
        fin
        t0 := tics()
        si Firma.verifica(g, cat, n, dirección(Clave.pública[0])) entonces
            imprimir3("La firma de %s es buena (la clave %s; %u tics).\n", pt(r), pt(Clave.HUELLA), tics() - t0)
            devolver cierto
        fin
        imprimir1("La firma de %s NO es buena.\n", pt(r))
        devolver falso
    fin

    función comprueba(): bool
        variable i, a, n, m, malos: nat32
        variable s: arreglo [68] de byte
        malos := 0
        para i desde 1 hasta ins_n hacer
            n := lee_archivos(ins_cab[i - 1], viejos)
            para a desde 1 hasta n hacer
                m := abrir(viejos[a - 1].destino)
                si es_error(m) entonces
                    imprimir2("  %s: falta %s\n", pt(ins_nombre[i - 1]), pt(viejos[a - 1].destino))
                    malos := malos + 1
                sino
                    si largo_de(m) <> viejos[a - 1].tamaño o no resume(m, viejos[a - 1].tamaño, s) o no iguales(s, viejos[a - 1].sha) entonces
                        imprimir2("  %s: %s ha cambiado\n", pt(ins_nombre[i - 1]), pt(viejos[a - 1].destino))
                        malos := malos + 1
                    fin
                    cerrar(m)
                fin
            fin
        fin
        si malos = 0 entonces
            imprimir1("Los archivos de los %u paquetes instalados están como se instalaron.\n", ins_n)
            devolver cierto
        fin
        imprimir1("%u archivos no están como se instalaron (PAQUETES INSTALA X.HPQ /FORZAR los vuelve a poner).\n", malos)
        devolver falso
    fin

    ; -------------------------------------------------------------------------
    función principal(): byte
        variable i, v: nat32
        variable u: Info_unidad
        variable orden_: arreglo [16] de byte
        variable r: arreglo [RUTA] de byte
        variable bien: bool
        buf := más_memoria(TROZO)
        cat := más_memoria(MAX_CATÁLOGO + 4)
        si buf = nulo o cat = nulo entonces
            escribir("paquetes: no hay memoria\n")
            devolver 1
        fin
        argumentos(args, 256)
        ; las opciones
        i := 0
        mientras palabra(args, i, palabra_, RUTA) hacer
            si iguales_sin_caja(palabra_, "/FORZAR") entonces forzar := cierto fin
            si iguales_sin_caja(palabra_, "/AVANCE") entonces con_avance := cierto fin
            si iguales_sin_caja(palabra_, "/TIPO") o iguales_sin_caja(palabra_, "/TIPOS") entonces por_tipo := cierto fin
            si iguales_sin_caja(palabra_, "/DEPENDIENTES") entonces con_dependientes := cierto fin
            si iguales_sin_caja(palabra_, "/LENTO") entonces lento := cierto fin
            si empieza_por(palabra_, "/CANCELA_EN=") entonces texto_a_natural(dirección(palabra_[12]), cancela_en) fin
            si iguales_sin_caja(palabra_, "/CATALOGO") entonces con_catálogo := cierto fin
            si iguales_sin_caja(palabra_, "/LIMPIA") entonces con_limpia := cierto fin
            si empieza_por(palabra_, "/CORTE=") o empieza_por(palabra_, "/corte=") entonces
                texto_a_natural(dirección(palabra_[7]), corte)
            fin
            si longitud(palabra_) > 7 y (empieza_por(palabra_, "/DESDE=") o empieza_por(palabra_, "/desde=")) entonces
                absoluta(dirección(palabra_[7]), r)
                si empieza_por(dirección(palabra_[7]), "http") o empieza_por(dirección(palabra_[7]), "HTTP") entonces Textos32.copiar(r, dirección(palabra_[7])) fin
                pon_origen(r)
            fin
            i := i + 1
        fin
        ; la orden: la primera palabra que no es una opción
        orden_[0] := 0
        i := 0
        mientras palabra(args, i, palabra_, RUTA) hacer
            si palabra_[0] <> '/' entonces
                copiar_hasta(orden_, palabra_, 16)
                romper
            fin
            i := i + 1
        fin
        ; (las palabras de después de la orden, desde la 1: la orden, primero)
        si i > 0 entonces
            ; quita las opciones de delante, para que la orden sea la palabra 0
            Textos32.copiar(args, tras_palabras(args, i))
        fin
        a_minúsculas(orden_)
        si orden_[0] = 0 o iguales(orden_, "ayuda") o iguales(orden_, "?") entonces
            ayuda()
            devolver 0
        fin
        ; la unidad del sistema, con \HISPA
        sis := 0
        i := 0
        mientras info_unidad(i, u) hacer
            si u.del_sistema = 1 entonces sis := u.letra fin
            i := i + 1
        fin
        v := dato(DATO_VERSIÓN)
        r[0] := 0
        natural_a_texto(v >> 8, versión_núcleo)
        concatenar(versión_núcleo, ".")
        natural_a_texto(v yb 0xFF, r)
        concatenar(versión_núcleo, r)
        si iguales(orden_, "mira") entonces
            si sis = 0 entonces sis := 'C' fin
            si mira() entonces devolver 0 fin
            devolver 1
        fin
        si iguales(orden_, "firma") entonces
            si firma_de_archivo() entonces devolver 0 fin
            devolver 1
        fin
        r[0] := sis
        r[1] := 0
        concatenar(r, ":\\HISPA")
        si sis = 0 o sis = 'M' o no existe(r) entonces
            escribir("paquetes: Hispa-Pentium no está instalado en esta unidad (falta \\HISPA): PAQUETES es\n")
            escribir("  para el sistema instalado en el disco duro (INSTALAR).\n")
            devolver 1
        fin
        Textos32.copiar(base, r)
        concatenar(base, "\\PAQUETES")
        en_base("DIARIO.TXT", diario)
        en_base("HECHO.TXT", hecho)
        si con_avance entonces
            en_base("AVANCE.TXT", avance)
            en_base("CANCELA.TXT", cancela)             ; (RÁPIDO)
            borrar(cancela)
        fin
        ; (USUARIOS) instalar, actualizar, quitar y reparar: solo un administrador
        si (iguales(orden_, "instala") o iguales(orden_, "actualiza") o iguales(orden_, "quita") o iguales(orden_, "repara")) y no soy_administrador() entonces
            escribir("paquetes: solo un administrador puede instalar, actualizar o quitar programas (entre con su usuario)\n")
            devolver 1
        fin
        si no existe(base) entonces crear_carpeta(base) fin
        si soy_administrador() entonces recupera() fin       ; (USUARIOS) lo de una vez que se cortó
        carga_instalados()
        bien := cierto
        si iguales(orden_, "lista") entonces
            di_lista()
        sino si iguales(orden_, "catalogo") o iguales(orden_, "catálogo") entonces
            di_catálogo()
        sino si iguales(orden_, "instala") entonces
            limpia_bajadas()                        ; (0.8.6)
            bien := instala()
        sino si iguales(orden_, "actualiza") entonces
            limpia_bajadas()
            bien := actualiza()
        sino si iguales(orden_, "quita") entonces
            bien := quita()
        sino si iguales(orden_, "comprueba") entonces
            bien := comprueba()
        sino si iguales(orden_, "estado") entonces
            ; (0.8.6) ACTUALIZ /BANDEJA, al arrancar: «estado /limpia» (lo de BAJADAS de antes)
            si con_limpia entonces limpia_bajadas() fin
            di_estado()
        sino si iguales(orden_, "repara") entonces
            limpia_bajadas()
            bien := repara()
        sino si iguales(orden_, "archivos") entonces
            bien := archivos()
        sino si iguales(orden_, "sueltos") entonces
            bien := sueltos()
        sino si iguales(orden_, "fichas") entonces
            fichas()
        sino
            imprimir1("paquetes: no sé qué es «%s» (PAQUETES AYUDA)\n", pt(orden_))
            bien := falso
        fin
        suelta_bajadas()                                ; (RÁPIDO)
        si no bien entonces se_cancela() fin
        si cancela[0] <> 0 entonces borrar(cancela) fin
        si cancelado entonces devolver 3 fin
        si bien entonces devolver 0 fin
        devolver 1
    fin

fin UPaquetes.
