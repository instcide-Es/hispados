    constante CLASES4 = "\n0000 Aparato antiguo\n0001 Tarjeta gráfica antigua\n0100 Controladora SCSI\n0101 Controladora IDE\n0102 Controladora de disquetes\n0104 Controladora RAID\n0105 Controladora ATA\n0106 Controladora SATA\n0107 Controladora SAS\n0108 Controladora de memoria (NVMe)\n0180 Controladora de discos\n0200 Tarjeta de red (Ethernet)\n0280 Tarjeta de red inalámbrica (Wi-Fi)\n0300 Tarjeta gráfica (VGA)\n0302 Tarjeta gráfica 3D\n0380 Tarjeta gráfica\n0400 Vídeo\n0401 Tarjeta de sonido (AC'97)\n0403 Sonido HD Audio\n0480 Sonido\n0500 Controladora de memoria RAM\n0580 Controladora de memoria\n0600 Puente al procesador\n0601 Puente ISA (LPC)\n0602 Puente EISA\n0604 Puente PCI a PCI\n0607 Puente CardBus\n0609 Puente PCI\n0680 Puente\n0700 Puerto serie\n0701 Puerto paralelo\n0703 Módem\n0780 Comunicaciones (motor de gestión)\n0800 Controladora de interrupciones\n0801 Controladora de DMA\n0802 Temporizador\n0803 Reloj\n0805 Lector de tarjetas SD\n0806 IOMMU\n0880 Periférico del sistema\n0900 Teclado\n0902 Ratón\n0B40 Coprocesador\n0C00 FireWire (IEEE 1394)\n0C03 Controladora USB\n0C05 Controladora SMBus\n0C80 Bus serie\n0D11 Bluetooth\n0D80 Aparato inalámbrico\n1080 Cifrado\n1180 Sensores\n1101 Medida de rendimiento\n"
    constante FAB_USB = "\n1D6B Linux Foundation\n0627 QEMU\n46F4 QEMU\n0409 NEC\n80EE VirtualBox\n0E0F VMware\n8087 Intel\n0781 SanDisk\n090C Silicon Motion\n058F Alcor Micro\n0951 Kingston\n13FE Phison\n8564 Transcend\n054C Sony\n0930 Toshiba\n125F A-DATA\n18A5 Verbatim\n1F75 Innostor\n046D Logitech\n045E Microsoft\n413C Dell\n04F2 Chicony\n05AC Apple\n0BDA Realtek\n1A40 Terminus\n05E3 Genesys Logic\n0424 Microchip (SMSC)\n0B95 ASIX\n0CF3 Atheros\n04CA Lite-On\n03F0 HP\n04A9 Canon\n04B8 Epson\n04E8 Samsung\n0BC2 Seagate\n1058 Western Digital\n152D JMicron\n174C ASMedia\n2109 VIA Labs\n1532 Razer\n0C45 Microdia\n05C8 Cheng Uei\n064E Suyin\n04F3 Elan\n06CB Synaptics\n0A5C Broadcom\n0A12 Cambridge Silicon Radio\n2001 D-Link\n148F Ralink\n067B Prolific\n0403 FTDI\n10C4 Silicon Labs\n1A86 QinHeng\n093A Pixart\n09DA A4Tech\n1C4F SiGma Micro\n258A Sinowealth\n0458 Genius (KYE)\n17EF Lenovo\n0D8C C-Media\n04D9 Holtek\n"
    constante MOD_USB = "\n46F4:0001 QEMU: memoria USB\n0409:55AA NEC: concentrador USB\n80EE:0021 VirtualBox: tableta USB\n0E0F:0003 VMware: ratón virtual\n1D6B:0002 Concentrador raíz USB 2.0\n0781:5567 SanDisk Cruzer Blade\n0781:5571 SanDisk Cruzer Fit\n0781:5581 SanDisk Ultra\n0951:1666 Kingston DataTraveler\n090C:1000 Silicon Motion: memoria USB\n058F:6387 Alcor: memoria USB\n13FE:4200 Phison: memoria USB\n046D:C077 Logitech M105 (ratón)\n046D:C52B Logitech Unifying (receptor)\n046D:C534 Logitech: receptor inalámbrico\n045E:0040 Microsoft Wheel Mouse Optical\n0BDA:8153 Realtek RTL8153 (red Gigabit por USB)\n0BDA:8152 Realtek RTL8152 (red por USB)\n0B95:772B ASIX AX88772B (red por USB)\n0B95:1790 ASIX AX88179 (red Gigabit por USB)\n0CF3:9271 Atheros AR9271 (Wi-Fi por USB)\n0BDA:8179 Realtek RTL8188EUS (Wi-Fi por USB)\n0BDA:0129 Realtek RTS5129: lector de tarjetas\n1A40:0101 Terminus: concentrador de 4 puertos\n05E3:0608 Genesys Logic: concentrador USB 2.0\n8087:0024 Intel: concentrador interno\n8087:8000 Intel: concentrador interno\n8087:8008 Intel: concentrador interno\n8087:0A2A Intel: Bluetooth\n0A5C:21E6 Broadcom: Bluetooth\n0A12:0001 CSR: Bluetooth\n"
    constante PNP = "\nPNP0303 Teclado PS/2\nPNP030B Teclado PS/2\nPNP0F13 Ratón PS/2\nPNP0F03 Ratón PS/2\nPNP0F0E Ratón PS/2\nPNP0B00 Reloj de la CMOS\nPNP0B01 Reloj de la CMOS\nPNP0B02 Reloj de la CMOS\nPNP0100 Reloj del sistema (8253)\nPNP0000 Controladora de interrupciones (8259)\nPNP0200 Controladora de DMA\nPNP0800 Altavoz del PC\nPNP0C04 Coprocesador matemático\nPNP0501 Puerto serie\nPNP0400 Puerto paralelo (impresora)\nPNP0401 Puerto paralelo ECP\nPNP0700 Controladora de disquetes\nPNP0103 Temporizador de alta precisión (HPET)\nPNP0A03 Bus PCI\nPNP0A08 Bus PCI Express\nPNP0A05 Contenedor de la placa\nPNP0A06 Contenedor de la placa\nPNP0C01 Memoria del sistema\nPNP0C02 Recursos de la placa base\nPNP0C09 Controlador embebido\nPNP0C0A Batería\nACPI0003 Adaptador de corriente\nPNP0C0C Botón de encendido\nPNP0C0D Tapa del portátil\nPNP0C0E Botón de suspender\nPNP0C0F Enlace de interrupciones PCI\nPNP0C14 Interfaz WMI\nPNP0C32 Botón rápido\nPNP0C80 Memoria (se puede añadir en marcha)\nPNP0C50 Panel táctil (HID por I2C)\nACPI0007 Procesador\nACPI0010 Contenedor de procesadores\nACPI0004 Módulo\nACPI0006 Contenedor de sucesos (GPE)\nACPI000E Reloj de despertar\nQEMU0002 QEMU: configuración (fw_cfg)\nINT0800 Memoria del firmware (Intel)\nINT3F0D Vigilante (Intel)\nLNXVIDEO Vídeo (ACPI)\nLNXPWRBN Botón de encendido\n"
    constante CATEGORÍAS = "Pantalla|Discos|Controladoras de disco|USB|Red|Sonido|Teclado y ratón|Sistema y ACPI|Batería|Procesador|Otros dispositivos"

    ; busca «clave» en la tabla y copia su nombre a d (falso si no está)
    función en_tabla(tabla: puntero a byte, clave: puntero a byte, d: puntero a byte, cabe: nat32): bool
        variable patrón: arreglo [24] de byte
        variable p: puntero a byte
        variable k: nat32
        patrón[0] := '\n'
        patrón[1] := 0
        concatenar(patrón, clave)
        concatenar(patrón, " ")
        p := buscar(tabla, patrón)
        si p = nulo entonces devolver falso fin
        p := p + longitud(patrón)
        k := 0
        mientras p[k] <> '\n' y p[k] <> 0 y k + 1 < cabe hacer
            d[k] := p[k]
            k := k + 1
        fin
        d[k] := 0
        devolver cierto
    fin

    función hex4(v: nat32, d: puntero a byte)
        dd[0] := v yb 0xFFFF
        formatear(d, 8, "%04X", dd)
    fin

    función clave_id(a: nat32, b: nat32, d: puntero a byte)
        dd[0] := a yb 0xFFFF
        dd[1] := b yb 0xFFFF
        formatear(d, 12, "%04X:%04X", dd)
    fin

    ; el nombre de la clase de PCI (con su interfaz, si la tabla la tiene)
    función nombre_clase(c: nat32, d: puntero a byte, cabe: nat32)
        variable k: arreglo [12] de byte
        dd[0] := c
        formatear(k, 12, "%06X", dd)
        si en_tabla(CLASES6, k, d, cabe) entonces devolver fin
        dd[0] := c >> 8
        formatear(k, 12, "%04X", dd)
        si en_tabla(CLASES4, k, d, cabe) entonces devolver fin
        dd[0] := c >> 16
        formatear(d, cabe, "Aparato de la clase %02X", dd)
    fin

    función nombre_clase_usb(c: nat32, d: puntero a byte)
        variable cc, pr: nat32
        cc := c >> 16
        pr := c yb 0xFF
        según nat16(cc)
            caso 0x01: Textos32.copiar(d, "sonido USB")
            caso 0x02: Textos32.copiar(d, "módem o red USB (CDC)")
            caso 0x03:
                si pr = 1 entonces Textos32.copiar(d, "teclado USB") sino si pr = 2 entonces Textos32.copiar(d, "ratón USB") sino Textos32.copiar(d, "aparato HID (mando, panel...)") fin
            caso 0x06: Textos32.copiar(d, "cámara de fotos (PTP)")
            caso 0x07: Textos32.copiar(d, "impresora USB")
            caso 0x08: Textos32.copiar(d, "memoria o disco USB")
            caso 0x09: Textos32.copiar(d, "concentrador USB")
            caso 0x0A: Textos32.copiar(d, "datos (CDC)")
            caso 0x0B: Textos32.copiar(d, "lector de tarjetas inteligentes")
            caso 0x0E: Textos32.copiar(d, "cámara USB")
            caso 0xE0: Textos32.copiar(d, "Bluetooth")
            caso 0xEF: Textos32.copiar(d, "aparato USB compuesto")
            caso 0xFF: Textos32.copiar(d, "aparato USB del fabricante")
            si no: Textos32.copiar(d, "aparato USB")
        fin
    fin

    ; el fabricante (vacío si no se sabe)
    función fabricante(i: nat32, d: puntero a byte)
        variable k: arreglo [12] de byte
        d[0] := 0
        si lista[i].bus = BUS_PCI entonces
            hex4(lista[i].fabricante, k)
            si no en_tabla(FAB_PCI, k, d, 48) entonces
                dd[0] := lista[i].fabricante
                formatear(d, 48, "el %04X (sin nombre en la tabla)", dd)
            fin
        sino si lista[i].bus = BUS_USB y lista[i].dirección < 0x100 entonces
            hex4(lista[i].fabricante, k)
            si no en_tabla(FAB_USB, k, d, 48) entonces
                si lista[i].marca[0] <> 0 entonces copiar_hasta(d, lista[i].marca, 48) sino
                    dd[0] := lista[i].fabricante
                    formatear(d, 48, "el %04X (sin nombre en la tabla)", dd)
                fin
            fin
        sino si lista[i].bus = BUS_CPU entonces
            si iguales(lista[i].marca, "GenuineIntel") entonces Textos32.copiar(d, "Intel")
            sino si iguales(lista[i].marca, "AuthenticAMD") entonces Textos32.copiar(d, "AMD")
            sino copiar_hasta(d, lista[i].marca, 48) fin
        sino
            copiar_hasta(d, lista[i].marca, 48)
        fin
    fin

    ; el nombre que se enseña (hasta «cabe»)
    función nombre_de(i: nat32, d: puntero a byte, cabe: nat32)
        variable k: arreglo [12] de byte
        variable f: arreglo [48] de byte
        variable c: arreglo [48] de byte
        d[0] := 0
        si lista[i].bus = BUS_PCI entonces
            clave_id(lista[i].fabricante, lista[i].producto, k)
            si en_tabla(MOD_PCI1, k, d, cabe) o en_tabla(MOD_PCI2, k, d, cabe) o en_tabla(MOD_PCI3, k, d, cabe) o en_tabla(MOD_PCI4, k, d, cabe) o en_tabla(MOD_PCI5, k, d, cabe) o en_tabla(MOD_PCI6, k, d, cabe) entonces devolver fin
            si lista[i].nombre[0] <> 0 entonces
                copiar_hasta(d, lista[i].nombre, cabe)
                devolver
            fin
            fabricante(i, f)
            nombre_clase(lista[i].clase, c, 48)
            hex4(lista[i].fabricante, k)
            si en_tabla(FAB_PCI, k, f, 48) entonces
                dd[0] := nat32(dirección(f[0]))
                dd[1] := nat32(dirección(c[0]))
                formatear(d, cabe, "%s: %s", dd)
            sino
                copiar_hasta(d, c, cabe)
            fin
        sino si lista[i].bus = BUS_USB entonces
            si lista[i].nombre[0] <> 0 entonces
                ; con la marca delante, si no la lleva ya
                si lista[i].marca[0] <> 0 y buscar(lista[i].nombre, lista[i].marca) = nulo entonces
                    dd[0] := nat32(dirección(lista[i].marca[0]))
                    dd[1] := nat32(dirección(lista[i].nombre[0]))
                    formatear(d, cabe, "%s %s", dd)
                sino
                    copiar_hasta(d, lista[i].nombre, cabe)
                fin
                devolver
            fin
            clave_id(lista[i].fabricante, lista[i].producto, k)
            si en_tabla(MOD_USB, k, d, cabe) entonces devolver fin
            nombre_clase_usb(lista[i].clase, c)
            hex4(lista[i].fabricante, k)
            si en_tabla(FAB_USB, k, f, 48) entonces
                dd[0] := nat32(dirección(f[0]))
                dd[1] := nat32(dirección(c[0]))
                formatear(d, cabe, "%s: %s", dd)
            sino
                c[0] := mayúscula(c[0])
                copiar_hasta(d, c, cabe)
            fin
        sino si lista[i].bus = BUS_DISCO entonces
            junta_espacios(lista[i].nombre)
            dd[0] := nat32(dirección(lista[i].nombre[0]))
            dd[1] := lista[i].dato1 div 2048
            si lista[i].dato1 >= 2048 * 10240 entonces
                dd[1] := lista[i].dato1 div (2048 * 1024)
                formatear(d, cabe, "%s (%u GB)", dd)
            sino
                formatear(d, cabe, "%s (%u MB)", dd)
            fin
        sino si lista[i].bus = BUS_ACPI y lista[i].pnp[0] <> 0 y en_tabla(PNP, lista[i].pnp, d, cabe) entonces
            si lista[i].dirección = 0 entonces copiar_hasta(d, lista[i].nombre, cabe) fin
        sino si lista[i].bus = BUS_ACPI y lista[i].dirección <> 0 entonces
            dd[0] := nat32(dirección(lista[i].pnp[0]))
            formatear(d, cabe, "Dispositivo ACPI %s", dd)
        sino
            copiar_hasta(d, lista[i].nombre, cabe)
        fin
    fin

    ; sin espacios repetidos («QEMU    QEMU HARDDISK»: el fabricante y el modelo del USB)
    función junta_espacios(p: puntero a byte)
        variable i, k: nat32
        i := 0
        k := 0
        mientras p[i] <> 0 hacer
            si p[i] <> ' ' o (k > 0 y p[k - 1] <> ' ') entonces
                p[k] := p[i]
                k := k + 1
            fin
            i := i + 1
        fin
        p[k] := 0
    fin

    ; la categoría (0 a N_CAT - 1)
    función categoría(i: nat32): nat32
        variable c, s: nat32
        c := lista[i].clase >> 16
        s := lista[i].clase >> 8
        según nat16(lista[i].bus)
            caso BUS_DISCO: devolver 1
            caso BUS_CPU: devolver 9
            caso BUS_PLACA:
                si c = 0x09 entonces devolver 6 fin
                si c = 0x03 entonces devolver 0 fin     ; (EDID) el monitor, en Pantalla
                devolver 7
            caso BUS_ACPI:
                si iguales(lista[i].pnp, "PNP0C0A") o iguales(lista[i].pnp, "ACPI0003") entonces devolver 8 fin
                si iguales(lista[i].pnp, "PNP0303") o iguales(lista[i].pnp, "PNP030B") o empieza_por(lista[i].pnp, "PNP0F") entonces devolver 6 fin
                si iguales(lista[i].pnp, "ACPI0007") entonces devolver 9 fin
                devolver 7
            caso BUS_USB:
                si c = 0x03 entonces devolver 6 fin
                si c = 0x01 entonces devolver 5 fin
                si c = 0x02 o c = 0x0A o c = 0xE0 entonces devolver 4 fin
                devolver 3
        fin
        si c = 0x03 entonces devolver 0 fin
        si c = 0x01 entonces devolver 2 fin
        si s = 0x0C03 entonces devolver 3 fin
        si c = 0x02 o c = 0x0D entonces devolver 4 fin
        si c = 0x04 entonces devolver 5 fin
        si c = 0x06 o c = 0x08 o c = 0x05 o s = 0x0C05 entonces devolver 7 fin
        si c = 0x0B entonces devolver 9 fin
        si c = 0x09 entonces devolver 6 fin
        devolver 10
    fin

    función palabra_estado(e: nat32): puntero a byte
        según nat16(e)
            caso EST_FUNCIONA: devolver "funciona"
            caso EST_ERROR: devolver "CON ERROR"
            caso EST_APAGADO: devolver "desactivado"
            caso EST_NO_HACE_FALTA: devolver "no le hace falta"
        fin
        devolver "SIN CONTROLADOR"
    fin

    función signo(e: nat32): byte
        según nat16(e)
            caso EST_FUNCIONA: devolver '+'          ; (la letra no tiene «√»)
            caso EST_ERROR: devolver 'X'
            caso EST_APAGADO: devolver '-'
            caso EST_NO_HACE_FALTA: devolver 0xFA    ; ·
        fin
        devolver '!'
    fin

    función marca_informe(e: nat32): puntero a byte
        según nat16(e)
            caso EST_FUNCIONA: devolver "[OK]"
            caso EST_ERROR: devolver "[X] "
            caso EST_APAGADO: devolver "[--]"
            caso EST_NO_HACE_FALTA: devolver "[OK]"
        fin
        devolver "[!] "
    fin

    ; el identificador corto: «8086:100E», «PNP0303»...
    función identificador(i: nat32, d: puntero a byte)
        d[0] := 0
        si lista[i].bus = BUS_PCI o (lista[i].bus = BUS_USB y lista[i].dirección < 0x100) entonces
            clave_id(lista[i].fabricante, lista[i].producto, d)
        sino
            copiar_hasta(d, lista[i].pnp, 16)
        fin
    fin

    ; dónde está
    función dónde(i: nat32, d: puntero a byte)
        variable a: nat32
        a := lista[i].dirección
        según nat16(lista[i].bus)
            caso BUS_PCI:
                dd[0] := (a >> 16) yb 0xFF
                dd[1] := (a >> 11) yb 0x1F
                dd[2] := (a >> 8) yb 7
                formatear(d, 120, "bus PCI, %02X:%02X.%u", dd)
            caso BUS_USB: Textos32.copiar(d, "USB")
            caso BUS_ACPI:
                si lista[i].dirección = 0 entonces Textos32.copiar(d, "ACPI (las tablas de la BIOS)") sino
                    dd[0] := nat32(dirección(lista[i].nombre[0]))
                    formatear(d, 120, "ACPI: %s", dd)
                fin
            caso BUS_PLACA: Textos32.copiar(d, "en la placa (los puertos de siempre)")
            caso BUS_DISCO:
                si lista[i].dato2 = 1 entonces Textos32.copiar(d, "disco IDE")
                sino si lista[i].dato2 = 2 entonces Textos32.copiar(d, "disco SATA (AHCI)")
                sino Textos32.copiar(d, "disco USB") fin
            si no: Textos32.copiar(d, "el procesador")
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  Leer la lista
    ; -------------------------------------------------------------------------
    función lee()
        variable i, k, ip: nat32
        n := lista_dispositivos(dirección(lista[0]), MAX)
        si es_error(n) entonces n := 0 fin
        si n > MAX entonces n := MAX fin
        para i desde 0 hasta n - 1 hacer
            oculto[i] := falso
            acpi_de[i] := SIN_PADRE
        fin
        ; lo de ACPI que ya sale como «lo de siempre» (el teclado PS/2, el
        ; reloj, los puertos serie...) va con ello, no aparte
        para i desde 0 hasta n - 1 hacer
            si lista[i].bus = BUS_ACPI y lista[i].pnp[0] <> 0 entonces
                para k desde 0 hasta n - 1 hacer
                    si no oculto[i] y lista[k].bus = BUS_PLACA y acpi_de[k] = SIN_PADRE y iguales(lista[k].pnp, lista[i].pnp) entonces
                        ; (los puertos serie: el de los mismos puertos)
                        si no iguales(lista[k].pnp, "PNP0501") o (lista[i].n_recursos > 0 y lista[k].n_recursos > 0 y lista[i].recursos[0].base = lista[k].recursos[0].base) entonces
                            oculto[i] := cierto
                            acpi_de[k] := i
                        fin
                    fin
                    ; (el teclado y el ratón PS/2 declarados con otro nombre)
                    si no oculto[i] y lista[k].bus = BUS_PLACA y acpi_de[k] = SIN_PADRE y empieza_por(lista[i].pnp, "PNP0F") y iguales(lista[k].pnp, "PNP0F13") entonces
                        oculto[i] := cierto
                        acpi_de[k] := i
                    fin
                fin
            fin
        fin
        ; la red y la batería, de sus servicios (sin ponerlos en marcha)
        hay_red := falso
        si estado_rápido(ip) <> RED_NADA entonces hay_red := estado_red(red) = 0 fin
        hay_en := batería(en)
    fin

    función cuenta(e: nat32): nat32
        variable i, c: nat32
        c := 0
        para i desde 0 hasta n - 1 hacer
            si no oculto[i] y lista[i].estado = e entonces c := c + 1 fin
        fin
        devolver c
    fin

    ; -------------------------------------------------------------------------
    ;  La ficha en texto: «Rótulo\tvalor\n» (la parte 0, General; la 1,
    ;  Controlador; la 2, Recursos)
    ; -------------------------------------------------------------------------
    función línea(d: puntero a byte, rótulo: puntero a byte, valor_: puntero a byte)
        si longitud(d) + longitud(rótulo) + longitud(valor_) + 4 >= 3000 entonces devolver fin
        concatenar(d, rótulo)
        concatenar(d, "\t")
        concatenar(d, valor_)
        concatenar(d, "\n")
    fin

    función tamaño_texto(n_: nat32, d: puntero a byte)
        dd[0] := n_
        si n_ = 0 entonces Textos32.copiar(d, "")
        sino si n_ >= 0x100000 y n_ yb 0xFFFFF = 0 entonces
            dd[0] := n_ >> 20
            formatear(d, 20, " (%u MB)", dd)
        sino si n_ >= 0x400 y n_ yb 0x3FF = 0 entonces
            dd[0] := n_ >> 10
            formatear(d, 20, " (%u K)", dd)
        sino
            formatear(d, 20, " (%u octetos)", dd)
        fin
    fin

    función ficha_de(i: nat32, parte: nat32, d: puntero a byte)
        variable k, a: nat32
        variable v: arreglo [200] de byte
        variable w: arreglo [64] de byte
        variable z: arreglo [24] de byte
        d[0] := 0
        si parte = 0 entonces
            opción_de(CATEGORÍAS, categoría(i), v, 200)
            línea(d, "Tipo", v)
            fabricante(i, v)
            si v[0] <> 0 entonces línea(d, "Fabricante", v) fin
            dónde(i, v)
            línea(d, "Dónde está", v)
            según nat16(lista[i].estado)
                caso EST_FUNCIONA:
                    dd[0] := nat32(dirección(lista[i].controlador[0]))
                    formatear(v, 200, "Funciona: lo lleva %s.", dd)
                caso EST_ERROR:
                    dd[0] := nat32(dirección(lista[i].controlador[0]))
                    formatear(v, 200, "CON ERROR: %s lo ha visto, pero no ha podido ponerlo en marcha.", dd)
                caso EST_APAGADO: Textos32.copiar(v, "Desactivado: se ha pedido que no se use.")
                caso EST_NO_HACE_FALTA: Textos32.copiar(v, "Funciona: no necesita controlador.")
                si no: Textos32.copiar(v, "SIN CONTROLADOR: Hispa-Pentium aún no sabe usarlo.")
            fin
            línea(d, "Estado", v)
            si lista[i].detalle[0] <> 0 entonces línea(d, "Detalle", lista[i].detalle) fin
            ; lo de la red y la batería, de sus servicios
            si hay_red y lista[i].bus = BUS_PCI y red.pci = lista[i].dirección entonces
                dd[0] := red.mac[0]
                dd[1] := red.mac[1]
                dd[2] := red.mac[2]
                dd[3] := red.mac[3]
                dd[4] := red.mac[4]
                dd[5] := red.mac[5]
                formatear(v, 200, "%02X:%02X:%02X:%02X:%02X:%02X", dd)
                línea(d, "MAC", v)
                si red.velocidad <> 0 entonces
                    dd[0] := red.velocidad
                    formatear(v, 200, "sí, a %u Mbit/s", dd)
                sino
                    Textos32.copiar(v, "no (¿está enchufado el cable?)")
                fin
                línea(d, "Enlace", v)
            fin
            si hay_en y lista[i].bus = BUS_ACPI y iguales(lista[i].pnp, "PNP0C0A") y en.nbat > 0 entonces
                dd[0] := en.pct
                si en.pct <= 100 entonces formatear(v, 200, "%u %%", dd) sino Textos32.copiar(v, "no se sabe") fin
                si en.cargando <> 0 entonces concatenar(v, ", cargando") fin
                línea(d, "Carga", v)
                si en.salud_pct <= 100 entonces
                    dd[0] := en.salud_pct
                    dd[1] := en.llena
                    dd[2] := en.diseño
                    dd[3] := nat32("mWh")
                    si en.unidad = 1 entonces dd[3] := nat32("mAh") fin
                    formatear(v, 200, "%u %% (guarda %u de %u %s de cuando era nueva)", dd)
                    línea(d, "Salud", v)
                fin
                si en.ciclos1 <> 0xFFFF entonces
                    dd[0] := en.ciclos1
                    formatear(v, 200, "%u", dd)
                    línea(d, "Ciclos de carga", v)
                fin
            fin
            si hay_en y lista[i].bus = BUS_ACPI y iguales(lista[i].pnp, "ACPI0003") y en.ca <= 1 entonces
                si en.ca = 1 entonces línea(d, "Corriente", "enchufado") sino línea(d, "Corriente", "sin enchufar") fin
            fin
        sino si parte = 1 entonces
            si lista[i].controlador[0] = 0 entonces
                si lista[i].estado = EST_NO_HACE_FALTA entonces línea(d, "Controlador", "no le hace falta") sino línea(d, "Controlador", "ninguno") fin
            sino
                dd[0] := nat32(dirección(lista[i].controlador[0]))
                si buscar(lista[i].controlador, ".cas") <> nulo entonces
                    formatear(v, 200, "%s (en el núcleo)", dd)
                sino si buscar(lista[i].controlador, ".BIN") <> nulo entonces
                    formatear(v, 200, "%s (un servicio del anillo 3)", dd)
                sino
                    formatear(v, 200, "%s", dd)
                fin
                línea(d, "Controlador", v)
            fin
            si lista[i].bus = BUS_PCI entonces
                clave_id(lista[i].fabricante, lista[i].producto, z)
                dd[0] := nat32(dirección(z[0]))
                formatear(v, 200, "PCI %s", dd)
                línea(d, "Identificador", v)
                si lista[i].subsistema <> 0 y lista[i].subsistema <> 0xFFFFFFFF entonces
                    clave_id(lista[i].subsistema, lista[i].subsistema >> 16, z)
                    línea(d, "Subsistema", z)
                fin
                dd[0] := lista[i].revisión
                formatear(v, 200, "%02X", dd)
                línea(d, "Revisión", v)
                nombre_clase(lista[i].clase, w, 64)
                dd[0] := lista[i].clase
                dd[1] := nat32(dirección(w[0]))
                formatear(v, 200, "%06X (%s)", dd)
                línea(d, "Clase", v)
            sino si lista[i].bus = BUS_USB y lista[i].dirección < 0x100 entonces
                clave_id(lista[i].fabricante, lista[i].producto, z)
                dd[0] := nat32(dirección(z[0]))
                formatear(v, 200, "USB %s", dd)
                línea(d, "Identificador", v)
                nombre_clase_usb(lista[i].clase, w)
                dd[0] := lista[i].clase >> 16
                dd[1] := (lista[i].clase >> 8) yb 0xFF
                dd[2] := lista[i].clase yb 0xFF
                dd[3] := nat32(dirección(w[0]))
                formatear(v, 200, "%02X/%02X/%02X (%s)", dd)
                línea(d, "Clase", v)
                si lista[i].nombre[0] <> 0 entonces línea(d, "Dice que es", lista[i].nombre) fin
                si lista[i].marca[0] <> 0 entonces línea(d, "Dice su marca", lista[i].marca) fin
                dd[0] := lista[i].dato3
                formatear(v, 200, "%u", dd)
                línea(d, "Dirección USB", v)
            sino si lista[i].bus = BUS_DISCO entonces
                línea(d, "Modelo", lista[i].nombre)
                dd[0] := lista[i].dato1
                dd[1] := lista[i].dato1 div 2048
                formatear(v, 200, "%u sectores de 512 octetos (%u MB)", dd)
                línea(d, "Tamaño", v)
            sino si lista[i].bus = BUS_CPU entonces
                línea(d, "Nombre", lista[i].nombre)
                dd[0] := lista[i].fabricante
                formatear(v, 200, "%08X (CPUID 1)", dd)
                línea(d, "Firma", v)
            sino si lista[i].pnp[0] <> 0 entonces
                línea(d, "Nombre PnP", lista[i].pnp)
            fin
            si lista[i].bus = BUS_ACPI y lista[i].dirección <> 0 entonces línea(d, "En ACPI", lista[i].nombre) fin
            si acpi_de[i] <> SIN_PADRE entonces línea(d, "En ACPI", lista[acpi_de[i]].nombre) fin
            si lista[i].padre <> SIN_PADRE y lista[i].padre < n entonces
                nombre_de(lista[i].padre, v, 200)
                línea(d, "Cuelga de", v)
            fin
        sino
            si lista[i].irq <> SIN_IRQ entonces
                dd[0] := lista[i].irq
                formatear(v, 200, "%u", dd)
                línea(d, "Interrupción (IRQ)", v)
            sino si lista[i].bus = BUS_PCI y lista[i].dato1 <> 0 entonces
                línea(d, "Interrupción (IRQ)", "sin poner por la BIOS")
            fin
            a := i
            ; (lo de siempre que ACPI declara: sus recursos, de ahí, si no tiene)
            si lista[i].n_recursos = 0 y acpi_de[i] <> SIN_PADRE entonces a := acpi_de[i] fin
            para k desde 1 hasta lista[a].n_recursos hacer
                tamaño_texto(lista[a].recursos[k - 1].largo, z)
                dd[0] := lista[a].recursos[k - 1].base
                dd[1] := lista[a].recursos[k - 1].base + lista[a].recursos[k - 1].largo - 1
                dd[2] := nat32(dirección(z[0]))
                si lista[a].recursos[k - 1].clase = REC_PUERTOS entonces
                    si lista[a].recursos[k - 1].largo > 1 entonces formatear(v, 200, "%04X-%04X%s", dd) sino formatear(v, 200, "%04X", dd) fin
                    línea(d, "Puertos", v)
                sino si lista[a].recursos[k - 1].clase = REC_MEMORIA64 entonces
                    formatear(v, 200, "por encima de 4 GB (...%08X)", dd)
                    línea(d, "Memoria", v)
                sino
                    si lista[a].recursos[k - 1].largo > 0 entonces formatear(v, 200, "%08X-%08X%s", dd) sino formatear(v, 200, "%08X", dd) fin
                    línea(d, "Memoria", v)
                fin
            fin
            si d[0] = 0 entonces línea(d, "Recursos", "ninguno que se sepa") fin
        fin
    fin

    ; -------------------------------------------------------------------------
    ;  El informe (para Carlos: qué tiene cada portátil del taller)
    ; -------------------------------------------------------------------------
    función añade_inf(s: puntero a byte)
        si longitud(informe) + longitud(s) + 2 < CABE_INFORME entonces concatenar(informe, s) fin
    fin

    ; la ficha, sangrada, al informe
    función ficha_al_informe(i: nat32)
        variable parte, k, j: nat32
        variable r: arreglo [240] de byte
        para parte desde 0 hasta 2 hacer
            ficha_de(i, parte, ficha_t)
            k := 0
            mientras ficha_t[k] <> 0 hacer
                Textos32.copiar(r, "       ")
                j := longitud(r)
                mientras ficha_t[k] <> 0 y ficha_t[k] <> '\n' y j < 236 hacer
                    si ficha_t[k] = '\t' entonces
                        r[j] := ':'
                        r[j + 1] := ' '
                        j := j + 2
                    sino
                        r[j] := ficha_t[k]
                        j := j + 1
                    fin
                    k := k + 1
                fin
                r[j] := '\n'
                r[j + 1] := 0
                si ficha_t[k] = '\n' entonces k := k + 1 fin
                ; (en General el tipo ya va en la cabecera)
                si no empieza_por(r, "       Tipo:") entonces añade_inf(r) fin
            fin
        fin
    fin

    función haz_informe()
        variable c, i, f, h: nat32
        variable nom: arreglo [80] de byte
        variable id: arreglo [24] de byte
        informe[0] := 0
        añade_inf("Administrador de dispositivos de Hispa-Pentium\n")
        nombre_equipo(nom, 80)
        f := dato(DATO_FECHA)
        dd[0] := nat32(dirección(nom[0]))
        si nom[0] = 0 entonces dd[0] := nat32("(sin nombre)") fin
        dd[1] := (f >> 16) yb 31
        dd[2] := (f >> 21) yb 15
        dd[3] := ((f >> 25) yb 127) + 1980
        dd[4] := (f >> 11) yb 31
        dd[5] := (f >> 5) yb 63
        formatear(t, 200, "Equipo: %s   Fecha: %02u/%02u/%u %02u:%02u\n", dd)
        añade_inf(t)
        dd[0] := dato(DATO_MARCOS) * 4 div 1024
        dd[1] := dato(DATO_ANCHO_PANTALLA)
        dd[2] := dato(DATO_ALTO_PANTALLA)
        h := dato(DATO_VERSIÓN)
        dd[3] := (h >> 8) yb 0xFF
        dd[4] := h yb 0xFF
        formatear(t, 200, "Memoria: %u MB   Pantalla: %u x %u   Núcleo: %u.%u\n", dd)
        añade_inf(t)
        dd[0] := n - cuenta_ocultos()
        dd[1] := cuenta(EST_FUNCIONA) + cuenta(EST_NO_HACE_FALTA)
        dd[2] := cuenta(EST_SIN_CONTROLADOR)
        dd[3] := cuenta(EST_ERROR)
        dd[4] := cuenta(EST_APAGADO)
        formatear(t, 200, "Resumen: %u dispositivos; %u funcionan, %u SIN CONTROLADOR, %u CON ERROR, %u desactivados.\n", dd)
        añade_inf(t)
        ; lo que falta, lo primero
        si dd[2] + dd[3] <> 0 entonces
            añade_inf("\nLo que falta (sin controlador o con error):\n")
            para i desde 0 hasta n - 1 hacer
                si no oculto[i] y (lista[i].estado = EST_SIN_CONTROLADOR o lista[i].estado = EST_ERROR) entonces
                    nombre_de(i, nom, 80)
                    identificador(i, id)
                    opción_de(CATEGORÍAS, categoría(i), t2, 200)
                    dd[0] := nat32(marca_informe(lista[i].estado))
                    dd[1] := nat32(dirección(nom[0]))
                    dd[2] := nat32(dirección(id[0]))
                    dd[3] := nat32(dirección(t2[0]))
                    formatear(t, 200, "  %s %s  [%s; %s]\n", dd)
                    añade_inf(t)
                fin
            fin
        fin
        para c desde 0 hasta N_CAT - 1 hacer
            h := 0
            para i desde 0 hasta n - 1 hacer
                si no oculto[i] y categoría(i) = c entonces
                    si h = 0 entonces
                        opción_de(CATEGORÍAS, c, t2, 200)
                        dd[0] := nat32(dirección(t2[0]))
                        formatear(t, 200, "\n== %s ==\n", dd)
                        añade_inf(t)
                    fin
                    h := h + 1
                    nombre_de(i, nom, 80)
                    identificador(i, id)
                    dd[0] := nat32(marca_informe(lista[i].estado))
                    dd[1] := nat32(dirección(nom[0]))
                    dd[2] := nat32(dirección(id[0]))
                    si id[0] <> 0 entonces formatear(t, 200, "  %s %s  [%s]\n", dd) sino formatear(t, 200, "  %s %s\n", dd) fin
                    añade_inf(t)
                    ficha_al_informe(i)
                fin
            fin
        fin
        si longitud(informe) + 80 >= CABE_INFORME entonces añade_inf("\n(el informe no cabe entero)\n") fin
    fin

    función cuenta_ocultos(): nat32
        variable i, c: nat32
        c := 0
        para i desde 0 hasta n - 1 hacer
            si oculto[i] entonces c := c + 1 fin
        fin
        devolver c
    fin

    ; escribe el informe en ese archivo (con los finales de línea del DOS)
    función guarda_en(ruta: puntero a byte): nat32
        variable m, i, k, r: nat32
        variable trozo: arreglo [512] de byte
        m := crear(ruta)
        si es_error(m) entonces devolver m fin
        i := 0
        k := 0
        mientras informe[i] <> 0 hacer
            si informe[i] = '\n' entonces
                trozo[k] := '\r'
                k := k + 1
            fin
            trozo[k] := informe[i]
            k := k + 1
            i := i + 1
            si k >= 500 entonces
                r := escribir_archivo(m, trozo, k)
                si r <> k entonces
                    cerrar(m)
                    devolver DISCO_LLENO
                fin
                k := 0
            fin
        fin
        si k > 0 entonces
            r := escribir_archivo(m, trozo, k)
            si r <> k entonces
                cerrar(m)
                devolver DISCO_LLENO
            fin
        fin
        cerrar(m)
        devolver 0
    fin

    ; adónde va el informe: X:\DISPOSIT.TXT, o la primera memoria USB, o el
    ; primer disco en los que se pueda escribir (en «ruta»; falso si ninguno)
    función dónde_guardar(ruta: puntero a byte): bool
        variable u: Info_unidad
        variable k, vuelta: nat32
        para vuelta desde 0 hasta 2 hacer
            k := 0
            mientras info_unidad(k, u) hacer
                si u.letra <> 0 y u.solo_lectura = 0 y u.clase <> 1 y u.clase <> 0 entonces
                    si (vuelta = 0 y u.letra = 'X') o (vuelta = 1 y u.medio = MEDIO_USB) o vuelta = 2 entonces
                        ruta[0] := u.letra
                        ruta[1] := 0
                        concatenar(ruta, ":\\DISPOSIT.TXT")
                        devolver cierto
                    fin
                fin
                k := k + 1
            fin
        fin
        devolver falso
    fin

    función guarda(ruta_dada: puntero a byte)
        variable ruta: arreglo [100] de byte
        variable r: nat32
        si ruta_dada <> nulo y ruta_dada[0] <> 0 entonces
            copiar_hasta(ruta, ruta_dada, 100)
        sino si no dónde_guardar(ruta) entonces
            Textos32.copiar(aviso, "No hay ninguna unidad en la que se pueda escribir (arranque con «escritura=usb»).")
            devolver
        fin
        haz_informe()
        r := guarda_en(ruta)
        si es_error(r) entonces
            dd[0] := nat32(dirección(ruta[0]))
            dd[1] := nat32(texto_error(r))
            formatear(aviso, 120, "No se puede guardar en %s: %s.", dd)
        sino
            dd[0] := nat32(dirección(ruta[0]))
            formatear(aviso, 120, "Informe guardado en %s", dd)
        fin
    fin

    función copia()
        haz_informe()
        si al_portapapeles(informe, longitud(informe)) entonces
            dd[0] := longitud(informe)
            formatear(aviso, 120, "Informe copiado al portapapeles (%u letras)", dd)
        sino
            Textos32.copiar(aviso, "No se ha podido copiar al portapapeles")
        fin
    fin

    ; =========================================================================
    ;  (INFORME-DISP, 0.8.12) «Enviar informe de los dispositivos que fallan»
    ;
    ;  Lo que se manda (un texto, UTF-8 con los \r\n del DOS; el mismo que se
    ;  enseña antes y que se guarda en los Documentos, INFDISP.TXT): la versión
    ;  de Hispa-Pentium y de cada paquete, el equipo (la ficha del SMBIOS: el
    ;  fabricante, el modelo y la BIOS, que da el núcleo sin el número de serie
    ;  ni el UUID: la 226, 8), el procesador, la memoria, la lista de todo con
    ;  su identificador y su estado y, de cada cosa que falla (sin controlador
    ;  o con error), dónde está, su ficha, qué controlador se ha intentado y
    ;  las líneas de ARRANQUE.TXT, RED.LOG, WIFI.LOG y BT.LOG que tocan a ese
    ;  aparato (por su identificador, su sitio en el PCI o su ruta de ACPI; de
    ;  la tarjeta Wi-Fi, del cable y del Bluetooth, también lo último de su
    ;  registro). Cada línea pasa por sanea(): fuera las que puedan llevar
    ;  una clave (contraseñas, PSK, testigos, galletas...), el número de serie,
    ;  el UUID o la MSDM; los nombres de las redes («...» en lo del Wi-Fi y del
    ;  Bluetooth), las MAC y los BSSID solo con su fabricante (los 3 primeros
    ;  octetos), las IP públicas, las rutas que no son del sistema (los
    ;  documentos, las carpetas de los usuarios), los nombres de los usuarios
    ;  y el del equipo. Ninguna tabla de ACPI. «<» y «>», como «(» y «)» (el
    ;  servidor no admite «<»: ni HTML ni PHP).
    ;  Lo recibe tools/informe-disp/informe.php (https://hispados.es/informe/
    ;  enviar.php), que contesta «OK número» o «ERROR motivo». No cambia nada
    ;  del sistema: lo puede hacer un usuario normal.
    ; =========================================================================
    constante SERVIDOR_INFORME = "https://hispados.es/informe/enviar.php"
    constante PRIMERA_LÍNEA = "Hispa-Pentium: informe de los dispositivos que fallan"
    constante CABE_ENVÍO = 32000
    constante CABE_UTF8 = 64000                ; (lo más que da la 437: dos octetos por letra)
    constante MAX_LÍN = 4000
    constante MAX_OCULTAR = 12
    constante CABE_MEM = 16384
    constante MAX_POR_FUENTE = 40              ; las líneas de un registro, por aparato
    constante ÚLTIMAS = 30                     ; lo último del registro de la Wi-Fi / del Bluetooth
    constante F_ARRANQUE = 0
    constante F_RED = 1
    constante F_WIFI = 2
    constante F_BT = 3
    constante V_ÁRBOL = 0
    constante V_VISTA = 1
    constante V_RESULTADO = 2
    ; (las palabras que, si salen en una línea, la quitan entera)
    constante QUITAR = "clave|contrase|password|passwd|passphrase|psk|pmk|ptk|gtk|secret|token|testigo|cookie|galleta|msdm|slic|uuid|serial|de serie|nº serie|n.º serie|número de serie|sku"

    variable envío: arreglo [CABE_ENVÍO] de byte           ; en la 437, con \r\n
    variable envío_lleno: bool
    variable envío_utf8: arreglo [CABE_UTF8] de byte
    variable n_utf8: nat32
    variable respuesta: arreglo [1024] de byte
    variable servidor: arreglo [200] de byte
    variable modo_v: nat32
    variable lín_ini: arreglo [MAX_LÍN] de nat32           ; (la vista) dónde empieza cada renglón
    variable lín_n: arreglo [MAX_LÍN] de nat32             ; y cuánto lleva
    variable n_lín, primera, cols_vista: nat32
    variable resultado: arreglo [300] de byte
    variable resultado2: arreglo [300] de byte
    variable fue_enviado: bool
    variable copia_en: arreglo [120] de byte
    variable ocultar: arreglo [MAX_OCULTAR] de arreglo [32] de byte
    variable n_ocultar: nat32
    variable letra_sistema: byte
    variable sa: arreglo [520] de byte                     ; la línea saneada
    variable sm: arreglo [520] de byte                     ; en minúsculas (para buscar)
    variable sx: arreglo [520] de byte
    ; el registro que se lee (un archivo, o lo de la memoria)
    variable rf_m: nat32
    variable rf_en_memoria: bool
    variable mem_reg: arreglo [CABE_MEM] de byte
    variable mem_n, mem_i: nat32
    variable rb: arreglo [4096] de byte
    variable rb_n, rb_i: nat32
    variable rl: arreglo [520] de byte
    variable rf_nombre: arreglo [40] de byte
    variable anillo: arreglo [ÚLTIMAS] de arreglo [200] de byte
    variable anillo_ya: arreglo [ÚLTIMAS] de bool
    variable smb: arreglo [1100] de byte
    variable vista_al: ent32

    ; ---- poner líneas en el informe ----
    función env_pon(s: puntero a byte)
        si envío_lleno entonces devolver fin
        si longitud(envío) + longitud(s) + 64 >= CABE_ENVÍO entonces
            concatenar(envío, "(el informe no cabe entero: aquí se corta)\r\n")
            envío_lleno := cierto
            devolver
        fin
        concatenar(envío, s)
    fin

    ; una línea nuestra, tal cual (sin sanear: los textos fijos del informe)
    función env_fijo(s: puntero a byte)
        env_pon(s)
        env_pon("\r\n")
    fin

    ; una línea, saneada, con su \r\n (las que no pasan, no van)
    función env_línea(s: puntero a byte)
        si sanea(s, F_ARRANQUE, falso) entonces
            env_pon(sa)
            env_pon("\r\n")
        fin
    fin

    ; ---- sanear ----
    función en_minúsculas(d: puntero a byte, t: puntero a byte)
        variable i: nat32
        i := 0
        mientras t[i] <> 0 y i < 515 hacer
            d[i] := minúscula(t[i])
            i := i + 1
        fin
        d[i] := 0
    fin

    función es_hex(c: byte): bool
        devolver (c >= '0' y c <= '9') o (c >= 'a' y c <= 'f') o (c >= 'A' y c <= 'F')
    fin

    función es_díg(c: byte): bool
        devolver c >= '0' y c <= '9'
    fin

    ; ¿lleva alguna de las palabras de QUITAR (sm, en minúsculas)?
    función lleva_palabra_mala(): bool
        variable k: nat32
        variable p: arreglo [24] de byte
        k := 0
        mientras cierto hacer
            opción_de(QUITAR, k, p, 24)
            si p[0] = 0 entonces devolver falso fin
            si buscar(sm, p) <> nulo entonces devolver cierto fin
            k := k + 1
        fin
        devolver falso
    fin

    ; ¿una MAC (o un BSSID) en t[i]? «hh:hh:hh:hh:hh:hh» (o con «-»)
    función es_mac(t: puntero a byte, i: nat32): bool
        variable k: nat32
        variable sep: byte
        para k desde 0 hasta 16 hacer
            si t[i + k] = 0 entonces devolver falso fin
        fin
        si i > 0 y (es_hex(t[i - 1]) o t[i - 1] = ':' o t[i - 1] = '-') entonces devolver falso fin
        sep := t[i + 2]
        si sep <> ':' y sep <> '-' entonces devolver falso fin
        para k desde 0 hasta 5 hacer
            si no es_hex(t[i + k * 3]) o no es_hex(t[i + k * 3 + 1]) entonces devolver falso fin
            si k < 5 y t[i + k * 3 + 2] <> sep entonces devolver falso fin
        fin
        si es_hex(t[i + 17]) o t[i + 17] = sep entonces devolver falso fin
        devolver cierto
    fin

    ; ¿una IPv4 en t[i]? su largo (0: no) y sus cuatro números
    función es_ip(t: puntero a byte, i: nat32, cu: puntero a nat32): nat32
        variable k, j, v, cifras: nat32
        si i > 0 y (es_díg(t[i - 1]) o t[i - 1] = '.') entonces devolver 0 fin
        j := i
        para k desde 0 hasta 3 hacer
            v := 0
            cifras := 0
            mientras es_díg(t[j]) y cifras < 4 hacer
                v := v * 10 + nat32(t[j] - '0')
                j := j + 1
                cifras := cifras + 1
            fin
            si cifras = 0 o cifras > 3 o v > 255 entonces devolver 0 fin
            cu[k] := v
            si k < 3 entonces
                si t[j] <> '.' entonces devolver 0 fin
                j := j + 1
            fin
        fin
        si es_díg(t[j]) o (t[j] = '.' y es_díg(t[j + 1])) entonces devolver 0 fin
        devolver j - i
    fin

    función ip_privada(cu: puntero a nat32): bool
        si cu[0] = 10 o cu[0] = 127 o cu[0] = 0 entonces devolver cierto fin
        si cu[0] = 192 y cu[1] = 168 entonces devolver cierto fin
        si cu[0] = 172 y cu[1] >= 16 y cu[1] <= 31 entonces devolver cierto fin
        si cu[0] = 169 y cu[1] = 254 entonces devolver cierto fin
        si cu[0] = 255 y cu[1] = 255 y cu[2] = 255 y cu[3] = 255 entonces devolver cierto fin
        si cu[0] = 255 y cu[1] = 255 entonces devolver cierto fin      ; (las máscaras)
        devolver falso
    fin

    ; ¿dónde acaba una ruta que empieza en t[i]?
    función fin_de_ruta(t: puntero a byte, i: nat32): nat32
        mientras t[i] <> 0 y t[i] <> ' ' y t[i] <> 0xAF y t[i] <> 0xAE y t[i] <> '"' y t[i] <> 39 y t[i] <> ',' y t[i] <> ';' y t[i] <> ')' y t[i] <> '(' y t[i] <> '<' y t[i] <> '>' y t[i] <> 9 hacer
            i := i + 1
        fin
        devolver i
    fin

    ; ¿es de las del sistema (la ruta t[i..j))? «X:\HISPA\...» o un archivo de la raíz
    función ruta_del_sistema(t: puntero a byte, i: nat32, j: nat32): bool
        variable k, barras: nat32
        variable u: arreglo [12] de byte
        k := 0
        mientras k < 9 y i + k < j hacer
            u[k] := mayúscula(t[i + k])
            k := k + 1
        fin
        u[k] := 0
        si empieza_por(dirección(u[1]), ":\\HISPA\\") o iguales(dirección(u[1]), ":\\HISPA") entonces devolver cierto fin
        barras := 0
        para k desde i hasta j - 1 hacer
            si t[k] = '\\' entonces barras := barras + 1 fin
        fin
        devolver barras <= 1
    fin

    ; cambia en sa lo que va entre «» por «(quitado)»
    función quita_comillas()
        variable i, j: nat32
        i := 0
        j := 0
        mientras sa[i] <> 0 hacer
            sx[j] := sa[i]
            j := j + 1
            si sa[i] = 0xAE entonces
                i := i + 1
                mientras sa[i] <> 0 y sa[i] <> 0xAF hacer i := i + 1 fin
                Textos32.copiar(dirección(sx[j]), "(quitado)")
                j := j + 9
                si sa[i] = 0xAF entonces
                    sx[j] := 0xAF
                    j := j + 1
                    i := i + 1
                fin
            sino
                i := i + 1
            fin
            si j > 500 entonces romper fin
        fin
        sx[j] := 0
        Textos32.copiar(sa, sx)
    fin

    ; cambia en sa cada uno de los nombres de «ocultar» (sin mirar la caja) por «(nombre)»
    función quita_nombres()
        variable k, i, j, n: nat32
        variable p: puntero a byte
        para k desde 1 hasta n_ocultar hacer
            n := longitud(ocultar[k - 1])
            en_minúsculas(sm, sa)
            p := buscar(sm, ocultar[k - 1])
            mientras p <> nulo hacer
                i := nat32(p) - nat32(dirección(sm[0]))
                j := 0
                mientras j < i hacer
                    sx[j] := sa[j]
                    j := j + 1
                fin
                sx[j] := 0
                concatenar(sx, "(nombre)")
                concatenar(sx, dirección(sa[i + n]))
                copiar_hasta(sa, sx, 510)
                en_minúsculas(sm, sa)
                p := buscar(sm, ocultar[k - 1])
            fin
        fin
    fin

    ; sanea la línea t (de la fuente f) en sa; falso si no puede ir. Con
    ; «de_red», lo de entre «» se quita (los nombres de las redes)
    función sanea(t: puntero a byte, f: nat32, de_red: bool): bool
        variable i, j, n, k: nat32
        variable cu: arreglo [4] de nat32
        variable c: byte
        en_minúsculas(sm, t)
        si lleva_palabra_mala() entonces devolver falso fin
        ; (el nombre de una red sin comillas: fuera la línea; un BSSID sí va, cortado)
        si buscar(sm, "ssid") <> nulo y buscar(sm, "bssid") = nulo entonces devolver falso fin
        si f = F_WIFI o f = F_BT o buscar(sm, "wifi") <> nulo o buscar(sm, "wi-fi") <> nulo o buscar(sm, "ssid") <> nulo o buscar(sm, "bluetooth") <> nulo o buscar(sm, "red \xAE") <> nulo entonces de_red := cierto fin
        i := 0
        j := 0
        mientras t[i] <> 0 y j < 500 hacer
            c := t[i]
            si es_hex(c) y es_mac(t, i) entonces
                para k desde 0 hasta 7 hacer sa[j + k] := t[i + k] fin
                j := j + 8
                sa[j] := t[i + 2]
                sa[j + 1] := 'x'
                sa[j + 2] := 'x'
                sa[j + 3] := t[i + 2]
                sa[j + 4] := 'x'
                sa[j + 5] := 'x'
                sa[j + 6] := t[i + 2]
                sa[j + 7] := 'x'
                sa[j + 8] := 'x'
                j := j + 9
                i := i + 17
            sino si es_díg(c) y es_ip(t, i, cu) > 0 entonces
                n := es_ip(t, i, cu)
                si ip_privada(cu) entonces
                    para k desde 0 hasta n - 1 hacer sa[j + k] := t[i + k] fin
                    j := j + n
                sino
                    sa[j] := 0
                    concatenar(sa, "(IP pública)")
                    j := longitud(sa)
                fin
                i := i + n
            sino si es_letra(c) y t[i + 1] = ':' y t[i + 2] = '\\' entonces
                n := fin_de_ruta(t, i)
                si ruta_del_sistema(t, i, n) entonces
                    mientras i < n y j < 500 hacer
                        sa[j] := t[i]
                        i := i + 1
                        j := j + 1
                    fin
                sino
                    sa[j] := 0
                    concatenar(sa, "(ruta)")
                    j := longitud(sa)
                    i := n
                fin
            sino si c = '\\' y (empieza_por(dirección(sm[i]), "\\usuarios") o empieza_por(dirección(sm[i]), "\\document")) entonces
                sa[j] := 0
                concatenar(sa, "(ruta)")
                j := longitud(sa)
                i := fin_de_ruta(t, i)
            sino
                si c = '<' entonces c := '(' fin
                si c = '>' entonces c := ')' fin
                si c < 32 entonces c := ' ' fin
                sa[j] := c
                j := j + 1
                i := i + 1
            fin
        fin
        sa[j] := 0
        si de_red entonces quita_comillas() fin
        quita_nombres()
        devolver cierto
    fin

    ; los nombres que no deben salir: los de los usuarios y el del equipo
    función prepara_ocultar()
        variable f: Ficha_usuario
        variable i, k: nat32
        variable t3: arreglo [80] de byte
        n_ocultar := 0
        i := 0
        mientras n_ocultar + 2 < MAX_OCULTAR y i < 32 y ficha_usuario(i, f) hacer
            si longitud(f.nombre) >= 3 entonces
                en_minúsculas(t3, f.nombre)
                copiar_hasta(ocultar[n_ocultar], t3, 32)
                n_ocultar := n_ocultar + 1
            fin
            i := i + 1
        fin
        nombre_usuario(t3, 80)
        si longitud(t3) >= 3 y n_ocultar < MAX_OCULTAR entonces
            en_minúsculas(sm, t3)
            copiar_hasta(ocultar[n_ocultar], sm, 32)
            n_ocultar := n_ocultar + 1
        fin
        ; (el del equipo, salvo si es el fabricante o el modelo, «TOSHIBA»: eso ya va)
        nombre_equipo(t3, 80)
        en_minúsculas(sx, smb)
        en_minúsculas(sm, t3)
        si longitud(t3) >= 3 y n_ocultar < MAX_OCULTAR y buscar(sx, sm) = nulo entonces
            copiar_hasta(ocultar[n_ocultar], sm, 32)
            n_ocultar := n_ocultar + 1
        fin
        ; (los largos, antes: «portatil-de-maria» antes que «maria»)
        para i desde 1 hasta n_ocultar hacer
            para k desde 1 hasta n_ocultar - 1 hacer
                si longitud(ocultar[k]) > longitud(ocultar[k - 1]) entonces
                    Textos32.copiar(t3, ocultar[k])
                    Textos32.copiar(ocultar[k], ocultar[k - 1])
                    Textos32.copiar(ocultar[k - 1], t3)
                fin
            fin
        fin
    fin

    ; ---- la unidad del sistema ----
    función unidad_del_sistema(): byte
        variable u: Info_unidad
        variable k: nat32
        k := 0
        mientras info_unidad(k, u) hacer
            si u.del_sistema = 1 y u.letra <> 0 entonces devolver u.letra fin
            k := k + 1
        fin
        devolver 0
    fin

    ; «C:» y el resto (sin letra: tal cual)
    función en_sistema(d: puntero a byte, resto: puntero a byte)
        d[0] := 0
        si letra_sistema <> 0 entonces
            d[0] := letra_sistema
            d[1] := ':'
            d[2] := 0
        fin
        concatenar(d, resto)
    fin

    ; ---- leer un registro, línea a línea ----
    función rf_abre(ruta: puntero a byte): bool
        variable m: nat32
        m := abrir(ruta)
        si es_error(m) entonces devolver falso fin
        rf_m := m
        rf_en_memoria := falso
        rb_n := 0
        rb_i := 0
        devolver cierto
    fin

    función rf_lee_octeto(ref c: byte): bool
        variable k: nat32
        si rf_en_memoria entonces
            si mem_i >= mem_n entonces devolver falso fin
            c := mem_reg[mem_i]
            mem_i := mem_i + 1
            devolver cierto
        fin
        si rb_i >= rb_n entonces
            k := leer(rf_m, rb, 4096)
            si es_error(k) o k = 0 entonces devolver falso fin
            rb_n := k
            rb_i := 0
        fin
        c := rb[rb_i]
        rb_i := rb_i + 1
        devolver cierto
    fin

    ; la línea siguiente, a rl (sin \r\n; las largas, cortadas a 500): falso al acabar
    función rf_línea(): bool
        variable c: byte
        variable n: nat32
        variable algo: bool
        n := 0
        algo := falso
        mientras rf_lee_octeto(c) hacer
            algo := cierto
            si c = '\n' entonces romper fin
            si c <> '\r' y n < 500 entonces
                si c = 0 entonces c := ' ' fin
                rl[n] := c
                n := n + 1
            fin
        fin
        rl[n] := 0
        devolver algo
    fin

    función rf_cierra()
        si no rf_en_memoria y rf_m <> 0 entonces cerrar(rf_m) fin
        rf_m := 0
    fin

    ; abre la fuente f (el archivo, o lo que hay en la memoria): falso si no hay
    función abre_fuente(f: nat32): bool
        variable ruta: arreglo [40] de byte
        rf_m := 0
        según nat16(f)
            caso F_ARRANQUE:
                Textos32.copiar(rf_nombre, "ARRANQUE.TXT")
                en_sistema(ruta, "\\ARRANQUE.TXT")
                si rf_abre(ruta) entonces devolver cierto fin
                mem_n := registro_del_arranque(mem_reg, CABE_MEM)
                si es_error(mem_n) o mem_n = 0 entonces devolver falso fin
                Textos32.copiar(rf_nombre, "registro del arranque")
            caso F_RED:
                Textos32.copiar(rf_nombre, "RED.LOG")
                en_sistema(ruta, "\\HISPA\\RED.LOG")
                si rf_abre(ruta) entonces devolver cierto fin
                en_sistema(ruta, "\\RED.LOG")
                si rf_abre(ruta) entonces devolver cierto fin
                si estado_rápido(mem_i) = RED_NADA entonces devolver falso fin
                mem_n := registro_red(mem_reg, CABE_MEM)
                si es_error_red(mem_n) o mem_n = 0 entonces devolver falso fin
                Textos32.copiar(rf_nombre, "RED.BIN")
            caso F_WIFI:
                Textos32.copiar(rf_nombre, "WIFI.LOG")
                en_sistema(ruta, "\\HISPA\\WIFI.LOG")
                si rf_abre(ruta) entonces devolver cierto fin
                en_sistema(ruta, "\\WIFI.LOG")
                devolver rf_abre(ruta)
            si no:
                Textos32.copiar(rf_nombre, "BT.LOG")
                en_sistema(ruta, "\\HISPA\\BT.LOG")
                si rf_abre(ruta) entonces devolver cierto fin
                en_sistema(ruta, "\\BT.LOG")
                devolver rf_abre(ruta)
        fin
        si mem_n > CABE_MEM entonces mem_n := CABE_MEM fin
        rf_en_memoria := cierto
        mem_i := 0
        devolver cierto
    fin

    ; ¿toca la línea (sx, en mayúsculas) al aparato i?
    función toca(i: nat32): bool
        variable k: arreglo [80] de byte
        variable a: nat32
        identificador(i, k)
        a_mayúsculas(k)
        si longitud(k) >= 4 y buscar(sx, k) <> nulo entonces devolver cierto fin
        si lista[i].bus = BUS_PCI entonces
            a := lista[i].dirección
            dd[0] := (a >> 16) yb 0xFF
            dd[1] := (a >> 11) yb 0x1F
            dd[2] := (a >> 8) yb 7
            formatear(k, 80, "%02X:%02X.%u", dd)
            si buscar(sx, k) <> nulo entonces devolver cierto fin
        fin
        si lista[i].bus = BUS_ACPI y lista[i].nombre[0] = '\\' y longitud(lista[i].nombre) >= 6 entonces
            copiar_hasta(k, lista[i].nombre, 80)
            a_mayúsculas(k)
            si buscar(sx, k) <> nulo entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; lo de la fuente f que toca al aparato i, al informe; con «últimas», también
    ; lo último del registro (las que no hayan salido ya). Cuántas ha puesto
    función líneas_de(f: nat32, i: nat32, últimas: nat32): nat32
        variable puestas, más, k, a, total: nat32
        variable pre: arreglo [48] de byte
        si no abre_fuente(f) entonces devolver 0 fin
        puestas := 0
        más := 0
        a := 0
        total := 0
        para k desde 0 hasta ÚLTIMAS - 1 hacer
            anillo[k][0] := 0
            anillo_ya[k] := falso
        fin
        dd[0] := nat32(dirección(rf_nombre[0]))
        formatear(pre, 48, "       %s: ", dd)
        mientras rf_línea() hacer
            Textos32.copiar(sx, rl)
            a_mayúsculas(sx)
            k := 0
            si toca(i) entonces
                si puestas < MAX_POR_FUENTE entonces
                    si sanea(rl, f, falso) entonces
                        env_pon(pre)
                        env_pon(sa)
                        env_pon("\r\n")
                        puestas := puestas + 1
                    fin
                sino
                    más := más + 1
                fin
                k := 1
            fin
            si últimas > 0 entonces
                copiar_hasta(anillo[a], rl, 200)
                anillo_ya[a] := k = 1
                a := (a + 1) mod últimas
                total := total + 1
            fin
        fin
        rf_cierra()
        si más > 0 entonces
            dd[0] := más
            formatear(sx, 120, "       (y %u líneas más que lo nombran)\r\n", dd)
            env_pon(sx)
        fin
        si últimas > 0 y total > 0 entonces
            dd[0] := nat32(dirección(rf_nombre[0]))
            dd[1] := últimas
            formatear(sx, 160, "       Lo último de %s (hasta %u líneas):\r\n", dd)
            env_pon(sx)
            si total < últimas entonces a := 0 fin
            para k desde 0 hasta últimas - 1 hacer
                si anillo[a][0] <> 0 y no anillo_ya[a] y sanea(anillo[a], f, falso) entonces
                    env_pon("         ")
                    env_pon(sa)
                    env_pon("\r\n")
                    puestas := puestas + 1
                fin
                a := (a + 1) mod últimas
            fin
        fin
        devolver puestas
    fin

    ; ¿qué es? (para lo último de su registro)
    función es_wifi(i: nat32): bool
        variable nom: arreglo [80] de byte
        si lista[i].bus = BUS_PCI y (lista[i].clase >> 8) = 0x0280 entonces devolver cierto fin
        nombre_de(i, nom, 80)
        devolver buscar(nom, "Wi-Fi") <> nulo o buscar(nom, "WLAN") <> nulo
    fin

    función es_bt(i: nat32): bool
        variable nom: arreglo [80] de byte
        si lista[i].bus = BUS_USB y (lista[i].clase >> 16) = 0xE0 entonces devolver cierto fin
        si lista[i].bus = BUS_PCI y (lista[i].clase >> 8) = 0x0D11 entonces devolver cierto fin
        nombre_de(i, nom, 80)
        devolver buscar(nom, "Bluetooth") <> nulo
    fin

    función es_cable(i: nat32): bool
        devolver lista[i].bus = BUS_PCI y (lista[i].clase >> 8) = 0x0200
    fin

    ; ---- las partes del informe ----
    ; la versión de Hispa-Pentium y la de cada paquete instalado
    función env_versiones()
        variable m, k, i, n, pq: nat32
        variable e: Entrada
        variable ruta: arreglo [64] de byte
        variable cab: arreglo [1024] de byte
        variable nom: arreglo [16] de byte
        variable ver: arreglo [20] de byte
        variable p: puntero a byte
        variable lin: arreglo [300] de byte
        dd[0] := (dato(DATO_VERSIÓN) >> 8) yb 0xFF
        dd[1] := dato(DATO_VERSIÓN) yb 0xFF
        k := dato(DATO_ARREGLO)
        si es_error(k) entonces k := 0 fin
        dd[2] := k
        formatear(t, 200, "Hispa-Pentium: %u.%u.%u", dd)
        si sistema_instalado() entonces concatenar(t, " (instalado en el disco)") sino concatenar(t, " (arrancado de una memoria o un CD)") fin
        env_línea(t)
        en_sistema(ruta, "\\HISPA\\PAQUETES")
        m := abrir(ruta)
        si es_error(m) entonces
            env_línea("Paquetes: ninguno instalado (no hay \\HISPA\\PAQUETES)")
            devolver
        fin
        Textos32.copiar(lin, "Paquetes:")
        pq := 0
        mientras entrada(m, e) hacer
            n := longitud(e.nombre)
            si e.atributos yb CARPETA = 0 y n > 4 y iguales(dirección(e.nombre[n - 4]), ".PQI") entonces
                en_sistema(ruta, "\\HISPA\\PAQUETES\\")
                concatenar(ruta, e.nombre)
                nom[0] := 0
                ver[0] := 0
                k := abrir(ruta)
                si no es_error(k) entonces
                    n := leer(k, cab, 1000)
                    cerrar(k)
                    si es_error(n) entonces n := 0 fin
                    cab[n] := 0
                    ; «nombre=...» y «version=...» de la cabecera
                    p := buscar(cab, "\nnombre=")
                    si p <> nulo entonces
                        i := 0
                        mientras p[8 + i] >= 32 y i < 14 hacer
                            nom[i] := p[8 + i]
                            i := i + 1
                        fin
                        nom[i] := 0
                    fin
                    p := buscar(cab, "\nversion=")
                    si p <> nulo entonces
                        i := 0
                        mientras p[9 + i] >= 32 y i < 18 hacer
                            ver[i] := p[9 + i]
                            i := i + 1
                        fin
                        ver[i] := 0
                    fin
                fin
                si nom[0] <> 0 entonces
                    si longitud(lin) + longitud(nom) + longitud(ver) + 4 > 76 entonces
                        env_línea(lin)
                        Textos32.copiar(lin, "         ")
                    fin
                    si pq > 0 y lin[longitud(lin) - 1] <> ' ' entonces concatenar(lin, ",") fin
                    concatenar(lin, " ")
                    concatenar(lin, nom)
                    concatenar(lin, " ")
                    concatenar(lin, ver)
                    pq := pq + 1
                fin
            fin
        fin
        cerrar(m)
        si pq = 0 entonces concatenar(lin, " ninguno instalado") fin
        env_línea(lin)
    fin

    ; un valor de la ficha del SMBIOS («clave=texto»), a d (vacío si no está)
    función de_smbios(clave: puntero a byte, d: puntero a byte)
        variable p: puntero a byte
        variable i, n: nat32
        variable pat: arreglo [32] de byte
        d[0] := 0
        pat[0] := '\n'
        pat[1] := 0
        concatenar(pat, clave)
        concatenar(pat, "=")
        p := buscar(smb, pat)
        si p = nulo entonces devolver fin
        n := longitud(pat)
        i := 0
        mientras p[n + i] <> '\n' y p[n + i] <> 0 y i < 70 hacer
            d[i] := p[n + i]
            i := i + 1
        fin
        d[i] := 0
    fin

    función env_smbios_uno(rótulo: puntero a byte, clave: puntero a byte)
        variable v: arreglo [80] de byte
        de_smbios(clave, v)
        si v[0] = 0 entonces devolver fin
        dd[0] := nat32(rótulo)
        dd[1] := nat32(dirección(v[0]))
        formatear(t, 200, "  %s: %s", dd)
        env_fijo(t)
    fin

    función env_equipo()
        variable r, i: nat32
        variable a, b, c: arreglo [80] de byte
        smb[0] := '\n'
        r := ficha_del_equipo(dirección(smb[1]), 1090)
        si es_error(r) entonces
            env_línea("Equipo (SMBIOS): este núcleo no lo dice (hace falta la base 0.8.12)")
            devolver
        fin
        si r = 0 entonces
            env_línea("Equipo (SMBIOS): no hay SMBIOS (el equipo no lo trae, o no se encuentra)")
            devolver
        fin
        ; (la 437 de casa: lo del SMBIOS va en ASCII; lo raro ya viene como «?»)
        para i desde 1 hasta r hacer
            si smb[i] = '<' entonces smb[i] := '(' fin
            si smb[i] = '>' entonces smb[i] := ')' fin
        fin
        env_fijo("Equipo (SMBIOS; sin el número de serie ni el UUID):")
        env_smbios_uno("Fabricante", "fabricante")
        env_smbios_uno("Modelo", "modelo")
        env_smbios_uno("Versión", "version")
        env_smbios_uno("Familia", "familia")
        de_smbios("placa_fabricante", a)
        de_smbios("placa_modelo", b)
        de_smbios("placa_version", c)
        si a[0] <> 0 o b[0] <> 0 entonces
            dd[0] := nat32(dirección(a[0]))
            dd[1] := nat32(dirección(b[0]))
            dd[2] := nat32(dirección(c[0]))
            formatear(t, 200, "  Placa: %s %s %s", dd)
            env_fijo(t)
        fin
        de_smbios("bios_fabricante", a)
        de_smbios("bios_version", b)
        de_smbios("bios_fecha", c)
        si a[0] <> 0 o b[0] <> 0 entonces
            dd[0] := nat32(dirección(a[0]))
            dd[1] := nat32(dirección(b[0]))
            dd[2] := nat32(dirección(c[0]))
            formatear(t, 200, "  BIOS: %s, versión %s, del %s", dd)
            env_fijo(t)
        fin
    fin

    ; la ficha (las tres pestañas) del aparato i, sangrada
    función env_ficha(i: nat32)
        variable parte, k, j: nat32
        variable r: arreglo [240] de byte
        para parte desde 0 hasta 2 hacer
            ficha_de(i, parte, ficha_t)
            k := 0
            mientras ficha_t[k] <> 0 hacer
                Textos32.copiar(r, "       ")
                j := longitud(r)
                mientras ficha_t[k] <> 0 y ficha_t[k] <> '\n' y j < 236 hacer
                    si ficha_t[k] = '\t' entonces
                        r[j] := ':'
                        r[j + 1] := ' '
                        j := j + 2
                    sino
                        r[j] := ficha_t[k]
                        j := j + 1
                    fin
                    k := k + 1
                fin
                r[j] := 0
                si ficha_t[k] = '\n' entonces k := k + 1 fin
                si no empieza_por(r, "       Tipo:") entonces env_línea(r) fin
            fin
        fin
    fin

    función falla(i: nat32): bool
        devolver no oculto[i] y (lista[i].estado = EST_SIN_CONTROLADOR o lista[i].estado = EST_ERROR)
    fin

    ; todo el informe, en «envío»
    función haz_envío()
        variable i, f, nf, h, puestas: nat32
        variable nom: arreglo [80] de byte
        variable id: arreglo [24] de byte
        variable dn: arreglo [120] de byte
        variable cpu_hecho: bool
        envío[0] := 0
        envío_lleno := falso
        letra_sistema := unidad_del_sistema()
        smb[0] := 0
        env_fijo(PRIMERA_LÍNEA)
        env_fijo("(Lo manda el Administrador de dispositivos, con «Enviar informe de los dispositivos que fallan». No lleva números de serie, ni el UUID, ni contraseñas, ni nombres de redes o de usuarios, ni rutas de documentos, ni IP públicas.)")
        f := dato(DATO_FECHA)
        dd[0] := (f >> 16) yb 31
        dd[1] := (f >> 21) yb 15
        dd[2] := ((f >> 25) yb 127) + 1980
        dd[3] := (f >> 11) yb 31
        dd[4] := (f >> 5) yb 63
        formatear(t, 200, "Fecha: %02u/%02u/%u %02u:%02u (la hora del equipo)", dd)
        env_línea(t)
        env_versiones()
        env_equipo()
        prepara_ocultar()
        cpu_hecho := falso
        para i desde 0 hasta n - 1 hacer
            si lista[i].bus = BUS_CPU y no cpu_hecho entonces
                nombre_de(i, nom, 80)
                fabricante(i, dn)
                dd[0] := nat32(dirección(nom[0]))
                dd[1] := nat32(dirección(dn[0]))
                formatear(t, 200, "Procesador: %s (%s)", dd)
                env_línea(t)
                cpu_hecho := cierto
            fin
        fin
        dd[0] := dato(DATO_MARCOS) * 4 div 1024
        dd[1] := dato(DATO_ANCHO_PANTALLA)
        dd[2] := dato(DATO_ALTO_PANTALLA)
        formatear(t, 200, "Memoria: %u MB   Pantalla: %u x %u", dd)
        env_línea(t)
        nf := cuenta(EST_SIN_CONTROLADOR) + cuenta(EST_ERROR)
        dd[0] := n - cuenta_ocultos()
        dd[1] := cuenta(EST_FUNCIONA) + cuenta(EST_NO_HACE_FALTA)
        dd[2] := cuenta(EST_SIN_CONTROLADOR)
        dd[3] := cuenta(EST_ERROR)
        dd[4] := cuenta(EST_APAGADO)
        formatear(t, 200, "Resumen: %u dispositivos; %u funcionan, %u SIN CONTROLADOR, %u CON ERROR, %u desactivados.", dd)
        env_línea(t)
        ; lo que falla, con todo lo suyo
        h := 0
        para i desde 0 hasta n - 1 hacer
            si falla(i) entonces h := h + 1 fin
        fin
        dd[0] := h
        formatear(t, 200, "== Lo que falla: %u ==", dd)
        env_pon("\r\n")
        env_fijo(t)
        si h = 0 entonces env_línea("  Nada: todo lo que se ve tiene su controlador.") fin
        para i desde 0 hasta n - 1 hacer
            si falla(i) entonces
                nombre_de(i, nom, 80)
                identificador(i, id)
                dd[0] := nat32(marca_informe(lista[i].estado))
                dd[1] := nat32(dirección(nom[0]))
                dd[2] := nat32(dirección(id[0]))
                formatear(t, 200, "-- %s %s  [%s]", dd)
                env_pon("\r\n")
                env_línea(t)
                si lista[i].controlador[0] <> 0 entonces
                    dd[0] := nat32(dirección(lista[i].controlador[0]))
                    formatear(t, 200, "       Controlador intentado: %s (no ha podido con él)", dd)
                sino
                    Textos32.copiar(t, "       Controlador intentado: ninguno (Hispa-Pentium no tiene uno para él)")
                fin
                env_línea(t)
                env_ficha(i)
                env_línea("       Lo que dicen los registros de él:")
                puestas := líneas_de(F_ARRANQUE, i, 0)
                si es_cable(i) entonces puestas := puestas + líneas_de(F_RED, i, 15) sino puestas := puestas + líneas_de(F_RED, i, 0) fin
                si es_wifi(i) entonces puestas := puestas + líneas_de(F_WIFI, i, ÚLTIMAS) sino puestas := puestas + líneas_de(F_WIFI, i, 0) fin
                si es_bt(i) entonces puestas := puestas + líneas_de(F_BT, i, ÚLTIMAS) sino puestas := puestas + líneas_de(F_BT, i, 0) fin
                si puestas = 0 entonces env_línea("       (nada: ni ARRANQUE.TXT, ni RED.LOG, ni WIFI.LOG, ni BT.LOG lo nombran)") fin
            fin
        fin
        ; y la lista de todo
        env_pon("\r\n")
        env_fijo("== Todos los dispositivos ==")
        para i desde 0 hasta n - 1 hacer
            si no oculto[i] entonces
                nombre_de(i, nom, 80)
                identificador(i, id)
                dónde(i, dn)
                dd[0] := nat32(marca_informe(lista[i].estado))
                dd[1] := nat32(dirección(nom[0]))
                dd[2] := nat32(dirección(id[0]))
                dd[3] := nat32(dirección(dn[0]))
                dd[4] := nat32(palabra_estado(lista[i].estado))
                dd[5] := nat32(dirección(lista[i].controlador[0]))
                si lista[i].controlador[0] = 0 entonces dd[5] := nat32("-") fin
                si id[0] = 0 entonces dd[2] := nat32("-") fin
                formatear(t, 200, "  %s %s  [%s; %s; %s; %s]", dd)
                env_línea(t)
            fin
        fin
        env_pon("\r\n")
        env_fijo("== Fin del informe ==")
    fin

    ; ---- la copia en los Documentos ----
    ; X:\USUARIOS\<CARPETA>\DOCUMENT\INFDISP.TXT (con usuarios), X:\DOCUMENT\INFDISP.TXT
    ; (sin ellos) o, si ahí no se puede, la primera unidad en la que se pueda escribir
    función guarda_copia(): bool
        variable ruta: arreglo [120] de byte
        variable c: arreglo [64] de byte
        variable m, r, vuelta: nat32
        para vuelta desde 0 hasta 1 hacer
            si vuelta = 0 entonces
                c[0] := 0
                si mi_carpeta(c, 64) > 0 y c[0] = '\\' entonces
                    en_sistema(ruta, c)
                    concatenar(ruta, "\\DOCUMENT")
                sino
                    en_sistema(ruta, "\\DOCUMENT")
                fin
                crear_carpeta(ruta)
                concatenar(ruta, "\\INFDISP.TXT")
            sino
                si no dónde_guardar(ruta) entonces devolver falso fin
                ruta[3] := 0
                concatenar(ruta, "INFDISP.TXT")
            fin
            m := crear(ruta)
            si no es_error(m) entonces
                r := escribir_archivo(m, envío_utf8, n_utf8)
                cerrar(m)
                si r = n_utf8 entonces
                    copiar_hasta(copia_en, ruta, 120)
                    devolver cierto
                fin
            fin
        fin
        devolver falso
    fin

    ; ---- mandarlo ----
    función motivo_red(e: nat32, d: puntero a byte)
        si e = SIN_RED o e = SIN_TARJETA o e = SIN_CABLE o e = SIN_IP entonces
            Textos32.copiar(d, "no hay red (enchufe el cable o conecte el Wi-Fi en Configuración > Red y Wi-Fi)")
        sino si e = NO_RESUELVE entonces
            Textos32.copiar(d, "no se encuentra el servidor (hispados.es): ¿hay salida a Internet?")
        sino si e = TIEMPO entonces
            Textos32.copiar(d, "el servidor no contesta a tiempo")
        sino si e = RECHAZADA o e = INALCANZABLE o e = CORTADA_RED o e = RED_CAMBIADA entonces
            Textos32.copiar(d, "no se llega al servidor (se ha cortado o no contesta)")
        sino si e = TLS_SIN_HORA entonces
            Textos32.copiar(d, "el reloj del equipo no está en hora (hace falta para la conexión segura)")
        sino si e = TLS_CERTIFICADO entonces
            Textos32.copiar(d, "el certificado del servidor no vale (¿está el reloj en hora?)")
        sino si e = SIN_TLS entonces
            Textos32.copiar(d, "falta el servicio de conexiones seguras (TLS.BIN: el paquete tls)")
        sino
            copiar_hasta(d, https_texto_error(e), 200)
        fin
    fin

    ; ¿«OK AAAAMMDD-HHMMSS-XXXX»? el número, a d
    función número_de(d: puntero a byte): bool
        variable i: nat32
        si no empieza_por(respuesta, "OK ") entonces devolver falso fin
        para i desde 0 hasta 19 hacer
            si i = 8 o i = 15 entonces
                si respuesta[3 + i] <> '-' entonces devolver falso fin
            sino si no es_hex(respuesta[3 + i]) entonces
                devolver falso
            fin
            d[i] := respuesta[3 + i]
        fin
        d[20] := 0
        devolver cierto
    fin

    función manda_informe()
        variable r: Respuesta_https
        variable c, e, ip, k, i, perdidas: nat32
        variable núm: arreglo [24] de byte
        variable mot: arreglo [240] de byte
        fue_enviado := falso
        resultado2[0] := 0
        copia_en[0] := 0
        n_utf8 := pag_437_a_utf8(envío, longitud(envío), envío_utf8, CABE_UTF8 - 1)
        si guarda_copia() entonces
            dd[0] := nat32(dirección(copia_en[0]))
            formatear(resultado2, 300, "Copia guardada en %s (para mandarla a mano, si hace falta).", dd)
        sino
            Textos32.copiar(resultado2, "No se ha podido guardar una copia (no hay dónde escribir).")
        fin
        si servidor[0] = 0 entonces Textos32.copiar(servidor, SERVIDOR_INFORME) fin
        ; la red: si no hay, se espera un poco (el Wi-Fi tarda en tener IP)
        e := estado_rápido(ip)
        k := 0
        mientras e <> RED_CONECTADA y e <> RED_NADA y k < 40 hacer
            dormir(50)
            e := estado_rápido(ip)
            k := k + 1
        fin
        si e = RED_SIN_TARJETA o e = RED_SIN_CABLE o e = RED_BUSCANDO entonces
            Textos32.copiar(resultado, "NO ENVIADO: no hay red (enchufe el cable o conecte el Wi-Fi en Configuración > Red y Wi-Fi)")
            escribir("disposit: informe: NO ENVIADO (sin red)\n")
            devolver
        fin
        dd[0] := nat32(dirección(servidor[0]))
        dd[1] := n_utf8
        imprimir("disposit: informe: lo mando a %s (%u octetos)\n", dd)
        sin_galletas := cierto
        c := https_post(servidor, "text/plain; charset=utf-8", envío_utf8, n_utf8, respuesta, 1000, r)
        https_cerrar()
        si r.error <> 0 o c = 0 entonces
            e := r.error
            si e = 0 entonces e := HTTPS_NO_VALE fin
            motivo_red(e, mot)
            dd[0] := nat32(dirección(mot[0]))
            formatear(resultado, 300, "NO ENVIADO: %s", dd)
            imprimir1("disposit: informe: %s\n", nat32(dirección(resultado[0])))
            devolver
        fin
        si r.largo < 1000 entonces respuesta[r.largo] := 0 sino respuesta[999] := 0 fin
        si c = 200 y número_de(núm) entonces
            fue_enviado := cierto
            dd[0] := nat32(dirección(núm[0]))
            formatear(resultado, 300, "ENVIADO (número de informe %s)", dd)
            imprimir1("disposit: informe: %s\n", nat32(dirección(resultado[0])))
            devolver
        fin
        ; lo rechaza: su motivo, en llano (lo de después de «ERROR », en la 437)
        mot[0] := 0
        si empieza_por(respuesta, "ERROR ") entonces
            i := 6
            mientras respuesta[i] <> 0 y respuesta[i] <> '\n' y respuesta[i] <> '\r' y i < 200 hacer i := i + 1 fin
            perdidas := pag_a_437(dirección(respuesta[6]), i - 6, mot, 200)
        fin
        para i desde 0 hasta longitud(mot) hacer
            si mot[i] <> 0 y mot[i] < 32 entonces mot[i] := ' ' fin
        fin
        si mot[0] = 0 entonces
            dd[0] := c
            formatear(mot, 200, "contesta %u", dd)
        fin
        dd[0] := nat32(dirección(mot[0]))
        dd[1] := c
        formatear(resultado, 300, "NO ENVIADO: el servidor lo rechaza: %s (%u)", dd)
        imprimir1("disposit: informe: %s\n", nat32(dirección(resultado[0])))
    fin

    ; ---- DISPOSIT /ENVIAR [/SI] [/SERVIDOR=url]: lo mismo, en la Consola ----
    función enviar_en_texto(args: puntero a byte): byte
        variable p: arreglo [220] de byte
        variable k: nat32
        variable sí_: bool
        variable c: nat32
        sí_ := falso
        k := 1
        mientras cierto hacer
            p[0] := 0
            palabra(args, k, p, 220)
            si p[0] = 0 entonces romper fin
            si iguales_sin_caja(p, "/SI") entonces sí_ := cierto fin
            si empieza_por(p, "/SERVIDOR=") o empieza_por(p, "/servidor=") entonces copiar_hasta(servidor, dirección(p[10]), 200) fin
            k := k + 1
        fin
        lee()
        haz_envío()
        escribir("==== Lo que se va a mandar (exactamente esto) ====\n")
        k := 0
        mientras envío[k] <> 0 hacer
            si envío[k] <> '\r' entonces
                p[0] := envío[k]
                p[1] := 0
                escribir(p)
            fin
            k := k + 1
        fin
        escribir("==== Fin de lo que se va a mandar ====\n")
        si no sí_ entonces
            escribir("¿Lo mando a hispados.es? Pulse S para enviarlo, o cualquier otra tecla para no enviar: ")
            c := tecla()
            escribir("\n")
            si c <> 's' y c <> 'S' entonces
                escribir("NO ENVIADO: cancelado (no se ha mandado nada)\n")
                devolver 1
            fin
        fin
        manda_informe()
        escribir(resultado)
        escribir("\n")
        escribir(resultado2)
        escribir("\n")
        si fue_enviado entonces devolver 0 fin
        devolver 1
    fin

    ; ---- la vista, en la ventana ----
    ; los renglones de la vista: cada línea, partida a «cols» letras
    función parte_renglones(cols: nat32)
        variable i, ini, k, j: nat32
        si cols < 20 entonces cols := 20 fin
        n_lín := 0
        i := 0
        ini := 0
        k := 0
        mientras envío[i] <> 0 y n_lín < MAX_LÍN hacer
            si envío[i] = '\r' y envío[i + 1] = '\n' entonces
                lín_ini[n_lín] := ini
                lín_n[n_lín] := k
                n_lín := n_lín + 1
                i := i + 2
                ini := i
                k := 0
            sino
                i := i + 1
                k := k + 1
                si k >= cols entonces
                    ; (por el último blanco, si lo hay cerca: las palabras enteras)
                    j := 0
                    mientras j < 24 y j + 1 < k y envío[i - 1 - j] <> ' ' hacer j := j + 1 fin
                    si j + 1 < k y envío[i - 1 - j] = ' ' entonces
                        i := i - j
                        k := k - j
                    fin
                    lín_ini[n_lín] := ini
                    lín_n[n_lín] := k
                    n_lín := n_lín + 1
                    ini := i
                    k := 0
                fin
            fin
        fin
        si k > 0 y n_lín < MAX_LÍN entonces
            lín_ini[n_lín] := ini
            lín_n[n_lín] := k
            n_lín := n_lín + 1
        fin
        cols_vista := cols
    fin

    función caben_renglones(al: ent32): nat32
        si al <= LT entonces devolver 1 fin
        devolver nat32((al - 4 * E) div LT)
    fin

    función baja(k: ent32)
        variable cab, máx: nat32
        cab := caben_renglones(vista_al)
        máx := 0
        si n_lín > cab entonces máx := n_lín - cab fin
        si k < 0 entonces
            si nat32(-k) > primera entonces primera := 0 sino primera := primera - nat32(-k) fin
        sino
            primera := primera + nat32(k)
            si primera > máx entonces primera := máx fin
        fin
    fin

    función empieza_envío()
        aviso[0] := 0
        lee()
        haz_envío()
        modo_v := V_VISTA
        primera := 0
        cols_vista := 0
        foco := ID_V_CANCELAR
        dd[0] := longitud(envío)
        imprimir("disposit: informe: la vista de lo que se manda (%u letras)\n", dd)
    fin

    función pinta_vista()
        variable yy, x, al, an, y2: ent32
        variable vueltas, k, j, cols, cab, cab2: nat32
        variable r: arreglo [240] de byte
        variable tinta: nat32
        vueltas := 0
        mientras vueltas < 2 hacer
            empezar_controles()
            caja(0, 0, ancho, alto, C_FONDO)
            yy := 3 * E
            si modo_v = V_RESULTADO entonces
                tinta := C_ROJO
                si fue_enviado entonces tinta := C_VERDE fin
                yy := yy + párrafo(LA, yy, ancho - 2 * LA, resultado, tinta, cierto, cierto) + E
                yy := yy + párrafo(LA, yy, ancho - 2 * LA, resultado2, C_TINTA, falso, cierto) + 2 * E
            sino
                negrita(LA, yy, "Enviar informe de los dispositivos que fallan", C_TINTA)
                yy := yy + LT + E
                dd[0] := longitud(envío)
                formatear(r, 240, "Esto es exactamente lo que se va a mandar a hispados.es (%u letras). No lleva números de serie, ni contraseñas, ni nombres de redes o de usuarios, ni nada de sus documentos. Se guarda también una copia en sus Documentos.", dd)
                yy := yy + párrafo(LA, yy, ancho - 2 * LA, r, C_TINTA, falso, cierto) + 2 * E
            fin
            ; el texto, con sus renglones
            an := ancho - LA
            al := alto - yy - alto_botón() - 10 * E - LT
            si al < 2 * LT entonces al := 2 * LT fin
            vista_al := al
            caja(LA div 2, yy, an, al, C_PAPEL)
            borde(LA div 2, yy, an, al, 1, C_BORDE)
            apuntar(ID_V_TEXTO, K_LISTA, LA div 2, yy, an, al)
            si foco = ID_V_TEXTO entonces marca_foco(LA div 2, yy, an, al) fin
            cols := nat32((an - 2 * LA) * 95 div 100 div LA)
            si cols <> cols_vista entonces
                parte_renglones(cols)
                baja(0)
            fin
            cab := caben_renglones(al)
            y2 := yy + 2 * E
            k := primera
            mientras k < n_lín y k < primera + cab hacer
                j := lín_n[k]
                si j > 238 entonces j := 238 fin
                para cab2 desde 0 hasta j hacer r[cab2] := envío[lín_ini[k] + cab2] fin
                r[j] := 0
                texto_corto(LA, y2, r, an - LA, C_TINTA, falso)
                y2 := y2 + LT
                k := k + 1
            fin
            dd[0] := primera + 1
            dd[1] := primera + cab
            si dd[1] > n_lín entonces dd[1] := n_lín fin
            dd[2] := n_lín
            formatear(r, 240, "Renglones %u a %u de %u (las flechas, Re Pág, Av Pág, Inicio, Fin o la rueda)", dd)
            Controles.texto(LA div 2, yy + al + E, r, C_SUAVE)
            ; los botones
            y2 := alto - alto_botón() - 4 * E
            si modo_v = V_RESULTADO entonces
                botón(ID_V_VOLVER, LA, y2, "Volver a la lista", cierto, falso)
            sino
                x := LA
                x := x + botón(ID_V_ENVIAR, x, y2, "Enviar", cierto, falso) + LA
                botón(ID_V_CANCELAR, x, y2, "Cancelar", falso, falso)
            fin
            si no asegurar_foco() entonces romper fin
            vueltas := vueltas + 1
        fin
        volcar()
    fin

    ; lo que hace un botón de la vista (cierto: se vuelve a la lista)
    función hace_vista(id: nat32)
        si id = ID_V_ENVIAR y modo_v = V_VISTA entonces
            Textos32.copiar(resultado, "Enviando...")
            resultado2[0] := 0
            modo_v := V_RESULTADO
            pinta_vista()
            manda_informe()
            foco := ID_V_VOLVER
        sino si id = ID_V_CANCELAR entonces
            modo_v := V_ÁRBOL
            Textos32.copiar(aviso, "No se ha enviado nada")
            escribir("disposit: informe: cancelado (no se ha mandado nada)\n")
            foco := ID_ENVIAR
        sino si id = ID_V_VOLVER entonces
            modo_v := V_ÁRBOL
            si fue_enviado entonces Textos32.copiar(aviso, "Informe enviado") sino Textos32.copiar(aviso, "Informe NO enviado") fin
            foco := ID_ENVIAR
        fin
    fin

    función tecla_vista(c: nat32)
        variable cab: nat32
        cab := caben_renglones(vista_al)
        si c = 27 entonces
            si modo_v = V_RESULTADO entonces hace_vista(ID_V_VOLVER) sino hace_vista(ID_V_CANCELAR) fin
        sino si c = '\t' o c = TECLA_MAYÚS_TAB entonces
            pasar_foco(c = '\t')
        sino si (c = '\n' o c = ' ') y foco <> ID_V_TEXTO entonces
            hace_vista(foco)
        sino si c = TECLA_ABAJO entonces baja(1)
        sino si c = TECLA_ARRIBA entonces baja(-1)
        sino si c = TECLA_AV_PÁG entonces baja(ent32(cab) - 1)
        sino si c = TECLA_RE_PÁG entonces baja(1 - ent32(cab))
        sino si c = TECLA_INICIO entonces primera := 0
        sino si c = TECLA_FIN entonces baja(ent32(MAX_LÍN))
        fin
    fin

    función clic_vista(x: ent32, yy: ent32)
        variable id: nat32
        id := control_en(x, yy)
        si id = 0 entonces devolver fin
        foco := id
        si id <> ID_V_TEXTO entonces hace_vista(id) fin
    fin

    ; =========================================================================
    ;  La ventana: el árbol
    ; =========================================================================
    ; (RECOGIDO) ¿algo de la categoría c no va? (sin controlador, con error o desactivado)
    función mal_en(c: nat32): nat32
        variable i, m: nat32
        m := 0
        para i desde 0 hasta n - 1 hacer
            si no oculto[i] y categoría(i) = c y (lista[i].estado = EST_SIN_CONTROLADOR o lista[i].estado = EST_ERROR o lista[i].estado = EST_APAGADO) entonces m := m + 1 fin
        fin
        devolver m
    fin

    ; (RECOGIDO) al abrir: recogido lo que funciona entero; abierto lo que tiene algo que no va
    función abre_lo_que_falla()
        variable c: nat32
        para c desde 0 hasta N_CAT - 1 hacer abierta[c] := mal_en(c) > 0 fin
    fin

    función llena_rejilla()
        variable c, i, h, antes, m: nat32
        variable r: ent32
        variable nom: arreglo [80] de byte
        variable cl: nat32
        antes := rejilla_id(g)
        rejilla_vaciar(g)
        para c desde 0 hasta N_CAT - 1 hacer
            h := 0
            para i desde 0 hasta n - 1 hacer
                si no oculto[i] y categoría(i) = c entonces h := h + 1 fin
            fin
            si h > 0 entonces
                r := renglón_nuevo(g, R_NORMAL, ES_CATEGORÍA + c)
                opción_de(CATEGORÍAS, c, t2, 200)
                dd[0] := nat32("[-]")
                si no abierta[c] entonces dd[0] := nat32("[+]") fin
                dd[1] := nat32(dirección(t2[0]))
                dd[2] := h
                formatear(t, 200, "%s %s (%u)", dd)

                celda(g, r, 0, t)
                ; (RECOGIDO) y, en palabra, cómo está la categoría (no solo el color)
                m := mal_en(c)
                dd[0] := m
                si m = 0 entonces celda(g, r, 1, "todo funciona")
                sino si m = 1 entonces celda(g, r, 1, "1 NO VA")
                sino
                    formatear(t2, 200, "%u NO VAN", dd)
                    celda(g, r, 1, t2)
                fin
                si abierta[c] entonces
                    para i desde 0 hasta n - 1 hacer
                        si no oculto[i] y categoría(i) = c entonces
                            cl := R_NORMAL
                            si lista[i].estado = EST_SIN_CONTROLADOR o lista[i].estado = EST_ERROR entonces cl := R_AVISO fin
                            si lista[i].estado = EST_APAGADO entonces cl := R_GRIS fin
                            r := renglón_nuevo(g, cl, i + 1)
                            nombre_de(i, nom, 80)
                            Textos32.copiar(t, "    ")
                            añadir_car(t, signo(lista[i].estado))
                            concatenar(t, " ")
                            concatenar(t, nom)
                            celda(g, r, 0, t)
                            celda(g, r, 1, palabra_estado(lista[i].estado))
                            si lista[i].estado = EST_NO_HACE_FALTA entonces celda(g, r, 2, "-") sino celda(g, r, 2, lista[i].controlador) fin
                            identificador(i, t)
                            celda(g, r, 3, t)
                        fin
                    fin
                fin
            fin
        fin
        rejilla_lista(g)
        si antes <> 0 entonces rejilla_elegir_id(g, antes) fin
    fin

    función pinta()
        variable yy, x: ent32
        variable vueltas: nat32
        variable est: arreglo [240] de byte
        si modo_v <> V_ÁRBOL entonces
            pinta_vista()
            devolver
        fin
        vueltas := 0
        mientras vueltas < 2 hacer
            empezar_controles()
            caja(0, 0, ancho, alto, C_FONDO)
            yy := barra_menús(0, 0, ancho, MENÚS, abierto_m)
            barra_herramientas(0, yy, ancho)
            x := 4
            x := x + herramienta(ID_PROPIEDADES, x, yy + 2, I_EDITAR, "Propiedades", rejilla_id(g) = 0 o rejilla_id(g) >= ES_CATEGORÍA) + 2
            x := x + separador(x, yy)
            x := x + herramienta(ID_COPIAR, x, yy + 2, I_IMPRIMIR, "Copiar informe", falso) + 2
            x := x + herramienta(ID_GUARDAR, x, yy + 2, I_GUARDAR, "Guardar informe", falso) + 2
            x := x + separador(x, yy)
            x := x + herramienta(ID_ACTUALIZAR, x, yy + 2, I_REFRESCAR, "Actualizar", falso) + 2
            yy := yy + alto_herramientas() + 4 * E
            rejilla(g, ID_REJILLA, LA div 2, yy, ancho - LA, alto - alto_estado() - alto_botón() - 10 * E - yy, "No hay dispositivos (¿el núcleo no da la lista?)")
            ; (INFORME-DISP) el botón de mandar lo que falla
            botón(ID_ENVIAR, LA div 2, alto - alto_estado() - alto_botón() - 4 * E, "Enviar informe de los dispositivos que fallan", falso, falso)
            dd[0] := n - cuenta_ocultos()
            dd[1] := cuenta(EST_SIN_CONTROLADOR)
            dd[2] := cuenta(EST_ERROR)
            formatear(est, 240, "%u dispositivos|%u sin controlador|%u con error|", dd)
            si aviso[0] <> 0 entonces concatenar(est, aviso) sino concatenar(est, "Intro o dos clics: propiedades") fin
            barra_estado(alto - alto_estado(), est)
            si no asegurar_foco() entonces romper fin
            vueltas := vueltas + 1
        fin
        volcar()
    fin

    ; las propiedades del elegido (otra ventana: el mismo programa, con /P)
    función abre_propiedades()
        variable id, r: nat32
        id := rejilla_id(g)
        si id = 0 entonces devolver fin
        si id >= ES_CATEGORÍA entonces
            abierta[id - ES_CATEGORÍA] := no abierta[id - ES_CATEGORÍA]
            llena_rejilla()
            devolver
        fin
        dd[0] := lista[id - 1].bus
        dd[1] := lista[id - 1].dirección
        formatear(t, 200, "/P %u %u", dd)
        r := lanzar_suelto("\\DISPOSIT.BIN", t)
        si es_error(r) entonces
            Textos32.copiar(aviso, "No se pueden abrir las propiedades: ")
            concatenar(aviso, texto_error(r))
        fin
    fin

    función actualiza()
        lee()
        llena_rejilla()
        Textos32.copiar(aviso, "Lista puesta al día")
    fin

    función hace(id: nat32)
        si id = ID_PROPIEDADES o id = ID_REJILLA entonces abre_propiedades()
        sino si id = ID_COPIAR entonces copia()
        sino si id = ID_GUARDAR entonces guarda(nulo)
        sino si id = ID_ACTUALIZAR entonces actualiza()
        sino si id = ID_ENVIAR entonces empieza_envío() fin
    fin

    función abre_menú_n(k: nat32)
        abierto_m := ent32(k)
        según k
            caso 0: abrir_menú_barra(0, "Propiedades|-|Copiar informe|Guardar informe|Enviar informe de los dispositivos que fallan...|-|Cerrar", 0)
            caso 1: abrir_menú_barra(1, "Actualizar|Desplegar todo (*)|Recoger todo (/)|-|Letra normal|Letra grande", 0)
            si no: abrir_menú_barra(2, "Acerca del Administrador de dispositivos", 0)
        fin
    fin

    función todas(sí: bool)
        variable c: nat32
        para c desde 0 hasta N_CAT - 1 hacer abierta[c] := sí fin
        llena_rejilla()
    fin

    ; lo elegido en un menú: cierto si hay que cerrar
    función elegido(cuál: nat32, op: nat32): bool
        abierto_m := -1
        si op = SIN_ELEGIR entonces devolver falso fin
        si cuál = 0 entonces
            según nat16(op)
                caso 0: abre_propiedades()
                caso 2: copia()
                caso 3: guarda(nulo)
                caso 4: empieza_envío()                ; (INFORME-DISP)
                caso 6: devolver cierto
            fin
        sino si cuál = 1 entonces
            según nat16(op)
                caso 0: actualiza()
                caso 1: todas(cierto)
                caso 2: todas(falso)
                caso 4:
                    tamaño_ := T_NORMAL
                    nuevo_tamaño(ancho, alto, tamaño_)
                caso 5:
                    tamaño_ := T_GRANDE
                    nuevo_tamaño(ancho, alto, tamaño_)
            fin
        sino si cuál = 2 entonces
            Textos32.copiar(aviso, "Administrador de dispositivos de Hispa-Pentium (GPL-2.0 o posterior)")
        sino si cuál = 3 y op = 0 entonces
            abre_propiedades()
        sino si cuál = 3 y op = 1 entonces
            ; copiar la ficha de lo elegido
            si rejilla_id(g) > 0 y rejilla_id(g) < ES_CATEGORÍA entonces copia_ficha(rejilla_id(g) - 1) fin
        fin
        devolver falso
    fin

    función copia_ficha(i: nat32)
        variable nom: arreglo [80] de byte
        variable id: arreglo [24] de byte
        informe[0] := 0
        nombre_de(i, nom, 80)
        identificador(i, id)
        dd[0] := nat32(marca_informe(lista[i].estado))
        dd[1] := nat32(dirección(nom[0]))
        dd[2] := nat32(dirección(id[0]))
        formatear(t, 200, "%s %s  [%s]\n", dd)
        añade_inf(t)
        ficha_al_informe(i)
        si al_portapapeles(informe, longitud(informe)) entonces Textos32.copiar(aviso, "Copiado al portapapeles") fin
    fin

    función tecla_pulsada(c: nat32): bool
        variable m: ent32
        variable id: nat32
        aviso[0] := 0
        m := menú_de_alt(MENÚS, c)
        si m >= 0 entonces
            abre_menú_n(nat32(m))
            devolver falso
        fin
        id := rejilla_id(g)
        si c = '\t' o c = TECLA_MAYÚS_TAB entonces
            pasar_foco(c = '\t')
        sino si (c = '\n' o c = ' ') y foco = ID_ENVIAR entonces
            empieza_envío()                      ; (INFORME-DISP)
        sino si c = '\n' entonces
            abre_propiedades()
        sino si (c = TECLA_IZQUIERDA o c = TECLA_DERECHA) y id >= ES_CATEGORÍA entonces
            abierta[id - ES_CATEGORÍA] := c = TECLA_DERECHA
            llena_rejilla()
        sino si c = '*' entonces
            todas(cierto)                        ; (RECOGIDO) * despliega todo; / lo recoge
        sino si c = '/' entonces
            todas(falso)
        sino si c = TECLA_F5 entonces
            actualiza()
        sino si c = 27 entonces
            devolver cierto
        sino
            rejilla_tecla(g, c)
        fin
        devolver falso
    fin

    función clic(x: ent32, yy: ent32, veces_: nat32, derecho: bool)
        variable id: nat32
        variable m, r: ent32
        aviso[0] := 0
        m := menú_en_barra(x, yy)
        si m >= 0 entonces
            abre_menú_n(nat32(m))
            devolver
        fin
        id := control_en(x, yy)
        si id = 0 entonces devolver fin
        si clase_de(id) = K_LISTA entonces
            foco := id
            r := rejilla_clic(g, x, yy)
            si r = -2 entonces
                ; (el árbol no se ordena: va como está)
                g.orden_col := -1
                llena_rejilla()
                devolver
            fin
            si r < 0 entonces devolver fin
            si derecho entonces
                si rejilla_id(g) > 0 y rejilla_id(g) < ES_CATEGORÍA entonces menú(v, x, yy, "Propiedades|Copiar sus datos", 0, 3) fin
                devolver
            fin
            ; un clic en [+]/[-] abre o cierra; dos clics, lo de Intro
            si rejilla_id(g) >= ES_CATEGORÍA y x < g.col_x[0] + 3 * LA entonces
                abre_propiedades()
            sino si veces_ >= 2 entonces
                abre_propiedades()
            fin
        sino si no derecho entonces
            hace(id)
        fin
    fin

    función ventana_principal(): byte
        variable s: Suceso
        variable c: nat32
        si no preparar_medida("Administrador de dispositivos", 720, 500, tamaño_) entonces devolver 2 fin
        lee()
        abre_lo_que_falla()                     ; (RECOGIDO)
        rejilla_nueva(g, MAX + N_CAT + 4)
        rejilla_columna(g, "Dispositivo", 0, falso)
        rejilla_columna(g, "Estado", 16, falso)
        rejilla_columna(g, "Controlador", 12, falso)
        rejilla_columna(g, "Identificador", 10, falso)
        lee()
        llena_rejilla()
        foco := ID_REJILLA
        pinta()
        mientras suceso(v, s, cierto) hacer
            ; (INFORME-DISP) la vista de lo que se manda, y lo que ha pasado
            si modo_v <> V_ÁRBOL y (s.clase = EV_TECLA o s.clase = EV_RATÓN_BAJA o s.clase = EV_RUEDA o s.clase = EV_MENÚ o s.clase = EV_UNIDADES) entonces
                si s.clase = EV_TECLA entonces
                    tecla_vista(s.a)
                sino si s.clase = EV_RATÓN_BAJA y s.c yb BOTÓN_IZQUIERDO <> 0 entonces
                    clic_vista(ent32(s.a), ent32(s.b))
                sino si s.clase = EV_RUEDA y s.c yb CON_CONTROL = 0 entonces
                    baja(0 - pasos_rueda(s.c) * 3)
                fin
                si modo_v = V_ÁRBOL entonces llena_rejilla() fin
                pinta()
            sino si s.clase = EV_TECLA entonces
                si tecla_pulsada(s.a) entonces devolver 0 fin
                pinta()
            sino si s.clase = EV_RATÓN_BAJA entonces
                clic(ent32(s.a), ent32(s.b), veces(s.c), s.c yb BOTÓN_DERECHO <> 0)
                pinta()
            sino si s.clase = EV_MENÚ entonces
                si elegido(s.b, s.a) entonces devolver 0 fin
                pinta()
            sino si s.clase = EV_RUEDA entonces
                ; (RUEDA) la rueda desplaza la lista sin mover lo elegido; con Ctrl, la letra
                si rueda(s) entonces
                    pinta()
                sino si rueda_letra(s) > 0 y tamaño_ < T_MUY_GRANDE entonces
                    tamaño_ := tamaño_ + 1
                    nuevo_tamaño(ancho, alto, tamaño_)
                    pinta()
                sino si rueda_letra(s) < 0 y tamaño_ > T_NORMAL entonces
                    tamaño_ := tamaño_ - 1
                    nuevo_tamaño(ancho, alto, tamaño_)
                    pinta()
                fin
            sino si s.clase = EV_UNIDADES entonces
                ; (se ha enchufado o quitado algo: la lista, al día)
                lee()
                llena_rejilla()
                pinta()
            sino si s.clase = EV_TAMAÑO entonces
                nuevo_tamaño(ent32(s.a), ent32(s.b), tamaño_)
                pinta()
            sino si s.clase = EV_CERRAR entonces
                devolver 0
            fin
        fin
        devolver 0
    fin

    ; =========================================================================
    ;  La ventana de las propiedades (DISPOSIT /P BUS DIR)
    ; =========================================================================
    función pinta_prop()
        variable yy, x, y2, an: ent32
        variable vueltas, k, j: nat32
        variable rot: arreglo [40] de byte
        variable val: arreglo [200] de byte
        variable nom: arreglo [80] de byte
        variable tinta: nat32
        vueltas := 0
        mientras vueltas < 2 hacer
            empezar_controles()
            caja(0, 0, ancho, alto, C_FONDO)
            ; la cabecera: el signo (con su palabra) y el nombre
            nombre_de(prop, nom, 80)
            tinta := C_VERDE
            si lista[prop].estado = EST_SIN_CONTROLADOR o lista[prop].estado = EST_ERROR entonces tinta := C_NARANJA fin
            si lista[prop].estado = EST_ERROR entonces tinta := C_ROJO fin
            caja_redonda(LA, 3 * E, LT + 4 * E, LT + 4 * E, 3 * E, tinta)
            si lista[prop].estado = EST_FUNCIONA o lista[prop].estado = EST_NO_HACE_FALTA entonces
                marca_hecho(LA + 3 * E, 6 * E, LT - 2 * E, C_PAPEL)
            sino
                rot[0] := signo(lista[prop].estado)
                rot[1] := 0
                negrita(LA + 2 * E + LA div 2, 5 * E, rot, C_PAPEL)
            fin
            texto_corto(4 * LA, 2 * E, nom, ancho - 4 * LA, C_TINTA, cierto)
            texto_corto(4 * LA, 2 * E + LT, palabra_estado(lista[prop].estado), ancho - 4 * LA, tinta, cierto)
            yy := 2 * LT + 8 * E
            yy := yy + pestañas(ID_PESTAÑAS, 0, yy, ancho, "General|Controlador|Recursos", pestaña, 0)
            an := ancho - 2 * LA
            caja(LA div 2, yy, ancho - LA, alto - yy - alto_botón() - 8 * E, C_PAPEL)
            borde(LA div 2, yy, ancho - LA, alto - yy - alto_botón() - 8 * E, 1, C_BORDE)
            ficha_de(prop, pestaña, ficha_t)
            y2 := yy + 4 * E
            k := 0
            mientras ficha_t[k] <> 0 y y2 + LT < alto - alto_botón() - 8 * E hacer
                j := 0
                mientras ficha_t[k] <> '\t' y ficha_t[k] <> 0 y j < 39 hacer
                    rot[j] := ficha_t[k]
                    j := j + 1
                    k := k + 1
                fin
                rot[j] := 0
                si ficha_t[k] = '\t' entonces k := k + 1 fin
                j := 0
                mientras ficha_t[k] <> '\n' y ficha_t[k] <> 0 y j < 199 hacer
                    val[j] := ficha_t[k]
                    j := j + 1
                    k := k + 1
                fin
                val[j] := 0
                si ficha_t[k] = '\n' entonces k := k + 1 fin
                texto_corto(LA + LA div 2, y2, rot, 17 * LA, C_SUAVE, cierto)
                y2 := y2 + párrafo(LA + 19 * LA, y2, an - 19 * LA, val, C_TINTA, falso, cierto) + E
            fin
            x := ancho - LA - ancho_botón("Cerrar")
            botón(ID_CERRAR, x, alto - alto_botón() - 4 * E, "Cerrar", cierto, falso)
            botón(ID_COPIAR_FICHA, LA, alto - alto_botón() - 4 * E, "Copiar estos datos", falso, falso)
            si aviso[0] <> 0 entonces Controles.texto(LA + ancho_botón("Copiar estos datos") + LA, alto - alto_botón() - 2 * E, aviso, C_VERDE) fin
            si no asegurar_foco() entonces romper fin
            vueltas := vueltas + 1
        fin
        volcar()
    fin

    función ventana_propiedades(args: puntero a byte): byte
        variable s: Suceso
        variable bus, dir, i, id: nat32
        variable p: arreglo [20] de byte
        variable nom: arreglo [80] de byte
        variable tit: arreglo [100] de byte
        variable m: ent32
        palabra(args, 1, p, 20)
        si no texto_a_natural(p, bus) entonces devolver 1 fin
        palabra(args, 2, p, 20)
        si no texto_a_natural(p, dir) entonces devolver 1 fin
        lee()
        prop := MAX
        para i desde 0 hasta n - 1 hacer
            si lista[i].bus = bus y lista[i].dirección = dir y prop = MAX entonces prop := i fin
        fin
        si prop = MAX entonces
            escribir("disposit: ese dispositivo ya no está\n")
            devolver 1
        fin
        nombre_de(prop, nom, 80)
        Textos32.copiar(tit, "Propiedades: ")
        concatenar(tit, nom)
        tit[60] := 0
        si no preparar_medida(tit, 600, 420, tamaño_) entonces devolver 2 fin
        foco := ID_PESTAÑAS
        pinta_prop()
        mientras suceso(v, s, cierto) hacer
            si s.clase = EV_TECLA entonces
                aviso[0] := 0
                si s.a = 27 o (s.a = '\n' y foco = ID_CERRAR) entonces devolver 0 fin
                si s.a = TECLA_CTRL_TAB o s.a = TECLA_CTRL_MAYÚS_TAB entonces
                    pestaña := otra_pestaña(pestaña, 3, 0, s.a = TECLA_CTRL_TAB)
                sino si s.a = '\t' o s.a = TECLA_MAYÚS_TAB entonces
                    pasar_foco(s.a = '\t')
                sino si foco = ID_PESTAÑAS y (s.a = TECLA_DERECHA o s.a = TECLA_IZQUIERDA) entonces
                    pestaña := otra_pestaña(pestaña, 3, 0, s.a = TECLA_DERECHA)
                sino si (s.a = '\n' o s.a = ' ') y foco = ID_COPIAR_FICHA entonces
                    copia_ficha(prop)
                fin
                pinta_prop()
            sino si s.clase = EV_RATÓN_BAJA y s.c yb BOTÓN_IZQUIERDO <> 0 entonces
                aviso[0] := 0
                id := control_en(ent32(s.a), ent32(s.b))
                si id = ID_CERRAR entonces devolver 0 fin
                si id = ID_PESTAÑAS entonces
                    m := pestaña_en(ent32(s.a), ent32(s.b))
                    si m >= 0 entonces pestaña := nat32(m) fin
                fin
                si id = ID_COPIAR_FICHA entonces copia_ficha(prop) fin
                si id <> 0 entonces foco := id fin
                pinta_prop()
            sino si s.clase = EV_TAMAÑO entonces
                nuevo_tamaño(ent32(s.a), ent32(s.b), tamaño_)
                pinta_prop()
            sino si s.clase = EV_CERRAR entonces
                devolver 0
            fin
        fin
        devolver 0
    fin

    ; =========================================================================
    función principal(): byte
        variable args: arreglo [160] de byte
        variable p: arreglo [100] de byte
        variable r: byte
        argumentos(args, 160)
        palabra(args, 0, p, 100)
        a_mayúsculas(p)
        si iguales(p, "/P") entonces devolver ventana_propiedades(args) fin
        ; (INFORME-DISP) DISPOSIT /ENVIAR [/SI] [/SERVIDOR=url]: en la Consola
        si iguales(p, "/ENVIAR") entonces devolver enviar_en_texto(args) fin
        ; (y la ventana, con otro servidor: las pruebas)
        si empieza_por(p, "/SERVIDOR=") entonces
            palabra(args, 0, p, 100)
            copiar_hasta(servidor, dirección(p[10]), 200)
        fin
        si iguales(p, "/INFORME") entonces
            lee()
            haz_informe()
            escribir(informe)
            devolver 0
        fin
        si iguales(p, "/GUARDAR") entonces
            lee()
            p[0] := 0
            palabra(args, 1, p, 100)
            guarda(p)
            escribir(aviso)
            escribir("\n")
            si empieza_por(aviso, "Informe guardado") entonces devolver 0 fin
            devolver 1
        fin
        si iguales(p, "/?") entonces
            escribir("DISPOSIT [/INFORME | /GUARDAR [RUTA] | /ENVIAR [/SI] [/SERVIDOR=url]]: el Administrador de dispositivos.\n")
            devolver 0
        fin
        r := ventana_principal()
        si r = 2 entonces
            ; sin escritorio: el informe, en texto
            lee()
            haz_informe()
            escribir(informe)
            devolver 0
        fin
        devolver r
    fin

fin UDisposi.
