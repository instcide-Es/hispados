; =============================================================================
;  udisposi.cas - DISPOSIT.BIN, el Administrador de dispositivos de
;  Hispa-Pentium: lo que hay en el equipo (todo lo del PCI, los aparatos USB,
;  lo que declara ACPI, los discos, el teclado y el ratón PS/2, los relojes,
;  los puertos serie y el procesador), en un árbol por categorías, con el
;  controlador de Hispa-Pentium que lleva cada cosa (o «SIN CONTROLADOR»),
;  su estado, su identificador y sus recursos. Se lo pide al núcleo con la
;  llamada 155 (dispositivos.cas), que solo lee.
;
;    DISPOSIT                  la ventana (sin escritorio: el informe, en texto)
;    DISPOSIT /INFORME         el informe, por la salida (DISPOSIT /INFORME > A.TXT)
;    DISPOSIT /GUARDAR [RUTA]  el informe, a ese archivo (sin ruta: X:\DISPOSIT.TXT
;                              o la primera unidad en la que se pueda escribir)
;    DISPOSIT /P BUS DIR       las propiedades de un dispositivo (las abre la
;                              ventana: General, Controlador y Recursos)
;    DISPOSIT /ENVIAR [/SI] [/SERVIDOR=URL]
;                              (INFORME-DISP, 0.8.12) el informe de lo que falla:
;                              lo enseña, pregunta (con /SI, no) y lo manda a
;                              hispados.es (tools/informe-disp/informe.php)
;
;  (RECOGIDO) Al abrirla, las categorías en las que todo funciona van recogidas
;  («[+] Red (1)», y «todo funciona» en Estado) y las que tienen algo que no va
;  (sin controlador, con error o desactivado), abiertas («1 NO VA»); «*» despliega
;  todo y «/» lo recoge (también en Ver).
;  En la ventana: el árbol (Intro, dos clics o un clic en [+]/[-] abren y
;  cierran una categoría; Intro o dos clics en un dispositivo, sus
;  propiedades), y «Copiar informe» (al portapapeles) y «Guardar informe»
;  (para mandar qué tiene cada portátil del taller); y, (INFORME-DISP) abajo,
;  «Enviar informe de los dispositivos que fallan» (también en Archivo): enseña
;  antes, en texto, exactamente lo que se va a mandar (sin números de serie,
;  ni claves, ni nombres de redes o de usuarios, ni rutas de documentos, ni
;  IP públicas), «Enviar» o «Cancelar»; luego, «ENVIADO (número de informe
;  ...)» o «NO ENVIADO: el motivo», y una copia en los Documentos (INFDISP.TXT). Lo que no tiene
;  controlador va con un «!», fondo naranja, una franja y la palabra; lo que
;  funciona, con «+» (y una marca en sus propiedades): nada depende solo del color.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo UDisposi

    modelo usuario

    importar Llamadas, Controles, Textos32, Formato, Redes, Https, BlocPag

    constante MAX = 200
    constante N_CAT = 11
    constante ID_REJILLA = 1
    constante ID_PROPIEDADES = 10
    constante ID_COPIAR = 11
    constante ID_GUARDAR = 12
    constante ID_ACTUALIZAR = 13
    constante ID_PESTAÑAS = 20
    constante ID_CERRAR = 21
    constante ID_COPIAR_FICHA = 22
    constante ID_ENVIAR = 14                    ; (INFORME-DISP) «Enviar informe de los dispositivos que fallan»
    constante ID_V_TEXTO = 30                   ; (INFORME-DISP) la vista de lo que se manda
    constante ID_V_ENVIAR = 31
    constante ID_V_CANCELAR = 32
    constante ID_V_VOLVER = 33
    constante ES_CATEGORÍA = 0x10000            ; el id de un renglón de categoría (más su número)
    constante MENÚS = "&Archivo|&Ver|A&yuda"
    constante CABE_INFORME = 60000

    variable lista: arreglo [MAX] de Dispositivo
    variable n: nat32
    variable oculto: arreglo [MAX] de bool      ; (lo de ACPI que ya sale como «lo de siempre»)
    variable acpi_de: arreglo [MAX] de nat32    ; la ficha de ACPI que va con ella (SIN_PADRE)
    variable abierta: arreglo [N_CAT] de bool
    variable red: Info_red
    variable hay_red: bool
    variable en: Energía
    variable hay_en: bool
    variable g: Rejilla
    variable informe: arreglo [CABE_INFORME] de byte
    variable aviso: arreglo [120] de byte
    variable t: arreglo [200] de byte
    variable t2: arreglo [200] de byte
    variable abierto_m: ent32 = -1
    variable tamaño_: nat32 = T_NORMAL
    variable dd: arreglo [6] de nat32
    ; las propiedades
    variable prop: nat32                        ; la ficha que se ve
    variable pestaña: nat32
    variable ficha_t: arreglo [3000] de byte

    ; =========================================================================
    ;  Las tablas de nombres (lo que se sabe y lo típico): «\nCLAVE Nombre»
    ; =========================================================================
    constante FAB_PCI = "\n8086 Intel\n10EC Realtek\n11AB Marvell\n1B4B Marvell\n14E4 Broadcom\n168C Atheros\n1969 Atheros\n1106 VIA\n1039 SiS\n1022 AMD\n1002 AMD (ATI)\n10DE NVIDIA\n80EE VirtualBox\n1234 QEMU (Bochs)\n1AF4 Red Hat (virtio)\n1B36 Red Hat (QEMU)\n15AD VMware\n1033 NEC\n104C Texas Instruments\n1180 Ricoh\n197B JMicron\n1B21 ASMedia\n1912 Renesas\n10B9 ALi\n1013 Cirrus Logic\n5333 S3\n102B Matrox\n1217 O2 Micro\n1814 Ralink\n1095 Silicon Image\n105A Promise\n13F6 C-Media\n1274 Ensoniq\n1102 Creative\n125D ESS\n106B Apple\n1179 Toshiba\n103C HP\n1028 Dell\n17AA Lenovo\n1025 Acer\n1043 ASUS\n144D Samsung\n1C5C SK hynix\n15B7 SanDisk\n1987 Phison\n126F Silicon Motion\n8384 SigmaTel\n1414 Microsoft\n1AB8 Parallels\n1AE0 Google\n9005 Adaptec\n1000 LSI\n11C1 Agere\n10B7 3Com\n1011 DEC\n1186 D-Link\n1317 ADMtek\n100B National Semiconductor\n1050 Winbond\n1023 Trident\n1524 ENE\n1E0F KIOXIA\n"
