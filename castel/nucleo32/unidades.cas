; =============================================================================
;  unidades.cas - las unidades de Hispa-Pentium, con sus letras, como en
;  Hispa-DOS:
;     C: D: ...   los volúmenes FAT de los discos de dentro (IDE y SATA);
;     X: W: V:... los de las memorias USB, de la X: hacia abajo (X: es la
;                 memoria de arranque; las que se enchufan en marcha, desde
;                 la W:, la primera libre hacia abajo);
;     M:          la unidad en memoria: los archivos que ha traído el
;                 cargador (los módulos de multiboot), de solo lectura;
;     (CD) D: E:...  los lectores de CD y DVD (ISO 9660: iso.cas), la primera
;                 letra libre tras los discos de dentro (D: si hay un disco
;                 duro, aunque no tenga FAT), una para cada lector, que se
;                 le queda aunque no tenga disco; detrás, las imágenes de
;                 disco montadas (.ISO, .IMG...), la primera libre.
;  Aquí se miran las particiones de cada disco (la tabla del MBR, y la GPT
;  de los discos de ahora) y se monta cada volumen FAT que haya (fat.cas);
;  un disco sin tabla, entero, también vale. La unidad número n es el
;  volumen número n de fat.cas (la de memoria no tiene volumen).
;
;  «La unidad del sistema» es de la que se cargan los programas cuando no se
;  dice otra: la que diga el cargador («unidad=X» en su línea) si está y
;  lleva el sistema (ORDENES.BIN, en su raíz o en \HISPA); si no, la primera
;  que lo lleve (C:... y luego X:...); si no, M:. Un sistema INSTALADO en el
;  disco (por el programa INSTALAR) lo lleva en la carpeta \HISPA.
;  Si la unidad del sistema se va (una memoria USB que se desenchufa), pasa
;  a serlo M: (o la primera con el sistema); y si vuelve, vuelve a ser X:.
;  «cambios» sube cada vez que aparece o desaparece una unidad.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo Unidades

    importar Discos, Fat, Multiboot, Tareas

    público constante MAX_UNIDADES = 8          ; (las de fat.cas: VOLÚMENES)
    público constante NINGUNA = 0xFFFFFFFF
    público constante U_FAT = 1                 ; un volumen FAT de un disco
    público constante U_MEMORIA = 2             ; los módulos del cargador

    público tipo Unidad = estructura
        hay: bool
        letra: byte
        clase: nat32                            ; U_FAT o U_MEMORIA
        disco: nat32                            ; (U_FAT) en qué disco está
        partición: nat32                        ; (U_FAT) cuál de sus particiones (0: el disco entero)
    fin

    público variable unidades: arreglo [MAX_UNIDADES] de Unidad
    público variable del_sistema: nat32 = 0xFFFFFFFF    ; la unidad del sistema (NINGUNA: no hay ninguna)
    variable sector: arreglo [512] de byte
    variable letra_interna: nat32 = 'C'
    variable letras_cd: arreglo [MAX_DISCOS] de byte   ; (CD) la letra de cada lector de CD o DVD
    variable en_caliente: bool                  ; montando una memoria enchufada en marcha (desde la W:)
    variable sistema_ido: bool                  ; la unidad del sistema se ha desenchufado
    público variable cambios: nat32             ; sube cada vez que aparece o desaparece una unidad

    ; la unidad que lleva esa letra (en mayúscula o minúscula), o NINGUNA
    público función por_letra(letra: nat32): nat32
        variable u: nat32
        si letra >= 'a' y letra <= 'z' entonces letra := letra - 32 fin
        para u desde 0 hasta MAX_UNIDADES - 1 hacer
            si unidades[u].hay y unidades[u].letra = letra entonces devolver u fin
        fin
        devolver NINGUNA
    fin

    ; una ficha libre (que no sea la última: es la de la unidad en memoria)
    función libre(): nat32
        variable u: nat32
        para u desde 0 hasta MAX_UNIDADES - 2 hacer
            si no unidades[u].hay entonces devolver u fin
        fin
        devolver NINGUNA
    fin

    ; prueba a montar lo que haya en el disco d desde el sector «inicio»
    función prueba(d: nat32, inicio: nat32, partición: nat32): bool
        variable u, l: nat32
        u := libre()
        si u = NINGUNA entonces devolver falso fin
        l := 0
        si discos[d].clase = DE_USB entonces
            l := letra_usb()
            si l = 0 entonces devolver falso fin
        sino si discos[d].clase = DE_CD o discos[d].clase = DE_IMAGEN entonces
            l := letra_de_cd(d)                         ; (CD)
            si l = 0 entonces devolver falso fin
        fin
        si l = 0 y letra_interna >= 'M' entonces devolver falso fin
        si no montar(u, d, inicio) entonces devolver falso fin
        unidades[u].hay := cierto
        unidades[u].clase := U_FAT
        unidades[u].disco := d
        unidades[u].partición := partición
        cambios := cambios + 1
        si l <> 0 entonces
            unidades[u].letra := l
        sino
            unidades[u].letra := letra_interna
            letra_interna := letra_interna + 1
        fin
        devolver cierto
    fin

    ; la letra para una memoria USB: al arrancar, la X: si está libre; si
    ; no (o enchufada en marcha), la primera libre de la W: hacia abajo
    ; (hasta la N:). 0: no queda ninguna.
    función letra_usb(): nat32
        variable l: nat32
        si no en_caliente y por_letra('X') = NINGUNA entonces devolver 'X' fin
        l := 'W'
        mientras l >= 'N' hacer
            si por_letra(l) = NINGUNA entonces devolver l fin
            l := l - 1
        fin
        devolver 0
    fin

    función palabra32(p: puntero a byte): nat32
        devolver p[0] ob (nat32(p[1]) << 8) ob (nat32(p[2]) << 16) ob (nat32(p[3]) << 24)
    fin

    ; las particiones de una tabla GPT (la de los discos de ahora): la
    ; cabecera está en el sector 1 y dice dónde están las entradas. Se
    ; prueba a montar cada una (la FAT se reconoce por su primer sector).
    función mira_gpt(d: nat32): nat32
        variable n, i, lba, cuántas, tamaño_, primero, hechas: nat32
        variable e: puntero a byte
        si no leer_sectores(d, 1, 1, sector) entonces devolver 0 fin
        si palabra32(dirección(sector[0])) <> 0x20494645 o palabra32(dirección(sector[4])) <> 0x54524150 entonces devolver 0 fin
        si palabra32(dirección(sector[76])) <> 0 entonces devolver 0 fin       ; (las entradas, más allá de 2 TB)
        lba := palabra32(dirección(sector[72]))
        cuántas := palabra32(dirección(sector[80]))
        tamaño_ := palabra32(dirección(sector[84]))
        si tamaño_ < 128 o tamaño_ > 512 o 512 mod tamaño_ <> 0 entonces devolver 0 fin
        si cuántas > 64 entonces cuántas := 64 fin
        hechas := 0
        n := 0
        mientras n < cuántas hacer
            i := n mod (512 div tamaño_)
            si i = 0 entonces
                si no leer_sectores(d, lba + n div (512 div tamaño_), 1, sector) entonces devolver hechas fin
            fin
            e := dirección(sector[i * tamaño_])
            ; una entrada en uso (su clase no es todo ceros) que empieza por debajo de los 2 TB
            si (palabra32(e) <> 0 o palabra32(e + 4) <> 0 o palabra32(e + 8) <> 0 o palabra32(e + 12) <> 0) y palabra32(e + 36) = 0 entonces
                primero := palabra32(e + 32)
                si primero <> 0 y prueba(d, primero, n + 1) entonces
                    hechas := hechas + 1
                    ; (montar ha usado otro sector: el de las entradas se vuelve a leer)
                    si no leer_sectores(d, lba + n div (512 div tamaño_), 1, sector) entonces devolver hechas fin
                fin
            fin
            n := n + 1
        fin
        devolver hechas
    fin

    ; mira el disco d y monta los volúmenes FAT que tenga. Da cuántos.
    público función monta_disco(d: nat32): nat32
        variable i, t, hechas: nat32
        variable inicios: arreglo [4] de nat32
        variable clases: arreglo [4] de byte
        si d >= MAX_DISCOS entonces devolver 0 fin
        si no discos[d].hay entonces devolver 0 fin
        ; (CD) un lector: su letra (lo monta cdcal.cas, cuando tiene disco); una
        ; imagen de CD, su ISO 9660
        si discos[d].clase = DE_CD entonces
            letra_de_cd(d)
            devolver 0
        fin
        si discos[d].bloque = 2048 entonces
            si monta_cd(d) entonces devolver 1 fin
            devolver 0
        fin
        ; el disco entero, sin tabla de particiones
        si prueba(d, 0, 0) entonces devolver 1 fin
        si no leer_sectores(d, 0, 1, sector) entonces devolver 0 fin
        si sector[510] <> 0x55 o sector[511] <> 0xAA entonces devolver 0 fin
        para i desde 0 hasta 3 hacer
            clases[i] := sector[446 + i * 16 + 4]
            inicios[i] := palabra32(dirección(sector[446 + i * 16 + 8]))
        fin
        hechas := 0
        para i desde 0 hasta 3 hacer
            t := clases[i]
            si t = 0xEE entonces
                devolver mira_gpt(d)
            sino si t = 0x01 o t = 0x04 o t = 0x06 o t = 0x0B o t = 0x0C o t = 0x0E o t = 0xEF entonces
                si inicios[i] <> 0 y prueba(d, inicios[i], i + 1) entonces hechas := hechas + 1 fin
            fin
        fin
        devolver hechas
    fin

    ; cuántas unidades tiene el disco d
    público función unidades_de(d: nat32): nat32
        variable u, n: nat32
        n := 0
        para u desde 0 hasta MAX_UNIDADES - 1 hacer
            si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces n := n + 1 fin
        fin
        devolver n
    fin

    ; si el cargador ha traído archivos, hacen de unidad M:
    público función monta_memoria(): bool
        si módulos() = 0 entonces devolver falso fin
        unidades[MAX_UNIDADES - 1].hay := cierto
        unidades[MAX_UNIDADES - 1].letra := 'M'
        unidades[MAX_UNIDADES - 1].clase := U_MEMORIA
        devolver cierto
    fin

    ; elige la unidad del sistema: la de la letra pedida (0: ninguna
    ; pedida) si está y tiene el sistema; si no, la primera que lo tenga
    ; (C:, D:... y luego X:...); si no, la de memoria; y si no, la primera
    ; que haya. (Así, el disco de dentro de un PC, que puede tener una
    ; partición FAT con otras cosas, no pasa por unidad del sistema.)
    público función elige_sistema(pedida: nat32)
        variable u, letra: nat32
        del_sistema := NINGUNA
        si pedida <> 0 entonces
            u := por_letra(pedida)
            si u <> NINGUNA entonces
                si unidades[u].clase = U_MEMORIA o tiene_sistema(u) entonces del_sistema := u fin
            fin
        fin
        si del_sistema = NINGUNA entonces
            para letra desde 'A' hasta 'Z' hacer
                u := por_letra(letra)
                si u <> NINGUNA y del_sistema = NINGUNA entonces
                    si tiene_sistema(u) entonces del_sistema := u fin
                fin
            fin
        fin
        si del_sistema = NINGUNA entonces del_sistema := por_letra('M') fin
        si del_sistema = NINGUNA entonces
            para u desde 0 hasta MAX_UNIDADES - 1 hacer
                si unidades[u].hay y del_sistema = NINGUNA entonces del_sistema := u fin
            fin
        fin
    fin

    ; ¿tiene esa unidad (un volumen FAT) el intérprete de órdenes en su raíz?
    ; (así se reconoce la memoria de arranque)
    público función tiene_sistema(u: nat32): bool
        variable m: nat32
        si u >= MAX_UNIDADES entonces devolver falso fin
        si no unidades[u].hay o unidades[u].clase <> U_FAT entonces devolver falso fin
        si discos[unidades[u].disco].clase = DE_CD o discos[unidades[u].disco].clase = DE_IMAGEN entonces devolver falso fin   ; (CD) (el CD de instalar es M:)
        m := abrir_archivo(u, "\\ORDENES.BIN", PARA_LEER)
        si m >= PRIMER_ERROR entonces m := abrir_archivo(u, "\\HISPA\\ORDENES.BIN", PARA_LEER) fin
        si m >= PRIMER_ERROR entonces devolver falso fin
        cerrar_archivo(m)
        devolver cierto
    fin

    ; ¿está el sistema INSTALADO en la unidad del sistema? (lo está si es un
    ; disco y lleva sus programas en la carpeta \HISPA, y no en la raíz, como
    ; la memoria de arranque: lo deja así el programa INSTALAR)
    público función instalado(): bool
        variable m: nat32
        si del_sistema >= MAX_UNIDADES entonces devolver falso fin
        si no unidades[del_sistema].hay o unidades[del_sistema].clase <> U_FAT entonces devolver falso fin
        m := abrir_archivo(del_sistema, "\\ORDENES.BIN", PARA_LEER)
        si m < PRIMER_ERROR entonces
            cerrar_archivo(m)
            devolver falso
        fin
        m := abrir_archivo(del_sistema, "\\HISPA\\ORDENES.BIN", PARA_LEER)
        si m >= PRIMER_ERROR entonces devolver falso fin
        cerrar_archivo(m)
        devolver cierto
    fin

    ; las unidades del disco d dejan de serlo (se va a escribir en él por
    ; debajo, sector a sector: el programa INSTALAR)
    público función desmonta_disco(d: nat32)
        variable u: nat32
        para u desde 0 hasta MAX_UNIDADES - 2 hacer
            si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces
                desmontar(u)
                unidades[u].hay := falso
            fin
        fin
    fin

    ; la memoria USB de arranque es X:: si hay varias memorias y la que lleva
    ; el sistema no es la primera, se cambian las letras
    público función arranque_a_x()
        variable x, u, letra: nat32
        x := por_letra('X')
        si x = NINGUNA entonces devolver fin
        si tiene_sistema(x) entonces devolver fin
        para letra desde 'N' hasta 'W' hacer
            u := por_letra(letra)
            si u <> NINGUNA entonces
                si tiene_sistema(u) entonces
                    unidades[u].letra := 'X'
                    unidades[x].letra := letra
                    devolver
                fin
            fin
        fin
    fin

    ; ¿es de solo lectura la unidad u?
    público función protegida(u: nat32): bool
        si u >= MAX_UNIDADES entonces devolver cierto fin
        si no unidades[u].hay o unidades[u].clase <> U_FAT entonces devolver cierto fin
        devolver no escribible(u)
    fin

    ; -------------------------------------------------------------------------
    ;  Las memorias USB que se enchufan y se desenchufan en marcha
    ; -------------------------------------------------------------------------
    ; el disco d (una memoria USB recién enchufada): se montan sus volúmenes
    ; FAT, con las letras de la W: hacia abajo. Si es la memoria del sistema
    ; que se había ido, vuelve a ser X: y la del sistema. Da cuántas.
    público función monta_caliente(d: nat32): nat32
        variable n, u: nat32
        en_caliente := cierto
        n := monta_disco(d)
        en_caliente := falso
        si sistema_ido y por_letra('X') = NINGUNA entonces
            para u desde 0 hasta MAX_UNIDADES - 2 hacer
                si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d y sistema_ido entonces
                    si tiene_sistema(u) entonces
                        unidades[u].letra := 'X'
                        del_sistema := u
                        sistema_ido := falso
                    fin
                fin
            fin
        fin
        devolver n
    fin

    ; las unidades del disco d dejan de estar (se ha desenchufado; o, con
    ; «guardar», se va a quitar con seguridad: antes, lo pendiente va al
    ; disco). Los archivos abiertos en ellas dan error desde ya; los
    ; programas que trabajaban en ellas pasan a la unidad del sistema. Deja
    ; en «letras» las suyas (hasta 4, acabadas en 0: caben en 5 octetos). Da
    ; cuántas eran.
    público función quita_disco(d: nat32, guardar: bool, letras: puntero a byte): nat32
        variable u, n, t: nat32
        n := 0
        para u desde 0 hasta MAX_UNIDADES - 2 hacer
            si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces
                si guardar entonces retirar(u) sino desmontar(u) fin
                unidades[u].hay := falso
                cambios := cambios + 1
                si n < 4 entonces letras[n] := unidades[u].letra fin
                n := n + 1
                para t desde 0 hasta MAX_TAREAS - 1 hacer
                    si tareas[t].estado <> Tareas.LIBRE y tareas[t].unidad = u + 1 entonces
                        tareas[t].unidad := 0
                        tareas[t].carpeta[0] := 0
                    fin
                fin
                si u = del_sistema entonces
                    ; la del sistema se ha ido: la que lo tenga, o la de memoria
                    sistema_ido := cierto
                    elige_sistema(0)
                fin
            fin
        fin
        si n < 4 entonces letras[n] := 0 sino letras[4] := 0 fin
        devolver n
    fin

    ; -------------------------------------------------------------------------
    ;  (CD) Los CD y los DVD, y las imágenes de disco
    ; -------------------------------------------------------------------------
    ; ¿es esa letra la de algún lector de CD (aunque no tenga disco)?
    función letra_de_lector(l: nat32): bool
        variable d: nat32
        para d desde 0 hasta MAX_DISCOS - 1 hacer
            si letras_cd[d] = l y discos[d].hay y discos[d].clase = DE_CD entonces devolver cierto fin
        fin
        devolver falso
    fin

    ; la primera letra libre tras los discos de dentro (D: si hay un disco
    ; duro, aunque no tenga FAT), antes de la M:. 0: ninguna.
    función letra_libre_cd(): nat32
        variable l, d: nat32
        l := letra_interna
        si l = 'C' entonces
            para d desde 0 hasta MAX_DISCOS - 1 hacer
                si discos[d].hay y (discos[d].clase = DE_ATA o discos[d].clase = DE_AHCI) entonces l := 'D' fin
            fin
        fin
        mientras l < 'M' y (por_letra(l) <> NINGUNA o letra_de_lector(l)) hacer l := l + 1 fin
        si l >= 'M' entonces devolver 0 fin
        devolver l
    fin

    ; la letra del disco d (un lector de CD, que la guarda para siempre; o
    ; una imagen, la primera libre). 0: no queda ninguna.
    público función letra_de_cd(d: nat32): nat32
        si d >= MAX_DISCOS entonces devolver 0 fin
        si discos[d].clase = DE_CD entonces
            si letras_cd[d] = 0 entonces letras_cd[d] := letra_libre_cd() fin
            devolver letras_cd[d]
        fin
        devolver letra_libre_cd()
    fin

    ; el disco del lector de CD que lleva esa letra (0xFFFFFFFF: ninguno)
    público función lector_de_letra(letra: nat32): nat32
        variable d: nat32
        si letra >= 'a' y letra <= 'z' entonces letra := letra - 32 fin
        para d desde 0 hasta MAX_DISCOS - 1 hacer
            si letras_cd[d] = letra y discos[d].hay y discos[d].clase = DE_CD entonces devolver d fin
        fin
        devolver 0xFFFFFFFF
    fin

    ; el lector del disco d se ha ido (uno de USB): su letra queda libre
    público función suelta_letra_cd(d: nat32)
        si d < MAX_DISCOS entonces letras_cd[d] := 0 fin
    fin

    ; monta el ISO 9660 del disco d (un CD o DVD, o una imagen de CD), con
    ; su letra. Falso si no lo tiene.
    público función monta_cd(d: nat32): bool
        variable u, l: nat32
        u := libre()
        si u = NINGUNA entonces devolver falso fin
        l := letra_de_cd(d)
        si l = 0 entonces devolver falso fin
        si no montar_iso(u, d) entonces devolver falso fin
        unidades[u].hay := cierto
        unidades[u].clase := U_FAT
        unidades[u].disco := d
        unidades[u].partición := 0
        unidades[u].letra := l
        cambios := cambios + 1
        devolver cierto
    fin

    ; la unidad del disco d (la primera: NINGUNA si no tiene)
    público función unidad_de_disco(d: nat32): nat32
        variable u: nat32
        para u desde 0 hasta MAX_UNIDADES - 2 hacer
            si unidades[u].hay y unidades[u].clase = U_FAT y unidades[u].disco = d entonces devolver u fin
        fin
        devolver NINGUNA
    fin

fin Unidades.
