    ; el de serie número i: dónde empieza (y en n, cuánto mide)
    público función de_serie(i: nat32, ref n: nat32): puntero a byte
        variable p: puntero a nat32
        si i >= DE_SERIE entonces
            n := 0
            devolver nulo
        fin
