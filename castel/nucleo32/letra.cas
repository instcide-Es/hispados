    ; dónde están las 16 filas de la letra c
    público función dibujo_letra(c: nat32): puntero a byte
        ensamblador
            mov eax, {c}
            and eax, 255
            shl eax, 4
            add eax, HP_letra8x16
        fin
    fin

fin Letra.
