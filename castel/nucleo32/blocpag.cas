; =============================================================================
;  blocpag.cas - los juegos de caracteres del Bloc de notas (BLOC.BIN): la
;  437 de casa (la de Hispa: la 437 con Á, Í, Ó, Ú, €...; tools/hispa437.py),
;  la Windows-1252 y UTF-8.
;
;  Dentro del Bloc el texto va siempre en UTF-8. Para no perder nada al abrir
;  y guardar, un octeto que no es UTF-8 válido (de 0x80 a 0xFF) se guarda
;  como el carácter U+DC00 + el octeto (un «sustituto escapado», como el
;  surrogateescape de Python: ED B2 80 .. ED B3 BF) y, al guardar, vuelve a
;  ser ese octeto. Los cinco huecos de la 1252 (81, 8D, 8F, 90, 9D) van a
;  U+0081.. (los de control C1). Así, abrir y guardar sin tocar nada deja el
;  archivo igual octeto a octeto, en las tres.
;
;      cp := pag_detectar(datos, n, bom)        ; CP_437, CP_UTF8 o CP_1252
;      m := pag_largo_utf8(cp, datos, n)        ; lo que ocupará dentro
;      pag_a_utf8(cp, datos, n, dentro)
;      pag_de_utf8(cp, dentro, m, fuera, perdidas)   ; lo que no cabe, «?»
;      k := pag_decodifica(p, n, u)             ; un carácter: los octetos que gasta
;      c := pag_letra(u)                        ; la letra de Hispa que lo pinta
;
;  Las tablas (entre sus marcas) las hace nucleo32/hazblocpag.py.
;  Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
; =============================================================================
módulo BlocPag

    importar BlocMem

    público constante CP_437 = 0
    público constante CP_UTF8 = 1
    público constante CP_1252 = 2
    público constante SIN_LETRA = 0xFFFFFFFF

    constante UN_MEGA = 1048576

