; numeros64.cas - los números escritos de 64 bits y las variables alineadas
; (CASTEL64.md §10 ter, para Hispa-64): un número de más de 32 bits es un
; nat64 (se pone con «mov rax, n»; no se calcula con él al compilar), en una
; cuenta, una comparación, un valor inicial, una constante, un argumento y
; en el ensamblador ({X}); y «alineado N» en las variables del módulo.
; código de salida: 7
; Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.
módulo Numeros64

    modelo linux64

    constante MITAD_ALTA = 0xFFFF800000000000
    constante GRANDE = 10000000000000000000
    constante PEQUE = 0x100000000

    variable mapa: nat64 = 0xFFFFFFFF80000000
    variable relleno: byte
    variable tabla: arreglo [512] de nat64 alineado 4096
    variable otro: byte
    variable pila: arreglo [100] de byte alineado 16

    función mitad(v: nat64): nat64
        devolver v >> 1
    fin

    función en_asm(): nat64
        ensamblador
            mov rax, {MITAD_ALTA}
            shr rax, 44
        fin
    fin

    función principal(): byte
        variable x: nat64
        variable n: nat32
        x := MITAD_ALTA + 0x1000
        escribir(x, " ", x - MITAD_ALTA, "\n")
        escribir(GRANDE, " ", GRANDE div 3, " ", mitad(0x8000000000000000), "\n")
        escribir(mapa, " ", mapa yb 0xFFFFFFFF00000000, " ", 18446744073709551615, "\n")
        escribir(x > 0x7FFFFFFFFFFFFFFF, " ", PEQUE = nat64(1) << 32, " ", x < 0x100000000, "\n")
        n := nat32(PEQUE - 1)
        escribir(n, " ", en_asm(), " ", -0x100000000, "\n")
        escribir(nat64(dirección(tabla)) yb 4095, " ", nat64(dirección(pila)) yb 15, "\n")
        tabla[511] := PEQUE
        escribir(tabla[511] + tabla[0], "\n")
        devolver 7
    fin

fin Numeros64.
