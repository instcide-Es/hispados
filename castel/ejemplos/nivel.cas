módulo Nivel

    función cuatro(): nat16
        devolver 4
    fin

    función principal(): byte
        escribir("salgo con el nivel 7\n")
        si cuatro() <> 4 entonces
            salir(1)
        fin
        devolver 3 + cuatro()
    fin

fin Nivel.
