; arreglos.cas - Fase 3: arreglos globales y locales, de 8 y de 16 bits.
; Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.

módulo Arreglos

    constante N = 8

    variable primos: arreglo [N] de nat16 = (2, 3, 5, 7, 11, 13, 17, 19)
    variable cuadrados: arreglo [N] de nat16          ; sin valor: empieza a cero
    variable letras: arreglo [N] de byte
    variable tabla: arreglo [3] de arreglo [4] de byte
    variable signos: arreglo [4] de ent16 = (-5, 300, -32768)    ; el cuarto, 0

    función principal()
        variable i, j, suma: nat16
        variable cuenta: arreglo [10] de byte
        variable pares: arreglo [5] de ent16

        ; leer un arreglo con valor inicial
        suma := 0
        para i desde 0 hasta N - 1 hacer
            suma := suma + primos[i]
        fin
        escribir("suma de primos = ", suma, "\n")

        ; escribir y leer elementos de 16 bits (índice variable y constante)
        escribir("antes: ", cuadrados[3], "\n")
        para i desde 0 hasta N - 1 hacer
            cuadrados[i] := i * i
        fin
        cuadrados[0] := 1000
        escribir("cuadrados:")
        para i desde 0 hasta N - 1 hacer
            escribir(" ", cuadrados[i])
        fin
        escribir("\n")

        ; elementos de 8 bits: se guardan módulo 256
        para i desde 0 hasta N - 1 hacer
            letras[i] := 'a' + i
        fin
        letras[N - 1] := 0
        escribir("letras: ", letras, "\n")
        letras[2] := letras[2] + 200
        escribir("letras[2] = ", letras[2], "\n")

        ; arreglos locales (en la pila)
        para i desde 0 hasta 9 hacer
            cuenta[i] := 0
        fin
        para i desde 0 hasta N - 1 hacer
            cuenta[primos[i] mod 10] := cuenta[primos[i] mod 10] + 1
        fin
        escribir("acaban en 1, 3, 7, 9:")
        escribir(" ", cuenta[1], " ", cuenta[3], " ", cuenta[7], " ", cuenta[9], "\n")
        para i desde 0 hasta 4 hacer
            pares[i] := 10 - 5 * i
        fin
        escribir("pares[4] = ", pares[4], ", pares[1] + pares[3] = ", pares[1] + pares[3], "\n")

        ; arreglo de arreglos
        para i desde 0 hasta 2 hacer
            para j desde 0 hasta 3 hacer
                tabla[i][j] := i * 10 + j
            fin
        fin
        escribir("tabla[2][3] = ", tabla[2][3], ", tabla[1][0] = ", tabla[1][0], "\n")

        ; índice que es una cuenta, a los dos lados
        i := 2
        cuadrados[i + 1] := cuadrados[i * 2] + cuadrados[primos[0]]
        escribir("cuadrados[3] = ", cuadrados[3], "\n")

        escribir("signos: ", signos[0], " ", signos[1], " ", signos[2], " ", signos[3], "\n")
        escribir("tamaños: ", tamaño(primos), " ", tamaño(letras), " ", tamaño(tabla), "\n")
    fin

fin Arreglos.
