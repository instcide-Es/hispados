; bits.cas - Fase 3: operadores de bits (yb ob xob nob << >>) y la cuenta con
; y sin signo.
; Copyright (C) 2026 Carlos Sanz y contribuidores. GPL-2.0 o posterior.

módulo Bits

    constante MASCARA = 0x0F << 4               ; las constantes también echan cuentas
    constante TODO    = nob 0
    constante MEZCLA  = (1 << 10 ob 1 << 3) xob 0xFF

    variable cifras: arreglo [17] de byte = "0123456789ABCDEF"

    ; enseña un número en hexadecimal, con sus cuatro cifras
    función hex(n: nat16)
        variable i: ent16
        para i desde 12 hasta 0 paso -4 hacer
            escribir_car(cifras[n >> i yb 0x0F])
        fin
    fin

    función cuenta_bits(n: nat16): nat16
        variable c: nat16
        c := 0
        mientras n <> 0 hacer
            c := c + (n yb 1)
            n := n >> 1
        fin
        devolver c
    fin

    función principal()
        variable a, b, d: nat16
        variable e: ent16
        variable oct: byte

        a := 0x1234
        b := 0x00FF
        hex(a yb b)
        escribir(" ")
        hex(a ob b)
        escribir(" ")
        hex(a xob b)
        escribir(" ")
        hex(nob a)
        escribir(" ")
        hex(a yb nob b)
        escribir("\n")

        d := 3
        hex(a << 4)
        escribir(" ")
        hex(a >> 4)
        escribir(" ")
        hex(a << d)
        escribir(" ")
        hex(a >> d + 1)
        escribir(" ")
        hex(1 << 15)
        escribir(" ")
        hex(a >> 0)
        escribir("\n")

        ; >> con signo conserva el signo (ent16); sin signo mete ceros
        e := -16
        a := 0xFFF0
        escribir(e >> 2, " ", a >> 2, " ", e << 1, " ", e >> d, "\n")

        hex(MASCARA)
        escribir(" ")
        hex(TODO)
        escribir(" ")
        hex(MEZCLA)
        escribir("\n")

        escribir(cuenta_bits(0), " ", cuenta_bits(0xFFFF), " ", cuenta_bits(0x8001), " ", cuenta_bits(1990), "\n")

        ; sobre la propia variable, y en un byte
        a := 0x00F0
        a := a ob 0x0F00
        a := a yb 0x0FF0
        a := a xob 0x0110
        hex(a)
        oct := 0x81
        oct := oct ob 0x18
        oct := oct yb nob 1
        escribir(" ", oct, "\n")

        ; probar un bit
        si a yb 0x0800 <> 0 entonces
            escribir("bit 11 puesto")
        fin
        si a yb 0x0001 = 0 entonces
            escribir(", bit 0 quitado")
        fin
        si oct yb 0x80 <> 0 y no (oct yb 1 <> 0) entonces
            escribir(", el alto del byte sí")
        fin
        escribir("\n")

        ; con y sin signo: la cuenta es la misma; cambia comparar, dividir y enseñar
        a := 40000
        e := -100
        escribir(a > 100, " ", e > 100, " ", e < a, "\n")
        escribir(a div 7, " ", a mod 7, " ", e div 7, " ", e mod 7, " ", -e div 8, "\n")
        escribir(a * 2, " ", e * 3, " ", a + 30000, " ", 7 - a, "\n")
        escribir(a div 256, " ", a mod 256, " ", a * 4, " ", (a + e) div d, "\n")
    fin

fin Bits.
